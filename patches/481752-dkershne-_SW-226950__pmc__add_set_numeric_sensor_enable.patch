+	sensord_oobi_load();
 
 	return 0;
 }
@@ -812,58 +851,90 @@
 	return err;
 }
 
-/* FIXME: this function is not used ... delete? */
-int sensord_enable_set(
+static void sensord_persist_numeric_sensor_enable(
+	struct hl_oobi_pldm_sensors *oobi, uint16_t sensor_id,
+	pldm_sensor_op_state_t operational_state)
+{
+	struct hl_oobi_pldm_numeric_sensor_op_state *item = NULL;
+	struct hl_oobi_pldm_numeric_sensor_op_state *empty = NULL;
+
+	for (size_t i = 0; i < ARRAY_SIZE(oobi->numeric_op_state); i++) {
+		if (oobi->numeric_op_state[i].sensor_id == sensor_id) {
+			item = &oobi->numeric_op_state[i];
+			break;
+		}
+		if (!empty && oobi->numeric_op_state[i].sensor_id == 0)
+			empty = &oobi->numeric_op_state[i];
+	}
+	if (!item)
+		item = empty;
+
+	if (!item) {
+		if (operational_state != PLDM_SENSOR_OP_STATE_ENABLED)
+			LOG_WRN("%s: Unable to persist sensor enable  %d: table_full",
+				__func__, sensor_id);
+		return;
+	}
+
+	switch (operational_state) {
+	case PLDM_SENSOR_OP_STATE_DISABLED:
+		item->sensor_id = sensor_id;
+		item->sensor_op_state = OOBI_SENSOR_OP_STATE_DISABLED;
+		break;
+	case PLDM_SENSOR_OP_STATE_UNAVAILABLE:
+		item->sensor_id = sensor_id;
+		item->sensor_op_state = OOBI_SENSOR_OP_STATE_UNAVAILABLE;
+		break;
+	default:
+		/* Other op states are ignored, just delete entry */
+		item->sensor_id = 0;
+		break;
+	}
+
+	hl_oobi_pldm_sensor_persist_data(oobi);
+}
+
