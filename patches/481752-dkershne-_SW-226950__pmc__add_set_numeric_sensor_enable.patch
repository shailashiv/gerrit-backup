 {
 	struct sensord_sensor_entry *sensor;
 	struct sensord_sensor_state *state;
 	k_spinlock_key_t key;
+	pldm_sensor_op_state_t current_op_state;
 
-	sensor = find_sensor(sensor_id, pdr_type_mask);
+	if (desired_op_state > PLDM_SENSOR_OP_STATE_UNAVAILABLE)
+		return PLDM_PMC_SET_NUMERIC_SENSOR_ENABLE_STATUS_INVALID_OP_STATE;
+
+	sensor = find_sensor(sensor_id, NUMERIC_SENSOR_TYPE_MASK);
 	if (!sensor)
-		return -ENODEV;
+		return PLDM_PMC_SET_NUMERIC_SENSOR_ENABLE_STATUS_INVALID_SENSOR_ID;
 
 	state = sensor->state;
 	key = k_spin_lock(&sensord_state.lock);
 
-	/* FIXME: assumes numeric sensor; add support for state sensors? */
-	switch ((pldm_sensor_op_state_t) state->value.single.operational_state) {
-	case PLDM_SENSOR_OP_STATE_DISABLED:
-		if (enable) {
-			state->value.single.operational_state = PLDM_SENSOR_OP_STATE_ENABLED;
-			state->value.single.present_state = PLDM_SENSOR_THRESHOLD_UNKNOWN;
-			state->value.single.previous_state = PLDM_SENSOR_THRESHOLD_UNKNOWN;
-			state->value.single.event_state = PLDM_SENSOR_THRESHOLD_UNKNOWN;
+	current_op_state = (pldm_sensor_op_state_t)state->value.single.operational_state;
 
+	if (current_op_state != desired_op_state) {
+		state->value.single.operational_state = desired_op_state;
+		state->value.single.present_state = PLDM_SENSOR_THRESHOLD_UNKNOWN;
+		state->value.single.previous_state = PLDM_SENSOR_THRESHOLD_UNKNOWN;
+		state->value.single.event_state = PLDM_SENSOR_THRESHOLD_UNKNOWN;
+
+		if (desired_op_state == PLDM_SENSOR_OP_STATE_ENABLED) {
 			state->polled = false; /* reset poll-once tracking */
 
 			/* trigger daemon poll immediately after enabling a sensor */
 			state->timestamp_next_poll = 0;
 			sensord_state.timestamp_next_poll = 0;
 		}
-		break;
-	case PLDM_SENSOR_OP_STATE_ENABLED:
-	case PLDM_SENSOR_OP_STATE_UNAVAILABLE:
-	case PLDM_SENSOR_OP_STATE_UNKNOWN:
-	case PLDM_SENSOR_OP_STATE_FAILED:
-	case PLDM_SENSOR_OP_STATE_INITIALIZING:
-	case PLDM_SENSOR_OP_STATE_SHUTTING_DOWN:
-	case PLDM_SENSOR_OP_STATE_IN_TEST:
-		if (!enable) {
-			state->value.single.operational_state = PLDM_SENSOR_OP_STATE_DISABLED;
-			state->value.single.present_state = PLDM_SENSOR_THRESHOLD_UNKNOWN;
-			state->value.single.previous_state = PLDM_SENSOR_THRESHOLD_UNKNOWN;
-			state->value.single.event_state = PLDM_SENSOR_THRESHOLD_UNKNOWN;
-		}
-		break;
 	}
 
 	k_spin_unlock(&sensord_state.lock, key);
 
-	return 0;
+	sensord_persist_numeric_sensor_enable(&sensord_state.oobi, sensor_id, desired_op_state);
+
+	return MCTP_STATUS_SUCCESS;
 }
 
 static int update_if_enabled_u8(
