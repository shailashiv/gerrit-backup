+static uint8_t decode_oobi_op_state(uint8_t oobi_op_state)
+{
+	switch (oobi_op_state) {
+	case OOBI_SENSOR_OP_STATE_DISABLED:
+		return PLDM_SENSOR_OP_STATE_DISABLED;
+	case OOBI_SENSOR_OP_STATE_UNAVAILABLE:
+		return PLDM_SENSOR_OP_STATE_UNAVAILABLE;
+	default:
+		return PLDM_SENSOR_OP_STATE_ENABLED;
+	}
+}
+
+static void sensord_oobi_load_numeric_sensor_enable(void)
+{
+	struct hl_oobi_pldm_numeric_sensor_op_state *sensors;
+
+	sensors = sensord_state.oobi.numeric_op_state;
+
+	for (size_t i = 0; i < ARRAY_SIZE(sensord_state.oobi.numeric_op_state); i++) {
+		if (sensors[i].sensor_id == 0)
+			continue;
+
+		sensord_numeric_sensor_enable_set(sensors[i].sensor_id,
+			decode_oobi_op_state(sensors[i].sensor_op_state));
+	}
+}
+
+static void sensord_oobi_load(void)
+{
+	hl_oobi_pldm_sensor_restore_data(&sensord_state.oobi);
+
+	sensord_oobi_load_numeric_sensor_enable();
+}
+
 static int sensord_init_all_sensors(void)
 {
 	uint8_t current_platform = pldm_get_current_platform();
@@ -704,6 +741,8 @@
 			return -EINVAL;
 		}
 	}
