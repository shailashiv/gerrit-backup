Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/preboot.c b/preboot.c
index b2da5f0..da175de 100644
--- a/preboot.c
+++ b/preboot.c
@@ -66,7 +66,7 @@
 	}
 }
 
-static void preboot_puts(const char* str)
