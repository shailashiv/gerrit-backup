From d070501f448e984fdf68d39c8361a21c700af8dd Mon Sep 17 00:00:00 2001
From: chandavath <rcrajagopal@habana.ai>
Date: Fri, 23 Feb 2024 15:16:16 +0200
Subject: [PATCH] [SW-137122] gaudi3: erom rec: cleaned up pci and flr handling

In erom, we always bringup pcie link through ARC1 only. Here
we won't run PIF ARC and it can't handle FLR RST. so we should
not enable flr handling in PIF ARC.
By default HW will handle the FLR.

Since PIF ARC not running, is_pci_initialized should check
smlh, rdlh registers. Moved pci dev specific functions to
device specific files.

Change-Id: I894283b420f6908162120aa1de1adaa3d4eb718b
Signed-off-by: chandavath <rcrajagopal@habana.ai>
---

diff --git a/arch/gaudi2/common/common.c b/arch/gaudi2/common/common.c
index 3b4f662..7a0f9d3 100644
--- a/arch/gaudi2/common/common.c
+++ b/arch/gaudi2/common/common.c
@@ -726,6 +726,22 @@
 	}
 }
 
+void pci_dev_specific_pll_init(void)
+{
+	unsigned int rst_src = hl_rst_src_get();
+
+	if ((rst_src == HL_COLD_RST) || (rst_src == HL_PRSTN_RST))
+		hl_dev_pci_pll_wa();
+}
+
+void pci_dev_specific_mem_enabled(void)
+{
+	unsigned int rst_src = hl_rst_src_get();
+
+	if ((rst_src == HL_COLD_RST) || (rst_src == HL_PRSTN_RST))
+		hl_pci_iatu_init();
+}
+
 #define MSIX_PBA_OFFSET_REG_VAL	0x2002
 
 void set_pci_msix_pba_offset_val(void)
