-
 	cpu_boot_dev_sts_set(CPU_BOOT_DEV_STS_FW_IATU_CONF_EN);
 }
 
-/* TODO: Move this functions to emb common modules */
-bool pci_dev_specific_pif_err_pending(void)
+void pci_dev_flr_enable(bool enable)
 {
-	u32 regval = regmap_readl(mmD0_PIF_ARC_ERROR);
-
-	return !(regval == pif_prev_err);
+	/* By default FLR RST handled by HW */
 }
 
-/* TODO: Move this functions to emb common modules */
-void hl_pif_report_err(u32 err_bit)
+void pci_dev_specific_flr(void)
 {
-	char *msg;
-	enum pif_runtime_error err = err_bit;
-
-	switch (err) {
-	case ERR_PCI_OUTBOUND_TIMEOUT:
-		msg = "outbound transactions timeout";
-		break;
-	case ERR_FLR_HW_RESET_TIMEOUT:
-		msg = "FLR HW reset timeout";
-		break;
-	case ERR_SEC_DIE_READY_TIMEOUT:
-		msg = "slave die ready timeout";
-		break;
-	case ERR_TS_COUNTER_OVERFLOW:
-		msg = "ts counter overflow";
-		break;
-	case ERR_CPU_EXCEPTION_HALT:
-		msg = "ARC halt on exeption";
-		break;
-	case ERR_PHY_FW_LOAD_TIMEOUT:
-		msg = "PHY FW update timeout";
-		break;
-	case ERR_PCI_LINK_UP_TIMEOUT:
-		preboot_puts_raw("waiting for pci link for more than 500ms");
-		return;
-	default:
-		preboot_puts_hex_raw("Unknown PIF err reported ", err, false);
-		return;
-	}
-
-	preboot_puts_raw("PIF err reported: ");
-	preboot_puts(msg);
-	preboot_puts("\n");
+	regmap_writel(PCIE_AUX_FLR_INT_IND_M, D0_PCIE_AUX_REG(mmPCIE_AUX_FLR_INT));
 }
 
-void pci_dev_specific_pif_err_process(void)
+void pci_dev_specific_pll_init(void)
 {
-	unsigned int err_idx = 0;
-	u32 regval, pending;
+	/* Nothing need to implemented for gaudi3 */
+}
 
-	regval = regmap_readl(mmD0_PIF_ARC_ERROR);
-	pending = regval ^ pif_prev_err;
-	pending &= regval;
-
-	while (pending) {
-		if (pending & BIT(0))
-			hl_pif_report_err(err_idx);
-
-		pending >>= 1;
-		err_idx++;
-	}
-
-	pif_prev_err = regval;
+void pci_dev_specific_mem_enabled(void)
+{
+	hl_pci_bmu_init();
+	hl_pci_iatu_init();
 }
 
 struct hl_pci_inbound_region gaudi3_pci_inbound_regions[] = PCI_IATU_INBOUND_REGIONS_DATA;
