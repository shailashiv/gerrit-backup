 #include <pci.h>
 #include <hl.h>
 
-static u32 pif_prev_err;
+static bool pcie_initialized;
 
 /* TODO: Move this functions to emb common modules */
 bool is_pcie_initialized(void)
 {
-	u32 regval;
+	unsigned int prstn, smlh, rdlh;
 
-	regval = regmap_readl(mmD0_PIF_ARC_STATUS);
-	if (regval & PIF_STAT_PCIE_INIT_DONE)
+	if (pcie_initialized)
 		return true;
+
+	prstn = regmap_readl(global_conf.prstn_reg);
+	smlh = regmap_readl(pci.aux_rdlh_link_up_reg);
+	rdlh = regmap_readl(pci.aux_smlh_link_up_reg);
+
+	if (prstn && smlh && rdlh) {
+		pcie_initialized = true;
+		return true;
+	}
 
 	return false;
 }
@@ -41,91 +49,30 @@
 }
 
 /* TODO: Move this functions to emb common modules */
-static void pif_arc_ctrl_reset(bool enable)
-{
-	u32 val = regmap_readl(mmD0_PIF_ARC_CONTROL);
-
-	if (enable)
-		val |= PIF_CTRL_FLR_RST_EN;
-	else
-		val &= ~PIF_CTRL_FLR_RST_EN;
-
-	regmap_writel(val, mmD0_PIF_ARC_CONTROL);
-}
-
-/* TODO: Move this functions to emb common modules */
