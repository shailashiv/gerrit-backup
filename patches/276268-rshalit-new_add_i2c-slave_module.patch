From 2586166cb895ff2fd17fdec8b56f364d22b07bf7 Mon Sep 17 00:00:00 2001
From: ran shalit <rshalit@habana.ai>
Date: Tue, 09 Aug 2022 10:34:37 +0300
Subject: [PATCH] new add i2c-slave module

Change-Id: I7bb770d8fcf1890fbe0253178aae1cef72ed32f9
Signed-off-by: ran shalit <rshalit@habana.ai>
---

diff --git a/package/zephyr/zephyr.mk b/package/zephyr/zephyr.mk
index 94422f8..b195b01 100644
--- a/package/zephyr/zephyr.mk
+++ b/package/zephyr/zephyr.mk
@@ -112,6 +112,7 @@
 ZEPHYR_CONF_OPTS_PREBOOT += -DTARGET=$(HL_TARGET)
 ZEPHYR_PREBOOT_SRCDIR = $(dir $(BR2_EXTERNAL_HABANALABS_PATH))/zephyr-apps/preboot
 ZEPHYR_CONF_OPTS_PREBOOT += $(ZEPHYR_PREBOOT_SRCDIR)
+ZEPHYR_CONF_OPTS_PREBOOT += "-DZEPHYR_MODULES=$(dir $(BR2_EXTERNAL_HABANALABS_PATH))/zephyr-modules/i2c-indirect"
 ifeq ($(PREBOOT_RUN_FROM_ICCM),true)
 ZEPHYR_CONF_OPTS_PREBOOT += -DCONFIG_PREBOOT_RUN_FROM_ICCM=y
 endif #PREBOOT_RUN_FROM_ICCM
@@ -119,7 +120,7 @@
 ZEPHYR_BUILD_CMDS += && $(TARGET_MAKE_ENV) $(MAKE) -C $(@D)/$(ZEPHYR_PREBOOT_DIR)
 ZEPHYR_INSTALL_TARGET_CMDS += && $(INSTALL) -D -m 0644 $(@D)/$(ZEPHYR_PREBOOT_DIR)/zephyr/zephyr.bin $(BINARIES_DIR)/preboot.bin
 ZEPHYR_INSTALL_TARGET_CMDS += && $(INSTALL) -D -m 0644 $(@D)/$(ZEPHYR_PREBOOT_DIR)/zephyr/zephyr.elf $(BINARIES_DIR)/zephyr_preboot.elf
-ZEPHYR_PREBOOT_MODULES = fdt boot_info mbedtls eeprom
+ZEPHYR_PREBOOT_MODULES = fdt boot_info mbedtls eeprom i2c-indirect
 $(foreach module,$(ZEPHYR_PREBOOT_MODULES),$(call DEFINE_MODULE_ENVVARS,$(module),$(ZEPHYR_PREBOOT_DIR),$(ZEPHYR_PREBOOT_NAME)))
 endif #BR2_PACKAGE_ZEPHYR_ARC_PREBOOT
 
