From b0e755ce6e96140ed658d86b815b8484691cb59e Mon Sep 17 00:00:00 2001
From: Karthikeyan K <karthikk@habana.ai>
Date: Thu, 21 Jul 2022 20:17:31 +0300
Subject: [PATCH] [SW-94864] rom: export rr config apis

Export rr config apis for re-use in ppboot.

Change-Id: I3bd0af5929559c720be9e5fdd6552e470441081d
---

diff --git a/arch/gaudi3/arc/arcboot_rom.txt b/arch/gaudi3/arc/arcboot_rom.txt
index 52ebe4b..a6fe415 100644
--- a/arch/gaudi3/arc/arcboot_rom.txt
+++ b/arch/gaudi3/arc/arcboot_rom.txt
@@ -15,3 +15,7 @@
 hl_get_boot_info_ver_rom
 secureboot_verify_image_signature
 secureboot_verify_image_hash384
+security_rr_config_debug_if_lbw
+security_rr_config_debug_if_hbw
+security_rr_config_pcie_lbw
+security_rr_config_pcie_hbw
diff --git a/arch/gaudi3/arc/dev_security.h b/arch/gaudi3/arc/dev_security.h
index abe5648..8b29505 100644
--- a/arch/gaudi3/arc/dev_security.h
+++ b/arch/gaudi3/arc/dev_security.h
@@ -7,6 +7,7 @@
 #define _GAUDI3_DEV_SECURITY_H_
 
 #include <sha512.h>
+#include <arcboot_export_dev.h>
 
 #define NUM_KEYS_IN_ROM					5
 #define SECURITY_DWORD_PER_KEY				12
@@ -30,15 +31,6 @@
 #define TOTAL_PUB_KEY_PROPS_SZ  (PUB_KEY_SZ + KEY_PROP_HDR_SZ)
 
 extern const uint8_t rom_key_hashes[NUM_KEYS_IN_ROM][SHA384_SUM_LEN];
-
-struct rom_rr_ctx {
-	uint8_t rr_idx;
-	uint8_t en_val;
-	uint32_t data_min;
-	uint32_t data_min_hi;
-	uint32_t data_max;
-	uint32_t data_max_hi;
-};
 
 /*
  * There are 18(0..17 rr idx) RRs for LBW.
diff --git a/arch/gaudi3/arc/security.c b/arch/gaudi3/arc/security.c
index 7c74788..66bfd44 100644
--- a/arch/gaudi3/arc/security.c
+++ b/arch/gaudi3/arc/security.c
@@ -203,7 +203,7 @@
 				rr_ctx->rr_idx);
 }
 
-static void security_rr_pcie_lbw_config(struct rom_rr_ctx *rr_ctx)
+void security_rr_config_pcie_lbw(struct rom_rr_ctx *rr_ctx)
 {
 	if (rr_ctx->rr_idx > RR_LBW_MAX_SHORT_IDX)
 		security_rr_pcie_lbw_config_full(rr_ctx);
@@ -211,7 +211,7 @@
 		security_rr_pcie_lbw_config_short(rr_ctx);
 }
 
-static void security_rr_pcie_hbw_config(struct rom_rr_ctx *rr_ctx)
+void security_rr_config_pcie_hbw(struct rom_rr_ctx *rr_ctx)
 {
 	uint32_t rr_dist = security_rr_calc_rr_dist(rr_ctx);
 
@@ -701,7 +701,7 @@
 }
 
 #define DEBUG_IF_ENABLE_VAL		0
-static void security_rr_config_lbw_debug_if(struct rom_rr_ctx *rr_ctx)
+void security_rr_config_debug_if_lbw(struct rom_rr_ctx *rr_ctx)
 {
 	if ((arcboot_rom_global.config_fuse &
 		EFUSE_SYSCFG_DISABLE_JTAG_IF_MASK) == DEBUG_IF_ENABLE_VAL)
@@ -712,7 +712,7 @@
 		security_rr_twi_lbw_config(rr_ctx);
 }
 
-static void security_rr_config_hbw_debug_if(struct rom_rr_ctx *rr_ctx)
+void security_rr_config_debug_if_hbw(struct rom_rr_ctx *rr_ctx)
 {
 	if ((arcboot_rom_global.config_fuse &
 		EFUSE_SYSCFG_DISABLE_JTAG_IF_MASK) == DEBUG_IF_ENABLE_VAL)
@@ -727,16 +727,16 @@
 {
 	security_handle_twi();
 
-	security_rr_config_lbw_debug_if(&rr_ctx_lbw);
+	security_rr_config_debug_if_lbw(&rr_ctx_lbw);
 
-	security_rr_config_hbw_debug_if(&rr_ctx_hbw);
+	security_rr_config_debug_if_hbw(&rr_ctx_hbw);
 }
 
 void security_rr_recovery_pcie_config(void)
 {
-	security_rr_pcie_lbw_config(&rr_ctx_lbw);
+	security_rr_config_pcie_lbw(&rr_ctx_lbw);
 
-	security_rr_pcie_hbw_config(&rr_ctx_hbw);
+	security_rr_config_pcie_hbw(&rr_ctx_hbw);
 }
 
 void check_and_enable_4b_termination(void) {}
