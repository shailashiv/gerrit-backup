diff --git a/goya2_arc/onix.c b/goya2_arc/onix.c
new file mode 100644
index 0000000..211e27b
--- /dev/null
+++ b/goya2_arc/onix.c
@@ -0,0 +1,29 @@
+/*
+ * Copyright (C) 2017 HabanaLabs Ltd.
+ *   Author: Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#include <unistd.h>
+#include "arcboot.h"
+#include "efuse.h"
+
+#define EFUSE_SYSCFG_ONIX_DEFAULT \
+				(EFUSE_SYSCFG_FW_VERSION_LOCATION_SPI | \
+				 EFUSE_SYSCFG_KEY_LOCATION_SPI | \
+				 EFUSE_SYSCFG_REVOKATION_LOCATION_SPI)
+
+int fuse_read(uint32_t word, uint32_t *val)
+{
+	int ret = -1;
+
+	if (word == EFUSE_SYSCFG_OFFSET) {
+		*val = EFUSE_SYSCFG_ONIX_DEFAULT;
+		ret = 0;
+	}
+
+	return ret;
+}
+
+void mem_cpy_wait_finish(void) {}
diff --git a/goya2_arc/pldm.c b/goya2_arc/pldm.c
new file mode 100644
index 0000000..3f6ceaa
--- /dev/null
+++ b/goya2_arc/pldm.c
