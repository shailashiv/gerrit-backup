From b51d74eeff6f399fb3b022733ccab3922b568125 Mon Sep 17 00:00:00 2001
From: Vitaly Margolin <vmargolin@habana.ai>
Date: Tue, 06 May 2025 08:37:51 +0300
Subject: [PATCH] [SW-227945] lfs: remove error msg if lfs disabled

Remove unneeded error message if LFS logging
is disabled

Change-Id: I90c3ecb85e05784aee083011f01660f4124b47f1
Signed-off-by: Vitaly Margolin <vmargolin@habana.ai>
---

diff --git a/app/io/preboot.c b/app/io/preboot.c
index d7654f1..9c14326 100644
--- a/app/io/preboot.c
+++ b/app/io/preboot.c
@@ -79,6 +79,7 @@
 		.setup = module_pci_setup,
 		.tid_get = module_pci_tid_get,
 		.shutdown = module_pci_shutdown,
+		.always_run = true,
 	},
 #endif
 #ifdef CONFIG_PREBOOT_MODULE_I2C_S
@@ -87,6 +88,7 @@
 		.setup = module_i2c_s_setup,
 		.tid_get = module_i2c_s_tid_get,
 		.shutdown = module_i2c_s_shutdown,
+		.always_run = true,
 	},
 #endif
 #ifdef CONFIG_PREBOOT_MODULE_FWUPD
@@ -95,6 +97,7 @@
 		.setup = module_fwupd_setup,
 		.tid_get = module_fwupd_tid_get,
 		.shutdown = module_fwupd_shutdown,
+		.always_run = true,
 	},
 #endif
 #ifdef CONFIG_PREBOOT_MODULE_FWUPD_OOB
@@ -103,6 +106,7 @@
 		.setup = module_oob_fwupd_setup,
 		.tid_get = module_oob_fwupd_tid_get,
 		.shutdown = module_oob_fwupd_shutdown,
+		.always_run = true,
 	},
 #endif
 #ifdef CONFIG_PREBOOT_MODULE_LKD
@@ -111,6 +115,7 @@
 		.setup = module_lkd_setup,
 		.tid_get = module_lkd_tid_get,
 		.shutdown = module_lkd_shutdown,
+		.always_run = true,
 	},
 #endif
 #ifdef CONFIG_LIBPLDM
@@ -119,12 +124,14 @@
 		.setup = module_pldm_setup,
 		.tid_get = module_pldm_tid_get,
 		.shutdown = module_pldm_shutdown,
+		.always_run = true,
 	},
 	{
 		.thread_name = "SENSORD-MODULE",
 		.setup = module_sensord_setup,
 		.tid_get = module_sensord_tid_get,
 		.shutdown = module_sensord_shutdown,
+		.always_run = true,
 	},
 #endif
 #ifdef CONFIG_PREBOOT_MODULE_APPWRQ
@@ -133,6 +140,7 @@
 		.setup = module_appwrq_setup,
 		.tid_get = module_appwrq_tid_get,
 		.shutdown = module_appwrq_shutdown,
+		.always_run = true,
 	},
 #endif
 #ifdef CONFIG_LFS_ENABLED
@@ -141,6 +149,7 @@
 		.setup = module_lfs_setup,
 		.tid_get = module_lfs_tid_get,
 		.shutdown = module_lfs_shutdown,
+		.always_run = false,
 	},
 #endif
 };
diff --git a/include/lib/module/cmd_module.h b/include/lib/module/cmd_module.h
index eb33a59..0ace47b 100644
--- a/include/lib/module/cmd_module.h
+++ b/include/lib/module/cmd_module.h
@@ -57,6 +57,7 @@
 	k_tid_t (*setup)(const char *thread_name);
 	k_tid_t (*tid_get)(void);
 	void (*shutdown)(void);
+	bool always_run;
 };
 
 /*
diff --git a/lib/module/cmd_module.c b/lib/module/cmd_module.c
index 8ce5cc1..a048711 100644
--- a/lib/module/cmd_module.c
+++ b/lib/module/cmd_module.c
@@ -109,8 +109,12 @@
 
 	for (i = 0; i < threads_num; i++) {
 		thread_id = cmd_threads[i].setup(cmd_threads[i].thread_name);
-		if (!thread_id)
-			LOG_ERR("Failed to spawn thread %s", cmd_threads[i].thread_name);
+		if (!thread_id) {
+			if (cmd_threads[i].always_run)
+				LOG_ERR("Failed to spawn thread %s", cmd_threads[i].thread_name);
+			else
+				LOG_INF("Thread %s was not spawned", cmd_threads[i].thread_name);
+		}
 	}
 }
 
