From 375606699c3bb7800f2ead58d8d9f6d3b0bb09af Mon Sep 17 00:00:00 2001
From: Arnon Kaufman <akaufman@habana.ai>
Date: Tue, 13 Feb 2024 17:49:38 +0200
Subject: [PATCH] sq refactor - add dsm

Signed-off-by: Arnon Kaufman <akaufman@habana.ai>
Change-Id: I4838cc5a0e8ccb702e746512eb1152ed7b7789c1
---

diff --git a/package/zephyr/zephyr.mk b/package/zephyr/zephyr.mk
index fed05c0..44132be 100644
--- a/package/zephyr/zephyr.mk
+++ b/package/zephyr/zephyr.mk
@@ -74,18 +74,8 @@
 endif
 
 ifdef BR2_PACKAGE_ZEPHYR_ARC_DSM
-ZEPHYR_COMPONENTS_LIST += dsm
-ZEPHYR_DSM_DIR = build-dsm
-ZEPHYR_CONF_DEFAULT ?= $(ZEPHYR_DSM_DIR)
-ZEPHYR_CONF_OPTS_DSM += -DBOARD=hl_$(DEVICE_NAME)_dsm_$(HL_TARGET)
-ZEPHYR_CONF_OPTS_DSM += -DDEVICE=$(DEVICE_NAME)
-ZEPHYR_DSM_SRCDIR = $(EMBEDDED_DIR)/zephyr-apps/pcie-ss/dsm
-ZEPHYR_CONF_OPTS_DSM += $(ZEPHYR_DSM_SRCDIR)
-ZEPHYR_CONFIGURE_CMDS += && $(ZEPHYR_CONF_ENV) $(HOST_DIR)/bin/cmake $(ZEPHYR_CONF_OPTS) $(ZEPHYR_CONF_OPTS_DSM) -B $(ZEPHYR_DSM_DIR)
-ZEPHYR_BUILD_CMDS += && $(TARGET_MAKE_ENV) $(MAKE) -C $(@D)/$(ZEPHYR_DSM_DIR)
-ZEPHYR_INSTALL_TARGET_CMDS += && $(INSTALL) -D -m 0644 $(@D)/$(ZEPHYR_DSM_DIR)/zephyr/zephyr.elf $(BINARIES_DIR)/zephyr_dsm.elf
+HL_ZEPHYR_PACKAGES += dsm
 endif
-
 
 ifdef BR2_PACKAGE_ZEPHYR_AGENT_FW_LOADER
 HL_ZEPHYR_PACKAGES += agent-fwl
