From cf72d91c2cc469b5175fd9cd911022bca96ea358 Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Fri, 13 Aug 2021 12:57:48 +0300
Subject: [PATCH] [SW-0] puts: fix the error strings output

Some error prints were overwritten by next print out due to those not
having the '\n' character at the end of the string.
Add the new line character to fix.

Change-Id: I0b8727905bacab799bf923484807bacef905c09c
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/arch/gaudi/arm/common.c b/arch/gaudi/arm/common.c
index 4be1914..3283d1e 100644
--- a/arch/gaudi/arm/common.c
+++ b/arch/gaudi/arm/common.c
@@ -238,7 +238,7 @@
 		 * timeout is used
 		 */
 		if (timeout_expired(start, PCIE_EXT_LD_TIMEOUT_US)) {
-			preboot_puts("Timed-out waiting for ext_ld_done!");
+			preboot_puts("Timed-out waiting for ext_ld_done!\n");
 			break;
 		}
 	}
diff --git a/arch/gaudi/arm/hbm.c b/arch/gaudi/arm/hbm.c
index c6fb2f5..0982e88 100644
--- a/arch/gaudi/arm/hbm.c
+++ b/arch/gaudi/arm/hbm.c
@@ -1395,7 +1395,7 @@
 		else
 			ret = dma_ch;
 	} else {
-		preboot_puts("hbm_pc: Illegal input");
+		preboot_puts("hbm_pc: Illegal input\n");
 		return -1;
 	}
 
@@ -1465,7 +1465,7 @@
 	int dma_ch;
 	struct hbm *hbm = &hbm_data;
 
-	preboot_puts("perform row repair");
+	preboot_puts("perform row repair\n");
 
 	if (hbm->row_replacement_iter[device] == MAX_ROW_REPLACEMENT_ITERATIONS) {
 		preboot_puts("Max row replacement iteration reached\n");
diff --git a/arch/greco/arc_elf32/common.c b/arch/greco/arc_elf32/common.c
index e294325..60be7d2 100644
--- a/arch/greco/arc_elf32/common.c
+++ b/arch/greco/arc_elf32/common.c
@@ -90,7 +90,7 @@
 u32 preboot_device_id_get(void)
 {
 	if (!pcie_dev_id)
-		preboot_puts("dev_id is not initialized");
+		preboot_puts("dev_id is not initialized\n");
 
 	return pcie_dev_id;
 }
diff --git a/arch/greco/common/common.c b/arch/greco/common/common.c
index cf713fe..d0b89b0 100644
--- a/arch/greco/common/common.c
+++ b/arch/greco/common/common.c
@@ -498,7 +498,7 @@
 		 * timeout is used
 		 */
 		if (timeout_expired(start, PCIE_EXT_LD_TIMEOUT_US)) {
-			preboot_puts("Timed-out waiting for ext_ld_done!");
+			preboot_puts("Timed-out waiting for ext_ld_done!\n");
 			break;
 		}
 	}
diff --git a/lib/preboot/fit.c b/lib/preboot/fit.c
index b9a562f..e60bd1d 100644
--- a/lib/preboot/fit.c
+++ b/lib/preboot/fit.c
@@ -1048,7 +1048,7 @@
 	if (conf >= 0) {
 		cell = fdt_getprop(fit, conf, FIT_LOAD_TYPE_PROP, &len);
 		if (!cell) {
-			preboot_puts("load type does not exist!");
+			preboot_puts("load type does not exist!\n");
 			*load_type = type;
 			return 0;
 		}
@@ -1090,13 +1090,13 @@
 
 	images_noffset = fdt_path_offset(fit, FIT_IMAGES_PATH);
 	if (images_noffset < 0) {
-		preboot_puts("Can't find images parent node");
+		preboot_puts("Can't find images parent node\n");
 		return images_noffset;
 	}
 
 	noffset = fdt_subnode_offset(fit, images_noffset, image_uname);
 	if (noffset < 0)
-		preboot_puts("Can't get node offset for image unit name");
+		preboot_puts("Can't get node offset for image unit name\n");
 
 	return noffset;
 }
