From 3534a0fbb2657e0260c30129f5211131e2240315 Mon Sep 17 00:00:00 2001
From: Karthikeyan K <karthikk@habana.ai>
Date: Wed, 08 Dec 2021 09:41:12 +0200
Subject: [PATCH] [SW-63186] gaudi2: sec: set axprot for arc farm

Configure arc farm regsiters to secured level using axprot.

Change-Id: Iebac82f80db992f920c23a3fc6c3d0adde51ed3b
---

diff --git a/arch/gaudi2/common/security.c b/arch/gaudi2/common/security.c
index 00fe460..bf33220 100644
--- a/arch/gaudi2/common/security.c
+++ b/arch/gaudi2/common/security.c
@@ -37,6 +37,8 @@
 #include <rot0_mstr_if_core_lbw_regs.h>
 #include <dcore0_hmmu0_mstr_if_core_hbw_regs.h>
 #include <pmmu_hbw_mstr_if_core_hbw_regs.h>
+#include <arc_farm_kdma_mstr_if_core_hbw_regs.h>
+#include <arc_farm_kdma_mstr_if_core_lbw_regs.h>
 
 /*
  * instances_num : Number of instances of RR to program.
@@ -1006,6 +1008,14 @@
 	regmap_writel(AXPROT_SEC_VAL, mmPMMU_HBW_MSTR_IF_CORE_HBW_AXPROT_OVRD);
 }
 
+static void preboot_secure_arc_farm(void)
+{
+	/* Set arc farm to secure level */
+	regmap_writel(AXPROT_SEC_VAL, mmARC_FARM_KDMA_MSTR_IF_CORE_HBW_AXPROT_OVRD);
+
+	regmap_writel(AXPROT_SEC_VAL, mmARC_FARM_KDMA_MSTR_IF_CORE_LBW_AXPROT_OVRD);
+}
+
 void preboot_security_init(void)
 {
 	preboot_secure_pcie();
@@ -1018,6 +1028,7 @@
 		preboot_secure_rot();
 		preboot_secure_hmmu();
 		preboot_secure_pmmu();
+		preboot_secure_arc_farm();
 		preboot_secure_lbw();
 		preboot_secure_hbw();
 		preboot_puts("Security enabled.\n");
