From cc5812a387812ed32be0271d8aeadb49e6fdb75b Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Sun, 07 Apr 2019 15:00:59 +0300
Subject: [PATCH] [SW-0] uart: update reg name to be like in specs

rename mmPSOC_UART_0_STATUS to mmPSOC_UART_0_STATE (as in specs project)

Change-Id: I26649e713b6c7868ec334082265348a162e60587
---

diff --git a/common/uart.c b/common/uart.c
index eaba0c6..09e9c7a 100644
--- a/common/uart.c
+++ b/common/uart.c
@@ -9,7 +9,7 @@
 #include <mach/hl_regs.h>
 
 #define mmPSOC_UART_0_DATA		(HL_CFG_BASE + 0xC45000)
-#define mmPSOC_UART_0_STATUS		(HL_CFG_BASE + 0xC45004)
+#define mmPSOC_UART_0_STATE		(HL_CFG_BASE + 0xC45004)
 #define UART_SR_TXFULL			(1 << 0) /* TX Buffer Full */
 #define STR_UINT_SZ			8
 
@@ -18,7 +18,7 @@
 	int i;
 
 	for (i = 0; str[i] && (i < 128); i++) {
-		while (readl(mmPSOC_UART_0_STATUS) & UART_SR_TXFULL)
+		while (readl(mmPSOC_UART_0_STATE) & UART_SR_TXFULL)
 			;
 		writel(str[i], mmPSOC_UART_0_DATA);
 		preboot_putc_virt_uart(str[i]);
