From 3df1716977af5d5dfc9a4a1f3045e53f692a6f41 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Wed, 15 Aug 2018 13:23:58 +0300
Subject: [PATCH] hl: make: fix {dali,gaudi}-prepare

Used correct defconfig file.
---

diff --git a/Makefile b/Makefile
index c1dfeba..ae074a1 100644
--- a/Makefile
+++ b/Makefile
@@ -60,11 +60,11 @@
 dali-onix-target dali-pldm-target dali-asic-target: hl-dali
 	@echo "export HL_TARGET=$(patsubst dali-%-target,%,$@)"	>> $(HL_VARS_FILE)
 
-$(OUTPUT_DIR)/.config: $(BR2_EXTERNAL)/configs/dali_defconfig
-	@$(MAKE) $(<F)
 .PHONY: dali-prepare gaudi-prepare
-gaudi-prepare: $(OUTPUT_DIR)/.config $(BR2_EXTERNAL)/configs/gaudi_defconfig
-dali-prepare: $(OUTPUT_DIR)/.config $(BR2_EXTERNAL)/configs/dali_defconfig
+gaudi-prepare: $(BR2_EXTERNAL)/configs/gaudi_defconfig
+	@$(MAKE) $(<F)
+dali-prepare: $(BR2_EXTERNAL)/configs/dali_defconfig
+	@$(MAKE) $(<F)
 
 .PHONY: dali-onix-build dali-pldm-build dali-asic-build gaudi-onix-build
 gaudi-onix-build: gaudi-onix-target
