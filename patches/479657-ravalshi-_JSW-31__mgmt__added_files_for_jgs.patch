+
+static bool is_i2c_recovery_available(const struct device *i2c_dev)
+{
+	const struct cpld_i2c_recovery_api *i2c_recovery_api;
+	bool res = false;
+
+	i2c_recovery_api = get_cpld_i2c_recovery_api();
+
+	if (i2c_recovery_api)
+		res = i2c_recovery_api->is_cpld_recovery_available(i2c_dev);
+
+	return res;
+}
+
+static int cpld_i2c_recovery_event_handler(const struct device *i2c_dev)
+{
+	if (i2c_recovery_in_process)
+		return 0;
+
+	if (!is_i2c_recovery_available(i2c_dev))
+		return 1;
+
+	i2c_recovery_in_process = true;
+
+	i2c_recovery_in_process = false;
+
+	return 0;
+}
+
+void hl_cpld_i2c_recovery_init(void)
+{
+	const struct cpld_i2c_recovery_api *i2c_recovery_api;
+
+	i2c_recovery_api = get_cpld_i2c_recovery_api();
+
+	if (i2c_recovery_api)
+		i2c_recovery_api->set_recovery_event_handler(cpld_i2c_recovery_event_handler);
+	else
+		LOG_ERR("Failed to get I2C recovery API");
+}
+
