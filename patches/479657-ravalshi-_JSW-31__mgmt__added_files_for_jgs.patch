diff --git a/arch/jgs/compute/device.c b/arch/jgs/compute/device.c
new file mode 100644
index 0000000..24d9eda
--- /dev/null
+++ b/arch/jgs/compute/device.c
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: Apache-2.0
+/*
+ *
+ * Copyright 2024 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <zephyr/kernel.h>
+#include <common.h>
+#include <bridge_if.h>
+#include <ipm.h>
+#include <hl_devs.h>
+
+#define LOG_LEVEL CONFIG_LOG_DEFAULT_LEVEL
+#include <zephyr/logging/log.h>
+LOG_MODULE_DECLARE(SYSMNGD_LOG_ID);
+
+#define BRIDGE_SIZE_MIN		4
+#define BRIDGE_SIZE_MAX		36
+
+static void i2a_bridge_process_cst_wake(struct mgmt_compute_config *config)
+{
+	/* clear interrupt */
+	ipm_clear(config->bridge_wq_data.dev, 0);
+
+	/* Step1: Workpoint */
+
+	/* Step2: GO DEC */
+
+	/* Step3: GT performs Clear core state */
+
+	/*
+	 * Step4: ACK GO DEC from GT
+	 * TODO: Is it interrupt to FW? Does it indicates step3 is done?
+	 */
+
+	/* Step5: GO RESUME */
+
+	/* Step6: ACK GO DEC from GT TODO: is it interrupt to FW? */
+
+}
+
+static void i2a_bridge_process_ip_ready(struct mgmt_compute_config *config)
+{
+
+	/* clear interrupt */
+	ipm_clear(config->bridge_wq_data.dev, 0);
+
+	/* TODO: Details on TSC download command */
+}
+
+static void i2a_bridge_process_fuse_pull(struct mgmt_compute_config *config)
+{
+	/* TODO: fuse read and delivery */
+
+	/* clear interrupt */
+	ipm_clear(config->bridge_wq_data.dev, 0);
+}
+
+static void i2a_bridge_work_handler(struct k_work *work)
+{
+	struct mgmt_compute_config *config = mgmt_get_compute_cfg();
+	struct bridge_simple_msg *msg;
+	uint32_t size = config->bridge_wq_data.size;
+
+	if ((size < BRIDGE_SIZE_MIN) || (size > BRIDGE_SIZE_MAX)) {
+		LOG_ERR("Invalid size received from driver, clear interrupt");
+		ipm_clear(config->bridge_wq_data.dev, 0);
+		return;
+	}
+
+	/* decode header */
+	msg = (struct bridge_simple_msg *) config->bridge_wq_data.ptr;
+	LOG_INF("Received OPCODE: 0x%x from PORT_ID: 0x%x size: %d from I2A bridge",
+			msg->opcode, msg->source_port_id, config->bridge_wq_data.size);
+
+	/*
+	 * TODO: add processing of opcodes
+	 * some opcodes will need CR write as action to request and some
+	 * opcodes will need new response via I2C bridge in which case
+	 * create the header + data required and perform ipm_send.
+	 * CR details yet to be updated by ARCH team.
+	 */
+	switch (msg->opcode) {
+	case BRIDGE_OPCODE_CST_WAKE:
+		i2a_bridge_process_cst_wake(config);
+		break;
+	case BRIDGE_OPCODE_IP_READY:
+		i2a_bridge_process_ip_ready(config);
+		break;
+	case BRIDGE_OPCODE_FUSE_PULL:
+		i2a_bridge_process_fuse_pull(config);
+		break;
+	default:
+		LOG_ERR("OPCODE: 0x%x not supported", msg->opcode);
+		break;
+	}
+
+	/* clear interrupt */
+	ipm_clear(config->bridge_wq_data.dev, 0);
+}
+
+static void i2a_bridge_callback(const struct device *dev,
+				void *context, uint32_t size, void *data)
+{
+	struct mgmt_compute_config *config = mgmt_get_compute_cfg();
+
+	config->bridge_wq_data.size = size;
+	config->bridge_wq_data.ptr = (void *) data;
+	config->bridge_wq_data.dev = dev;
+	k_work_submit(&config->bridge_work);
+}
+
+static int fs_init_bridge(void)
+{
+	struct mgmt_compute_config *config = mgmt_get_compute_cfg();
+
+	config->bridge_dev = I2A_DEV_INST;
+	if (!config->bridge_dev) {
+		LOG_ERR("Failed to get pointer to I2A bridge device!");
+		return -ENODEV;
+	}
+
+	k_work_init(&config->bridge_work, i2a_bridge_work_handler);
+
+	ipm_register_callback(config->bridge_dev, i2a_bridge_callback, config);
+	ipm_set_enabled(config->bridge_dev, true);
+	return 0;
+}
+
+
+int mgmt_dev_prepare(void)
+{
+	struct mgmt_compute_config *config = mgmt_get_compute_cfg();
+
+	config->init_bridge = fs_init_bridge;
+	return 0;
+}
