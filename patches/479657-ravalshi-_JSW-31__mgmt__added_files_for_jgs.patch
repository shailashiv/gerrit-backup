+ * All Rights Reserved.
+ */
+
+#include <dev_queue_packets.h>
+#include <cpucp_resp_if.h>
+
+#define LOG_LEVEL                       CONFIG_LOG_DEFAULT_LEVEL
+
+#include <zephyr/logging/log.h>
+LOG_MODULE_DECLARE(fs1_queues_packet);
+
+/* TODO: Remove this once frequency is retrieved from pll driver. */
+struct fs1_pll_info pll_info_array[CPUCP_PLL_IDX_MAX] = {
+	{CPUCP_PLL_PCIE, 2000, 1000, 500, 100},
+	{CPUCP_PLL_PSOC, 1000, 500, 200, 50},
+	{CPUCP_PLL_NIC, 800, 533, 400, 100},
+	{CPUCP_PLL_DEC, 1000, 500, 500, 125},
+	{CPUCP_PLL_ENC, 1000, 500, 500, 125},
+	{CPUCP_PLL_HBM, 1600, 800, 200, 100},
+	{CPUCP_PLL_GT_CU, 1600, 1600, 400, 200},
+	{CPUCP_PLL_GT_SB, 1200, 600, 400, 25},
+	{CPUCP_PLL_DMA, 1600, 800, 400, 200},
+	{CPUCP_PLL_C2C, 2000, 1000, 500, 200},
+	{CPUCP_PLL_D2D, 2000, 667, 500, 200},
+	{CPUCP_PLL_SGAM, 1600, 1600, 1600, 1600}
+};
+
+int queue_dev_get_pll_index_info(uint32_t pll_index, struct cpucp_resp_pll_info_get *pll_info_get)
+{
+
+	if (pll_index == 0 || pll_index > CPUCP_PLL_IDX_MAX)
+		return -EINVAL;
+
+	pll_info_get->size = sizeof(struct cpucp_resp_pll_info_get);
+	pll_info_get->div0_freq = pll_info_array[pll_index - 1].div0_freq;
+	pll_info_get->div1_freq = pll_info_array[pll_index - 1].div1_freq;
+	pll_info_get->div2_freq = pll_info_array[pll_index - 1].div2_freq;
+	pll_info_get->div3_freq = pll_info_array[pll_index - 1].div3_freq;
+
+	return 0;
+}
