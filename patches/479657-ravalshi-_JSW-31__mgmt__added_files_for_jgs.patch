+void ras_init(struct hl_dev_config *dev_config) {}
+void hl_dev_spec_en_pci_access(void) {}
+
+#define FS_QUEUE_SCRATCHPAD_ADDR_HI	0xF8830000
+#define FS_QUEUE_SCRATCHPAD_ADDR_LO	0xF8820000
+
+/* TODO: change these macros according to specs file */
+#define FS_QUEUE_SPSRAM_EXTEN_ADDR	0x70000000
+#define FS_QUEUE_HBW_EXTN_ADDR		0x10000000
+void queue_dev_update_arc_addr_extn(uint32_t addr_hi, uint32_t addr_lo,
+				    uint32_t *extn_addr, bool *extn_set)
+{
+	struct hl_dev_config *dev_config = hl_get_dev_cfg();
+
+	if (addr_lo >= FS_QUEUE_SCRATCHPAD_ADDR_LO && addr_hi <= FS_QUEUE_SCRATCHPAD_ADDR_HI)
+		*extn_addr = FS_QUEUE_SPSRAM_EXTEN_ADDR;
+	else {
+		CFG_WREG32((mmIO_0_CFG_PSOC_ARC_MNG_BASE + mmARC_HBW_OFFSET_REGION_1), 0x0);
+		CFG_WREG32((mmIO_0_CFG_PSOC_ARC_MNG_BASE + mmARC_HBW_MSB_ADDR_REGION_1),
+			addr_hi);
+		CFG_WREG32((mmIO_0_CFG_PSOC_ARC_MNG_BASE + mmARC_HBW_LSB_ADDR_REGION_1),
+			addr_lo & 0xFFFFFFF);
+
+		*extn_addr = FS_QUEUE_HBW_EXTN_ADDR;
+	}
+
+	*extn_set = true;
+	dev_config->boot_done = true;
+}
