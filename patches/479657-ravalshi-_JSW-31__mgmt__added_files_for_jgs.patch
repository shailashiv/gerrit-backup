+}
+
+void cpu_boot_if_dev_spec_regs_init(struct cpu_boot_if_regs *regs)
+{
+	/* boot_if module wants the full address */
+	regs->status = HL_CFG_BASE + IO0_H0_PSOC_GLOBAL_CONF(mmGLOBAL_CONF_CPU_BOOT_STATUS);
+	regs->response = HL_CFG_BASE + mmCPU_CMD_STATUS_TO_HOST;
+	regs->kmd_msg_to_cpu = HL_CFG_BASE + IO0_H0_PSOC_GLOBAL_CONF(mmGLOBAL_CONF_KMD_MSG_TO_CPU);
+	regs->hw_state = HL_CFG_BASE + mmHW_STATE;
+	regs->err[0] = HL_CFG_BASE + mmCPU_BOOT_ERR0;
+	regs->err[1] = HL_CFG_BASE + mmCPU_BOOT_ERR1;
+	regs->dev_sts[0] = HL_CFG_BASE + mmCPU_BOOT_DEV_STS0;
+	regs->dev_sts[1] = HL_CFG_BASE + mmCPU_BOOT_DEV_STS1;
+}
