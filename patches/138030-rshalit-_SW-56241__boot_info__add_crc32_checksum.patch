From 2064c4205c08d3ff12470b36044813d893cdd0e2 Mon Sep 17 00:00:00 2001
From: ran shalit <rshalit@habana.ai>
Date: Mon, 18 Oct 2021 20:35:47 +0300
Subject: [PATCH] [SW-56241] boot_info: add crc32 checksum

Add crc32 in hl_boot_info_desc struct.
In addition, a version represent the checksum
algo and the checksum data in struct, i.e.
version #0 is for sha256 with checksum field in
struct, and version #1 is for crc32 with crc32 field
in struct (version number is set in zephyr config).
This design is more generic then code dependent,
and was proposed by IgorG.

Change-Id: I61eb79fa47f34368757129f9603a2a0ba92ca7fb
Signed-off-by: ran shalit <rshalit@habana.ai>
---

diff --git a/arch/gaudi/arm/common.c b/arch/gaudi/arm/common.c
index a51cadf..91dad3a 100644
--- a/arch/gaudi/arm/common.c
+++ b/arch/gaudi/arm/common.c
@@ -26,6 +26,7 @@
 #include <hl_boot_if.h>			/* requires stdint.h */
 #include <boot_if.h>
 #include <gaudi/gaudi_reg_map.h>
+#include <gaudi/gaudi_boot_info.h>
 #include <gaudi/gaudi_fw_if.h>
 #include <common/pci_ids.h>
 #include <cpu_ca53_cfg_regs.h>
@@ -616,3 +617,8 @@
 	if (__stack2 != STACK_CANARY_MAGIC_WORD)
 		cpu_boot_err_set(CPU_BOOT_ERR_BOOT_FW_CRIT_ERR);
 }
+
+u16 hl_get_boot_info_ver(void)
+{
+	return HL_BOOT_INFO_VERSION;
+}
