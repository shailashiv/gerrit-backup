+	};
+	uint16_t hdr_sz;
+	uint8_t reserved4[2];
+} __packed;
+
+struct rma_failure {
+	union {
+		struct {
+			uint8_t sram_ecc : 1;
+			uint8_t hbm_ecc : 1;
