@@ -0,0 +1,110 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright 2016-2023 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#ifndef _HABANALABS_GPU_FW_UPD_IF_H_
+#define _HABANALABS_GPU_FW_UPD_IF_H_
+
+/* Be able to address the whole SRAM */
+#define HL_UPD_STS_OFFSET_MASK	0xF8000000
+/* Be able to have FW up to 16MB */
+#define HL_UPD_CMD_SIZE_MASK	0xFF000000
+
+enum fw_post_reset_cmd {
+	FLOPS_UPD_NOOP = 0,
+	FLOPS_UPD_NXT_IMG1,
+	FLOPS_UPD_NXT_IMG2,
+	FLOPS_UPD_PENDING,
+	FLOPS_EEPROM_UPDATED,
+	FLOPS_CPLD_UPDATED,
+	FLOPS_FUSE_PENDING,
+	FLOPS_EROM_UPDATED,
+};
+
+enum hl_upd_cmd {
+	HL_UPD_NOOP = 0,
+	HL_UPD_CLR_STS,
+	HL_UPD_RST_STATE,
+	HL_UPD_MAP_FLASH,
+	HL_UPD_MAP_EEPROM,
+	HL_UPD_PROG_FLASH,
+	HL_UPD_PROG_EEPROM,
+	HL_UPD_RST_DEV,
+	HL_UPD_MAP_CPLD,
+	HL_UPD_PROG_CPLD,
+	HL_UPD_MAP_SRAM,
+	HL_UPD_RUN_SRAM,
+	HL_UPD_GET_STATUS,
+	HL_UPD_MAP_ELBI,
+	HL_UPD_RUN_ELBI,
+	HL_UPD_GET_PROTO_STATUS,
+};
+
+enum hl_upd_sts {
+	HL_UPD_STS_NOOP = 0,
+	HL_UPD_STS_MAP_OK,
+	HL_UPD_STS_MAP_ERR,
+	HL_UPD_STS_MAP_ACK,
+	HL_UPD_STS_RUN_OK = 4,
+	HL_UPD_STS_PROG_OK = 4,
+	HL_UPD_STS_GET_STATUS_OK = 4,
+	HL_UPD_STS_OK = 4,
+	HL_UPD_STS_RUN_ERR = 5,
+	HL_UPD_STS_PROG_ERR = 5,
+	HL_UPD_STS_GET_STATUS_ERR = 5,
+	HL_UPD_STS_ERR = 5,
+	HL_UPD_STS_RUN_ACK = 6,
+	HL_UPD_STS_PROG_ACK = 6,
+	HL_UPD_STS_GET_STATUS_ACK = 6,
+	HL_UPD_STS_ACK = 6,
+	HL_UPD_STS_RST_OK,
+	HL_UPD_STS_RST_ACK,
+	HL_UPD_STS_RST_ERR,
+	HL_UPD_STS_VALID_ERR,
+	HL_UPD_STS_TIMEOUT_ERR,
+	HL_UPD_STS_REPEAT,
+	HL_UPD_STS_INVLD_LAST
+};
+
+struct hl_upd_command {
+	union {
+		struct {
+			uint32_t size :24;
+			uint32_t reserved :4;
+			enum hl_upd_cmd cmd:4;
+		} __packed;
+		uint32_t val;
+	};
+};
+
+struct hl_upd_status {
+	union {
+		struct {
+			uint32_t offset :27;
+			uint32_t reserved :1;
+			enum hl_upd_sts status:4;
+		} __packed;
+		uint32_t val;
+	};
+};
+
+#define HL_UPD_PROTO_VERSION		1
+#define HL_UPD_PROTO_VERSION_INVALID	~0U
+
+struct hl_upd_proto_status {
+	union {
+		struct {
+			uint64_t compat_mask;
+			uint32_t version;
+			uint32_t fw_comp; /* firmware component */
+			uint32_t err;
+			uint32_t sub_err;
+		} __packed;
+		uint32_t val[6];
+	};
+};
+
+#endif /* _HABANALABS_GPU_FW_UPD_IF_H_ */
