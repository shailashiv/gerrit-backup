+
+/**
+ * struct cpucp_component_type - component type
+ * @CPUCP_COMP_TYPE_NIC: NIC
+ * @CPUCP_COMP_TYPE_MEDIA: MEDIA
+ */
+enum cpucp_component_type {
+	CPUCP_COMP_TYPE_NIC,
+	CPUCP_COMP_TYPE_MEDIA,
+	CPUCP_COMP_TYPE_MAX
+};
+
+/**
+ * struct cpucp_dvsec_type - dvsec type
+ * @CPUCP_DVSEC_TYPE_PMON: Performance Monitoring
+ * @CPUCP_DVSEC_TYPE_TELEMETRY: TELEMETRY
+ * @CPUCP_DVSEC_TYPE_WATCHER: WATCHER
+ * @CPUCP_DVSEC_TYPE_CRASHLOG: CRASHLOG
