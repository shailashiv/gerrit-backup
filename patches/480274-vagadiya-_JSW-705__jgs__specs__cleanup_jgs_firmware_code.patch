@@ -0,0 +1,209 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright 2016-2023 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#ifndef _HABANALABS_GPU_FW_IF_H_
+#define _HABANALABS_GPU_FW_IF_H_
+
+#define SHA256_SUM_LEN		32
+#define SHA384_SUM_LEN		48
+
+/* Enabled firmware capabilities bit number */
+enum hl_fw_en_caps {
+	/* indicate whether or not the firmware can handle a hard reset */
+	HL_FW_EN_CAPS_HARD_RESET,
+	/* LKD requests to skip waiting for BMC data */
+	HL_FW_EN_CAPS_SKIP_BMC,
+	HL_FW_EN_CAPS_MEM_CLR,		/* FW cleared memories */
+};
+
+enum hl_fw_error {
+	HL_FW_ERR_NONE = 0,
+	HL_FW_ERR_PROTO = 1,
+	HL_FW_ERR_FIT = 2,
+	HL_FW_ERR_SECURITY = 3,
+	HL_FW_ERR_EEPROM = 4,
+	HL_FW_ERR_LAST
+};
+
+enum hl_sec_error {
+	HL_SEC_ERR_NONE = 0,
+	HL_SEC_ERR_SVN_INVALID = 1,
+	HL_SEC_ERR_KEY_REVOKED = 2,
+	HL_SEC_ERR_SIGN_FAILED = 3,
+	HL_SEC_ERR_LAST
+};
+
+enum hl_fw_fit_boot_error {
+	HL_FW_FIT_BOOT_ERR_NONE = 0,
+	HL_FW_FIT_BOOT_ERR_CORRUPTED,
+	HL_FW_FIT_BOOT_ERR_ADDRESS_VIOLATION,
+	HL_FW_FIT_BOOT_ERR_NOT_RUNNABLE,
+	HL_FW_FIT_BOOT_ERR_REVOKED_KEY,
+	HL_FW_FIT_BOOT_ERR_SVN,
+	HL_FW_FIT_BOOT_ERR_SIGNATURE,
+	HL_FW_FIT_BOOT_ERR_LAST
+};
+
+enum hl_fw_reset_cause {
+	HL_FW_RESET_CAUSE_UNKNOWN = 0,
+	HL_FW_RESET_CAUSE_HEARTBEAT,
+	HL_FW_RESET_CAUSE_TDR,
+	HL_FW_RESET_CAUSE_WATCHDOG,
+};
+
+enum hl_eeprom_error {
+	HL_EEPROM_SUCCESS = 0,
+	HL_EEPROM_ERR_DEV_FAIL = 1,
+	HL_EEPROM_ERR_CRC_FAIL = 2,
+	HL_EEPROM_ERR_REC_DATA_FAIL = 3,
+	HL_EEPROM_ERR_LAST
+};
+
+enum hl_fw_comp {
+	HL_FW_COMP_NONE,
+	HL_FW_COMP_PREBOOT,
+	HL_FW_COMP_UBOOT,
+	HL_FW_COMP_ZEPHYR,
+	HL_FW_COMP_EROM,
+	HL_FW_COMP_ROM,
+	HL_FW_COMP_LAST
+};
+
+
+#define HL_FW_INFO_VERSION	2
+
+struct hl_fw_info_compat {
+	uint32_t version;
+	uint8_t reset_cause; /* nvme enum hl_fw_reset_cause */
+	uint8_t razwi_errors_count;
+	uint8_t eeprom_err;
+	uint8_t spi_flash_checksum_err;
+	uint16_t fit_failure;
+	uint8_t spi_sec_failure;
+	uint8_t agent_sec_failure;
+	uint8_t sec_curr_key;
+	uint8_t sec_curr_svn;
+	uint8_t sec_min_svn;
+	uint8_t sec_revoked_keys;
+	uint8_t hbm_mbist_row_repair_done;
+	uint8_t wd_disable;
+	uint8_t nic_sts;
+	uint8_t eeprom_def_boot_en;
+	uint32_t rst_cause_reg_offset;
+	uint32_t device_activity_counter;
+	uint8_t perm_acc_err;
+	uint8_t cpld_checksum_err;
+	uint8_t cpld_version;
+	uint8_t last_reset_source; /* plat specific reset cause such as enum gaudi3_rst_src_bit */
+	uint32_t ext_fw_low_addr;
+	uint32_t ext_fw_high_addr;
+	uint32_t ext_fw_size;
+	uint32_t cpu_boot_err_val[2];	/* boot error registers for passing between components */
+	uint32_t fw_rsvd_mem_mb;	/* reserved DRAM memory size in MB for FW/SVE use */
+	uint8_t i2c_saddr_peer;
+	uint8_t mctp_eid_local;
+	uint8_t mctp_eid_peer;
+	uint8_t pldm_tid_local;
+	uint32_t cpu_boot_sts_val[2];	/* boot status registers for passing between components */
+} __packed;
+
+
+#define HL_MEM_INFO_VERSION	1
+
+#define HL_NVME_MAX_ECC_SIZE	64
+#define HL_SRAM_ARRAYS_COUNT	3
+#define HL_HBM_ARRAYS_COUNT	3
+
+#define HL_NVME_MAX_PARITY_SIZE	64
+#define HL_PARITY_QUEUE_SIZE	(sizeof(uint32_t) + HL_NVME_MAX_PARITY_SIZE * sizeof(uint16_t))
+
+#define SRAM_ECC_QUEUE_WORDS	(HL_NVME_MAX_ECC_SIZE * HL_SRAM_ARRAYS_COUNT + 1)
+#define HBM_ECC_QUEUE_WORDS	(HL_NVME_MAX_ECC_SIZE * HL_HBM_ARRAYS_COUNT + 1)
+#define PARITY_QUEUE_WORDS	(HL_PARITY_QUEUE_SIZE / sizeof(uint32_t))
+
+struct hl_mem_hbm_bank_replacement_counters {
+	uint32_t hbm_banks_replaced_none;
+	uint32_t hbm_banks_replaced_low;
+	uint32_t hbm_banks_replaced_partial;
+	uint32_t hbm_banks_replaced_high;
+	uint32_t hbm_banks_replaced_max;
+};
+
+struct hl_mem_info_compat {
+	uint32_t version;
+	uint16_t sram_derr_count;
+	uint16_t sram_serr_count;
+	uint16_t sram_serr_threshold;
+	uint16_t hbm_derr_count;
+	uint16_t hbm_serr_count;
+	uint16_t hbm_serr_threshold;
+	uint8_t hbm_catastrophic_temp;
+	uint8_t rsvd[3];
+	uint32_t sram_serr_data[SRAM_ECC_QUEUE_WORDS];
+	uint32_t sram_derr_data[SRAM_ECC_QUEUE_WORDS];
+	uint32_t hbm_serr_data[HBM_ECC_QUEUE_WORDS];
+	uint32_t hbm_derr_data[HBM_ECC_QUEUE_WORDS];
+	uint32_t hbm_ca_parity[PARITY_QUEUE_WORDS];
+	uint32_t hbm_wr_parity[PARITY_QUEUE_WORDS];
+	uint32_t hbm_rd_parity[PARITY_QUEUE_WORDS];
+	uint16_t sram_derr_events;
+	uint16_t sram_fatal_events;
+	uint16_t sram_serr_bursts;
+	uint16_t hbm_derr_events;
+	uint16_t hbm_fatal_events;
+	uint16_t hbm_serr_bursts;
+	uint16_t hbm_fatal_parity;
+	struct hl_mem_hbm_bank_replacement_counters bank_replacement_counters;
+};
+
+#define HL_VUART_MAGIC_VER(v)	(0x86828400 | (v)) /* VRTx */
+#define HL_VUART_MAGIC		HL_VUART_MAGIC_VER(0)
+
+struct hl_vuart_queue {
+	uint32_t magic;
+	uint32_t head;
+	uint32_t tail;
+	uint8_t data[];
+};
+
+struct hl_linux_pcr {
+	uint8_t sha[SHA384_SUM_LEN];
+};
+
+enum hl_sku_type {
+	HL_SINGLE_DIE_SKU = 0,
+	HL_DUAL_DIE_SKU,
+	HL_MAX_DIE_SKU = 255,
+};
+
+enum hl_die_id {
+	HL_DIE_ID_0 = 0,
+	HL_DIE_ID_1,
+	HL_DIE_ID_MAX = 255,
+};
+
+enum pwr_reduction_modes {
+	PWRRDT_MODE_0 = 0,
+	PWRRDT_MODE_1,
+	PWRRDT_MODE_2,
+	PWRRDT_MODE_3,
+	PWRRDT_MODE_MAX = PWRRDT_MODE_3
+};
+
+enum hl_serdes_link_id {
+	HLS2_SERDES_LINK_ID = 0b00000,
+	HLS2_TYPE_1_SERDES_LINK_ID = 0b10000,
+	HLS2_UNKNOWN_SERDES_LINK_ID = 0b11111,
+	HLS3_FULLSCALE_IN_SERDES_LINK_ID = 0b00001,
+	HLS3_FULLSCALE_OUT_SERDES_LINK_ID = 0b00010,
+	HLS3_FULL_OAM_3PORTS_SCALE_OUT_SERDES_LINK_ID = 0b11111,
+	HLS3_FULL_OAM_6PORTS_SCALE_OUT_SERDES_LINK_ID = 0b00110,
+	HLS3_SINGLEPORT_OAM_FULLSCALE_OUT_SERDES_LINK_ID = 0b10011,
+	HLS3_UNKNOWN_SERDES_LINK_ID = 0b00000,
+};
+
+#endif /* _HABANALABS_GPU_FW_IF_H_ */
diff --git a/gpu/common/hl_fw_upd_if.h b/gpu/common/hl_fw_upd_if.h
