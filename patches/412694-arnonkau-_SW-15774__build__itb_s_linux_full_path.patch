diff --git a/board/habanalabs/common/linux-pldm.its b/board/habanalabs/common/linux-pldm.its
index e758c60..dd9d44a 100644
--- a/board/habanalabs/common/linux-pldm.its
+++ b/board/habanalabs/common/linux-pldm.its
@@ -15,7 +15,7 @@
 	images {
 		kernel-1 {
 			description = "Linux kernel";
-			data = /incbin/("Image");
+			data = /incbin/("@LINUX_PROD_DIR@Image");
 			type = "kernel";
 			arch = "arm64";
 			os = "linux";
@@ -25,7 +25,7 @@
 		};
 		fdt-1 {
 			description = "Flattened Device Tree blob";
-			data = /incbin/("@HL_TARGET@.dtb");
+			data = /incbin/("@LINUX_DTB_DIR@@HL_TARGET@.dtb");
 			type = "flat_dt";
 			arch = "arm64";
 			compression = "none";
@@ -33,7 +33,7 @@
 		};
 		ramdisk-1 {
 			description = "ramdisk";
-			data = /incbin/("rootfs.cpio");
+			data = /incbin/("@LINUX_ROOTFS_DIR@rootfs.cpio");
 			type = "ramdisk";
 			arch = "arm64";
 			os = "linux";
diff --git a/board/habanalabs/common/linux.its b/board/habanalabs/common/linux.its
index 713cc98..9ab3ad5 100644
--- a/board/habanalabs/common/linux.its
+++ b/board/habanalabs/common/linux.its
@@ -15,7 +15,7 @@
 	images {
 		kernel-1 {
 			description = "Linux kernel";
-			data = /incbin/("Image.gz");
+			data = /incbin/("@LINUX_PROD_DIR@Image.gz");
 			type = "kernel";
 			arch = "arm64";
 			os = "linux";
@@ -31,7 +31,7 @@
 		};
 		fdt-1 {
 			description = "Flattened Device Tree blob";
-			data = /incbin/("@HL_TARGET@.dtb");
+			data = /incbin/("@LINUX_DTB_DIR@@HL_TARGET@.dtb");
 			type = "flat_dt";
 			arch = "arm64";
 			compression = "none";
@@ -42,7 +42,7 @@
 		};
 		ramdisk-1 {
 			description = "ramdisk";
-			data = /incbin/("rootfs.cpio.gz");
+			data = /incbin/("@LINUX_ROOTFS_DIR@rootfs.cpio.gz");
 			type = "ramdisk";
 			arch = "arm64";
 			os = "linux";
diff --git a/board/habanalabs/common/post-image-fit-global.sh b/board/habanalabs/common/post-image-fit-global.sh
index 0ab3220..5c65b48 100755
--- a/board/habanalabs/common/post-image-fit-global.sh
+++ b/board/habanalabs/common/post-image-fit-global.sh
@@ -61,6 +61,10 @@
 LINUX_DTB_DIR=${LINUX_PRODUCTS_DIR}/dts/habanalabs/${HL_DEV}/
 LINUX_ROOTFS_DIR=${IMGS_DIR}
 
+LINUX_PRODUCTS_DIR=${BASE_DIR}/build/linux-custom/arch/arm64/boot/
+LINUX_DTB_DIR=${LINUX_PRODUCTS_DIR}/dts/habanalabs/${HL_DEV}/
+LINUX_ROOTFS_DIR=${IMGS_DIR}
+
 # Set compression to lzo
 HL_COMPRESS=lzo
 
@@ -132,6 +136,10 @@
 ITS_SED_PARAMS+="s/@HL_ZEPHYR_MGMT_VERSION@/${HL_ZEPHYR_MGMT_VERSION}/g;"
 ITS_SED_PARAMS+="s/@HL_ZEPHYR_PID_VERSION@/${HL_ZEPHYR_PID_VERSION}/g;"
 
+ITS_SED_PARAMS+="s#@LINUX_PROD_DIR@#${LINUX_PRODUCTS_DIR}#g;"
+ITS_SED_PARAMS+="s#@LINUX_DTB_DIR@#${LINUX_DTB_DIR}#g;"
+ITS_SED_PARAMS+="s#@LINUX_ROOTFS_DIR@#${LINUX_ROOTFS_DIR}#g;"
+
 if [ ! -f ${NIC_FW_FILE} ]; then
 	dd bs=4 count=1 if=/dev/zero of=${BINS_DIR}/empty_nic_fw.bin
 	NIC_FW_FILE=${BINS_DIR}/empty_nic_fw.bin
diff --git a/board/habanalabs/common/post-image-fit.sh b/board/habanalabs/common/post-image-fit.sh
index 03881c8..b6d27f5 100755
--- a/board/habanalabs/common/post-image-fit.sh
+++ b/board/habanalabs/common/post-image-fit.sh
@@ -83,6 +83,10 @@
 ITS_SED_PARAMS+="s/@KERNEL_START_ADDR_HI@/${KERNEL_START_ADDR_HI}/g;"
 ITS_SED_PARAMS+="s/@KERNEL_LOAD_ADDR_LO@/${KERNEL_LOAD_ADDR_LO}/g;"
 
+ITS_SED_PARAMS+="s#@LINUX_PROD_DIR@#${LINUX_PRODUCTS_DIR}#g;"
+ITS_SED_PARAMS+="s#@LINUX_DTB_DIR@#${LINUX_DTB_DIR}#g;"
+ITS_SED_PARAMS+="s#@LINUX_ROOTFS_DIR@#${LINUX_ROOTFS_DIR}#g;"
+
