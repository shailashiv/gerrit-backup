+	int key = 0;
 
 	LOG_HEXDUMP_DBG_LOCAL(data, size, "send");
 
@@ -121,9 +158,10 @@
 	}
 
 	for (i = 0; i < num_chunks; i++) {
-		msg = (struct ipm_hl_msg_hdr *) (base + (i * chunk_sz));
+		msg = (volatile struct ipm_hl_msg_hdr *) (base + (i * chunk_sz));
 		if ((msg->busy) && (msg->id == id)) {
 			if (!msg->ack) {
+				/* Raise interrupt again to notify receiver about pending ack */
 				sys_write32(config->tx.irq_num, (mem_addr_t) config->intr_base);
 			}
 
@@ -135,33 +173,39 @@
 	}
 
 	for (i = 0; i < num_chunks; i++) {
-		msg = (struct ipm_hl_msg_hdr *) (base + (i * chunk_sz));
+		msg = (volatile struct ipm_hl_msg_hdr *) (base + (i * chunk_sz));
 		if (!msg->busy) { /* Chunk is free */
-			break;
+			key = irq_lock();
+
+			/* Race is possible on msg->busy, please recheck if chunk is free */
+			if (msg->busy) {
+				/* Race detected recheck chunk */
+				irq_unlock(key);
+				i = 0;
+				continue;
+			}
+
+			msg->id = id;
+			msg->size = size;
+			msg->ack = false;
+			msg->seq_no = dev_data->tx_ctrl->pi;
+			dev_data->tx_ctrl->pi++;
+			addr = (uint8_t *) msg;
+			msg->busy = true;
+
+			memcpy((void *)(addr + sizeof(struct ipm_hl_msg_hdr)), data, size);
+
+			HL_ARC_W_BARRIER();
+
+			/* Raise interrupt */
+			sys_write32(config->tx.irq_num, (mem_addr_t) config->intr_base);
+			irq_unlock(key);
+			return 0;
 		}
 	}
 
-	if (i == num_chunks) {
-		LOG_DBG_LOCAL("mailbox is full, retry later");
-		return -EBUSY;
-	}
-
-	msg->id = id;
-	msg->size = size;
-	msg->ack = false;
-	msg->busy = true;
-	msg->seq_no = dev_data->tx_ctrl->pi++;
-	addr = (uint8_t *) msg;
-	LOG_DBG_LOCAL("MSG CREATED: id: %d size: %d seq no: %d\n",
-			msg->id, msg->size, msg->seq_no);
-
-	memcpy((void *)(addr + sizeof(struct ipm_hl_msg_hdr)), data, size);
-
-	HL_ARC_W_BARRIER();
-	/* Raise interrupt */
-	sys_write32(config->tx.irq_num, (mem_addr_t) config->intr_base);
-
-	return 0;
+	LOG_DBG_LOCAL("mailbox is full, retry later");
+	return -EBUSY;
 }
 
 void ipm_hl_register_callback(const struct device *dev,
