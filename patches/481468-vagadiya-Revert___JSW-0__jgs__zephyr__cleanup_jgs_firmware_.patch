 void fs_iterate_edmas(struct iterate_module_ctx *ctx)
 {
+#ifdef TO_BE_REMOVED
+	uint32_t edma_idx, reg_base_addr;
+	bool is_die_avail = dev_is_die_available(ctx->die_id);
+
+	if (!is_die_avail)
+		return;
+
+	for (edma_idx = 0; edma_idx < FS1_NUM_OF_EDMA_PER_COMP_DIE; edma_idx++) {
+		if (fs_is_edma_engine_missing(ctx->die_id, edma_idx))
+			continue;
+
+		reg_base_addr = mmCOMPUTE_0_CFG_EDMA_EDMA_0_BASE +
+						(edma_idx * EDMA_INST_DIST);
+		ctx->fn(reg_base_addr, ctx->data);
+	}
+#endif
 }
 
