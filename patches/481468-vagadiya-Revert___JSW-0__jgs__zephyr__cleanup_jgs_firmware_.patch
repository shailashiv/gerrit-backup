 void fs_iterate_nss_nms_sms(struct iterate_module_ctx *ctx)
 {
+#ifdef TO_BE_REMOVED
+	uint32_t io_die_sriov_half_0_id, io_die_sriov_half_1_id, die_id, reg_base_addr;
+	bool is_die_avail;
+
+	io_die_sriov_half_0_id = ctx->die_id; /* io die half 0 */
+	io_die_sriov_half_1_id = io_die_sriov_half_0_id + 1; /* io die half 1 */
+
+	for (die_id = io_die_sriov_half_0_id; die_id <= io_die_sriov_half_1_id; die_id++) {
+		is_die_avail = dev_is_die_available(die_id);
+		if (!is_die_avail)
+			continue;
+
+		if (fs_is_nss_nms_sms_missing(die_id))
+			continue;
+
+		reg_base_addr = mmIO_0_CFG_HALF_0_NSS_NMS_SMS_BASE +
+				((die_id - FS1_IO_DIE_0) * FS1_IO_DIE_HALF_DIST_OFFSET);
+		ctx->fn(reg_base_addr, ctx->data);
+	}
+#endif
 }
 
