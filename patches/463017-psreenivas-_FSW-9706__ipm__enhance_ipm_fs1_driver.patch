 	uint32_t hdr_sz = sizeof(struct ipm_fs_msg_hdr);
@@ -136,7 +137,7 @@
 	__ASSERT(data->callback != NULL,
 		 "No callback registered to ipm_fs interrupt driver %p", dev);
 
-	data->mbx.pi = sys_read32((mem_addr_t) &reg_base->pi[0]);
+	data->mbx.pi = sys_read32((mem_addr_t) &reg_base->pi[config->mbx_idx]);
 	if (data->mbx.pi == data->mbx.ci) {
 		LOG_ERR("no data received, spurious interrupt");
 		return;
@@ -262,7 +263,8 @@
 
 callback_ops:
 		data->mbx.pi_to_cb = (data->mbx.pi_to_cb + m_size) % data->mbx.len;
-		data->callback(dev, data->user_data, msg_hdr.id, &cb_data);
+		if (data->callback)
+			data->callback(dev, data->user_data, msg_hdr.id, &cb_data);
 
