 			LOG_DBG_LOCAL("Incorrect size: %d passed to update mailbox CI dev:%p",
@@ -273,12 +275,13 @@
 
 static void ipm_fs_init_mbx_data(const struct device *dev)
 {
-	const struct ipm_fs_config *config = DEV_CFG(dev);
 	struct ipm_fs_data *const data = DEV_DATA(dev);
+	const struct ipm_fs_config *config = DEV_CFG(dev);
 	struct ipm_fs_mbx_regs *reg_base = (struct ipm_fs_mbx_regs *)(config->cfg_base);
 
-	data->mbx.base_addr = (uint32_t)sys_read32((mem_addr_t) &reg_base->base_addr_lsb);
-	data->mbx.len = sys_read32((mem_addr_t) &reg_base->q_size);
+	data->mbx.base_addr =
+		(uint32_t)sys_read32((mem_addr_t) &reg_base->base_addr_lsb[config->mbx_idx]);
+	data->mbx.len = sys_read32((mem_addr_t) &reg_base->q_size[config->mbx_idx]);
 	data->mbx.ci = 0;
 	data->mbx.pi = 0;
 	data->mbx.pi_to_cb = 0;
@@ -287,31 +290,58 @@
 void ipm_fs_isr(const struct device *dev)
 {
 	const struct ipm_fs_config *config = DEV_CFG(dev);
+	struct ipm_fs_mbx_regs *reg_base = (struct ipm_fs_mbx_regs *)(config->cfg_base);
 	/*
 	 * RX will get 2 interrupts
 	 * 1. mbx enable
 	 * 2. pi write
-	 * TODO: add interrupt registers and check for particular en or write interrupt
-	 * is associated with mailbox.
 	 */
+	uint32_t en_sts = (sys_read32((mem_addr_t)&reg_base->en_sts) & BIT(config->mbx_idx));
+	uint32_t pi_sts = (sys_read32((mem_addr_t)&reg_base->pi_sts) & BIT(config->mbx_idx));
 
-	/* Enable routine*/
-	if (config->mbx_type == MBX_RX_ONLY)
+	if (!en_sts && !pi_sts) {
+		LOG_DBG("Interrupt does not belong to dev %p", dev);
+		return;
+	}
+
+	/* mbx enable routine */
+	if (en_sts) {
 		ipm_fs_init_mbx_data(dev);
+		sys_write32(BIT(config->mbx_idx), (mem_addr_t)&(reg_base->en_sts));
+		return;
+	}
 
 	/* PI write routine */
-	ipm_fs_mbx_process_data(dev);
+	if (pi_sts) {
+		ipm_fs_mbx_process_data(dev);
+		sys_write32(BIT(config->mbx_idx), (mem_addr_t)&reg_base->pi_sts);
+	}
 }
 
+static inline int ipm_fs_rx_is_ready(const struct device *dev)
+{
+	const struct ipm_fs_config *config = DEV_CFG(dev);
+	struct ipm_fs_mbx_regs *reg_base = (struct ipm_fs_mbx_regs *)(config->cfg_base);
 
-int ipm_fs_send(const struct device *dev, int wait, uint32_t id,
-		   const void *data, int size)
+	if ((sys_read32((mem_addr_t)&reg_base->en_sts) & BIT(config->mbx_idx)) ||
+		!sys_read32((mem_addr_t)&reg_base->en[config->mbx_idx])) {
+		return false;
+	}
+	return true;
+}
+
+int ipm_fs_send(const struct device *dev, int wait, uint32_t id, const void *data, int size)
 {
 	struct ipm_fs_mbx_buffer_data mbx_data;
 	struct ipm_fs_msg_hdr msg_hdr;
 	uint32_t hdr_sz = sizeof(struct ipm_fs_msg_hdr);
 	uint32_t req_sz = hdr_sz + size, cp_sz;
 	int ret;
+
+	if (!ipm_fs_rx_is_ready(dev)) {
+		LOG_DBG_LOCAL("Receiver not ready to accept message, please retry later");
+		return -EAGAIN;
+	}
 
 	if ((size) && (!data)) {
 		LOG_ERR_LOCAL("Null data buffer received for non-zero size: %d dev: %p",
@@ -385,16 +415,37 @@
 	return 0;
 }
 
+#ifdef CONFIG_IPM_INTEL_FS_RX_MBX
+int ipm_fs_irq_init(const struct device *dev)
+{
+	const struct ipm_fs_config *config = DEV_CFG(dev);
+	struct ipm_fs_data *const data = DEV_DATA(dev);
+	uint32_t val = sys_read32((mem_addr_t) config->intr_mask);
+
+	data->shared_irq_dev = DEVICE_DT_GET(DT_NODELABEL(sw_malibox_irq));
+	if (!data->shared_irq_dev) {
+		LOG_ERR("Failed to get sw_malibox_irq device binding");
+		return -ENODEV;
+	}
+
+	/* Register for interrupt */
+	shared_irq_isr_register(data->shared_irq_dev, (isr_t)ipm_fs_isr, dev);
+	/* Unmask the psoc interrupt */
+	val &= ~BIT(config->mask_idx);
+	sys_write32(val, config->intr_mask);
+	/* Enable the psoc interrupt */
+	shared_irq_enable(data->shared_irq_dev, dev);
+
+	return 0;
+}
+#endif
+
 int ipm_fs_set_enabled(const struct device *dev, int enable)
 {
 	const struct ipm_fs_config *config = DEV_CFG(dev);
 	struct ipm_fs_mbx_regs *reg_base = (struct ipm_fs_mbx_regs *)(config->cfg_base);
 
-	if (config->mbx_type == MBX_TX_ONLY)
-		sys_write32((enable) ? 0x1 : 0x0, (mem_addr_t) &reg_base->en[0]);
-	else
-		ipm_fs_init_mbx_data(dev);
-
+	sys_write32((enable) ? 0x1 : 0x0, (mem_addr_t) &reg_base->en[config->mbx_idx]);
 	return 0;
 }
 
@@ -403,33 +454,44 @@
 	return 0;
 }
 
-int ipm_fs_init(const struct device *dev)
+void ipm_fs_tx_init(const struct device *dev)
 {
 	const struct ipm_fs_config *config = DEV_CFG(dev);
 	struct ipm_fs_mbx_regs *reg_base = (struct ipm_fs_mbx_regs *)(config->cfg_base);
 
-	LOG_INF("IPM FS mbx comms dev %p enumeration start", dev);
+	/*
+	 * TX will fill all the buffer content lo/hi addr and size
+	 * and then set enable interrupt in ipm_fs_set_enabled function.
+	 */
+	sys_write32(config->data_base, (mem_addr_t) &reg_base->base_addr_lsb[config->mbx_idx]);
+	sys_write32(0x0, (mem_addr_t) &reg_base->base_addr_msb[config->mbx_idx]);
+	sys_write32(config->data_size, (mem_addr_t) &reg_base->q_size[config->mbx_idx]);
+	sys_write32(0x0, (mem_addr_t) &reg_base->pi[config->mbx_idx]);
+	sys_write32(0x0, (mem_addr_t) &reg_base->ci[config->mbx_idx]);
+
+	/* Clear mailbox buffer */
+	memset((void *)config->data_base, 0x0, config->data_size);
+
+	/* init mbx buffer data */
+	ipm_fs_init_mbx_data(dev);
+}
+
+int ipm_fs_init(const struct device *dev)
+{
+	const struct ipm_fs_config *config = DEV_CFG(dev);
+
+	LOG_INF("IPM FS mbx comms %s dev %p enumeration start",
+		(config->mbx_type == MBX_TX_ONLY) ? "TX" : "RX", dev);
+
+	if (config->init) {
+		config->init(dev);
+	}
+
 	if (config->irq_config_func)
 		config->irq_config_func(dev);
 
-	if (config->mbx_type == MBX_TX_ONLY) {
-		/*
-		 * TX will fill all the buffer content lo/hi addr and size
-		 * and then set enable interrupt in ipm_fs_set_enabled function.
-		 */
-		sys_write32(config->data_base, (mem_addr_t) &reg_base->base_addr_lsb[0]);
-		sys_write32(0x0, (mem_addr_t) &reg_base->base_addr_msb[0]);
-		sys_write32(config->data_size, (mem_addr_t) &reg_base->q_size[0]);
-		sys_write32(0x0, (mem_addr_t) &reg_base->pi[0]);
-		sys_write32(0x0, (mem_addr_t) &reg_base->ci[0]);
+	LOG_INF("IPM FS mbx comms %s dev %p enumeration end",
+		(config->mbx_type == MBX_TX_ONLY) ? "TX" : "RX", dev);
 
-		/* Clear mailbox buffer */
-		memset((void *)config->data_base, 0x0, config->data_size);
-
-		/* init mbx buffer data */
-		ipm_fs_init_mbx_data(dev);
-	}
-
-	LOG_INF("IPM FS mbx comms dev %p enumeration end", dev);
 	return 0;
 }
