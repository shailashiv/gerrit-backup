+
+/* Bit shifts specific for Gaudi and used during reset routines */
+#define MME_ACC_ACC_STALL_R_SHIFT	0
+
+/* Unit reset shifts used by the reset routines */
+#define UNIT_RST_L_TPC_0_MSK	BIT(21)
+#define UNIT_RST_L_TPC_1_MSK	BIT(22)
+#define UNIT_RST_L_TPC_2_MSK	BIT(23)
+#define UNIT_RST_L_TPC_3_MSK	BIT(24)
+#define UNIT_RST_L_TPC_4_MSK	BIT(25)
+#define UNIT_RST_L_TPC_5_MSK	BIT(26)
+#define UNIT_RST_L_TPC_6_MSK	BIT(27)
+#define UNIT_RST_L_TPC_7_MSK	BIT(28)
+#define UNIT_RST_L_MME_0_MSK	BIT(29)
+#define UNIT_RST_L_MME_1_MSK	BIT(30)
+#define UNIT_RST_L_MME_2_MSK	BIT(31)
+
+#define UNIT_RST_H_MME_3_MSK	BIT(0)
+#define UNIT_RST_H_NIC_0_MSK	BIT(5)
+#define UNIT_RST_H_NIC_1_MSK	BIT(6)
+#define UNIT_RST_H_NIC_2_MSK	BIT(7)
+#define UNIT_RST_H_NIC_3_MSK	BIT(8)
+#define UNIT_RST_H_NIC_4_MSK	BIT(9)
+#define UNIT_RST_H_SM_0_MSK	BIT(10)
+#define UNIT_RST_H_SM_1_MSK	BIT(11)
+#define UNIT_RST_H_SM_2_MSK	BIT(12)
+#define UNIT_RST_H_SM_3_MSK	BIT(13)
+#define UNIT_RST_H_DMA_0_MSK	BIT(18)
+#define UNIT_RST_H_DMA_1_MSK	BIT(19)
+
+#define UNIT_RST_L_TPC_MSK	(UNIT_RST_L_TPC_0_MSK | UNIT_RST_L_TPC_1_MSK | \
+				 UNIT_RST_L_TPC_2_MSK | UNIT_RST_L_TPC_3_MSK | \
+				 UNIT_RST_L_TPC_4_MSK | UNIT_RST_L_TPC_5_MSK | \
+				 UNIT_RST_L_TPC_6_MSK | UNIT_RST_L_TPC_7_MSK)
+
+#define UNIT_RST_L_MME_MSK	(UNIT_RST_L_MME_0_MSK | UNIT_RST_L_MME_1_MSK | \
+				 UNIT_RST_L_MME_2_MSK)
+
+#define UNIT_RST_L_MSK		(UNIT_RST_L_TPC_MSK | UNIT_RST_L_MME_MSK)
+
+#define UNIT_RST_H_MME_MSK	(UNIT_RST_H_MME_3_MSK)
+
+#define UNIT_RST_H_NIC_MSK	(UNIT_RST_H_NIC_0_MSK | UNIT_RST_H_NIC_1_MSK | \
+				 UNIT_RST_H_NIC_2_MSK | UNIT_RST_H_NIC_3_MSK | \
+				 UNIT_RST_H_NIC_4_MSK)
+
+#define UNIT_RST_H_DMA_MSK	(UNIT_RST_H_DMA_0_MSK | UNIT_RST_H_DMA_1_MSK)
+
+#define UNIT_RST_H_SM_MSK	(UNIT_RST_H_SM_0_MSK | UNIT_RST_H_SM_0_MSK |   \
+				 UNIT_RST_H_SM_0_MSK | UNIT_RST_H_SM_0_MSK)
+
+#define UNIT_RST_H_MSK		(UNIT_RST_H_MME_MSK | UNIT_RST_H_NIC_MSK |     \
+				 UNIT_RST_H_DMA_MSK | UNIT_RST_H_SM_MSK)
+
+static void gaudi_mask_nics_ints(void)
+{
+	int i, j;
+	u32 reg, base, eng_base;
+
+	for (i = 0; i < GAUDI_NICS_NUM; i++) {
+		base = GAUDI_NICS_DIST * i;
+		for (j = 0; j < GAUDI_NIC_ENGS_IN_NIC; j++) {
+			eng_base = base + GAUDI_NIC_ENGS_DIST * j;
+
+			reg = eng_base + mmNIC0_QPC0_INTERRUPT_MASK;
+			regmap_writel(0, reg);
+
+			reg = eng_base + mmNIC0_QPC0_INTRRRUPT_RESP_ERR_MASK;
+			regmap_writel(0, reg);
+
+			reg = eng_base + mmNIC0_RXE0_CQ_CFG0;
+			regmap_writel(0, reg);
+
+			reg = eng_base + mmNIC0_RXE0_SPI_MASK;
+			regmap_writel(0xFFFFFFFF, reg);
+
+			reg = eng_base + mmNIC0_RXE0_SEI_MASK;
+			regmap_writel(0x7, reg);
+
+			reg = eng_base + mmNIC0_RXE0_MSI_CASUE_MASK;
+			regmap_writel(0, reg);
+
+			reg = eng_base + mmNIC0_TXE0_INTERRUPT_MASK;
+			regmap_writel(0, reg);
+
+			reg = eng_base + mmNIC0_TXS0_INTERRUPT_MASK;
+			regmap_writel(0, reg);
+		}
+
+		reg = base + mmNIC0_RXB_DBG_SEI_INTR;
+		regmap_writel(0x4, reg);
+
+		reg = base + mmNIC0_TMR_INTERRUPT_MASK;
+		regmap_writel(0, reg);
+	}
+}
+
+static void gaudi_nics_rxb_drop_reset(void)
+{
+	int i, j;
+	unsigned int off;
+
+	for (i = 0; i < GAUDI_NICS_NUM; i++) {
+		for (j = 0; j < 16; j++) {
+			off = mmNIC0_RXB_DROP_THRESHOLD_0 + j * 4 + i * 0x40000;
+			regmap_writel(0, off);
+		}
+	}
+}
+
+static void gaudi_nics_txe_read_choke(void)
+{
+	int i, j;
+	u32 reg, base, eng_base;
+
+	for (i = 0; i < GAUDI_NICS_NUM; i++) {
+		base = GAUDI_NICS_DIST * i;
+		for (j = 0; j < GAUDI_NIC_ENGS_IN_NIC; j++) {
+			eng_base = base + GAUDI_NIC_ENGS_DIST * j;
+			reg = eng_base + mmNIC0_TXE0_READ_CREDIT_FORCE_FULL;
+			regmap_writel(0x1, reg);
+		}
+	}
+}
+
+static void gaudi_nic_qpc_disable(unsigned int reg, int nic, int qpc)
+{
+	unsigned int off, mask = BIT(6);
+
+	off = reg + nic * 0x40000 + qpc * 0x1000;
+	reg = regmap_readl(off);
+	reg |= mask;
+	regmap_writel(reg, off);
+}
+
+static void gaudi_nics_qpcs_disable(void)
+{
+	int nic, qpc;
+
+	for (nic = 0; nic < GAUDI_NICS_NUM; nic++) {
+		for (qpc = 0; qpc < GAUDI_QPCS_NUM; qpc++) {
+			gaudi_nic_qpc_disable(mmNIC0_QPC0_REQ_STATIC_CONFIG,
+					      nic, qpc);
+			gaudi_nic_qpc_disable(mmNIC0_QPC0_RES_STATIC_CONFIG,
+					      nic, qpc);
+		}
+	}
+}
+
+static void gaudi_nics_handle(void)
+{
+	gaudi_mask_nics_ints();
+	gaudi_nics_rxb_drop_reset();
+	gaudi_nics_txe_read_choke();
+	gaudi_nics_qpcs_disable();
+}
+
+static void gaudi_disable_pci_dma_qmans(void)
+{
+	regmap_writel(0, mmDMA0_QM_GLBL_CFG0);
+	regmap_writel(0, mmDMA1_QM_GLBL_CFG0);
+	regmap_writel(0, mmDMA5_QM_GLBL_CFG0);
+}
+
+static void gaudi_disable_hbm_dma_qmans(void)
+{
+	regmap_writel(0, mmDMA2_QM_GLBL_CFG0);
+	regmap_writel(0, mmDMA3_QM_GLBL_CFG0);
+	regmap_writel(0, mmDMA4_QM_GLBL_CFG0);
+	regmap_writel(0, mmDMA6_QM_GLBL_CFG0);
+	regmap_writel(0, mmDMA7_QM_GLBL_CFG0);
+}
+
+static void gaudi_disable_mme_qmans(void)
+{
+	regmap_writel(0, mmMME2_QM_GLBL_CFG0);
+	regmap_writel(0, mmMME0_QM_GLBL_CFG0);
+}
+
+static void gaudi_disable_tpc_qmans(void)
+{
+	u32 tpc_offset = 0;
+	int tpc_id;
+
+	for (tpc_id = 0; tpc_id < GAUDI_TPCS_NUM; tpc_id++) {
+		regmap_writel(0, mmTPC0_QM_GLBL_CFG0 + tpc_offset);
+		tpc_offset += mmTPC1_QM_GLBL_CFG0 - mmTPC0_QM_GLBL_CFG0;
+	}
+}
+
+static void gaudi_disable_nic_qmans(void)
+{
+	u32 nic_offset = 0;
+	u32 nic_delta_between_qmans = mmNIC0_QM1_BASE - mmNIC0_QM0_BASE;
+	u32 nic_delta_between_nics = mmNIC1_QM0_BASE - mmNIC0_QM0_BASE;
+	u32 nic_base = mmNIC0_QM0_BASE & ~HL_CFG_BASE;
+	int nic_id;
+
+	for (nic_id = 0; nic_id < GAUDI_NIC_ENGS_NUM; nic_id++) {
+		regmap_writel(0, nic_base + nic_offset);
+
+		nic_offset += nic_delta_between_qmans;
+		if (nic_id & 1) {
+			nic_offset -= nic_delta_between_qmans * 2;
+			nic_offset += nic_delta_between_nics;
+		}
+	}
+}
+
+static void gaudi_stop_pci_dma_qmans(void)
+{
+	u32 stop = 0x1F << DMA0_QM_GLBL_CFG1_CP_STOP_SHIFT;
+
+	/* Stop upper CPs of QMANs 0.0 to 1.3 and 5.0 to 5.3 */
+	regmap_writel(stop, mmDMA0_QM_GLBL_CFG1);
+	regmap_writel(stop, mmDMA1_QM_GLBL_CFG1);
+	regmap_writel(stop, mmDMA5_QM_GLBL_CFG1);
+}
+
+static void gaudi_stop_hbm_dma_qmans(void)
+{
+	u32 stop = 0x1F << DMA0_QM_GLBL_CFG1_CP_STOP_SHIFT;
+
+	/* Stop CPs of HBM DMA QMANs */
+	regmap_writel(stop, mmDMA2_QM_GLBL_CFG1);
+	regmap_writel(stop, mmDMA3_QM_GLBL_CFG1);
+	regmap_writel(stop, mmDMA4_QM_GLBL_CFG1);
+	regmap_writel(stop, mmDMA6_QM_GLBL_CFG1);
+	regmap_writel(stop, mmDMA7_QM_GLBL_CFG1);
+}
+
+static void gaudi_stop_mme_qmans(void)
+{
+	u32 stop = 0x1F << MME0_QM_GLBL_CFG1_CP_STOP_SHIFT;
+
+	/* Stop CPs of MME QMANs */
+	regmap_writel(stop, mmMME2_QM_GLBL_CFG1);
+	regmap_writel(stop, mmMME0_QM_GLBL_CFG1);
+}
+
+static void gaudi_stop_tpc_qmans(void)
+{
+	u32 stop = 0x1F << TPC0_QM_GLBL_CFG1_CP_STOP_SHIFT;
+	u32 qman_offset = mmTPC0_QM_GLBL_CFG1;
+	u32 tpcs_off_delta = mmTPC1_QM_GLBL_CFG1 - mmTPC0_QM_GLBL_CFG1;
+	int i;
+
+	for (i = 0; i < GAUDI_TPCS_NUM; i++)
+		regmap_writel(stop, qman_offset + i * tpcs_off_delta);
+}
+
+static void gaudi_stop_nic_qmans(void)
+{
+	/* The stop bits are at the same shift on all NICs QMANs */
+	u32 stop = 0xF << NIC0_QM0_GLBL_CFG1_CP_STOP_SHIFT;
+	u32 qman0_offset = mmNIC0_QM0_GLBL_CFG1;
+	u32 qman1_offset = mmNIC0_QM1_GLBL_CFG1;
+	u32 nics_off_delta = mmNIC1_QM0_BASE - mmNIC0_QM0_BASE;
+	int i;
+
+	for (i = 0; i < GAUDI_NICS_NUM; i++) {
+		regmap_writel(stop, qman0_offset + i * nics_off_delta);
+		regmap_writel(stop, qman1_offset + i * nics_off_delta);
+	}
+}
+
+static void gaudi_disable_clock_gating(void)
+{
+	u32 qman_offset;
+	int i;
+
+	for (i = 0, qman_offset = 0; i < GAUDI_DMA_CHANNELS_NUM; i++) {
+		regmap_writel(0, mmDMA0_QM_CGM_CFG + qman_offset);
+		regmap_writel(0, mmDMA0_QM_CGM_CFG1 + qman_offset);
+
+		qman_offset += mmDMA1_QM_CGM_CFG - mmDMA0_QM_CGM_CFG;
+	}
+
+	regmap_writel(0, mmMME0_QM_CGM_CFG);
+	regmap_writel(0, mmMME0_QM_CGM_CFG1);
+	regmap_writel(0, mmMME2_QM_CGM_CFG);
+	regmap_writel(0, mmMME2_QM_CGM_CFG1);
+
+	for (i = 0, qman_offset = 0; i < GAUDI_TPCS_NUM; i++) {
+		regmap_writel(0, mmTPC0_QM_CGM_CFG + qman_offset);
+		regmap_writel(0, mmTPC0_QM_CGM_CFG1 + qman_offset);
+
+		qman_offset += mmTPC1_QM_CGM_CFG - mmTPC0_QM_CGM_CFG;
+	}
+}
+
+static void gaudi_pci_dma_stall(void)
+{
+	u32 stall = BIT(DMA0_CORE_CFG_1_HALT_SHIFT);
+
+	regmap_writel(stall, mmDMA0_CORE_CFG_1);
+	regmap_writel(stall, mmDMA1_CORE_CFG_1);
+	regmap_writel(stall, mmDMA5_CORE_CFG_1);
+}
+
+static void gaudi_hbm_dma_stall(void)
+{
+	u32 stall = BIT(DMA0_CORE_CFG_1_HALT_SHIFT);
+
+	regmap_writel(stall, mmDMA2_CORE_CFG_1);
+	regmap_writel(stall, mmDMA3_CORE_CFG_1);
+	regmap_writel(stall, mmDMA4_CORE_CFG_1);
+	regmap_writel(stall, mmDMA6_CORE_CFG_1);
+	regmap_writel(stall, mmDMA7_CORE_CFG_1);
+}
+
+static void gaudi_mme_stall(void)
+{
+	/* both ACC and SBAB stall bits shifts are the same */
+	u32 stall = BIT(MME_ACC_ACC_STALL_R_SHIFT);
+	u32 acc_offset = mmMME0_ACC_ACC_STALL;
+	u32 sbab_offset = mmMME0_SBAB_SB_STALL;
+	/* MME offsets are the same between ACCs and SBABs */
+	u32 mmes_off_delta = mmMME1_ACC_BASE - mmMME0_ACC_BASE;
+	int i;
+
+	for (i = 0; i < GAUDI_MMES_NUM; i++) {
+		/* WA for H3-1800 bug: do ACC and SBAB writes twice */
+		regmap_writel(stall, acc_offset + i * mmes_off_delta);
+		regmap_writel(stall, acc_offset + i * mmes_off_delta);
+		regmap_writel(stall, sbab_offset + i * mmes_off_delta);
+		regmap_writel(stall, sbab_offset + i * mmes_off_delta);
+	}
+}
+
+static void gaudi_tpc_stall(void)
+{
+	u32 stall = BIT(TPC0_CFG_TPC_STALL_V_SHIFT);
+	u32 tpcs_off_delta = mmTPC1_CFG_TPC_STALL - mmTPC0_CFG_TPC_STALL;
+	u32 stall_offset = mmTPC0_CFG_TPC_STALL;
+	int i;
+
+	for (i = 0; i < GAUDI_TPCS_NUM; i++)
+		regmap_writel(stall, stall_offset + i * tpcs_off_delta);
+}
+
+static void gaudi_disable_timestamp(void)
+{
+	/* Disable the timestamp counter */
+	regmap_writel(0, mmPSOC_TIMESTAMP_BASE & ~HL_CFG_BASE);
+}
+
+static void gaudi_halt_engines(void)
+{
+	gaudi_nics_handle();
+
+	gaudi_disable_clock_gating();
+
+	/* stop Rx/Tx here to drain any queued packets */
+	gaudi_stop_nic_qmans();
+
+	gaudi_stop_mme_qmans();
+	gaudi_stop_tpc_qmans();
+	gaudi_stop_hbm_dma_qmans();
+	gaudi_stop_pci_dma_qmans();
+
+	udelay(1000);
+
+	gaudi_pci_dma_stall();
+	gaudi_hbm_dma_stall();
+	gaudi_tpc_stall();
+	gaudi_mme_stall();
+
+	udelay(1000);
+
+	gaudi_disable_nic_qmans();
+	gaudi_disable_mme_qmans();
+	gaudi_disable_tpc_qmans();
+	gaudi_disable_hbm_dma_qmans();
+	gaudi_disable_pci_dma_qmans();
+
+	gaudi_disable_timestamp();
+}
+
+static void gaudi_hw_fini(void)
+{
+	/* Restart BTL/BLR upon hard-reset */
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_BOOT_SEQ_RE_START);
+
+	/* move the UART/SPI clock to reference clock */
+	regmap_writel(HL_PLL_REF_CLK, mmPSOC_PCI_PLL_DIV_SEL_2);
+
+	udelay(1000);
+
+	/* The reset mask is set by BTL, so we do not need to do this here */
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_SW_ALL_RST);
+}
+
+/*
+ * This function makes sure no access is done from host to the SoC units during
+ * the reset. All incoming downstream traffic is routed to RAZWI, so responses
+ * will be sent to the host and PCIe link will not break.
+ *
+ * Note: since we close all the access, the boot FW must enable the access back.
+ */
+static void gaudi_close_pcie_rr(void)
+{
+	/* RRs min/max HIT is not inclusive: min < hit < max */
+	u32 min = 0xF0000000 - 1, max = 0xFFFFFFFF;
+	u32 hmsk = 0x3FF80;
+
+	/* PCIe RR - CFG WP 0x7FF0000000 - 0x7FFFFFFFFF */
+	regmap_writel(min, mmPCIE_WRAP_RR_WR_PRV_RANGE_REG_MIN_0);
+	regmap_writel(0xFCC01F64, mmPCIE_WRAP_RR_WR_PRV_RANGE_REG_MAX_0);
+	/* Hole for VUART TX status 0x7FFCC01F64 - 0x7FFCC01F67 */
+	regmap_writel(0xFCC01F67, mmPCIE_WRAP_RR_WR_PRV_RANGE_REG_MIN_1);
+	regmap_writel(max, mmPCIE_WRAP_RR_WR_PRV_RANGE_REG_MAX_1);
+	regmap_writel(min, mmPCIE_WRAP_RR_RD_PRV_RANGE_REG_MIN_0);
+	regmap_writel(0xFCC01F60, mmPCIE_WRAP_RR_RD_PRV_RANGE_REG_MAX_0);
+	/* Hole for VUART TX 0x7FFCC01F60 - 0x7FFCC01F67 */
+	regmap_writel(0xFCC01F67, mmPCIE_WRAP_RR_RD_PRV_RANGE_REG_MIN_1);
+	regmap_writel(max, mmPCIE_WRAP_RR_RD_PRV_RANGE_REG_MAX_1);
+
+	/* PCIe RTR RR - Full chip WP 0x0 - 0x07FFFFFFFFF */
+	regmap_writel(0, mmSIF_RTR_CTRL_7_RANGE_PRIV_BASE_LOW_AW_0);
+	regmap_writel(0, mmSIF_RTR_CTRL_7_RANGE_PRIV_BASE_HIGH_AW_0);
+	regmap_writel(0, mmSIF_RTR_CTRL_7_RANGE_PRIV_MASK_LOW_AW_0);
+	regmap_writel(hmsk, mmSIF_RTR_CTRL_7_RANGE_PRIV_MASK_HIGH_AW_0);
+	/* PCIe RTR RR - WP Enable (hit) */
+	regmap_writel(0x1, mmSIF_RTR_CTRL_7_RANGE_PRIV_HIT_AW);
+
+	/* PCIe RTR RR - Full chip RP 0x0 - 0x07FFFFFFFFF */
+	regmap_writel(0, mmSIF_RTR_CTRL_7_RANGE_PRIV_BASE_LOW_AR_0);
+	regmap_writel(0, mmSIF_RTR_CTRL_7_RANGE_PRIV_BASE_HIGH_AR_0);
+	regmap_writel(0, mmSIF_RTR_CTRL_7_RANGE_PRIV_MASK_LOW_AR_0);
+	regmap_writel(hmsk, mmSIF_RTR_CTRL_7_RANGE_PRIV_MASK_HIGH_AR_0);
+	/* PCIe RTR RR - RP Enable (hit) */
+	regmap_writel(0x1, mmSIF_RTR_CTRL_7_RANGE_PRIV_HIT_AR);
+}
+
+static void gaudi_reset_soc_initiators(void)
+{
+	regmap_writel(UNIT_RST_L_MSK, mmPSOC_GLOBAL_CONF_UNIT_RST_N_L);
+	regmap_writel(UNIT_RST_H_MSK, mmPSOC_GLOBAL_CONF_UNIT_RST_N_H);
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_UNIT_RST_N);
+
+	udelay(5000);	/* let reset propagate */
+
+	regmap_writel(0, mmPSOC_GLOBAL_CONF_UNIT_RST_N_L);
+	regmap_writel(0, mmPSOC_GLOBAL_CONF_UNIT_RST_N_H);
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_UNIT_RST_N);
+}
+
+void hl_dev_reset(void)
+{
+	gaudi_halt_engines();
+	gaudi_close_pcie_rr();
+	hl_pcie_disable_access();
+	gaudi_reset_soc_initiators();
+
+	gaudi_hw_fini();
+	wfe();
+}
diff --git a/arch/gaudi/rma_info.c b/arch/gaudi/rma_info.c
new file mode 100644
index 0000000..0598267
--- /dev/null
+++ b/arch/gaudi/rma_info.c
@@ -0,0 +1,404 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2021 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <common.h>
+#include <sha256.h>
+#include <hl_boot_desc.h>
+#include <string.h>
+#include "uart.h"
+#include "boot_if.h"
+#include "rma_info.h"
+#include "boot_info.h"
+#include "module_i2c_slave.h"
+#include "hl_i2c_slave_events.h"
+#include "i2cslave_indirect.h"
+
+#define ROUND_UP4(n)	(((n) + sizeof(u32) - 1) & ~(sizeof(u32) - 1))
+#define RMA_HEADER_ENTRY_SIZE		sizeof(struct rma_entry)
+#define RMA_SRAM_ECC_ENTRY_SIZE		sizeof(struct rma_sram_ecc_entry)
+#define MAX_SIZE_ONE_RMA_TABLE		RMA_SRAM_ECC_ENTRY_SIZE
+#define RMA_TABLE_HEADER_SIZE		sizeof(struct table_header)
+
+#define MAX_INFO_DESC_DATA	\
+	((MAX_SRAM_ECC_ENTRIES * MAX_SIZE_ONE_RMA_TABLE) + RMA_TABLE_HEADER_SIZE)
+
+#define FLASH_STORAGE_BLOCK0	0x100000
+#define FLASH_STORAGE_BLOCK1	(FLASH_STORAGE_BLOCK0 + 0x10000)
+#define FLASH_SECTOR_SIZE	0x10000
+#define FLASH_NUM_FLASH_INFO	2
+#define FLASH_SECTOR_MAGIC	0xAA55AA55
+
+static struct hbm_init_err rma_hbm_init_err;
+
+struct flash_header {
+	union {
+		struct {
+			u32 magic;
+			u32 stamp;
+			u32 reserved[6];
+		} __packed;
+		u32 data[8];
+	};
+} __packed;
+
+struct flash_mem_context {
+	u32 base[FLASH_NUM_FLASH_INFO];
+	u32 flash_size[FLASH_NUM_FLASH_INFO];
+};
+
+struct flash_mem_context flash_mem_context = {
+	.base = { FLASH_STORAGE_BLOCK0, FLASH_STORAGE_BLOCK1 },
+	.flash_size = { FLASH_SECTOR_SIZE, FLASH_SECTOR_SIZE },
+};
+
+int rma_erase(void)
+{
+	int ret, i;
+
+	for (i = 0; i < ARRAY_SIZE(flash_mem_context.base); i++) {
+		ret = spi_erase(flash_mem_context.base[i],
+				flash_mem_context.flash_size[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int flash_read(size_t offset, void *data, size_t size)
+{
+	int flash_select = -1;
+	u32 flash_offset;
+	struct flash_header header0, header1;
+
+	/* on every read we first choose a valid sector to read from */
+	spi_copy(&header0, flash_mem_context.base[0],
+				sizeof(struct flash_header), NULL);
+
+	spi_copy(&header1, flash_mem_context.base[1],
+				sizeof(struct flash_header), NULL);
+
+	if (header0.magic == FLASH_SECTOR_MAGIC &&
+	    header1.magic == FLASH_SECTOR_MAGIC) {
+		if (header1.stamp > header0.stamp)
+			flash_select = 1;
+		else
+			flash_select = 0;
+	} else if (header0.magic == FLASH_SECTOR_MAGIC) {
+		flash_select = 0;
+	} else if (header1.magic == FLASH_SECTOR_MAGIC) {
+		flash_select = 1;
+	}
+
+	if (flash_select < 0) {
+		/*
+		 * if no magic found returns a dummy zero, because framework requires
+		 * a success return. In this case framework will than try to search
+		 * for the boot-pointer validity, and return failure if not valid.
+		 */
+		memset(data, 0, size);
+		return 0;
+	}
+
+	if (size + offset > flash_mem_context.flash_size[flash_select])
+		return 1;
+
+	flash_offset = flash_mem_context.base[flash_select] + offset
+						+ sizeof(struct flash_header);
+	spi_copy(data, flash_offset, size, NULL);
+
+	return 0;
+}
+
+static int rma_info_get(u32 type, void *data, u32 *size)
+{
+	struct hl_boot_info_ptrs ptrs;
+	struct hl_boot_info_desc desc;
+	u32 i;
+	u8 chksum[HL_CHKSUM_SIZE];
+	int err;
+	u32 desc_offset, desc_start = sizeof(struct hl_boot_info_ptrs);
+
+	err = flash_read(0, &ptrs, sizeof(struct hl_boot_info_ptrs));
+	if (err)
+		return err;
+
+	if (ptrs.magic != HL_BOOT_INFO_MAGIC)
+		return 1;
+
+	for (i = 0; i < ptrs.count; i++) {
+		err = flash_read(desc_start + i * sizeof(u32),
+					&desc_offset, sizeof(desc_offset));
+		if (err)
+			return err;
+
+		err = flash_read(desc_offset,
+				    &desc, sizeof(struct hl_boot_info_desc));
+		if (err)
+			return err;
+
+		if (type != desc.type)
+			continue;
+
+		if (desc.magic != (HL_BOOT_INFO_DESC_MAGIC | type))
+			return 1;
+
+		if (desc.size > *size)
+			return 1;
+
+		err = flash_read(desc.offset, data, ROUND_UP4(desc.size));
+		if (err)
+			return err;
+
+		sha256_csum((u8 *)data, desc.size, chksum);
+		if (memcmp(chksum, desc.chksum, HL_CHKSUM_SIZE))
+			return 1;
+
+		*size = desc.size;
+
+		return 0;
+	}
+
+	return 1;
+}
+
+static void preboot_rma_type_print(struct rma_failure rma_failure)
+{
+	if (rma_failure.sram_ecc)
+		preboot_puts_raw("SRAM ECC ");
+
+	if (rma_failure.hbm_ecc)
+		preboot_puts_raw("HBM ECC ");
+
+	if (rma_failure.hbm_parity)
+		preboot_puts_raw("HBM Parity ");
+
+	if (rma_failure.row_replacement)
+		preboot_puts_raw("Row Replacement ");
+
+	if (rma_failure.hbm_init)
+		preboot_puts_raw("HBM Init ");
+
+	preboot_puts("\n");
+}
+
+/* Read RMA header table */
+static void preboot_process_rma_header(void)
+{
+	int err;
+	struct rma_table *table = NULL;
+	size_t size;
+	struct rma_entry *rma_header;
+
+	err = rma_table_read(RMA_HEADER_TABLE, &table, &size);
+	if (err || (size == 0))
+		return;
+
+	rma_header = (struct rma_entry *)table->data;
+	/* Update ERR_STS if any error */
+	if (rma_header->rma_failure.sram_ecc ||
+		rma_header->rma_failure.hbm_ecc ||
+		rma_header->rma_failure.hbm_parity ||
+		rma_header->rma_failure.row_replacement ||
+		rma_header->rma_failure.hbm_init) {
+		err_sts_reg_val |= HL_ERROR_STATUS_FATAL_ERROR;
+		i2csi_update_smbus_alert(rma_header);
+		/* set boot error bit for RMA */
+		cpu_boot_err_clrset(CPU_BOOT_ERR0_DEVICE_UNUSABLE_FAIL, true);
+		preboot_puts_raw("RMA Fatal error(s): ");
+		preboot_rma_type_print(rma_header->rma_failure);
+		i2c_rma_failure = rma_header->rma_failure;
+		if (rma_header->rma_failure.hbm_init)
+			rma_hbm_init_err = rma_header->hbm_init_err;
+	}
+
+	rma_table_free(table, size);
+}
+
+void preboot_process_last_rma_info(void)
+{
+	preboot_process_rma_header();
+}
+
+void rma_info_sram_ecc_err_sts(struct hl_i2ci_error_status_sram_ecc *op)
+{
+	int err;
+	struct rma_table *table = NULL;
+	size_t size;
+	struct rma_sram_ecc_entry *sram_ecc_entry, *entry_select;
+
+	err = rma_table_read(RMA_SRAM_ECC_TABLE, &table, &size);
+	if (err || (size == 0))
+		return;
+
+	op->total_err =  size / table->header.entry_size;
+
+	/*
+	 * Opcode's query of error status must
+	 * be an index within the total errors
+	 * that are currently active.
+	 */
+	if (op->entry_index < op->total_err) {
+		sram_ecc_entry = (struct rma_sram_ecc_entry *)table->data;
+		entry_select = &sram_ecc_entry[op->entry_index];
+		op->sram_index = entry_select->sram_index;
+		op->sram_address = entry_select->address;
+		op->cause.multiple_serr = entry_select->header.serr_cause;
+		op->cause.derr = entry_select->header.derr_cause;
+	}
+
+	rma_table_free(table, size);
+}
+
+void rma_info_hbm_ecc_err_sts(struct hl_i2ci_error_status_hbm_ecc *op)
+{
+	int err;
+	struct rma_table *table = NULL;
+	size_t size;
+	struct rma_hbm_ecc_entry *hbm_ecc_entry, *entry_select;
+
+	err = rma_table_read(RMA_HBM_ECC_TABLE, &table, &size);
+	if (err || (size == 0))
+		return;
+
+	op->total_err =  size / table->header.entry_size;
+
+	/*
+	 * Opcode's query of error status must
+	 * be an index within the total errors
+	 * that are currently active.
+	 */
+	if (op->entry_index < op->total_err) {
+		hbm_ecc_entry = (struct rma_hbm_ecc_entry *)table->data;
+		entry_select = &hbm_ecc_entry[op->entry_index];
+		op->device = entry_select->device;
+		op->pc = entry_select->pc;
+		op->sid = entry_select->sid;
+		op->bank = entry_select->bank;
+		op->cause.multiple_serr = entry_select->header.serr_cause;
+		op->cause.derr = entry_select->header.derr_cause;
+	}
+
+	rma_table_free(table, size);
+}
+
+void rma_info_hbm_par_err_sts(struct hl_i2ci_error_status_hbm_parity *op)
+{
+	int err;
+	struct rma_table *table = NULL;
+	size_t size;
+	struct rma_hbm_parity_entry *hbm_par_entry, *entry_select;
+
+	err = rma_table_read(RMA_HBM_PARITY_TABLE, &table, &size);
+	if (err || (size == 0))
+		return;
+
+	op->total_err =  size / table->header.entry_size;
+
+	/*
+	 * Opcode's query of error status must
+	 * be an index within the total errors
+	 * that are currently active.
+	 */
+	if (op->entry_index < op->total_err) {
+		hbm_par_entry = (struct rma_hbm_parity_entry *)table->data;
+		entry_select = &hbm_par_entry[op->entry_index];
+		op->device = entry_select->device;
+		op->pc = entry_select->pc;
+		op->cause.ca = entry_select->header.ca_cause;
+		op->cause.data_rd = entry_select->header.rd_cause;
+		op->cause.data_wr = entry_select->header.wr_cause;
+	}
+
+	rma_table_free(table, size);
+}
+
+void rma_info_hbm_init_err_sts(struct hl_i2ci_error_status_hbm_init *op)
+{
+	op->internal_loopback_error = rma_hbm_init_err.internal_loopback;
+	op->lane_detection_error = rma_hbm_init_err.lane_detection;
+	op->no_interrupts_error = rma_hbm_init_err.no_interrupts;
+	op->ecc_initialization_error = rma_hbm_init_err.ecc_init_err;
+	op->mcbist_error = rma_hbm_init_err.mc_bist;
+	op->training_error = rma_hbm_init_err.training_error;
+}
+
+void rma_info_hbm_row_replacement(struct hl_i2ci_dram *op)
+{
+	int err;
+	struct rma_table *table = NULL;
+	size_t size;
+	struct rma_hbm_row_replacement_entry *hbm_row_replacement, *entry_select;
+
+	err = rma_table_read(RMA_HBM_ROW_REPLACEMENT_TABLE, &table, &size);
+	if (err || (size == 0))
+		return;
+
+	op->number_of_replaced_rows = size / table->header.entry_size;
+
+	/*
+	 * Opcode's query of row index must
+	 * be an index within the replaced rows
+	 */
+	if (op->index_replaced_row_selection < op->number_of_replaced_rows) {
+		hbm_row_replacement = (struct rma_hbm_row_replacement_entry *)table->data;
+		entry_select = &hbm_row_replacement[op->index_replaced_row_selection];
+		op->replaced_row_hbm_index = entry_select->device;
+		op->replaced_row_pc_index = entry_select->pc;
+		op->replaced_row_bank_index = entry_select->bank;
+		op->replaced_row_cause.data = entry_select->header.data_cause;
+		op->replaced_row_address = entry_select->row;
+	}
+
+	rma_table_free(table, size);
+}
+
+#define RMA_HDR_TBL_SIZE (RMA_HEADER_ENTRY_SIZE + RMA_TABLE_HEADER_SIZE)
+
+u8 hbm_hdr_table[RMA_HDR_TBL_SIZE]__aligned(4);
+u8 hbm_ecc_table[MAX_INFO_DESC_DATA]__aligned(4);
+u8 row_rep_table[MAX_INFO_DESC_DATA]__aligned(4);
+
+void preboot_finalize_rma_tables(void)
+{
+	int ret;
+	u32 size = MAX_INFO_DESC_DATA;
+
+	ret = rma_info_get(RMA_HBM_ROW_REPLACEMENT_TABLE, row_rep_table, &size);
+	if (!ret)
+		boot_info_set(HL_BOOT_INFO_RMA_ROW_REP_TABLE, row_rep_table, size);
+
+	size = MAX_INFO_DESC_DATA;
+	ret = rma_info_get(RMA_HBM_ECC_TABLE, hbm_ecc_table, &size);
+	if (!ret)
+		boot_info_set(HL_BOOT_INFO_RMA_HBM_ECC_TABLE, hbm_ecc_table, size);
+
+	size = MAX_INFO_DESC_DATA;
+	ret = rma_info_get(RMA_HEADER_TABLE, hbm_hdr_table, &size);
+	if (!ret)
+		boot_info_set(HL_BOOT_INFO_RMA_HDR_TABLE, hbm_hdr_table, size);
+}
+
+int rma_table_read(enum rma_tables_type type, struct rma_table **table, size_t *data_len)
+{
+	int ret;
+	u32 size = MAX_INFO_DESC_DATA;
+
+	ret = rma_info_get(type, row_rep_table, &size);
+	if (ret)
+		return ret;
+
+	*table = (struct rma_table *)row_rep_table;
+	*data_len = size - RMA_TABLE_HEADER_SIZE;
+
+	return 0;
+}
+
+void rma_table_free(struct rma_table *table, size_t data_len)
+{
+	memset(table, 0, data_len + RMA_TABLE_HEADER_SIZE);
+}
