+++ b/arch/gaudi/ppboot.lds.S
@@ -0,0 +1,45 @@
+/*
+ * (C) Copyright 2017 HabanaLabs, Ltd.
+ * Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#include "common.h"
+
+MEMORY { .sram : ORIGIN = PPBOOT_TEXT_BASE, LENGTH = PPBOOT_SIZE }
+
+OUTPUT_FORMAT("elf64-littleaarch64", "elf64-littleaarch64", "elf64-littleaarch64")
+OUTPUT_ARCH(aarch64)
+ENTRY(_start)
+SECTIONS
+{
+	.text : {
+		. = ALIGN(8);
+		ppboot/crt0_ppboot.o (.text*)
+		* (.text*)
+	} >.sram
+
+	.bss : {
+		. = ALIGN(8);
+		__bss_start = . ;
+		*(.bss*)
+		__bss_end = . ;
+	} > .sram
+
+	.stack : {
+		. = ALIGN(8);
+		__stack = . ;
+		. = . + 512 ;
+		__stack_top = . ;
+	} > .sram
+
+	.stack2 : {
+		. = ALIGN(8);
+		__stack2 = . ;
+		. = . + 512 ;
+		__stack_top2 = . ;
+	} > .sram
+
+	.note.gnu.build-id : { *(.note.gnu.build-id) } > .sram
+}
