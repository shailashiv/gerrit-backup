diff --git a/arch/goya/common.c b/arch/goya/common.c
new file mode 100644
index 0000000..9e7d889
--- /dev/null
+++ b/arch/goya/common.c
@@ -0,0 +1,269 @@
+/*
+ * (C) Copyright 2019 HabanaLabs, Ltd.
+ * Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#include <goya_blocks.h>
+#include <pcie_phy_regs.h>
+#include <psoc_global_conf_regs.h>
+#include <psoc_efuse_regs.h>
+#include <pcie_aux_regs.h>
+#include <pcie_core_regs.h>
+#include <cpu_timestamp_regs.h>
+#include <pcie_db_rsv_regs.h>
+
+#include <cpu_timestamp_regs.h>
+
+#include <bitops.h>
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+#include <string.h>
+#include <spi.h>
+#include <preboot/fit.h>
+#include <preboot/thermal.h>
+#include <string.h>
+#include <boot_if.h>
+
+#include "common.h"
+
+#define BTL_COUNTER_MAX		BIT(22)
+
+u32 get_efuse_read_reg(void)
+{
+	return mmPSOC_EFUSE_READ;
+}
+
+bool hl_is_debug_mode(enum hl_debug_hw_func func)
+{
+	u32 boot_strap = regmap_readl(mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS);
+	u32 strap_mask;
+
+	switch (func) {
+	case HL_DEBUG_HW_PCIE:
+		strap_mask = BIT(21); /* Dump Select[8] */
+		break;
+	case HL_DEBUG_HW_DRAM:
+		strap_mask = BIT(20); /* Dump Select[7] */
+		break;
+	case HL_DEBUG_HW_I2C:
+		strap_mask = BIT(19); /* Dump Select[6] */
+		break;
+	default:
+		preboot_puts_hex("Unknown H/W function ", func, false);
+		return 0;
+	}
+
+	return boot_strap & strap_mask;
+}
+
+static int preboot_wait_for_bit(unsigned int reg, unsigned long timeout_ns)
+{
+	unsigned int val;
+	unsigned long count = (timeout_ns * SYS_REF_CLOCK) / 1000000000UL;
+
+	while (count--) {
+		val = regmap_readl(reg);
+		if (val & 1)
+			return 0;
+	}
+
+	return 1;
+}
+
+static void preboot_wait_for_ext_ld_done(void)
+{
+	/*
+	 * Wait for HW FSM to complete 16KB copy to PHY
+	 * this is enough to set ext_ld_done.
+	 * FSM will set ext_ld_done after 32KB but why wait
+	 * if we can already move on
+	 */
+	while ((regmap_readl(mmPCIE_PHY_CR_PARA_CMD) & 0xFFFF) <= 0xD780)
+		;
+	regmap_writel(1, mmPCIE_PHY_PHYX_SRAM_EXT_LD_DONE_0);
+	regmap_writel(1, mmPCIE_PHY_PHYX_SRAM_EXT_LD_DONE_1);
+	regmap_writel(1, mmPCIE_PHY_PHYX_SRAM_EXT_LD_DONE_2);
+	regmap_writel(1, mmPCIE_PHY_PHYX_SRAM_EXT_LD_DONE_3);
+}
+
+static void preboot_wait_for_stable_pclk(void)
+{
+	int ret;
+
+	while (1) {
+		ret = 0;
+		/* Wait for PCLK stable - check MPLLA [no timeout] */
+		ret |= preboot_wait_for_bit(mmPCIE_PHY_PHYX_MPLLA_STATE_0, 100);
+		ret |= preboot_wait_for_bit(mmPCIE_PHY_PHYX_MPLLA_STATE_1, 100);
+		ret |= preboot_wait_for_bit(mmPCIE_PHY_PHYX_MPLLA_STATE_2, 100);
+		ret |= preboot_wait_for_bit(mmPCIE_PHY_PHYX_MPLLA_STATE_3, 100);
+		if (!ret)
+			break;
+
+		ret = 0;
+		/* Wait for PCLK stable - check MPLLB [no timeout] */
+		ret |= preboot_wait_for_bit(mmPCIE_PHY_PHYX_MPLLB_STATE_0, 100);
+		ret |= preboot_wait_for_bit(mmPCIE_PHY_PHYX_MPLLB_STATE_1, 100);
+		ret |= preboot_wait_for_bit(mmPCIE_PHY_PHYX_MPLLB_STATE_2, 100);
+		ret |= preboot_wait_for_bit(mmPCIE_PHY_PHYX_MPLLB_STATE_3, 100);
+		if (!ret)
+			break;
+	}
+}
+
+/*
+ * Handle PCIe erratum: make sure reset_n de-asserted only after perst
+ * Assume PRSTn tied with cold reset
+ * Assume PCIe enable strap (DIP switch) is set, and hence HW enable LTSSM
+ */
+void preboot_pcie_wait_for_link(void)
+{
+	preboot_wait_for_ext_ld_done();
+	preboot_wait_for_stable_pclk();
+
+	while (1) {
+		unsigned int prstn, ltssm, smlh, rdlh, hot_reset;
+
+		prstn = regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN);
+		ltssm = regmap_readl(mmPCIE_AUX_LTSSM_EN);
+		smlh = regmap_readl(mmPCIE_AUX_SMLH_LINK_UP);
+		rdlh = regmap_readl(mmPCIE_AUX_RDLH_LINK_UP);
+		hot_reset = regmap_readl(mmPCIE_CORE_HOT_RST);
+
+		if ((hot_reset & BIT(0)) == BIT(0)) {
+			regmap_writel(0x10, mmPCIE_CORE_HOT_RST);
+			regmap_writel(1, mmPCIE_AUX_LTSSM_EN);
+		}
+
+		if (prstn && smlh && rdlh) {
+			preboot_puts("PCIe link is UP!\n");
+			break;
+		}
+
+		/*
+		 * Some host assert prstn during link up while moving to GEN3
+		 * This cause BAR size to be reset
+		 * We stop link up process by disabling ltssm
+		 * till BAR is reconfigured
+		 */
+		if (!prstn && ltssm) {
+			regmap_writel(0, mmPCIE_AUX_LTSSM_EN);
+			continue;
+		}
+
+		if (prstn && !ltssm) {
+			regmap_writel(1, mmPCIE_AUX_LTSSM_EN);
+			continue;
+		}
+	}
+}
+
+/* Handle BTL erratum: exhaust timeout counter before any SPI access */
+void preboot_delay(void)
+{
+	unsigned long cntpct, end;
+	int i;
+
+	/* get begin counter value and calc end counter value */
+	asm volatile("mrs %0, cntpct_el0" : "=r" (cntpct));
+	end = cntpct + BTL_COUNTER_MAX;
+
+	for (i = 0; i < BTL_COUNTER_MAX; i++) {
+		asm volatile("mrs %0, cntpct_el0" : "=r" (cntpct));
+		if (cntpct >= end)
+			break;
+	}
+}
+
+void preboot_putc_virt_uart(const char c)
+{
+	/*
+	 * update vUART to HOST
+	 * DATA: mmPCIE_DB_RSV_RSV_0
+	 * STATUS: mmPCIE_DB_RSV_RSV_1
+	 */
+	regmap_writel(c, mmPCIE_DB_RSV_RSV_0);
+	regmap_writel(1, mmPCIE_DB_RSV_RSV_1);
+}
+
+unsigned int get_cs_pad_sel(void)
+{
+	return mmPSOC_GLOBAL_CONF_PAD_SEL_53;
+}
+
+void preboot_sync_btl(void) {}
+
+void hl_plat_early_init(void) {}
+
+void image_start(u64 loadaddr)
+{
+	void (*image_entry)(void) = (void *)loadaddr;
+
+	image_entry();
+}
+
+void ppboot_cp_preboot(u64 loadaddr, u32 offset, u32 size, char *name)
+{
+	preboot_puts_hex_raw("Preboot loadaddr: ",
+			     (u32)(loadaddr >> 32), false);
+	preboot_puth((u32)loadaddr, false);
+
+	spi_copy((void *)loadaddr, offset, size, name);
+}
+
+u32 hl_pll_timestamp_base_get(void)
+{
+	return mmCPU_TIMESTAMP_CNTCR;
+}
+
+void lkd_dev_specific_setup(void)
+{
+	cpu_boot_dev_sts_clrset(CPU_BOOT_DEV_STS0_FW_LD_COM_EN, true);
+}
+
+#define GOYA_ASIC_TS_MAX_COUNT 3
+
+int hl_ts_get_count(void)
+{
+	return GOYA_ASIC_TS_MAX_COUNT;
+}
+
+/* Hard coded each of the goya on-chip TS device properties */
+struct hl_ts_cfg goya_hl_ts_data[GOYA_ASIC_TS_MAX_COUNT] = {
+	{.base = mmNORTH_THERMAL_SENSOR_BASE & ~HL_CFG_BASE,
+		.alarm_a = 110, .alarm_b = 120,
+		.calib_offset = 8, .use_calib = true, .hl_tmp_data = { 0 }},
+	{.base = mmPSOC_TS_BASE & ~HL_CFG_BASE,
+		.alarm_a = 110, .alarm_b =  120,
+		.calib_offset = 9, .use_calib = true, .hl_tmp_data = { 0 }},
+	{.base = mmTPC_THEMAL_SENSOR_BASE & ~HL_CFG_BASE,
+		.alarm_a = 110, .alarm_b = 120,
+		.calib_offset = 10, .use_calib = true, .hl_tmp_data = { 0 }},
+};
+
+void hl_ts_data_init(void)
+{
+	u32 pll_base;
+
+	pll_base = mmCPU_PLL_BASE & ~HL_CFG_BASE;
+	goya_hl_ts_data[0].freq = hl_pll_get_freq(pll_base, HL_PLL_DIV2);
+
+	pll_base = mmPSOC_PCI_PLL_BASE & ~HL_CFG_BASE;
+	goya_hl_ts_data[1].freq = hl_pll_get_freq(pll_base, HL_PLL_DIV1);
+
+	pll_base = mmTPC_PLL_BASE & ~HL_CFG_BASE;
+	goya_hl_ts_data[2].freq = hl_pll_get_freq(pll_base, HL_PLL_DIV3);
+
+	memcpy(hl_ts_data, goya_hl_ts_data,
+		sizeof(struct hl_ts_cfg) * GOYA_ASIC_TS_MAX_COUNT);
+}
+
+void spi_prot_late(void)
+{
+	spi_prot();
+}
+
+void spi_prot_early(void) {}
