+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2020 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <stdbool.h>
+
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+#include <psoc_global_conf_regs.h>
+
+#define SYS_CLOCK_FREQUENCY	155000ULL
+#define UART_CLOCK_FREQUENCY	11900ULL
+#define PLDM_UART_BAUDRATE	300
+
+u32 hl_skip_pcie_init(void)
+{
+	return 1;
+}
+
