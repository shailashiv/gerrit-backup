diff --git a/arch/gaudi2_arc_gnu/pldm.c b/arch/gaudi2_arc_gnu/pldm.c
new file mode 100644
index 0000000..aa4dd16
--- /dev/null
+++ b/arch/gaudi2_arc_gnu/pldm.c
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ *
+ * (C) Copyright 2021 HabanaLabs, Ltd.
+ *
+ */
+
+
+#include <stdbool.h>
+
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+#include <psoc_cpu_pll_ctrl_regs.h>
+#include <psoc_global_conf_regs.h>
+#include "common.h"
+
+#define SYS_CLOCK_FREQUENCY	155000ULL
+
+/*
+ * With Goya2 v88 PLDM image when PCI pll div3
+ * is bumped up tp 250 MHz actual clock goes
+ * to 12.9 KHz.
+ */
+#define UART_CLOCK_FREQUENCY	12900ULL
+
+/* Working BAUD rate on PLDM */
+#define PLDM_UART_BAUDRATE	300
+
+/*
+ * This cfg specific to PLDM bumps up uart freq
+ * to 250 MHz while keeping other div's on refclk
+ */
+/*
+ * TODO: Enable this later
+static struct hl_pll_cfg gaudi2_pll_cfg[] = {
+	{
+		.name = "CPU", .base = mmPSOC_CPU_PLL_CTRL_BASE,
+		.nr = 1, .nf = 60, .od = 2, .nb = 3,
+		.div_factor = { 0, 0, 4, 1 },
+		.div_sel = { HL_PLL_REF_CLK,
+			HL_PLL_REF_CLK,
+			HL_PLL_REF_CLK,
+			HL_PLL_DIV_PLL
+		},
+	}
+};
+*/
+
+u32 hl_skip_pcie_init(void)
+{
+	return 0;
+}
+
+u64 hl_pll_timestamp_freq_get(void)
+{
+	return SYS_CLOCK_FREQUENCY;
+}
+
+void hl_dev_pll_init(void)
+{
+	/* TODO: Enable this later */
+	/* Bump up UART frequency */
+	//hl_pll_init(gaudi2_pll_cfg, 1);
+}
+
+void hl_uart_init(void)
+{
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_8);	/* UART0 RXD */
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_9);	/* UART0 TXD */
+	preboot_uart_init(UART_CLOCK_FREQUENCY / PLDM_UART_BAUDRATE);
+}
+
+u32 hl_spi_baudr_get(void)
+{
+	u32 factor = 2; /* Min Divider */
+
+	/* baud rate doesn't support odd number */
+	return (factor + 1) & 0xFFFE;
+}
+void preboot_init_pcie_phy(void) {}
diff --git a/arch/gaudi2_arc_gnu/pll.c b/arch/gaudi2_arc_gnu/pll.c
new file mode 100644
index 0000000..792820c
--- /dev/null
+++ b/arch/gaudi2_arc_gnu/pll.c
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2021 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <stddef.h>
+#include <bitops.h>
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+#include "common.h"
+
+
+#define GAUDI2_PLL_CFG_DIV		0x104
+
+u32 hl_pll_get_freq(u32 pll_base, enum hl_pll_div_out div)
+{
+	u32 div_sel, factor, offset;
+	u32 reg, fbdiv, refdiv, postdiv1, postdiv2;
+	u64 out_freq = SYS_REF_CLOCK;
+
+	offset = div * sizeof(u32);
+	div_sel = regmap_readl(pll_base + HL_PLL_DIV_SEL + offset);
+
+	if (div_sel == HL_PLL_PLL_CLK || div_sel == HL_PLL_DIV_PLL) {
+		reg = regmap_readl(pll_base + GAUDI2_PLL_CFG_DIV);
+		/* fbdiv : bits 0-11 */
+		fbdiv = EXTRACT_BITS(reg, 0, 12);
+		/* postdiv1 : bits 16-18 */
+		postdiv1 = EXTRACT_BITS(reg, 16, 3);
+		/* postdiv2 : bits 20-22 */
+		postdiv2 = EXTRACT_BITS(reg, 20, 3);
+		/* refdiv : bits 24-29 */
+		refdiv  = EXTRACT_BITS(reg, 24, 6);
+		out_freq = SYS_REF_CLOCK * fbdiv;
+		out_freq /= refdiv * postdiv1 * postdiv2;
+	}
+
+	if (div_sel == HL_PLL_DIV_REF || div_sel == HL_PLL_DIV_PLL) {
+		factor = regmap_readl(pll_base + HL_PLL_DIV_FACTOR + offset);
+		out_freq /= factor + 1;
+	}
+
+	/*
+	 * TODO : The clock relaxation is not accounted here.
+	 * We might need to deal with it in the future.
+	 */
+
+	return out_freq;
+}
+
+#ifdef TARGET_IS_PLDM
+
+#define GAUDI2_PLL_CFG		0x100
+#define GAUDI2_PLL_CFG_EN	BIT(0)
+#define GAUDI2_PLL_CFG_LOCK	BIT(16)
+#define GAUDI2_PLL_DIV_SEL_DELAY	0x1E0
+
+
+void hl_pll_reset(struct hl_pll_cfg *cfg, bool reset)
+{
+	u32 reg = regmap_readl(cfg->base + GAUDI2_PLL_CFG);
+
+	if (true == reset)
+		reg |= GAUDI2_PLL_CFG_EN;
+	else
+		reg &= ~GAUDI2_PLL_CFG_EN;
+
+	regmap_writel(reg, cfg->base + GAUDI2_PLL_CFG);
+}
+
+int hl_pll_is_locked(struct hl_pll_cfg *cfg)
+{
+	return regmap_readl(cfg->base + GAUDI2_PLL_CFG) & GAUDI2_PLL_CFG_LOCK;
+}
+
+#define GAUDI2_PLL_POSTDIV1_SHIFT	16
+#define GAUDI2_PLL_POSTDIV2_SHIFT	20
+#define GAUDI2_PLL_REFDIV_SHIFT		24
+#define GAUDI2_PLL_MAX_WAIT_TIME		1
+
+void hl_pll_cfg(struct hl_pll_cfg *cfg)
+{
+	u32 reg = 0;
+
+	/* put the PLL into reset by writing 0 to CTRL_CFG.EN */
+	hl_pll_reset(cfg, false);
+
+	/* FBDIV - bit 0
+	 * POSTDIV1 - bit 16
+	 * POSTDIV2 - bit 20
+	 * REFDIV - bit 24
+	 */
+	reg = cfg->nr << GAUDI2_PLL_REFDIV_SHIFT |
+		cfg->nb << GAUDI2_PLL_POSTDIV2_SHIFT |
+		cfg->od << GAUDI2_PLL_POSTDIV1_SHIFT | cfg->nf;
+
+	regmap_writel(reg, cfg->base + GAUDI2_PLL_CFG_DIV);
+
+	/* after updating the coefficients we need to wait >=1us */
+	udelay(GAUDI2_PLL_MAX_WAIT_TIME);
+
+	/* enable the PLL by writing a value of 1 to CTRL_CFG.EN*/
+	hl_pll_reset(cfg, true);
+}
+
+void hl_pll_ack_int(struct hl_pll_cfg *cfg) { }
+
+void hl_pll_clear_lock_status(struct hl_pll_cfg *cfg) { }
+
+void hl_pll_clk_relax_reset(struct hl_pll_cfg *cfg)
+{
+	/* TODO: implement resetting the clock relaxation */
+}
+
+void hl_pll_set_div_sel_delay(struct hl_pll_cfg *cfg)
+{
+	regmap_writel(1, cfg->base + GAUDI2_PLL_DIV_SEL_DELAY);
+}
+
+#endif /* TARGET_IS_PLDM */
diff --git a/arch/gaudi2_arc_gnu/ppboot.lds.S b/arch/gaudi2_arc_gnu/ppboot.lds.S
new file mode 100644
index 0000000..c3a55fb
--- /dev/null
+++ b/arch/gaudi2_arc_gnu/ppboot.lds.S
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright 2021 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include "common.h"
+
+#ifdef __arc__
+OUTPUT_FORMAT("elf32-littlearc", "elf32-bigarc", "elf32-littlearc")
+OUTPUT_ARCH(arc)
+
+MEMORY
+{
+	.sram 	: ORIGIN = PPBOOT_TEXT_BASE, LENGTH = PPBOOT_SIZE
+	DCCM	: ORIGIN = PPBOOT_DCCM_BASE, LENGTH = 8K
+}
+
+REGION_ALIAS("REGION_DATA",	DCCM)
+REGION_ALIAS("REGION_SDATA",	DCCM)
+REGION_ALIAS("REGION_BSS",	DCCM)
+REGION_ALIAS("REGION_STACK",	DCCM)
+
+#endif
+
+ENTRY(_start)
+SECTIONS
+{
+	.text : {
+		. = ALIGN(8);
+		ppboot/crt0_ppboot.o (.text*)
+		*(.text .text.*)
+		_etext = . ;
+	} >.sram
+
+	.rodata : AT ( LOADADDR(.text) + SIZEOF(.text) ) {
+		_rodata = .;
+		*(.rodata .rodata.*)
+		_erodata = . ;
+        } >.sram
+
+	.data : AT ( LOADADDR(.rodata) + SIZEOF(.rodata) ) {
+		. = ALIGN(8);
+		_data = .;
+		*(.data .data.*)
+		_edata = .;
+        } > REGION_DATA
+
+	.sdata : AT ( LOADADDR(.data) + SIZEOF(.data) ) {
+		. = ALIGN(8);
+		_sdata = .;
+		*(.sdata .sdata.* .gnu.linkonce.s.*)
+		_esdata = . ;
+        } > REGION_SDATA
+
+	.bss : {
+		. = ALIGN(8);
+		__bss_start = . ;
+		*(.bss*)
+		__bss_end = . ;
+	} > REGION_BSS
+
+	.stack : {
+		. = ALIGN(8);
+		__stack = . ;
+		. = . + 512 ;
+		__stack_top = . ;
+	} > REGION_STACK
+
+	.note.gnu.build-id : { *(.note.gnu.build-id) } > .sram
+}
