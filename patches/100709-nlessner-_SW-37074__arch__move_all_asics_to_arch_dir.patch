+++ b/arch/gaudi2/common.h
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Copyright (C) 2020 HabanaLabs Ltd.
+ */
+
+#ifndef COMMON_GAUDI2_ARM_H_
+#define COMMON_GAUDI2_ARM_H_
+
+#include <gaudi2_blocks_linux_driver.h>
+#include <bitops.h>
+
+#ifdef TARGET_IS_ONIX
+#define PPBOOT_TEXT_BASE		0x8200000000
+#define SDRAM_BASE			0x8200000000ull
+#else
+#define PPBOOT_TEXT_BASE		0x7FFD000000
+#define SDRAM_BASE			0x7FFD000000ull
+#endif
+
+#define HL_PCIE_LINK_RETRIES             50
+#define HL_FW_BOOT_PTRS_BASE		0x80000
+#define HL_SPI_LEGACY_PREBOOT_OFF	0xC0000
+
+#define PPBOOT_SIZE			0x5000		/* 20KB */
+#define PREBOOT_SIZE			0x10000		/* 64KB */
+#define SRAM_SIZE			0x3000000	/* 48MB */
+#define PREBOOT_TEXT_BASE		(PPBOOT_TEXT_BASE + PPBOOT_SIZE)
+
+#define CFG_REGION_SIZE			0xC000000
+#define BAR0_RSRVD_SIZE			0x1000000
+
+#define HL_SPI_BASE			0x3FF6000000ull
+#define HL_CFG_BASE			0x3FF8000000ull
+#define STM_FLASH_BASE			0x1000007FF4000000ull
+#define BAR0_RSRVD_BASE			0x1000FFFFFC000000ull
+#define DRAM_BASE			0x1001000000000000ull
+
+#define HOST_PHYS_BASE_0		0x0000000000000000ull
+#define HOST_PHYS_SIZE_0		0x0100000000000000ull
+
+#define HL_SP_SRAM_BASE			0x7FF7FE0000ULL
+#define HL_SP_SRAM_SIZE			0x10000
+#define FUSE_WORDS_PER_BANK		0x40
+#define I2C_SLAVE_ADDRESS		0x6A
+#define I2C_SLAVE_ADDRESS_DBG		0x47
+#define ARC_RST_VALUE			0x110
+#define ARC_RST_VEC_ADDR		0x0
+#define ARC0_MEM_SIZE			(ARC0_ICCM_SIZE + ARC0_DCCM_SIZE)
+#define ARC1_MEM_SIZE			(ARC1_ICCM_SIZE + ARC1_DCCM_SIZE)
+
+#define HL_PCIE_LINK_RETRIES		50
+#define HL_INIT_SP_SRAM_RETRIES		50
+
+#define BOOT_INFO_BASE			HL_SP_SRAM_BASE
+
+/*
+ * Set ARCs in halt state before reset
+ * 1. Set halt bit in RUN_HALT_REQ register
+ * 2. Clear halt bit in RUN_HALT_REQ register
+ * 3. Set Reset bit
+ */
+#define HALT_N_RESET_ARC(id)						 \
+	do {								 \
+		regmap_writel(BIT(1), mmPSOC_ARC##id##_CFG_RUN_HALT_REQ);\
+		regmap_writel(0x0, mmPSOC_ARC##id##_CFG_RUN_HALT_REQ);	 \
+		regmap_writel(0x1, mmPSOC_ARC##id##_CFG_ARC_RST);	 \
+	} while (0)
+/*
+ * Set ARC in running state
+ * 1. Set run bit in RUN_HALT_REQ register
+ * 2. Wait for ACK from core in RUN_HALT_ACK register
+ * 3. Clear run bit in RUN_HALT_REQ register
+ */
+#define RUN_ARC(id)							       \
+	do {								       \
+		regmap_writel(BIT(0), mmPSOC_ARC##id##_CFG_RUN_HALT_REQ);      \
+		while (!(regmap_readl(mmPSOC_ARC##id##_CFG_RUN_HALT_ACK) &     \
+				PSOC_ARC##id##_CFG_RUN_HALT_ACK_RUN_ACK_MASK)) \
+			;						       \
+		regmap_writel(0x0, mmPSOC_ARC##id##_CFG_RUN_HALT_REQ);	       \
+	} while (0)
+
+#define PCIE_PHY_EXT_MPLLB_SSC_PEAK			0x5000
+#define PCIE_PHY_EXT_MPLLB_SSC_STEP_SIZE		0x19CE
+#define PCIE_PHY_EXT_MPLLA_SSC_PEAK			0x6666
+#define PCIE_PHY_EXT_MPLLA_SSC_STEP_SIZE		0x2108
+
+#define PCIE_PHY_PROTOCOL0_EXT_MPLLA_MULTIPLIER		0x50
+#define PCIE_PHY_PROTOCOL0_EXT_MPLLA_MULTIPLIER_SR	0xA0
+#define PCIE_PHY_PROTOCOL0_EXT_MPLLB_MULTIPLIER		0x7D
+#define PCIE_PHY_PROTOCOL0_EXT_TX_EQ_MAIN_G1_SLICE0	0x30
+#define PCIE_PHY_PROTOCOL0_EXT_TX_EQ_MAIN_G2_SLICE0	0x30
+#define PCIE_PHY_PROTOCOL0_EXT_TX_EQ_MAIN_G3_SLICE0	0x30
+#define PCIE_PHY_PROTOCOL0_EXT_TX_EQ_MAIN_G4_SLICE0	0x30
+
+#define PCIE_PHY_PROTOCOL0_EXT_MPLLA_BANDWIDTH_SR_LOW	0x25
+#define PCIE_PHY_PROTOCOL0_EXT_MPLLA_BANDWIDTH_SR_HIGH	0x25
+#define PCIE_PHY_PROTOCOL0_EXT_MPLLB_BANDWIDTH_SR_LOW	0x25
+#define PCIE_PHY_PROTOCOL0_EXT_MPLLB_BANDWIDTH_SR_HIGH	0x25
+#define PCIE_PHY_PROTOCOL0_EXT_MPLLB_BANDWIDTH_LOW	0x1C3
+#define PCIE_PHY_PROTOCOL0_EXT_MPLLB_BANDWIDTH_HIGH	0x1C3
+
+#define PCIE_PHY_PROTOCOL0_EXT_RX_ADAPT_MODE_G3_CONF	0x5555
+#define PCIE_PHY_PROTOCOL0_EXT_RX_ADAPT_SEL_G4_CONF	0xFF
+
+#define I2C_SLAVE_DEFAULT_INTR_MASK			0x48FF
+
+#endif /* COMMON_GAUDI2_ARM_H_ */
+
diff --git a/arch/gaudi2/onix.c b/arch/gaudi2/onix.c
new file mode 100644
index 0000000..4c28fb1
--- /dev/null
+++ b/arch/gaudi2/onix.c
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2020 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <stdbool.h>
+
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+#include <cmd_module.h>
+#include <psoc_global_conf_regs.h>
+
+#define SYS_CLOCK_FREQUENCY	35000000ULL
+
+u32 hl_skip_pcie_init(void)
+{
+	return 1;
+}
+
+u64 hl_pll_timestamp_freq_get(void)
+{
+	return SYS_CLOCK_FREQUENCY;
+}
+
+void hl_uart_init(void)
+{
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_8);	/* UART0 RXD */
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_9);	/* UART0 TXD */
+	preboot_uart_init(SYS_CLOCK_FREQUENCY / (HL_UART_BAUDRATE / 2));
+}
+
+u32 hl_spi_baudr_get(void)
+{
+	u32 factor;
+
+	factor = SYS_CLOCK_FREQUENCY / HL_SPI_FLASH_MAX_FREQ;
+
+	/* baud rate doesn't support odd number */
+	return (factor + 1) & 0xFFFE;
+}
+
+enum cmd_check_res dev_specific_module_pci_check(void)
+{
+	/*
+	 * FLR and Hot Reset Registers are not part of PSOC and hence
+	 * writing to them results in ERROR that is resetting the
+	 * ONIX. To avoid it, simply return with NOT FOUND
+	 */
+	return NOT_FOUND;
+}
+
+void preboot_sync_btl(void) {}
+
+void hl_dev_ts_init(void) {}
