-void spi_base_get(unsigned int *regs)
-{
-	*regs = mmPSOC_QSPI_CTRLR0;
-}
-
-void image_start(u64 loadaddr)
-{
-	void (*image_entry)(void) = (void *)loadaddr;
-
-	image_entry();
-}
-
-void preboot_start_image(u64 startaddr)
-{
-	/*
-	 * After image_entry, control is not expected to return
-	 * here and continue.
-	 */
-	image_start(startaddr);
-
-
-	/* Set ARC0 and ARC1 in running state */
-	/*
-	 * TODO: Move run arc above image start once zephyr
-	 * support is added
-	 */
-	RUN_ARC(0);
-	RUN_ARC(1);
-}
-
-static void fit_copy_arc_image(u64 dst, const void *buf, int len)
-{
-	/* TODO: copy images once zephyr support is added */
-	return;
-
-	/*
-	 * initialize scratch SRAM to avoid ECC exceptions
-	 * ECC errors are observed due to byte copy to SP
-	 * memory which turns to be read-modify-write transaction
-	 */
-	init_sp_sram();
-
-	/* TODO: Add later */
-}
-
-void preboot_copy_image(u64 dst, const void *buf, int len, const char *arch)
-{
-	if (!strcmp(arch, "arc"))
-		fit_copy_arc_image(dst, buf, len);
-	else
-		memcpy((void *)dst, buf, len);
-}
-
-void ppboot_cp_preboot(u64 loadaddr, u32 offset, u32 size, char *name)
-{
-	preboot_puts_hex_raw("Preboot loadaddr: ",
-			     (u32)(loadaddr >> 32), false);
-	preboot_puth((u32)loadaddr, false);
-
-	spi_copy((void *)loadaddr, offset, size, name);
-}
-
-u32 hl_pll_timestamp_base_get(void)
-{
-	return mmCPU_TIMESTAMP_CNTCR;
-}
-
-void pci_dev_specific_hot_rst(void)
-{
-	regmap_writel(0x10, mmPCIE_CORE_HOT_RST);
-	regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
-}
-
-bool preboot_is_valid_address_range(u64 addr, int len)
-{
-	if (addr >= HL_SP_SRAM_BASE &&
-	    addr + len < HL_SP_SRAM_BASE + HL_SP_SRAM_SIZE)
-		return true;
-
-	if (preboot_sram_is_valid_address_range(addr, len))
-		return true;
-
-	if (addr >= ARC0_ICCM_BASE_ADDR &&
-	    addr + len < ARC0_ICCM_BASE_ADDR + ARC0_MEM_SIZE)
-		return true;
-
-	if (addr >= ARC1_ICCM_BASE_ADDR &&
-	    addr + len < ARC1_ICCM_BASE_ADDR + ARC1_MEM_SIZE)
-		return true;
-
-	return false;
-}
-
-u32 get_efuse_read_reg(void)
-{
-	return mmPSOC_EFUSE_READ_CTRL;
-}
-
-u32 dev_pci_dbi_cfg_offset_get(void)
-{
-	return (u32)mmPCIE_DBI_BASE & 0xFFFFFFF;
-}
