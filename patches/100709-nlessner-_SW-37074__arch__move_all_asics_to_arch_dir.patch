+
+#ifndef COMMON_GAUDI2_ARC_GNU_H_
+#define COMMON_GAUDI2_ARC_GNU_H_
+
+#include <gaudi2_blocks_linux_driver.h>
+#include <bitops.h>
+
+#define SRAM_SIZE			0x3000000	/* 48MB */
+
+#define PPBOOT_SIZE			0x4000		/* 16KB */
+#define PREBOOT_SIZE			0xE000		/* 56KB */
+
+#define HL_FW_BOOT_PTRS_BASE		0x80000
+#define HL_SPI_LEGACY_PREBOOT_OFF	0xC0000
+
+#define HL_SP_SRAM_BASE		0x1000007FF7FE0000ULL
+#define HL_SP_SRAM_SIZE		0x10000
+#define PCIE_FW_SRAM_BASE	0x27FF0000
+#define FW_SRAM_BASE		0x27FD0000
+#define SP_SRAM_BASE		0x27FE0000
+#define ARC_ICCM_BASE		0x27040000
+#define SP_SRAM_PREBOOT_OFFSET	0x1000
+#define PPBOOT_TEXT_BASE	(FW_SRAM_BASE + 0xC)
+#define PREBOOT_TEXT_BASE	(SP_SRAM_BASE + SP_SRAM_PREBOOT_OFFSET + 0x8)
+
+/*
+ * TODO: this address is wrong, a good address must be set in order to use
+ * boot info API.
+ */
+#define BOOT_INFO_BASE		SP_SRAM_BASE
+
+/* In order not to conflict with ARC BOOTROM's usage of DCCM,
+ * Let PPBoot start from the offset of 0x402C, for using DCCM
+ * for its own BSS and Stack.
+ */
+#define PPBOOT_DCCM_BASE	0x8000402C
+
+#define SDRAM_BASE		0x11000000
+#define HL_SPI_BASE		0x26000000
+#define HL_CFG_BASE		0xF8000000
+#define I2C_SLAVE_DEFAULT_INTR_MASK	0x48FF
+
+#define FUSE_WORDS_PER_BANK	0x40
+#define I2C_SLAVE_ADDRESS	0x6A
+#define I2C_SLAVE_ADDRESS_DBG	I2C_SLAVE_ADDRESS
+
+#define EFUSE_SYSCFG_DISABLE_TWI_IF_MASK        BIT(19)
+#define EFUSE_SYSCFG_FW_VERSION_LOCATION_SPI	BIT(8)
+#define EFUSE_SYSCFG_ENABLE_VALIDATION_MASK	BIT(10)
+
+#define RECOVERY_TEXT_BASE	(0x0 + 0x4)
+#define RECOVERY_SIZE		0x4000
+
+#define ARC_RST_VALUE		0x110
+#define ARC_RST_VEC_ADDR	0x0
+
+#endif /* COMMON_GAUDI2_ARC_GNU_H_ */
