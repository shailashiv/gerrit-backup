+#define FW_WORD_NUM		0x2000	/* FW_SIZE / 2 */
+#define PCIE_LTR_DISABLE		0
+#define PCIE_CAP_HDR_NXT_OFFSET		0x1f8
+
+#define CPU1_RST_CTRL							\
+	((BIT(1) << CPU_CA53_CFG_ARM_RST_CONTROL_NCPUPORESET_SHIFT) |	\
+	 (BIT(1) << CPU_CA53_CFG_ARM_RST_CONTROL_NCORERESET_SHIFT))
+
+bool hl_is_debug_mode(enum hl_debug_hw_func func)
+{
+	u32 boot_strap = regmap_readl(mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS);
+	u32 strap_mask;
+
+	switch (func) {
+	case HL_DEBUG_HW_PCIE:
+		strap_mask = BIT(19); /* Dump Select[11] */
+		break;
+	case HL_DEBUG_HW_DRAM:
+		strap_mask = BIT(18); /* Dump Select[10] */
+		break;
+	case HL_DEBUG_HW_I2C:
+		strap_mask = BIT(17); /* Dump Select[9] */
+		break;
+	default:
+		preboot_puts_hex("Unknown H/W function ", func, false);
+		return 0;
+	}
+
+	return boot_strap & strap_mask;
+}
+
+static void preboot_init_pcie_phy_fw_update(void)
+{
+	/* Configure FW update size */
+	regmap_writel(FW_WORD_NUM, mmPCIE_WRAP_PHY_FW_FSM_SIZE);
+
+	/*
+	 * PHY FW FSM EN and Direct FW write mechanism enable
+	 * FW FSM assumes that the data is present in the SRAM
+	 * The FSM will wait for SRAM init done before updating
+	 * the SRAM contents
+	 */
+	regmap_writel(9, mmPCIE_WRAP_PHY_FW_FSM);
+
+	/* Take the PHY out of reset */
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
+}
+
+__weak void preboot_init_pcie_phy(void)
+{
+	/* Reset PCIe PHY */
+	regmap_writel(0, mmPSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
+
+	/*
+	 * Set PCIe PHY CR Para I/F to CFG.
+	 * Select CR PARA I/F instead of JTAG
+	 */
+	regmap_writel(1, mmPCIE_PHY_CR_PARA_SEL_0);
+	regmap_writel(1, mmPCIE_PHY_CR_PARA_SEL_1);
+	regmap_writel(1, mmPCIE_PHY_CR_PARA_SEL_2);
+	regmap_writel(1, mmPCIE_PHY_CR_PARA_SEL_3);
+
+	/* Select indirect access to CR PARA I/F instead of PRBI */
+	regmap_writel(1, mmPCIE_PHY_CR_PARA_CFG);
+
+	/*
+	 * Use PHY configuration from SoC online
+	 * instead of default values
+	 */
+	regmap_writel(1, mmPCIE_PHY_PHY_EXT_CTRL_SEL);
+	preboot_init_pcie_phy_fw_update();
+}
+
+#define FUSE_DEV_ID_WORD_OFFSET	1
+#define GAUDI_SECURE_PCI_ID_EXT	BIT(4)
+
+u32 preboot_get_vendor_id_device_id(void)
+{
+	u32 pci_dev_id = PCI_IDS_GAUDI;
+	char devid[5];
+
+	/* Read the second part of the device ID which contains the step */
+	if (!preboot_fuse_read(FUSE_DEV_ID_WORD_OFFSET + 1, (u32 *)devid)) {
+		devid[4] = '\0';
+		/* Check for device type B1 and set the PCI ID accordingly */
+		if (!strcmp(&devid[2], "B1"))
+			pci_dev_id = PCI_IDS_GAUDI_HL2000M;
+	}
+
+	/*
+	 * Secure pci ids:
+	 * PCI_IDS_GAUDI_SEC : 0x1010
+	 * PCI_IDS_GAUDI_HL2000M_SEC : 0x1011
+	 */
+	/* If security is enabled set the PCI ID accordingly*/
+	if (preboot_security_is_enabled())
+		pci_dev_id |= GAUDI_SECURE_PCI_ID_EXT;
+
+	return (pci_dev_id << 16) | PCI_VENDOR_ID_HABANALABS;
+}
+
+static void preboot_disable_pcie_ltr(void)
+{
+	u32 cap_hdr_cfg, dev_cap2_reg;
+
+	/* PCIe LTR configuration, set bits 31:20 to 0x1f8 */
+	cap_hdr_cfg = regmap_readl(mmPCIE_DBI_MARGIN_EXT_CAP_HDR_REG);
+	cap_hdr_cfg &= ~(PCIE_DBI_MARGIN_EXT_CAP_HDR_REG_NEXT_OFFSET_MASK);
+	cap_hdr_cfg |= (PCIE_CAP_HDR_NXT_OFFSET <<
+		 PCIE_DBI_MARGIN_EXT_CAP_HDR_REG_NEXT_OFFSET_SHIFT);
+	regmap_writel(cap_hdr_cfg, mmPCIE_DBI_MARGIN_EXT_CAP_HDR_REG);
+
+	/* Disable LTR support, set bit-11 to '0' */
+	dev_cap2_reg = regmap_readl(mmPCIE_DBI_DEVICE_CAPABILITIES2_REG);
+	dev_cap2_reg &= ~(PCIE_DBI_DEVICE_CAPABILITIES2_REG_PCIE_CAP_LTR_SUPP_MASK);
+	dev_cap2_reg |= (PCIE_LTR_DISABLE <<
+		 PCIE_DBI_DEVICE_CAPABILITIES2_REG_PCIE_CAP_LTR_SUPP_SHIFT);
+	regmap_writel(dev_cap2_reg, mmPCIE_DBI_DEVICE_CAPABILITIES2_REG);
+}
+
+void preboot_init_pcie(void)
+{
+	u64 start;
+	u32 ven_id_dev_id = preboot_get_vendor_id_device_id();
+
+	preboot_init_pcie_phy();
+
+	/* Update Vendor ID */
+	regmap_writel(ven_id_dev_id, mmPCIE_DBI_DEVICE_ID_VENDOR_ID_REG);
+
+	/* Update subsystem Vendor ID */
+	regmap_writel(ven_id_dev_id,
+		      mmPCIE_DBI_SUBSYSTEM_ID_SUBSYSTEM_VENDOR_ID_REG);
+
+	/* Disable the EQ REDO Gen3 */
+	regmap_writel(0x00402801, mmPCIE_DBI_GEN3_RELATED_OFF);
+	regmap_writel(0x04027041, mmPCIE_DBI_GEN3_EQ_CONTROL_OFF);
+
+	/* Disable the EQ REDO Gen4*/
+	regmap_writel(0x01402801, mmPCIE_DBI_GEN3_RELATED_OFF);
+	regmap_writel(0x04027041, mmPCIE_DBI_GEN3_EQ_CONTROL_OFF);
+
+	start = timestamp_get_us();
+	/* Wait for ext_ld_done before executing W/A */
+	while (regmap_readl(mmPCIE_PHY_PHYX_SRAM_EXT_LD_DONE_0) &&
+	       regmap_readl(mmPCIE_PHY_PHYX_SRAM_EXT_LD_DONE_1) &&
+	       regmap_readl(mmPCIE_PHY_PHYX_SRAM_EXT_LD_DONE_2) &&
+	       regmap_readl(mmPCIE_PHY_PHYX_SRAM_EXT_LD_DONE_3)) {
+		/*
+		 * PCIe external load complete should take maximum of 300us
+		 * to complete. Including some grace period 576us of
+		 * timeout is used
+		 */
+		if (timeout_expired(start, PCIE_EXT_LD_TIMEOUT_US)) {
+			preboot_puts("Timed-out waiting for ext_ld_done!");
+			break;
+		}
+	}
+
+
+	/* Execute the Synopsys W/A */
+	regmap_writel(0xF, mmPCIE_PHY_CR_PARA_CTRL);
+	regmap_writel(0x0004A07D, mmPCIE_PHY_CR_PARA_CMD);
+	udelay(20);
+
+	/* Set BAR4 size to 32GB */
+	regmap_writel(0x00100000, mmPCIE_AUX_DBI);
+	regmap_writel(0xFFFFFFFF, mmPCIE_DBI_BAR4_REG);
+	regmap_writel(0x00000007, mmPCIE_DBI_BAR5_REG);
+	regmap_writel(0x00000000, mmPCIE_AUX_DBI);
+
+	/* PCIe disable LTR */
+	preboot_disable_pcie_ltr();
+
+	/* Enable and Mask LTSSM (erratum 102) */
+	regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
+}
+
+/*
+ * This function makes sure no access is done from host to the SoC's PCIe IF.
+ * The inbound memory requests are disabled. The ELBI access gets "retry"
+ * response. All channels provide responses to the host and PCIe
+ * link will not break.
+ */
+void hl_pcie_disable_access(void)
+{
+	u32 reg;
+
+	/* Disable the ELBI access */
+	regmap_writel(1, mmPCIE_CORE_REQ_RETRY_EN);
+
+	/* Disable the PCIe inbound memory requests */
+	reg = regmap_readl(mmPCIE_DBI_STATUS_COMMAND_REG);
+	reg &= ~BIT(1);
+	regmap_writel(reg, mmPCIE_DBI_STATUS_COMMAND_REG);
+}
+
+void hl_pcie_enable_access(void)
+{
+	u32 reg;
+
+	/* Enable the ELBI access */
+	regmap_writel(0, mmPCIE_CORE_REQ_RETRY_EN);
+
+	/* Enable the PCIe inbound memory requests */
+	reg = regmap_readl(mmPCIE_DBI_STATUS_COMMAND_REG);
+	reg |= BIT(PCIE_DBI_STATUS_COMMAND_REG_PCI_TYPE0_MEM_SPACE_EN_SHIFT);
+	regmap_writel(reg, mmPCIE_DBI_STATUS_COMMAND_REG);
+}
+static void preboot_pcie_monitoring(void)
+{
+	/* Wait for PRSTn */
+	while (!regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN))
+		;
+
+	/* Only after PRSTn is de-asserted */
+	preboot_pcie_enable();
+
+	while (1) {
+		unsigned int prstn, ltssm, smlh, rdlh;
+
+		prstn = regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN);
+		ltssm = regmap_readl(mmPCIE_AUX_LTSSM_EN);
+		smlh = regmap_readl(mmPCIE_AUX_SMLH_LINK_UP);
+		rdlh = regmap_readl(mmPCIE_AUX_RDLH_LINK_UP);
+
+		if (prstn && smlh && rdlh)
+			break;
+
+		/*
+		 * Some host assert prstn during link up while moving to GEN3
+		 * This cause BAR size to be reset
+		 * We stop link up process by disabling ltssm
+		 * till BAR is reconfigured
+		 */
+		if (!prstn && ltssm) {
+			regmap_writel(0, mmPCIE_AUX_LTSSM_EN);
+			continue;
+		}
+
+		if (prstn && !ltssm) {
+			regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
+			continue;
+		}
+	}
+
+	/* W/A H/W bug that may lead to have a wrong mask (0x1) in LTSSM */
+	regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
+}
+
+void preboot_secondary_cpu_stop(void)
+{
+	u32 rst_ctrl = regmap_readl(mmCPU_CA53_CFG_ARM_RST_CONTROL);
+
+	rst_ctrl &= ~CPU1_RST_CTRL; /* Reset CPU1 */
+	regmap_writel(rst_ctrl, mmCPU_CA53_CFG_ARM_RST_CONTROL);
+}
+
+void secondary_main(void)
+{
+	preboot_pcie_monitoring();
+
+	/* Hang in WFE until further notice */
+	while (1)
+		wfe();
+}
+
+void preboot_pcie_wait_for_link(void)
+{
+	u32 rst_addr_lsb, rst_addr_msb, rst_ctrl;
+
+	/*
+	 * Call preboot_security_is_enabled() before offloading PCI work to
+	 * CPU1 is needed because we don't want CPU1 to init fuse or access OTP
+	 * while CPU0 is running and may attempt access the same resource.
+	 * Performing this call fills the fuse/OTP cache so a secondary call
+	 * will only read from cache.
+	 */
+	(void)preboot_security_is_enabled();
+
+	rst_addr_lsb = (u32)(uintptr_t)secondary_entry;
+	rst_addr_msb = (u32)(uintptr_t)(((uintptr_t)secondary_entry) >> 32);
+	regmap_writel(rst_addr_lsb, mmCPU_CA53_CFG_RST_ADDR_LSB_1);
+	regmap_writel(rst_addr_msb, mmCPU_CA53_CFG_RST_ADDR_MSB_1);
+
+	rst_ctrl = regmap_readl(mmCPU_CA53_CFG_ARM_RST_CONTROL);
+	rst_ctrl |= CPU1_RST_CTRL; /* Take CPU1 out of reset */
+	regmap_writel(rst_ctrl, mmCPU_CA53_CFG_ARM_RST_CONTROL);
+}
+
+void preboot_delay(void) {}
+
+#define mmPCIE_WRAP_VUART_TX_DATA	0xC01F60
+#define mmPCIE_WRAP_VUART_TX_STATUS	0xC01F64
+void preboot_putc_virt_uart(const char c)
+{
+	/*
+	 * update vUART to HOST
+	 * DATA: mmPCIE_WRAP_VUART_TX_DATA
+	 * STATUS: mmPCIE_WRAP_VUART_TX_STATUS
+	 */
+	regmap_writel(c, mmPCIE_WRAP_VUART_TX_DATA);
+	regmap_writel(1, mmPCIE_WRAP_VUART_TX_STATUS);
+}
+
+unsigned int get_cs_pad_sel(void)
+{
+	return mmPSOC_GLOBAL_CONF_PAD_SEL_53;
+}
+
+/*
+ * Wait for Boot Manager to complete PCIe image execution
+ * and return to idle state, so it won't initiate UART access anymore
+ */
+void preboot_sync_btl(void)
+{
+	u64 start = timestamp_get_us();
+
+	while (regmap_readl(mmPSOC_GLOBAL_CONF_BTM_FSM)) {
+		/*
+		 * Boot manager is supposed to complete entire execution
+		 * of FSM, BTL primary/secondary at this point. Though
+		 * It should not take more than 100ms for it to finish
+		 * timeout of half second is used here.
+		 */
+		if (timeout_expired(start, BTL_SYNC_TIMEOUT_US))
+			break;
+	}
+}
+
+void hl_plat_early_init(void)
+{
+	cpu_boot_dev_sts_clrset(CPU_BOOT_DEV_STS0_FW_IATU_CONF_EN, true);
+}
+
+
+void ppboot_log_waiting_for_pcie(void)
+{
+	/* we are waiting for link, so do not waste too much time on log */
+	preboot_puts("5\n");
+}
