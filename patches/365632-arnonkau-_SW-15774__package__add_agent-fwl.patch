From 4aa3544f1e374877ae0ef3fd31ced360c003354d Mon Sep 17 00:00:00 2001
From: Arnon Kaufman <akaufman@habana.ai>
Date: Sat, 21 Oct 2023 00:31:47 +0300
Subject: [PATCH] [SW-15774] package: add agent-fwl

Add package to build the firmware loader

Change-Id: I2e35118b98a2b2ebb15971e9c03452e575701870
Signed-off-by: Arnon Kaufman <akaufman@habana.ai>
---

diff --git a/board/habanalabs/common/local.mk b/board/habanalabs/common/local.mk
index 9aa70d6..6eb48f5 100644
--- a/board/habanalabs/common/local.mk
+++ b/board/habanalabs/common/local.mk
@@ -24,3 +24,4 @@
 PID_OVERRIDE_SRCDIR = $(TOPDIR)/../zephyr-apps/arcpid
 MGMT_OVERRIDE_SRCDIR = $(TOPDIR)/../zephyr-apps/arcmgmt
 EVENT_OVERRIDE_SRCDIR = $(TOPDIR)/../zephyr-apps/arcevent
+AGENT_FWL_OVERRIDE_SRCDIR = $(TOPDIR)/../zephyr-plugins
diff --git a/package/agent-fwl/agent-fwl.mk b/package/agent-fwl/agent-fwl.mk
new file mode 100644
index 0000000..534366b
--- /dev/null
+++ b/package/agent-fwl/agent-fwl.mk
@@ -0,0 +1,147 @@
+AGENT_FWL_APP_NAME = fw_loader
+AGENT_FWL_DEPENDENCIES = host-cmake host-lzop host-lz4
+AGENT_FWL_APP_MODULES = boot_info eeprom fdt i2c-indirect lz4 mbedtls hl_shell soc_init
+
+AGENT_FWL_SRCDIR=$(EMBEDDED_DIR)/zephyr-plugins/fw-loader
+AGENT_FWL_SRC_DIR=$(EMBEDDED_DIR)/zephyr-plugins/fw-loader
+AGENT_FWL_ZEPHYR_SRCDIR=$(EMBEDDED_DIR)/zephyr
+AGENT_FWL_APP_PROD_NAME = zephyr_$(HL_TARGET)_$(AGENT_FWL_APP_NAME)
+AGENT_FWL_DEVICE_NAME = $(firstword $(subst _, ,$(HL_DEV)))
+AGENT_FWL_APP_VERSION = $(shell cut -d- -f2- $(@D)/localversion-habanalabs)
+AGENT_FWL_LOCAL_VERSION = $$(sed "s/^.*fw-\\([0-9]\\+\\.[0-9]\\+\\.[0-9]\\+\\).*$$/\\1/" $(@D)/localversion-habanalabs)
+
+DEV_PREFIX_UPPERCASE=$(call UPPERCASE,$(DEV_PREFIX))
+
+AGENT_FWL_DIR = build-agent-fw-loader
+
+AGENT_FWL_CONF_APP_EXTRA_CFLAGS = \
+		-include $(EMBEDDED_ROOT)/specs/$(AGENT_FWL_DEVICE_NAME)/$(AGENT_FWL_DEVICE_NAME)_boot_info.h \
+		$($(call UPPERCASE,$(DEV_PREFIX))_CONF_DEV_EXTRA_CFLAGS) \
+		$(ZEPHYR_CONF_DEV_EXTRA_CFLAGS)
+
+
+AGENT_FWL_CONF_APP_CFLAGS = \
+		-I$(AGENT_FWL_SRC_DIR)/../common/include \
+		-I$(AGENT_FWL_SRC_DIR)/../common/include/$(HL_DEV) \
+		-I$(AGENT_FWL_SRC_DIR)/include
+
+AGENT_FWL_CONF_OPTS = $(ZEPHYR_CONF_OPTS)
+ifdef BR2_arcle
+AGENT_FWL_CONF_OPTS += -DBOARD=hl_$(AGENT_FWL_DEVICE_NAME)_agent_$(HL_TARGET)
+endif
+ifdef BR2_aarch64
+AGENT_FWL_CONF_APP_EXTRA_CFLAGS += -mstrict-align
+AGENT_FWL_CONF_OPTS += -DBOARD=hl_$(AGENT_FWL_DEVICE_NAME)_$(HL_TARGET)
+endif
+
+ifeq ($(HL_TARGET),pldm)
+AGENT_FWL_CONF_APP_EXTRA_CFLAGS += -DTARGET_IS_PLDM
+endif
+
+ifeq ($(HL_TARGET),onix)
+AGENT_FWL_CONF_APP_EXTRA_CFLAGS += -DTARGET_IS_ONIX
+endif
+
+AGENT_FWL_BUILD_DIR = $(@D)
+AGENT_FWL_BUILDDIR = $(@D)
+AGENT_FWL_DIR = $(@D)
+AGENT_FWL_ZEPHYR_BUILD_DIR ?= $(@D)/zephyr
+
+AGENT_FWL_CONF_ENV = CROSS_COMPILE=$(TARGET_CROSS)
+AGENT_FWL_CONF_ENV += ZEPHYR_TOOLCHAIN_VARIANT=cross-compile
+AGENT_FWL_CONF_ENV += ZEPHYR_BASE=$(AGENT_FWL_ZEPHYR_BUILD_DIR)
+
+
+AGENT_FWL_CONF_OPTS += -UCMAKE_TOOLCHAIN_FILE
+AGENT_FWL_CONF_OPTS += -DUSER_CACHE_DIR=$(@D)/.cache
+AGENT_FWL_CONF_OPTS += -DCMAKE_EXE_LINKER_FLAGS_INIT=-Wl,-e__start
+AGENT_FWL_CONF_OPTS += -DEXTRA_CFLAGS="\
+		-Werror \
+		-Wno-misleading-indentation \
+		$($(call UPPERCASE,$(DEV_PREFIX))_CONF_DEV_EXTRA_CFLAGS) \
+		$(AGENT_FWL_CONF_APP_EXTRA_CFLAGS)"
+
+AGENT_FWL_CONF_OPTS += -DFAKE_SECURITY=$(FAKE_SECURITY)
+AGENT_FWL_CONF_OPTS += -DBUILD_VERSION="$(AGENT_FWL_APP_VERSION)"
+AGENT_FWL_CONF_OPTS += -DBUILD_MACHINE="$(shell hostname -s)"
+AGENT_FWL_CONF_OPTS += -DCMAKE_C_FLAGS="\
+		$(AGENT_FWL_CONF_APP_CFLAGS)"
+
+AGENT_FWL_CONF_OPTS += -DDTS_EXTRA_CPPFLAGS="-I$(SPECS_EMBEDDED_DIR)"
+AGENT_FWL_CONF_OPTS += -DDEVICE=$(AGENT_FWL_DEVICE_NAME)
+AGENT_FWL_CONF_OPTS += -DAPP_NAME=$(AGENT_FWL_APP_PROD_NAME)
+AGENT_FWL_CONF_OPTS += -DAPP_VERSION=$(AGENT_FWL_APP_VERSION)
+AGENT_FWL_WEST_SRC_DIR :=
+AGENT_FWL_WEST_DEST_DIR :=
+
+define AGENT_FWL_COPY_ZEPHYR_SRC
+	rsync -au --chmod=u=rwX,go=rX  --exclude .svn --exclude .git --exclude .hg --exclude .bzr --exclude CVS $(AGENT_FWL_ZEPHYR_SRCDIR) $(AGENT_FWL_BUILD_DIR)
+endef
+
+# Arguments:
+# - module name
+# - component dir
+# - component name
+#
+define AGENT_FWL_DEFINE_MODULE_ENVVARS
+	$(eval MODULE_NAME=$(strip $1))
+	$(eval MODULE_NAME_UPPER_CASE=$(shell echo $(MODULE_NAME) | tr a-z A-Z))
+	$(eval MODULE_NAME_UPPER_CASE=$(strip $(MODULE_NAME_UPPER_CASE)))
+	$(eval $(MODULE_NAME_UPPER_CASE)_SRCDIR=$(EMBEDDED_DIR)/zephyr-modules/$(MODULE_NAME))
+	$(eval $(MODULE_NAME_UPPER_CASE)_DIR=$(@D)/build/modules/$(MODULE_NAME))
+	$(eval $(MODULE_NAME_UPPER_CASE)_NAME=$2_$(MODULE_NAME))
+endef
+
+$(foreach module,$(AGENT_FWL_APP_MODULES),$(call AGENT_FWL_DEFINE_MODULE_ENVVARS,$(module),$(AGENT_FWL_APP_PROD_NAME)))
+
+# Arguments:
+# - module (mbedtls, eeprom, etc.)
+define AGENT_FWL_MODULE_VERSION_HOOK
+	$(eval MODULE_NAME_UPPER_CASE=$(shell echo $1 | tr a-z A-Z))
+	$(eval MODULE_NAME_UPPER_CASE=$(strip $(MODULE_NAME_UPPER_CASE)))
+	$(call HL_VERSION_GEN, ${${MODULE_NAME_UPPER_CASE}_SRCDIR}, ${${MODULE_NAME_UPPER_CASE}_DIR}, ${${MODULE_NAME_UPPER_CASE}_NAME})
+endef
+
+define AGENT_FWL_APP_VERSION_GEN
+	@$(call HL_VERSION_GEN, ${AGENT_FWL_SRCDIR},.,${AGENT_FWL_APP_PROD_NAME})
+	@$(call HL_VERSION_GEN, ${AGENT_FWL_SRCDIR},build,${AGENT_FWL_APP_PROD_NAME})
+	@$(foreach module,$(AGENT_FWL_APP_MODULES),$(call AGENT_FWL_MODULE_VERSION_HOOK,$(module)))
+endef
+
+define AGENT_FWL_CREATE_HL_VERSION
+	@mkdir -p $(AGENT_FWL_BUILD_DIR)/include
+	@echo "#ifndef _HL_VERSION_" >  $(AGENT_FWL_BUILD_DIR)/include/_hl_version.h
+	@echo "#define _HL_VERSION_" >>  $(AGENT_FWL_BUILD_DIR)/include/_hl_version.h
+	@echo "#define HL_VERSION_MAJOR $$(echo $(AGENT_FWL_LOCAL_VERSION) | cut -d. -f1)" >> $(AGENT_FWL_BUILD_DIR)/include/_hl_version.h
+	@echo "#define HL_VERSION_MINOR $$(echo $(AGENT_FWL_LOCAL_VERSION) | cut -d. -f2)" >> $(AGENT_FWL_BUILD_DIR)/include/_hl_version.h
+	@echo "#define HL_VERSION_PATCH $$(echo $(AGENT_FWL_LOCAL_VERSION) | cut -d. -f3)" >> $(AGENT_FWL_BUILD_DIR)/include/_hl_version.h
+	@echo "#endif" >>  $(AGENT_FWL_BUILD_DIR)/include/_hl_version.h
+endef
+
+define AGENT_FWL_CONFIGURE_CMDS
+	$(call MESSAGE, "AGENT_FWL_CONF_APP_EXTRA_CFLAGS $(AGENT_FWL_CONF_APP_EXTRA_CFLAGS)")
+	@$(call AGENT_FWL_CREATE_HL_VERSION)
+	@$(AGENT_FWL_CONF_ENV) $(HOST_DIR)/bin/cmake $(AGENT_FWL_CONF_OPTS) -S $(AGENT_FWL_BUILD_DIR)/fw-loader -B $(AGENT_FWL_BUILD_DIR)/build
+endef
+
+AGENT_FWL_POST_RSYNC_HOOKS += HL_VERSION_GEN
+AGENT_FWL_POST_RSYNC_HOOKS += AGENT_FWL_COPY_ZEPHYR_SRC
+AGENT_FWL_POST_RSYNC_HOOKS += AGENT_FWL_APP_VERSION_GEN
+
+define AGENT_FWL_BUILD_CMDS
+	@$(TARGET_MAKE_ENV) $(MAKE) -C $(AGENT_FWL_BUILD_DIR)/build
+endef
+
+define AGENT_FWL_INSTALL_TARGET_CMDS
+	@$(INSTALL) -D -m 0644 $(@D)/build/zephyr/zephyr.bin $(BINARIES_DIR)/zephyr_agent_$(AGENT_FWL_APP_NAME).bin
+	@$(INSTALL) -D -m 0644 $(@D)/build/zephyr/zephyr.elf $(BINARIES_DIR)/zephyr_agent_$(AGENT_FWL_APP_NAME).elf
+	@$(INSTALL) -D -m 0644 $(@D)/build/zephyr/zephyr.stat $(BINARIES_DIR)/zephyr_agent_$(AGENT_FWL_APP_NAME).stat
+
+endef
+
+agent-fwl-configure: $(AGENT_FWL_DEPENDENCIES)
+agent-fwl-menuconfig agent-fwl-guiconfig: | agent-fwl-configure
+	$(TARGET_MAKE_ENV) $(MAKE) -C $(AGENT_FWL_BUILD_DIR)/build
+	rm -f $(AGENT_FWL_BUILD_DIR)/.stamp_{configured,built}
+
+$(eval $(cmake-package))
