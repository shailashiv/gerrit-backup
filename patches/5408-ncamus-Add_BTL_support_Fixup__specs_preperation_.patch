From c4d6375e61dcdfdda8fdbfbacbb1a36353d22c0c Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Wed, 08 Aug 2018 06:55:02 +0300
Subject: [PATCH] Add BTL support Fixup [specs preperation]

Now we can include specs repository headers and
use from it any register definition as is
Currently specs/dali/asic_reg is available
---

diff --git a/board/habanalabs/dali/btl/Makefile b/board/habanalabs/dali/btl/Makefile
index 66399f4..96e59d3 100644
--- a/board/habanalabs/dali/btl/Makefile
+++ b/board/habanalabs/dali/btl/Makefile
@@ -7,6 +7,9 @@
 COMMON_CPP_FLAGS += -DPREBOOT_ADDR=0x7FF0400000
 COMMON_CPP_FLAGS += -DPREBOOT_ADDR_H=0x7F
 COMMON_CPP_FLAGS += -DPREBOOT_ADDR_L=0xF0400000
+
+COMMON_CPP_FLAGS += -I$(dir $(BR2_EXTERNAL))/specs/dali/asic_reg
+
 ifeq ($(DALI_TARGET),pldm)
 	COMMON_CPP_FLAGS += -DTARGET_IS_PLDM
 endif
diff --git a/board/habanalabs/dali/btl/btl-as.py b/board/habanalabs/dali/btl/btl-as.py
index 4c4720a..20e5c47 100755
--- a/board/habanalabs/dali/btl/btl-as.py
+++ b/board/habanalabs/dali/btl/btl-as.py
@@ -33,8 +33,8 @@
     global command_menemonic
 
     addr, data = params.split(",", 2)
-    __opcode_addr = struct.pack('>I',(_opcode << 28) + int(addr,16))
-    __data = struct.pack('>I', int(data,16))
+    __opcode_addr = struct.pack('>I',(_opcode << 28) + (0xC << 24) + int(addr,16))
+    __data = struct.pack('>I', int(data,0))
     crc = binascii.crc32(__opcode_addr)
     crc = binascii.crc32(__data, crc) & 0xffffffff
     __crc = struct.pack('<I', crc)
diff --git a/board/habanalabs/dali/btl/i2c.s b/board/habanalabs/dali/btl/i2c.s
index 4b1fbbe..8a1ae2f 100644
--- a/board/habanalabs/dali/btl/i2c.s
+++ b/board/habanalabs/dali/btl/i2c.s
@@ -3,20 +3,20 @@
  */
 
 /* Program IC_SAR with address to which DW_apb_i2c slave responds */
-cfg 0xCC42008, 0x47
+cfg 0xC42008, 0x47
 
 /* Program IC_CON */
-cfg 0xCC42000, 0x22
+cfg 0xC42000, 0x22
 
 /* Write to IC_INTR_MASK to enable all interrupts */
-cfg 0xCC4202C, 0x7FFF
+cfg 0xC4202C, 0x7FFF
 
 /* Write to IC_RX_TL to set Rx FIFO threshold level */
-cfg 0xCC42038, 0
+cfg 0xC42038, 0
 
 /* Write to IC_TX_TL to set Tx FIFO threshold level */
-cfg 0xCC4203C, 0x7
+cfg 0xC4203C, 0x7
 
 /* Write 1 to IC_ENABLE to enable DW_apb_i2c */
-cfg 0xCC4206C, 0x1
+cfg 0xC4206C, 0x1
 
