+cfg 0xC4B668, 0x41
 
 /* Configure prstn to reset entire SoC */
-cfg 0xCC4B470, 0x7FFFFF
+cfg 0xC4B470, 0x7FFFFF
 
 /* Clear masking of prstn from SW reset */
-cfg 0xCC4B484, 0x0
+cfg 0xC4B484, 0x0
 
 #include "pcie_phy.s"
 
@@ -38,18 +38,18 @@
  * 30 - UBOOT_OFFSET
  * 31 - UBOOT_SIZE
  */
-cfg 0xCC4B16C, BTLID
-cfg 0xCC4B170, SPL_OFFSET
-cfg 0xCC4B174, SPL_SIZE
-cfg 0xCC4B178, UBOOT_OFFSET
-cfg 0xCC4B17C, UBOOT_SIZE
+cfg 0xC4B16C, BTLID
+cfg 0xC4B170, SPL_OFFSET
+cfg 0xC4B174, SPL_SIZE
+cfg 0xC4B178, UBOOT_OFFSET
+cfg 0xC4B17C, UBOOT_SIZE
 
 /* Set CPU0 Reset address to PREBOOT */
