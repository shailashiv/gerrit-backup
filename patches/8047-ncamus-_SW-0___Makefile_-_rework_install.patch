+goya-pldm-install gaudi-pldm-install: HL_INSTALL_LAB_IP ?= 192.168.10.45
+goya-pldm-install gaudi-pldm-install: HL_INSTALL_HOST_IP ?= 192.168.10.45
+goya-asic-install gaudi-asic-install: HL_INSTALL_HOST_IP ?= 192.168.10.156
