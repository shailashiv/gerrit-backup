From 4fd7405823dd5dce823fd5710d1dd1a495091914 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Fri, 18 Jan 2019 13:44:21 +0200
Subject: [PATCH] [SW-0]: Makefile - rework install

Installation took too long so lets change a bit:
1) Remove unused files installation
2) Seperate into HOST (default) and LAB install targets
3) Introduce *-install-all target to install HOST & LAB
4) Rename GOYA_INSTALL_*_IP to HL_INSTALL_*_IP

Note: Update Jenkins jobs (otherwise item 4 will break jobs)

Change-Id: Ib81529e505ebbd9b0a651bd40481610d2ad1dcc6
---

diff --git a/Makefile b/Makefile
index e698eac..6a0124d 100644
--- a/Makefile
+++ b/Makefile
@@ -36,9 +36,9 @@
 	@echo '  optional environment variables:'
 	@echo '    PLDM_HEX_DIR       - Palladium directory to install flash image'
 	@echo '  goya-<board>-install - Install to <board> e.g. onix, pldm, asic'
-	@echo '                           set GOYA_INSTALL_LAB_IP=<lab IP> to'
+	@echo '                           set HL_INSTALL_LAB_IP=<lab IP> to'
 	@echo '                             override <board> default lab IP'
-	@echo '                           set GOYA_INSTALL_HOST_IP=<host IP> to'
+	@echo '                           set HL_INSTALL_HOST_IP=<host IP> to'
 	@echo '                             override <board> default host IP'
 	@echo
 	@echo 'Release:'
@@ -184,48 +184,52 @@
 IMAGES_DIR := ${OUTPUT_DIR}/images
 UBOOT_BASE := ${OUTPUT_DIR}/build/uboot-custom
 LINUX_BASE := ${OUTPUT_DIR}/build/linux-custom
-UBOOT_XMPL := ${UBOOT_BASE}/examples/standalone
