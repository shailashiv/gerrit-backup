+static int gaudi2_sms_check_pattern(uint32_t value, uint32_t ones_mask, uint32_t zeros_mask)
+{
+	if ((value & ones_mask) != ones_mask) {
+		preboot_puts("ones check failed\n");
+		return 1;
+	}
+
+	if ((~value & zeros_mask) != zeros_mask) {
+		preboot_puts("zeros check failed\n");
+		return 1;
+	}
+
+	return 0;
+}
+
+static int gaudi2_sms_read_and_check_pattern(uint32_t ones_mask, uint32_t zeros_mask)
+{
+	uint32_t val;
+
+	val = regmap_readl(mmPSOC_DFT_APB_WORD1);
+
+	gaudi2_sms_check_pattern(val, ones_mask, zeros_mask);
+
+	return 0;
+}
+
+static void gaudi2_sram_ring_pattern(enum gaudi2_sram_self_repair_op op)
+{
+	uint32_t expected_ones, expected_zeros;
+
+	regmap_writel(GAUDI2_RING_PATTERN_VAL1, mmPSOC_DFT_APB_WORD0);
+	if (op == SRAM_SELF_REPAIR_OP_BIRA) {
+		regmap_writel(GAUDI2_RING_PATTERN_VAL2, mmPSOC_DFT_APB_WORD1);
+		udelay(DELAY_5K_USEC);
+	} else if (op == SRAM_SELF_REPAIR_OP_BISR) {
+		regmap_writel(GAUDI2_RING_PATTERN_VAL3, mmPSOC_DFT_APB_WORD1);
+		udelay(DELAY_67_USEC);
+	} else if (op == SRAM_SELF_REPAIR_OP_BIST) {
+		regmap_writel(GAUDI2_RING_PATTERN_VAL4, mmPSOC_DFT_APB_WORD1);
+		udelay(DELAY_5K_USEC);
+	} else {
+		preboot_puts("Invalid sram repair operation\n");
+		return;
+	}
+
+	regmap_writel(GAUDI2_RING_PATTERN_VAL5, mmPSOC_DFT_APB_WORD0);
+	if (op == SRAM_SELF_REPAIR_OP_BIST)
+		regmap_writel(GAUDI2_RING_PATTERN_VAL6, mmPSOC_DFT_APB_WORD1);
+	else
+		regmap_writel(GAUDI2_RING_PATTERN_VAL7, mmPSOC_DFT_APB_WORD1);
+
+	expected_ones = 0b00000000000000000000001010000000;
+	expected_zeros = 0b00000000000000000000000101110000;
+	gaudi2_sms_read_and_check_pattern(expected_ones, expected_zeros);
+
+	if (op == SRAM_SELF_REPAIR_OP_BIST) {
+		regmap_writel(GAUDI2_RING_PATTERN_VAL8, mmPSOC_DFT_APB_WORD0);
+		regmap_writel(GAUDI2_RING_PATTERN_VAL9, mmPSOC_DFT_APB_WORD1);
+		udelay(DELAY_5K_USEC);
+
+		regmap_writel(GAUDI2_RING_PATTERN_VAL10, mmPSOC_DFT_APB_WORD0);
+		regmap_writel(GAUDI2_RING_PATTERN_VAL11,  mmPSOC_DFT_APB_WORD1);
+
+		expected_ones = 0b00000000000000000000000000000000;
+		expected_zeros = 0b00000000000000000000000000010000;
+		gaudi2_sms_read_and_check_pattern(expected_ones, expected_zeros);
+	}
+}
+
+static void gaudi2_sram_ring_sel(uint32_t dfx_val, uint32_t ring)
+{
+	uint32_t ring_value = BIT(8) | (ring << 3) | 0x5;
+
+	regmap_writel(GAUDI2_RING_PATTERN_VAL12, mmPSOC_DFT_APB_WORD0);
+	regmap_writel(GAUDI2_RING_PATTERN_VAL13, mmPSOC_DFT_APB_WORD1);
+	regmap_writel(GAUDI2_RING_PATTERN_VAL14, mmPSOC_DFT_APB_WORD0);
+	regmap_writel(dfx_val, mmPSOC_DFT_APB_WORD1);
+	regmap_writel(GAUDI2_RING_PATTERN_VAL12, mmPSOC_DFT_APB_WORD0);
+	regmap_writel(GAUDI2_RING_PATTERN_VAL15, mmPSOC_DFT_APB_WORD1);
+	regmap_writel(GAUDI2_RING_PATTERN_VAL10, mmPSOC_DFT_APB_WORD0);
+	regmap_writel(GAUDI2_RING_PATTERN_VAL16, mmPSOC_DFT_APB_WORD1);
+	regmap_writel(GAUDI2_RING_PATTERN_VAL10, mmPSOC_DFT_APB_WORD0);
+	regmap_writel(ring_value, mmPSOC_DFT_APB_WORD1);
+	regmap_writel(GAUDI2_RING_PATTERN_VAL10, mmPSOC_DFT_APB_WORD0);
+	regmap_writel(GAUDI2_RING_PATTERN_VAL17, mmPSOC_DFT_APB_WORD1);
+}
+
+static void gaudi2_sram_id_sel(void)
+{
+	regmap_writel(GAUDI2_RING_PATTERN_VAL12, mmPSOC_DFT_APB_WORD0);
+	regmap_writel(GAUDI2_RING_PATTERN_VAL13, mmPSOC_DFT_APB_WORD1);
+	regmap_writel(GAUDI2_RING_PATTERN_VAL14, mmPSOC_DFT_APB_WORD0);
+	regmap_writel(GAUDI2_RING_PATTERN_VAL18, mmPSOC_DFT_APB_WORD1);
+	regmap_writel(GAUDI2_RING_PATTERN_VAL12, mmPSOC_DFT_APB_WORD0);
+	regmap_writel(GAUDI2_RING_PATTERN_VAL19, mmPSOC_DFT_APB_WORD1);
+	regmap_writel(GAUDI2_RING_PATTERN_VAL20, mmPSOC_DFT_APB_WORD0);
+	regmap_writel(GAUDI2_RING_PATTERN_VAL21, mmPSOC_DFT_APB_WORD1);
+}
+
+static void gaudi2_sram_beginning_pattern(void)
+{
+	regmap_writel(GAUDI2_RING_PATTERN_VAL22, mmPSOC_GLOBAL_CONF_DFT_APB_CONTROL);
+	regmap_writel(GAUDI2_RING_PATTERN_VAL22, mmPSOC_DFT_APB_WORD0);
+	regmap_writel(GAUDI2_RING_PATTERN_VAL9, mmPSOC_DFT_APB_WORD1);
+}
+
+static void (*gaudi2_sram_region_ring_pattern[])(enum gaudi2_sram_self_repair_op op)  = {
+				[SRAM_RING_TYPE_TPC] = NULL,
+				[SRAM_RING_TYPE_SOB_ROT] = NULL,
+				[SRAM_RING_TYPE_SRAM] = gaudi2_sram_ring_pattern,
+				[SRAM_RING_TYPE_XBAR_MID] = NULL,
+				[SRAM_RING_TYPE_VDEC] = NULL,
+				[SRAM_RING_TYPE_SOB_XDMA] = NULL,
+				[SRAM_RING_TYPE_NIC] = NULL,
+				[SRAM_RING_TYPE_MME] = NULL,
+				[SRAM_RING_TYPE_HMMU_XBAR] = NULL,
+				[SRAM_RING_TYPE_HMMU_2] = NULL,
+				[SRAM_RING_TYPE_EDMA1_HMMU3] = NULL,
+				[SRAM_RING_TYPE_HMMU_MC] = NULL
+};
+
+static void gaudi2_sram_self_repair(enum gaudi2_sram_self_repair_op op)
+{
+	unsigned int dfx, ring;
+	enum gaudi2_sram_ring_type ring_type;
+
+	gaudi2_sram_beginning_pattern();
+
+	for (dfx = 0; dfx < ARRAY_SIZE(dfx_value_table); dfx++) {
+		for (ring = 0; ring < ring_count_table[dfx]; ring++) {
+			ring_type = gauid2_ring_type_table[dfx][ring];
+			if (ring_type == SRAM_RING_TYPE_SRAM) {
+				gaudi2_sram_id_sel();
+				gaudi2_sram_ring_sel(dfx_value_table[dfx], ring + 1);
+				gaudi2_sram_region_ring_pattern[ring_type](op);
+				gaudi2_sram_id_sel();
+			}
+		}
+	}
+}
+
+static void gaudi2_mask_sram_ecc(bool enable)
+{
+	u32 val;
+	int dcore, sram;
+	u32 dcore_offset = 0x200000;
+	u32 sram_offset = 0x8000;
+	u32 offset;
+
+	if (enable) {
+		regmap_writel(CPU_IF_SRAM_DERR_INTR_MASK_VAL_MASK, mmCPU_IF_SRAM_DERR_INTR_MASK);
+		regmap_writel(CPU_IF_SRAM_SERR_INTR_MASK_VAL_MASK, mmCPU_IF_SRAM_SERR_INTR_MASK);
+		val = DCORE0_SRAM0_BANK_SPECIAL_MEM_ECC_GLBL_ERR_MASK_DERR_MASK |
+				DCORE0_SRAM0_BANK_SPECIAL_MEM_ECC_GLBL_ERR_MASK_SERR_MASK;
+	} else {
+		regmap_writel(0, mmCPU_IF_SRAM_SERR_INTR_MASK);
+		regmap_writel(0, mmCPU_IF_SRAM_DERR_INTR_MASK);
+		val = 0;
+	}
+
+	for (dcore = 0; dcore < NUM_OF_DCORES ; dcore++) {
+		offset = dcore * dcore_offset;
+		for (sram = 0; sram < NUM_OF_SRAM_BANK_PER_DCORE; sram++) {
+			regmap_writel(val, mmDCORE0_SRAM0_BANK_SPECIAL_MEM_ECC_GLBL_ERR_MASK
+											+ offset);
+			offset += sram_offset;
+		}
+	}
+}
+
+static void gaudi2_mask_clear_sram_ecc(void)
+{
+	int dcore, sram, wrap;
+	u32 dcore_offset = 0x200000;
+	u32 sram_offset = 0x8000;
+	u32 offset;
+	u32 num_mem_wrapper = 0;
+
+	num_mem_wrapper = regmap_readl(mmDCORE0_SRAM0_BANK_SPECIAL_MEM_NUMOF);
+	for (dcore = 0; dcore < NUM_OF_DCORES ; dcore++) {
+		offset = dcore * dcore_offset;
+		for (sram = 0; sram < NUM_OF_SRAM_BANK_PER_DCORE; sram++) {
+			for (wrap = 0; wrap < num_mem_wrapper; wrap++) {
+				regmap_writel(wrap,
+						mmDCORE0_SRAM0_BANK_SPECIAL_MEM_ECC_SEL + offset);
+				regmap_writel((
+					DCORE0_SRAM0_BANK_SPECIAL_MEM_ECC_CTL_DERR_CLR_MASK |
+					DCORE0_SRAM0_BANK_SPECIAL_MEM_ECC_CTL_SERR_CLR_MASK),
+					mmDCORE0_SRAM0_BANK_SPECIAL_MEM_ECC_CTL + offset);
+			}
+			offset += sram_offset;
+		}
+	}
+}
+
+#define SRAM_NUM_MEM_CPY_XFERS			48 /* (48*1024*1024)/(65535*16) */
+static void gaudi2_mask_scrub_sram(void)
+{
+	u32 retry = 1000;
+	u32 mem_cfg, cpy_sts;
+	u32 size = 0xFFFF0; /* (65535*16) bytes */
+	u32 block;
+	u64 addr;
+
+	for (block = 0; block <= SRAM_NUM_MEM_CPY_XFERS; block++) {
+		addr = SDRAM_BASE_FULL + size * block;
+		if (block == SRAM_NUM_MEM_CPY_XFERS) /* last block */
+			size = 768; /* (48*1024*1024) - (48*65535*16) bytes */
+
+		/* Use memblock to initialize dccm memory */
+		regmap_writel((u32)addr, mmPSOC_GLOBAL_CONF_MEM_CPY_DEST_ADDR_L);
+		regmap_writel((u32)(addr >> 32), mmPSOC_GLOBAL_CONF_MEM_CPY_DEST_ADDR_H);
+
+		mem_cfg = regmap_readl(mmPSOC_GLOBAL_CONF_MEM_CPY_CTRL2);
+		mem_cfg &= ~(PSOC_GLOBAL_CONF_MEM_CPY_CTRL2_MEM_SIZE_MASK);
+
+		/* set size of in granuality of 16 bytes */
+		mem_cfg |= ((size >> 4) & PSOC_GLOBAL_CONF_MEM_CPY_CTRL2_MEM_SIZE_MASK);
+		mem_cfg |= BIT(PSOC_GLOBAL_CONF_MEM_CPY_CTRL2_USE_CONST_SHIFT);
+
+		regmap_writel(mem_cfg, mmPSOC_GLOBAL_CONF_MEM_CPY_CTRL2);
+		/* Enable copy and wait for completion */
+		regmap_writel(BIT(0), mmPSOC_GLOBAL_CONF_MEM_CPY_CTRL);
+		while (1) {
+			cpy_sts = regmap_readl(mmPSOC_GLOBAL_CONF_MEM_CPY_STATUS);
+			if (cpy_sts)
+				break;
+
+			retry--;
+			if (!retry) {
+				preboot_puts("sram mem_cpy timedout");
+				break;
+			}
+			udelay(DELAY_100K_USEC);
+		}
+	}
+}
+
+static void gaudi2_scrub_sram(void)
+{
+	gaudi2_mask_sram_ecc(true);
+	gaudi2_mask_scrub_sram();
+	gaudi2_mask_clear_sram_ecc();
+	gaudi2_mask_sram_ecc(false);
+}
+
+#define DFT_APB_CONTROL_DEFAULT_VAL		0xFE
+void hl_sram_self_repair(void)
+{
+	gaudi2_sram_self_repair(SRAM_SELF_REPAIR_OP_BIRA);
+	gaudi2_sram_self_repair(SRAM_SELF_REPAIR_OP_BISR);
+	gaudi2_sram_self_repair(SRAM_SELF_REPAIR_OP_BIST);
+	/* Get back to normal from DFT mode */
+	regmap_writel(DFT_APB_CONTROL_DEFAULT_VAL, mmPSOC_GLOBAL_CONF_DFT_APB_CONTROL);
+	gaudi2_scrub_sram(); /* TODO: Replace this by UNIT reset (Refer SIV-1088) */
+	preboot_puts("sram bist done\n");
+}
