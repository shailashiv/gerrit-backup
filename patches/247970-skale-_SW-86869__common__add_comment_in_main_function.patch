From de8eb5014298ccd2af84a13b4e0b759594787a4b Mon Sep 17 00:00:00 2001
From: Sanyog Kale <skale@habana.ai>
Date: Wed, 24 Aug 2022 20:37:37 +0300
Subject: [PATCH] [SW-86869] common: add comment in main function

To enhance code readibility, this patch add comment in
arcboot_rom_main function.

Change-Id: Ia85ca0611aca269a4588480eacc2fc6299ff407c
---

diff --git a/app/arcboot_rom.c b/app/arcboot_rom.c
index 71ee494..945b188 100644
--- a/app/arcboot_rom.c
+++ b/app/arcboot_rom.c
@@ -475,6 +475,12 @@
 	arcboot_rom_security_init();
 	arcboot_rom_disable_spi_gw();
 	arcboot_rom_wait_for_signal();
+	/*
+	 * Following code will be executed only by
+	 * Master die as Slave die will wait for signal
+	 * from Master die in above function to execute
+	 * recovery flow.
+	 */
 	arcboot_rom_check_n_enter_recovery();
 	arcboot_rom_request_cpld_wdog();
 	if (arcboot_rom_verify(HL_FW_BOOT_PTR_SPI))
