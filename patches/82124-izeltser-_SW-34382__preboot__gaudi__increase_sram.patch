From 32348624c477fedc86b1c54425121e24152528b8 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Mon, 15 Mar 2021 14:47:04 +0200
Subject: [PATCH] [SW-34382] preboot: gaudi: increase sram

Handling boot info from scratchpad sram, specifically nvme
descriptor, has increased the bss utilization.
increasing to a max of 128kb

Change-Id: Icf19bec2b8bb51664d14b734c4d687923dedc427
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/gaudi/common.h b/gaudi/common.h
index 684969e..374e28d 100644
--- a/gaudi/common.h
+++ b/gaudi/common.h
@@ -8,7 +8,7 @@
 #define COMMON_GAUDI_H_
 
 #define PPBOOT_SIZE			0x4000		/* 16KB */
-#define PREBOOT_SIZE			0x14000		/* 80KB */
+#define PREBOOT_SIZE			0x20000		/* 128KB */
 #define SRAM_SIZE			0x1400000	/* 20MB */
 
 #define HL_SP_SRAM_BASE			0x7FFBFE0000
