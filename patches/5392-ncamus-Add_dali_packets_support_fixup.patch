From 427c6db2ffbff0c677ab571ba3b8a2b9f391aec0 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Sun, 05 Aug 2018 09:52:02 +0300
Subject: [PATCH] Add dali packets support fixup

Update to new flash layout
---

diff --git a/board/habanalabs/common/rootfs_overlay/usr/sbin/flash_burn b/board/habanalabs/common/rootfs_overlay/usr/sbin/flash_burn
index 139c354..12f5481 100755
--- a/board/habanalabs/common/rootfs_overlay/usr/sbin/flash_burn
+++ b/board/habanalabs/common/rootfs_overlay/usr/sbin/flash_burn
@@ -1,4 +1,4 @@
-#!/bin/sh -x
+#!/bin/sh
 
 if [ $# -eq 0 ]; then
 	echo "Usage: ${0} [-c <cksum>] <image>"
@@ -60,18 +60,20 @@
 # 0 -- All
 # 1 -- BTL Primary
 # 2 -- Next Image
-# 3 -- FW 0
-# 4 -- FW 1
-STABLE_IMAGE_CHAR=0x`xxd -p -l1 -c1 /dev/mtd2`
+# 3 -- Uboot Env
+# 4 -- FW 0
+# 5 -- FW 1
+STABLE_IMAGE_CHAR=`xxd -p -l1 -c1 /dev/mtd2`
 # '1' / '2' equal (ascii) 0x31 / 0x32
-if ![ ${STABLE_IMAGE_CHAR} -eq 0x31 ] && ![ ${STABLE_IMAGE_CHAR} -eq 0x32 ]; then
-	STABLE_IMAGE_CHAR=0x31
+if ![ "${STABLE_IMAGE_CHAR}" -eq "31" ] && ![ "${STABLE_IMAGE_CHAR}" -eq "32" ]; then
+	STABLE_IMAGE_CHAR=31
 fi
-STABLE_IMAGE_NUM=$((${STABLE_IMAGE_CHAR} - 0x31))
-MODIFIABLE_IMAGE_ID=$((2 - ${STABLE_IMAGE_NUM}))
-MODIFIABLE_MTD_ID=$((3 + ${MODIFIABLE_IMAGE_ID}))
+STABLE_IMAGE_NUM=$((0x${STABLE_IMAGE_CHAR} - 0x31))
+MODIFIABLE_IMAGE_ID=$((1 - ${STABLE_IMAGE_NUM}))
+MODIFIABLE_MTD_ID=$((4 + ${MODIFIABLE_IMAGE_ID}))
 BTL_IMAGE=${INFILE}.mtd1
 NEXT_IMAGE=${INFILE}.mtd2
+UBOOT_ENV_IMAGE=${INFILE}.mtd3
 FW_IMAGE=${INFILE}.mtd${MODIFIABLE_MTD_ID}
 
 dd status=none conv=sync bs=64K if=${INFILE} of=${BTL_IMAGE} count=1
@@ -80,8 +82,9 @@
 else
 	echo "11112222" > next-image.txt
 fi
+dd status=none conv=sync bs=64K skip=8 count=1 if=${INFILE} of=${UBOOT_ENV_IMAGE}
 dd status=none conv=sync bs=64K if=next-image.txt of=${NEXT_IMAGE}
-dd status=none conv=sync bs=64K skip=8 if=${INFILE} of=${FW_IMAGE}
+dd status=none conv=sync bs=64K skip=10 if=${INFILE} of=${FW_IMAGE}
 
 function burn_image {
 	DEV=/dev/mtd${1}
@@ -110,4 +113,5 @@
 echo "Updating MTD Partitions:"
 burn_image 1
 burn_image 2
+burn_image 3
 burn_image ${MODIFIABLE_MTD_ID}
