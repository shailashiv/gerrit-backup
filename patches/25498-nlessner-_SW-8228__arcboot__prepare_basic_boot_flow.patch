@@ -1,103 +0,0 @@
-/*
- * arcboot - Signature Verification
- *
- * A simple application which call phase0b to validate the signature
- * of a blob of data.
- *
- * Both the protected data and the signature of the protected data can be
- * changed, but the public key should be locked into the device.
- *
- * test_phase0b_data     - blob of protected data
- * test_phase0b_data_len - size of the blob
- * test_phase0b_sig      - signature of the blob
- * test_phase0b_sig_len  - signature size
- * test_public_key       - public key
- * test_public_key_len   - public key size
- */
-
-#include <stdio.h>
-#include "soc.h"
-#include "sb.h"
-#include "arcboot.h"
-
-unsigned char __attribute__ ((section(".fw_sram"))) fw_sram[FW_SIZE];
-
-int arcboot_dma_copy_image(uint32_t image_size)
-{
-	uint32_t reg_spi_dma_ctrl_s =  0;
-	uint32_t reg_spi_dma_status_s = 0;
-	uint32_t tmp = 0;
-	uint32_t next_image_add = 0;
-
-	regmap_writel(0, mmPSOC_GLOBAL_CONF_SPI_DMA_DST_ADDR_L);
-	regmap_writel(0, mmPSOC_GLOBAL_CONF_SPI_DMA_DST_ADDR_H);
-
-	image_size = flash_readl(FLASH_IMAGE_1_OFFSET +
-				 FLASH_IMAGE_PREBOOT_OFFSET);
-	regmap_writel(image_size, mmPSOC_SECURITY_SW_STATUS_0);
-
-	next_image_add = image_size % SPI_FLASH_BLOCK_SIZE;
-	regmap_writel(next_image_add, mmPSOC_SECURITY_SW_STATUS_1);
-
-	next_image_add += image_size;
-	regmap_writel(next_image_add, mmPSOC_SECURITY_SW_STATUS_2);
-
-	image_size = flash_readl(FLASH_IMAGE_1_OFFSET + next_image_add);
-	regmap_writel(tmp, mmPSOC_SECURITY_SW_STATUS_4);
-
-	reg_spi_dma_ctrl_s = image_size << 18;
-	reg_spi_dma_ctrl_s = 0; // addr
-	reg_spi_dma_ctrl_s = 1 << 1; //sram
-	reg_spi_dma_ctrl_s = 1; // en
-
-	regmap_writel(reg_spi_dma_ctrl_s, mmPSOC_GLOBAL_CONF_SPI_DMA_CTRL);
-	do {
-		tmp = regmap_readl(mmPSOC_SECURITY_SW_STATUS_0) + 1;
-		regmap_writel(tmp, mmPSOC_SECURITY_SW_STATUS_0);
-		reg_spi_dma_status_s =
-		 regmap_readl(mmPSOC_GLOBAL_CONF_SPI_DMA_STATUS);
-		regmap_writel(reg_spi_dma_status_s,
-				  mmPSOC_SECURITY_SW_STATUS_1);
-	} while (reg_spi_dma_status_s & 0x3);
-	return 0;
-}
-
-int arcboot_verify_image(uint32_t image_size)
-{
-	int st, err;
-	unsigned char block_buf[512];
-	uint16_t test_phase0b_data_len = image_size - SIG_SIZE - BLOB_START;
-
-	unsigned char *test_phase0b_data = &fw_sram[BLOB_START];
-	unsigned char *test_phase0b_sig = &fw_sram[test_phase0b_data_len + BLOB_START];
-	unsigned char *test_public_key = test_phase0b_sig - KEY_SIZE;
-	uint32_t test_phase0b_sig_len = SIG_SIZE;
-	uint32_t test_public_key_len = KEY_SIZE;
-
-	XSTACK_INIT();
-
-	/* Phase0b uses the public key (test_public_key) to validate signature (test_phase0b_sig)
-	 * of the data blob (test_phase0b_data) */
-	err = elp_secureboot_phase0b(sb_proxy_read, test_phase0b_data, test_phase0b_data_len, test_public_key, test_public_key_len,
-			test_phase0b_sig, test_phase0b_sig_len, &st, block_buf, sizeof block_buf);
-
-	if (err || !st) {
-		regmap_writel(0x800, mmPSOC_SECURITY_STATUS);
-		regmap_writel(err, mmPSOC_SECURITY_SW_STATUS_0);
-		regmap_writel(st, mmPSOC_SECURITY_SW_STATUS_1);
-	}
-
-	regmap_writel(1, mmPSOC_SECURITY_STATUS);
-	return 0;
-}
-
-int arcboot_rom_main(void)
-{
-	uint32_t image_size = 0;
-
-	image_size = ((uint32_t *)fw_sram)[0];
-	//arcboot_dma_copy_image(image_size);
-	arcboot_verify_image(image_size);
-
-	return 0;
-}
