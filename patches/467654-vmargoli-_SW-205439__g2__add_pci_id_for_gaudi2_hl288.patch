From dbf499d25ba55340da35b48c64741383490fe526 Mon Sep 17 00:00:00 2001
From: Vitaly Margolin <vmargolin@habana.ai>
Date: Thu, 26 Dec 2024 10:08:31 +0200
Subject: [PATCH] [SW-205439] g2: add pci id for gaudi2 hl288

Add PCI ID for Gaudi2 HL288 PCIE card

Change-Id: I7ed6d5428884deb1f7fc027a344f0d38adf6b89b
Signed-off-by: Vitaly Margolin <vmargolin@habana.ai>
---

diff --git a/arch/gaudi2/common/common.c b/arch/gaudi2/common/common.c
index f3cc25f..0318de0 100644
--- a/arch/gaudi2/common/common.c
+++ b/arch/gaudi2/common/common.c
@@ -317,10 +317,29 @@
 
 static u32 pci_dev_id;
 
+#define GPIO_CARD_TYPE		81
+#define GPIO_CARD_TYPE_BIT	BIT(GPIO_CARD_TYPE % 16)
+#define PSOC_GPIO5_DATA_REG	mmPSOC_GPIO5_BASE
+
+static bool is_card_type_pcie(void)
+{
+	uint32_t val;
+	uint32_t is_pcie;
+
+	val = regmap_readl(PSOC_GPIO5_DATA_REG);
+	is_pcie = val & GPIO_CARD_TYPE_BIT;
+	return !!is_pcie;
+}
+
 void preboot_device_id_init(void)
 {
+	enum hl_pci_ids pci_id = PCI_IDS_GAUDI2;
+
+	if (is_card_type_pcie())
+		pci_id = PCI_IDS_GAUDI2_HL_288;
+
 	/* using vendor id as a magic number */
-	pci_dev_id = PCI_IDS_GAUDI2 | (PCI_VENDOR_ID_HABANALABS << 16);
+	pci_dev_id = pci_id | (PCI_VENDOR_ID_HABANALABS << 16);
 }
 
 u32 preboot_device_id_get(void)
