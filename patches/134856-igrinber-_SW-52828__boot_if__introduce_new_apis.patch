 #include <preboot.h>
 #include <hl_boot_if.h>			/* requires stdint.h */
+#include <bitops.h>
 
 #define REG_WIDTH	32
 
@@ -75,7 +76,7 @@
 	regmap_writel(cpu_boot_if.status_val, cpu_boot_if.status);
 }
 
-static void cpu_boot_reg_clrset(u32 reg, u32 mask, bool set)
+static void cpu_boot_reg_do_clrset(u32 reg, u32 mask, bool set)
 {
 	u32 *shadow;
 
@@ -99,20 +100,14 @@
 
 void cpu_boot_err_clrset(u64 mask, bool set)
 {
-	cpu_boot_reg_clrset(cpu_boot_if.err[0], (u32)mask, set);
-	cpu_boot_reg_clrset(cpu_boot_if.err[1], (u32)(mask >> REG_WIDTH), set);
-}
-
-bool cpu_boot_err_get(u64 mask)
-{
-	return !!((cpu_boot_if.err_val[0] & (u32)mask) |
-		  (cpu_boot_if.err_val[1] & (u32)(mask >> REG_WIDTH)));
+	cpu_boot_reg_do_clrset(cpu_boot_if.err[0], (u32)mask, set);
+	cpu_boot_reg_do_clrset(cpu_boot_if.err[1], (u32)(mask >> REG_WIDTH), set);
 }
 
 void cpu_boot_dev_sts_clrset(u64 mask, bool set)
 {
-	cpu_boot_reg_clrset(cpu_boot_if.dev_sts[0], (u32)mask, set);
-	cpu_boot_reg_clrset(cpu_boot_if.dev_sts[1], (u32)(mask >> REG_WIDTH), set);
+	cpu_boot_reg_do_clrset(cpu_boot_if.dev_sts[0], (u32)mask, set);
+	cpu_boot_reg_do_clrset(cpu_boot_if.dev_sts[1], (u32)(mask >> REG_WIDTH), set);
 }
 
 void cpu_boot_rsp_set(enum cpu_msg_status sts)
@@ -131,3 +126,77 @@
 
 	return val << REG_WIDTH | cpu_boot_if.dev_sts_val[0];
 }
+
+static void cpu_boot_reg_clrset(u32 *reg_table, u32 val, bool set)
+{
+	int shift;
+	u32 reg;
+
+	reg = reg_table[val / REG_WIDTH];
+	shift = val % REG_WIDTH;
+
+	cpu_boot_reg_do_clrset(reg, BIT(shift), set);
+}
+
+static void cpu_boot_err_do_clrset(enum cpu_boot_err val, bool set)
+{
+	if (val < 0 || val >= CPU_BOOT_ERR_LAST)
+		return;
+
+	cpu_boot_reg_clrset(cpu_boot_if.err, val, set);
+}
+
+void cpu_boot_err_set(enum cpu_boot_err val)
+{
+	cpu_boot_err_do_clrset(val, true);
+}
+
+void cpu_boot_err_clr(enum cpu_boot_err val)
+{
+	cpu_boot_err_do_clrset(val, false);
+}
+
+static int cpu_boot_get(u32 *regs, int val)
+{
+	int shift;
+	u32 reg;
+
+	reg = regs[val / REG_WIDTH];
+	shift = val % REG_WIDTH;
+
+	return !!(regmap_readl(reg) & BIT(shift));
+}
+
+int cpu_boot_err_get(enum cpu_boot_err val)
+{
+	if (val < 0 || val >= CPU_BOOT_ERR_LAST)
+		return -1;
+
+	return cpu_boot_get(cpu_boot_if.err, val);
+}
+
+static void cpu_boot_dev_sts_do_clrset(enum cpu_boot_dev_sts val, bool set)
+{
+	if (val < 0 || val >= CPU_BOOT_DEV_STS_LAST)
+		return;
+
+	cpu_boot_reg_clrset(cpu_boot_if.dev_sts, val, set);
+}
+
+void cpu_boot_dev_sts_set(enum cpu_boot_dev_sts val)
+{
+	cpu_boot_dev_sts_do_clrset(val, true);
+}
+
+void cpu_boot_dev_sts_clr(enum cpu_boot_dev_sts val)
+{
+	cpu_boot_dev_sts_do_clrset(val, false);
+}
+
+int cpu_boot_dev_sts_get(enum cpu_boot_dev_sts val)
+{
+	if (val < 0 || val >= CPU_BOOT_DEV_STS_LAST)
+		return -1;
+
+	return cpu_boot_get(cpu_boot_if.dev_sts, val);
+}
