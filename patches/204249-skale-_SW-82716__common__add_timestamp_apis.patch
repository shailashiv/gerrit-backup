+#define TIMESTAMP_CNTCR_CNTCR_EN_M		CPU_TIMESTAMP_CNTCR_CNTCR_EN_MASK
+
 #define SPI_DMA_CTRL_ADDR_SHIFT			PSOC_GLOBAL_CONF_SPI_DMA_CTRL_ADDR_SHIFT
 #define SPI_DMA_CTRL_DST_SRAM_SHIFT		PSOC_GLOBAL_CONF_SPI_DMA_CTRL_DST_SRAM_SHIFT
