+++ b/arch/gaudi2/arc/regmap.h
@@ -17,6 +17,12 @@
 #define mmQSPI_BAUDR			mmPSOC_QSPI_BAUDR
 #define mmQSPI_DR0			mmPSOC_QSPI_DR0
 
+#define mmTIMESTAMP_CNTCR		mmPSOC_TIMESTAMP_CNTCR
+#define mmTIMESTAMP_CNTSR		mmPSOC_TIMESTAMP_CNTSR
+#define mmTIMESTAMP_CNTCVL		mmPSOC_TIMESTAMP_CNTCVL
+#define mmTIMESTAMP_CNTCVU		mmPSOC_TIMESTAMP_CNTCVU
+#define mmTIMESTAMP_CNTFID0		mmPSOC_TIMESTAMP_CNTFID0
+
 #define mmEFUSE_READ_CTRL		mmPSOC_EFUSE_READ_CTRL
 #define mmEFUSE_READ_ADDRESS		mmPSOC_EFUSE_READ_ADDRESS
 #define mmEFUSE_DATA_0			mmPSOC_EFUSE_DATA_0
