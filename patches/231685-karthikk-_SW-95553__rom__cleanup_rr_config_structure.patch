From 3f79bde18095b0d1c645f91de0ae7c4fe42828b2 Mon Sep 17 00:00:00 2001
From: Karthikeyan K <karthikk@habana.ai>
Date: Wed, 13 Jul 2022 12:11:31 +0300
Subject: [PATCH] [SW-95553] rom: cleanup rr config structure

Removed redundant code from rr config structure.

Change-Id: I35134e9322f99e0b4e993cd0362567b3fbc9167c
---

diff --git a/arch/gaudi3/arc/dev_security.h b/arch/gaudi3/arc/dev_security.h
index 1ec99ae..e9e08e5 100644
--- a/arch/gaudi3/arc/dev_security.h
+++ b/arch/gaudi3/arc/dev_security.h
@@ -71,17 +71,6 @@
 	HL_SEC_HBW_RR_SHORT_7 = 7,
 };
 
-/*
- * Enum to set the range registers to a predefined constant value.
- * eg: Open or block the complete lbw or hbw ranges, in this case
- * the min and max config values are constant (max possible).
- */
-enum rom_rr_ctx_static_config {
-	RR_OPEN_ALL,
-	RR_BLOCK_ALL,
-	RR_MAX_CTX_TYPES,
-};
-
 int secureboot_verify_image_v2(const uint8_t *image, uint32_t image_len, uint8_t *key,
 				uint32_t key_len, uint8_t *sig, uint32_t sig_len,
 				uint8_t sec_ver, uint8_t key_index);
diff --git a/arch/gaudi3/arc/security.c b/arch/gaudi3/arc/security.c
index 309f982..0aae899 100644
--- a/arch/gaudi3/arc/security.c
+++ b/arch/gaudi3/arc/security.c
@@ -94,36 +94,20 @@
 	}
 };
 
-static struct rom_rr_ctx rr_ctx_lbw[RR_MAX_CTX_TYPES] = {
-	[RR_OPEN_ALL] = {
+static struct rom_rr_ctx rr_ctx_lbw = {
 		.rr_idx = HL_SEC_LBW_RR_SHORT_13,
 		.data_min = RR_DEFAULT_VAL,
 		.data_max = RR_DEFAULT_VAL,
 		.en_val = RR_PRIV_RANGE_DIS,
-	},
-	[RR_BLOCK_ALL] = {
-		.data_min = RR_LBW_PRIV_RANGE_MIN_SHORT_VAL,
-		.data_max = RR_LBW_PRIV_RANGE_MAX_SHORT_VAL,
-		.en_val = RR_PRIV_RANGE_EN,
-	},
 };
 
-static struct rom_rr_ctx rr_ctx_hbw[RR_MAX_CTX_TYPES] = {
-	[RR_OPEN_ALL] = {
+static struct rom_rr_ctx rr_ctx_hbw = {
 		.rr_idx = HL_SEC_HBW_RR_SHORT_7,
 		.data_min = RR_DEFAULT_VAL,
 		.data_min_hi = RR_DEFAULT_VAL,
 		.data_max = RR_DEFAULT_VAL,
 		.data_max_hi = RR_DEFAULT_VAL,
 		.en_val = RR_PRIV_RANGE_DIS,
-	},
-	[RR_BLOCK_ALL] = {
-		.data_min = RR_HBW_PRIV_RANGE_MIN_LO_VAL,
-		.data_min_hi = RR_HBW_PRIV_RANGE_MIN_HI_VAL,
-		.data_max = RR_HBW_PRIV_RANGE_MAX_LO_VAL,
-		.data_max_hi = RR_HBW_PRIV_RANGE_MAX_HI_VAL,
-		.en_val = RR_PRIV_RANGE_EN,
-	},
 };
 
 static uint32_t security_rr_calc_rr_dist(struct rom_rr_ctx *rr_ctx)
@@ -743,16 +727,16 @@
 {
 	security_handle_twi();
 
-	security_rr_config_lbw_debug_if(&rr_ctx_lbw[RR_OPEN_ALL]);
+	security_rr_config_lbw_debug_if(&rr_ctx_lbw);
 
-	security_rr_config_hbw_debug_if(&rr_ctx_hbw[RR_OPEN_ALL]);
+	security_rr_config_hbw_debug_if(&rr_ctx_hbw);
 }
 
 void security_rr_recovery_pcie_config(void)
 {
-	security_rr_pcie_lbw_config(&rr_ctx_lbw[RR_OPEN_ALL]);
+	security_rr_pcie_lbw_config(&rr_ctx_lbw);
 
-	security_rr_pcie_hbw_config(&rr_ctx_hbw[RR_OPEN_ALL]);
+	security_rr_pcie_hbw_config(&rr_ctx_hbw);
 }
 
 void check_and_enable_4b_termination(void) {}
