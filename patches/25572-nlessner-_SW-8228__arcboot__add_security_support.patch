From 0bc82e80f12bb1255fad5a8e2a1128205460c135 Mon Sep 17 00:00:00 2001
From: Noam Lessner <nlessner@habana.ai>
Date: Tue, 14 Jan 2020 20:48:19 +0200
Subject: [PATCH] [SW-8228] arcboot: add security support

add support for security releated functions

Change-Id: Ief53d95c385551e8563a8256cba18eae8019b13c
Signed-off-by: Noam Lessner <nlessner@habana.ai>
---

diff --git a/common/security.c b/common/security.c
new file mode 100644
index 0000000..08ee5db
--- /dev/null
+++ b/common/security.c
@@ -0,0 +1,23 @@
+/*
+ * Copyright 2016-2019 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ *
+ * SPDX-License-Identifier:	GPL-2.0+
+ */
+
+#include "arcboot.h"
+
+void security_disable_debug_if()
+{
+
+}
+
+void security_enable_spi_dma()
+{
+	regmap_writel(mmPSOC_GLOBAL_CONF_SPI_DMA_AWUSER,0x400);
+}
+
+void security_enable_mem_cpy()
+{
+	regmap_writel(mmPSOC_GLOBAL_CONF_MEM_CPY_AXUSER,0x400);
+}
\ No newline at end of file
diff --git a/common/security.h b/common/security.h
new file mode 100644
index 0000000..5c08342
--- /dev/null
+++ b/common/security.h
@@ -0,0 +1,15 @@
+/*
+ * Copyright (C) 2017 HabanaLabs Ltd.
+ *   Author: Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#ifndef _SECURITY_H_
+#define _SECURITY_H_
+
+void security_disable_debug_if();
+void security_enable_spi_dma();
+void security_enable_mem_cpy();
+
+#endif /* _SECURITY_H_ */
\ No newline at end of file
