From 49aee6dd576ec4ea879fd0ead124f40e58f6df5a Mon Sep 17 00:00:00 2001
From: Karthikeyan K <karthikk@habana.ai>
Date: Tue, 06 Sep 2022 10:06:39 +0300
Subject: [PATCH] [SW-0] gaudi3: fix api comments

Fixed efuse bit security api's comments.

Change-Id: I257a673830a8cb89a03afcf91a1d48ff5d21e92c
---

diff --git a/arch/gaudi3/arc/security.c b/arch/gaudi3/arc/security.c
index 96e7530..452ba9e 100644
--- a/arch/gaudi3/arc/security.c
+++ b/arch/gaudi3/arc/security.c
@@ -698,7 +698,7 @@
 
 int security_efuse_tpm_en(void)
 {
-	/* check efuse for security validation enable */
+	/* check efuse for tpm validation enable */
 	uint32_t config_fuse = arcboot_rom_global.sec_data.efuse_sys_cfg;
 
 	return !!(config_fuse & EFUSE_SYSCFG_ENABLE_TPM_MASK);
@@ -706,7 +706,7 @@
 
 int security_efuse_tpm_loc(void)
 {
-	/* check efuse for security validation enable */
+	/* check efuse for tpm execution location */
 	uint32_t config_fuse = arcboot_rom_global.sec_data.efuse_sys_cfg;
 
 	return !!(config_fuse & EFUSE_SYSCFG_TPM_CODE_LOCATION_MASK);
