From ce8953cf1e07675518841dba72c9265daa60fb16 Mon Sep 17 00:00:00 2001
From: Michael Pauzner <mpauzner@habana.ai>
Date: Wed, 07 May 2025 13:57:21 +0300
Subject: [PATCH] [SW-221409] serdes: add support for lfs in ram

Include path for LFS rambd is missing.

Change-Id: I0558f8d843ea46eec15e004fd82e97b1fba32683
Signed-off-by: Michael Pauzner <mpauzner@habana.ai>
---

diff --git a/CMakeLists.txt b/CMakeLists.txt
index ae43380..afa0a68 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -15,6 +15,7 @@
     zephyr_include_directories(${ZEPHYR_MODULES_DIR}/littlefs)
     zephyr_include_directories(${ZEPHYR_MODULES_DIR}/littlefs/common)
     zephyr_include_directories(${ZEPHYR_MODULES_DIR}/littlefs/zephyr)
+    zephyr_include_directories(${ZEPHYR_MODULES_DIR}/littlefs/bd)
   endif()
   FILE(GLOB hl_serdes_sources src/hl_serdes/common/*.c src/hl_serdes/${DEVICE}/*.c)
   list(APPEND lib_sources ${hl_serdes_sources})
