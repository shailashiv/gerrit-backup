From 9583f00d4aaa2efed40837b95456eb4bf16f0e96 Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Mon, 04 Jul 2022 16:28:37 +0300
Subject: [PATCH] [SW-0] gaudi2: use standard defines from sizes.h

Replace adhoc values with standard defines from sizes.h.

Change-Id: If701d61cc16cc4496c97430b42229bf040bd75d6
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/arch/gaudi2/arc/common.c b/arch/gaudi2/arc/common.c
index f552a60..44c6c9e 100644
--- a/arch/gaudi2/arc/common.c
+++ b/arch/gaudi2/arc/common.c
@@ -40,6 +40,7 @@
 #include <boot_if.h>
 #include "common.h"
 #include <bitops.h>
+#include <sizes.h>
 #include "preboot/thermal.h"
 #include <arcboot_export.h>
 #include <pci.h>
@@ -70,7 +71,7 @@
 #define DBI_ENABLE				0x300000
 
 #define ARCBOOT_STATUS_REG_SZ_BITS		32
-#define FLASH_64KB_PADD				65536
+#define FLASH_64KB_PADD				SZ_64K
 #define FLASH_VALID_SZ(s)			((s) < SZ_2M)
 #define SECUREBOOT_MAX_PPBOOT_IMG_SIZE		46080
 #define SPI_DMA_DST_FW_SRAM			BIT(1)
@@ -359,7 +360,6 @@
  */
 #define MAX_DMA_SIZE		0xFFF0
 #define CRC_SIZE		4
-#define OFFSET_64KB		0x10000
 
 static int ppboot_dma_copy(uint16_t image_size, uint32_t flash_offset,
 			   uint64_t dest_offset, uint8_t fw_sram_dst)
@@ -474,7 +474,7 @@
 			(payload_size - MAX_DMA_SIZE * i + CRC_SIZE) :
 				(MAX_DMA_SIZE + CRC_SIZE);
 
-		ret = ppboot_dma_copy(copy_size, (flash_offset + OFFSET_64KB * i),
+		ret = ppboot_dma_copy(copy_size, (flash_offset + SZ_64K * i),
 					SDRAM_MEM_REGION_FULL_ADDR(mdesc.base),
 					SPI_DMA_DST_HBW);
 		if (ret)
@@ -535,7 +535,7 @@
 				(payload_size - MAX_DMA_SIZE * i + CRC_SIZE) :
 				(MAX_DMA_SIZE + CRC_SIZE);
 
-		ret = ppboot_dma_copy(copy_size, flash_offset + OFFSET_64KB * i,
+		ret = ppboot_dma_copy(copy_size, flash_offset + SZ_64K * i,
 				      ARC1_ICCM_FULL_BASE, SPI_DMA_DST_HBW);
 		if (ret)
 			return ARCBOOT_BRINGUP_ERROR;
