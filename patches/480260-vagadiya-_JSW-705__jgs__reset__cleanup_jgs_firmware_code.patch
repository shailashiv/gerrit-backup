From 1247eb2d5150d86a02d0180a46dc62163d26e7ca Mon Sep 17 00:00:00 2001
From: Mitali Vagadiya <vmnagajibhai@habana.ai>
Date: Wed, 21 May 2025 17:20:29 +0300
Subject: [PATCH] [JSW-705] jgs: reset: cleanup jgs firmware code

This patch removes unnecessary or additional comments,
renames fs related code to jgs and performs complete
code cleanup.

Change-Id: I91dd1329943c4fb9944bc9c5ebd526c6c6b83e4c
---

diff --git a/arch/jgs/dev.c b/arch/jgs/dev.c
index 6b8df87..254536e 100644
--- a/arch/jgs/dev.c
+++ b/arch/jgs/dev.c
@@ -1,6 +1,6 @@
 // SPDX-License-Identifier: Apache-2.0
 /*
- * (C) Copyright 2024 HabanaLabs, Ltd.
+ * (C) Copyright 2025 Intel, Ltd.
  * All rights reserved.
  *
  */
@@ -18,58 +18,58 @@
 LOG_MODULE_REGISTER(intel_jgs_reset);
 struct k_work reset_work;
 
-static void fs1_rst_notify_cxl_arc(void)
+static void jgs_rst_notify_cxl_arc(void)
 {
 	/* TODO */
 }
 
-static void fs1_rst_prepare_xha_reset(void)
+static void jgs_rst_prepare_xha_reset(void)
 {
 	/* TODO */
 }
 
-static void fs1_rst_send_cxl_reset(void)
+static void jgs_rst_send_cxl_reset(void)
 {
 	/* TODO */
 }
 
-static void fs1_rst_isolation_cfg(bool en)
+static void jgs_rst_isolation_cfg(bool en)
 {
 	/* TODO */
 }
 
-static void fs1_rst_issue_unit_rst(bool reset)
+static void jgs_rst_issue_unit_rst(bool reset)
 {
 	/* TODO */
 }
 
-static void fs1_rst_work(struct k_work *work)
+static void jgs_rst_work(struct k_work *work)
 {
 	uint32_t  retry = FSM_STATE_RETRIES;
 
 	/* Early reset notification to CXL */
-	fs1_rst_notify_cxl_arc();
+	jgs_rst_notify_cxl_arc();
 
 	/* Prepare xHA for reset */
-	fs1_rst_prepare_xha_reset();
+	jgs_rst_prepare_xha_reset();
 
 	/* Prepare CXL arc for reset */
-	fs1_rst_send_cxl_reset();
+	jgs_rst_send_cxl_reset();
 
 	/* Set ISO for the blocks which undergo reset */
-	fs1_rst_isolation_cfg(true);
+	jgs_rst_isolation_cfg(true);
 
 	/* Issue unit reset to block under reset */
-	fs1_rst_issue_unit_rst(true);
+	jgs_rst_issue_unit_rst(true);
 
 	/* wait for 0.5 usec */
 	k_busy_wait(500);
 
 	/* End unit reset */
-	fs1_rst_issue_unit_rst(false);
+	jgs_rst_issue_unit_rst(false);
 
 	/* Clear ISO for the blocks which underwent reset */
-	fs1_rst_isolation_cfg(true);
+	jgs_rst_isolation_cfg(true);
 
 	/* set the BTM FSM state to FSM_GRAD_RST_DONE */
 	CFG_WREG32(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_BTM_FSM), FSM_GRAD_RST_DONE);
@@ -86,7 +86,7 @@
 
 }
 
-__unused static void fs1_rst_callback(const struct device *dev, void *data)
+__unused static void jgs_rst_callback(const struct device *dev, void *data)
 {
 	k_work_submit(&reset_work);
 }
@@ -97,5 +97,5 @@
 
 	/* TODO: get the reset dev and register for call back */
 
-	k_work_init(&reset_work, fs1_rst_work);
+	k_work_init(&reset_work, jgs_rst_work);
 }
