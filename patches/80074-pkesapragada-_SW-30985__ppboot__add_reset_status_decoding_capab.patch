+	GAUDI2_SW_RST = PSOC_GLOBAL_CONF_RST_SRC_SW_RST_IND_SHIFT,
+	GAUDI2_FLR_RST = PSOC_GLOBAL_CONF_RST_SRC_FLR_RST_IND_SHIFT,
+	GAUDI2_ECC_DERR_RST = PSOC_GLOBAL_CONF_RST_SRC_ECC_DERR_RST_IND_SHIFT,
