From 22e205342e6ee049b162761dc43bbd0576d87d4d Mon Sep 17 00:00:00 2001
From: Pardha Kesapragada <pkesapragada@habana.ai>
Date: Thu, 18 Mar 2021 11:49:31 +0200
Subject: [PATCH] [SW-30985] ppboot: add reset status decoding capability

In all platforms until Greco, PSOC_GLOBAL_CONF_RST_SRC
contained an index which will determine the cause of reset.
But for Gaudi2, more resets have been added, each with
a bit mask, with each reset denoting a specific case.
Hence add a capability to decode the reset causes per
platform basis. The platform specific resets
are mapped to a common structure which ppboot uses to
take appropriate actions

Change-Id: I1cc62fa2fb6d8c3c2937613ebfd92112280aff5b
Signed-off-by: Pardha Kesapragada <pkesapragada@habana.ai>
---

diff --git a/gaudi/common.c b/gaudi/common.c
index 957a49f..c348264 100644
--- a/gaudi/common.c
+++ b/gaudi/common.c
@@ -420,3 +420,33 @@
 	preboot_ack_razwi_irq();
 	preboot_security_dbi_lock();
 }
+
+u32 decode_reset_cause(void)
+{
+	u32 rst_src;
+
+	rst_src = regmap_readl(mmPSOC_GLOBAL_CONF_RST_SRC);
+
+	switch (rst_src) {
+	case GAUDI_COLD_RST:
+		rst_src = HL_COLD_RST;
+		break;
+	case GAUDI_PRSTN_RST:
+		rst_src = HL_PRSTN_RST;
+		break;
+	case GAUDI_MANUAL_RST:
+		rst_src = HL_MANUAL_RST;
+		break;
+	case GAUDI_WD_RST:
+		rst_src = HL_WD_RST;
+		break;
+	case GAUDI_SW_ALL_RST:
+		rst_src = HL_SW_ALL_RST;
+		break;
+	default:
+		rst_src = HL_UNKNOWN_RST;
+		break;
+	}
+
+	return rst_src;
+}
diff --git a/gaudi/common.h b/gaudi/common.h
index 4ab14a4..6d553ed 100644
--- a/gaudi/common.h
+++ b/gaudi/common.h
@@ -59,5 +59,13 @@
 int gaudi_hbm_init(void);
 u32 preboot_get_vendor_id_device_id(void);
 
+enum gaudi_rst_src {
+	GAUDI_COLD_RST,
+	GAUDI_MANUAL_RST,
+	GAUDI_PRSTN_RST = 2,
+	GAUDI_WD_RST = 4,
+	GAUDI_SW_ALL_RST = 8,
+};
+
 #endif /* __ASSEMBLY__ */
 #endif /* COMMON_GAUDI_H_ */
diff --git a/gaudi2_arc_gnu/common.c b/gaudi2_arc_gnu/common.c
index b5b8750..e1c3e85 100644
--- a/gaudi2_arc_gnu/common.c
+++ b/gaudi2_arc_gnu/common.c
@@ -454,3 +454,50 @@
 	*loadaddr = copy_preboot();
 	return true;
 }
+
+u32 decode_reset_cause(void)
+{
+	u32 pos, rst_src, reg;
+
+	reg = regmap_readl(mmPSOC_GLOBAL_CONF_RST_SRC);
+
+	if (!reg)
+		return HL_UNKNOWN_RST;
+
+	pos = (__builtin_ffs(reg) - 1);
+
+	switch (pos) {
+	case GAUDI2_COLD_RST:
+		rst_src = HL_COLD_RST;
+		break;
+	case GAUDI2_PRSTN_RST:
+		rst_src = HL_PRSTN_RST;
+		break;
+	case GAUDI2_MANUAL_RST:
+		rst_src = HL_MANUAL_RST;
+		break;
+	case GAUDI2_WD_RST:
+		rst_src = HL_WD_RST;
+		break;
+	case GAUDI2_SW_RST:
+		rst_src = HL_SW_ALL_RST;
+		break;
+	case GAUDI2_SOFT_RST:
+		rst_src = HL_SOFT_RST;
+		break;
+	case GAUDI2_FW_RST:
+		rst_src = HL_FW_RST;
+		break;
+	case GAUDI2_FLR_RST:
+		rst_src = HL_FLR_RST;
+		break;
+	case GAUDI2_ECC_DERR_RST:
+		rst_src = HL_ECC_DERR_RST;
+		break;
+	default:
+		rst_src = HL_UNKNOWN_RST;
+		break;
+	}
+
+	return rst_src;
+}
