From 72d1a6fbafc6717326173751501ab1ee5222c648 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Sun, 05 Aug 2018 16:59:12 +0300
Subject: [PATCH] Add more validation for burn_flush script

Check flashcp return value
---

diff --git a/board/habanalabs/common/rootfs_overlay/usr/sbin/flash_burn b/board/habanalabs/common/rootfs_overlay/usr/sbin/flash_burn
index fe05e59..f699c11 100755
--- a/board/habanalabs/common/rootfs_overlay/usr/sbin/flash_burn
+++ b/board/habanalabs/common/rootfs_overlay/usr/sbin/flash_burn
@@ -98,6 +98,11 @@
 	echo -n "    ${NAME} @ ${OFFSET_HEX}... "
 	flashcp ${IMG} ${DEV}
 
+	if [ $? -ne 0 ]; then
+		echo "ERROR: flashcp ${IMG} ${DEV}"
+		exit 3
+	fi
+
 	IMG_SIZE=`ls -l ${IMG}						| tr -s ' ' 			| cut -d' ' -f5`
 	BLK_CNT=$(((${IMG_SIZE} + 0x8000) / 0x10000))
 	dd status=none conv=sync bs=64K if=${DEV} of=${IMG}.verify count=${BLK_CNT}
