new file mode 100644
index 0000000..9e99bef
--- /dev/null
+++ b/common/spi_flash.h
@@ -0,0 +1,29 @@
+/*
+ * Copyright (C) 2017 HabanaLabs Ltd.
+ *   Author: Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#ifndef _SPI_FLASH_H_
+#define _SPI_FLASH_H_
+
+#define ENABLE_BYTE_SWAP		1
+#define DISABLE_BYTE_SWAP		0
+
+#define FLASH_PRIMARY_OFFSET		0
+#define FLASH_SECONDARY_OFFSET		4
+#define FLASH_EFUSE_OFFSET		8
+#define FLASH_IMAGE_PTR			12
+
+#define FLASH_EFUSE_FW_VERSION_OFFSET	0
+#define FLASH_EFUSE_KEYS_OFFSET		16
+#define FLASH_EFUSE_KEYS_REVOKE_OFFSET	176
+
+u32 spi_flash_readl(u32 offset);
+void spi_flash_writel(u32 val, u32 offset);
+void spi_flash_get_revoke(uint32_t *key_revoke);
+void spi_flash_get_hash(uint32_t *key_hash);
+uint8_t spi_flash_get_fw_version_security(void);
+
+#endif /* _SPI_FLASH_H_ */
