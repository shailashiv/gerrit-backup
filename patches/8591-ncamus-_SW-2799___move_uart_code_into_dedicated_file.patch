+#ifndef _HL_UART_H_
+#define _HL_UART_H_
+
+
+#ifdef DEV_IS_GOYA
+void preboot_puts_raw(const char* str);
+void preboot_puts(const char* str);
+int preboot_uint2hexstring(char *str, unsigned int num, bool pad);
+void preboot_puth_raw(unsigned int val, bool pad);
+void preboot_puth(unsigned int val, bool pad);
+#else
+static inline void preboot_puts_raw(const char* str) {}
+static inline void preboot_puts(const char* str) {}
+static inline int preboot_uint2hexstring(char *str, unsigned int num, bool pad) { return 0;}
+static inline void preboot_puth_raw(unsigned int val, bool pad) {}
+static inline void preboot_puth(unsigned int val, bool pad) {}
+#endif
+
+#endif /* _HL_UART_H_ */
