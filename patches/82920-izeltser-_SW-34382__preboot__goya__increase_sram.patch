From 7845eab161ab0e70fe0756ede9c4fb417bcf2a1d Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Mon, 15 Mar 2021 16:42:16 +0200
Subject: [PATCH] [SW-34382] preboot: goya: increase sram

Handling boot info from scratchpad sram, specifically nvme
descriptor, has increased the bss utilization.
increasing to a max of 128kb

Change-Id: I59424531c6fefa5eba3e40029c20e70364cb461b
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/goya/common.h b/goya/common.h
index 2adf5b8..1c489be 100644
--- a/goya/common.h
+++ b/goya/common.h
@@ -10,7 +10,7 @@
 #define SRAM_SIZE			0x32A0000	/* 50.625MB */
 
 #define PPBOOT_SIZE			0x4000		/* 16KB */
-#define PREBOOT_SIZE			0xC000		/* 48KB */
+#define PREBOOT_SIZE			0x20000		/* 128KB */
 
 #define HL_FW_BOOT_PTRS_BASE		0x60000
 #define HL_SPI_LEGACY_PREBOOT_OFF	0xA0000
