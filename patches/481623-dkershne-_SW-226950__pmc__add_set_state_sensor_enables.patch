From 63bdf4377e5e45f3be7571808258a72268e261b7 Mon Sep 17 00:00:00 2001
From: David Kershner <dkershner@habana.ai>
Date: Thu, 15 May 2025 21:34:36 +0300
Subject: [PATCH] [SW-226950] pmc: add set state sensor enables

Add the PLDM command SetStateSensorEnables. Each composite sensors
can be manually set to ENABLED, DISABLED, or UNAVAILABLE. Sensor
operational state is persisted across soft resets (oobi) as
long as table is not full.

Change-Id: I93c4d05f233a905e4ac028734032d9978ad5c298
Signed-off-by: David Kershner <dkershner@habana.ai>
---

diff --git a/include/pldm_base.h b/include/pldm_base.h
index c0a0d9f..f353997 100644
--- a/include/pldm_base.h
+++ b/include/pldm_base.h
@@ -74,6 +74,7 @@
 #define PLDM_CMD_PMC_GET_UID				0x03
 #define PLDM_CMD_PMC_SET_NUMERIC_SENSOR_ENABLE		0x10
 #define PLDM_CMD_PMC_GET_SENSOR_READING			0x11
+#define PLDM_CMD_PMC_SET_STATE_SENSOR_ENABLES		0x20
 #define PLDM_CMD_PMC_GET_STATE_SENSOR_READINGS		0x21
 #define PLDM_CMD_PMC_SET_NUMERIC_EFFECTER_ENABLE	0x30
 #define PLDM_CMD_PMC_SET_NUMERIC_EFFECTER_VALUE		0x31
@@ -419,6 +420,23 @@
 	uint16_t sensor_id;
 	uint8_t sensor_operational_state;
 	uint8_t sensor_event_message_enable;
+} __packed;
+
+typedef enum {
+	PLDM_PMC_SET_STATE_SENSOR_ENABLES_STATUS_INVALID_SENSOR_ID		= 0x80,
+	PLDM_PMC_SET_STATE_SENSOR_ENABLES_STATUS_INVALID_OP_STATE		= 0x81,
+	PLDM_PMC_SET_STATE_SENSOR_ENABLES_STATUS_EVENT_GEN_NOT_SUPPORTED	= 0x82,
+} pldm_pmc_set_state_sensor_enables_status_t;
+
+struct pldm_pmc_set_state_sensor_enables_op_field {
+	uint8_t sensor_op_state;
+	uint8_t event_msg_enable;
+} __packed;
+
+struct pldm_pmc_set_state_sensor_enables_req {
+	uint16_t sensor_id;
+	uint8_t composite_sensor_count;
+	struct pldm_pmc_set_state_sensor_enables_op_field op_field[PLDM_PDR_MAX_COMPOSITE_SENSORS];
 } __packed;
 
 typedef enum {
@@ -958,6 +976,7 @@
 			PLDM_DEFINE_REQ(pmc_get_pdr);
 			PLDM_DEFINE_REQ(pmc_set_numeric_sensor_enable);
 			PLDM_DEFINE_REQ(pmc_get_sensor_reading);
+			PLDM_DEFINE_REQ(pmc_set_state_sensor_enables);
 			PLDM_DEFINE_REQ(pmc_get_state_sensor_readings);
 			PLDM_DEFINE_REQ(pmc_get_sensor_thresholds);
 			PLDM_DEFINE_REQ(pmc_set_sensor_thresholds);
