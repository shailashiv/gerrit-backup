diff --git a/src/pldm_pmc.c b/src/pldm_pmc.c
index 456193f..8569f6a 100644
--- a/src/pldm_pmc.c
+++ b/src/pldm_pmc.c
@@ -1429,6 +1429,53 @@
 	return 0;
 }
 
+static int pldm_do_pmc_set_state_sensor_enables(
+	pldm_t pldm, void *arg, struct pldm_transport_msg *msg, k_timeout_t timeout)
+{
+	struct pldm_pmc_set_state_sensor_enables_req *req =
+		&msg->pldm.req.pmc_set_state_sensor_enables;
+	struct pldm_pmc_state *state = arg;
+	uint8_t op_states[PLDM_PDR_MAX_COMPOSITE_SENSORS];
+	int comp_sensor_count = MIN(req->composite_sensor_count, PLDM_PDR_MAX_COMPOSITE_SENSORS);
+	int err = 0;
+
+	if (state->log_requests)
+		LOG_INF("PLDM:PMC:SetStateSensorEnables ID=%u", req->sensor_id);
+
+	for (int idx = 0; idx < comp_sensor_count; idx++) {
+		if (req->op_field[idx].event_msg_enable) {
+			err = PLDM_PMC_SET_STATE_SENSOR_ENABLES_STATUS_EVENT_GEN_NOT_SUPPORTED;
+			break;
+		}
+		if (req->op_field[idx].sensor_op_state > PLDM_SENSOR_OP_STATE_UNAVAILABLE) {
+			err = PLDM_PMC_SET_STATE_SENSOR_ENABLES_STATUS_INVALID_OP_STATE;
+			break;
+		}
+		op_states[idx] = req->op_field[idx].sensor_op_state;
+	}
+	if (err)
+		return pldm_respond_error(pldm, msg, timeout, err);
+
+	err = sensord_state_sensor_enables_set(req->sensor_id,
+					       comp_sensor_count,
+					       op_states);
+	if (err)
+		return pldm_respond_error(pldm, msg, timeout, err);
+
+	err = pldm_resp_prepare(pldm, msg, 0);
+	if (err) {
+		LOG_ERR("%s: failed to prepare response: %d", __func__, err);
+		return err;
+	}
+
+	err = pldm_resp_send(pldm, msg, timeout);
+	if (err) {
+		LOG_ERR("%s: failed to send response: %d", __func__, err);
+		return err;
+	}
+	return 0;
+}
+
 static const struct pldm_handler pldm_pmc_handlers[] = {
 	{ PLDM_CMD_PMC_GET_PDR_REPO_INFO,		pldm_do_pmc_get_pdr_repo_info},
 	{ PLDM_CMD_PMC_GET_PDR,				pldm_do_pmc_get_pdr},
@@ -1443,6 +1490,7 @@
 	{ PLDM_CMD_PMC_SET_STATE_EFFECTER_ENABLES,	pldm_do_pmc_set_state_effecter_enables},
 	{ PLDM_CMD_PMC_SET_STATE_EFFECTER_STATES,	pldm_do_pmc_set_state_effecter_states},
 	{ PLDM_CMD_PMC_GET_STATE_EFFECTER_STATES,	pldm_do_pmc_get_state_effecter_states},
+	{ PLDM_CMD_PMC_SET_STATE_SENSOR_ENABLES,	pldm_do_pmc_set_state_sensor_enables},
 	{ PLDM_CMD_PMC_SET_NUMERIC_SENSOR_ENABLE,	pldm_do_pmc_set_numeric_sensor_enable},
 };
 
diff --git a/src/sensord.c b/src/sensord.c
index aa4d198..7434c48 100644
--- a/src/sensord.c
+++ b/src/sensord.c
@@ -895,12 +895,44 @@
 	}
 }
 
+static void oobi_decode_state_sensor_state(uint8_t *op_states, uint16_t comp_op_state)
+{
+	for (int i = 0; i < PLDM_PDR_MAX_COMPOSITE_SENSORS; i++) {
+		if (HL_OOBI_PLDM_STATE_SENSOR_OP_STATE_IS_UNAVAILABLE(i, comp_op_state))
+			op_states[i] = PLDM_SENSOR_OP_STATE_UNAVAILABLE;
+		else if (HL_OOBI_PLDM_STATE_SENSOR_OP_STATE_IS_DISABLED(i, comp_op_state))
+			op_states[i] = PLDM_SENSOR_OP_STATE_DISABLED;
+		else
+			op_states[i] = PLDM_SENSOR_OP_STATE_ENABLED;
+	}
+}
+
+static void sensord_oobi_load_state_sensor_enables(void)
+{
+	struct hl_oobi_pldm_state_sensor_op_state *sensors;
+
+	sensors = sensord_state.oobi.state_op_state;
+
+	for (size_t i = 0; i < ARRAY_SIZE(sensord_state.oobi.state_op_state); i++) {
+		uint8_t op_states[PLDM_PDR_MAX_COMPOSITE_SENSORS] = {};
+
+		if (sensors[i].sensor_id == 0)
+			continue;
+
+		oobi_decode_state_sensor_state(op_states, sensors[i].comp_op_state);
+		sensord_state_sensor_enables_set(sensors[i].sensor_id,
+						 PLDM_PDR_MAX_COMPOSITE_SENSORS,
+						 op_states);
+	}
+}
+
 static void sensord_oobi_load(void)
 {
 	hl_oobi_pldm_sensor_restore_data(&sensord_state.oobi);
 
 	sensord_oobi_load_thresholds();
 	sensord_oobi_load_numeric_sensor_enable();
+	sensord_oobi_load_state_sensor_enables();
 }
 
 static int sensord_init_all_sensors(void)
@@ -1138,6 +1170,97 @@
 	return MCTP_STATUS_SUCCESS;
 }
 
+static void sensord_persist_state_sensor_enable(struct sensord_sensor_entry *sensor)
+{
+	struct hl_oobi_pldm_state_sensor_op_state *item = NULL;
+	struct hl_oobi_pldm_state_sensor_op_state *empty = NULL;
+	struct hl_oobi_pldm_sensors *oobi = &sensord_state.oobi;
+	uint16_t sensor_id = get_sensor_id(sensor);
+
+	for (size_t i = 0; i < ARRAY_SIZE(oobi->state_op_state); i++) {
+		if (oobi->state_op_state[i].sensor_id == sensor_id) {
+			item = &oobi->state_op_state[i];
+			break;
+		}
+		if (!empty && oobi->state_op_state[i].sensor_id == 0)
+			empty = &oobi->state_op_state[i];
+	}
+	if (!item)
+		item = empty;
+	if (!item) {
+		LOG_WRN("%s: Unable to persist sensor op_states  %d: table_full", __func__,
+			sensor_id);
+		return;
+	}
+
+	item->sensor_id = sensor_id;
+	item->comp_op_state = 0; /* ENABLE all composite sensors */
+	for (int idx = 0; idx < sensor->state->value.composite.count; idx++) {
+		uint8_t current_op_state =
+			sensor->state->value.composite.element[idx].operational_state;
+
+		if (current_op_state == PLDM_SENSOR_OP_STATE_UNAVAILABLE)
+			item->comp_op_state |= HL_OOBI_PLDM_STATE_SENSOR_OP_STATE_UNAVAILABLE(idx);
+		else if (current_op_state == PLDM_SENSOR_OP_STATE_DISABLED)
+			item->comp_op_state |= HL_OOBI_PLDM_STATE_SENSOR_OP_STATE_DISABLED(idx);
+	}
+
+	/* No composite sensor is disabled/unavailable remove from persistence */
+	if (!item->comp_op_state)
+		item->sensor_id = 0;
+
+	hl_oobi_pldm_sensor_persist_data(oobi);
+}
+
+int sensord_state_sensor_enables_set(
+	uint16_t sensor_id,
+	uint8_t op_state_count,
+	uint8_t *op_states)
+{
+	struct sensord_sensor_entry *sensor;
+	struct sensord_sensor_state *state;
+	uint8_t composite_sensor_count;
+	k_spinlock_key_t key;
+
+	sensor = find_sensor(sensor_id, STATE_SENSOR_TYPE_MASK);
+	if (!sensor)
+		return PLDM_PMC_SET_STATE_SENSOR_ENABLES_STATUS_INVALID_SENSOR_ID;
+
+	state = sensor->state;
+
+	composite_sensor_count = MIN(op_state_count, state->value.composite.count);
+
+	key = k_spin_lock(&sensord_state.lock);
+
+	for (int idx = 0; idx < composite_sensor_count; idx++) {
+		struct sensord_sensor_value_composite_element *element =
+			&state->value.composite.element[idx];
+		uint8_t current_op_state = element->operational_state;
+		uint8_t desired_op_state = op_states[idx];
+
+		if (current_op_state != desired_op_state) {
+			element->operational_state = desired_op_state;
+			element->present_state = PLDM_SENSOR_THRESHOLD_UNKNOWN;
+			element->previous_state = PLDM_SENSOR_THRESHOLD_UNKNOWN;
+			element->event_state = PLDM_SENSOR_THRESHOLD_UNKNOWN;
+
+			if (desired_op_state == PLDM_SENSOR_OP_STATE_ENABLED) {
+				state->polled = false; /* reset poll-once tracking */
+
+				/* trigger daemon poll immediately after enabling a sensor */
+				state->timestamp_next_poll = 0;
+				sensord_state.timestamp_next_poll = 0;
+			}
+		}
+	}
+
+	k_spin_unlock(&sensord_state.lock, key);
+
+	sensord_persist_state_sensor_enable(sensor);
+
+	return MCTP_STATUS_SUCCESS;
+}
+
 static int update_if_enabled_u8(
 	const struct pldm_pdr_numeric_sensor_u8 *entry,
 	struct pldm_pmc_threshold_data *dst,
