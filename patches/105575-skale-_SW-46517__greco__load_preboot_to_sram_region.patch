From 5049ce2a8ee513df99192feeb426dc3f4295a08d Mon Sep 17 00:00:00 2001
From: Sanyog Kale <skale@habana.ai>
Date: Wed, 23 Jun 2021 21:02:12 +0300
Subject: [PATCH] [SW-46517] greco: load preboot to sram region

Currently, preboot image is dma'ed from spi to scratchpad sram
in secureboot flow. Since scratchpad sram is limited and is used
for other stuff in FW, this patch add changes to load and run
preboot at sram location.

Change-Id: I2c0a16d1e043a9dcb462ff65271df334dd4d0051
---

diff --git a/arch/greco_arc/common.c b/arch/greco_arc/common.c
index 2457972..c75cd0e 100644
--- a/arch/greco_arc/common.c
+++ b/arch/greco_arc/common.c
@@ -494,14 +494,14 @@
 	 * instead of 0x7FFBFE1000ULL (right shift offest 0x1000 by 2).
 	 */
 	dma_copy_image(image_size, flash_offset,
-		       (HL_SP_SRAM_BASE + (SP_SRAM_PREBOOT_OFFSET >> 2)),
-		       SPI_DMA_DST_HBW);
+			(SDRAM_FULL_BASE + (PPBOOT_SIZE >> 2)),
+			SPI_DMA_DST_HBW);
 	if (dma_wait_finish() == DMA_CRC_ERROR)
 		return ARCBOOT_BRINGUP_ERROR;
 
 	image_size -= SECUREBOOT_IMG_HEAD_FOOTER;
 	if (secureboot_verify_image(image_size,
-			(SP_SRAM_BASE + SP_SRAM_PREBOOT_OFFSET + IMG_LEN_SIZE))
+			(SDRAM_BASE + PPBOOT_SIZE + IMG_LEN_SIZE))
 			== SECUREBOOT_VERIFY_FAILED)
 		return ARCBOOT_BRINGUP_ERROR;
 
diff --git a/arch/greco_arc/common.h b/arch/greco_arc/common.h
index 667db54..6716ae0 100644
--- a/arch/greco_arc/common.h
+++ b/arch/greco_arc/common.h
@@ -16,20 +16,20 @@
 #define HL_FW_BOOT_PTRS_BASE		0x80000
 #define HL_SPI_LEGACY_PREBOOT_OFF	0xC0000
 
+#define SDRAM_BASE		0x10000000
+#define SDRAM_FULL_BASE		0x7FF0000000ull
 #define HL_SP_SRAM_BASE		0x7FFBFE0000ULL
 #define PCIE_FW_SRAM_BASE	0x1BFF0000
 #define FW_SRAM_BASE		0x1B050000
 #define SP_SRAM_BASE		0x1BFE0000
-#define SP_SRAM_PREBOOT_OFFSET	0x1000
 #define PPBOOT_TEXT_BASE	(FW_SRAM_BASE + 0xC)
-#define PREBOOT_TEXT_BASE	(SP_SRAM_BASE + SP_SRAM_PREBOOT_OFFSET + 0x8)
+#define PREBOOT_TEXT_BASE	(SDRAM_BASE + PPBOOT_SIZE + 0x8)
 /* In order not to conflict with ARC BOOTROM's usage of DCCM,
  * Let PPBoot start from the offset of 8544 bytes, for using DCCM
  * for its own BSS and Stack.
  */
 #define PPBOOT_DCCM_BASE	0x80002160
 
-#define SDRAM_BASE		0x10000000
 #define HL_SPI_BASE		0x1A000000
 #define HL_CFG_BASE		0xFC000000
 
diff --git a/arch/greco_arc_gnu/common.h b/arch/greco_arc_gnu/common.h
index b85e34f..356c48a 100644
--- a/arch/greco_arc_gnu/common.h
+++ b/arch/greco_arc_gnu/common.h
@@ -16,13 +16,13 @@
 #define HL_FW_BOOT_PTRS_BASE		0x80000
 #define HL_SPI_LEGACY_PREBOOT_OFF	0xC0000
 
+#define SDRAM_BASE		0x10000000
 #define PCIE_FW_SRAM_BASE	0x1BFF0000
 #define FW_SRAM_BASE		0x1B050000
 #define SP_SRAM_BASE		0x1BFE0000
 #define ARC_ICCM_BASE		0x1B020000
-#define SP_SRAM_PREBOOT_OFFSET	0x1000
 #define PPBOOT_TEXT_BASE	(FW_SRAM_BASE + 0xC)
-#define PREBOOT_TEXT_BASE	(SP_SRAM_BASE + SP_SRAM_PREBOOT_OFFSET + 0x8)
+#define PREBOOT_TEXT_BASE	(SDRAM_BASE + PPBOOT_SIZE + 0x8)
 
 #define HL_SP_SRAM_BASE		0x7FFBFE0000
 #define HL_SP_SRAM_SIZE		0x10000
@@ -41,7 +41,6 @@
 #define RECOVERY_TEXT_BASE	(0x0 + 0x4)
 #define RECOVERY_SIZE		0x4000
 
-#define SDRAM_BASE		0x10000000
 #define SDRAM_FULL_BASE		0x7FF0000000ull
 #define DRAM_BASE		0x1000000000000ull
 #define HOST_PHYS_BASE		0x2000000000000ull
