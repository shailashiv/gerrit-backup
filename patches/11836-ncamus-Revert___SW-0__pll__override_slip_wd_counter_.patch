From f1aaef1c2b8c7401543ba3f0281dae19ac75e9ce Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Thu, 25 Apr 2019 17:47:43 +0300
Subject: [PATCH] Revert "[SW-0] pll: override slip wd counter"

This reverts commit 6399c77e5a71ac2cb954ac695f3536ed6b7c94b6.

Change-Id: Ibf39702c704b5868392e35ea70ac3683f3832866
---

diff --git a/common/pll.c b/common/pll.c
index 977a490..a4f1dba 100644
--- a/common/pll.c
+++ b/common/pll.c
@@ -79,9 +79,6 @@
 
 	hl_pll_reset(cfg, false);
 
-	/* configure to raise interrupt after X unlocked cycles */
-	regmap_writel(0x1, cfg->base + HL_PLL_SLIP_WD_CNTR);
-
 	/* Wait >500 (10us) reference cycles until PLL re-locks. */
 	hl_pll_udelay(HL_PLL_MAX_WAIT_TIME);
 
diff --git a/common/pll.h b/common/pll.h
index 17221a5..15c74c7 100644
--- a/common/pll.h
+++ b/common/pll.h
@@ -17,7 +17,6 @@
 #define HL_PLL_LOCK_INTR	0x128
 #define HL_PLL_DATA_CHNG	0x130
 #define HL_PLL_RST		0x134
-#define HL_PLL_SLIP_WD_CNTR	0x150
 #define HL_PLL_DIV_FACTOR	0x200
 #define HL_PLL_DIV_FACTOR_CMD	0x220
 #define HL_PLL_DIV_SEL		0x280
