-
-uint32_t security_key_soc_location_offset(uint32_t hash_key_index)
-{
-	uint32_t ret;
-	uint8_t key_soc_base_index;
-	uint8_t key_soc_location_index;
-	uint32_t key_soc_location[] = {
-		mmPSOC_SECURITY_HABANA_KEY_0,
-		mmPSOC_SECURITY_PUBLIC_KEY_0_0,
-		mmPSOC_SECURITY_PUBLIC_KEY_1_0,
-		mmPSOC_SECURITY_PUBLIC_KEY_2_0,
-		mmPSOC_SECURITY_PUBLIC_KEY_3_0
-	};
-
-	/* select which index to choose (haban, customer 0-4) */
-	key_soc_base_index = hash_key_index / SECURITY_DWORD_PER_KEY;
-	/* key is 256bit, 32bit * 8... which of the 8 location is requested */
-	key_soc_location_index = hash_key_index % SECURITY_DWORD_PER_KEY;
-
-	/* get base address of selected key index */
-	ret = key_soc_location[key_soc_base_index];
-	/* add to base address of key the spicifice location of currect DWORD */
-	ret += (key_soc_location_index * sizeof(uint32_t));
-	return ret;
-}
-
-void security_load_keys(void)
-{
-	uint8_t hash_key_index;
-	uint32_t key_hash[SECURITY_KEY_HASH_ARRAY_SIZE];
-	enum security_location key_location;
-
-	key_location = ((arcboot_rom_global.config_fuse >>
-			EFUSE_SYSCFG_KEY_LOCATION) &
-			EFUSE_SYSCFG_KEY_LOCATION_MASK);
-
-	arcboot_rom_status_update(PROGRESS_KEY_LOC);
-	arcboot_rom_status_update_location(PROGRESS_KEY_LOC_0, key_location);
-
-	switch (key_location) {
-	case SPI_FLASH:
-		spi_flash_get_hash(key_hash);
-		break;
-	case SPI_OTP:
-		spi_flash_otp_access(FLASH_OTP_ENABLE);
-		spi_flash_otp_get_hash(key_hash);
-		spi_flash_otp_access(FLASH_OTP_DISABLE);
-		break;
-	case ASIC_EFUSE:
-	default:
-		efuse_get_hash(key_hash);
-		break;
-	}
-
-	for (hash_key_index = 0; hash_key_index < SECURITY_KEY_HASH_ARRAY_SIZE;
-	     hash_key_index++) {
-		/* store habana key hash in PSOC_SECURITY */
-		regmap_writel(key_hash[hash_key_index],
-			      security_key_soc_location_offset(hash_key_index));
-		/* store key hashes in Scratch PAD Sram */
-		sp_sram_writel(key_hash[hash_key_index],
-			       SECURITY_EFUSE_KEYS_OFFSET + (hash_key_index *
-			       SECURITY_BYTE_PER_DWORD));
-	}
-}
-
-void check_and_enable_4b_termination(void)
-{
-	uint32_t spare0;
-	/*
-	 * check and enable 4B termination
-	 * set bit[1] of mmPCIE_WRAP_SPECIAL_GLBL_SPARE_0 register
-	 * to enable LBW 4B termination.
-	 */
-	if (arcboot_rom_global.config_fuse &
-				EFUSE_SYSCFG_ENABLE_4B_TERMINATION) {
-
-		spare0 = regmap_readl(mmPCIE_WRAP_SPECIAL_GLBL_SPARE_0);
-		spare0 |= BIT(1);
-		regmap_writel(spare0, mmPCIE_WRAP_SPECIAL_GLBL_SPARE_0);
-	}
-}
-
-void security_handle_twi(void)
-{
-	if (arcboot_rom_global.config_fuse & EFUSE_SYSCFG_DISABLE_TWI_IF_MASK)
-		security_disable_twi_if();
-}
-
-void security_disable_jtag_if(void)
-{
-	regmap_writel(0, mmPSOC_CS_TRACE_TOP_ROM_VALID_0);
-	regmap_writel(0, mmPSOC_CS_TRACE_TOP_ROM_VALID_1);
-	security_jtag_dap(SECURITY_JTAG_DAP_DISABLE);
-	security_disable_jtag_mstr_if();
-}
-
-void security_enable_jtag_if(void)
-{
-	regmap_writel(0xFFFFFFFF, mmPSOC_CS_TRACE_TOP_ROM_VALID_0);
-	regmap_writel(0xFFFFFFFF, mmPSOC_CS_TRACE_TOP_ROM_VALID_1);
-	security_jtag_dap(SECURITY_JTAG_DAP_ENABLE);
-	security_enable_jtag_mstr_if();
-}
