+/* TODO: get newly added key addresses from global specs once it is updated */
+#define mmD0_PSOC_SECURITY_PUBLIC_KEY_3_0		0xC494190
+#define mmD0_PSOC_SECURITY_PUBLIC_KEY_4_0		0xC4941C0
+static void security_store_keys_in_psoc(uint8_t max_keys, uint32_t *hash)
+{
+	uint8_t key_idx, dword;
+	uint32_t key_soc_location_base;
+	uint32_t key_address[] = {
+		mmD0_PSOC_SECURITY_PUBLIC_KEY_0_0,
+		mmD0_PSOC_SECURITY_PUBLIC_KEY_1_0,
+		mmD0_PSOC_SECURITY_PUBLIC_KEY_2_0,
+		mmD0_PSOC_SECURITY_PUBLIC_KEY_3_0,
+		mmD0_PSOC_SECURITY_PUBLIC_KEY_4_0
+	};
+
+	for (key_idx = 0; key_idx < max_keys; key_idx++) {
+		key_soc_location_base = key_address[key_idx];
+		for (dword = 0; dword < SECURITY_DWORD_PER_KEY; dword++) {
+			regmap_writel(hash[(key_idx * SECURITY_DWORD_PER_KEY) + dword],
+					key_soc_location_base);
+			key_soc_location_base += sizeof(uint32_t);
+		}
+	}
+}
+
+void security_load_keys(void)
+{
+	uint8_t hash_key_index, num_dwords, max_keys = NUM_KEYS_IN_ROM;
+	uint32_t key_hash[NUM_KEYS_IN_ROM * SECURITY_DWORD_PER_KEY];
+	enum security_key_location key_location;
+
+	key_location = ((arcboot_rom_global.config_fuse >>
+			EFUSE_SYSCFG_KEY_LOCATION) &
+			EFUSE_SYSCFG_KEY_LOCATION_MASK);
+
+	arcboot_rom_status_update(PROGRESS_KEY_LOC);
+	arcboot_rom_status_update_location(PROGRESS_KEY_LOC_0, key_location);
+
+	switch (key_location) {
+	case KEY_LOCATION_EFUSE:
+		max_keys = NUM_KEYS_IN_EFUSE;
+		efuse_get_hash(key_hash);
+		break;
+	case KEY_LOCATION_ROM:
+	default:
+		security_rom_get_hash(key_hash);
+		break;
+	}
+
+	/* store hashes in the limited space available in PSOC_SECURITY */
+	security_store_keys_in_psoc(max_keys, key_hash);
+
+	/* Store key hashes in SPSRAM */
+	num_dwords = max_keys * SECURITY_DWORD_PER_KEY;
+	for (hash_key_index = 0; hash_key_index < num_dwords;
+					hash_key_index++)
+		sp_sram_writel(key_hash[hash_key_index],
+			   SECURITY_EFUSE_KEYS_OFFSET + (hash_key_index *
+			   SECURITY_BYTE_PER_DWORD));
+}
+
+void security_load_revoke_bits(void)
+{
+	uint32_t key_revoke = 0;
+	enum security_location revoke_location;
+
+	revoke_location = ((arcboot_rom_global.config_fuse >>
+			   EFUSE_SYSCFG_REVOKATION_LOCATION) &
+			   EFUSE_SYSCFG_REVOKATION_LOCATION_MASK);
+
+	arcboot_rom_status_update(PROGRESS_REVOKE_LOC);
+	arcboot_rom_status_update_location(PROGRESS_REVOKE_LOC_0,
+					   revoke_location);
+
+	switch (revoke_location) {
+	/* TODO: Add other locations if required for gaudi3 */
+	/* TODO: Confirm enumeration values for gaudi3 */
+	case ASIC_EFUSE:
+		key_revoke = arcboot_rom_global.config_fuse;
+		break;
+	default:
+		return;
+	}
+	key_revoke &= EFUSE_SYSCFG_REVOKE_KEY_MASK;
+
+	/* store key_revoke map in PSOC */
+	regmap_writel(key_revoke, mmSECURITY_KEY_REVOKE);
+
+	/* store key hashes in Scratch PAD Sram */
+	sp_sram_writel(key_revoke,
+		       SECURITY_EFUSE_KEYS_REVOKE_OFFSET);
+}
+
+void security_load_fw_version(void)
+{
+	uint8_t fw_version_sec = 0;
+	enum security_location fw_version_location;
+
+	fw_version_location = ((arcboot_rom_global.config_fuse >>
+			       EFUSE_SYSCFG_FW_VERSION_LOCATION) &
+			       EFUSE_SYSCFG_FW_VERSION_LOCATION_MASK);
+
+	arcboot_rom_status_update(PROGRESS_VER_LOC);
+	arcboot_rom_status_update_location(PROGRESS_VER_LOC_0,
+					   fw_version_location);
+
+	switch (fw_version_location) {
+	/* TODO: Add other locations if required for gaudi3 */
+	/* TODO: Confirm enumeration values for gaudi3 */
+	case ASIC_EFUSE:
+		fw_version_sec = efuse_otp_get_fw_version_security();
+		break;
+	default:
+		return;
+	}
+
+	/* store minimum allowed security version in PSOC */
+	regmap_writel(SECURITY_FW_VERSION_FROM_SECURITY_BYTE(fw_version_sec),
+		      mmSECURITY_MIN_FW_VERSION);
+
+	/* store minimum allowed security version in Scratch PAD Sram */
+	sp_sram_writel(SECURITY_FW_VERSION_FROM_SECURITY_BYTE(fw_version_sec),
+		      SECURITY_EFUSE_FW_VERSION_OFFSET);
+}
+
+void security_load_sec_efuse_dword(void)
+{
+	sp_sram_writel(arcboot_rom_global.config_fuse,
+		       SECURITY_EFUSE_SYS_CFG_OFFSET);
+}
+
+int security_efuse_image_validation_en(void)
+{
+	/* check efuse for security validation enable */
+	uint32_t config_fuse = sp_sram_readl(SECURITY_EFUSE_SYS_CFG_OFFSET);
+
+	return !!(config_fuse & EFUSE_SYSCFG_ENABLE_VALIDATION_MASK);
+}
