+++ b/include/arch/common/gpu/queue_comms.h
@@ -37,14 +37,6 @@
 	struct gpu_queues_data queues_data;
 };
 
-struct jgs_queues_config {
-	/* TODO: add jgs device specific variables & data structure(s) */
-	struct gpu_queue_d2h_config d2h_resp_config;
-	struct gpu_queue_d2h_config d2h_async_config;
-	struct gpu_queue_h2d_config h2d_config;
-	struct gpu_queues_data queues_data;
-};
-
 struct gpu_queue_fifo_entry {
 	void *fifo_reserved;   /* 1st word reserved for use by FIFO */
 	struct queue_buffer_data buffer_data;
diff --git a/include/arch/jgs/app_defs.h b/include/arch/jgs/app_defs.h
index e3b4e58..916cd3a 100644
--- a/include/arch/jgs/app_defs.h
+++ b/include/arch/jgs/app_defs.h
@@ -20,7 +20,7 @@
 #include <queue_comms.h>
 
 struct mgmt_dev_data {
-	struct jgs_queues_config queues_cfg;
+	struct gpu_queues_config queues_cfg;
 };
 
 #endif /* ZEPHYR_INCLUDE_JGS_DEFS_H */
