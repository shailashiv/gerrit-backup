diff --git a/drivers/svid/CMakeLists.txt b/drivers/svid/CMakeLists.txt
new file mode 100644
index 0000000..c5ba9f6
--- /dev/null
+++ b/drivers/svid/CMakeLists.txt
@@ -0,0 +1,7 @@
+# SPDX-License-Identifier: Apache-2.0
+
+zephyr_syscall_header(${ZEPHYR_BASE}/include/zephyr/drivers/svid/svid.h)
+
+zephyr_library()
+
+zephyr_library_sources_ifdef(CONFIG_SVID svid_intel.c)
\ No newline at end of file
diff --git a/drivers/svid/Kconfig b/drivers/svid/Kconfig
new file mode 100644
index 0000000..ef74246
--- /dev/null
+++ b/drivers/svid/Kconfig
@@ -0,0 +1,16 @@
+# Copyright (c) 2025 Intel Corporation
+# SPDX-License-Identifier: Apache-2.0
+
+menuconfig SVID
+	bool "Serial Voltage Identification (SVID) drivers"
+	help
+	  Enable SVID Driver Configuration
+
+if SVID
+
+config SVID_INTEL
+	bool "Intel SVID driver"
+	help
+	  Enable SVID driver
+
+endif
\ No newline at end of file
diff --git a/drivers/svid/svid_intel.c b/drivers/svid/svid_intel.c
new file mode 100644
index 0000000..0adc63d
--- /dev/null
+++ b/drivers/svid/svid_intel.c
@@ -0,0 +1,48 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2016-2025 Intel, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <zephyr/types.h>
+#include <zephyr/kernel.h>
+#include <zephyr/device.h>
+
+#include <zephyr/drivers/svid/svid.h>
+
+#define DT_DRV_COMPAT intel_svid
+
+#define LOG_LEVEL CONFIG_SVID_LOG_LEVEL
+
+#include <zephyr/logging/log.h>
+LOG_MODULE_REGISTER(svid);
+
+#include "svid_intel.h"
+
+typedef int (*svid_api_configure_t)(const struct device *dev, uint32_t dev_config);
+
+struct svid_driver_api {
+	svid_api_configure_t configure;
+};
+
+int svid_configure(const struct device *dev, uint32_t config)
+{
+	return 0;
+};
+
+const struct svid_driver_api funcs = {
+	.configure = svid_configure,
+};
+
+int svid_init(const struct device *dev)
+{
+	LOG_INF("SVID Initialized");
+	return 0;
+};
+
+#define SVID_DRIVER_INIT(inst) \
+	DEVICE_DT_INST_DEFINE(inst, svid_init, NULL, NULL, NULL,  \
+	POST_KERNEL, CONFIG_KERNEL_INIT_PRIORITY_DEFAULT, &funcs);
+
+DT_INST_FOREACH_STATUS_OKAY(SVID_DRIVER_INIT)
