+	-I$(SPECS_ROOT) \
+	-I$(SPECS_EXT_ROOT) \
+	-I$(SPECS_ROOT)/$(DEV_PREFIX)/asic_reg \
+	-I$(SPECS_H9_DIR) \
+	-I$(SPECS_H9_DIR)/$(DEV_PREFIX)/asic_reg
