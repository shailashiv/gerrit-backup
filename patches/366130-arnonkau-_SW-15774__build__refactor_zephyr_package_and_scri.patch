diff --git a/package/zephyr/gaudi2.mk b/package/zephyr/gaudi2.mk
new file mode 100644
index 0000000..bcdb2e6
--- /dev/null
+++ b/package/zephyr/gaudi2.mk
@@ -0,0 +1,11 @@
+#Buildroot is including all the makefiles for
+#the compilation of zephyr appliation Hence
+#adding additional check for gaudi3 to avoid
+#including SPECS_H9_DIR for other platforms
+
+GAUDI2_CONF_DEV_EXTRA_CFLAGS =\
+	-I$(SPECS_EMBEDDED_DIR) \
+	-I$(SPECS_EMBEDDED_DIR)/$(DEV_PREFIX) \
+	-I$(SPECS_ROOT) \
+	-I$(SPECS_EXT_ROOT) \
+	-I$(SPECS_ROOT)/$(DEV_PREFIX)/asic_reg
