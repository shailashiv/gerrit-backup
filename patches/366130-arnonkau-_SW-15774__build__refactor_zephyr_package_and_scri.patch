-DEVICE_NAME = $(firstword $(subst _, ,$(HL_DEV)))
-
-# zephyr uses west tool to perform repo management, installation
-# of the tools used for zephyr compilation. For our zephyr
-# compilation, we do not make use of west tool.
-# If west is installed on build machine, it looks for configuration
-# file and throws error if it doesn't find one. To solve this issue,
-# create dummy configuration file in .west folder relative to zephyr
-# build directory.
-ZEPHYR_WEST_SRC_FILE_PATH = $(BR2_EXTERNAL_HABANALABS_PATH)/package/zephyr
-ZEPHYR_WEST_DEST_DIR_PATH = $(BR2_EXTERNAL_HABANALABS_PATH)/output/$(HL_DEV)/build/.west
-
-ZEPHYR_LOCAL_VERSION = $$(sed "s/^.*fw-\\([0-9]\\+\\.[0-9]\\+\\.[0-9]\\+\\).*$$/\\1/" $(ZEPHYR_BUILDDIR)/localversion-habanalabs)
-
-ZEPHYR_CONFIGURE_CMDS = $(INSTALL) -D -m 0755 $(ZEPHYR_WEST_SRC_FILE_PATH)/west.config $(ZEPHYR_WEST_DEST_DIR_PATH)/config ; cd $(ZEPHYR_BUILDDIR) ;
-ZEPHYR_CONFIGURE_CMDS += echo "\#ifndef _HL_VERSION_" > include/hl_version.h ;
-ZEPHYR_CONFIGURE_CMDS += echo "\#define _HL_VERSION_" >> include/hl_version.h ;
-ZEPHYR_CONFIGURE_CMDS += echo "\#define HL_VERSION_MAJOR $$(echo $(ZEPHYR_LOCAL_VERSION) | cut -d. -f1)" >> $(ZEPHYR_BUILDDIR)/include/hl_version.h ;
-ZEPHYR_CONFIGURE_CMDS += echo "\#define HL_VERSION_MINOR $$(echo $(ZEPHYR_LOCAL_VERSION) | cut -d. -f2)" >> $(ZEPHYR_BUILDDIR)/include/hl_version.h ;
-ZEPHYR_CONFIGURE_CMDS += echo "\#define HL_VERSION_PATCH $$(echo $(ZEPHYR_LOCAL_VERSION) | cut -d. -f3)" >> $(ZEPHYR_BUILDDIR)/include/hl_version.h ;
-ZEPHYR_CONFIGURE_CMDS += echo "\#endif" >> include/hl_version.h
-ZEPHYR_BUILD_CMDS = true
-ZEPHYR_INSTALL_TARGET_CMDS = true
-
-ZEPHYR_COMPONENTS_LIST =
-
-# Arguments:
-# - module name
-# - component dir
-# - component name
-define DEFINE_MODULE_ENVVARS
-	$(eval MODULE_NAME=$(strip $1)) \
-	$(eval MODULE_NAME_UPPER_CASE=$(shell echo $(MODULE_NAME) | tr a-z A-Z)) \
-	$(eval MODULE_NAME_UPPER_CASE=$(strip $(MODULE_NAME_UPPER_CASE))) \
-	$(eval COMPONENT_NAME_UPPER_CASE=$(shell echo $3 | tr a-z A-Z)) \
-	$(eval COMPONENT_NAME_UPPER_CASE=$(strip $(COMPONENT_NAME_UPPER_CASE))) \
-	\
-	$(eval $(COMPONENT_NAME_UPPER_CASE)_$(MODULE_NAME_UPPER_CASE)_SRCDIR=$(EMBEDDED_DIR)/zephyr-modules/$(MODULE_NAME)) \
-	$(eval $(COMPONENT_NAME_UPPER_CASE)_$(MODULE_NAME_UPPER_CASE)_DIR=$2/modules/$(MODULE_NAME)) \
-	$(eval $(COMPONENT_NAME_UPPER_CASE)_$(MODULE_NAME_UPPER_CASE)_NAME=$3_$(MODULE_NAME))
-endef
-
-define CREATE_APP_VERSION
--DAPP_NAME=$1 \
--DAPP_VERSION=$(shell cut -d- -f2- $(ZEPHYR_BUILDDIR)/$2/localversion-habanalabs)
-endef
