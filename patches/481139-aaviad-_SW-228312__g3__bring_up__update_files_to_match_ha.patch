From 33b725336aa113c7963c1bb2454a16cc2e0e0e5a Mon Sep 17 00:00:00 2001
From: Ariel Aviad <aaviad@habana.ai>
Date: Wed, 04 Jun 2025 18:45:09 +0300
Subject: [PATCH] [SW-228312] g3: bring up: update files to match habanalabs repo

Habanalabs repo update gaudi3 bring up, this
patch update the changes to embedded specs

Change-Id: Iebf32c30e986fed662efc9a6b3a18990c7a16000
Signed-off-by: Ariel Aviad <aaviad@habana.ai>
---

diff --git a/gaudi3/bringup/gaudi3_bringup.c b/gaudi3/bringup/gaudi3_bringup.c
index 4ce6356..35fd20d 100644
--- a/gaudi3/bringup/gaudi3_bringup.c
+++ b/gaudi3/bringup/gaudi3_bringup.c
@@ -793,7 +793,6 @@
 				ROTATOR_COORD_NUM_ERR_CONTEXT_ID_COORD_M}
 };
 
-
 /**
  * gaudi3_get_spi_gw_addr - convert address to SPI GW address
  *
diff --git a/gaudi3/bringup/hbl_cn/gaudi3_cn_bringup.c b/gaudi3/bringup/hbl_cn/gaudi3_cn_bringup.c
index 200f97b..859daa4 100644
--- a/gaudi3/bringup/hbl_cn/gaudi3_cn_bringup.c
+++ b/gaudi3/bringup/hbl_cn/gaudi3_cn_bringup.c
@@ -949,7 +949,8 @@
 					  BIT(NIC_TRIGGER_LINK_SHUTDOWN) |
 					  BIT(NIC_INVALIDATE_PORT_QPS) |
 					  BIT(NIC_QP_ID_OFFSET_IN_MACRO) |
-					  BIT(NIC_FORCE_PORT_FAILURE);
+					  BIT(NIC_FORCE_PORT_FAILURE) |
+					  BIT(NIC_PHY_LOOPBACK);
 
 	hdev->debugfs_supp_mask |= gaudi3_debugfs_support_mask;
 }
