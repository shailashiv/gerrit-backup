From f92632218895f974c1ad021ac28ee97f123a2572 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Sun, 09 Jan 2022 18:48:22 +0200
Subject: [PATCH] [SW-0] gaudi2: pci: improve readability

keeping code on the same line for better readability.

Change-Id: Iabb4b50d9502fe330abe9917ecd598f0eaed710b
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/arch/gaudi2/common/common.c b/arch/gaudi2/common/common.c
index 1e858fc..e264963 100644
--- a/arch/gaudi2/common/common.c
+++ b/arch/gaudi2/common/common.c
@@ -366,8 +366,7 @@
 	       regmap_readl(mmPCIE_PHY_PHYX_SRAM_EXT_LD_DONE_2) &&
 	       regmap_readl(mmPCIE_PHY_PHYX_SRAM_EXT_LD_DONE_3))) {
 
-		if (timeout_expired(start, PCIE_EXT_LD_TIMEOUT_US) &&
-		    usr_notify) {
+		if (timeout_expired(start, PCIE_EXT_LD_TIMEOUT_US) && usr_notify) {
 			preboot_puts("ext_ld_done is low > 10mSec\n");
 			usr_notify = false;
 		}
