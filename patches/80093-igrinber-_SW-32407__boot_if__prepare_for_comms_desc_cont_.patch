From 7a72e8a28f126acf26c43661753c0fc230685b81 Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Wed, 03 Mar 2021 16:04:31 +0200
Subject: [PATCH] [SW-32407] boot_if: prepare for comms desc cont.

The communication descriptor will be added to the boot_if and will
include types from stdint.h, but it can't include the stdint.h by
itself, so we need to do this for boot_if.
Add stdint.h and a comment about its requirement.

Change-Id: I1369e12d81fae0dc880f95de3dc4d71e468eeaaa
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/goya2/common.c b/goya2/common.c
index fb8b89a..14f1702 100644
--- a/goya2/common.c
+++ b/goya2/common.c
@@ -5,6 +5,8 @@
  * SPDX-License-Identifier:     GPL-2.0+
  */
 
+#include <stdint.h>
+
 #include <psoc_gpio1_regs.h>
 #include <psoc_qspi_regs.h>
 #include <psoc_global_conf_regs.h>
@@ -23,7 +25,7 @@
 #include <psoc_arc1_cfg_regs.h>
 #include <psoc_arc1_cfg_masks.h>
 
-#include <hl_boot_if.h>
+#include <hl_boot_if.h>			/* requires stdint.h */
 #include <goya2/goya2_reg_map.h>
 #include <dcon0_tstd_masks.h>
 #include <dcon0_tstd_regs.h>
diff --git a/goya2_arc/common.c b/goya2_arc/common.c
index 646ea38..ac83edb 100644
--- a/goya2_arc/common.c
+++ b/goya2_arc/common.c
@@ -4,6 +4,8 @@
  * All Rights Reserved.
  */
 
+#include <stdint.h>
+
 #include <pcie_phy_regs.h>
 #include <psoc_global_conf_regs.h>
 #include <psoc_gpio1_regs.h>
@@ -17,7 +19,7 @@
 #include <cpu_ca53_cfg_regs.h>
 #include <cpu_timestamp_regs.h>
 
-#include <hl_boot_if.h>
+#include <hl_boot_if.h>			/* requires stdint.h */
 #include <goya2/goya2_reg_map.h>
 #include <common/pci_ids.h>
 #include <arcboot_export.h>
diff --git a/goya2_arc_gnu/common.c b/goya2_arc_gnu/common.c
index a63d749..35ba074 100644
--- a/goya2_arc_gnu/common.c
+++ b/goya2_arc_gnu/common.c
@@ -5,6 +5,8 @@
  * SPDX-License-Identifier:     GPL-2.0+
  */
 
+#include <stdint.h>
+
 #include <pcie_phy_regs.h>
 #include <psoc_global_conf_regs.h>
 #include <psoc_gpio1_regs.h>
@@ -21,7 +23,7 @@
 
 #include <cpu_timestamp_regs.h>
 
-#include <hl_boot_if.h>
+#include <hl_boot_if.h>			/* requires stdint.h */
 #include <goya2/goya2_reg_map.h>
 #include <common/pci_ids.h>
 #include <goya2_blocks_linux_driver.h>
