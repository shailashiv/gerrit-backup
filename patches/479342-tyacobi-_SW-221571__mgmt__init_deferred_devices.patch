From fd93e4c455e9b4a1f954524449b8ff36e5a8c6b3 Mon Sep 17 00:00:00 2001
From: Tal Yacobi <tyacobi@habana.ai>
Date: Tue, 13 May 2025 11:18:44 +0300
Subject: [PATCH] [SW-221571] mgmt: init deferred devices

Some devices are not supported in pcie card type
(e.g., in HL-338).

Check which of these devices are supported
and init them on runtime.

Change-Id: I4b5813ff9d940cca2177eb91484f3fce64bf53ad
Signed-off-by: Tal Yacobi <tyacobi@habana.ai>
---

diff --git a/app/io/mgmt.c b/app/io/mgmt.c
index d1130e4..4cfbf01 100644
--- a/app/io/mgmt.c
+++ b/app/io/mgmt.c
@@ -318,6 +318,26 @@
 	EMPTY_WEAK_FUNC(void hl_rtr_ctrl_init_rl_reg_once(void),)
 #endif
 
+static void hl_mgmt_device_drivers_deferred_init(void)
+{
+	DEVICE_INIT_IF_EXIST(sfp, QSFP_LED_DEV);
+	DEVICE_INIT_IF_EXIST(sfp, QSFP1_DEV);
+	DEVICE_INIT_IF_EXIST(sfp, QSFP2_DEV);
+	DEVICE_INIT_IF_EXIST(adc121c027, ADC121C027_DEV);
+	DEVICE_INIT_IF_EXIST(mp2891, MP2891_DEV);
+	DEVICE_INIT_IF_EXIST(tmp464, TMP464_DEV);
+	DEVICE_INIT_IF_EXIST(tmp464, TMP464_0_DEV);
+	DEVICE_INIT_IF_EXIST(tmp464, TMP464_1_DEV);
+	DEVICE_INIT_IF_EXIST(xdpe, XDPE132G5H_DEV);
+	DEVICE_INIT_IF_EXIST(xdpe, XDPE132G5H_0_DEV);
+	DEVICE_INIT_IF_EXIST(xdpe, XDPE132G5H_1_DEV);
+	DEVICE_INIT_IF_EXIST(xdpe, XDPE132G5H_2_DEV);
+	DEVICE_INIT_IF_EXIST(xdpp1100, XDPP1100_DEV);
+	DEVICE_INIT_IF_EXIST(tmp432, TMP432_DEV(0));
+	DEVICE_INIT_IF_EXIST(tmp432, TMP432_DEV(1));
+	DEVICE_INIT_IF_EXIST(ina236_0, INA236_DEV(0));
+}
+
 void main(void)
 {
 	int32_t ret;
@@ -328,6 +348,8 @@
 
 	print_header();
 
+	hl_mgmt_device_drivers_deferred_init();
+
 	memset(&dev_config, 0, sizeof(dev_config));
 
 	start_lfs_logger();
