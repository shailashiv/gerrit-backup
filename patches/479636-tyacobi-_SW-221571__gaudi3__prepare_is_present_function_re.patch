From affb677ec20e8eb1b480bca6a2016d3ff415ca40 Mon Sep 17 00:00:00 2001
From: Tal Yacobi <tyacobi@habana.ai>
Date: Tue, 13 May 2025 11:04:54 +0300
Subject: [PATCH] [SW-221571] gaudi3: prepare is present function refactor

Prepare refactoring of hl_is_ina236_present
to be the same as the other is_<device>_present functions

Change-Id: Ia49c252ddb79c4a9c3316a1d86aabaf5a5366b91
Signed-off-by: Tal Yacobi <tyacobi@habana.ai>
---

diff --git a/arch/gaudi3/sensors.c b/arch/gaudi3/sensors.c
index a52a63a..2d18a69 100644
--- a/arch/gaudi3/sensors.c
+++ b/arch/gaudi3/sensors.c
@@ -157,9 +157,7 @@
 
 static bool hl_ina236_valid(uint32_t idx)
 {
-	uint16_t addr = (idx) ? INA236_3V3_ADDR : INA236_12V_ADDR;
-
-	return hl_is_ina236_present(addr);
+	return idx == 0 ? !hl_is_card_type_pcie() : true;
 }
 
 static void hl_volt_asc10_compute(struct sensor_value *value, uint16_t sensor_idx)
