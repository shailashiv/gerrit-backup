From e1e1a220ebf1340836d7a2989564221f4f804e0f Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Tue, 30 Apr 2019 18:04:52 +0300
Subject: [PATCH] [SW-4177] gaudi: uart/sf: calculate baud rate

Add dynamic baud rate calculation based on the settings in effect
(read from H/W) for both UART and the SPI flash.

Change-Id: Ib7db6f7f3dcf18088821e295e296d5b1bfce23c8
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/common/preboot.h b/common/preboot.h
index 236e0ed..b041bde 100644
--- a/common/preboot.h
+++ b/common/preboot.h
@@ -16,6 +16,9 @@
 #define SDRAM_BASE				0x7ff0000000ull
 #define SPL_TEXT_BASE				0x7ff0080000ull
 
+#define HL_UART_BAUDRATE	115200
+#define HL_SPI_FLASH_MAX_FREQ	25000000
+
 typedef unsigned char u8;
 typedef unsigned int u32;
 typedef unsigned long long u64;
diff --git a/gaudi/gaudi.c b/gaudi/gaudi.c
index 3fa484a..47ec761 100644
--- a/gaudi/gaudi.c
+++ b/gaudi/gaudi.c
@@ -165,12 +165,19 @@
 
 void hl_uart_init(void)
 {
-	preboot_uart_init(UART_BAUDDIV);
+	u32 pcie_div2_freq = hl_pll_get_freq(mmPSOC_PCI_PLL_BASE, HL_PLL_DIV2);
+
+	preboot_uart_init(pcie_div2_freq / HL_UART_BAUDRATE);
 }
 
 u32 hl_spi_baudr_get(void)
 {
-	return SPI_BAUDR;
+	u32 factor;
+	u32 pcie_div2_freq = hl_pll_get_freq(mmPSOC_PCI_PLL_BASE, HL_PLL_DIV2);
+
+	factor = pcie_div2_freq / HL_SPI_FLASH_MAX_FREQ;
+
+	return factor > 2 ? factor : 2;
 }
 
 int hl_pll_partial_init_get(void)
diff --git a/gaudi/gaudi.h b/gaudi/gaudi.h
index 8d13e8c..0874123 100644
--- a/gaudi/gaudi.h
+++ b/gaudi/gaudi.h
@@ -26,7 +26,3 @@
 #define mmNIC2_HBM_PLL_BASE		0xD78000
 #define mmNIC2_MME_PLL_BASE		0xD79000
 #define mmNIC2_TPC_PLL_BASE		0xD7A000
-
-#define PCI_DIV2_CLOCK			(830000000 / 5)
-#define UART_BAUDDIV			(PCI_DIV2_CLOCK / 115200)
-#define SPI_BAUDR			(PCI_DIV2_CLOCK / 25000000)
