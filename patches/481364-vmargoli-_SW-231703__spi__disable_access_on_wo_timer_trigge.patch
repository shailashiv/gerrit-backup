-
-		return 0;
-	}
-
-	/*
-	 * by design there are some unbalanced 'access enable' calls, like for example in
-	 * preboot LKD module and FWUPD module.
-	 */
-	if (!driver_data->access_disabled) {
-		LOG_DBG("Access to flash already enabled");
-		return 0;
-	}
-
-	driver_data->access_disabled = false;
-	release_device(dev);
