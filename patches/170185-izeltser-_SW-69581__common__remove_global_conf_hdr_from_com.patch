diff --git a/include/device.h b/include/device.h
index fac2299..0433699 100644
--- a/include/device.h
+++ b/include/device.h
@@ -60,12 +60,32 @@
 	u32 rxflr_reg;
 };
 
+struct device_global_conf {
+	u32 prstn_reg;
+	u32 kmd_msg_to_cpu_reg;
+	u32 i2c_slv_reg;
+	u32 i2c_slv_intr_mask_reg;
+	u32 cpu_boot_status_reg;
+	u32 cpu_cmd_status_to_host_map;
+	u32 cpu_boot_err0_map;
+	u32 cpu_boot_err1_map;
+	u32 cpu_boot_dev_sts0_map;
+	u32 cpu_boot_dev_sts1_map;
+	u32 upd_pending_sts_map;
+	u32 upd_cmd_map;
+	u32 upd_sts_map;
+	u32 preboot_ver_off_map;
+	u32 mmfuse_ver_off_map;
+};
+
 extern struct device_efuse efuse;
 extern struct device_uart uart;
 extern struct device_pci pci;
 extern struct device_i2c_s i2c_s;
+extern struct device_global_conf global_conf;
 
 void device_init_efuse(void);
 void device_init_uart(void);
 void device_init_pci(void);
 void device_init_i2c_s(void);
+void device_init_global_conf(void);
