diff --git a/ppboot/ppboot.c b/ppboot/ppboot.c
index 6f84dab..15a1c9b 100644
--- a/ppboot/ppboot.c
+++ b/ppboot/ppboot.c
@@ -167,10 +167,6 @@
 	ppboot_version();
 	rst_src_dump();
 
-	/* check if we are done here */
