 void image_start(u64 loadaddr)
diff --git a/goya2/common.c b/goya2/common.c
index e216bb7..07cc248 100644
--- a/goya2/common.c
+++ b/goya2/common.c
@@ -201,11 +201,6 @@
 		;
 }
 
-int hl_pcie_init_only(void)
-{
-	return 0;
-}
-
