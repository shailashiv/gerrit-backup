@@ -205,11 +205,6 @@
 		;
 }
 
-int hl_pcie_init_only(void)
-{
-	return 0;
-}
-
 void hl_plat_init(void) {}
 
 
diff --git a/goya/common.c b/goya/common.c
index 13b862f..dc783f4 100644
--- a/goya/common.c
+++ b/goya/common.c
@@ -161,11 +161,6 @@
 
