From 0d50feb2dc9f7b1ad7635ee2243ec4073f7088db Mon Sep 17 00:00:00 2001
From: ran shalit <rshalit@habana.ai>
Date: Thu, 02 Dec 2021 21:07:50 +0200
Subject: [PATCH] [SW-36213] preboot: change header order

Change header order because of __packed type.

Change-Id: Id15c2ae59f186f23730afd32cb3d29ae7f4a1cb0
Signed-off-by: ran shalit <rshalit@habana.ai>
---

diff --git a/arch/gaudi/arm/rma_info.c b/arch/gaudi/arm/rma_info.c
index d052892..9a9cd2a 100644
--- a/arch/gaudi/arm/rma_info.c
+++ b/arch/gaudi/arm/rma_info.c
@@ -8,7 +8,6 @@
 #include <common.h>
 #include <sha256.h>
 #include <spi_flash.h>
-#include <hl_boot_desc.h>
 #include <string.h>
 #include "uart.h"
 #include "boot_if.h"
@@ -18,6 +17,8 @@
 #include "hl_i2c_slave_events.h"
 #include "i2cslave_indirect.h"
 #include "sha.h"
+#include <preboot.h>
+#include <hl_boot_desc.h> /* requires preboot.h for __packed */
 
 #define ROUND_UP4(n)	(((n) + sizeof(u32) - 1) & ~(sizeof(u32) - 1))
 #define RMA_HEADER_ENTRY_SIZE		sizeof(struct rma_entry)
diff --git a/lib/preboot/fit.c b/lib/preboot/fit.c
index f6d8187..be998a5 100644
--- a/lib/preboot/fit.c
+++ b/lib/preboot/fit.c
@@ -10,8 +10,8 @@
 #include <bitops.h>
 #include <security.h>
 #include <hl_boot_if.h>
-#include <hl_boot_desc.h>
 #include <preboot.h>
+#include <hl_boot_desc.h> /* requires preboot.h for __packed */
 #include <boot_if.h>
 #include <fit_load_type.h>
 #include <boot_info.h>
