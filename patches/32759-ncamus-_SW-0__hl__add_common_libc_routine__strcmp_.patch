From f2a94605d6ae5401c7edf2743b9031f5e4b705a2 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Fri, 17 Apr 2020 15:26:51 +0300
Subject: [PATCH] [SW-0] hl: add common libc routine (strcmp)

Introduced explicitly in code and otherwise break compilation

Change-Id: Ic324f09f5533b906dd467fe5ddd8837d661afe5a
---

diff --git a/common/string.c b/common/string.c
index a3107ec..e69575e 100644
--- a/common/string.c
+++ b/common/string.c
@@ -124,6 +124,23 @@
 }
 
 /**
+ * strcmp - Compare two strings
+ * @cs: One string
+ * @ct: Another string
+ */
+int strcmp(const char * cs,const char * ct)
+{
+	register signed char __res;
+
+	while (1) {
+		if ((__res = *cs - *ct++) != 0 || !*cs++)
+			break;
+	}
+
+	return __res;
+}
+
+/**
  * strlen - Find the length of a string
  * @s: The string to be sized
  */
