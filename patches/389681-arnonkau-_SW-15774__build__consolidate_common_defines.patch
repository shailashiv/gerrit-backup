From 827c5a6b24d18e5b5089628087066a28a52fbaf4 Mon Sep 17 00:00:00 2001
From: Arnon Kaufman <akaufman@habana.ai>
Date: Tue, 14 Nov 2023 13:06:20 +0200
Subject: [PATCH] [SW-15774] build: consolidate common defines

Create a common file under the zephyr package for holding the common
configuration.

Signed-off-by: Arnon Kaufman <akaufman@habana.ai>
Change-Id: I44d299b1f3e53b272366f59aec03300b69d56279
---

diff --git a/package/agent-fwl/agent-fwl.mk b/package/agent-fwl/agent-fwl.mk
index 45be4a4..921b44a 100644
--- a/package/agent-fwl/agent-fwl.mk
+++ b/package/agent-fwl/agent-fwl.mk
@@ -14,9 +14,9 @@
 
 AGENT_FWL_CONF_APP_EXTRA_CFLAGS = \
 		-include $(EMBEDDED_ROOT)/specs/$(AGENT_FWL_DEVICE_NAME)/$(AGENT_FWL_DEVICE_NAME)_boot_info.h \
-		$($(call UPPERCASE,$(DEV_PREFIX))_CONF_DEV_EXTRA_CFLAGS) \
+		$(CONF_DEV_EXTRA_CFLAGS) \
+		$(COMMON_CONF_EXTRA_CFLAGS) \
 		$(ZEPHYR_CONF_DEV_EXTRA_CFLAGS)
-
 
 AGENT_FWL_CONF_APP_CFLAGS = \
 		-I$(AGENT_FWL_SRC_DIR)/../common/include \
@@ -46,13 +46,14 @@
 AGENT_FWL_CONF_OPTS += -DEXTRA_CFLAGS="\
 		-Werror \
 		-Wno-misleading-indentation \
-		$($(call UPPERCASE,$(DEV_PREFIX))_CONF_DEV_EXTRA_CFLAGS) \
+		$(CONF_DEV_EXTRA_CFLAGS) \
 		$(AGENT_FWL_CONF_APP_EXTRA_CFLAGS)"
 
 AGENT_FWL_CONF_OPTS += -DFAKE_SECURITY=$(FAKE_SECURITY)
 AGENT_FWL_CONF_OPTS += -DBUILD_VERSION="$(AGENT_FWL_APP_VERSION)"
 AGENT_FWL_CONF_OPTS += -DBUILD_MACHINE="$(shell hostname -s)"
 AGENT_FWL_CONF_OPTS += -DCMAKE_C_FLAGS="\
+		$(CONF_DEV_EXTRA_CFLAGS) \
 		$(AGENT_FWL_CONF_APP_CFLAGS)"
 
 AGENT_FWL_CONF_OPTS += -DDTS_EXTRA_CPPFLAGS="-I$(SPECS_EMBEDDED_DIR)"
