diff --git a/package/event/event.mk b/package/event/event.mk
index a3332ed..6ca1760 100644
--- a/package/event/event.mk
+++ b/package/event/event.mk
@@ -13,21 +13,13 @@
 EVENT_ZEPHYR_BUILD_DIR ?= $(@D)/zephyr
 
 EVENT_CONF_CFLAGS =\
-		-I$(EVENT_ZEPHYR_BUILD_DIR) \
-		-I$(EVENT_ZEPHYR_BUILD_DIR)/include \
-		-I$(EVENT_ZEPHYR_BUILD_DIR)/include/drivers/misc/hl_npu \
-		-I$(EVENT_ZEPHYR_BUILD_DIR)/include/drivers/misc/hl_npu/$(HL_DEV) \
-		-I$(EVENT_ZEPHYR_BUILD_DIR)/include/drivers/misc/hl_npu/common \
-		-I$(EVENT_ZEPHYR_BUILD_DIR)/drivers/misc/hl_npu \
-		-I$(EVENT_ZEPHYR_BUILD_DIR)/drivers/misc/hl_npu/$(HL_DEV) \
-		-I$(EVENT_ZEPHYR_BUILD_DIR)/drivers/misc/hl_npu/common \
-		-I$(EVENT_ZEPHYR_BUILD_DIR)/include/generated \
-		-I$(EVENT_ZEPHYR_BUILD_DIR)/include/generated/syscalls \
+		$(COMMON_DRV_CONF_CFLAGS) \
 		$(ZEPHYR_CONF_DEV_EXTRA_CFLAGS)
 
 EVENT_CONF_EXTRA_CFLAGS = \
 		-include $(EMBEDDED_ROOT)/specs/$(EVENT_DEVICE_NAME)/$(EVENT_DEVICE_NAME)_boot_info.h \
 		$(CONF_DEV_EXTRA_CFLAGS) \
+		$(COMMON_CONF_EXTRA_CFLAGS) \
 		$(ZEPHYR_CONF_DEV_EXTRA_CFLAGS)
 
 EVENT_CONF_ENV = CROSS_COMPILE=$(TARGET_CROSS)
