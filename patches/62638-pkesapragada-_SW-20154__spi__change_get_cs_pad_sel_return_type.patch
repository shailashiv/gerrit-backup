index 1cc3979..1a16d18 100644
--- a/goya/common.c
+++ b/goya/common.c
@@ -181,7 +181,7 @@
 	regmap_writel(1, mmPCIE_DB_RSV_RSV_1);
 }
 
-u32 get_cs_pad_sel(void)
+unsigned int get_cs_pad_sel(void)
 {
 	return mmPSOC_GLOBAL_CONF_PAD_SEL_53;
 }
