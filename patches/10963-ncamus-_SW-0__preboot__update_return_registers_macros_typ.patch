From 0cfd5090e329139ee7cb447f9ffe88da9a88a3af Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Sun, 07 Apr 2019 15:23:50 +0300
Subject: [PATCH] [SW-0] preboot: update return registers macros type

It is simple u64 and not a pointer this avoids redundand casting
Also make it cleaner for use with io operations (readl/writel)

Change-Id: I0918ed3af2d6022df7288a724e2dc45f8d6fcb74
---

diff --git a/common/preboot.h b/common/preboot.h
index 9df3002..47da923 100644
--- a/common/preboot.h
+++ b/common/preboot.h
@@ -8,6 +8,6 @@
 #ifndef COMMON_PREBOOT_H_
 #define COMMON_PREBOOT_H_
 
-unsigned int *get_cpu_boot_status_reg(void);
+u64 get_cpu_boot_status_reg(void);
 
 #endif /* COMMON_PREBOOT_H_ */
diff --git a/common/spi.c b/common/spi.c
index fd9cddd..d4408d3 100644
--- a/common/spi.c
+++ b/common/spi.c
@@ -64,7 +64,7 @@
 
 static void spi_claim_bus(void)
 {
-	static u32 *reg;
+	static u64 reg;
 
 	if (!reg)
 		reg = get_cs_pad_sel();
@@ -74,7 +74,7 @@
 
 static void spi_release_bus(void)
 {
-	static u32 *reg;
+	static u64 reg;
 
 	if (!reg)
 		reg = get_cs_pad_sel();
diff --git a/common/spi.h b/common/spi.h
index a465f1e..7e39071 100644
--- a/common/spi.h
+++ b/common/spi.h
@@ -10,6 +10,6 @@
 
 
 void spi_copy_spl(unsigned int spl_offset);
-unsigned int *get_cs_pad_sel(void);
+u64 get_cs_pad_sel(void);
 
 #endif /* _HL_SPI_H_ */
diff --git a/gaudi/gaudi.c b/gaudi/gaudi.c
index ae55ba5..cabee12 100644
--- a/gaudi/gaudi.c
+++ b/gaudi/gaudi.c
@@ -21,13 +21,13 @@
 	}
 }
 
-unsigned int *get_cs_pad_sel(void)
+u64 get_cs_pad_sel(void)
 {
-	return (unsigned int *)mmPSOC_GLOBAL_CONF_PAD_SEL_53;
+	return mmPSOC_GLOBAL_CONF_PAD_SEL_53;
 }
 
 #define mmPSOC_GLOBAL_CONF_CPU_BOOT_STATUS	(HL_CFG_BASE + 0xC4B300)
-unsigned int *get_cpu_boot_status_reg(void)
+u64 get_cpu_boot_status_reg(void)
 {
-	return (unsigned int *)mmPSOC_GLOBAL_CONF_CPU_BOOT_STATUS;
+	return mmPSOC_GLOBAL_CONF_CPU_BOOT_STATUS;
 }
diff --git a/goya/goya.c b/goya/goya.c
index e423312..9cd60296 100644
--- a/goya/goya.c
+++ b/goya/goya.c
@@ -149,12 +149,12 @@
 	writel(1, mmPCIE_DB_RSV_RSV_1);
 }
 
-unsigned int *get_cs_pad_sel(void)
+u64 get_cs_pad_sel(void)
 {
-	return (unsigned int *)mmPSOC_GLOBAL_CONF_PAD_SEL_53;
+	return mmPSOC_GLOBAL_CONF_PAD_SEL_53;
 }
 
-unsigned int *get_cpu_boot_status_reg(void)
+u64 get_cpu_boot_status_reg(void)
 {
-	return (unsigned int *)mmPSOC_GLOBAL_CONF_WARM_REBOOT;
+	return mmPSOC_GLOBAL_CONF_WARM_REBOOT;
 }
