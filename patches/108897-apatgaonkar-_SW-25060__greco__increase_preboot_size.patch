From 2ca6729ac4340bd8cf9ba03b69383251496a9c98 Mon Sep 17 00:00:00 2001
From: Abhishek <apatgaonkar@habana.ai>
Date: Tue, 06 Jul 2021 11:56:50 +0300
Subject: [PATCH] [SW-25060] greco: increase preboot size

Increase preboot size to accommodate more functions.

Change-Id: Ifdda547a78a6526c9b074816d41a72b89d709f06
---

diff --git a/arch/greco/common.h b/arch/greco/common.h
index 1e0e3c7..819ed3e 100644
--- a/arch/greco/common.h
+++ b/arch/greco/common.h
@@ -11,7 +11,7 @@
 #include <bitops.h>
 
 #define PPBOOT_SIZE			0x5000		/* 20KB */
-#define PREBOOT_SIZE			0x11000		/* 68KB */
+#define PREBOOT_SIZE			0x11800		/* 70KB */
 
 #define SRAM_SIZE			0x8000000	/* 128MB */
 #define HL_SP_SRAM_SIZE			0x10000
