+static void i2c_debug_mode_handling(void)
+{
+	bool debug_mode;
+
+	debug_mode = hl_is_debug_mode(HL_DEBUG_HW_I2C);
+
+	/* i2c debug mode is true and gpio is deasserted */
+	if ((debug_mode == true) &&
+		 (preboot_host_gpio_asserted() == false)) {
+
+		/*
+		 * Wait till gpio is asserted. When gpio is de-asserted
+		 * its in debug mode. when gpio is asserted fw will
+		 * read write to modules.
+		 */
+		while (!preboot_host_gpio_asserted())
+			;
+	}
+}
+
 void module_handle_cmds(struct cmd_module_ops cmd_ops[], int size)
 {
 	int i = 0, j = 0;
@@ -19,8 +39,12 @@
 		cmd_ops[j].setup();
 
 	preboot_puts("Waiting for commands...\n");
+
 	i = 0;
 	while (1) {
+
+		i2c_debug_mode_handling();
+
 		res = cmd_ops[i].check();
 		switch (res) {
 		case NOT_FOUND:
