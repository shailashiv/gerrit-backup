From 4fb5bf9d1ee88ae112901ec4f3fef262830d2d97 Mon Sep 17 00:00:00 2001
From: Avinash Kumar <avikumar@habana.ai>
Date: Mon, 07 Jun 2021 13:54:55 +0300
Subject: [PATCH] [SW-31046] greco: scl low i2c slave in debug mode

Before power-up Soc BMC assert HOST_GPIO to LOW level.
Preboot fw monitors HOST_GPIO as follows:
LOW level- Greco in debug mode. Fw will wait till
HOST_GPIO is asserted to HIGH.
HIGH level- FW will read and write to modules and
monitor HOST_GPIO level.

When user done reading/writing from Soc, he must assert
HOST_GPIO to high level. For greco host_gpio is GPIO[44].

Change-Id: I98c3aa65a252f208b67b5e80b9b5d97359f44410
Signed-off-by: Avinash Kumar <avikumar@habana.ai>
---

diff --git a/arch/greco/common.c b/arch/greco/common.c
index 732aa0c..6348b1c 100644
--- a/arch/greco/common.c
+++ b/arch/greco/common.c
@@ -12,6 +12,7 @@
 #include <psoc_global_conf_regs.h>
 #include <psoc_global_conf_masks.h>
 #include <psoc_efuse_regs.h>
+#include <psoc_gpio2_regs.h>
 #include <pcie_aux_regs.h>
 #include <pcie_core_regs.h>
 #include <pcie_wrap_regs.h>
@@ -51,6 +52,25 @@
 #define FUSE_READ_RANGE_ALL	0x3F80
 #define PCIE_LTR_DISABLE		0
 #define PCIE_CAP_HDR_NXT_OFFSET		0x1f8
+#define HOST_GPIO_I2C_DEBUG	44
+
+/* HOST_GPIO is set through mmPSOC_GPIO2, each mmPSOC_GPIO serve 16 GPIOs.*/
+bool preboot_host_gpio_asserted(void)
+{
+	u32 reg, mask;
+
+	mask = BIT(HOST_GPIO_I2C_DEBUG % 16);
+
+	/* configure as input */
+	regmap_writel(mask, mmPSOC_GPIO2_OUTENCLR);
+
+	/* clear ALT function for gpio */
+	regmap_writel(mask, mmPSOC_GPIO2_ALTFUNCCLR);
+
+	reg  = regmap_readl(mmPSOC_GPIO2_DATA);
+
+	return reg & mask;
+}
 
 u32 get_efuse_read_reg(void)
 {
