From 4b44631b287d2540eda60ed45ea9ec792301d35c Mon Sep 17 00:00:00 2001
From: Peleg Vigodny <peleg.vigodny@tandemg.com>
Date: Wed, 07 Jul 2021 10:32:10 +0300
Subject: [PATCH] [SW-36402] erom: increase size

Increase erom section size to 64KiB

Change-Id: Ifba4a816e2e8ab72d6f89f6ee7618f6e39f37447
Signed-off-by: Peleg Vigodny <peleg.vigodny@tandemg.com>
---

diff --git a/app/ext_rom/common.h b/app/ext_rom/common.h
index 7a3d474..6def245 100644
--- a/app/ext_rom/common.h
+++ b/app/ext_rom/common.h
@@ -7,7 +7,7 @@
 #define COMMON_EXT_ROM_H_
 
 #define EXT_ROM_START		(0)
-#define EXT_ROM_TEXT_LENGTH	(32*1024)
+#define EXT_ROM_TEXT_LENGTH	(64*1024)
 /* No header bytes. Hence the text base is same as erom start address */
 #define EXT_ROM_TEXT_BASE	(EXT_ROM_START)
 
