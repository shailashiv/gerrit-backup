From a43bc149cbfd716e952178874abb442f13df53eb Mon Sep 17 00:00:00 2001
From: Abhishek <apatgaonkar@habana.ai>
Date: Fri, 15 Mar 2024 14:43:42 +0200
Subject: [PATCH] [FSW-402] fs1: disable spi gateway for signle die

For single die sku, disable the spi gateway.

Change-Id: I0baf0360bfa2f3a041e2b3e4e7994ffd6a18f96e
---

diff --git a/app/boot_rom.c b/app/boot_rom.c
index a4f4eaa..f86b43c 100644
--- a/app/boot_rom.c
+++ b/app/boot_rom.c
@@ -6,6 +6,7 @@
 
 #include <boot_rom.h>
 #include <security.h>
+#include <common.h>
 
 struct boot_rom_global_s __attribute__((section (".rom_persistent_section")))boot_rom_global = {
 	.config_fuse = 0,
@@ -16,6 +17,7 @@
 	.curr_img = 0,
 	.die_id = 0,
 	.die_type = INVALID_DIE_TYPE,
+	.sku_type = INVALID_SKU,
 };
 
 struct boot_rom_manifest_s __attribute__((section (".rom_manifest_section")))boot_rom_manifest;
@@ -26,5 +28,7 @@
 
 	boot_rom_security_init();
 
+	boot_rom_disable_spi_gw();
+
 	return 0;
 }
diff --git a/arch/fs1/arc/common.c b/arch/fs1/arc/common.c
index 38a4cc0..aedbd2a 100644
--- a/arch/fs1/arc/common.c
+++ b/arch/fs1/arc/common.c
@@ -13,6 +13,8 @@
 #include <psoc_boot_conf_regs.h>
 #include <psoc_security_regs.h>
 #include <global_conf_regs.h>
+#include <d2d_spi_regs.h>
+#include <d2d_spi_masks.h>
 #include <fs1_reg_mask.h>
 #include <fs1_fw_if.h>
 #include <status.h>
@@ -136,3 +138,16 @@
 	cold_rst_data.arc1_iccm_init_done = 1;
 	regmap_writel(cold_rst_data.data, IO0_HALF0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
 }
+
+void boot_rom_disable_spi_gw(void)
+{
+	uint32_t val;
+
+	if (boot_rom_global.sku_type == MULTI_DIE_SKU)
+		return;
+
+	/* Disable SPI D2D GW */
+	val = regmap_readl(IO0_H0_PSOC_D2D_SPI(mmD2D_SPI_GLOBAL_CFG));
+	val &= ~(D2D_SPI_GLOBAL_CFG_MSTR_ENABLE_M);
+	regmap_writel(val, IO0_H0_PSOC_D2D_SPI(mmD2D_SPI_GLOBAL_CFG));
+}
diff --git a/common/common.h b/common/common.h
index b0cf8ca..c9b16d6 100644
--- a/common/common.h
+++ b/common/common.h
@@ -13,5 +13,6 @@
 void boot_rom_persistent_dccm_init(uint8_t die_id);
 void boot_rom_read_cold_flops(void);
 void boot_rom_iccm_init(void);
+void boot_rom_disable_spi_gw(void);
 
 #endif /* _COMMON_H_ */
diff --git a/include/boot_rom.h b/include/boot_rom.h
index 6c63f8d..ab5eba9 100644
--- a/include/boot_rom.h
+++ b/include/boot_rom.h
@@ -75,6 +75,7 @@
 	uint8_t curr_img;
 	uint8_t die_id;
 	enum boot_rom_die_type die_type;
+	enum boot_rom_sku_type sku_type;
 	uint64_t ppboot_start_addr;
 };
 
