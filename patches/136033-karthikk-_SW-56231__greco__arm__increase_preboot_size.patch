From e7a18b37d32828baf70a8123210b344a51ec0aec Mon Sep 17 00:00:00 2001
From: Karthikeyan K <karthikk@habana.ai>
Date: Fri, 08 Oct 2021 11:33:45 +0300
Subject: [PATCH] [SW-56231] greco: arm: increase preboot size

Increase greco arm preboot size from 70KB -> 74KB.

Change-Id: Ic8d888c2ae103adc8336d9cfbcdfbd23a3bd3700
---

diff --git a/arch/greco/arm/common.h b/arch/greco/arm/common.h
index 48d91f5..7ad082f 100644
--- a/arch/greco/arm/common.h
+++ b/arch/greco/arm/common.h
@@ -10,7 +10,7 @@
 #include <bitops.h>
 
 #define PPBOOT_SIZE			0x5000		/* 20KB */
-#define PREBOOT_SIZE			0x11800		/* 70KB */
+#define PREBOOT_SIZE			0x12800		/* 74KB */
 
 #define HL_SP_SRAM_SIZE			0x10000
 
