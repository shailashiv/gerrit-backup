From ff73a3fe548ec22d33b9b26a17776ea6dd73e971 Mon Sep 17 00:00:00 2001
From: Pardha Kesapragada <pkesapragada@habana.ai>
Date: Wed, 03 Feb 2021 15:49:04 +0200
Subject: [PATCH] [SW-20154] gaudi2_arc: enable signature verification

Enable Signature verification by default for Onix

Change-Id: I685d77be5267629d7f604f77d315783566f1eb36
Signed-off-by: Pardha Kesapragada <pkesapragada@habana.ai>
---

diff --git a/gaudi2_arc/onix.c b/gaudi2_arc/onix.c
index 5e7e66e..f82fc69 100644
--- a/gaudi2_arc/onix.c
+++ b/gaudi2_arc/onix.c
@@ -9,12 +9,11 @@
 #include <common.h>
 #include <psoc_global_conf_masks.h>
 
-/* TODO: Enable Image validation later */
 #define EFUSE_SYSCFG_ONIX_DEFAULT \
 				(EFUSE_SYSCFG_FW_VERSION_LOCATION_SPI | \
 				 EFUSE_SYSCFG_KEY_LOCATION_SPI | \
 				 EFUSE_SYSCFG_REVOKATION_LOCATION_SPI | \
-				 /* EFUSE_SYSCFG_ENABLE_VALIDATION_MASK |*/ \
+				 EFUSE_SYSCFG_ENABLE_VALIDATION_MASK | \
 				 EFUSE_SYSCFG_GPIO02_RECOVERY_CONTROL)
 
 int fuse_read(uint32_t word, uint32_t *val)
