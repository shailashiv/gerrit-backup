From e3435fa18b3515cc78d517b9009b6e005dadd681 Mon Sep 17 00:00:00 2001
From: Subrata Chatterjee <schatterjee@habana.ai>
Date: Tue, 07 Dec 2021 20:14:36 +0200
Subject: [PATCH] [SW-63186] gaudi2: pcie: config permission level

Configure PCIe initiator permission level as secured.

Change-Id: Ibfa519e46a2e627b9fb1d558d5c066ef4267a04c
Signed-off-by: Subrata Chatterjee <schatterjee@habana.ai>
---

diff --git a/arch/gaudi2/common/security.c b/arch/gaudi2/common/security.c
index f41418c..23f216f 100644
--- a/arch/gaudi2/common/security.c
+++ b/arch/gaudi2/common/security.c
@@ -29,6 +29,8 @@
 #include <dcore0_rtr2_masks.h>
 #include <dcore0_rtr2_regs.h>
 #include <pcie_elbi_rr_mstr_if_core_lbw_regs.h>
+#include <pcie_wrap_regs.h>
+#include <pcie_wrap_masks.h>
 
 /*
  * instances_num : Number of instances of RR to program.
@@ -434,6 +436,12 @@
 {
 	/* make transactions via ELBI as secured */
 	regmap_writel(AXPROT_OVRD_SEC, mmPCIE_ELBI_RR_MSTR_IF_CORE_LBW_AXPROT_OVRD);
+}
+
+static void preboot_secure_pcie(void)
+{
+	regmap_writel((PCIE_WRAP_PCIE_PROT_OVR_RD_EN_MASK |
+		       PCIE_WRAP_PCIE_PROT_OVR_WR_EN_MASK), mmPCIE_WRAP_PCIE_PROT_OVR);
 }
 
 static int init_prot_bits_block(u32 index, u8 major, u8 minor, u8 sub_minor)
@@ -877,6 +885,8 @@
 
 void preboot_security_init(void)
 {
+	preboot_secure_pcie();
+
 	/* Do security related initializations only if security is enabled */
 	if (!preboot_security_is_enabled())
 		return;
