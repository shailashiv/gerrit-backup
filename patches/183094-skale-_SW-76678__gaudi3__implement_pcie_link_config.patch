+	/* TODO: Check any HW FSM bits needs to be configured */
+}
+
+void pcie_phy_set_sram_ext_ld_done(void)
+{
+	regmap_writel(1, mmD0_PCIE_PHY_PHY_SRAM_EXT_LD_DONE);
+}
+
+void pcie_phy_set_mpll_a_b_ssc_enable(void)
+{
+
+	pcie_update_reg_range(mmD0_PCIE_PHY_PHYX_MPLLB_SSC_EN_0,
+			mmD0_PCIE_PHY_PHYX_MPLLB_SSC_EN_3, 0x1);
+	pcie_update_reg_range(mmD0_PCIE_PHY_PHYX_MPLLA_SSC_EN_0,
+			mmD0_PCIE_PHY_PHYX_MPLLA_SSC_EN_3, 0x1);
+}
+
 uint8_t get_sris_mode_from_strap(void)
 {
-	return 0;
+	uint32_t boot_strap;
+
+	boot_strap = regmap_readl(mmD0_PSOC_BOOT_CONF_BOOT_STRAP_PINS_H);
+
+	return !!(boot_strap & D0_PSOC_BOOT_CONF_BOOT_STRAP_PINS_H_SRIS_M);
 }
+
+#define DUMP_SEL_SSC_MASK	0x2
 
 uint8_t get_ssc_en_from_strap(void)
 {
-	return 0;
+	uint32_t boot_strap = regmap_readl(mmD0_PSOC_BOOT_CONF_BOOT_STRAP_PINS_L);
+
+	uint32_t dump_sel = (boot_strap &
+		D0_PSOC_BOOT_CONF_BOOT_STRAP_PINS_L_DUMP_SEL_M) >>
+		D0_PSOC_BOOT_CONF_BOOT_STRAP_PINS_L_DUMP_SEL_S;
+
+	/* dumpsel[1] is SSC EN */
+	return !!(dump_sel & DUMP_SEL_SSC_MASK);
 }
 
 uint8_t get_srns_mode_from_strap(void)
@@ -139,6 +193,32 @@
 	return 0;
 }
 
+void pcie_phy_ssc_en_set(void)
+{
+	if (get_ssc_en_from_strap()) {
+		/*
+		 * TODO: check whether efuse
+		 * EFUSE_SYSCFG_WA_SNPS_CASE_01038891 needs to be checked.
+		 */
+		pcie_phy_set_mpll_a_b_ssc_enable();
+	}
+}
+
+void pcie_set_pcie_device_vendor_id(void)
+{
+	uint32_t id;
+
+	if (!arcboot_rom_global.die_id)
+		return;
+
+	id = ((PCI_VENDOR_ID_HABANALABS <
+		D1_PCIE_DBI_SIG_DEVICE_ID_VENDOR_ID_REG_PCI_TYPE0_VENDOR_ID_S) |
+		(PCI_IDS_GAUDI3_DIE1 <
+		D1_PCIE_DBI_SIG_DEVICE_ID_VENDOR_ID_REG_PCI_TYPE0_DEVICE_ID_S));
+
+	regmap_writel(id, mmD1_PCIE_DBI_SIG_DEVICE_ID_VENDOR_ID_REG);
+}
+
 static void arcboot_rom_prstn_init(void)
 {
 	if (arcboot_rom_global.die_id) {
diff --git a/arch/gaudi3/arc/recovery.c b/arch/gaudi3/arc/recovery.c
index fe42532..970fcad 100644
--- a/arch/gaudi3/arc/recovery.c
+++ b/arch/gaudi3/arc/recovery.c
@@ -5,13 +5,72 @@
  */
 
 #include <arcboot.h>
+#include <boot_desc.h>
+#include <common.h>
+#include <pcie.h>
+#include <efuse.h>
 #include <dev_common.h>
+#include <dev_efuse.h>
+
+static void execute_erom_recovery(void)
+{
+	/* TODO: implement erom recovery */
+}
+
+static void rom_recovery(void)
+{
+	/* TODO: implement rom recovery */
+}
+
+static void rom_pcie_recovery(void)
+{
+	arcboot_rom_status_update(PROGRESS_PCIE_IN_RECOVERY);
+
+	/* Disable PCIe error responses (both HBW and LBW) */
+	regmap_writel(0x1, mmPCIE_RSP_OK);
+	regmap_writel(0x1, mmD0_PCIE_WRAP_PCIE_RSP_OK_1);
+
+	if ((arcboot_rom_global.config_fuse &
+	     EFUSE_SYSCFG_DISABLE_ROM_PCIE_RECOVERY) == 0)
+		pcie_config();
+}
+
+static void execute_rom_recovery(void)
+{
+	rom_pcie_recovery();
+	rom_recovery();
+}
 
 void execute_recovery(void)
 {
+	uint8_t recovery_location;
+
 	/* Notify slave if master die and dual die sku */
 	if ((arcboot_rom_global.sku) && (!arcboot_rom_global.die_id))
 		arcboot_rom_notify_slave();
 
-	/* TODO: implement recovery sequence */
+	/*
+	 * efuse[14:13]:
+	 * 00: ROM
+	 * 01: eROM
+	 * 10: Reserved
+	 * 11: ROM
+	 */
+	recovery_location = ((arcboot_rom_global.config_fuse >>
+			EFUSE_SYSCFG_RECOVERY_CODE_LOCATION) &
+			EFUSE_SYSCFG_RECOVERY_CODE_LOCATION_MASK);
+
+	if (recovery_location != EFUSE_SYSCFG_RECOVERY_CODE_LOCATION_EROM)
+		/* In all other scenarios, execute from ROM (most secure) */
+		execute_rom_recovery();
+	else
+		execute_erom_recovery();
+
+	/*
+	 * ROM Execution is expected to reach here only in case EROM image
+	 * download and verification error.
+	 * Stay here and do not return
+	 */
+	while (1)
+		;
 }
diff --git a/common/pcie.c b/common/pcie.c
