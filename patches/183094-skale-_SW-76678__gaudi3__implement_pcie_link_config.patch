+void pcie_config(void)
 {
 	uint32_t link_ctrl;
 	uint8_t ltssm_en;
+
+	pcie_set_pcie_device_vendor_id();
 
 	pcie_loop_while_prstn(PCIE_PRSTN_ASSERT);
 	ltssm_en = regmap_readl(mmLTSSM_EN) &
@@ -90,6 +95,7 @@
 		}
 
 		pcie_wa_snps_case_01038891();
+		pcie_phy_ssc_en_set();
 
 		regmap_writel(1, mmPCIE_PHY_RST_N);
 
@@ -120,6 +126,7 @@
 		enable_flr_handling_fsm();
 
 		/* disable HOT reset handling by HW state machine */
+		/* TODO: Check whether required for Gaudi3 */
 		regmap_writel(CPU_HOT_RST_CTRL_MASK,
 			      mmCPU_HOT_RST);
 
