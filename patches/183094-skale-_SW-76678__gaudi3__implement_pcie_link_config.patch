-void pcie_phy_para_sel_set(void) {}
+
+void pcie_phy_para_sel_set(void)
+{
+	regmap_writel(1, mmD0_PCIE_PHY_CR_PARA_SEL_0);
+	regmap_writel(1, mmD0_PCIE_PHY_CR_PARA_SEL_1);
+	regmap_writel(1, mmD0_PCIE_PHY_CR_PARA_SEL_2);
+	regmap_writel(1, mmD0_PCIE_PHY_CR_PARA_SEL_3);
+}
+
+void pcie_wait_for_sram_init_done(void)
+{
+	while (regmap_readl(mmD0_PCIE_PHY_PHYX_SRAM_INIT_DONE_0) ||
+		regmap_readl(mmD0_PCIE_PHY_PHYX_SRAM_INIT_DONE_1) ||
+		regmap_readl(mmD0_PCIE_PHY_PHYX_SRAM_INIT_DONE_2) ||
+		regmap_readl(mmD0_PCIE_PHY_PHYX_SRAM_INIT_DONE_3))
+		;
+}
