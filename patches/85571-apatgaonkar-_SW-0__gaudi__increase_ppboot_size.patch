From 3edc0e2fdd01bac46728564362789e3031632fa1 Mon Sep 17 00:00:00 2001
From: Abhishek <apatgaonkar@habana.ai>
Date: Wed, 31 Mar 2021 07:18:28 +0300
Subject: [PATCH] [SW-0] gaudi: increase ppboot size

To introduce a generic reset decoding capability
that can work commonly for all platforms, gaudi1
ppboot needs to be marginally increased.
Therefore this patch increases the size by 1KB

Change-Id: I565e6ff4406f3b58249cd2da7d52560bb9ca74ed
---

diff --git a/gaudi/common.h b/gaudi/common.h
index 374e28d..4ab14a4 100644
--- a/gaudi/common.h
+++ b/gaudi/common.h
@@ -7,7 +7,7 @@
 #ifndef COMMON_GAUDI_H_
 #define COMMON_GAUDI_H_
 
-#define PPBOOT_SIZE			0x4000		/* 16KB */
+#define PPBOOT_SIZE			0x4400		/* 17KB */
 #define PREBOOT_SIZE			0x20000		/* 128KB */
 #define SRAM_SIZE			0x1400000	/* 20MB */
 
