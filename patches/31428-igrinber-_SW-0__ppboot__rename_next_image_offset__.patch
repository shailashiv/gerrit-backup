From 77eb6fb1a59f6a2ed4600f3ffa1daa30b05ef147 Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Wed, 01 Apr 2020 13:25:23 +0300
Subject: [PATCH] [SW-0] ppboot: rename next_image_offset()

Rename the next_image_offset() function to next_image_base_offset().
The new name better reflects what the function does.

Change-Id: Ieba444604e17e731a80da4ec0f626fe05f676536
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/app/ppboot.c b/app/ppboot.c
index 3110eb8..71347a9 100644
--- a/app/ppboot.c
+++ b/app/ppboot.c
@@ -18,7 +18,7 @@
 #include "pll.h"
 
 /* Stable ID can be 0 or 1, if not defined return primary offset (0) */
-static u32 next_image_offset(u32 offset, char *name)
+static u32 next_image_base_offset(u32 offset, char *name)
 {
 	u32 id;
 
@@ -41,7 +41,7 @@
 		name = "MODIFIABLE";
 	}
 
-	*offset = next_image_offset(next_img_off, name);
+	*offset = next_image_base_offset(next_img_off, name);
 
 	return image_pending;
 }
