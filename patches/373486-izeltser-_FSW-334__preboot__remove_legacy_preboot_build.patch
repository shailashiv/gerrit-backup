-
-static void preboot_process_last_boot_info(void)
-{
-	u32 boot_err = HL_FW_FIT_BOOT_ERR_NONE;
-	u32 data_size, rst_src;
-	u32 nic_en_local;
-	u32 fw_upd_is_dis = 0;
-
-	if (!boot_info_get(HL_BOOT_INFO_FIT_BOOT_ERROR, &boot_err,
-			   sizeof(boot_err), &data_size)) {
-		switch (boot_err) {
-		case HL_FW_FIT_BOOT_ERR_NONE:
-			break;
-		case HL_FW_FIT_BOOT_ERR_CORRUPTED:
-		case HL_FW_FIT_BOOT_ERR_ADDRESS_VIOLATION:
-		case HL_FW_FIT_BOOT_ERR_NOT_RUNNABLE:
-			cpu_boot_err_set(CPU_BOOT_ERR_FIT_CORRUPTED);
-			break;
-		case HL_FW_FIT_BOOT_ERR_REVOKED_KEY:
-		case HL_FW_FIT_BOOT_ERR_SVN:
-		case HL_FW_FIT_BOOT_ERR_SIGNATURE:
-			cpu_boot_err_set(CPU_BOOT_ERR_SECURITY_FAIL);
-			break;
-		}
-
-		i2csi_set_boot_err(boot_err, true);
-	}
-
-	if (!boot_info_get(HL_BOOT_INFO_NIC_EN, &nic_en_local,
-			   sizeof(nic_en_local), &data_size))
-		preboot_nic_en(nic_en_local);
-
-	/*
-	 * Preserve pci disable if exist, except for PRSTN, in which it is
-	 * required to clear previous indication.
-	 */
-	rst_src = hl_rst_src_get();
-	if (rst_src != HL_PRSTN_RST)
-		boot_info_get(HL_BOOT_INFO_FW_UPD_CLOSURE, &fw_upd_is_dis,
-			      sizeof(fw_upd_is_dis), &data_size);
-
-	/* device activity counter is cleared in power cycle or prstn */
-	if (rst_src == HL_PRSTN_RST || rst_src == HL_COLD_RST)
-		fw_info.device_activity_counter = 0;
-
-	module_fwupd_pcie_disable(fw_upd_is_dis);
-
-	if (!boot_info_get(HL_BOOT_INFO_FW_INFO, &fw_info,
-			   sizeof(fw_info), &data_size)) {
-		if (fw_info.version != HL_FW_INFO_VERSION) {
-			preboot_puts_hex("Ignoring fw info with version: ",
-					 fw_info.version, false);
-			/* ignoring fw_info data */
-			memset((void *)&fw_info, 0, sizeof(fw_info));
-		}
-
-		/*
-		 * Ignore reset cause that came from Linux as it is invalid to
-		 * current reset sequence.
-		 */
-		fw_info.reset_cause = HL_FW_RESET_CAUSE_UNKNOWN;
-	}
-}
