-void preboot_main(void)
-{
-	u64 ver_off = (uintptr_t)preboot_vers;
-	bool is_sec_en;
-
-	preboot_init_stack_monitor();
-	device_init();
-	/* Initialize internal if variables */
-	cpu_boot_if_init();
-	cpu_boot_sts_set(CPU_BOOT_STATUS_IN_PREBOOT);
-	/* Enable the errors communication */
-	cpu_boot_err_set(CPU_BOOT_ERR_ENABLED);
-	/* Enable the device status communication */
-	cpu_boot_dev_sts_set(CPU_BOOT_DEV_STS_ENABLED);
-
-	/*
-	 * Note: we assume CPU frequency is not changed while CPU is running,
-	 * so the udelay init is done once before we start.
-	 */
-	udelay_init();
-
-	hl_dev_pll_init();
-
-	hl_uart_init();
-	preboot_fuse_init();
-
-	preboot_close_strap_eeprom_write();
-
-	preboot_cond_arc0_reset();
-
-	spi_flash_init();
-	spi_flash_prot_late();
-	spi_flash_prot_status();
-
-	preboot_sp_sram_init();
-	preboot_reset_init();
-
-	preboot_device_id_init();
-
-	preboot_e2e_credits_init();
-	preboot_hbm_credits_init();
-	preboot_rate_limiter_init();
-
-	preboot_security_init();
-	preboot_security_dynamic_init();
-	cpu_boot_sts_set(CPU_BOOT_STATUS_SECURITY_READY);
-
-	hl_ts_init();
-
-	/* Prepare boot FW versions and eFuse data for host */
-	preboot_version();
-	fuse_version();
-	preboot_read_straps();
-	preboot_read_test_mode();
-	preboot_security_dynamic_vers_init(ver_off, sizeof(preboot_vers));
-
-	preboot_led_on();
-	is_sec_en = preboot_security_is_enabled();
-	if (!is_sec_en)
-		hl_clock_gating_init();
-
-	hl_ram_init();
-	preboot_dev_enable_caps();
-
-	preboot_process_last_boot_info();
-	preboot_process_last_rma_info();
-
-	if (hl_is_watchdog_reset())
-		i2csi_set_wd_err(HL_FW_RESET_CAUSE_WATCHDOG);
-
-	preboot_engines_init();
-
-	preboot_clear_wd_gpio();
-
-	preboot_tpm_auth();
-
-	module_handle_cmds(cmd_ops, ARRAY_SIZE(cmd_ops));
-}
-
-bool preboot_error_inform(u32 major, u32 minor)
-{
-	/*
-	 * ensuring sending the first error occurrence
-	 * to reset the error just use the clr_on_read
-	 */
-	if (!pending_error.error) {
-		pending_error.major = major;
-		pending_error.minor = minor;
-		return true;
-	}
-
-	return false;
-}
-
-bool preboot_error_is_pending(void)
-{
-	return !!pending_error.error;
-}
-
-u32 preboot_error_read_and_clr(u32 *major, u32 *minor)
-{
-	*major = pending_error.major;
-	*minor = pending_error.minor;
-
-	pending_error.error = 0;
-	return *major;
-}
-
-__weak int preboot_set_sram_sf_access(bool is_enable)
-{
-	return 1;
-}
-
-void preboot_set_eeprom_defaults_en(u8 eeprom_defaults_on_err)
-{
-	eeprom_def_boot_en = eeprom_defaults_on_err;
-}
-
-void preboot_boot_info_set_eeprom_fw_info(void)
-{
-	fw_info.version = HL_FW_INFO_VERSION;
-	fw_info.eeprom_def_boot_en = eeprom_def_boot_en;
-	boot_info_set(HL_BOOT_INFO_FW_INFO, &fw_info, sizeof(fw_info));
-}
-
-void preboot_finalize_uboot_override(void)
-{
-	if (eeprom_def_boot_en)
-		preboot_boot_info_set_eeprom_fw_info();
-}
