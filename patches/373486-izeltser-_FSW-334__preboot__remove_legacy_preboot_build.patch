diff --git a/app/ext_rom/erom_recovery.c b/app/ext_rom/erom_recovery.c
index 7e97f95..bdf8a86 100644
--- a/app/ext_rom/erom_recovery.c
+++ b/app/ext_rom/erom_recovery.c
@@ -14,11 +14,40 @@
 #include <security.h>
 #include <spi_flash.h>
 #include <device.h>
+#include <boot_info.h>
+#include <hl_fw_if.h>
+#include <hl_boot_desc.h>
 
 #include <uart.h>
 
 #include <hl_i2c_indirect_protocol.h>
 #include <gaudi2/i2c_indirect_protocol.h>
+
+#define BTL_VER_PREFIX	"BTL version "
+#define FUSE_VER_PREFIX	"Fuse version "
+
+struct hl_rsp_err {
+	union {
+		struct {
+			u32 major;
+			u32 minor;
+		};
+		u64 error;
+	};
+};
+
+u8 hl_asic_sn[FUSE_DEVID_SIZE];
+struct hl_fw_info_compat fw_info;
+u32 err_sts_reg_val;
+static struct hl_rsp_err pending_error;
+static u8 eeprom_def_boot_en;
+static u64 preboot_en_caps;
+
+static const char *preboot_ver_str = HL_FW_COMP_NAME " " VERSION_STR;
+static char preboot_vers[][VERSION_MAX_LEN] = {
+	[PREBOOT_BTL_VER] = { BTL_VER_PREFIX },
+	[PREBOOT_EFUSE_VER] = { FUSE_VER_PREFIX },
+};
 
 static struct cmd_module_ops cmd_ops[] = {
 	{	/* PCI module */
@@ -88,6 +117,87 @@
 	op_status.device_status = HL_I2CI_REQ_DEV_STS_RECOVERY;
 }
 
+bool preboot_error_is_pending(void)
+{
+	return !!pending_error.error;
+}
+
+u32 preboot_error_read_and_clr(u32 *major, u32 *minor)
+{
+	*major = pending_error.major;
+	*minor = pending_error.minor;
+	pending_error.error = 0;
+	return *major;
+}
+
+bool preboot_error_inform(u32 major, u32 minor)
+{
+	/*
+	 * ensuring sending the first error occurrence
+	 * to reset the error just use the clr_on_read
+	 */
+	if (!pending_error.error) {
+		pending_error.major = major;
+		pending_error.minor = minor;
+		return true;
+	}
+	return false;
+}
+
+void preboot_finalize_enabled_caps(void)
+{
+	if (!preboot_en_caps)
+		return;
+	boot_info_set(HL_BOOT_INFO_EN_CAPS, &preboot_en_caps,
+		      sizeof(preboot_en_caps));
+}
+
+const char *preboot_get_version(enum preboot_vers ver)
+{
+	return preboot_vers[ver];
+}
+
+bool preboot_is_overlap_address_range(u64 addr, int len)
+{
+	if (addr + len <= (uintptr_t)&_start || addr >= (uintptr_t)&__stack_top)
+		return false;
+	return true;
+}
+
+void preboot_boot_info_set_eeprom_fw_info(void)
+{
+	fw_info.version = HL_FW_INFO_VERSION;
+	fw_info.eeprom_def_boot_en = eeprom_def_boot_en;
+	boot_info_set(HL_BOOT_INFO_FW_INFO, &fw_info, sizeof(fw_info));
+}
+
+void preboot_finalize_uboot_override(void)
+{
+	if (eeprom_def_boot_en)
+		preboot_boot_info_set_eeprom_fw_info();
+}
+
+void preboot_version(void)
+{
+	int err;
+	int j, i = 0, btl_ver_sz = 0;
+
+	preboot_puts("\n");
+	preboot_puts_raw(preboot_ver_str);
+	preboot_puts("\n");
+	/* copy the preboot version */
+	for (j = 0; j < VERSION_MAX_LEN - btl_ver_sz - 1; j++) {
+		preboot_vers[PREBOOT_BTL_VER][i++] = preboot_ver_str[j];
+		if (preboot_ver_str[j] == '\0')
+			break;
+	}
+
+	err = boot_info_set(HL_BOOT_INFO_PREBOOT_BTL_VERSION, preboot_vers[PREBOOT_BTL_VER],
+			    VERSION_MAX_LEN);
+	if (err)
+		preboot_puts("Failed to pass preboot BTL version securely\n");
+}
+
 __weak void preboot_recovery_flag(bool en) { }
 
 void erom_main_function(void)
