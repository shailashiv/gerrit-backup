From 6ef5f57769b6dbd078a5c873ecf333fe7db835a0 Mon Sep 17 00:00:00 2001
From: ran shalit <rshalit@habana.ai>
Date: Tue, 05 Oct 2021 07:36:54 +0300
Subject: [PATCH] [SW-56241] zephyr: add boot_info in arcmgmt build

Add boot_info module for arcmgmt build.

Change-Id: I19f7b1b4fef1e86d58aa81dd82b93bed4c2e967b
Signed-off-by: ran shalit <rshalit@habana.ai>
---

diff --git a/package/zephyr/zephyr.mk b/package/zephyr/zephyr.mk
index 5b5e165..9b8a96d 100644
--- a/package/zephyr/zephyr.mk
+++ b/package/zephyr/zephyr.mk
@@ -43,21 +43,28 @@
 ZEPHYR_INSTALL_TARGET_CMDS += && $(INSTALL) -D -m 0644 $(@D)/$(ZEPHYR_PID_DIR)/zephyr/zephyr.elf $(BINARIES_DIR)/zephyr_pid.elf
 endif
 
+define ZEPHYR_ARC_MGMT
+$(eval ZEPHYR_MGMT_DIR = build-mgmt)\
+$(eval ZEPHYR_CONF_DEFAULT ?= $(ZEPHYR_MGMT_DIR))\
+$(eval ZEPHYR_CONF_OPTS_MGMT += -DBOARD=hl_$(DEVICE_NAME)_mgmt_$(HL_TARGET))\
+$(eval ZEPHYR_CONF_OPTS_MGMT += -DDEVICE=$(DEVICE_NAME))\
+$(eval ZEPHYR_CONF_OPTS_MGMT += $(dir $(BR2_EXTERNAL_HABANALABS_PATH))/arcmgmt)\
+$(eval ZEPHYR_CONF_OPTS += $2)\
+$(eval ZEPHYR_CONF_OPTS_MGMT += $1) \
+$(eval ZEPHYR_CONFIGURE_CMDS += && $$(ZEPHYR_CONF_ENV) $(HOST_DIR)/bin/cmake $$(ZEPHYR_CONF_OPTS) $(ZEPHYR_CONF_OPTS_MGMT) -B $(ZEPHYR_MGMT_DIR)) \
+$(eval ZEPHYR_BUILD_CMDS += && $(TARGET_MAKE_ENV) $(MAKE) -C $$(@D)/$(ZEPHYR_MGMT_DIR))\
+$(eval ZEPHYR_INSTALL_TARGET_CMDS += && $(INSTALL) -D -m 0644 $$(@D)/$(ZEPHYR_MGMT_DIR)/zephyr/zephyr.elf $(BINARIES_DIR)/zephyr_mgmt.elf)\
+
+endef
+
 ifdef BR2_PACKAGE_ZEPHYR_ARC_MGMT
-ZEPHYR_MGMT_DIR = build-mgmt
-ZEPHYR_CONF_DEFAULT ?= $(ZEPHYR_MGMT_DIR)
-ZEPHYR_CONF_OPTS_MGMT += -DBOARD=hl_$(DEVICE_NAME)_mgmt_$(HL_TARGET)
-ZEPHYR_CONF_OPTS_MGMT += -DDEVICE=$(DEVICE_NAME)
-ZEPHYR_CONF_OPTS_MGMT += $(dir $(BR2_EXTERNAL_HABANALABS_PATH))/arcmgmt
-ZEPHYR_CONF_OPTS_MGMT += -DZEPHYR_MODULES=$(dir $(BR2_EXTERNAL_HABANALABS_PATH))/zephyr-modules/eeprom
 ifeq ($(HL_TARGET),pldm)
-ZEPHYR_CONF_OPTS += -DEXTRA_CFLAGS="-Werror -DTARGET_IS_PLDM"
+EXTRA_CFLAGS = "-Werror -DTARGET_IS_PLDM"
 else ifeq ($(HL_TARGET),onix)
-ZEPHYR_CONF_OPTS += -DEXTRA_CFLAGS="-Werror -DTARGET_IS_ONIX"
+EXTRA_CFLAGS = "-Werror -DTARGET_IS_ONIX"
 endif
-ZEPHYR_CONFIGURE_CMDS += && $(ZEPHYR_CONF_ENV) $(HOST_DIR)/bin/cmake $(ZEPHYR_CONF_OPTS) $(ZEPHYR_CONF_OPTS_MGMT) -B $(ZEPHYR_MGMT_DIR)
-ZEPHYR_BUILD_CMDS += && $(TARGET_MAKE_ENV) $(MAKE) -C $(@D)/$(ZEPHYR_MGMT_DIR)
-ZEPHYR_INSTALL_TARGET_CMDS += && $(INSTALL) -D -m 0644 $(@D)/$(ZEPHYR_MGMT_DIR)/zephyr/zephyr.elf $(BINARIES_DIR)/zephyr_mgmt.elf
+EXTRA_CONF = "-DZEPHYR_MODULES=$(dir $(BR2_EXTERNAL_HABANALABS_PATH))/zephyr-modules/eeprom;$(dir $(BR2_EXTERNAL_HABANALABS_PATH))/zephyr-modules/boot_info"
+$(call ZEPHYR_ARC_MGMT, $(EXTRA_CONF), $(EXTRA_CFLAGS))
 endif
 
 ifdef BR2_PACKAGE_ZEPHYR_AGENT_FW_LOADER
