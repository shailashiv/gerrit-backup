+			__attribute__ ((unused))uint8_t spi_controller_en)
+{
+}
+
+void security_pcie_rr_config(uint8_t spi_en)
+{
+	regmap_writel(PCIE_WRAP_PCIE_PROT_OVR_WR_EN_MASK |
+		      PCIE_WRAP_PCIE_PROT_OVR_RD_EN_MASK,
+		      mmPCIE_WRAP_PCIE_PROT_OVR);
+
+	/* NO Shared Initiator bits for Gaudi2, what to do? */
+	/* regmap_writel(PCIE_MSTR_RR_MSTR_IF_AXUSER_CORE_SHARED_MASK,
+		      mmPCIE_MSTR_RR_MSTR_IF_AXUSER_CORE);
+	*/
+	security_elbi_rr_lbw_config(spi_en);
+	security_dcon_rr_lbw_config(spi_en);
+	security_dcon_if0_rr_hbw_config(spi_en);
+	security_dcon_if1_rr_hbw_config(spi_en);
+}
+
+uint32_t security_key_soc_location_offset(uint32_t hash_key_index)
+{
+	uint32_t ret;
+	uint8_t key_soc_base_index;
+	uint8_t key_soc_location_index;
+	uint32_t key_soc_location[] = {
+		mmPSOC_SECURITY_PUBLIC_KEY_0_0,
+		mmPSOC_SECURITY_PUBLIC_KEY_1_0,
+		mmPSOC_SECURITY_PUBLIC_KEY_2_0,
+	};
+
+	/* select which index to choose */
+	key_soc_base_index = hash_key_index / SECURITY_DWORD_PER_KEY;
+	/* key is 384bit, 32bit * 12... which of the 12 location is requested */
+	key_soc_location_index = hash_key_index % SECURITY_DWORD_PER_KEY;
+
+	/* get base address of selected key index */
+	ret = key_soc_location[key_soc_base_index];
+	/* add to base address of key the spicifice location of currect DWORD */
+	ret += (key_soc_location_index * sizeof(uint32_t));
+
+	return ret;
+}
+
+void rom_get_hash(uint32_t *key_hash)
+{
+	uint32_t *ptr = (uint32_t *)rom_key_hashes;
+
+	for (int i = 0; i < SECURITY_KEY_HASH_ARRAY_SIZE; i++)
+		*(key_hash + i) = *(ptr + i);
+}
+
+void security_load_keys(void)
+{
+	uint8_t hash_key_index, num_dwords;
+	uint32_t key_hash[SECURITY_KEY_HASH_ARRAY_SIZE];
+	enum security_key_location key_location;
+
+	key_location = ((arcboot_rom_global.config_fuse >>
+			EFUSE_SYSCFG_KEY_LOCATION) &
+			EFUSE_SYSCFG_KEY_LOCATION_MASK);
+
+	arcboot_rom_status_update(PROGRESS_KEY_LOC);
+	arcboot_rom_status_update_location(PROGRESS_KEY_LOC_0, key_location);
+
+	switch (key_location) {
+	case KEY_LOCATION_EFUSE:
+		efuse_get_hash(key_hash);
+		break;
+	case KEY_LOCATION_ROM:
+	default:
+		rom_get_hash(key_hash);
+		break;
+	}
+
+	/* Store 3 key hashes in PSOC SECURITY, due to limited space */
+	num_dwords = NUM_KEYS_IN_EFUSE * SECURITY_DWORD_PER_KEY;
+	for (hash_key_index = 0; hash_key_index < num_dwords;
+	     hash_key_index++)
+		/* store habana key hash in PSOC_SECURITY */
+		regmap_writel(key_hash[hash_key_index],
+			      security_key_soc_location_offset(hash_key_index));
+
+	/* Store the 3 keys in SPSRAM */
+	for (hash_key_index = 0; hash_key_index < num_dwords;
+		hash_key_index++)
+		sp_sram_writel(key_hash[hash_key_index],
+			       SECURITY_EFUSE_KEYS_OFFSET + (hash_key_index *
+			       SECURITY_BYTE_PER_DWORD));
+}
+
+void check_and_enable_4b_termination(void)
+{
+	/* Not needed for Gaudi2 */
+}
