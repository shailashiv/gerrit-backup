+
+static int security_check_key_revoke_status(uint32_t key_index)
+{
+	uint8_t max_key_index = NUM_KEYS_IN_EFUSE, key_revoke;
+
+	/*
+	 * Key index ranges from:
+	 * 0 - 4: if key location == ROM (1)
+	 * 0 - 2: if key location == eFUSE (0)
+	 */
+	/* check efuse for key location */
+	if ((arcboot_rom_global.config_fuse >> EFUSE_SYSCFG_KEY_LOCATION) &
+			EFUSE_SYSCFG_KEY_LOCATION_MASK)
+		max_key_index = NUM_KEYS_IN_ROM;
+
+	if (key_index >= max_key_index)
+		return -1;
+
+	key_revoke = sp_sram_readl(SECURITY_EFUSE_KEYS_REVOKE_OFFSET);
+
+	/* if the key is not revoked, return 1 */
+	if ((key_revoke & BIT(key_index)) == 0)
+		return 1;
+
+	/* no valid key found */
+	return -1;
+}
+
+int security_get_key_hash(uint32_t *hash, uint8_t key_index)
+{
+	uint32_t valid_key_base, max_key_index = NUM_KEYS_IN_EFUSE;
+	int i;
+
+	/* check efuse for key location */
+	if ((arcboot_rom_global.config_fuse >> EFUSE_SYSCFG_KEY_LOCATION) &
+			EFUSE_SYSCFG_KEY_LOCATION_MASK) {
+
+		uint32_t *ptr;
+		max_key_index = NUM_KEYS_IN_ROM;
+
+		if (key_index >= max_key_index)
+			return -1;
+
+		/* read from ROM itself */
+		ptr = (uint32_t *)rom_key_hashes[key_index];
+		for (i = 0; i < SECURITY_DWORD_PER_KEY; i++)
+			*(hash + i) = ptr[i];
+	} else {
+
+		if (key_index >= max_key_index)
+			return -1;
+
+		/* read from efuse/SP SRAM */
+		valid_key_base = (key_index * SECURITY_BYTE_PER_DWORD *
+			  SECURITY_DWORD_PER_KEY) + SECURITY_EFUSE_KEYS_OFFSET;
+
+		for (i = 0; i < SECURITY_DWORD_PER_KEY; i++)
+			*(hash + i) = sp_sram_readl(valid_key_base + (i *
+					    SECURITY_BYTE_PER_DWORD));
+	}
+
+	return 1;
+}
+/*
+ * arcboot - Signature Verification
+ *
+ * A simple application which call phase0b to validate the signature
+ * of a blob of data.
+ *
+ * Both the protected data and the signature of the protected data can be
+ * changed, but the public key should be locked into the device.
+ *
+ * test_phase0b_data     - blob of protected data
+ * test_phase0b_data_len - size of the blob
+ * test_phase0b_sig      - signature of the blob
+ * test_phase0b_sig_len  - signature size
+ * test_public_key       - public key
+ * test_public_key_len   - public key size
+ */
+
+int secureboot_verify_image(uint32_t image_size,
+				uint32_t image_offset)
+{
+	int verify = 0, ret, key_index;
+	unsigned char expected_hash[SHA384_SUM_LEN];
+	unsigned char actual_hash[SHA384_SUM_LEN];
+	uint32_t config_fuse;
+	uint32_t test_public_key_len = KEY_SIZE;
+	uint32_t test_sig_len = SIG_SIZE;
+	uint32_t test_data_len = image_size;
+	unsigned char *test_data = (unsigned char *)(image_offset);
+	unsigned char *test_sig = test_data + test_data_len;
+
+	/* Key header is located as the last 2 DWORDS of the image */
+	unsigned char *ptr_key_index = test_sig - KEY_PROP_HDR_SZ;
+        unsigned char *ptr_key_prop = test_sig - TOTAL_PUB_KEY_PROPS_SZ;
+        unsigned char *test_public_key =  ptr_key_prop - test_public_key_len;
+
+	uint32_t fw_version = base_readl((uint32_t)test_data);
+
+	/* check efuse for security validation enable */
+	config_fuse = sp_sram_readl(SECURITY_EFUSE_SYS_CFG_OFFSET);
+
+	if ((config_fuse & EFUSE_SYSCFG_ENABLE_VALIDATION_MASK) == 0)
+		return SECUREBOOT_VERIFY_SUCCESS;
+
+	/* check minimal valid security FW version */
+	if (security_check_valid_fw_version(fw_version) !=
+					SECURITY_FW_VERSION_SECURE)
+		return SECUREBOOT_VERIFY_VER_FAILED;
+
+	key_index = *(uint32_t *)ptr_key_index;
+
+	ret = security_check_key_revoke_status(key_index);
+	if (ret != 1)
+		return SECUREBOOT_VERIFY_KEY_FAILED;
+
+	ret = security_get_key_hash((uint32_t *)expected_hash, key_index);
+	if (ret != 1)
+		return SECUREBOOT_VERIFY_KEY_FAILED;
+
+	/* check pub key hash versus efuse */
+        sha384_csum(test_public_key, test_public_key_len, actual_hash, 0);
+
+        verify = memcmp(actual_hash, expected_hash, SHA384_SUM_LEN);
+	if (verify)
+		return SECUREBOOT_VERIFY_KEY_FAILED;
+
+	ret = rsa_verify(test_data, test_data_len, test_public_key,
+			test_public_key_len, test_sig, test_sig_len);
+
+	/* 0 - SUCCESS, but arcboot main code, expects 1 for SUCCESS */
+	if (!ret)
+		return SECUREBOOT_VERIFY_SUCCESS;
+
+	return SECUREBOOT_VERIFY_FAILED;
+}
