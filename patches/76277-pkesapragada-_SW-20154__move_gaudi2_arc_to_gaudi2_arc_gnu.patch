@@ -0,0 +1,196 @@
+/* SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Copyright (C) 2021 HabanaLabs Ltd.
+ */
+
+#include <string.h>
+#include <arcboot.h>
+#include <efuse.h>
+#include <secureboot.h>
+#include <security.h>
+#include <dev_security.h>
+#include <rsa.h>
+#include <sha512.h>
+
+
+const uint8_t rom_key_hashes[NUM_KEYS_IN_ROM][SHA384_SUM_LEN] = {
+	/* Habana Public Key */
+	{
+		0x09, 0xa8, 0xdd, 0xac, 0xbe, 0x8a, 0x6d, 0x34,
+		0x94, 0x23, 0x62, 0x7c, 0xd6, 0x11, 0xe8, 0x15,
