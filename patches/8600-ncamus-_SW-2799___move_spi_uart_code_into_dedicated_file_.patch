From d43cd674a3610d5a698ec054a6f5510f3948aca7 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Mon, 04 Feb 2019 13:46:06 +0200
Subject: [PATCH] [SW-2799]: move spi/uart code into dedicated file FIXUP

Actually it is not only for Goya :)

Change-Id: I7786abcd69d7020a57a9638d62227a78106e430c
---

diff --git a/spi.h b/spi.h
index 10b8964..5d2051c 100644
--- a/spi.h
+++ b/spi.h
@@ -9,10 +9,6 @@
 #define _HL_SPI_H_
 
 
-#ifdef DEV_IS_GOYA
 void spi_copy_spl(unsigned int spl_offset);
-#else
-static inline void spi_copy_spl(unsigned int spl_offset) {}
-#endif
 
 #endif /* _HL_SPI_H_ */
diff --git a/uart.h b/uart.h
index 3b1c380..c0188e0 100644
--- a/uart.h
+++ b/uart.h
@@ -9,18 +9,10 @@
 #define _HL_UART_H_
 
 
-#ifdef DEV_IS_GOYA
 void preboot_puts_raw(const char* str);
 void preboot_puts(const char* str);
 int preboot_uint2hexstring(char *str, unsigned int num, bool pad);
 void preboot_puth_raw(unsigned int val, bool pad);
 void preboot_puth(unsigned int val, bool pad);
-#else
-static inline void preboot_puts_raw(const char* str) {}
-static inline void preboot_puts(const char* str) {}
-static inline int preboot_uint2hexstring(char *str, unsigned int num, bool pad) { return 0;}
-static inline void preboot_puth_raw(unsigned int val, bool pad) {}
-static inline void preboot_puth(unsigned int val, bool pad) {}
-#endif
 
 #endif /* _HL_UART_H_ */
