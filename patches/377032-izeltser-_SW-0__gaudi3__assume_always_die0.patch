From a4157318d25edb9779663597f722e76b1d4ec4f2 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Sun, 10 Dec 2023 20:34:26 +0200
Subject: [PATCH] [SW-0] gaudi3: assume always die0

since Pif Arc and Ppboot are running on die0 only, the code supporting
die1 is removed

pldm-bloader functionality is preserved as it is designed to run
on both dies.

Change-Id: Ia38b56dd61f34fb2dfeabf3df4dfac90b6a0785f
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/app/pcie_pif/pcie_pif.c b/app/pcie_pif/pcie_pif.c
index 30167dd..ab8d547 100644
--- a/app/pcie_pif/pcie_pif.c
+++ b/app/pcie_pif/pcie_pif.c
@@ -23,7 +23,6 @@
 	bool prstn_deasserted;
 	bool flr_sw_ctrl;
 	bool dual_die_sku;
-	bool primary_die;
 	bool setup_done;
 };
 
@@ -219,12 +218,10 @@
 	terminate_pci_access();
 	trigger_flr_reset();
 
-	if (flr_sts.primary_die) {
-		if (flr_sts.dual_die_sku)
-			wait_for_secondary_die();
+	if (flr_sts.dual_die_sku)
+		wait_for_secondary_die();
 
-		flag_flr_done();
-	}
+	flag_flr_done();
 
 	/* TODO: wait for confirmation from FW that security preparations have finished */
 
@@ -241,7 +238,6 @@
 		return;
 
 	flr_sts.dual_die_sku = hl_is_dual_die_sku();
-	flr_sts.primary_die = hl_get_die_id() ? false : true;
 	flr_sts.flr_sw_ctrl = true;
 	flr_sts.setup_done = true;
 	hl_pif_report_sts(PIF_STAT_FLR_INITIALIZED);
@@ -264,10 +260,7 @@
 	if (!flr_sts.flr_sw_ctrl)
 		return NOT_FOUND;
 
-	if (flr_sts.primary_die)
-		flr_req = regmap_readl(pif_arc.pf_flr_active);
-	else	/* running on secondary die in a dual die sku */
-		flr_req = regmap_readl(pif_arc.psoc2pif_flr_req);
+	flr_req = regmap_readl(pif_arc.pf_flr_active);
 
 	if (flr_req) {
 		pif_ts_counter_arm();
diff --git a/app/pldm_bloader/pldm_bloader.c b/app/pldm_bloader/pldm_bloader.c
index 18c44c9..d048810 100644
--- a/app/pldm_bloader/pldm_bloader.c
+++ b/app/pldm_bloader/pldm_bloader.c
@@ -23,6 +23,8 @@
 	device_init_uart();
 }
 
+__weak uint32_t hl_get_die_id(void) { return 0; }
+
 void pldm_bloader_main(void)
 {
 	uint32_t die_id = hl_get_die_id();
diff --git a/arch/gaudi3/arc/common.c b/arch/gaudi3/arc/common.c
index 331815f..0ac2c75 100644
--- a/arch/gaudi3/arc/common.c
+++ b/arch/gaudi3/arc/common.c
@@ -135,19 +135,9 @@
 	return boot_info_set_no_merge(type, data, size);
 }
 
-u32 gaudi3_die_timestamp_base_get(u32 die_id)
-{
-	if (die_id == GAUDI3_SLAVE_DIE_ID)
-		return mmD1_PSOC_TIMESTAMP_BASE;
-
-	return mmD0_PSOC_TIMESTAMP_BASE;
-}
-
 u32 hl_pll_timestamp_base_get(void)
 {
-	uint32_t die_id = hl_get_die_id();
-
-	return gaudi3_die_timestamp_base_get(die_id);
+	return mmD0_PSOC_TIMESTAMP_BASE;
 }
 
 unsigned int get_cs_pad_sel_flash(void)
@@ -465,7 +455,7 @@
 	image_entry();
 }
 
-u32 hl_get_die_id(void)
+uint32_t hl_get_die_id(void)
 {
 	/*
 	 * same address space read by both dies will return a different value
@@ -535,42 +525,22 @@
 
 void device_init_pci(void)
 {
-
