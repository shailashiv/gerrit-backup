-		pci.aux_smlh_link_up_reg = D1_PCIE_AUX_REG(mmPCIE_AUX_SMLH_LINK_UP);
-		pci.core_hot_rst_reg = D1_PCIE_CORE_REG(mmPCIE_CORE_HOT_RST);
-	}
+	/* DIE 0 */
+	pci.dbi_bar0_reg = D0_PCIE_DBI_SIG_REG(mmPCIE_DBI_BAR0_REG);
+	pci.dbi_bar2_reg = D0_PCIE_DBI_SIG_REG(mmPCIE_DBI_BAR2_REG);
