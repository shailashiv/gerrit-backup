+	pci.aux_pf_flr_active_reg = D0_PCIE_AUX_REG(mmPCIE_AUX_PF_FLR_ACTIVE);
+	pci.aux_flr_int_reg = D0_PCIE_AUX_REG(mmPCIE_AUX_FLR_INT);
+	pci.aux_pf_flr_done_reg = D0_PCIE_AUX_REG(mmPCIE_AUX_PF_FLR_DONE);
+	pci.aux_rdlh_link_up_reg = D0_PCIE_AUX_REG(mmPCIE_AUX_RDLH_LINK_UP);
+	pci.aux_smlh_link_up_reg = D0_PCIE_AUX_REG(mmPCIE_AUX_SMLH_LINK_UP);
+	pci.core_hot_rst_reg = D0_PCIE_CORE_REG(mmPCIE_CORE_HOT_RST);
 }
 
 void device_init_i2c_s(void)
@@ -624,38 +594,21 @@
 
