diff --git a/greco_arc/asic.c b/greco_arc/asic.c
new file mode 100644
index 0000000..c2f48c0
--- /dev/null
+++ b/greco_arc/asic.c
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2016-2020 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <psoc_global_conf_regs.h>
+
+#include <bitops.h>
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+
+#include "common.h"
+
+u32 hl_skip_pcie_init(void)
+{
+	/* Use DumpSel[2] to skip PCIe initialization */
+	return regmap_readl(mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS_L) & BIT(10);
+}
+
+u64 hl_pll_timestamp_freq_get(void)
+{
+	return hl_pll_get_freq(mmPSOC_PCI_PLL_CTRL_BASE, HL_PLL_DIV3);
+}
+
+void hl_uart_init(void)
+{
+	u32 uart_clk_freq = hl_pll_get_freq(mmPSOC_PCI_PLL_CTRL_BASE,
+						HL_PLL_DIV3);
+
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_8);	/* UART0 RXD */
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_9);	/* UART0 TXD */
+	preboot_uart_init(uart_clk_freq / HL_UART_BAUDRATE);
+}
+
+u32 hl_spi_baudr_get(void)
+{
+	u32 factor;
+	u32 spi_clk_freq = hl_pll_get_freq(mmPSOC_PCI_PLL_CTRL_BASE,
+						HL_PLL_DIV3);
+
+	factor = spi_clk_freq / HL_SPI_FLASH_MAX_FREQ;
+
+	return factor > 2 ? factor : 2;
+}
+
+/*
+ * FW_SRAM layout:
+ * ---------------
+ * CRC32 [4B]
+ * Signature [384B]
+ * Public Key [392B]
+ * PCIe PHY FW
+ * PPboot
+ * PPboot size [4B]
+ * FW Version [4B]
+ * Layout Size [4B]
+ */
+#define FW_SRAM_META_SIZE	(4 + 4 + 4 + 392 + 384 + 4)
+void hl_init_pcie_phy_fw(void)
+{
+	int i;
+	u32 *fw_sram_base = (u32 *)FW_SRAM_BASE;
+	u32 image_size = *fw_sram_base;
+	u32 ppboot_size = *(fw_sram_base + 2);
+	u32 size = image_size - ppboot_size - FW_SRAM_META_SIZE;
+	u32 *src = (u32 *)((char *)(fw_sram_base + 3) + ppboot_size);
+	u32 *dst = (u32 *)PCIE_FW_SRAM_BASE;
+	unsigned int rst_src = regmap_readl(mmPSOC_GLOBAL_CONF_RST_SRC);
+
+	if (rst_src != HL_COLD_RST)
+		return;
+
+	for (i = 0; i < (size / 4); i++)
+		*(dst + i) = *(src + i);
+}
+
diff --git a/greco_arc/common.c b/greco_arc/common.c
new file mode 100644
index 0000000..3889373
--- /dev/null
+++ b/greco_arc/common.c
@@ -0,0 +1,365 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2016-2020 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <stdint.h>
+
+#include <pcie_phy_regs.h>
+#include <psoc_global_conf_regs.h>
+#include <psoc_gpio1_regs.h>
+#include <psoc_qspi_regs.h>
+#include <psoc_efuse_regs.h>
+#include <psoc_arc0_cfg_regs.h>
+#include <pcie_aux_regs.h>
+#include <pcie_wrap_regs.h>
+#include <pcie_core_regs.h>
+#include <pcie_dbi_regs.h>
+#include <cpu_ca53_cfg_regs.h>
+#include <cpu_timestamp_regs.h>
+
+#include <hl_boot_if.h>			 /* requires stdint.h */
+#include <greco/greco_reg_map.h>
+#include <common/pci_ids.h>
+#include <arcboot_export.h>
+
+#include <bitops.h>
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+#include <efuse.h>
+#include <string.h>
+
+#include "common.h"
+
+#define FW_WORD_NUM		0x2200	/* FW_SIZE / 2 */
+#define PRODUCT_ID_STR_SIZE	0x8
+
+#define mmPCIE_WRAP_VUART_TX_DATA       0xC15F60
+#define mmPCIE_WRAP_VUART_TX_STATUS     0xC15F64
+
+u32 get_efuse_read_reg(void)
+{
+	return mmPSOC_EFUSE_READ;
+}
+
+static void preboot_init_pcie_phy_fw_update(void)
+{
+	/* Configure FW update size */
+	regmap_writel(FW_WORD_NUM, mmPCIE_WRAP_PHY_FW_FSM_SIZE);
+
+	/*
+	 * PHY FW FSM EN and Direct FW write mechanism enable
+	 * FW FSM assumes that the data is present in the SRAM
+	 * The FSM will wait for SRAM init done before updating
+	 * the SRAM contents
+	 */
+	regmap_writel(9, mmPCIE_WRAP_PHY_FW_FSM);
+
+	/* Take the PHY out of reset */
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
+}
+
+__weak void preboot_init_pcie_phy(void)
+{
+	/* Reset PCIe PHY */
+	regmap_writel(0, mmPSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
+
+	/*
+	 * Set PCIe PHY CR Para I/F to CFG.
+	 * Select CR PARA I/F instead of JTAG
+	 */
+	regmap_writel(1, mmPCIE_PHY_CR_PARA_SEL_0);
+	regmap_writel(1, mmPCIE_PHY_CR_PARA_SEL_1);
+
+	/* Select indirect access to CR PARA I/F instead of PRBI */
+	regmap_writel(1, mmPCIE_PHY_CR_PARA_CFG);
+
+	preboot_init_pcie_phy_fw_update();
+}
+
+static u32 preboot_pcie_device_id_get(void)
+{
+	u32 device_id;
+	int ret;
+	char product_str[PRODUCT_ID_STR_SIZE];
+
+	/* Default device id for addin card */
+	device_id = PCI_IDS_GRECO_ADDIN;
+
+	/*
+	 * Efuse stores "product id + rev" as 7 chars of which
+	 * product id is initial 6 chars.
+	 * e.g. for greco addin card efuse stores "HL1170A"
+	 * where "HL1170" is product id and rev is "A".
+	 * These 7 chars are read as two 32-bit uint reads
+	 * and stored in product_str.
+	 */
+	ret = preboot_fuse_read(EFUSE_PRODUCT_ID_OFFSET,
+				(u32 *)&product_str[0]);
+	if (!ret)
+		return device_id;
+
+	ret = preboot_fuse_read(EFUSE_PRODUCT_ID_OFFSET + 1,
+				(u32 *)&product_str[4]);
+	if (!ret)
+		return device_id;
+
+	/* Remove product revision */
+	product_str[PRODUCT_ID_STR_SIZE - 2] = '\0';
+
+	if (strcmp(product_str, "HL1120") == 0)
+		device_id = PCI_IDS_GRECO_M2;
+
+	return device_id;
+}
+
+static void preboot_pcie_device_id_vendor_id_set(void)
+{
+	u32 device_id, device_id_vendor_id;
+
+	device_id = preboot_pcie_device_id_get();
+
+	device_id_vendor_id = (device_id << 16) | PCI_VENDOR_ID_HABANALABS;
+
+	/* Update Vendor ID */
+	regmap_writel(device_id_vendor_id,
+		      mmPCIE_DBI_DEVICE_ID_VENDOR_ID_REG);
+
+	/* Update subsystem Vendor ID */
+	regmap_writel(device_id_vendor_id,
+		      mmPCIE_DBI_SUBSYSTEM_ID_SUBSYSTEM_VENDOR_ID_REG);
+
+}
+
+void preboot_init_pcie(void)
+{
+
+	preboot_init_pcie_phy();
+
+	preboot_pcie_device_id_vendor_id_set();
+
+	/* Disable the EQ REDO */
+	regmap_writel(0x00402801, mmPCIE_DBI_GEN3_RELATED_OFF);
+
+	while (!(regmap_readl(mmPCIE_PHY_PHYX_SRAM_INIT_DONE_0) &&
+		regmap_readl(mmPCIE_PHY_PHYX_SRAM_INIT_DONE_1)))
+		;
+
+	/* Execute the Synopsys W/A */
+	regmap_writel(0xF, mmPCIE_PHY_CR_PARA_CTRL);
+	regmap_writel(0x0004A07D, mmPCIE_PHY_CR_PARA_CMD);
+	udelay(20);
+
+	/* Enable and Mask LTSSM (erratum 102) */
+	regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
+}
+
+void preboot_pcie_wait_for_link(void)
+{
+	/* Wait for PRSTn */
+	while (!regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN))
+		;
+
+	/* Only after PRSTn is de-asserted */
+	preboot_pcie_enable();
+
+	while (1) {
+		unsigned int prstn, ltssm, smlh, rdlh;
+
+		prstn = regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN);
+		ltssm = regmap_readl(mmPCIE_AUX_LTSSM_EN);
+		smlh = regmap_readl(mmPCIE_AUX_SMLH_LINK_UP);
+		rdlh = regmap_readl(mmPCIE_AUX_RDLH_LINK_UP);
+
+		if (prstn && smlh && rdlh) {
+			preboot_puts("PCIe link is UP!\n");
+			break;
+		}
+
+		/*
+		 * Some host assert prstn during link up while moving to GEN3
+		 * This cause BAR size to be reset
+		 * We stop link up process by disabling ltssm
+		 * till BAR is reconfigured
+		 */
+		if (!prstn && ltssm) {
+			regmap_writel(0, mmPCIE_AUX_LTSSM_EN);
+			continue;
+		}
+
+		if (prstn && !ltssm) {
+			regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
+			continue;
+		}
+	}
+
+	/* W/A H/W bug that may lead to have a wrong mask (0x1) in LTSSM */
+	regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
+}
+
+void preboot_delay(void) {}
+
+void preboot_putc_virt_uart(const char c)
+{
+	/*
+	 * update vUART to HOST
+	 * DATA: mmPCIE_WRAP_VUART_TX_DATA
+	 * STATUS: mmPCIE_WRAP_VUART_TX_STATUS
+	 */
+	regmap_writel(c, mmPCIE_WRAP_VUART_TX_DATA);
+	regmap_writel(1, mmPCIE_WRAP_VUART_TX_STATUS);
+}
+
+unsigned int get_cs_pad_sel(void)
+{
+	return mmPSOC_GLOBAL_CONF_PAD_SEL_19;
+}
+
+void preboot_sync_btl(void) {}
+
+void init_prstn(void)
+{
+	/* Configure PRSTN to reset entire SoC */
+	regmap_writel(0xFFFFFFFF, mmPSOC_GLOBAL_CONF_PRSTN_RST_CFG_L);
+	regmap_writel(0x3FFFFF, mmPSOC_GLOBAL_CONF_PRSTN_RST_CFG_H);
+
+	/* Clear masking of PRSTN from SW reset */
+	regmap_writel(0x0, mmPSOC_GLOBAL_CONF_PRSTN_MASK);
+
+	/*
+	 * Hold PCIe controller at reset during PRSTn
+	 * Configure Boot Sequencer to wait for PRSTn
+	 * instead of PCLK stable
+	 */
+	regmap_writel(0x1, mmPSOC_GLOBAL_CONF_PHY_STABLE);
+
+	/*
+	 * Errata: Do not wait for ext_ld_done in boot_seq after
+	 * PRSTn is de-asserted (move to PCIe image without waiting
+	 * for ext_ld_done) ext_ld_done will be configured during
+	 * the PCIe image as part of the FW update flow
+	 */
+	regmap_writel(0x0, mmPSOC_GLOBAL_CONF_BOOT_SEQ_EXT_LD);
+}
+
+static void init_arc0(void)
+{
+	/*
+	 * Program Reset vector address for ARC0 to ICCM 0x0 location
+	 * where vector table first entry will be available and then
+	 * bring ARC0 out of reset. ARC when out of reset is by default
+	 * in halt state.
+	 */
+	regmap_writel(ARC_RST_VEC_ADDR, mmPSOC_ARC0_CFG_RST_VEC_ADDR);
+	regmap_writel(ARC_RST_VALUE, mmPSOC_ARC0_CFG_ARC_RST);
+}
+
+void hl_plat_early_init(void)
+{
+	/* Functionality used to be done in BTL */
+	init_prstn();
+
+	init_arc0();
+}
+
+void spi_ssi_cs0_get(unsigned int *mask, unsigned int *data_offset,
+		     unsigned int *out_en_offset)
+{
+	*mask = BIT(19 % 16);
+	*data_offset = mmPSOC_GPIO1_DATAOUT;
+	*out_en_offset = mmPSOC_GPIO1_OUTENSET;
+}
+
+void spi_base_get(unsigned int *regs)
+{
+	*regs = mmPSOC_QSPI_CTRLR0;
+}
+
+void image_start(u64 loadaddr)
+{
+	u32 lsb = (u32) loadaddr;
+	void (*image_entry)(void) = (void *) lsb;
+
+	image_entry();
+}
+
+void ppboot_cp_preboot(u64 loadaddr, u32 offset, u32 size, char *name)
+{
+	/* Not implemented - ARC BootROM copies and validates preboot */
+}
+
+u32 hl_pll_timestamp_base_get(void)
+{
+	return mmCPU_TIMESTAMP_CNTCR;
+}
+
+static u32 ppboot_flash_image_offset(u8 image_ptr)
+{
+	u8 flash_image_switch;
+
+	flash_image_switch = spi_flash_readl(FLASH_IMAGE_SWITCH_OFFSET);
+	if (flash_image_switch != 0) {
+		if (image_ptr != ARCBOOT_SECONDARY)
+			image_ptr = ARCBOOT_SECONDARY;
+		else
+			image_ptr = ARCBOOT_PRIMARY;
+	}
+
+	if (image_ptr == ARCBOOT_SECONDARY)
+		return spi_flash_readl(FLASH_SECONDARY_OFFSET);
+	else
+		return spi_flash_readl(FLASH_PRIMARY_OFFSET);
+}
+
+static int ppboot_bringup_preboot(u8 image_ptr)
+{
+	u32 flash_offset;
+	u16 image_size;
+
+	flash_offset = ppboot_flash_image_offset(image_ptr);
+	image_size = (u16) spi_flash_readl(flash_offset);
+
+	/*
+	 * Copy preboot image from flash to Scratchpad SRAM.
+	 * Note that the offset to be provided to perform DMA must be
+	 * in granuality of 4B. ie. In order to write at
+	 * 0x7FFBFE1000ULL, the address to be passed is 0x7FFBFE0400ULL
+	 * instead of 0x7FFBFE1000ULL (right shift offest 0x1000 by 2).
+	 */
+	dma_copy_image(image_size, flash_offset,
+		       (HL_SP_SRAM_BASE + (SP_SRAM_PREBOOT_OFFSET >> 2)),
+		       SPI_DMA_DST_HBW);
+	if (dma_wait_finish() == DMA_CRC_ERROR)
+		return ARCBOOT_BRINGUP_ERROR;
+
+	image_size -= SECUREBOOT_IMG_HEAD_FOOTER;
+	if (secureboot_verify_image(image_size,
+			(SP_SRAM_BASE + SP_SRAM_PREBOOT_OFFSET + IMG_LEN_SIZE))
+			== SECUREBOOT_VERIFY_FAILED)
+		return ARCBOOT_BRINGUP_ERROR;
+
+	return ARCBOOT_BRINGUP_OK;
+}
+
+u64 copy_preboot(void)
+{
+	u32 config_fuse;
+	int ret;
+
+	if (ppboot_bringup_preboot(ARCBOOT_PRIMARY) != ARCBOOT_BRINGUP_OK) {
+		if (ppboot_bringup_preboot(ARCBOOT_SECONDARY) !=
+			ARCBOOT_BRINGUP_OK) {
+			/* if debug I/F is enabled then fall back on I2C_S */
+			ret = preboot_fuse_read(EFUSE_SYSCFG_OFFSET,
+						&config_fuse);
+			if ((!ret)  && ((config_fuse ==
+				EFUSE_SYSCFG_DISABLE_TWI_IF_MASK) == 0)) {
+				security_i2c_s_enable();
+			}
+		}
+	}
+
+	return PREBOOT_TEXT_BASE;
+}
diff --git a/greco_arc/common.h b/greco_arc/common.h
new file mode 100644
index 0000000..aaed039
--- /dev/null
+++ b/greco_arc/common.h
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright 2016-2020 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#ifndef COMMON_GRECO_ARC_H_
+#define COMMON_GRECO_ARC_H_
+
+#include <goya2_blocks_linux_driver.h>
+#include <bitops.h>
+
+#define PPBOOT_SIZE		0x4000		/* 16KB */
+#define PREBOOT_SIZE		0xC000		/* 48KB */
+
+#define HL_FW_BOOT_PTRS_BASE		0x80000
+#define HL_SPI_LEGACY_PREBOOT_OFF	0xC0000
+
+#define HL_SP_SRAM_BASE		0x7FFBFE0000ULL
+#define PCIE_FW_SRAM_BASE	0x1BFF0000
+#define FW_SRAM_BASE		0x1B050000
+#define SP_SRAM_BASE		0x1BFE0000
+#define SP_SRAM_PREBOOT_OFFSET	0x1000
+#define PPBOOT_TEXT_BASE	(FW_SRAM_BASE + 0xC)
+#define PREBOOT_TEXT_BASE	(SP_SRAM_BASE + SP_SRAM_PREBOOT_OFFSET + 0x8)
+/* In order not to conflict with ARC BOOTROM's usage of DCCM,
+ * Let PPBoot start from the offset of 8KB, for using DCCM
+ * for its own BSS and Stack.
+ */
+#define PPBOOT_DCCM_BASE	0x80002000
+
+#define SDRAM_BASE		0x10000000
+#define FIT_IMG_BASE		0x10200000
+#define HL_SPI_BASE		0x1A000000
+#define HL_CFG_BASE		0xFC000000
+
+#define FUSE_WORDS_PER_BANK	0x40
+#define I2C_SLAVE_ADDRESS	0x6A
+#define I2C_SLAVE_ADDRESS_DBG	I2C_SLAVE_ADDRESS
+#define I2C_SLAVE_DEFAULT_INTR_MASK	0x48FF
+
+#define EFUSE_SYSCFG_DISABLE_TWI_IF_MASK        BIT(19)
+#define EFUSE_SYSCFG_FW_VERSION_LOCATION_SPI	BIT(14)
+#define EFUSE_SYSCFG_KEY_LOCATION_SPI		BIT(8)
+#define EFUSE_SYSCFG_REVOKATION_LOCATION_SPI	BIT(6)
+#define EFUSE_SYSCFG_ENABLE_VALIDATION_MASK	BIT(10)
+
+#define ARC_RST_VALUE		0x110
+#define ARC_RST_VEC_ADDR	0x0
+
+#endif /* COMMON_GRECO_ARC_H_ */
diff --git a/greco_arc/onix.c b/greco_arc/onix.c
new file mode 100644
index 0000000..110e7e4
--- /dev/null
+++ b/greco_arc/onix.c
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2016-2020 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+#include <efuse.h>
+
+#include <psoc_global_conf_regs.h>
+
+#include "common.h"
+
+#define SYS_CLOCK_FREQUENCY	35000000ULL
+#define UART_CLOCK_FREQUENCY	SYS_CLOCK_FREQUENCY
+#define PLDM_UART_BAUDRATE	57600
+
+#define EFUSE_SYSCFG_ONIX_DEFAULT \
+				(EFUSE_SYSCFG_FW_VERSION_LOCATION_SPI | \
+				 EFUSE_SYSCFG_KEY_LOCATION_SPI | \
+				 EFUSE_SYSCFG_REVOKATION_LOCATION_SPI | \
+				 EFUSE_SYSCFG_ENABLE_VALIDATION_MASK)
+
+u32 hl_skip_pcie_init(void)
+{
+	return 1;
+}
+
+u64 hl_pll_timestamp_freq_get(void)
+{
+	return SYS_CLOCK_FREQUENCY;
+}
+
+void hl_uart_init(void)
+{
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_8);	/* UART0 RXD */
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_9);	/* UART0 TXD */
+	preboot_uart_init(UART_CLOCK_FREQUENCY / PLDM_UART_BAUDRATE);
+}
+
+u32 hl_spi_baudr_get(void)
+{
+	u32 factor = 2; /* Min Divider */
+
+	/* baud rate doesn't support odd number */
+	return (factor + 1) & 0xFFFE;
+}
+
+int preboot_fuse_read(u32 word, u32 *val)
+{
+	int ret = -1;
+
+	if (word == EFUSE_SYSCFG_OFFSET) {
+		*val = EFUSE_SYSCFG_ONIX_DEFAULT;
+		ret = 0;
+	}
+
+	return ret;
+}
+
+void preboot_init_pcie_phy(void) {}
diff --git a/greco_arc/pcie_phy_fw.hex b/greco_arc/pcie_phy_fw.hex
new file mode 100644
index 0000000..f48c0f0
--- /dev/null
+++ b/greco_arc/pcie_phy_fw.hex
@@ -0,0 +1,8731 @@
+// ===================================================================================
+//  This Firmware was generated using the following settings on 2019-May-16_11:11:02
+// ===================================================================================
+// IPXACT         = e25_pma_1.3h_raw_1.4b_fw_2.4
+// ASM_REVISION   = 72
+// SET_EXCEL_FILE = esm25_adaptation_stats_hfsm_registers_v2.xlsx
+// SET_EXCEL_REV  = 1.7
+// SET_ADAPT_FILE =
+// SET_ADAPT_REV  = 1.7
+// PMA            = sds
+// PARAM0         = E25_RAW_1_3
+// PARAM1         = X081_E25_TSMC7FF
+// PARAM2         = E25_RAW_1_4
+// PARAM3         = E25_TSMC7FF
+// PARAM4         = E25_PMA_1_3
+// PARAM5         = SLC_RANGE_CALCULATION
+// PARAM6         = ENABLE_RTRIM_BY_DEFAULT
+//=======================================
+
+//===========================
+// Note that the SRAM addresses below are internal PHY memory mapped addresses when loading SRAM content via the CR PARA I/F.
+// If loading the SRAM directly through a separate external port, the SRAM addresses should remove the offset and start at address:0x0000
+//===========================
+// SRAM DATA -- NORMAL MODE
