Signed-off-by: Guy Nisan <gnisan@habana.ai>
---

diff --git a/gaudi/common.h b/gaudi/common.h
index 3869a9b..e86468f 100644
--- a/gaudi/common.h
+++ b/gaudi/common.h
@@ -8,7 +8,7 @@
 #define COMMON_GAUDI_H_
 
 #define PPBOOT_SIZE			0x4000		/* 16KB */
