From 17ea205f6c7d9066339a87463983df205c67d242 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Fri, 27 Apr 2018 17:17:08 +0300
Subject: [PATCH] Add thermal support

Adds thermal daemon to handel thermal loop
---

diff --git a/Config.in b/Config.in
index cca2b34..eaa7a1f 100644
--- a/Config.in
+++ b/Config.in
@@ -5,5 +5,6 @@
 source "$BR2_EXTERNAL_HL_DALI_PATH/package/uboot-test-hooks/Config.in"
 source "$BR2_EXTERNAL_HL_DALI_PATH/package/tbot/Config.in"
 source "$BR2_EXTERNAL_HL_DALI_PATH/package/dsv/Config.in"
+source "$BR2_EXTERNAL_HL_DALI_PATH/package/thermal/Config.in"
 
 # Below can add to make it appear in the top-level configuration menu
diff --git a/Makefile b/Makefile
index ae9e3f2..9777e75 100644
--- a/Makefile
+++ b/Makefile
@@ -95,7 +95,8 @@
 dali-distclean: $(OUTPUT_DIR)/.config
 	@$(MAKE) uboot-dirclean linux-dirclean armcp-dirclean	\
 		 spdlog-dirclean specs-dirclean specs_external-dirclean \
-		 host-uboot-test-hooks-dirclean host-tbot-dirclean
+		 host-uboot-test-hooks-dirclean host-tbot-dirclean \
+		 thermal-dirclean
 
 .PHONY: dali-onix-test dali-pldm-test dali-asic-test
 dali-onix-test: dali-onix-tools-install
diff --git a/board/habanalabs/common/local.mk b/board/habanalabs/common/local.mk
index 0c4c11c..cbf8096 100644
--- a/board/habanalabs/common/local.mk
+++ b/board/habanalabs/common/local.mk
@@ -7,3 +7,4 @@
 UBOOT_TEST_HOOKS_OVERRIDE_SRCDIR = $(TOPDIR)/../uboot-test-hooks
 TBOT_OVERRIDE_SRCDIR = $(TOPDIR)/../tbot
 DSV_OVERRIDE_SRCDIR = $(TOPDIR)/../dsv
+THERMAL_OVERRIDE_SRCDIR = $(TOPDIR)/../thermal
diff --git a/configs/dali_defconfig b/configs/dali_defconfig
index 300a3ef..bcc1a8d 100644
--- a/configs/dali_defconfig
+++ b/configs/dali_defconfig
@@ -62,3 +62,4 @@
 BR2_PACKAGE_UBOOT_TEST_HOOKS=y
 BR2_PACKAGE_TBOT=y
 BR2_PACKAGE_DSV=y
+BR2_PACKAGE_THERMAL=y
diff --git a/package/thermal/Config.in b/package/thermal/Config.in
new file mode 100644
index 0000000..5a03793
--- /dev/null
+++ b/package/thermal/Config.in
@@ -0,0 +1,5 @@
+config BR2_PACKAGE_THERMAL
+	bool "THERMAL"
+	help
+	  Thermal managment daemon
+	  Based on Linux sysfs API for thermal infrastructure
diff --git a/package/thermal/thermal.mk b/package/thermal/thermal.mk
new file mode 100644
index 0000000..6cf4354
--- /dev/null
+++ b/package/thermal/thermal.mk
@@ -0,0 +1,9 @@
+THERMAL_VERSION = 1.0.0
+THERMAL_SITE = thermal
+THERMAL_LICENSE = unclear
+
+define THERMAL_BUILD_CMDS
+	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) all
+endef
+
+$(eval $(generic-package))
