From dd8b4da15d97c8bd4b59b441e9d00abd657b2960 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Wed, 17 Aug 2022 13:53:18 +0300
Subject: [PATCH] [SW-0] gaudi3: fix address ranges

Upper bound of the address ranges is fixed

Change-Id: Ib399bcf8d4cca480f24dffb4ebde110639053ff5
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/arch/gaudi3/arc/common.c b/arch/gaudi3/arc/common.c
index dfc8c1f..d4bddea 100644
--- a/arch/gaudi3/arc/common.c
+++ b/arch/gaudi3/arc/common.c
@@ -411,22 +411,22 @@
 bool preboot_is_valid_address_range(u64 addr, int len)
 {
 	if (addr >= SP_SRAM_BASE &&
-	    addr + len <= SP_SRAM_BASE + HL_SP_SRAM_SIZE)
+	    addr + len < SP_SRAM_BASE + HL_SP_SRAM_SIZE)
 		return true;
 
 	if (addr >= HL_SP_SRAM_BASE &&
-	    addr + len <= HL_SP_SRAM_BASE + HL_SP_SRAM_SIZE)
+	    addr + len < HL_SP_SRAM_BASE + HL_SP_SRAM_SIZE)
 		return true;
 
 	if (addr >= ARC0_ICCM_FULL_BASE &&
-	    addr + len <= ARC0_ICCM_FULL_BASE + ARC0_MEM_SIZE)
+	    addr + len < ARC0_ICCM_FULL_BASE + ARC0_MEM_SIZE)
 		return true;
 
 	if (addr >= ARC1_ICCM_FULL_BASE &&
-	    addr + len <= ARC1_ICCM_FULL_BASE + ARC1_MEM_SIZE)
+	    addr + len < ARC1_ICCM_FULL_BASE + ARC1_MEM_SIZE)
 		return true;
 
-	if (addr >= SDRAM_BASE && addr + len <= SDRAM_BASE + SDRAM_SIZE)
+	if (addr >= SDRAM_BASE && addr + len < SDRAM_BASE + SDRAM_SIZE)
 		return true;
 
 	preboot_puts_hex64("ERROR: invalid address range addr = ", addr, true);
