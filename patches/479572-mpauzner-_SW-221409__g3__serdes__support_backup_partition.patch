From 9c0bf277c88a3def385bb7464094b2b2e0296064 Mon Sep 17 00:00:00 2001
From: Michael Pauzner <mpauzner@habana.ai>
Date: Mon, 12 May 2025 14:38:59 +0300
Subject: [PATCH] [SW-221409] g3: serdes: support backup partition

Add support for backup serdes LFS partition in RAM.

Change-Id: Ic5040596f2b92b83f03322ac5d25b5479216d139
Signed-off-by: Michael Pauzner <mpauzner@habana.ai>
---

diff --git a/src/hl_serdes/gaudi3/serdes.c b/src/hl_serdes/gaudi3/serdes.c
index 3922959..d4f702a 100644
--- a/src/hl_serdes/gaudi3/serdes.c
+++ b/src/hl_serdes/gaudi3/serdes.c
@@ -95,6 +95,11 @@
 static struct hl_serdes_oam_data oam_data;
 
 #ifdef CONFIG_LFS_ENABLED
+#define LFS_SPI_SERDES_PARTITION_NAME	"SerDes LFS SPI NOR partition"
+#ifdef CONFIG_LFS_IMAGE_IN_RAM
+#define LFS_RAM_SERDES_PARTITION_NAME	"SerDes LFS backup partition"
+#endif
+
 static struct lfs_zephyrbd *zephyrbd_state;
 
 static int read_flash_chunk(uint32_t addr, uint32_t size, uint8_t *buf)
@@ -178,10 +183,19 @@
 	if (!rc)
 		rc = lfs_zephyrbd_init(&zephyrbd_state, LFS_SPI_SERDES_PARTITION);
 
-	if (rc)
-		LOG_ERR("Unable to mount SerDes LFS SPI NOR partition");
+	if (rc) {
+#ifdef CONFIG_LFS_IMAGE_IN_RAM
+		rc = lfs_zephyrbd_init(&zephyrbd_state, LFS_RAM_SERDES_PARTITION);
+		if (rc)
+			LOG_ERR("Unable to mount %s", LFS_RAM_SERDES_PARTITION_NAME);
+		else
+			LOG_INF("%s mounted successfully", LFS_RAM_SERDES_PARTITION_NAME);
+#else
+		LOG_ERR("Unable to mount %s", LFS_SPI_SERDES_PARTITION_NAME);
+#endif /* CONFIG_LFS_IMAGE_IN_RAM */
+	}
 	else
-		LOG_INF("SerDes LFS SPI NOR partition mounted successfully");
+		LOG_INF("%s mounted successfully", LFS_SPI_SERDES_PARTITION_NAME);
 
 	return rc;
 }
