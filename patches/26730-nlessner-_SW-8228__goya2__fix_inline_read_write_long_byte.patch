From ee45b6f09eb53896d63d8cd62ccedd6bc7f8b3bb Mon Sep 17 00:00:00 2001
From: Noam Lessner <nlessner@habana.ai>
Date: Wed, 29 Jan 2020 00:48:42 +0200
Subject: [PATCH] [SW-8228] goya2: fix inline read/write long/byte

Fix inline function to access memory regions.

Change-Id: I9d1e5e1f469cd08a89ede8c10f0d0971d44402ce
---

diff --git a/include/arcboot.h b/include/arcboot.h
index 20fe53b..2a4036a 100644
--- a/include/arcboot.h
+++ b/include/arcboot.h
@@ -21,15 +21,18 @@
 
 #define SPI_FLASH_BLOCK_SIZE			1024
 
-#define SDRAM_BASE				0x30000000
+#define HL_SDRAM_BASE				0x10000000
 #define HL_FLASH_OFFSET				0xA000000
 #define HL_SBROM_OFFSET				0xB040000
 #define HL_FWSRAM_OFFSET			0xB050000
 
 
-#define HL_FLASH_BASE				(SDRAM_BASE + HL_FLASH_OFFSET)
-#define HL_SBROM_BASE				(SDRAM_BASE + HL_SBROM_OFFSET)
-#define HL_FWSRAM_BASE				(SDRAM_BASE + HL_FWSRAM_OFFSET)
+#define HL_FLASH_BASE				(HL_SDRAM_BASE + \
+						 HL_FLASH_OFFSET)
+#define HL_SBROM_BASE				(HL_SDRAM_BASE + \
+						 HL_SBROM_OFFSET)
+#define HL_FWSRAM_BASE				(HL_SDRAM_BASE + \
+						 HL_FWSRAM_OFFSET)
 #define HL_CFG_BASE				0xFC000000
 
 //SPI FLASH CONST
@@ -60,7 +63,7 @@
 
 static inline u32 base_readl(u32 offset)
 {
-	u32 reg = *((volatile u32 *)(HL_CFG_BASE + offset));
+	u32 reg = *((volatile u32 *)(offset));
 
 	return reg;
 }
