From 578f1cc9380b6b082189b08889a7c3b4abecc4b7 Mon Sep 17 00:00:00 2001
From: Ran Shalit <rshalit@habana.ai>
Date: Mon, 07 Sep 2020 17:43:32 +0300
Subject: [PATCH] [SW-12754] gaudi: security: add pll protection

Add PLL protection using protection bits.

Change-Id: I39c73a950f5962fa5fa3c9085f8d8300bc9d8343
Signed-off-by: Ran Shalit <rshalit@habana.ai>
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/gaudi/security.c b/gaudi/security.c
index 7d87a63..ee4c69a 100644
--- a/gaudi/security.c
+++ b/gaudi/security.c
@@ -257,6 +257,17 @@
 	}
 }
 
+static void set_prot_bits_pages_range_all(u32 base, u32 dist, int count)
+{
+	int i;
+	u32 prot_base;
+
+	for (i = 0; i < count; i++) {
+		prot_base = base + dist * i;
+		set_prot_bits_range_all(prot_base, PROT_SIZE_MAX);
+	}
+}
+
 static void set_prot_bits_priv_int_conf(u64 page_base)
 {
 	/* Calculate the private protection bits base register */
@@ -317,6 +328,37 @@
 
 	/* Protect CPU_TIMESTAMP - 4K */
 	/* TODO: use RRs for CPU_TIMESTAMP protection */
+}
+
+static void preboot_secure_pll(void)
+{
+	u32 base;
+
+	/* DMA_W, IF_E, MESH_W, MESH_E */
+	base = mmDMA_W_PLL_BASE & ~HL_CFG_BASE;
+	set_prot_bits_pages_range_all(base, 0x20000, 4);
+
+	/* IF_W, DMA_E, SRAM_W, SRAM_E */
+	base = mmIF_W_PLL_BASE & ~HL_CFG_BASE;
+	set_prot_bits_pages_range_all(base, 0x20000, 4);
+
+	/* PSOC_CPU, PSOC_MME, PSOC_PCI, PSOC_TPC, PSOC_HBM */
+	base = mmPSOC_CPU_PLL_BASE & ~HL_CFG_BASE;
+	/*
+	 * TODO: the counter should be 5 to cover all 5 PSOC PLLs.
+	 * For the LKD to load successfully before the integration, skip the
+	 * PSOC_HBM_PLL. Once the HBM PLL data passing is implemented in LKD,
+	 * we can return this to 5.
+	 */
+	set_prot_bits_pages_range_all(base, 0x1000, 4);
+
+	/* NIC0, NIC1 */
+	base = mmNIC0_PLL_BASE & ~HL_CFG_BASE;
+	set_prot_bits_pages_range_all(base, 0x40000, 2);
+
+	/* NIC2_HBM, NIC2_MME, NIC2_TPC */
+	base = mmNIC2_HBM_PLL_BASE & ~HL_CFG_BASE;
+	set_prot_bits_pages_range_all(base, 0x1000, 3);
 }
 
 static void preboot_secure_psoc_global_conf(void)
@@ -556,6 +598,7 @@
 	preboot_secure_pci();
 	preboot_secure_mme();
 	preboot_secure_tpc();
+	preboot_secure_pll();
 
 	/* TODO: implement the rest of security enablement */
 
