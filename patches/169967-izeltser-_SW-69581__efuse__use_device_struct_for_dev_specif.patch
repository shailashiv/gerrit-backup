diff --git a/lib/common/efuse.c b/lib/common/efuse.c
index 8f31909..dab173a 100644
--- a/lib/common/efuse.c
+++ b/lib/common/efuse.c
@@ -6,8 +6,8 @@
  */
 
 #include <unistd.h>
-#include <psoc_efuse_regs.h>
 #include <preboot.h>
+#include <device.h>
 #include <boot_if.h>
 #include "efuse.h"
 #include "common.h"
@@ -23,26 +23,23 @@
 #define FUSE_TIMEOUT_US		100000
 #define FUSE_DELAY_US		20
 #define FUSE_RETRIES		(FUSE_TIMEOUT_US / FUSE_DELAY_US)
-#define FUSE_ALL_ADDRESSES	0x3F80
+
+struct device_efuse efuse;
 
 static int efuse_init;
 
 int preboot_fuse_init(void)
 {
 	int i;
-	u32 read_reg;
 
 	if (efuse_init == 1)
 		return -1;
 
-	regmap_writel(FUSE_ALL_ADDRESSES, mmPSOC_EFUSE_READ_ADDRESS);
-
-	read_reg = get_efuse_read_reg();
-
-	regmap_writel(1, read_reg);
+	regmap_writel(efuse.addr_range, efuse.read_address_reg);
+	regmap_writel(1, efuse.read_reg);
 
 	for (i = 0; i < FUSE_RETRIES; i++)
-		if (regmap_readl(read_reg))
+		if (regmap_readl(efuse.read_reg))
 			udelay(FUSE_DELAY_US);
 		else
 			break;
@@ -59,7 +56,7 @@
 	int offset, ret;
 	u32 read_val;
 
-	if (word >= FUSE_WORDS_PER_BANK) {
+	if (word >= efuse.words_per_bank) {
 		cpu_boot_err_set(CPU_BOOT_ERR_EFUSE_FAIL);
 		preboot_puts("Invalid efuse word offset\n");
 		return -1;
@@ -74,11 +71,11 @@
 
 	/* read value from bank0 */
 	offset = (word * sizeof(u32));
-	read_val = regmap_readl(mmPSOC_EFUSE_DATA_0 + offset);
+	read_val = regmap_readl(efuse.data_0_reg + offset);
 
 	/* read value from bank1 and OR with value from bank0 */
-	offset = ((FUSE_WORDS_PER_BANK + word) * sizeof(u32));
-	read_val |= regmap_readl(mmPSOC_EFUSE_DATA_0 + offset);
+	offset = ((efuse.words_per_bank + word) * sizeof(u32));
+	read_val |= regmap_readl(efuse.data_0_reg + offset);
 
 	*val = read_val;
 
