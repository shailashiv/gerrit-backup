From b78bf90346e950696ce75c1daf359a0c692a3dae Mon Sep 17 00:00:00 2001
From: Vitaly Margolin <vmargolin@habana.ai>
Date: Mon, 16 Jun 2025 14:22:10 +0300
Subject: [PATCH] [SW-232431] lfs: add support of lfs log cleaning

Add support of LFS based flash log cleaning

Change-Id: I800c05cca26836d8784c79d00c3ad1cf401e0526
Signed-off-by: Vitaly Margolin <vmargolin@habana.ai>
---

diff --git a/fw-loader/include/fit_loader_lfs.h b/fw-loader/include/fit_loader_lfs.h
index 04eadd5..9f5fbba 100644
--- a/fw-loader/include/fit_loader_lfs.h
+++ b/fw-loader/include/fit_loader_lfs.h
@@ -8,5 +8,6 @@
 #define FIT_LOADER_LFS_H
 
 int fit_load_log_read(const void *fit, int conf);
+int fit_load_log_cleanup(const void *fit, int conf);
 
 #endif
diff --git a/fw-loader/src/fit_loader.c b/fw-loader/src/fit_loader.c
index 5585918..be5a791 100644
--- a/fw-loader/src/fit_loader.c
+++ b/fw-loader/src/fit_loader.c
@@ -2108,6 +2108,14 @@
 		.post_load = false,
 		.pldm_pkg_version = false,
 	},
+	[FIT_LOAD_TYPE_CLEANUP_LOG] = {
+		.load = fit_load_log_cleanup,
+		.verify = NULL,
+		.secured_load = false,
+		.max_runtime_ms = 3 * MAX_RUNTIME_MINUTE,
+		.post_load = false,
+		.pldm_pkg_version = false,
+	},
 #endif
 };
 
diff --git a/fw-loader/src/fit_loader_lfs.c b/fw-loader/src/fit_loader_lfs.c
index 5b4c6b2..091ff8f 100644
--- a/fw-loader/src/fit_loader_lfs.c
+++ b/fw-loader/src/fit_loader_lfs.c
@@ -196,4 +196,34 @@
 	fw_heap_free(dir_buf);
 	return rc;
 }
+
+int fit_load_log_cleanup(const void *fit, int conf)
+{
+	int rc;
+	void *res_fit;
+	uint32_t res_fit_size = HL_FIT_SIMPLE_PROP_SIZE * 2;
+	const char *stage;
+	int err;
+
+	res_fit = fwupd_fit_rel_and_resp_fit_alloc(res_fit_size, &stage, &err);
+	if (!res_fit) {
+		LOG_ERR("Log cleanup %s failed: %d", stage, err);
+		return -EIO;
+	}
+
+	rc = fdt_property_u32(res_fit, HL_FIT_LOAD_TYPE_PROP, FIT_LOAD_TYPE_CLEANUP_LOG);
+	if (rc) {
+		LOG_ERR("Log cleanup failed, set %s failed: %d", HL_FIT_LOAD_TYPE_PROP, rc);
+		return rc;
+	}
+
+	rc = module_lfs_cleanup();
+	if (rc)
+		LOG_ERR("Failed to clean LFS logger partition, RC=%d", rc);
+	else
+		LOG_INF("LFS logger partition was cleaned successfully");
+
+	fdt_property_u32(res_fit, HL_FIT_VALUE_PROP, rc);
+	return rc;
+}
 #endif
