From 1371d5069d0ffa72f12ff175d2b4effc8b49eebd Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Thu, 24 Nov 2022 14:25:56 +0200
Subject: [PATCH] [SW-66329] pif_arc: fix status reporting

report status as a bit mask, instead of an enum

Change-Id: I92a8bb8bdbb994c46cf6a2fdc314ca9d30eb771c
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/app/pcie_pif/pcie_pif.c b/app/pcie_pif/pcie_pif.c
index b8851eb..cfaf5fb 100644
--- a/app/pcie_pif/pcie_pif.c
+++ b/app/pcie_pif/pcie_pif.c
@@ -53,12 +53,13 @@
 	regmap_writel(reg_val, pif_arc.error_reg);
 }
 
-static void flr_report_status(u32 stat_val)
+static void flr_report_status(u32 status_bit)
 {
-	if (stat_val >= STAT_LAST)
-		return;
+	u32 reg_val;
 
-	regmap_writel(stat_val, pif_arc.status_reg);
+	reg_val = regmap_readl(pif_arc.status_reg);
+	reg_val |= status_bit;
+	regmap_writel(reg_val, pif_arc.status_reg);
 }
 
 bool is_pcie_initialized(void)
@@ -78,7 +79,7 @@
 	regmap_writel(1, pif_arc.pf_flr_done);
 	pif_ts_delay(FLR_ACTIVE_SIG_WIDTH_US);
 	regmap_writel(0, pif_arc.pf_flr_done);
-	flr_report_status(STAT_FLR_DONE_REPORTED);
+	flr_report_status(PIF_STAT_FLR_DONE_REPORTED);
 }
 
 static inline bool pif_flr_rst_en(void)
@@ -97,7 +98,7 @@
 	}
 
 	regmap_writel(0, pif_arc.psoc2pif_die_ready);
-	flr_report_status(STAT_SEC_DIE_READY);
+	flr_report_status(PIF_STAT_SEC_DIE_READY);
 }
 
 static void set_flr_active(void)
@@ -105,7 +106,7 @@
 	regmap_writel(1, pif_arc.pif2psoc_flr_active);
 	pif_ts_delay(FLR_ACTIVE_SIG_WIDTH_US);
 	regmap_writel(0, pif_arc.pif2psoc_flr_active);
-	flr_report_status(STAT_INT_RESET_ACTIVE);
+	flr_report_status(PIF_STAT_INT_RESET_ACTIVE);
 }
 
 static void poll_flr_done(void)
@@ -120,7 +121,7 @@
 	}
 
 	regmap_writel(0, pif_arc.psoc2pif_flr_done);
-	flr_report_status(STAT_INT_RESET_DONE);
+	flr_report_status(PIF_STAT_INT_RESET_DONE);
 }
 
 #define PIF_ISOLATE_OUTBOUND	BIT(0)
@@ -145,7 +146,7 @@
 		}
 	}
 
-	flr_report_status(STAT_PCI_ACCESS_DISABLED);
+	flr_report_status(PIF_STAT_PCI_ACCESS_DISABLED);
 }
 
 static void enable_pci_access(void)
@@ -159,7 +160,7 @@
 	regval &= ~PIF_ISOLATE_OUTBOUND;
 	regmap_writel(regval, pif_arc.outbound_iso);
 
-	flr_report_status(STAT_PCI_ACCESS_ENABLED);
+	flr_report_status(PIF_STAT_PCI_ACCESS_ENABLED);
 }
 
 static void trigger_flr_reset(void)
@@ -176,7 +177,7 @@
 
 void pci_dev_specific_run(void)
 {
-	flr_report_status(STAT_FLR_EVENT_START);
+	flr_report_status(PIF_STAT_FLR_EVENT_START);
 	terminate_pci_access();
 	trigger_flr_reset();
 
@@ -190,7 +191,7 @@
 	/* TODO: wait for confirmation from FW that security preparations have finished */
 
 	enable_pci_access();
-	flr_report_status(STAT_FLR_EVENT_FINISH);
+	flr_report_status(PIF_STAT_FLR_EVENT_FINISH);
 
 	pif_ts_rearm_enable(true);
 }
@@ -205,7 +206,7 @@
 	flr_sts.primary_die = hl_get_die_id() ? false : true;
 	flr_sts.flr_sw_ctrl = true;
 	flr_sts.setup_done = true;
-	flr_report_status(STAT_FLR_INITIALIZED);
+	flr_report_status(PIF_STAT_FLR_INITIALIZED);
 }
 
 void pci_dev_specific_disable(void)
