From d966499714b1a5793f21cd69ac3f81272f8eed93 Mon Sep 17 00:00:00 2001
From: Alexey Puzhevich <alexey.puzhevich@intel.com>
Date: Mon, 16 Jun 2025 15:55:34 +0300
Subject: [PATCH] [JSW-934] jgs: preboot: run in simulation environment

The needed changes were introduced to enable ppboot
execution in simulation environment (Coral) on mwm_ww19_4 spec.

Change-Id: Iad87b2e5c32e20180c1136827193cbcf672c8a4a
Signed-off-by: Alexey Puzhevich <alexey.puzhevich@intel.com>
---

diff --git a/boards/intel/jgs/jgs_preboot_asic_defconfig b/boards/intel/jgs/jgs_preboot_asic_defconfig
index 7a7af82..9ae76ec 100644
--- a/boards/intel/jgs/jgs_preboot_asic_defconfig
+++ b/boards/intel/jgs/jgs_preboot_asic_defconfig
@@ -19,7 +19,7 @@
 CONFIG_LIBFDT=y
 CONFIG_LIBBOOTINFO=y
 # boot info addr is spsram base This address is yet to be finalized
-CONFIG_BOOTINFO_ADDR=0x78a00000
+CONFIG_BOOTINFO_ADDR=0x79df0000
 CONFIG_BOOTINFO_SIZE=0x8000
 CONFIG_LIBSOC_INIT=y
 CONFIG_HW_STACK_PROTECTION=y
