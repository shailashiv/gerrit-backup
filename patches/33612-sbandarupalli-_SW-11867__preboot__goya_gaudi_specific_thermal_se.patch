diff --git a/goya/common.c b/goya/common.c
index 4e1144b..5076969 100644
--- a/goya/common.c
+++ b/goya/common.c
@@ -19,6 +19,8 @@
 #include <uart.h>
 #include <string.h>
 #include <spi.h>
+#include <thermal.h>
+#include <string.h>
 
 #include "common.h"
 
@@ -194,3 +196,32 @@
 {
 	return mmCPU_TIMESTAMP_CNTCR;
 }
+
+#define GOYA_ASIC_TS_MAX_COUNT 3
+
+int hl_ts_get_count(void)
+{
+	return GOYA_ASIC_TS_MAX_COUNT;
+}
+
+/* Hard coded each of the goya on-chip TS device properties */
+struct hl_ts_cfg goya_hl_ts_data[GOYA_ASIC_TS_MAX_COUNT] = {
+	{.base = mmNORTH_THERMAL_SENSOR_BASE, .alarm_a = 110, .alarm_b = 120,
+		.calib_offset = 8, .use_calib = true, .hl_tmp_data = { 0 }},
+	{.base = mmPSOC_TS_BASE, .alarm_a = 110, .alarm_b =  120,
+		.calib_offset = 9, .use_calib = true, .hl_tmp_data = { 0 }},
+	{.base = mmTPC_THEMAL_SENSOR_BASE,  .alarm_a = 110, .alarm_b = 120,
+		.calib_offset = 10, .use_calib = true, .hl_tmp_data = { 0 }},
+};
+
+void hl_ts_data_init(void)
+{
+	goya_hl_ts_data[0].freq = hl_pll_get_freq(mmCPU_PLL_BASE,
+						HL_PLL_DIV2);
+	goya_hl_ts_data[1].freq = hl_pll_get_freq(mmPSOC_PCI_PLL_BASE,
+						HL_PLL_DIV1);
+	goya_hl_ts_data[2].freq = hl_pll_get_freq(mmTPC_PLL_BASE,
+						HL_PLL_DIV3);
+	memcpy(hl_ts_data, goya_hl_ts_data,
+		sizeof(struct hl_ts_cfg) * GOYA_ASIC_TS_MAX_COUNT);
+}
