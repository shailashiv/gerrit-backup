From 032022b7c5e46689a88c23abe46049f2d0e49878 Mon Sep 17 00:00:00 2001
From: Karthikeyan K <karthikk@habana.ai>
Date: Thu, 20 Jan 2022 04:22:15 +0200
Subject: [PATCH] [SW-69190] gaudi3: update address space for gaudi3

Define gaudi3 specific address space macros.

Change-Id: I8ce6b7bd13232a32fced6ccfd04814cf74d7fcea
---

diff --git a/arch/gaudi3/arc/soc.h b/arch/gaudi3/arc/soc.h
index 378e9f6..02619c9 100644
--- a/arch/gaudi3/arc/soc.h
+++ b/arch/gaudi3/arc/soc.h
@@ -7,11 +7,31 @@
 #define _SOC_H_
 #include <gaudi3_regs.h>
 
+enum region_idx {
+	REGION_ICCM_IDX = 0,
+	REGION_SRAM_IDX = 1,
+	REGION_FW_MEM_IDX = 2,
+	REGION_RSVD_IDX = 3,
+	REGION_V_MEM_0_IDX = 4,
+	REGION_V_MEM_1_IDX = 5,
+	REGION_V_MEM_2_IDX = 6,
+	REGION_V_MEM_3_IDX = 7,
+	REGION_DCCM_IDX = 8,
+	REGION_PCIE_LOWER_IDX = 9,
+	REGION_PCIE_UPPER_IDX = 10,
+	REGION_GEN_PURPOSE_0_IDX = 11,
+	REGION_D2D_HBW_IDX = 12,
+	REGION_GEN_PURPOSE_1_IDX = 13,
+	REGION_D2D_LBW_IDX = 14,
+	REGION_LBW_CFG_IDX = 15,
+};
+
 /* TODO: Replace with gaudi3 values */
 
 #define CPU_FREQ			500000000
 #define CPU_FREQ_US			500	/* CPU_FREQ / 1000000 */
 
+/* TODO: Remove unused defines */
 #define FW_SIZE				65535
 #define SIG_SIZE			384
 #define KEY_SIZE			784
@@ -19,38 +39,60 @@
 
 #define SPI_FLASH_BLOCK_SIZE		1024
 
-/* 2MB for Gaudi2 */
+#define REGION_BASE_ADDR(REG_IDX)	(REG_IDX << 28)
+#define SZ_256MB			0x10000000
+/* 2MB for Gaudi2 . TODO: Confirm for gaudi3 */
 #define FLASH_VALID_MASK		0x1FFFFF
 #define FLASH_VALID_OFFSET		0
 #define FLASH_VALID_MAX_SIZE		0x200000
 
-#define HL_SRAM_BASE			0x1000007FF0000000ULL
-#define HL_SP_SRAM_BASE			0x1000007FF7FE0000ULL
-#define HL_SRAM_PHY_BASE		0x1000FFFFFD000000ULL
+#define HL_SRAM_BASE_FULL          	0x0200FFFFF0000000ull
+
+#define HL_CFG_BASE			REGION_BASE_ADDR(REGION_LBW_CFG_IDX)
+#define HL_CFG_SIZE			SZ_256MB   /* 256MB */
+
+#define HL_GLOB_SRAM_BASE		REGION_BASE_ADDR(REGION_SRAM_IDX)
+#define HL_GLOB_SRAM_SIZE		SZ_256MB   /* 256MB */
+
+#define HL_ICCM_BASE			REGION_BASE_ADDR(REGION_ICCM_IDX)
+#define HL_ICCM_SIZE			0x40000   /* 256KB */
+
+#define HL_DCCM_BASE			REGION_BASE_ADDR(REGION_DCCM_IDX)
+#define HL_DCCM_SIZE			0x10000   /* 64KB */
+
+#define HL_D2D_LBW_BASE			REGION_BASE_ADDR(REGION_D2D_LBW_IDX)
+#define HL_D2D_LBW_SIZE			SZ_256MB   /* 256MB */
+
+#define HL_D2D_HBW_BASE			REGION_BASE_ADDR(REGION_D2D_HBW_IDX)
+#define HL_D2D_HBW_SIZE			SZ_256MB   /* 256MB */
+
+#define HL_FW_MEM_BASE			REGION_BASE_ADDR(REGION_FW_MEM_IDX)
+#define HL_FW_MEM_SIZE			SZ_256MB
 
 /*
  * This is not SDRAM Base, but the base address of General region
  * into which the rest of the components are mapped
  */
-#define HL_SDRAM_BASE			0x20000000
-#define HL_SRAM_LOG_BASE		0x11000000
+#define HL_SDRAM_BASE			HL_FW_MEM_BASE
 
-#define HL_FLASH_OFFSET			0x6000000
-#define HL_ICCM_OFFSET			0x7040000
-#define HL_SBROM_OFFSET			0x7FC0000
-#define HL_FWSRAM_OFFSET		0x7FD0000
-#define HL_SCRATCHPAD_SRAM_OFFSET	0x7FE0000
-#define HL_PCIE_FWSRAM_OFFSET		0x7FF0000
-#define HL_CFG_BASE			0xF8000000
-#define HL_ICCM_BASE			(HL_SRAM_BASE + HL_ICCM_OFFSET)
+#define HL_FLASH_OFFSET			0x2000000
+#define HL_ARC0_ICCM_OFFSET		0x3000000
+#define HL_ARC0_DCCM_OFFSET		0x3020000
+#define HL_ARC1_ICCM_OFFSET		0x3040000
+#define HL_ARC1_DCCM_OFFSET		0x3080000
+#define HL_ARC2_ICCM_OFFSET		0x30C0000
+#define HL_ARC2_DCCM_OFFSET		0x30E0000
+#define HL_ICCM_OFFSET			HL_ARC1_ICCM_OFFSET
+#define HL_SBROM_OFFSET			0x3100000
+#define HL_SCRATCHPAD_SRAM_OFFSET	0x3120000
+#define HL_FWSRAM_OFFSET		0x3140000
+#define HL_PCIE_FWSRAM_OFFSET		0x7F00000
 
-#define HL_ICCM_SIZE			0x20000
+#define HL_FW_MEM_BASE_FULL		0x0300007FD0000000ull
+/* TODO: Fix the macro name for HL_SRAM_BASE in common code.*/
+#define HL_SRAM_BASE			HL_FW_MEM_BASE_FULL
+#define HL_SP_SRAM_BASE			(HL_FW_MEM_BASE_FULL + HL_SCRATCHPAD_SRAM_OFFSET)
 #define HL_SP_SRAM_SIZE			0x10000
-#define HL_SRAM_PHY_SIZE		0x2FFFFF
-
-#define HL_ICCM_END			(HL_ICCM_BASE + HL_ICCM_SIZE - 1)
-#define HL_SP_SRAM_END			(HL_SP_SRAM_BASE + HL_SP_SRAM_SIZE - 1)
-#define HL_SRAM_PHY_END			(HL_SRAM_PHY_BASE +\
-					HL_SRAM_PHY_SIZE - 1)
+#define HL_MIRROR_CFG_BASE		HL_D2D_LBW_BASE
 
 #endif /* _SOC_H_ */
