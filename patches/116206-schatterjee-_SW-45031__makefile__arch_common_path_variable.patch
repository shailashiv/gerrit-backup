From e4d31965b0d689b88c107edbbfc53d7813add667 Mon Sep 17 00:00:00 2001
From: Subrata Chatterjee <schatterjee@habana.ai>
Date: Fri, 30 Jul 2021 21:39:50 +0300
Subject: [PATCH] [SW-45031] makefile: arch common path variable

To avoid repeat use of "../common/" in many places, created
a new variable HL_DEV_ARCH_COMMON.

Change-Id: Id65b8efc57c7ce9889e4c4e6537b73caeaf9d735
Signed-off-by: Subrata Chatterjee <schatterjee@habana.ai>
---

diff --git a/Makefile b/Makefile
index 2ce0406..63ea7bd 100644
--- a/Makefile
+++ b/Makefile
@@ -7,6 +7,7 @@
 	HL_DEV_SUBTYPE := arm
 endif
 HL_DEV_ARCH := arch/$(BASE_DEV_NAME)/$(HL_DEV_SUBTYPE)
+HL_DEV_ARCH_COMMON := arch/$(BASE_DEV_NAME)/common
 ifeq ($(BASE_DEV_NAME),greco)
 	BASE_DEV_NAME := goya2
 endif
@@ -17,7 +18,7 @@
 CFLAGS += -include $(SPECS_EMBEDDED_DIR)/$(SPECS_EMB_DEV)/$(SPECS_EMB_DEV)_reg_map.h
 CFLAGS += -Wall -Werror
 CFLAGS += -g -c -fno-builtin
-CFLAGS += -I ./include/ -I ./ -I ./lib/ -I ./lib/common/ -I ./$(HL_DEV_ARCH)/ -I ./$(HL_DEV_ARCH)/../common/
+CFLAGS += -I ./include/ -I ./ -I ./lib/ -I ./lib/common/ -I ./$(HL_DEV_ARCH)/ -I ./$(HL_DEV_ARCH_COMMON)/
 
 ifeq ($(HL_TARGET),pldm)
 	CFLAGS += -DTARGET_IS_PLDM
diff --git a/app/recovery/Makefile b/app/recovery/Makefile
index e700ee2..35c433a 100644
--- a/app/recovery/Makefile
+++ b/app/recovery/Makefile
@@ -3,6 +3,7 @@
 BASE_DEV_NAME := $(shell echo $(HL_DEV) | cut -d'_' -f1)
 HL_DEV_SUBTYPE := $(shell echo $(HL_DEV) | cut -d'_' -s -f2,3)
 HL_DEV_ARCH := arch/$(BASE_DEV_NAME)/$(HL_DEV_SUBTYPE)
+HL_DEV_ARCH_COMMON := arch/$(BASE_DEV_NAME)/common
 ifeq ($(BASE_DEV_NAME),greco)
 	BASE_DEV_NAME := goya2
 endif
@@ -24,10 +25,10 @@
 
 RECOVERY_SRCS_C := $(shell ls *.c)
 RECOVERY_SRCS_C += $(shell ls ../../lib/common/*.c)
-RECOVERY_SRCS_C += $(shell ls ../../$(HL_DEV_ARCH)/../common/common.c)
+RECOVERY_SRCS_C += $(shell ls ../../$(HL_DEV_ARCH_COMMON)/common.c)
 RECOVERY_SRCS_C += $(shell ls ../../$(HL_DEV_ARCH)/common.c)
 RECOVERY_SRCS_C += $(shell ls ../../$(HL_DEV_ARCH)/$(HL_TARGET).c)
-RECOVERY_SRCS_C += $(shell ls ../../$(HL_DEV_ARCH)/../common/$(HL_TARGET).c)
+RECOVERY_SRCS_C += $(shell ls ../../$(HL_DEV_ARCH_COMMON)/$(HL_TARGET).c)
 RECOVERY_APP_S := $(shell ls crt0_recovery.S)
 
 RECOVERY_OBJECTS := $(RECOVERY_SRCS_C:.c=.o)
diff --git a/arch/gaudi2/arc/Makefile b/arch/gaudi2/arc/Makefile
index e46a262..c58b8bf 100644
--- a/arch/gaudi2/arc/Makefile
+++ b/arch/gaudi2/arc/Makefile
@@ -1,4 +1,4 @@
-include $(HL_DEV_ARCH)/../common/Makefile
+include $(HL_DEV_ARCH_COMMON)/Makefile
 
 FW_SIZE := 0x8000
 PPBOOT_MAX_SIZE := 16384
diff --git a/arch/gaudi2/arm/Makefile b/arch/gaudi2/arm/Makefile
index 59568cc..a9ee777 100644
--- a/arch/gaudi2/arm/Makefile
+++ b/arch/gaudi2/arm/Makefile
@@ -1,4 +1,4 @@
-include $(HL_DEV_ARCH)/../common/Makefile
+include $(HL_DEV_ARCH_COMMON)/Makefile
 
 FW_SIZE := 0x4400
 PPBOOT_MAX_SIZE := 20480
diff --git a/arch/gaudi2/common/Makefile b/arch/gaudi2/common/Makefile
index e211ca5..3c20d65 100644
--- a/arch/gaudi2/common/Makefile
+++ b/arch/gaudi2/common/Makefile
@@ -1,5 +1,5 @@
-PREBOOT_SRCS_C += $(shell ls $(HL_DEV_ARCH)/../common/common.c)
-PREBOOT_SRCS_C += $(shell ls $(HL_DEV_ARCH)/../common/$(HL_TARGET).c)
+PREBOOT_SRCS_C += $(shell ls $(HL_DEV_ARCH_COMMON)/common.c)
+PREBOOT_SRCS_C += $(shell ls $(HL_DEV_ARCH_COMMON)/$(HL_TARGET).c)
 
-PPBOOT_SRCS_C += $(shell ls $(HL_DEV_ARCH)/../common/common.c)
-PPBOOT_SRCS_C += $(shell ls $(HL_DEV_ARCH)/../common/$(HL_TARGET).c)
+PPBOOT_SRCS_C += $(shell ls $(HL_DEV_ARCH_COMMON)/common.c)
+PPBOOT_SRCS_C += $(shell ls $(HL_DEV_ARCH_COMMON)/$(HL_TARGET).c)
