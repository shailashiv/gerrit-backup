From 5615a40c3bb8088e4d912dbce99fdc467723764d Mon Sep 17 00:00:00 2001
From: Varsha Maira <vmaira@habana.ai>
Date: Sat, 15 Jun 2024 14:55:09 +0300
Subject: [PATCH] [FSW-418] fs1: bootrom: paralellize tpm operations

This patch adds a finite state machine (FSM) to
interleave TPM operations with other functionalities.
Instead of waiting idly for TPM responses, the boot
ROM proceeds with other tasks and periodically keeps
checking for TPM responses. Each state has short
timeouts. If the FSM doesn't complete by the end of
boot ROM execution, a final long timeout-waited
TPM operation is performed.

This patch also adds a new bit to the progress_bit.h
to indicate that the FSM is out of sync.

Change-Id: Iac1c74bff10976f8b6b8434c8ae554d1e51b9672
Signed-off-by: Varsha Maira <vmaira@habana.ai>
---

diff --git a/arch/fs1/arc/common.c b/arch/fs1/arc/common.c
index f29a8f8..18f5c7c 100644
--- a/arch/fs1/arc/common.c
+++ b/arch/fs1/arc/common.c
@@ -20,6 +20,7 @@
 #include <status.h>
 #include <efuse.h>
 #include "dev_uart.h"
+#include "progress_bits.h"
 
 uint8_t boot_rom_get_die_id(void)
 {
@@ -264,6 +265,11 @@
 	boot_rom_set_tpm_next_pcr_index(TPM2_SVN_PCR_IDX);
 }
 
+bool boot_rom_is_manifest_valid(void)
+{
+	return (bool)boot_rom_global.validation_pass;
+}
+
 static bool boot_rom_get_svn(__unused uint8_t *hash)
 {
 	/*
@@ -302,3 +308,10 @@
 
 	return is_valid;
 }
+
+enum boot_rom_progress boot_rom_get_tpm_extend_fail_prog_bit(uint8_t tpm_pcr_index)
+{
+	return (tpm_pcr_index == TPM2_SVN_PCR_IDX) ?
+		PROGRESS_BOOT_ROM_SVN_TPM_PCR_EXTEND_FAIL :
+		PROGRESS_BOOT_ROM_MANIFEST_TPM_PCR_EXTEND_FAIL;
+}
