 		$(ZEPHYR_CONF_DEV_EXTRA_CFLAGS)
 
 AGENT_PCIE_CONF_APP_CFLAGS = \
@@ -56,11 +56,7 @@
 AGENT_PCIE_CONF_OPTS += -DBUILD_VERSION="$(AGENT_PCIE_APP_VERSION)"
 AGENT_PCIE_CONF_OPTS += -DBUILD_MACHINE="$(shell hostname -s)"
 AGENT_PCIE_CONF_OPTS += -DCMAKE_C_FLAGS="\
-		-I$(SPECS_EMBEDDED_DIR) \
-		-I$(SPECS_EMBEDDED_DIR)/$(DEV_PREFIX) \
