 AGENT_PCIE_DIR = build-agent-pcie
 
 AGENT_PCIE_CONF_APP_EXTRA_CFLAGS = \
-		-include $(EMBEDDED_ROOT)/specs/$(AGENT_PCIE_DEVICE_NAME)/$(AGENT_PCIE_DEVICE_NAME)_boot_info.h \
