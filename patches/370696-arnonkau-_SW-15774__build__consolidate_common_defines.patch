From 500e2de50e0f0a8c2e0bfc93ee84efcca7edcca2 Mon Sep 17 00:00:00 2001
From: Arnon Kaufman <akaufman@habana.ai>
Date: Tue, 14 Nov 2023 13:06:20 +0200
Subject: [PATCH] [SW-15774] build: consolidate common defines

Create a common file under the zephyr package for holding the common
configuration.

Change-Id: I741c5cdc98c07dd747ec82e6f1a5d8e27458a98d
Signed-off-by: Arnon Kaufman <akaufman@habana.ai>
---

diff --git a/package/agent-fwl/agent-fwl.mk b/package/agent-fwl/agent-fwl.mk
index 534366b..6cd2078 100644
--- a/package/agent-fwl/agent-fwl.mk
+++ b/package/agent-fwl/agent-fwl.mk
@@ -10,15 +10,12 @@
 AGENT_FWL_APP_VERSION = $(shell cut -d- -f2- $(@D)/localversion-habanalabs)
 AGENT_FWL_LOCAL_VERSION = $$(sed "s/^.*fw-\\([0-9]\\+\\.[0-9]\\+\\.[0-9]\\+\\).*$$/\\1/" $(@D)/localversion-habanalabs)
 
-DEV_PREFIX_UPPERCASE=$(call UPPERCASE,$(DEV_PREFIX))
-
 AGENT_FWL_DIR = build-agent-fw-loader
 
 AGENT_FWL_CONF_APP_EXTRA_CFLAGS = \
 		-include $(EMBEDDED_ROOT)/specs/$(AGENT_FWL_DEVICE_NAME)/$(AGENT_FWL_DEVICE_NAME)_boot_info.h \
-		$($(call UPPERCASE,$(DEV_PREFIX))_CONF_DEV_EXTRA_CFLAGS) \
+		$(COMMON_CONF_EXTRA_CFLAGS) \
 		$(ZEPHYR_CONF_DEV_EXTRA_CFLAGS)
-
 
 AGENT_FWL_CONF_APP_CFLAGS = \
 		-I$(AGENT_FWL_SRC_DIR)/../common/include \
diff --git a/package/agent-hbm/agent-hbm.mk b/package/agent-hbm/agent-hbm.mk
index 5e17486..3bf3065 100644
--- a/package/agent-hbm/agent-hbm.mk
+++ b/package/agent-hbm/agent-hbm.mk
@@ -15,7 +15,7 @@
 AGENT_HBM_DIR = build-agent-hbm
 
 AGENT_HBM_CONF_APP_EXTRA_CFLAGS = \
-		-include $(EMBEDDED_ROOT)/specs/$(AGENT_HBM_DEVICE_NAME)/$(AGENT_HBM_DEVICE_NAME)_boot_info.h \
+		$(COMMON_CONF_EXTRA_CFLAGS) \
 		$(ZEPHYR_CONF_DEV_EXTRA_CFLAGS)
 
 AGENT_HBM_CONF_APP_CFLAGS = \
@@ -63,11 +63,7 @@
 AGENT_HBM_CONF_OPTS += -DBUILD_VERSION="$(AGENT_HBM_APP_VERSION)"
 AGENT_HBM_CONF_OPTS += -DBUILD_MACHINE="$(shell hostname -s)"
 AGENT_HBM_CONF_OPTS += -DCMAKE_C_FLAGS="\
-		-I$(SPECS_EMBEDDED_DIR) \
-		-I$(SPECS_EMBEDDED_DIR)/$(DEV_PREFIX) \
-		-I$(SPECS_ROOT) \
-		-I$(SPECS_EXT_ROOT) \
-		-I$(SPECS_ROOT)/$(DEV_PREFIX)/asic_reg \
+		$(COMMON_SPECS_CFLAGS) \
 		$(AGENT_HBM_CONF_APP_CFLAGS)"
 
 AGENT_HBM_CONF_OPTS += -DDTS_EXTRA_CPPFLAGS="-I$(SPECS_EMBEDDED_DIR)"
diff --git a/package/agent-pcie/agent-pcie.mk b/package/agent-pcie/agent-pcie.mk
