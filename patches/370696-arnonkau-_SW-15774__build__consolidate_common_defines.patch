 AGENT_SERDES_CONF_APP_CFLAGS = \
diff --git a/package/event/event.mk b/package/event/event.mk
index 9b502c6..767019c 100644
--- a/package/event/event.mk
+++ b/package/event/event.mk
@@ -15,21 +15,11 @@
 EVENT_ZEPHYR_BUILD_DIR ?= $(@D)/zephyr
 
 EVENT_CONF_CFLAGS =\
-		-I$(EVENT_ZEPHYR_BUILD_DIR) \
-		-I$(EVENT_ZEPHYR_BUILD_DIR)/include \
-		-I$(EVENT_ZEPHYR_BUILD_DIR)/include/drivers/misc/hl_npu \
-		-I$(EVENT_ZEPHYR_BUILD_DIR)/include/drivers/misc/hl_npu/$(HL_DEV) \
-		-I$(EVENT_ZEPHYR_BUILD_DIR)/include/drivers/misc/hl_npu/common \
-		-I$(EVENT_ZEPHYR_BUILD_DIR)/drivers/misc/hl_npu \
-		-I$(EVENT_ZEPHYR_BUILD_DIR)/drivers/misc/hl_npu/$(HL_DEV) \
-		-I$(EVENT_ZEPHYR_BUILD_DIR)/drivers/misc/hl_npu/common \
-		-I$(EVENT_ZEPHYR_BUILD_DIR)/include/generated \
-		-I$(EVENT_ZEPHYR_BUILD_DIR)/include/generated/syscalls \
+		$(COMMON_DRV_CONF_CFLAGS) \
 		$(ZEPHYR_CONF_DEV_EXTRA_CFLAGS)
 
 EVENT_CONF_EXTRA_CFLAGS = \
-		-include $(EMBEDDED_ROOT)/specs/$(EVENT_DEVICE_NAME)/$(EVENT_DEVICE_NAME)_boot_info.h \
-		$($(call UPPERCASE,$(DEV_PREFIX))_CONF_DEV_EXTRA_CFLAGS) \
+		$(COMMON_CONF_EXTRA_CFLAGS) \
 		$(ZEPHYR_CONF_DEV_EXTRA_CFLAGS)
 
 ifeq ($(HL_TARGET),pldm)
diff --git a/package/mgmt/mgmt.mk b/package/mgmt/mgmt.mk
index da3b653..1f1d4b1 100644
--- a/package/mgmt/mgmt.mk
+++ b/package/mgmt/mgmt.mk
@@ -15,21 +15,11 @@
 MGMT_ZEPHYR_BUILD_DIR ?= $(@D)/zephyr
 
 MGMT_CONF_CFLAGS =\
-		-I$(MGMT_ZEPHYR_BUILD_DIR) \
-		-I$(MGMT_ZEPHYR_BUILD_DIR)/include \
-		-I$(MGMT_ZEPHYR_BUILD_DIR)/include/drivers/misc/hl_npu \
-		-I$(MGMT_ZEPHYR_BUILD_DIR)/include/drivers/misc/hl_npu/$(HL_DEV) \
-		-I$(MGMT_ZEPHYR_BUILD_DIR)/include/drivers/misc/hl_npu/common \
-		-I$(MGMT_ZEPHYR_BUILD_DIR)/drivers/misc/hl_npu \
-		-I$(MGMT_ZEPHYR_BUILD_DIR)/drivers/misc/hl_npu/$(HL_DEV) \
-		-I$(MGMT_ZEPHYR_BUILD_DIR)/drivers/misc/hl_npu/common \
-		-I$(MGMT_ZEPHYR_BUILD_DIR)/include/generated \
-		-I$(MGMT_ZEPHYR_BUILD_DIR)/include/generated/syscalls \
+		$(COMMON_DRV_CONF_CFLAGS) \
 		$(ZEPHYR_CONF_DEV_EXTRA_CFLAGS)
 
 MGMT_CONF_EXTRA_CFLAGS =\
-		-include $(EMBEDDED_ROOT)/specs/$(MGMT_DEVICE_NAME)/$(MGMT_DEVICE_NAME)_boot_info.h \
-		$($(call UPPERCASE,$(DEV_PREFIX))_CONF_DEV_EXTRA_CFLAGS) \
+		$(COMMON_CONF_EXTRA_CFLAGS) \
 		$(ZEPHYR_CONF_DEV_EXTRA_CFLAGS)
 
 ifeq ($(HL_TARGET),pldm)
diff --git a/package/zephyr/zephyr.mk b/package/zephyr/zephyr.mk
index 2517733..8870a6a 100644
--- a/package/zephyr/zephyr.mk
+++ b/package/zephyr/zephyr.mk
@@ -16,6 +16,30 @@
 endif
 endif
 
+COMMON_DRV_CONF_CFLAGS =\
+		-I$(BUILDDIR) \
+		-I$(BUILDDIR)/include \
+		-I$(BUILDDIR)/include/drivers/misc/hl_npu \
+		-I$(BUILDDIR)/include/drivers/misc/hl_npu/$(HL_DEV) \
+		-I$(BUILDDIR)/include/drivers/misc/hl_npu/common \
+		-I$(BUILDDIR)/drivers/misc/hl_npu \
+		-I$(BUILDDIR)/drivers/misc/hl_npu/$(HL_DEV) \
+		-I$(BUILDDIR)/drivers/misc/hl_npu/common \
+		-I$(BUILDDIR)/include/generated \
+		-I$(BUILDDIR)/include/generated/syscalls
+
+COMMON_CONF_CFLAGS =
+COMMON_CONF_EXTRA_CFLAGS =\
+		-include $(EMBEDDED_ROOT)/specs/$(DEVICE_NAME)/$(DEVICE_NAME)_boot_info.h \
+		$($(call UPPERCASE,$(DEV_PREFIX))_CONF_DEV_EXTRA_CFLAGS)
+
+COMMON_SPECS_CFLAGS = \
+		-I$(SPECS_EMBEDDED_DIR) \
+		-I$(SPECS_EMBEDDED_DIR)/$(DEV_PREFIX) \
+		-I$(SPECS_ROOT) \
+		-I$(SPECS_EXT_ROOT) \
+		-I$(SPECS_ROOT)/$(DEV_PREFIX)/asic_reg
+
 ZEPHYR_CONF_DEV_EXTRA_CFLAGS += \
 		-DCONFIG_HL_STACK_OVERFLOW_REDUCE_SIZE=$(STACK_REDUCTION_SIZE)
 
