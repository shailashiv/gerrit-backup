 export OBMC_PHOSPHOR_FULLCHIP_IMAGE_NAME = $(OBMC_PHOSPHOR_IMAGE_BASENAME).static.mtd.all.tar
 export OPENBMC_IMAGE_DIR = $(OPENBMC_WORK_DIR)/tmp/deploy/images/hls
-export OPENBMC_DEPLOY_DIR = $(OUTPUT_DIR)/build/openbmc-custom
+export HLS_DEPLOY_DIR = $(OUTPUT_DIR)/build/openbmc-custom
 unexport TEMPLATECONF
 
 ABS_OPENBMC_WORK_DIR = $(OPENBMC_DEPLOY_DIR)/$(OPENBMC_WORK_DIR)
 OPENBMC_DEVTOOL_SOURCES = $(ABS_OPENBMC_WORK_DIR)/workspace/sources
 
-define OPENBMC_BITBAKE_ENV
+ifeq ($(HL_DEV),hls)
+	include scripts/make/common/Makefile.openbmc
+endif
+
+define HLS_BITBAKE_ENV
 	BB_ENV_EXTRAWHITE+=" HL_VERSION HABANA_SOFTWARE_STACK HL_LINUX_ROOT HOME BUILD_ROOT OPENBMC_BUILD_CACHE"
 endef
 export OPENBMC_BITBAKE_ENV
 
-define OPENBMC_ENV
+define HLS_ENV
 	mkdir -p $(OPENBMC_WORK_DIR);				\
 	TEMPLATECONF=$(OPENBMC_ENV_FLAGS) source ./openbmc-env;
 endef
@@ -73,133 +77,11 @@
 	@echo '***************HLS ASIC INSTALL***************'
 	sshpass -p$(HL_PASSWD) $(SCP) $(IMAGES_DIR)/flash-hls-pkg.tgz	root@$(HL_INSTALL_LAB_IP):/tmp/
 
