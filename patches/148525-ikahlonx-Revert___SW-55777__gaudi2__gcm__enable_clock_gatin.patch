From a6e8670dfca7eaeea3206f668e7463e929da1f6e Mon Sep 17 00:00:00 2001
From: Idan Kahlon <idan.kahlon@tandemg.com>
Date: Fri, 19 Nov 2021 11:06:00 +0200
Subject: [PATCH] Revert "[SW-55777] gaudi2: gcm: enable clock gating"

This reverts commit 809ce3b9aaadcb05ff377f10b3cad786c1b82ea6.

Change-Id: I0dd34acccc97a9f200218ca18d221cea895249a4
---

diff --git a/app/preboot/preboot.c b/app/preboot/preboot.c
index e1bf13b..42ffabc 100644
--- a/app/preboot/preboot.c
+++ b/app/preboot/preboot.c
@@ -394,6 +394,7 @@
 void preboot_main(void)
 {
 	u64 ver_off = (uintptr_t)preboot_vers;
+	bool is_sec_en;
 
 	preboot_init_stack_monitor();
 	/* Initialize internal if variables */
@@ -446,8 +447,9 @@
 	preboot_security_dynamic_vers_init(ver_off, sizeof(preboot_vers));
 
 	preboot_led_on();
-
-	hl_clock_gating_init();
+	is_sec_en = preboot_security_is_enabled();
+	if (!is_sec_en)
+		hl_clock_gating_init();
 
 	hl_ram_init();
 	preboot_dev_enable_caps();
diff --git a/arch/gaudi/arm/asic.c b/arch/gaudi/arm/asic.c
