From c69c3a4b7775afba93677398e238532f81713254 Mon Sep 17 00:00:00 2001
From: Karthikeyan K <karthikk@habana.ai>
Date: Fri, 08 Oct 2021 13:25:51 +0300
Subject: [PATCH] [SW-56231] gaudi2: arc: increase preboot size

Increase gaudi2 arc preboot size from 56KB -> 57KB.

Change-Id: I25519e5c5abffb11c9016590b67f9fe27629d832
---

diff --git a/arch/gaudi2/arc/common.h b/arch/gaudi2/arc/common.h
index 58bf6a3..a1bb2e6 100644
--- a/arch/gaudi2/arc/common.h
+++ b/arch/gaudi2/arc/common.h
@@ -9,7 +9,7 @@
 #include <bitops.h>
 
 #define PPBOOT_SIZE			0x4000		/* 16KB */
-#define PREBOOT_SIZE			0xE000		/* 56KB */
+#define PREBOOT_SIZE			0xE400		/* 57KB */
 
 #define HL_FW_BOOT_PTRS_BASE		0x80000
 #define HL_SPI_LEGACY_PREBOOT_OFF	0xC0000
