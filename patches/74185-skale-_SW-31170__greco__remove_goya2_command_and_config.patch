diff --git a/scripts/make/goya2/Makefile b/scripts/make/goya2/Makefile
deleted file mode 100644
index b816795..0000000
--- a/scripts/make/goya2/Makefile
+++ /dev/null
@@ -1,47 +0,0 @@
-.PHONY: goya2-release
-goya2-release: hl-check-release
-	$(call hl-release-check-branch,$(RELEASE_REPOS_DIRS),origin)
-	$(call hl-release-eval,$(patsubst %-release,%,$@))
-	$(call hl-release-push,$(patsubst %-release,%,$@))
-	$(call hl-release-test,$(patsubst %-release,%,$@))
-
-.PHONY: goya2-asic-prepare goya2-onix-prepare goya2-pldm-prepare
-goya2-asic-prepare goya2-pldm-prepare goya2-onix-prepare:
-	@ # goya2 target doesn't need prepare as prepare and build of HL
-	@ # targets is taken care in global build. Since build_emb
-	@ # command used in jenkins builds performs prepare followed by
-	@ # build, added dummy prepare for global target.
-
-.PHONY: goya2-asic-build goya2-pldm-build goya2-onix-build
-goya2-asic-build: goya2_arc-asic-internal goya2_arc_gnu-asic-internal goya2_arm-asic-internal
-goya2-pldm-build: goya2_arc-pldm-internal goya2_arc_gnu-pldm-internal goya2_arm-pldm-internal
-goya2-onix-build: goya2_arc-onix-internal goya2_arc_gnu-onix-internal goya2_arm-onix-internal
-
-goya2%-internal:
-	@$(MAKE) $(patsubst %-internal,%,$@)-build
-
-.PHONY: goya2-install-host
-goya2-install-host:
-	@$(MAKE) hl-install-host HL_INSTALL_HOST_IP=$(HL_INSTALL_HOST_IP)
-
-.PHONY: goya2-asic-install goya2-onix-install
-goya2-onix-install: goya2_arm-onix-target goya2-install-host
-goya2-onix-install: HL_INSTALL_HOST_IP ?= emb-srv-host16
-
-goya2-asic-install: goya2_arm-asic-target goya2-install-host
-goya2-asic-install: HL_INSTALL_HOST_IP ?= emb-srv-host16
-goya2-onix-install goya2-asic-install:
-	@
-
-.PHONY: goya2-post-image
-goya2-post-image:
-	. ./board/habanalabs/common/post-image-fit-global.sh
-
-goya2-asic-build goya2-pldm-build goya2-onix-build:
-	@$(MAKE) goya2-post-image
-
-.PHONY: goya2-distclean
-goya2-distclean:
-	@$(MAKE) goya2_arm-distclean
-	@$(MAKE) goya2_arc-distclean
-	@$(MAKE) goya2_arc_gnu-distclean
