From a4e98eba7c8b3d5a1ea80f31b0951d47f05f0763 Mon Sep 17 00:00:00 2001
From: Sailaja <sbandarupalli@habana.ai>
Date: Thu, 08 Oct 2020 08:29:05 +0300
Subject: [PATCH] [SW-20979] goya2: tstd: update calibration coefficients

Fixed swapping of calibrated and uncalibrated coefficients

Change-Id: I986f510b916ffb21d877bae8f3345d866fa71ee9
Signed-off-by: Sailaja <sbandarupalli@habana.ai>
---

diff --git a/preboot/thermal_v2.c b/preboot/thermal_v2.c
index 7cfc445..862fe6b 100644
--- a/preboot/thermal_v2.c
+++ b/preboot/thermal_v2.c
@@ -73,12 +73,12 @@
  * Note that coefficients are multiplied by 100 for better
  * accuracy in result.
  */
-#define TS_CALIB_A_G_COEFF			5740
-#define TS_CALIB_B_H_COEFF			24940
-#define TS_CALIB_DIV_COEFF			4096
-#define TS_UNCALIB_A_G_COEFF			6567
-#define TS_UNCALIB_B_H_COEFF			25410
+#define TS_UNCALIB_A_G_COEFF			5740
+#define TS_UNCALIB_B_H_COEFF			24940
 #define TS_UNCALIB_DIV_COEFF			4096
+#define TS_CALIB_A_G_COEFF			6567
+#define TS_CALIB_B_H_COEFF			25410
+#define TS_CALIB_DIV_COEFF			4096
 
 #define HL_PVT_COMP_ID				0x00
 #define HL_PVT_COMP_ID_VALUE			0x9b487062
