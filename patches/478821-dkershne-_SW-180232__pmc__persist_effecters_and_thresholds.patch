+static void sensord_persist_sensor_thresholds(
+	struct hl_oobi_pldm_sensors *oobi, uint16_t sensor_id,
+	struct pldm_pmc_threshold_data *thresholds)
+{
+	struct hl_oobi_pldm_sensor_threshold *item = NULL;
+	struct hl_oobi_pldm_sensor_threshold *empty = NULL;
+
+	for (size_t i = 0; i < ARRAY_SIZE(oobi->sensor_thresholds); i++) {
+		if (oobi->sensor_thresholds[i].sensor_id == sensor_id) {
+			item = &oobi->sensor_thresholds[i];
+			break;
+		}
+		if (!empty && oobi->sensor_thresholds[i].sensor_id == 0)
+			empty = &oobi->sensor_thresholds[i];
+	}
+	if (!item)
+		item = empty;
+	if (!item) {
+		LOG_ERR("%s: Failed to persist thresholds  %d: table_full", __func__, sensor_id);
+		return;
+	}
+
+	item->sensor_id = sensor_id;
+	item->thresholds = *thresholds;
+	hl_oobi_pldm_sensor_persist_data(oobi);
+}
+
