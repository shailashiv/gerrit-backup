+static void pldm_restore_numeric_effecter(struct pldm_pmc_state *state,
+	struct hl_oobi_pldm_effecters *oobi)
+{
+	for (size_t i = 0; i < ARRAY_SIZE(oobi->numeric_effecters); ++i) {
+		struct pldm_numeric_effecter_entry *entry;
+		int err;
+
+		if (oobi->numeric_effecters[i].effecter_id == 0)
+			continue;
+
+		entry = find_numeric_effecter(state, oobi->numeric_effecters[i].effecter_id);
+		if (!entry)
+			continue;
+
+		err = pldm_update_numeric_effecter_value(entry, oobi->numeric_effecters[i].value);
+		if (err)
+			LOG_INF("%s: effecter value not set:  effecter %u err %d",
+				__func__, oobi->numeric_effecters[i].effecter_id, err);
+
+		entry->state.op_state = oobi->numeric_effecters[i].op_state;
+	}
+}
+
+static void pldm_restore_composite_state_effecter(
+	int index,
+	struct pldm_state_effecter_entry *entry,
+	const struct pldm_pdr_possible_states *possible_states,
+	struct hl_oobi_pldm_state_effecter *effecter)
+{
+	if (!is_valid_state_effecter_state(possible_states,
+					   effecter->composite_state[index].state)) {
+		LOG_WRN("%s: id %u composite %u unsupported new state %u",
+			__func__, effecter->effecter_id, index,
+			effecter->composite_state[index].state);
+		return;
+	}
+
+	if (entry->api.set) {
+		int err;
+
+		/* callback is responsible for all updates to state */
+		err = entry->api.set(&entry->pdr->state_effecter, &entry->state[index],
+				     index, effecter->composite_state[index].state);
+		if (err)
+			LOG_ERR("%s: error: effecter %u err %d", __func__,
+				effecter->effecter_id, err);
+	} else {
+		entry->state[index].pending_state = effecter->composite_state[index].state;
+		entry->state[index].present_state = effecter->composite_state[index].state;
+	}
+
+	entry->state[index].op_state = effecter->composite_state[index].op_state;
+}
+
+static void pldm_restore_state_effecter(struct pldm_pmc_state *state,
+	struct hl_oobi_pldm_effecters *oobi)
+{
+	struct hl_oobi_pldm_state_effecter *effecters = oobi->state_effecters;
+
+	for (size_t i = 0; i < ARRAY_SIZE(oobi->state_effecters); i++) {
+		struct pldm_state_effecter_entry *entry;
+		const struct pldm_pdr_state_effecter *pdr;
+
+		if (oobi->state_effecters[i].effecter_id == 0)
+			continue;
+
+		entry = find_state_effecter(state, effecters[i].effecter_id);
+		if (!entry)
+			continue;
+
+		pdr = &entry->pdr->state_effecter;
+		for (size_t c = 0; c < ARRAY_SIZE(effecters[i].composite_state); c++)
+			pldm_restore_composite_state_effecter(c, entry, &pdr->possible_states[c],
+							      &effecters[i]);
+	}
+}
+
+static void pldm_restore_effecters(struct hl_oobi_pldm_effecters *oobi)
+{
+	hl_oobi_pldm_effecter_restore_data(oobi);
+
+	pldm_restore_numeric_effecter(&state, oobi);
+	pldm_restore_state_effecter(&state, oobi);
+}
