+static void sensord_oobi_load_thresholds(void)
+{
+	struct hl_oobi_pldm_sensor_threshold *thresholds;
+
+	hl_oobi_pldm_sensor_restore_data(&sensord_state.oobi);
+
+	thresholds = sensord_state.oobi.sensor_thresholds;
+
+	for (size_t i = 0; i < ARRAY_SIZE(sensord_state.oobi.sensor_thresholds); i++) {
