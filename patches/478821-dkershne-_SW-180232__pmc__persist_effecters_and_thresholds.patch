+static int pldm_update_numeric_effecter_value(
+	struct pldm_numeric_effecter_entry *entry,
+	pldm_sensor_value_t value)
+{
+	const struct pldm_pdr_numeric_effecter *pdr;
+
+	pdr = &entry->pdr->numeric_effecter;
+
+	/* check range of value being set */
+	if (value.u32 < pdr->min_settable || value.u32 > pdr->max_settable) {
+		LOG_WRN("%s: effecter %d: invalid value=%d min=%d max=%d",
+			__func__, pdr->effecter_id, value.u32, pdr->min_settable,
+			pdr->max_settable);
+		return MCTP_STATUS_ERROR_INVALID_DATA;
+	}
+
+	/* verify effecter state */
+	if (!is_effecter_settable(entry->state.op_state)) {
+		LOG_WRN("%s: effector %u in invalid state %d for set",
+			__func__, pdr->effecter_id, entry->state.op_state);
+		return MCTP_STATUS_ERROR_UNSUPPORTED;
+	}
+
+	if (entry->api.set) {
+		int err;
+
+		/* callback is responsible for all updates to state */
+		err = entry->api.set(pdr, &entry->state, value);
+		if (err) {
+			LOG_ERR("%s: error: effecter %u err %d",
+				__func__, pdr->effecter_id, err);
+			return err;
+		}
+	} else {
+		/* no callback; immediate update of state */
+		entry->state.pending_value = value;
+		entry->state.present_value = value;
+		entry->state.op_state = PLDM_PMC_EFFECTER_OP_STATE_ENABLED_NO_UPDATE_PENDING;
+	}
+	return 0;
+}
