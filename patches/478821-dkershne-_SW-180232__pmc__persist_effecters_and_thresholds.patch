+static int sensord_oobi_remove_sensor_thresholds(
+	struct hl_oobi_pldm_sensors *oobi, uint16_t sensor_id)
+{
+	for (size_t i = 0; i < ARRAY_SIZE(oobi->sensor_thresholds); i++) {
+		if (oobi->sensor_thresholds[i].sensor_id == sensor_id) {
+			oobi->sensor_thresholds[i].sensor_id = 0;
+			hl_oobi_pldm_sensor_persist_data(oobi);
+
+			return 0;
+		}
+	}
+	return 0;
+}
