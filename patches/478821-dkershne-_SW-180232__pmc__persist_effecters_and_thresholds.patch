+static void pldm_persist_numeric_effecter(
+	struct pldm_numeric_effecter_entry *entry, struct hl_oobi_pldm_effecters *oobi)
+{
+	struct hl_oobi_pldm_numeric_effecter *item = NULL;
+	struct hl_oobi_pldm_numeric_effecter *empty = NULL;
+
+	for (size_t i = 0; i < ARRAY_SIZE(oobi->numeric_effecters); i++) {
+		if (oobi->numeric_effecters[i].effecter_id ==
+		    entry->pdr->numeric_effecter.effecter_id) {
+			item = &oobi->numeric_effecters[i];
+			break;
+		}
+		if (!empty && oobi->numeric_effecters[i].effecter_id == 0)
+			empty = &oobi->numeric_effecters[i];
+	}
+
+	if (!item)
+		item = empty;
+
+	if (!item) {
+		LOG_ERR("%s: Failed to persist effecter %d: table full.", __func__,
+			entry->pdr->numeric_effecter.effecter_id);
+		return;
+	}
+
+	item->effecter_id = entry->pdr->numeric_effecter.effecter_id;
+	item->op_state = entry->state.op_state;
+	item->value = entry->state.present_value;
+	hl_oobi_pldm_effecter_persist_data(oobi);
+}
