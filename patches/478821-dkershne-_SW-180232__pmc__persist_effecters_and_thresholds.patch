+static void pldm_persist_state_effecter(
+	struct pldm_state_effecter_entry *entry, struct hl_oobi_pldm_effecters *oobi)
+{
+	struct hl_oobi_pldm_state_effecter *item = NULL;
+	struct hl_oobi_pldm_state_effecter *empty = NULL;
+	const struct pldm_pdr_state_effecter *pdr = &entry->pdr->state_effecter;
+
+	for (size_t i = 0; i < ARRAY_SIZE(oobi->state_effecters); i++) {
+		if (oobi->state_effecters[i].effecter_id == pdr->effecter_id) {
+			item = &oobi->state_effecters[i];
+			break;
+		}
+		if (!empty && oobi->state_effecters[i].effecter_id == 0)
+			empty = &oobi->state_effecters[i];
+	}
+
+	if (!item)
+		item = empty;
+
+	if (!item) {
+		LOG_ERR("%s: Failed to persist state effecter %d: table full", __func__,
+			pdr->effecter_id);
+		return;
+	}
+
+	item->effecter_id = pdr->effecter_id;
+	for (size_t c = 0; c < ARRAY_SIZE(item->composite_state); c++) {
+		item->composite_state[c].op_state = entry->state[c].op_state;
+		item->composite_state[c].state = entry->state[c].present_state;
+	}
+	hl_oobi_pldm_effecter_persist_data(oobi);
+}
