-
-#include <libfdt.h>
-#include <string.h>
-#include <bitops.h>
-#include <security.h>
-#include <dev_security.h>
-#include <hl_boot_if.h>
-#include <arcboot.h>
-#include <hl_boot_desc.h>
-#include <fit_load_type.h>
-#include <boot_info.h>
-#include <hl_fw_if.h>
-#include "fit.h"
-#include "fit_rsa.h"
-#include "fit_regions.h"
-#include "cmd_module.h"
