-
-#define FIT_IMAGES_PATH			"/images"
-#define FIT_CONFS_PATH			"/configurations"
-
-#define FIT_CONF_NAME			"preboot-conf"
-#define FIT_DESC_PROP			"description"
-#define FIT_LOADABLE_PROP		"loadables"
-#define FIT_HASHED_NODES_PROP		"hashed-nodes"
-#define FIT_DATA_PROP			"data"
-#define FIT_HASH_PROP			"hash"
-#define FIT_LOADADDR_PROP		"loadaddr"
-#define FIT_STARTADDR_PROP		"startaddr"
-#define FIT_ARCH_PROP			"arch"
-#define FIT_COMPRESSION_PROP		"compression"
-
-#define FIT_SEC_VERSION			"hl-sec-version"
-#define FIT_SEC_KEY_IDX			"hl-sec-key-idx"
-#define FIT_SIG_NODENAME		"signature"
-#define FIT_VALUE_PROP			"value"
-#define FIT_ALGO_PROP			"algo"
-#define FIT_KEY_NAME_HINT		"key-name-hint"
-#define FIT_PUB_KEY_PROP		"pub-key"
-#define FIT_PUB_KEY_EXT_PROP		"pub-key-ext"
-#define FIT_LOAD_TYPE_PROP		"load-type"
-#define FIT_PUB_KEY_HASH_PROP		"hash"
-
-#define FIT_MAX_PATH			200
-#define MAX_FDT_REGIONS			20
-#define IMAGE_MAX_HASHED_NODES		20
-
-#define FIT_MAX_IMAGES			8
-
-#define FDT_MIN_SUPPORTED_VERSION	0x11
-#define FIT_MAX_KEY_NAME		64
-#define PREFIX_KEY			"key-"
-
-struct fit_image {
-	uint64_t loadaddr;
-	uint64_t startaddr;
-	const char *arch;
-};
-
-struct fit_image images[FIT_MAX_IMAGES];
-struct fdt_region fdt_regions[MAX_FDT_REGIONS];
-struct image_region region[MAX_FDT_REGIONS];
-static int arcboot_key_idx;
-
-__weak void arcboot_copy_image(uint64_t dst, const void *buf, int len,
-			       __unused const char *arch)
-{
-	memcpy((void *)(uintptr_t)dst, buf, len);
-}
-
-static const char *fit_loadables_name(const void *fit, int noffset, int id)
-{
-	return fdt_stringlist_get(fit, noffset, FIT_LOADABLE_PROP, id, NULL);
-}
-
-static int fit_find_config_node(const void *fit)
-{
-	int conf, node;
-	int dflt_conf_node = -1;
-
-	conf = fdt_path_offset(fit, FIT_CONFS_PATH);
-	if (conf < 0)
-		return -1;
-
-	for (node = fdt_first_subnode(fit, conf); node >= 0; node = fdt_next_subnode(fit, node)) {
-		const char *node_name = fdt_get_name(fit, node, NULL);
-
-		if (strcmp(FIT_CONF_NAME, node_name) == 0) {
-			dflt_conf_node = node;
-			break;
-		}
-	}
-
-	return dflt_conf_node;
-}
-
-static int fit_loadables_node_get(const void *fit, int id)
-{
-	int images, conf = fit_find_config_node(fit);
-	const char *uname = fit_loadables_name(fit, conf, id);
-
-	images = fdt_path_offset(fit, FIT_IMAGES_PATH);
-	return fdt_subnode_offset(fit, images, uname);
-}
-
-int fit_check_format(const void *fit)
-{
-	if (fdt_check_header(fit))
-		return FIT_FORMAT_HEADER_CHECK_FAILED;
-
-	/* mandatory / node 'description' property */
-	if (fdt_getprop(fit, 0, FIT_DESC_PROP, NULL) == NULL)
-		return FIT_FORMAT_NO_DESCRIPTION;
-
-	/* mandatory subimages parent '/images' node */
-	if (fdt_path_offset(fit, FIT_IMAGES_PATH) < 0)
-		return FIT_FORMAT_NO_IMAGES_PARENT_NODE;
-
-	return FIT_FORMAT_SUCCESS;
-}
-
-static int fit_get_int(const void *fit, int node, const char *prop_name,
-		       int default_val)
-{
-	const int *cell;
-	int len;
-
-	cell = fdt_getprop(fit, node, prop_name, &len);
-	if (cell && len >= (int) sizeof(int))
-		return fdt32_to_cpu(cell[0]);
-
-	return default_val;
-}
-
-static int get_algo_prop(const void *fit, int noffset, const uint8_t **algo_prop)
-{
-	int algo_prop_len;
-
-	*algo_prop = fdt_getprop(fit, noffset, FIT_ALGO_PROP, &algo_prop_len);
-	if (!(*algo_prop))
-		return 1;
-
-	if (algo_prop_len != sizeof(FIT_ALGO_PROP_EXPECTED_VALUE))
-		return 1;
-
-	if (memcmp((char *)*algo_prop, FIT_ALGO_PROP_EXPECTED_VALUE,
-			sizeof(FIT_ALGO_PROP_EXPECTED_VALUE)))
-		return 1;
-
-	return 0;
-}
-
-static int get_sig_hash(const void *fit, int noffset, const uint8_t **hash_value,
-			int *hash_value_len)
-{
-	*hash_value = fdt_getprop(fit, noffset, FIT_VALUE_PROP, hash_value_len);
-	if (!(*hash_value))
-		return 1;
-
-	return 0;
-}
-
-static int get_key_name(const void *fit, int noffset, const char **key_name)
-{
-	int key_name_len;
-
-	*key_name = fdt_getprop(fit, noffset, FIT_KEY_NAME_HINT, &key_name_len);
-	if (!(*key_name))
-		return 1;
-
-	return 0;
-}
-
-static int get_pub_key_node(const void *pub_key_fit, const char *key_name)
-{
-	int sig_node;
-	char key_node_name[FIT_MAX_KEY_NAME] = PREFIX_KEY;
-	size_t key_node_name_len = sizeof(PREFIX_KEY) - 1;
-
-	key_node_name[FIT_MAX_KEY_NAME - 1] = '\0';
-
-	strncpy(key_node_name + key_node_name_len,
-			key_name, (FIT_MAX_KEY_NAME - key_node_name_len - 1));
-	/*
-	 * To avoid stack based buffer overflow
-	 * make sure your key string length does not exceed buffer size.
-	 */
-	if (key_node_name[FIT_MAX_KEY_NAME - 1] != '\0')
-		return -1;
-
-	sig_node = fdt_subnode_offset(pub_key_fit, 0, FIT_SIG_NODENAME);
-
-	return fdt_subnode_offset(pub_key_fit, sig_node, key_node_name);
-}
-
-int fit_get_key_prop(const void *pub_key_fit, const char *key_name,
-			    struct key_prop *prop)
-{
-	int pub_key_node = 0;
-	int length;
-
-	if (fdt_check_header(pub_key_fit))
-		return 1;
-
-	pub_key_node = get_pub_key_node(pub_key_fit, key_name);
-	if (pub_key_node < 0)
-		return 1;
-
-	prop->num_bits =
-		fit_get_int(pub_key_fit, pub_key_node, "rsa,num-bits", 0);
-	prop->n0inv =
-		fit_get_int(pub_key_fit, pub_key_node, "rsa,n0-inverse", 0);
-	prop->public_exponent =
-		fdt_getprop(pub_key_fit, pub_key_node, "rsa,exponent", &length);
-	if (!prop->public_exponent || length < (int) sizeof(uint64_t))
-		prop->public_exponent = NULL;
-	prop->modulus =
-		fdt_getprop(pub_key_fit, pub_key_node, "rsa,modulus", NULL);
-	prop->rr =
-		fdt_getprop(pub_key_fit, pub_key_node, "rsa,r-squared", NULL);
-
-	if (!prop->num_bits || !prop->modulus)
-		return 1;
-
-	return 0;
-}
-
-static int fit_config_check_sig(const void *fit, int noffset,
-				const struct image_region region[],
-				int region_count, const void *pub_key_fit)
-{
-	const uint8_t *algo_prop = NULL;
-	const uint8_t *hash_value = NULL;
-	const char *key_name = NULL;
-	int hash_len = 0;
-	struct key_prop prop;
-
-	if (get_algo_prop(fit, noffset, &algo_prop))
-		return 1;
-
-	if (get_sig_hash(fit, noffset, &hash_value, &hash_len))
-		return 1;
-
-	if (get_key_name(fit, noffset, &key_name))
-		return 1;
-
-	if (fit_get_key_prop(pub_key_fit, key_name, &prop))
-		return 1;
-
-	return rsa_verify_regions(region, region_count, hash_value, hash_len,
-				  &prop);
-}
-
-static const char *fit_get_hashed_nodes(const void *fit, int noffset,
-					int *hashed_node_count, char **node_inc)
-{
-	const char *prop, *end, *name;
-	int prop_len;
-	int count;
-	int i;
-
-	/* Count the number of strings in the property */
-	count = fdt_stringlist_count(fit, noffset, FIT_HASHED_NODES_PROP);
-	if ((count == 0) || (count > IMAGE_MAX_HASHED_NODES))
-		return NULL;
-
-	prop = fdt_getprop(fit, noffset, FIT_HASHED_NODES_PROP, &prop_len);
-	end = prop ? prop + prop_len : prop;
-	*hashed_node_count = count;
-	for (name = prop, i = 0; name < end; name += strlen(name) + 1, i++)
-		node_inc[i] = (char *)name;
-
-	return prop;
-}
-
-static int fit_pub_key_node_get(const void *fit, __unused int conf)
-{
-	int images;
-
-	images = fdt_path_offset(fit, FIT_IMAGES_PATH);
-	return fdt_subnode_offset(fit, images, FIT_PUB_KEY_PROP);
-}
-
-static int fit_get_pub_key(const void *fit, int noffset, int sig_sub_node,
-			   const void **pub_key_fit, enum fit_sec_failure *res)
-{
-	int node, key_len, pub_key_node;
-	const void *key_data;
-	const char *key_name;
-
-	node = fit_pub_key_node_get(fit, noffset);
-	if (node < 0)
-		return 1;
-
-	key_data = fdt_getprop(fit, node, FIT_DATA_PROP, &key_len);
-	if (!key_data)
-		return 1;
-
-	arcboot_key_idx = fit_get_int(fit, 0, FIT_SEC_KEY_IDX, -1);
-	if (arcboot_key_idx < 0)
-		return 1;
-
-	*pub_key_fit = key_data;
-
-	/* Get modulus from public key */
-	if (fdt_check_header(*pub_key_fit))
-		return 1;
-
-	if (get_key_name(fit, sig_sub_node, &key_name))
-		return 1;
-
-	pub_key_node = get_pub_key_node(*pub_key_fit, key_name);
-	if (pub_key_node < 0)
-		return 1;
-
-	/* Update key data and key length with 384 bytes modulus */
-	key_data = fdt_getprop(*pub_key_fit, pub_key_node,
-			"rsa,modulus", &key_len);
-
-	if (security_check_key_revoke_status(arcboot_key_idx) != 1) {
-		*res = FIT_SEC_KEY_REVOKED;
-		return 1;
-	}
-
-	if (secureboot_verify_key_hash(arcboot_key_idx, (uint8_t *)key_data, key_len)) {
-		*res = FIT_SEC_SIGN_FAILED;
-		return 1;
-	}
-
-	return 0;
-}
-
-static bool fit_svn_is_valid(const void *fit)
-{
-	int sec_ver;
-
-	sec_ver = fit_get_int(fit, 0, FIT_SEC_VERSION, -1);
-	if (sec_ver < 0)
-		return false;
-
-	if (security_check_valid_fw_version(sec_ver) !=
-					SECURITY_FW_VERSION_SECURE)
-		return false;
-
-	return true;
-}
-
-static int fit_verify_config_regions(const void *fit,
-				     struct fdt_region *fdt_regions,
-				     int count, int sig_sub_node,
-				     const void *pub_key_fit)
-{
-	fit_region_make_list(fit, fdt_regions, count, region);
-
-	return fit_config_check_sig(fit, sig_sub_node, region, count,
-				    pub_key_fit);
-}
-
-/* Checks the signed FIT and validate it againts the public key */
-static int fit_verify_config(const void *fit, int noffset,
-			     enum fit_sec_failure *res)
-{
-	int sig_sub_node;
-	const char *hashed_node_prop;
-	int count, err;
-	char *node_inc[IMAGE_MAX_HASHED_NODES];
-	char * const exc_prop[] = { FIT_DATA_PROP };
-	char path[FIT_MAX_PATH];
-	const uint32_t *strings;
-	const void *pub_key_fit;
-
-	sig_sub_node = fdt_subnode_offset(fit, noffset, FIT_SIG_NODENAME);
-	if (sig_sub_node < 0)
-		return 1;
-
-	if (fit_get_pub_key(fit, noffset, sig_sub_node, &pub_key_fit, res))
-		return 1;
-
-	hashed_node_prop = fit_get_hashed_nodes(fit, sig_sub_node, &count,
-						node_inc);
-	if (!hashed_node_prop)
-		return 1;
-
-	/* Get a list of regions to hash */
-	count = fdt_find_regions(fit, node_inc, count, exc_prop,
-				 ARRAY_SIZE(exc_prop), fdt_regions,
-				 MAX_FDT_REGIONS - 1, path, sizeof(path), 0);
-
-	if ((count <= 0) || (count >= MAX_FDT_REGIONS - 1))
-		return 1;
-
-	/* Add the strings */
-	strings = fdt_getprop(fit, sig_sub_node, "hashed-strings", NULL);
-	if (strings) {
-		fdt_regions[count].offset = fdt_off_dt_strings(fit);
-		fdt_regions[count].size = fdt32_to_cpu(strings[1]);
-		count++;
-	}
-
-	err = fit_verify_config_regions(fit, fdt_regions, count, sig_sub_node,
-					pub_key_fit);
-	if (err) {
-		*res = FIT_SEC_SIGN_FAILED;
-		return err;
-	}
-
-	return 0;
-}
-
-static int fit_verify_security(const void *fit, int noffset,
-			       enum fit_sec_failure *res)
-{
-	if (!security_efuse_image_validation_en())
-		return 0;
-
-	if (!fit_svn_is_valid(fit)) {
-		*res = FIT_SEC_SVN_INVALID;
-		return 1;
-	}
-
-	/*
-	 * Security in enabled and SVN is valid all thats left is to check the
-	 * signature on the FIT.
-	 */
-	return fit_verify_config(fit, noffset, res);
-}
-
-static int fit_getprop_u64(const void *fit, int node, const char *name,
-			   uint64_t *val64)
-{
-	const uint32_t *val32;
-	int len;
-
-	val32 = fdt_getprop(fit, node, name, &len);
-	if (!val32 || len != sizeof(uint64_t))
-		return 1;
-
-	*val64 = ((uint64_t)fdt32_to_cpu(val32[0])) << 32;
-	*val64 |= fdt32_to_cpu(val32[1]);
-	return 0;
-}
-
-int fit_init_resp(void *fit, size_t sz)
-{
-	int err;
-
-	err = fdt_create(fit, sz);
-	if (err)
-		return err;
-
-	err = fdt_finish_reservemap(fit);
-	if (err)
-		return err;
-
-	err = fdt_begin_node(fit, "");
-	if (err)
-		return err;
-
-	return 0;
-}
-
-int fit_fin_resp(void *fit, unsigned int *res_size)
-{
-	int err;
-
-	if (!fdt_size_dt_strings(fit)) {
-		*res_size = 0;
-		return 0; /* Empty response */
-	}
-
-	err = fdt_end_node(fit);
-	if (err)
-		return err;
-
-	err = fdt_finish(fit);
-	if (err)
-		return err;
-
-	*res_size = fdt_totalsize(fit);
-
-	return err;
-}
-
-static int fit_copy_image(uint64_t dst, const void *buf, int len, const char *arch,
-			  const char *cmpr)
-{
-	if (!strcmp(cmpr, "none")) {
-		arcboot_copy_image(dst, buf, len, arch);
-		return 0;
-	}
-
-	return 1;
-}
-
-static bool fit_load_is_runnable(const void *fit, int conf)
-{
-	const uint32_t *cell;
-	uint32_t type;
-	int len;
-
-	cell = fdt_getprop(fit, conf, FIT_LOAD_TYPE_PROP, &len);
-
-	/* If load type does not exists, assume it's u-boot */
-	if (!cell)
-		return true;
-
-	if (len != sizeof(*cell))
-		return false;
-
-	type = fdt32_to_cpu(*cell);
-	if (type >= FIT_LOAD_TYPE_COUNT)
-		return false;
-
-	return type == FIT_LOAD_TYPE_RUN;
-}
-
-static const uint8_t *fit_node_get_hash(const void *fit, int node)
-{
-	int hash;
-	const char *prop;
-
-	hash = fdt_subnode_offset(fit, node, FIT_HASH_PROP);
-	prop = (const char *)fdt_getprop(fit, hash, FIT_ALGO_PROP, NULL);
-	if (strcmp(prop, FIT_SHA))
-		return NULL;
-
-	return (const uint8_t *)fdt_getprop(fit, hash, FIT_VALUE_PROP, NULL);
-}
-
-__weak void sha_csum(__unused const unsigned char *input, __unused unsigned int ilen,
-		__unused unsigned char *output)
-{
-}
-
-static int fit_node_check_hash(const void *fit, int node, const uint8_t *buf,
-			       int len)
-{
-	const uint8_t *node_hash = fit_node_get_hash(fit, node);
-	uint8_t calc_hash[SHA_SUM_LEN];
-
-	if (!node_hash)
-		return 1;
-
-	sha_csum(buf, len, calc_hash);
-	if (memcmp(node_hash, calc_hash, SHA_SUM_LEN))
-		return 1;
-
-	return 0;
-}
-
-__weak bool arcboot_rom_is_image_sig_supported(void) { return true; }
-
-__weak int arcboot_verify_img_sig(__unused const void *fit, __unused size_t img_size,
-				  __unused enum fit_sec_failure *res, __unused int *key_idx)
