-	return 1;
-}
-
-static int fit_verify_image(const void *fit, size_t fit_size, int conf,
-			    enum fit_sec_failure *res)
-{
-	/*
-	 * for platforms with image security descriptor support, the signature
-	 * of the descriptor is validated. otherwise the fit internal signature
-	 * is validated.
-	 */
-	if (!arcboot_rom_is_image_sig_supported())
-		return fit_verify_security(fit, conf, res);
-
-	return arcboot_verify_img_sig(fit, fit_size, res, &arcboot_key_idx);
-}
-
-static enum fit_load_result fit_copy_images(const void *fit,
-					    enum fit_sec_failure *res)
-{
-	int node, len;
-	int conf, num_images, i;
-	const uint8_t *buf;
-	uint64_t load, start;
-	const char *cmpr;
-	size_t fit_size = fdt_totalsize(fit);
-
-	/* Check if image supports a minimum FDT version or newer */
-	if (fdt_version(fit) < FDT_MIN_SUPPORTED_VERSION)
-		return FIT_LOAD_SEC_FAILED;
-
-	/* check that the calculated memory range are legal */
-	if (!arcboot_is_valid_address_range((uintptr_t)fit, fit_size))
-		return FIT_LOAD_SEC_FAILED;
-
-	/* Get number of images in preboot configuration */
-	conf = fit_find_config_node(fit);
-	if (conf < 0)
-		return FIT_LOAD_CORRUPTED;
-
-	if (!fit_load_is_runnable(fit, conf))
-		return FIT_LOAD_CORRUPTED;
-
-	if (fit_verify_image(fit, fit_size, conf, res))
-		return FIT_LOAD_SEC_FAILED;
-
-	num_images = fdt_stringlist_count(fit, conf, FIT_LOADABLE_PROP);
-	if (num_images > FIT_MAX_IMAGES)
-		return FIT_LOAD_CORRUPTED;
-	else if (num_images < 0)
-		return FIT_LOAD_CORRUPTED;
-
-	for (i = 0; i < num_images; i++) {
-		node = fit_loadables_node_get(fit, i);
-		if (node < 0)
-			return FIT_LOAD_NOT_RUNNABLE;
-
-		if (fit_getprop_u64(fit, node, FIT_LOADADDR_PROP, &load))
-			return FIT_LOAD_BAD_LOAD_ADDR;
-
-		if (fit_getprop_u64(fit, node, FIT_STARTADDR_PROP, &start))
-			start = load;
-
-		buf = fdt_getprop(fit, node, FIT_DATA_PROP, &len);
-		if (!buf)
-			return FIT_LOAD_CORRUPTED;
-
-		if (fit_node_check_hash(fit, node, buf, len))
-			return FIT_LOAD_CORRUPTED;
-
-		cmpr = (const char *)fdt_getprop(fit, node,
-						 FIT_COMPRESSION_PROP,
-						 NULL);
-		if (!cmpr) {
-			/*
-			 * mkimage is adding compression, if it's missing then
-			 * something is wrong.
-			 */
-			return FIT_LOAD_CORRUPTED;
-		}
-
-		if (!arcboot_is_valid_address_range(load, len))
-			return FIT_LOAD_BAD_LOAD_ADDR;
-
-		images[i].arch = (const char *)fdt_getprop(fit, node,
-							FIT_ARCH_PROP, NULL);
-		if (!images[i].arch)
-			return FIT_LOAD_CORRUPTED;
-
-		images[i].loadaddr = load;
-		images[i].startaddr = start;
-
-		if (fit_copy_image(load, buf, len, images[i].arch, cmpr))
-			return FIT_LOAD_CORRUPTED;
-	}
-
-	return FIT_LOAD_SUCCESS;
-}
-
-void fit_load_update_status(enum fit_load_result errtype)
-{
-	switch (errtype) {
-	case FIT_LOAD_BAD_LOAD_ADDR:
-	case FIT_LOAD_NOT_RUNNABLE:
-	case FIT_LOAD_CORRUPTED:
-		arcboot_rom_status_update(PROGRESS_ARCBOOT_ROM_FIT_LOAD_FAILED);
-		break;
-	case FIT_LOAD_SEC_FAILED:
-		arcboot_rom_status_update(PROGRESS_ARCBOOT_ROM_FIT_LOAD_SEC_FAILED);
-		break;
-	default:
-		arcboot_rom_status_update(PROGRESS_ARCBOOT_ROM_FIT_LOAD_UNKNOWN_ERROR);
-		break;
-	}
-}
-
-void fit_format_update_status(enum fit_format_result errtype)
-{
-	switch (errtype) {
-	case FIT_FORMAT_HEADER_CHECK_FAILED:
-		arcboot_rom_status_update(PROGRESS_ARCBOOT_ROM_FIT_FORMAT_HEADER_CHECK_FAILED);
-		break;
-	case FIT_FORMAT_NO_DESCRIPTION:
-		arcboot_rom_status_update(PROGRESS_ARCBOOT_ROM_FIT_FORMAT_NO_DESCRIPTION);
-		break;
-	case FIT_FORMAT_NO_IMAGES_PARENT_NODE:
-		arcboot_rom_status_update(PROGRESS_ARCBOOT_ROM_FIT_FORMAT_NO_IMAGES_PARENT_NODE);
-		break;
-	case FIT_FORMAT_CURRUPTED_LOAD_TYPE:
-		arcboot_rom_status_update(PROGRESS_ARCBOOT_ROM_FIT_FORMAT_CORRUPTED_LOAD_TYPE);
-		break;
-	case FIT_FORMAT_UNSUPPORTED_LOAD_TYPE:
-		arcboot_rom_status_update(PROGRESS_ARCBOOT_ROM_FIT_FORMAT_UNSUPPORTED_LOAD_TYPE);
-		break;
-	default:
-		arcboot_rom_status_update(PROGRESS_ARCBOOT_ROM_FIT_FORMAT_UNKNOWN_ERROR);
-		break;
-	}
-}
-
-static int fwupd_sec_convert_min_error(enum fit_sec_failure err)
-{
-	int serr;
-
-	switch (err) {
-	case FIT_SEC_KEY_REVOKED:
-		serr = HL_SEC_ERR_KEY_REVOKED;
-		break;
-	case FIT_SEC_SVN_INVALID:
-		serr = HL_SEC_ERR_SVN_INVALID;
-		break;
-	case FIT_SEC_SIGN_FAILED:
-		serr = HL_SEC_ERR_SIGN_FAILED;
-		break;
-	default:
-		serr = FIT_SEC_NONE;
-		break;
-	};
-
-	return serr;
-}
-
-int fit_load_images(void *fit)
-{
-	enum fit_sec_failure sec_res = FIT_SEC_NONE;
-	enum fit_load_result fit_load_error;
-	enum fit_format_result fit_format_error;
-
-	memset(&images, 0x0, sizeof(images));
-
-	fit_format_error = fit_check_format(fit);
-	if (fit_format_error) {
-		fit_format_update_status(fit_format_error);
-		fit_load_error = FIT_LOAD_CORRUPTED;
-	} else {
-		fit_load_error = fit_copy_images(fit, &sec_res);
-	}
-
-	switch (fit_load_error) {
-	case FIT_LOAD_SUCCESS:
-		return FIT_LOAD_SUCCESS;
-	case FIT_LOAD_SEC_FAILED:
-		arcboot_error_inform(HL_FW_ERR_SECURITY,
-				     fwupd_sec_convert_min_error(sec_res));
-		break;
-	default:
-		arcboot_error_inform(HL_FW_ERR_FIT, fit_load_error);
-		break;
-	}
-
-	fit_load_update_status(fit_load_error);
-	return fit_load_error;
-}
-
-void fit_run_image(void)
-{
-	uint64_t startaddr = 0;
-	uint32_t i;
-
-	for (i = 0; i < FIT_MAX_IMAGES; i++) {
-
-		if (strcmp(images[i].arch, "arc"))
-			continue;
-		/*
-		 * Since we only perform agent fit download as part
-		 * of ROM recovery, assumption is made here that
-		 * number of fit images will be 1 and agent will
-		 * run only on ARC.
-		 */
-		startaddr = images[i].startaddr;
-		break;
-	}
-
-	arcboot_start_image(startaddr);
-}
-
-__weak size_t arcboot_get_img_sec_desc_size(void)
-{
-	return 0;
-}
-
-int fit_validate_size(const void *fit, int len)
-{
-	size_t img_size = ROUND_UP4(fdt_totalsize(fit));
-
-	if (fdt_check_header(fit))
-		return 1;
-
-	/* taking the security footer into account */
-	img_size += arcboot_get_img_sec_desc_size();
-
-	return img_size != (size_t) len;
-}
-
-int fit_get_load_type(const void *fit, uint32_t *load_type)
-{
-	const uint32_t *cell;
-	uint32_t type = FIT_LOAD_TYPE_RUN;
-	int ret, len, conf;
-
-	ret = fit_check_format(fit);
-	if (ret)
-		return ret;
-
-	conf = fit_find_config_node(fit);
-	if (conf >= 0) {
-		cell = fdt_getprop(fit, conf, FIT_LOAD_TYPE_PROP, &len);
-		if (!cell) {
-			*load_type = type;
-			return FIT_FORMAT_SUCCESS;
-		}
-		if (len != sizeof(*cell))
-			return FIT_FORMAT_CURRUPTED_LOAD_TYPE;
-
-		type = fdt32_to_cpu(*cell);
-		if (type >= FIT_LOAD_TYPE_COUNT)
-			return FIT_FORMAT_UNSUPPORTED_LOAD_TYPE;
-	}
-
-	*load_type = type;
-
-	return ret;
-}
-
-static int fit_image_get_data(const void *fit, int noffset,
-		       const void **data, size_t *size)
-{
-	int len;
-
-	*data = fdt_getprop(fit, noffset, FIT_DATA_PROP, &len);
-	if (*data == NULL) {
-		*size = 0;
-		return -1;
-	}
-
-	*size = len;
-	return 0;
-}
-
-static int fit_image_get_node(const void *fit, const char *image_uname)
-{
-	int images_noffset;
-
-	images_noffset = fdt_path_offset(fit, FIT_IMAGES_PATH);
-	if (images_noffset < 0)
-		return images_noffset;
-
-	return fdt_subnode_offset(fit, images_noffset, image_uname);
-}
-
-static int fit_conf_get_prop_node_index(const void *fit, int noffset,
-				 const char *prop_name, int index)
-{
-	const char *uname;
-	int len;
-
-	/* get image unit name from configuration property */
-	uname = fdt_stringlist_get(fit, noffset, prop_name, index, &len);
-	if (uname == NULL)
-		return len;
-
-	return fit_image_get_node(fit, uname);
-}
-
-int fit_image_get_loadable_data(const void *fit, const void **data,
-				size_t size)
-{
-	size_t actual_size;
-	int err, node, conf;
-
-	conf = fit_find_config_node(fit);
-	if (conf < 0)
-		return 1;
-
-	node = fit_conf_get_prop_node_index(fit, conf, FIT_LOADABLE_PROP, 0);
-	if (node < 0)
-		return 1;
-
-	err = fit_image_get_data(fit, node, data, &actual_size);
-	if (err)
-		return err;
-
-	if (actual_size != size)
-		return 1;
-
-	return 0;
-}
-
-#define HL_SEC_REGIONS_CNT	2
-
-int fit_verify_img_sig(const void *img, size_t img_size, const void *sec_desc,
-		       size_t sec_desc_size, const void *pub_key_fit,
-		       const uint8_t *sig, size_t sig_len)
