From 809ce3b9aaadcb05ff377f10b3cad786c1b82ea6 Mon Sep 17 00:00:00 2001
From: Moria Zuberi <moria.zuberi@tandemg.com>
Date: Sun, 19 Sep 2021 11:23:07 +0300
Subject: [PATCH] [SW-55777] gaudi2: gcm: enable clock gating

Init clock gating for gaudi2.
Move security check into gaudi1 specific code.

NOTE: Increasing sram size to 63K in order to support
this feature.

Change-Id: Ide0e5a110e42f3566fafe7031c3a4b889a4edc6d
Signed-off-by: Moria Zuberi <moria.zuberi@tandemg.com>
---

diff --git a/app/preboot/preboot.c b/app/preboot/preboot.c
index de7671f..d72e910 100644
--- a/app/preboot/preboot.c
+++ b/app/preboot/preboot.c
@@ -386,7 +386,6 @@
 void preboot_main(void)
 {
 	u64 ver_off = (uintptr_t)preboot_vers;
-	bool is_sec_en;
 
 	preboot_init_stack_monitor();
 	/* Initialize internal if variables */
@@ -437,9 +436,8 @@
 	preboot_security_dynamic_vers_init(ver_off, sizeof(preboot_vers));
 
 	preboot_led_on();
-	is_sec_en = preboot_security_is_enabled();
-	if (!is_sec_en)
-		hl_clock_gating_init();
+
+	hl_clock_gating_init();
 
 	hl_ram_init();
 	preboot_dev_enable_caps();
diff --git a/arch/gaudi/arm/asic.c b/arch/gaudi/arm/asic.c
index 13ee112..c5462e6 100644
--- a/arch/gaudi/arm/asic.c
+++ b/arch/gaudi/arm/asic.c
@@ -222,6 +222,10 @@
 void hl_clock_gating_init(void)
 {
 	u32 i, base = 0, reg, val;
+	bool is_sec_en = preboot_security_is_enabled();
+
+	if (is_sec_en)
+		return;
 
 	for (i = PCI_DMA_1; i < GAUDI_DMA_MAX ; i++) {
 		base = i * DMA_QMAN_DIFF;
