-	#define ROTATOR_MASK 0x3
-	#define DECODER_ENABLED_MASK 0x1AB
+	#define ROTATOR_MASK 0x0
+	#define DECODER_ENABLED_MASK 0x0
 	#define NIC_PORTS_MASK 0
-	#define TPC_ENABLED_MASK 0x1020101
+	#define TPC_ENABLED_MASK 0x0
+	#define HMMU_HIF_ENABLED_MASK 0x0
 #else /* ASIC */
