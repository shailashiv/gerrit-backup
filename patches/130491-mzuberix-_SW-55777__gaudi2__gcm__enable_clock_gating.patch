 #include "hl.h"
 
@@ -61,6 +80,26 @@
 #define ARC_HALT_ACK_RETRIES		100
 #define ARC_RUN_ACK_TIMEOUT_US		100
 #define ARC_IS_RUNNING			BIT(0) /* arc's "is running" sts bit */
+
+#define TPC_CFG_CGU_CPE_CNT		8
+#define DCORE0_TPC0_CFG_CGU_CPE_SB_DISABLE_MASK	0x2000
+#define DCORE0_TPC0_QM_CGM_CFG_IDLE_TH_MASK	0xFFF
+#define DCORE0_TPC0_QM_CGM_CFG_G2F_TH_MASK	0xFF0000
+#define DCORE0_TPC0_QM_CGM_CFG_EN_MASK		0x80000000
+
+#define GAUDI2_TPC_CFG_CGU_CPE_MASK \
+	FIELD_PREP(DCORE0_TPC0_CFG_CGU_CPE_SB_DISABLE_MASK, 0x1)
+
+#define GAUDI2_QM_CGM_CFG_MASK \
+	(FIELD_PREP(DCORE0_TPC0_QM_CGM_CFG_IDLE_TH_MASK, 0x100) | \
+	FIELD_PREP(DCORE0_TPC0_QM_CGM_CFG_G2F_TH_MASK, 0x10) | \
+	FIELD_PREP(DCORE0_TPC0_QM_CGM_CFG_EN_MASK, 0x1))
+
+#define GAUDI2_KDMA_CGM_CFG_MASK \
+	(FIELD_PREP(DCORE0_TPC0_QM_CGM_CFG_IDLE_TH_MASK, 0x80) | \
+	FIELD_PREP(DCORE0_TPC0_QM_CGM_CFG_G2F_TH_MASK, 0x10) | \
+	FIELD_PREP(DCORE0_TPC0_QM_CGM_CFG_EN_MASK, 0x1))
+
 void lkd_dev_spec_regs(struct cpu_dyn_regs *regs)
 {
 	regs->cpu_pq_base_addr_low = mmCPU_IF_PQ_BASE_ADDR_LOW;
@@ -321,6 +360,167 @@
 	return !!(dump_sel & DUMP_SEL_SSC_MASK);
 }
 
+static void gaudi2_enable_tpc_clk_gating(int dcore, int inst, u32 offset)
+{
+	int j;
+
+	regmap_writel(GAUDI2_QM_CGM_CFG_MASK, mmDCORE0_TPC0_QM_CGM_CFG + offset);
+
+	/* H6-3040 keep CGU CPE SB disabled */
+	for (j = 0; j < TPC_CFG_CGU_CPE_CNT; j++)
+		regmap_writel(GAUDI2_TPC_CFG_CGU_CPE_MASK,
+			      mmDCORE0_TPC0_CFG_CGU_CPE_0 + (j * 4) + offset);
+}
+
+static void gaudi2_enable_all_tpcs_clk_gating(void)
+{
+	int dcore, inst, instances, tpc_seq = -1;
+	u32 offset;
+
+	for (dcore = 0; dcore < NUM_OF_DCORES; dcore++) {
+		instances = (dcore == 0) ?
+				NUM_DCORE0_TPC : NUM_OF_TPC_PER_DCORE;
+
+		for (inst = 0; inst < instances; inst++) {
+			tpc_seq++;
+
+			if (!(TPC_ENABLED_MASK & BIT(tpc_seq)))
+				continue;
+
+			offset = (DCORE_OFFSET * dcore) +
+				 (DCORE_TPC_OFFSET * inst);
+			gaudi2_enable_tpc_clk_gating(dcore, inst, offset);
+		}
+	}
+}
+
+void gaudi2_init_mme_clk_gating(void)
+{
+	int i, j, dcore_offs = 0;
+
+	for (i = 0; i < NUM_OF_DCORES; i++) {
+		if (!(MME_MASK & (1 << i)))
+			continue;
+
+		dcore_offs = i * DCORE_OFFSET;
+
+		regmap_writel(GAUDI2_QM_CGM_CFG_MASK, mmDCORE0_MME_QM_CGM_CFG +
+			      dcore_offs);
+		regmap_writel(0x210006, mmDCORE0_MME_CTRL_LO_EU + dcore_offs);
+		regmap_writel(0, mmDCORE0_MME_ACC_CLK_GATE_EN + dcore_offs);
+
+		for (j = 0; j < NUM_OF_MME_SBTE_PORTS; j++) {
+			regmap_writel(0x11, mmDCORE0_MME_SBTE0_ENABLE_CGATE +
+				dcore_offs + (j * DCORE_MME_SBTE_OFFSET));
+		}
+	}
+}
+
+void gaudi2_init_rotator_clk_gating(void)
+{
+	if (ROTATOR_MASK & BIT(0))
+		regmap_writel(GAUDI2_QM_CGM_CFG_MASK, mmROT0_QM_CGM_CFG);
+
+	if (ROTATOR_MASK & BIT(1))
+		regmap_writel(GAUDI2_QM_CGM_CFG_MASK, mmROT1_QM_CGM_CFG);
+}
+
+void gaudi2_init_sram_banks_clk_gating(void)
+{
+	int i, j;
+	u32 reg;
+
+	for (i = 0; i < NUM_OF_DCORES; i++) {
+		for (j = 0; j < NUM_OF_SRAM_BANK_PER_DCORE; j++) {
+			reg = mmDCORE0_SRAM0_BANK_CG_CTRL + (i * DCORE_OFFSET) +
+				(j * DCORE_SRAM_BANK_OFFSET);
+			regmap_writel(0xE00003, reg);
+		}
+	}
+}
+
+void gaudi2_init_edma_clk_gating(void)
+{
+	int i, j;
+	u32 reg;
+
+	for (i = 0; i < NUM_OF_DCORES; i++) {
+		if (!(EDMA_ENABLED_MASK & BIT(i)))
+			continue;
+
+		for (j = 0; j < NUM_OF_EDMA_PER_DCORE; j++) {
+			reg = mmDCORE0_EDMA0_QM_CGM_CFG +
+				(i * DCORE_OFFSET) + (j * DCORE_EDMA_OFFSET);
+			regmap_writel(GAUDI2_QM_CGM_CFG_MASK, reg);
+		}
+	}
+}
+
+void gaudi2_init_hif_clk_gating(void)
+{
+	int i, j;
+	u8 seq;
+	u32 reg;
+
+	for (i = 0; i < NUM_OF_DCORES; i++) {
+		for (j = 0; j < NUM_OF_HIF_PER_DCORE; j++) {
+			seq = i * NUM_OF_HIF_PER_DCORE + j;
+
+			if (!(HMMU_HIF_ENABLED_MASK & BIT(seq)))
+				continue;
+
+			reg = mmDCORE0_HIF0_CLOCK_GATE_CONFIG +
+				(i * DCORE_OFFSET) + (j * DCORE_HIF_OFFSET);
+			regmap_writel(0x5, reg);
+
+			reg = mmDCORE0_HMMU0_SCRAMB_OUT_CG_CONFIG +
+				(i * DCORE_OFFSET) + (j * DCORE_HMMU_OFFSET);
+			regmap_writel(0x33, reg);
+		}
+	}
+}
+
+void gaudi2_init_vdec_clk_gating(void)
+{
+	int i, j;
+	u32 reg;
+
+	for (i = 0; i < NUM_OF_DCORES; i++) {
+		for (j = 0; j < NUM_OF_VDEC_PER_DCORE; j++) {
+			if (!(DECODER_ENABLED_MASK & (1 << ((i * 2) + j))))
+				continue;
+
+			reg = mmDCORE0_VDEC0_BRDG_CTRL_CGM_DISABLE +
+				(i * DCORE_OFFSET) + (j * DCORE_VDEC_OFFSET);
+			regmap_writel(0, reg);
+		}
+	}
+}
+
+void hl_clock_gating_init(void)
+{
+	gaudi2_enable_all_tpcs_clk_gating();
+
+	gaudi2_init_mme_clk_gating();
+
+	gaudi2_init_rotator_clk_gating();
+
+	gaudi2_init_sram_banks_clk_gating();
+
+	gaudi2_init_edma_clk_gating();
+
+	regmap_writel(GAUDI2_QM_CGM_CFG_MASK, mmPDMA0_QM_CGM_CFG);
+	regmap_writel(GAUDI2_QM_CGM_CFG_MASK, mmPDMA1_QM_CGM_CFG);
+
+	regmap_writel(GAUDI2_KDMA_CGM_CFG_MASK, mmARC_FARM_KDMA_KDMA_CGM_CFG);
+
+	gaudi2_init_hif_clk_gating();
+
+	regmap_writel(0x1b, mmPMMU_PIF_CLOCK_GATE_CONFIG);
+
+	gaudi2_init_vdec_clk_gating();
+}
+
 uint8_t get_sris_mode_from_strap(void)
 {
 	uint32_t boot_strap;
