-	struct hit_regs hit;
-};
-
-enum hl_sec_engine_type {
-	HL_SEC_ENGINE_IF_RTR,
-	HL_SEC_ENGINE_PCIE,
-	HL_SEC_ENGINE_PSOC,
-	HL_SEC_ENGINE_SFT,
-};
-
-/*
- * There are 18(0..17 rr idx) RRs for LBW.
- * The classification and apis are as listed below:
- *
- * 1) 14(0..13 rr idx) Regions with 4KB granularity
- * API: hl_secure_lbw_rr(rr idx, min addr, max addr, rr sel)
- *
- * 2) 4(14..17 rr idx) Regions with full address range.
- * API: hl_secure_lbw_rr(rr idx, min addr, max addr, rr sel)
- *
- * rr idx type : gaudi2_sec_if_lbw_rrs
- * Based on the rr idx mentioned above the api would use
- * the short/full rrs.
- * NOTE: The apis listed above will block all read and write
- * transactions for the input address range.
- */
-enum gaudi2_sec_if_lbw_rrs {
-	HL_SEC_LBW_DBG_CFG_SPACE = 0,
-	HL_SEC_LBW_PSOC_GLBL_CONF = 1,
-	HL_SEC_LBW_MAX_RR_IDX = 18,
-};
-
-/*
- * There are 10(0..9 rr idx) RRs for HBW
- * NOTE: All the RRs for HBW are of 4KB granularity
- *
- * 1) 6(0..5 rr idx) Regions with 39 bit addressing
- * API: hl_secure_hbw_rr(rr idx, min addr, max addr, rr sel)
- *
- * 2) 2(6..7 rr idx) Regions with 50 bit addressing.
- * API: hl_secure_hbw_rr(rr idx, min addr, max addr, rr sel)
- *
- * 3) 2(8..9 rr idx) Regions with 50 bit addressing, to block only write.
- * API: hl_secure_hbw_rr(rr idx, min addr, max addr,  rr sel)
- *
- * rr idx type : gaudi2_sec_if_hbw_rrs
- */
-enum gaudi2_sec_if_hbw_rrs {
-	HL_SEC_HBW_SPI_FLASH = 0,
-	HL_SEC_HBW_ICCM0_TO_SP_SRAM = 1,
-	HL_SEC_HBW_PSOC_LBW = 2,
-	HL_SEC_HBW_SRAM_BGN = 3,
-	HL_SEC_HBW_SRAM_IMG = 4,
-	/*
-	 * HL_SEC_HBW_PSOC_LBW is a special case RR, because
-	 * for gaudi2 JT/MSTR/I2C RRs do not have a dedicated
-	 * LBW RR, but instead can use the HBW RRs to block
-	 * LBW Ranges.
-	 */
-	HL_SEC_HBW_SRAM = 6,
-	/*
-	 * SRAM END points to the first byte of HBM
-	 * hence a full rr needs to be used.
-	 */
-	HL_SEC_HBW_SRAM_END = HL_SEC_HBW_SRAM,
-	HL_SEC_HBW_SRAM_RO = 8,
-	HL_SEC_HBW_SF_RO = 9,
-	HL_SEC_HBW_MAX_RR_IDX = 10,
-};
-
-enum preboot_sec_dyn_rr_window {
-	SRAM_BGN_TO_IMG = 0,
-	IMAGE,
-	IMG_END_TO_SRAM_END,
-};
-
-struct preboot_sec_dyn_pcie_rr_cfg {
-	int rr;
-	u64 min;
-	u64 max;
-};
-
