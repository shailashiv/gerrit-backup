-	struct hbw_rr_addr max_short;
-	struct hbw_rr_addr min_full;
-	struct hbw_rr_addr max_full;
-	u32 hit_wr_breg;
-	u32 hit_rd_breg;
-};
-
-struct hit_regs {
-	u32 hit_wr;
-	u32 hit_rd;
-};
-
-/*
- * Single instance of range register. Helper structure
- * to generalize implementation between short and full.
- */
-struct lbw_rr_reg {
-	u32 rr_idx_calc;
-	u32 data_min;
-	u32 data_max;
-	u32 reg_min;
-	u32 reg_max;
-	struct hit_regs hit;
-};
-
-struct hbw_rr_reg {
-	u32 rr_idx_calc;
-	u64 data_min;
