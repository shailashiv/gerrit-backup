From cc7fd59a897d9396a14891785b8deb80b156a3dd Mon Sep 17 00:00:00 2001
From: Arnon Kaufman <akaufman@habana.ai>
Date: Sun, 18 Apr 2021 13:52:32 +0300
Subject: [PATCH] [SW-31823] fit: status response infrastructure

Till now the preboot handled fit as input only,
there is a need to have the ability of sending
fit as a back response.

The first use of this interface is the handling of the proto_status

Change-Id: I0cfb86ca2846c23428cbdf0d336a8aae2c5fd298
Signed-off-by: Arnon Kaufman <akaufman@habana.ai>
---

diff --git a/preboot/fit.c b/preboot/fit.c
index eba13db..cf7b8f4 100644
--- a/preboot/fit.c
+++ b/preboot/fit.c
@@ -633,6 +633,47 @@
 	return 0;
 }
 
+int fit_init_resp(void *fit, size_t sz)
+{
+	int err;
+
+	err = fdt_create(fit, sz);
+	if (err)
+		return err;
+
+	err = fdt_finish_reservemap(fit);
+	if (err)
+		return err;
+
+	err = fdt_begin_node(fit, "");
+	if (err)
+		return err;
+
+	return 0;
+}
+
+int fit_fin_resp(void *fit, unsigned int *res_size)
+{
+	int err;
+
+	if (!fdt_size_dt_strings(fit)) {
+		*res_size = 0;
+		return 0; /* Empty response */
+	}
+
+	err = fdt_end_node(fit);
+	if (err)
+		return err;
+
+	err = fdt_finish(fit);
+	if (err)
+		return err;
+
+	*res_size = fdt_totalsize(fit);
+
+	return err;
+}
+
 static int fit_copy_image(u64 dst, const void *buf, int len, const char *arch,
 			  const char *cmpr)
 {
