diff --git a/preboot/module_fwupd.c b/preboot/module_fwupd.c
index 1e40057..edf5508 100644
--- a/preboot/module_fwupd.c
+++ b/preboot/module_fwupd.c
@@ -4,11 +4,13 @@
  * All Rights Reserved.
  */
 
+#include <libfdt.h>
 #include <stdint.h>
 #include <inttypes.h>
 #include <string.h>
 
 #include <psoc_global_conf_regs.h>
+#include <boot_if.h>
 #include <hl_fw_if.h>
 #include <preboot.h>
 #include <fit_load_type.h>
@@ -19,8 +21,14 @@
 #include "pll.h"
 #include "fit.h"
 
-#define WFC_TIMEOUT_MS		500
-#define TIMEOUT_US		1000
+#define FIT_RSP_MARGIN_SIZE_IN_KB	0x400 /* 1KB */
+#define FIT_DFL_RSP_SIZE_IN_KB		0x1000 /* 4KB */
+
+#define WFC_TIMEOUT_MS			500
+#define TIMEOUT_US			1000
+
+#define HL_FIT_LOAD_TYPE_PROP		"load-type"
+#define HL_FIT_PROTO_STATUS_PROP	"protocol-status"
 
 static bool is_fit_checked;
 static unsigned int map_size;
@@ -61,6 +69,7 @@
 	case HL_UPD_MAP_SPSRAM:
 	case HL_UPD_RUN_SRAM:
 	case HL_UPD_RUN_SPSRAM:
+	case HL_UPD_GET_PROTO_STATUS:
 		return FOUND_SLOW_RETURN;
 	default:
 		return NOT_FOUND;
@@ -250,6 +259,84 @@
 		preboot_security_dynamic_img_spsram_open();
 }
 
+static int fwupd_create_resp(void *res_fit, const int load_type,
+		const char *prop_name, const void *prop_data,
+		int *prop_data_sz)
+{
+	int err;
+	unsigned int sz = 4 * 1024;
+
+	sz = ((*prop_data_sz + FIT_RSP_MARGIN_SIZE_IN_KB) > FIT_DFL_RSP_SIZE_IN_KB) ?
+		(*prop_data_sz + FIT_RSP_MARGIN_SIZE_IN_KB) : FIT_DFL_RSP_SIZE_IN_KB;
+
+	err = fit_init_resp(res_fit, sz);
+	if (err)
+		goto fit_init_err;
+
+	err = fdt_property_u32(res_fit, HL_FIT_LOAD_TYPE_PROP, load_type);
+	if (err)
+		goto fit_init_err;
+
+	err = fdt_property(res_fit, prop_name, prop_data, *prop_data_sz);
+	if (err)
+		goto fit_init_err;
+
+	err = fit_fin_resp(res_fit, &sz);
+	if (err)
+		goto fit_init_err;
+
+	*prop_data_sz = sz;
+
+fit_init_err:
+	return err;
+}
+
+static void fwupd_get_proto_status(struct hl_upd_proto_status *status, int err, int serr)
+{
+	status->version = HL_UPD_PROTO_VERSION;
+	status->compat_mask = cpu_boot_dev_sts_get_all();
+	status->fw_comp = HL_FW_COMP_PREBOOT;
+	status->err = err;
+	status->sub_err = serr;
+}
+
+static int fwupd_prepare_proto_status(void *res_fit, int rsp_err, int rsp_sub_err)
+{
+	struct hl_upd_proto_status status;
+	int size = sizeof(status);
+
+	fwupd_get_proto_status(&status, rsp_err, rsp_sub_err);
+
+	return fwupd_create_resp(res_fit, FIT_LOAD_TYPE_PROTO_STATUS,
+		HL_FIT_PROTO_STATUS_PROP, &status, &size);
+}
+
+static void module_fwupd_proto_status(void)
+{
+	int err;
+	enum hl_upd_sts sts;
+	void *offset;
+
+	module_fwupd_send_status(HL_UPD_STS_ACK, 0);
+	offset = (void *)preboot_shm_get_offset();
+	err = fwupd_prepare_proto_status(offset, 0, 0);
+	if (err)
+		goto fwupd_proto_sts_err;
+	err = module_fwupd_wfc(WFC_TIMEOUT_MS);
+	if (err)
+		goto fwupd_proto_sts_wfc;
+
+	module_fwupd_send_status(HL_UPD_STS_OK, offset);
+	return;
+
+fwupd_proto_sts_wfc:
+	sts = HL_UPD_STS_TIMEOUT_ERR;
+	preboot_puts("Timeout error\n");
+
+fwupd_proto_sts_err:
+	module_fwupd_send_status(sts, 0);
+}
+
 void module_fwupd_run(void)
 {
 	struct hl_upd_command cmd;
@@ -286,6 +373,10 @@
 		preboot_puts("FW UPD RUN SPSRAM received\n");
 		module_fwupd_run_cmd(cmd.cmd);
 		break;
+	case HL_UPD_GET_PROTO_STATUS:
+		preboot_puts("FW UPD PROTO STATUS received\n");
+		module_fwupd_proto_status();
+		break;
 	default:
 		break;
 	}
