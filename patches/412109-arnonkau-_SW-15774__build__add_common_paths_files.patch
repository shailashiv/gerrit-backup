index 0000000..bc4009b
--- /dev/null
+++ b/scripts/make/common/hl_dirs.mk
@@ -0,0 +1,7 @@
+# NOTE: should be in sync with board/habanalabs/common/dirs.sh
+
+export IMGS_DIR=$(OUTPUT_DIR)/images/
+export STAGE_DIR=$(IMGS_DIR)
+
+export DIRS_LIST = \
