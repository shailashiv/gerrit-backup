From 912d9bf3278ff8ec0629e791711fcdac52e52395 Mon Sep 17 00:00:00 2001
From: Guy Nisan <gnisan@habana.ai>
Date: Thu, 13 Jan 2022 13:57:37 +0200
Subject: [PATCH] [SW-69642] preboot: add signed types

Add signed types definitions

Change-Id: I97f3fa24e6120872c273d3ebcec87b2ef6ccae04
Signed-off-by: Guy Nisan <gnisan@habana.ai>
---

diff --git a/include/types.h b/include/types.h
index 46219fa..6f1f08c 100644
--- a/include/types.h
+++ b/include/types.h
@@ -8,9 +8,12 @@
 #define _TYPEDEFS_H_
 
 typedef unsigned char u8;
+typedef char s8;
 typedef unsigned int u32;
-typedef unsigned short int u16;
 typedef signed int s32;
+typedef unsigned short int u16;
+typedef short int s16;
 typedef unsigned long long u64;
+typedef long long s64;
 
 #endif /* _TYPEDEFS_H_ */
