From 9bfa7f45e2dd678e314ed98bfac7e0f4d2d4d765 Mon Sep 17 00:00:00 2001
From: Murala S Swamy <ssmurala@habana.ai>
Date: Fri, 28 Jun 2024 18:21:39 +0300
Subject: [PATCH] [FSW-420] fs1: initialize key revocation bits

with this patch, added support to initialize
security data structure with key revocation bits
and added function to check revoke status.

Change-Id: I8adae55c0438acb62868254900d773e8b853997d
---

diff --git a/arch/fs1/arc/Makefile b/arch/fs1/arc/Makefile
index ddb3593..ecb3e98 100644
--- a/arch/fs1/arc/Makefile
+++ b/arch/fs1/arc/Makefile
@@ -14,3 +14,4 @@
 BOOT_ROM_COMMON_SRCS_C += $(shell ls $(HL_DEV_ARCH)/dev_recovery.c)
 BOOT_ROM_COMMON_SRCS_C += $(shell ls $(HL_DEV_ARCH)/dev_boot_info.c)
 BOOT_ROM_COMMON_SRCS_C += $(shell ls $(HL_DEV_ARCH)/dev_dma.c)
+BOOT_ROM_COMMON_SRCS_C += $(shell ls $(HL_DEV_ARCH)/dev_security.c)
diff --git a/arch/fs1/arc/dev_security.c b/arch/fs1/arc/dev_security.c
new file mode 100644
index 0000000..58b73d6
--- /dev/null
+++ b/arch/fs1/arc/dev_security.c
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2024 HabanaLabs Ltd.
+ * All Rights Reserved.
+ */
+
+#include <boot_rom.h>
+#include <mem_io.h>
+#include <fs1_blocks_linux_driver.h>
+#include <psoc_security_regs.h>
+#include <fs1_reg_map.h>
+#include <fs1_efuse.h>
+#include <status.h>
+
+void security_load_revoke_bits(void)
+{
+	uint32_t key_revoke = boot_rom_global.config_fuse & EFUSE_SYSCFG_KEY_REVOCATION_BITS;
+
+	if (boot_rom_global.fake_fuse_en)
+		boot_rom_status_update(PROGRESS_REVOKE_LOC_SPI_FLASH);
+	else
+		boot_rom_status_update(PROGRESS_REVOKE_LOC_ASIC_EFUSE);
+
+	/* store key_revoke map in PSOC */
+	regmap_writel(key_revoke, IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_KEY_REVOKE));
+
+	boot_rom_global.sec_data.key_revoke = key_revoke;
+}
