diff --git a/common/security.c b/common/security.c
index 912b05e..c6ef7f0 100644
--- a/common/security.c
+++ b/common/security.c
@@ -6,6 +6,24 @@
  */
 
 #include <boot_rom.h>
+#include <dev_security.h>
+
+int security_check_key_revoke_status(uint32_t key_index)
+{
+	uint8_t key_revoke;
+
+	if (key_index >= NUM_KEYS_IN_ROM)
+		return -1;
+
+	key_revoke = boot_rom_global.sec_data.key_revoke;
+
+	/* if the key is not revoked, return 1 */
+	if ((key_revoke & (1 << key_index)) == 0)
+		return 1;
+
+	/* no valid key found */
+	return -1;
+}
 
 static void security_handle_jtag_if(void)
 {
@@ -27,5 +45,5 @@
 		return;
 
 	security_load_sec_efuse_dword();
+	security_load_revoke_bits();
 }
-
