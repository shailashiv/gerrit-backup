new file mode 100644
index 0000000..ecf5155
--- /dev/null
+++ b/arch/fs1/arc/dev_security.h
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Copyright (C) 2024 HabanaLabs Ltd.
+ */
+
+#ifndef _DEV_SECURITY_H_
+#define _DEV_SECURITY_H_
+
+#define NUM_KEYS_IN_ROM					5
+
+void security_load_revoke_bits(void);
+
+#endif /* _DEV_SECURITY_H_ */
