From 30fb087b8bd0fa4bb46a9e23260a7e2b24c27e99 Mon Sep 17 00:00:00 2001
From: Abhishek <apatgaonkar@habana.ai>
Date: Tue, 10 Aug 2021 14:34:39 +0300
Subject: [PATCH] [SW-56797] greco: new pcie phy fw

This patch adds new pcie phy firmware provided
by Synopsys.

// ===============================================================
//  This Firmware was generated using the following settings on
//  2021-Jun-07_16:08:50
// ===============================================================
// IPXACT         = e25_pma_1.3h_raw_1.4b_fw_3.5
// ASM_REVISION   = 92
// SET_EXCEL_FILE = esm25_adaptation_stats_hfsm_registers_v2.xlsx
// SET_EXCEL_REV  = 1.12
// SET_ADAPT_FILE =
// SET_ADAPT_REV  = 1.42
// PROC           = x081_e25_tsmc7ff
// PMA            = sds
// PARAM0         = E25_RAW_1_3
// PARAM1         = X081_E25_TSMC7FF
// PARAM2         = E25_RAW_1_4
// PARAM3         = E25_TSMC7FF
// PARAM4         = E25_PMA_1_3
// PARAM5         = SLC_RANGE_CALCULATION
// PARAM6         = ENABLE_RTRIM_BY_DEFAULT
// PARAM7         = P1_CPM_FW_WA
// PARAM8         =
//=======================================

Because of new FW, size change related defines are changed in make.
New fw size: 0x5400

FW_WORD_NUM macro was defined twice. This patch removes extra define.

Timeout for external load of phy fw is doubled to accommodate 32KB size

New Phy FW is changed only for arc boot flow as in Greco due to BTL
workaround is used to clear DCCM and always start ROM

Change-Id: I32b05ba25e35593db8df4abbc23d796f8694a698
---

diff --git a/arch/greco/arc_elf32/common.h b/arch/greco/arc_elf32/common.h
index b8fe030..70c0182 100644
--- a/arch/greco/arc_elf32/common.h
+++ b/arch/greco/arc_elf32/common.h
@@ -25,7 +25,7 @@
 #define PPBOOT_TEXT_BASE	(FW_SRAM_BASE + 0xC)
 #define PREBOOT_TEXT_BASE	(SDRAM_BASE + PPBOOT_SIZE + 0x8)
 
-#define FW_WORD_NUM		0x2200	/* FW_SIZE / 2 */
+#define FW_WORD_NUM		0x2A00	/* FW_SIZE / 2 */
 
 /* In order not to conflict with ARC BOOTROM's usage of DCCM,
  * Let PPBoot start from the offset of 8544 bytes, for using DCCM
@@ -50,8 +50,6 @@
 
 #define ARC_RST_VALUE		0x110
 #define ARC_RST_VEC_ADDR	0x0
-
-#define FW_WORD_NUM		0x2200	/* FW_SIZE / 2 */
 
 #ifndef __ASSEMBLY__
 extern void secondary_entry(void);
