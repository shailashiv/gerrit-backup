diff --git a/arch/gaudi3/arc/pldm.c b/arch/gaudi3/arc/pldm.c
index 7fb5f83..84aee1c 100644
--- a/arch/gaudi3/arc/pldm.c
+++ b/arch/gaudi3/arc/pldm.c
@@ -5,6 +5,9 @@
 #include <gaudi3_blocks_linux_driver.h>
 #include <d0_psoc_global_conf_regs.h>
 #include <d0_psoc_global_conf_masks.h>
+#include <d0_parc_arc0_cfg_regs.h>
+#include <d0_parc_arc2_cfg_regs.h>
+#include <d0_parc_local_cfg_regs.h>
 #include <common/pci_ids.h>
 #include <stddef.h>
 #include <bitops.h>
@@ -13,6 +16,7 @@
 #include <pll.h>
 #include <arcboot_export_dev.h>
 #include <boot_desc.h>
+#include <efuse.h>
 #include "hl.h"
 
 #define SYS_CLOCK_FREQUENCY	250000000ULL /* PCI PLL DIV3 SIMULATION CLK */
@@ -162,3 +166,79 @@
 
 	return dev_id;
 }
+
+#define UART_DIV_ID	3
+
+/*
+ * pcie pll is initialized by the boot fsm to nominal values (in secured boot mode). In order to
+ * support uart prints on pldm only div3 of the pci pll should be modified. Since div3 also impacts
+ * the baudrate of the d2d spi dma, pci pll of both dies should be carefully reconfigured first,
+ * before using the spi gw for data transfer.
+ */
+void btldr_pll_fixup(uint32_t die_id)
+{
+	gaudi3_cpu_pll_cfg[0].base = die_id ? mmD1_G4_PCI_PLL_CTRL_BASE : mmD0_G4_PCI_PLL_CTRL_BASE;
+
+	hl_pll_reconfig_div(gaudi3_cpu_pll_cfg, UART_DIV_ID);
+}
+
+void btldr_parc_prepare(void)
+{
+	/* ARC must not be in reset state when accessing the CCM modules */
+	regmap_writel(0, mmD0_PARC_ARC0_CFG_ARC_RST);
+	regmap_writel(0, mmD0_PARC_ARC2_CFG_ARC_RST);
+}
+
+#define EFUSE_APP_SIZE_OFFSET	55
+#define EFUSE_APP_SIZE_MASK	0x1
+
+static void btldr_copy_preboot_app(void)
+{
+	int err;
+	u32 val;
+
+	/*
+	 * Clean copy of the application is stored in ICCM0. In case the application binary
+	 * exceeds ICCM0 size, the rest is stored in ICCM2.
+	 * An efuse bit is controlling whether the application binary is larger than ICCM0 size.
+	 */
+	gaudi3_hbw_memcpy(ARC0_ICCM_FULL_BASE, ARC1_ICCM_FULL_BASE, ARC0_ICCM_SIZE);
+
+	err = preboot_fuse_read(EFUSE_APP_SIZE_OFFSET, &val);
+	if (err)
+		val = EFUSE_APP_SIZE_MASK;
+
+	val &= EFUSE_APP_SIZE_MASK;
+
+	if (!val)
+		return;
+
+	gaudi3_hbw_memcpy(ARC2_ICCM_FULL_BASE, ARC1_ICCM_FULL_BASE + ARC0_ICCM_SIZE,
+			  ARC1_ICCM_SIZE - ARC0_ICCM_SIZE);
+}
+
+static void btldr_copy_bootinfo(void)
+{
+	/*
+	 * Normally bootinfo is first written to spsram by the arcboot, so preboot rtos expects some
+	 * bootinfo data to be available when it runs. On PLDM, when running standalone preboot,
+	 * pre-recorded boot info data is loaded to the SPSRAM.
+	 * Since SPSRAM content is erazed on cold reboot, fresh copy stored in DCCM0 and copied
+	 * back to the SPSRAM as part of the preparation to run preboot rtos.
+	 */
+	gaudi3_hbw_memcpy(ARC0_DCCM_FULL_BASE, HL_SP_SRAM_BASE, ARC0_DCCM_SIZE);
+}
+
+void btldr_copy_data(void)
+{
+	btldr_copy_preboot_app();
+	btldr_copy_bootinfo();
+}
+
+#define APP_RST_VECTOR_ADDR	0 /* first address of the local ICCM */
+
+void btldr_exec_app(void)
+{
+	preboot_puts("pldm-bloader resigned\n");
+	preboot_start_image(APP_RST_VECTOR_ADDR, true);
+}
diff --git a/arch/gaudi3/arc/pldm_bloader.lds.S b/arch/gaudi3/arc/pldm_bloader.lds.S
new file mode 100644
index 0000000..4bfef04
--- /dev/null
+++ b/arch/gaudi3/arc/pldm_bloader.lds.S
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Copyright (C) 2023 HabanaLabs Ltd.
+ */
+
+OUTPUT_FORMAT("elf32-littlearc", "elf32-bigarc", "elf32-littlearc")
+OUTPUT_ARCH(arc)
+
+MEMORY
+{
+	ICCM	: ORIGIN = 0x00000000, LENGTH = 256K
+	SBROM	: ORIGIN = 0x23100000, LENGTH = 128K
+	DCCM	: ORIGIN = 0x80000000, LENGTH = 64K
+}
+
+REGION_ALIAS("REGION_IVT",	SBROM)
+REGION_ALIAS("REGION_TEXT",	SBROM)
+REGION_ALIAS("REGION_DATA",	DCCM)
+REGION_ALIAS("REGION_SDATA",	DCCM)
+REGION_ALIAS("REGION_BSS",	DCCM)
+REGION_ALIAS("REGION_STACK",	DCCM)
+
+ENTRY(__start)
+
+SECTIONS
+{
+	_dccm_begin = ORIGIN(DCCM);
+	_dccm_end = ORIGIN(DCCM) + LENGTH(DCCM);
+
+	.ivt : {
+		KEEP (*(.ivt));
+	} > REGION_IVT
+
+	.text : {
+		crt0_rom.o (.text*)
+		*(.text .text.* .rodata .rodata.*)
+		_etext = . ;
+	} > REGION_TEXT
+
+	.data : AT ( LOADADDR(.text) + SIZEOF(.text) ) {
+		_data_after_persist_sec = _etext;
+		_data = .;
+		_rom_non_persistent_dccm_start = .;
+		*(.data .data.*)
+	} > REGION_DATA
+
+	.sdata : AT ( LOADADDR(.data) + SIZEOF(.data) ) {
+		__SDATA_BEGIN__ = .;
+		*(.sdata .sdata.* .gnu.linkonce.s.*)
+		_edata = .;
+		PROVIDE (edata = .);
+	} > REGION_SDATA
+
+	.bss : {
+		*(.dynbss)
+		*(.bss .bss.* .gnu.linkonce.b.*)
+		*(COMMON)
+		/* Align here to ensure that the .bss section occupies space up to
+		_end. Align after .bss to ensure correct alignment even if the
+		.bss section disappears because there are no input sections. */
+		. = ALIGN(32 / 8);
+		_end = .;
+		PROVIDE (end = .);
+	} > REGION_BSS
+
+	.stack : {
+		. = ALIGN(32 / 8);
+		__stack = . ;
+		. = . + 2k;
+		__stack_top = . ;
+	} > REGION_STACK
+}
