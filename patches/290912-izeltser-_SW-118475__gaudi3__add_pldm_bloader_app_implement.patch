index 0e0cc7d..be43a62 100644
--- a/arch/gaudi3/arc/common.h
+++ b/arch/gaudi3/arc/common.h
@@ -35,6 +35,8 @@
 #define ARC1_ICCM_SIZE			SZ_256K
 #define ARC1_DCCM_FULL_BASE		0x300007FD3080000ull
 #define ARC1_DCCM_SIZE			SZ_64K
+#define ARC2_ICCM_FULL_BASE		0x300007FD30c0000ull
+#define ARC2_ICCM_SIZE			SZ_128K
 
 #define SRAM_MEM_REGION_BASE		0x10000000
 #define FW_MEM_REGION_BASE		0x20000000
