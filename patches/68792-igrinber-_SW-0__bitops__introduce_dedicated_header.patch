diff --git a/include/bitops.h b/include/bitops.h
new file mode 100644
index 0000000..ba2d559
--- /dev/null
+++ b/include/bitops.h
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Copyright (C) 2021 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+#ifndef _BITOPS_H_
+#define _BITOPS_H_
+
+#define BIT(nr)		(1 << (nr))
+
+/* extracts "n" number of bits from position "p" in the given number "v" */
+#define EXTRACT_BITS(v, p, n) (((v) & (((1 << (n)) - 1) << (p))) >> (p))
+
+
+#ifndef __ASSEMBLY__
+
+/*
+ * __ffs32: find first bit set. This is defined the same way as
+ * the libc and compiler builtin ffs routines, therefore
+ * differs in spirit from the above ffz (man ffs).
+ */
+
+static inline int __ffs32(unsigned int x)
+{
+	int r = 1;
+
+	if (!x)
+		return 0;
+
+	if (!(x & 0xffff)) {
+		x >>= 16;
+		r += 16;
+	}
+	if (!(x & 0xff)) {
+		x >>= 8;
+		r += 8;
+	}
+	if (!(x & 0xf)) {
+		x >>= 4;
+		r += 4;
+	}
+	if (!(x & 3)) {
+		x >>= 2;
+		r += 2;
+	}
+	if (!(x & 1)) {
+		x >>= 1;
+		r += 1;
+	}
+	return r;
+}
+
+#endif /* __ASSEMBLY__ */
+
+#endif /* _BITOPS_H_ */
