From b6be4e84f6b57030b07b681c5f43eff6f8b5d09d Mon Sep 17 00:00:00 2001
From: Josh Fazekas <Josh.Fazekas@Intel.com>
Date: Fri, 13 Jun 2025 21:31:41 +0300
Subject: [PATCH] [SW-229355] g3: pldm: SRAM fatal repair errors

Set sensor ID 339 - composite sensor index 2 - SRAM fatal repair errors
to return a default value of Operational Fault Status Normal

Change-Id: I601b555dfb1649cdfd81f8b5cd569c25bc7a73da
Signed-off-by: Josh Fazekas <Josh.Fazekas@Intel.com>
---

diff --git a/arch/gaudi3/ras/pldm/sensord_handlers.c b/arch/gaudi3/ras/pldm/sensord_handlers.c
index 8a5775e..c7869ed 100644
--- a/arch/gaudi3/ras/pldm/sensord_handlers.c
+++ b/arch/gaudi3/ras/pldm/sensord_handlers.c
@@ -2437,8 +2437,9 @@
 	count = hl_get_sram_fatal_events_count();
 	sample->composite[COMP_SENSOR_FATAL_RMA_ECC_SRAM_FATAL] = check_rma_error_state(count);
 
-	/* TODO: pull SRAM repair data once filled in */
-	sample->composite[COMP_SENSOR_FATAL_RMA_ECC_SRAM_FATAL_REPAIR] = 0;
+	/* TODO: report normal for now - pull SRAM repair data once filled in */
+	sample->composite[COMP_SENSOR_FATAL_RMA_ECC_SRAM_FATAL_REPAIR] =
+		PLDM_STATE_SET_OPERATIONAL_FAULT_STATUS_NORMAL;
 
 	count = hl_get_hbm_fatal_events_count();
 	sample->composite[COMP_SENSOR_FATAL_RMA_ECC_HBM_FATAL] = check_rma_error_state(count);
