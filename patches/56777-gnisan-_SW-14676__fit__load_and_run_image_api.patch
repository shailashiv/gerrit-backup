-	case FIT_LOAD_CORRUPTED:
-		cpu_boot_err_clrset(CPU_BOOT_ERR0_FIT_CORRUPTED, true);
-		preboot_puts("FIT loading failed, Retrying...\n");
-		break;
-	case FIT_LOAD_SEC_FAILED:
-		cpu_boot_err_clrset(CPU_BOOT_ERR0_SECURITY_FAIL, true);
-		preboot_puts("FIT security validation failed, Retrying...\n");
-		break;
-	}
+	sts.fit_not_checked = !!fit_load_images();
 }
 
 void module_lkd_run_noret(void)
@@ -103,7 +79,7 @@
 		wfe();
 		break;
 	case KMD_MSG_FIT_RDY:
-		preboot_fit_start_images(sts.images);
+		fit_run_image();
 		/* no break */
 	default:
 		break;
