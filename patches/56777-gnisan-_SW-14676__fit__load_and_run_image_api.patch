diff --git a/goya2_arc_gnu/common.c b/goya2_arc_gnu/common.c
index 6e25d0c..0b7f89c 100644
--- a/goya2_arc_gnu/common.c
+++ b/goya2_arc_gnu/common.c
@@ -138,28 +138,22 @@
 	*regs = mmPSOC_QSPI_CTRLR0;
 }
 
-void fit_copy_image(u64 dst, const void *buf, int len, const char *arch)
+void preboot_copy_image(u64 dst, const void *buf, int len, const char *arch)
 {
 	/* Prepare the ARC SRAM address */
 	u32 arc_dst = ((u32)dst & 0xFFFFFFF) | BIT(28);
 
-	preboot_puts_hex("FIT loadaddr: ", arc_dst, false);
-
 	memcpy((void *)arc_dst, buf, len);
 }
 
-void preboot_fit_start_images(struct fit_image *image)
+void preboot_start_image(u64 startaddr)
 {
 	void (*image_entry)(void);
 	u32 lsb, msb;
-	u32 i;
 
-	for (i = 0; i < FIT_MAX_IMAGES; i++) {
-		if (strcmp(image[i].arch, "arm64"))
-			continue;
-
-		lsb = (u32)image[i].startaddr;
-		msb = (u32)(image[i].startaddr >> 32);
+	if (startaddr) {
+		lsb = (u32)startaddr;
+		msb = (u32)(startaddr >> 32);
 		/* Set CPU0 Reset address to U-Boot */
 		regmap_writel(lsb, mmCPU_CA53_CFG_RST_ADDR_LSB_0);
 		regmap_writel(msb, mmCPU_CA53_CFG_RST_ADDR_MSB_0);
@@ -167,7 +161,6 @@
 		/* Wake up CPU0, after we put all CPUs in reset */
 		regmap_writel(0x0, mmCPU_CA53_CFG_ARM_RST_CONTROL);
 		regmap_writel(0x10111, mmCPU_CA53_CFG_ARM_RST_CONTROL);
-		break;
 	}
 
 	/*
diff --git a/preboot/fit.c b/preboot/fit.c
index e349975..cff802e 100644
--- a/preboot/fit.c
+++ b/preboot/fit.c
@@ -7,11 +7,15 @@
 
 #include <libfdt.h>
 #include <security.h>
+#include <hl_boot_if.h>
+#include <preboot.h>
+#include <boot_if.h>
 #include "common.h"
 #include "uart.h"
 #include "fit.h"
 #include "fit_rsa.h"
 #include "fit_regions.h"
+#include "cmd_module.h"
 
 #define FIT_IMAGES_PATH		"/images"
 #define FIT_CONFS_PATH		"/configurations"
@@ -40,8 +44,34 @@
 #define MAX_FDT_REGIONS		20
 #define IMAGE_MAX_HASHED_NODES	20
 
+#define FIT_MAX_IMAGES		8
+
+struct fit_image {
+	u64 loadaddr;
+	u64 startaddr;
+	const char *arch;
+};
+
+enum fit_load_result {
+	FIT_LOAD_SUCCESS = 0,
+	FIT_LOAD_CORRUPTED,
+	FIT_LOAD_SEC_FAILED,
+};
+
+struct fit_image images[FIT_MAX_IMAGES];
 struct fdt_region fdt_regions[MAX_FDT_REGIONS];
 struct image_region region[MAX_FDT_REGIONS];
+
+__weak void preboot_start_image(u64 startaddr)
+{
+	image_start(startaddr);
+}
+
+__weak void preboot_copy_image(u64 dst, const void *buf, int len,
+			       const char *arch)
+{
+	memcpy((void *)(uintptr_t)dst, buf, len);
+}
 
 __weak bool preboot_security_is_enabled(void)
 {
@@ -473,7 +503,17 @@
 	return 0;
 }
 
-enum fit_load_result fit_load_images(const void *fit, struct fit_image *images)
+static void fit_copy_image(u64 dst, const void *buf, int len, const char *arch)
+{
+	preboot_puts_raw("FIT loadaddr: 0x");
+	if (sizeof(void *) > sizeof(u32))
+		preboot_puth_raw((u32)(dst >> 32), false);
+	preboot_puth((u32)dst, false);
+
+	preboot_copy_image(dst, buf, len, arch);
+}
+
+static enum fit_load_result fit_copy_images(const void *fit)
 {
 	int node, len;
 	int conf, num_images, i;
@@ -530,3 +570,48 @@
 
 	return FIT_LOAD_SUCCESS;
 }
+
+int fit_load_images(void)
+{
+	void *fit = (void *)FIT_IMG_BASE;
+	int err;
+
+	memset(&images, 0x0, sizeof(images));
+
+	err = !fit_check_format(fit);
+	if (!err)
+		err = fit_copy_images(fit);
+
+	cpu_boot_err_clrset(CPU_BOOT_ERR0_FIT_CORRUPTED |
+			    CPU_BOOT_ERR0_SECURITY_FAIL, false);
+	switch (err) {
+	case FIT_LOAD_SUCCESS:
+		return 0;
+	case FIT_LOAD_CORRUPTED:
+		cpu_boot_err_clrset(CPU_BOOT_ERR0_FIT_CORRUPTED, true);
+		preboot_puts("FIT loading failed, Retrying...\n");
+		break;
+	case FIT_LOAD_SEC_FAILED:
+		cpu_boot_err_clrset(CPU_BOOT_ERR0_SECURITY_FAIL, true);
+		preboot_puts("FIT security validation failed, Retrying...\n");
+		break;
+	}
+
+	return 1;
+}
+
+void fit_run_image(void)
+{
+	u64 startaddr = 0;
+	u32 i;
+
+	for (i = 0; i < FIT_MAX_IMAGES; i++) {
+		if (strcmp(images[i].arch, "arm64"))
+			continue;
+
+		startaddr = images[i].startaddr;
+		break;
+	}
+
+	preboot_start_image(startaddr);
+}
