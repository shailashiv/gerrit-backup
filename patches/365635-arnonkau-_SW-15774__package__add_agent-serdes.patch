From a0a853fc638af4ec3756030984393ccb036ba9b9 Mon Sep 17 00:00:00 2001
From: Arnon Kaufman <akaufman@habana.ai>
Date: Sat, 21 Oct 2023 00:45:14 +0300
Subject: [PATCH] [SW-15774] package: add agent-serdes

Add a package to build the SERDES agent

Change-Id: I02f2931017c5ab8fec68ff0c1841cba3f3bd1575
Signed-off-by: Arnon Kaufman <akaufman@habana.ai>
---

diff --git a/board/habanalabs/common/local.mk b/board/habanalabs/common/local.mk
index d5e8a0b..6dc76b3 100644
--- a/board/habanalabs/common/local.mk
+++ b/board/habanalabs/common/local.mk
@@ -27,3 +27,4 @@
 AGENT_FWL_OVERRIDE_SRCDIR = $(TOPDIR)/../zephyr-plugins
 AGENT_HBM_OVERRIDE_SRCDIR = $(TOPDIR)/../zephyr-plugins
 AGENT_PCIE_OVERRIDE_SRCDIR = $(TOPDIR)/../zephyr-plugins
+AGENT_SERDES_OVERRIDE_SRCDIR = $(TOPDIR)/../zephyr-plugins
diff --git a/package/agent-serdes/agent-serdes.mk b/package/agent-serdes/agent-serdes.mk
new file mode 100644
index 0000000..40cef77
--- /dev/null
+++ b/package/agent-serdes/agent-serdes.mk
@@ -0,0 +1,134 @@
+AGENT_SERDES_APP_NAME = serdes
+AGENT_SERDES_DEPENDENCIES = host-cmake host-lzop host-lz4
+AGENT_SERDES_APP_MODULES = eeprom mbedtls boot_info i2c-indirect soc_init
+
+AGENT_SRC_DIR=$(EMBEDDED_DIR)/zephyr-plugins
+AGENT_MARGIN_TOOL_SRC_DIR=$(AGENT_SRC_DIR)/margin-tools
+AGENT_SERDES_SRCDIR=$(AGENT_MARGIN_TOOL_SRC_DIR)/serdes
+AGENT_SERDES_SRC_DIR=$(AGENT_MARGIN_TOOL_SRC_DIR)/serdes
+AGENT_SERDES_ZEPHYR_SRCDIR=$(EMBEDDED_DIR)/zephyr
+AGENT_SERDES_APP_PROD_NAME = zephyr_$(HL_TARGET)_$(AGENT_SERDES_APP_NAME)
+AGENT_SERDES_DEVICE_NAME = $(firstword $(subst _, ,$(HL_DEV)))
+AGENT_SERDES_APP_VERSION = $(shell cut -d- -f2- $(@D)/localversion-habanalabs)
+AGENT_SERDES_LOCAL_VERSION = $$(sed "s/^.*fw-\\([0-9]\\+\\.[0-9]\\+\\.[0-9]\\+\\).*$$/\\1/" $(@D)/localversion-habanalabs)
+
+AGENT_SERDES_DIR = build-agent-serdes
+
+AGENT_SERDES_CONF_APP_EXTRA_CFLAGS = \
+		-include $(EMBEDDED_ROOT)/specs/$(AGENT_SERDES_DEVICE_NAME)/$(AGENT_SERDES_DEVICE_NAME)_boot_info.h \
+		$($(call UPPERCASE,$(DEV_PREFIX))_CONF_DEV_EXTRA_CFLAGS) \
+		$(ZEPHYR_CONF_DEV_EXTRA_CFLAGS)
+
+AGENT_SERDES_CONF_APP_CFLAGS = \
+		-I$(AGENT_MARGIN_TOOL_SRC_DIR)/common/include \
+		-I$(AGENT_MARGIN_TOOL_SRC_DIR)/common/include/$(HL_DEV) \
+		-I$(AGENT_SRC_DIR)/common/include \
+		-I$(AGENT_SRC_DIR)/common/include/$(HL_DEV)
+
+AGENT_SERDES_CONF_OPTS = $(ZEPHYR_CONF_OPTS)
+
+ifdef BR2_arcle
+AGENT_SERDES_CONF_OPTS += -DBOARD=hl_$(AGENT_SERDES_DEVICE_NAME)_agent_$(HL_TARGET)
+endif
+ifdef BR2_aarch64
+AGENT_SERDES_CONF_APP_EXTRA_CFLAGS += -mstrict-align
+AGENT_SERDES_CONF_OPTS += -DBOARD=hl_$(AGENT_SERDES_DEVICE_NAME)_$(HL_TARGET)
+endif
+
+ifeq ($(HL_TARGET),pldm)
+AGENT_SERDES_CONF_APP_EXTRA_CFLAGS = -DTARGET_IS_PLDM
+endif
+
+ifeq ($(HL_TARGET),onix)
+AGENT_SERDES_CONF_APP_EXTRA_CFLAGS = -DTARGET_IS_ONIX
+endif
+
+AGENT_SERDES_BUILD_DIR = $(@D)
+AGENT_SERDES_BUILDDIR = $(@D)
+AGENT_SERDES_DIR = $(@D)
+AGENT_SERDES_ZEPHYR_BUILD_DIR ?= $(@D)/zephyr
+
+AGENT_SERDES_CONF_ENV = CROSS_COMPILE=$(TARGET_CROSS)
+AGENT_SERDES_CONF_ENV += ZEPHYR_TOOLCHAIN_VARIANT=cross-compile
+AGENT_SERDES_CONF_ENV += ZEPHYR_BASE=$(AGENT_SERDES_ZEPHYR_BUILD_DIR)
+
+AGENT_SERDES_CONF_OPTS += -UCMAKE_TOOLCHAIN_FILE
+AGENT_SERDES_CONF_OPTS += -DUSER_CACHE_DIR=$(@D)/.cache
+AGENT_SERDES_CONF_OPTS += -DCMAKE_EXE_LINKER_FLAGS_INIT=-Wl,-e__start
+AGENT_SERDES_CONF_OPTS += -DEXTRA_CFLAGS="\
+		-Werror \
+		-Wno-misleading-indentation \
+		$($(call UPPERCASE,$(DEV_PREFIX))_CONF_DEV_EXTRA_CFLAGS) \
+		$(AGENT_SERDES_CONF_APP_EXTRA_CFLAGS)"
+
+AGENT_SERDES_CONF_OPTS += -DFAKE_SECURITY=$(FAKE_SECURITY)
+AGENT_SERDES_CONF_OPTS += -DBUILD_VERSION="$(AGENT_SERDES_APP_VERSION)"
+AGENT_SERDES_CONF_OPTS += -DBUILD_MACHINE="$(shell hostname -s)"
+AGENT_SERDES_CONF_OPTS += -DCMAKE_C_FLAGS="\
+		$(AGENT_SERDES_CONF_APP_CFLAGS)"
+
+AGENT_SERDES_CONF_OPTS += -DDTS_EXTRA_CPPFLAGS="-I$(SPECS_EMBEDDED_DIR)"
+AGENT_SERDES_CONF_OPTS += -DDEVICE=$(AGENT_SERDES_DEVICE_NAME)
+AGENT_SERDES_CONF_OPTS += -DAPP_NAME=$(AGENT_SERDES_APP_PROD_NAME)
+AGENT_SERDES_CONF_OPTS += -DAPP_VERSION=$(AGENT_SERDES_APP_VERSION)
+AGENT_SERDES_WEST_SRC_DIR :=
+AGENT_SERDES_WEST_DEST_DIR :=
+
+define AGENT_SERDES_COPY_ZEPHYR_SRC
+	rsync -au --chmod=u=rwX,go=rX  --exclude .svn --exclude .git --exclude .hg --exclude .bzr --exclude CVS $(AGENT_SERDES_ZEPHYR_SRCDIR) $(AGENT_SERDES_BUILD_DIR)
+endef
+
+# Arguments:
+# - module name
+# - component dir
+# - component name
+#
+define AGENT_SERDES_DEFINE_MODULE_ENVVARS
+	$(eval MODULE_NAME=$(strip $1))
+	$(eval MODULE_NAME_UPPER_CASE=$(shell echo $(MODULE_NAME) | tr a-z A-Z))
+	$(eval MODULE_NAME_UPPER_CASE=$(strip $(MODULE_NAME_UPPER_CASE)))
+	$(eval $(MODULE_NAME_UPPER_CASE)_SRCDIR=$(EMBEDDED_DIR)/zephyr-modules/$(MODULE_NAME))
+	$(eval $(MODULE_NAME_UPPER_CASE)_DIR=$(@D)/build/modules/$(MODULE_NAME))
+	$(eval $(MODULE_NAME_UPPER_CASE)_NAME=$2_$(MODULE_NAME))
+endef
+
+$(foreach module,$(AGENT_SERDES_APP_MODULES),$(call AGENT_SERDES_DEFINE_MODULE_ENVVARS,$(module),$(AGENT_SERDES_APP_PROD_NAME)))
+
+# Arguments:
+# - module (mbedtls, eeprom, etc.)
+define AGENT_SERDES_MODULE_VERSION_HOOK
+	$(eval MODULE_NAME_UPPER_CASE=$(shell echo $1 | tr a-z A-Z))
+	$(eval MODULE_NAME_UPPER_CASE=$(strip $(MODULE_NAME_UPPER_CASE)))
+	$(call HL_VERSION_GEN, ${${MODULE_NAME_UPPER_CASE}_SRCDIR}, ${${MODULE_NAME_UPPER_CASE}_DIR}, ${${MODULE_NAME_UPPER_CASE}_NAME})
+endef
+
+define AGENT_SERDES_APP_VERSION_GEN
+	@$(call HL_VERSION_GEN, ${AGENT_SERDES_SRCDIR},.,${AGENT_SERDES_APP_PROD_NAME})
+	@$(call HL_VERSION_GEN, ${AGENT_SERDES_SRCDIR},build,${AGENT_SERDES_APP_PROD_NAME})
+	@$(foreach module,$(AGENT_SERDES_APP_MODULES),$(call AGENT_SERDES_MODULE_VERSION_HOOK,$(module)))
+endef
+
+define AGENT_SERDES_CONFIGURE_CMDS
+	$(AGENT_SERDES_CONF_ENV) $(HOST_DIR)/bin/cmake $(AGENT_SERDES_CONF_OPTS) -S $(AGENT_SERDES_BUILD_DIR)/margin-tools/serdes -B $(AGENT_SERDES_BUILD_DIR)/build
+endef
+
+AGENT_SERDES_POST_RSYNC_HOOKS += HL_VERSION_GEN
+AGENT_SERDES_POST_RSYNC_HOOKS += AGENT_SERDES_COPY_ZEPHYR_SRC
+AGENT_SERDES_POST_RSYNC_HOOKS += AGENT_SERDES_APP_VERSION_GEN
+
+define AGENT_SERDES_BUILD_CMDS
+	$(TARGET_MAKE_ENV) $(MAKE) -C $(AGENT_SERDES_BUILD_DIR)/build
+endef
+
+define AGENT_SERDES_INSTALL_TARGET_CMDS
+	@$(INSTALL) -D -m 0644 $(@D)/build/zephyr/zephyr.bin $(BINARIES_DIR)/zephyr_agent_$(AGENT_SERDES_APP_NAME).bin
+	@$(INSTALL) -D -m 0644 $(@D)/build/zephyr/zephyr.elf $(BINARIES_DIR)/zephyr_agent_$(AGENT_SERDES_APP_NAME).elf
+	@$(INSTALL) -D -m 0644 $(@D)/build/zephyr/zephyr.stat $(BINARIES_DIR)/zephyr_agent_$(AGENT_SERDES_APP_NAME).stat
+endef
+
+agent-serdes-configure: $(AGENT_SERDES_DEPENDENCIES)
+agent-serdes-menuconfig agent-serdes-guiconfig: | agent-serdes-configure
+	$(TARGET_MAKE_ENV) $(MAKE) -C $(AGENT_SERDES_BUILD_DIR)/build
+	rm -f $(AGENT_SERDES_BUILD_DIR)/.stamp_{configured,built}
+
+$(eval $(cmake-package))
