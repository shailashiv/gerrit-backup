From 28ca5d41a53f3f10ed8cb55465ecc9a7042966e4 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Wed, 16 Nov 2022 11:28:22 +0200
Subject: [PATCH] [SW-66407] pcie_fw: rename fw size define

fw size define is renamed for better readability

Change-Id: Id50f2748db269cca02d9a18f62bc5b314fcc6d25
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/Makefile b/Makefile
index fd0b793..a74d03a 100644
--- a/Makefile
+++ b/Makefile
@@ -125,7 +125,7 @@
 	echo "VERSION_STR" | gcc -include $< -I./ -I ./lib/common/ -I ./$(HL_DEV_ARCH)/ -I$(SPECS_EMBEDDED_DIR)/$(SPECS_EMB_DEV) -I$(SPECS_DIR)/$(BASE_DEV_NAME)/asic_reg -I$(SPECS_DIR)/ -I ./include/ -P -E -o - - | tail -1 | sed 's/\" \+\"//g;s/["\n]//g' | cut -d' ' -f2- | tr -d '\n' > $@
 
 $(PCI_PHY_FW_TARGET): $(HL_DEV_ARCH)/pcie_phy_fw.i
-	@cut -d' ' -f2- $< | xxd -r -p | dd status=none bs=16 count=$$(($(FW_SIZE) / 16)) conv=sync,swab of=$@
+	@cut -d' ' -f2- $< | xxd -r -p | dd status=none bs=16 count=$$(($(PHY_FW_SIZE) / 16)) conv=sync,swab of=$@
 
 $(HL_DEV_ARCH)/pcie_phy_fw.i: $(HL_DEV_ARCH)/pcie_phy_fw.hex
 	@$(CC) -x c -E -P -nostdinc -o $@ $<
