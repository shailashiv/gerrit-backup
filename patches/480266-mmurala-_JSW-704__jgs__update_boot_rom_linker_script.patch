From 147b3f5cb85b0988521ff6e15a3224f6ab7b3c3d Mon Sep 17 00:00:00 2001
From: Murala S Swamy <ssmurala@habana.ai>
Date: Wed, 21 May 2025 19:09:56 +0300
Subject: [PATCH] [JSW-704] jgs: update boot rom linker script

with this patch jgs linker script is updated
to use new address space.

Change-Id: Ib89205b7a26bd29ad30b0eaed43c969fc42fcf49
---

diff --git a/arch/jgs/arc/boot_rom.lds b/arch/jgs/arc/boot_rom.lds
index 0215d6a..41183dc 100644
--- a/arch/jgs/arc/boot_rom.lds
+++ b/arch/jgs/arc/boot_rom.lds
@@ -9,9 +9,9 @@
 MEMORY
 {
 	ICCM	: ORIGIN = 0x00000000, LENGTH = 256K
-	SPI	: ORIGIN = 0x94000000, LENGTH = 16M
-	SBROM	: ORIGIN = 0x78980000, LENGTH = 128K
-	FWSRAM	: ORIGIN = 0x789A0000, LENGTH = 128K
+	SPI	: ORIGIN = 0x9F000000, LENGTH = 16M
+	SBROM	: ORIGIN = 0x78620000, LENGTH = 128K
+	FWSRAM	: ORIGIN = 0x78640000, LENGTH = 128K
 	DCCM	: ORIGIN = 0x80000000, LENGTH = 128K
 }
 
