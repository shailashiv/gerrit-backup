From 9b790c0cf8e0dc702bc5c352acee0a74b138cf96 Mon Sep 17 00:00:00 2001
From: Subrata Chatterjee <schatterjee@habana.ai>
Date: Tue, 29 Jun 2021 19:36:14 +0300
Subject: [PATCH] [SW-43475] greco: increase preboot size

Increased preboot size for greco to accomodate more
functions.

Change-Id: Ib9039a39351a36d4d9da8498e2d435fca686cbcd
Signed-off-by: Subrata Chatterjee <schatterjee@habana.ai>
---

diff --git a/arch/greco/common.h b/arch/greco/common.h
index 4ed4d88..1e0e3c7 100644
--- a/arch/greco/common.h
+++ b/arch/greco/common.h
@@ -11,7 +11,7 @@
 #include <bitops.h>
 
 #define PPBOOT_SIZE			0x5000		/* 20KB */
-#define PREBOOT_SIZE			0x10800		/* 66KB */
+#define PREBOOT_SIZE			0x11000		/* 68KB */
 
 #define SRAM_SIZE			0x8000000	/* 128MB */
 #define HL_SP_SRAM_SIZE			0x10000
