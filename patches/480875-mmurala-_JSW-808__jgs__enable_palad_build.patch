From 720db51a53f610db4d39d4ae1261d02f526e1cd5 Mon Sep 17 00:00:00 2001
From: Murala S Swamy <ssmurala@habana.ai>
Date: Mon, 02 Jun 2025 09:09:41 +0300
Subject: [PATCH] [JSW-808] jgs: enable palad build

This patch enables palad build

Change-Id: Ifcd7e4ce58c96fb1c0ada6f77b3bcb9affecd3b6
---

diff --git a/arch/jgs/arc/common.c b/arch/jgs/arc/common.c
index dadbb09..ae3dbe8 100644
--- a/arch/jgs/arc/common.c
+++ b/arch/jgs/arc/common.c
@@ -46,6 +46,8 @@
 #include <bmu_masks.h>
 #include <h15b_psoc_reset_conf_regs.h>
 #include <pcie_flr_regs.h>
+#include <lib_common.h>
+#include <jgs_binning_defs.h>
 
 #define LOG_LEVEL CONFIG_LOG_DEFAULT_LEVEL
 #include <zephyr/logging/log.h>
@@ -278,7 +280,6 @@
 	LOG_INF("Boot strap pins low: 0x%08x, high: 0x%08x",
 		boot_strap_l, boot_strap_h);
 }
-
 
 static int preboot_isolation(enum fs1_die_id die_id)
 {
diff --git a/arch/jgs/arc/palad.c b/arch/jgs/arc/palad.c
index 02bbc18..acc995a 100644
--- a/arch/jgs/arc/palad.c
+++ b/arch/jgs/arc/palad.c
@@ -16,7 +16,7 @@
 #include <pcie_flr_regs.h>
 #include <psoc_boot_conf_regs.h>
 #include <psoc_boot_conf_masks.h>
-#include <fs1_blocks_linux_driver.h>
+#include <jgs_blocks_linux_driver.h>
 
 #include <address_space.h>
 #include <preboot.h>
@@ -24,8 +24,8 @@
 #include <hl_platform_defs.h>
 #include "hl.h"
 #include <hl_boot_info.h>
-#include <fs1_reg_map.h>
-#include <fs1_efuse.h>
+#include <jgs_reg_map.h>
+#include <jgs_efuse.h>
 #include <efuse.h>
 #include <hl_pcie.h>
 
@@ -62,9 +62,9 @@
 static void hl_psoc_drain_init(void)
 {
 	/* psoc drain is enabled by default, enable drain address stamp logging */
-	CFG_WREG32(mmIO_0_CFG_HALF_0_PSOC_PARC_CFG_MISC_DRAIN_HBW_BASE +
+	CFG_WREG32(mmIO_0_CFG_PSOC_PARC_CFG_MISC_DRAIN_HBW_BASE +
 		   mmAXI_DRAIN_WRAP_RSP_ERR_DRAIN_STAMP, DRAIN_STAMP_ENA_MASK);
-	CFG_WREG32(mmIO_0_CFG_HALF_0_PSOC_PARC_CFG_MISC_DRAIN_LBW_BASE +
+	CFG_WREG32(mmIO_0_CFG_PSOC_PARC_CFG_MISC_DRAIN_LBW_BASE +
 		   mmAXI_DRAIN_WRAP_RSP_ERR_DRAIN_STAMP, DRAIN_STAMP_ENA_MASK);
 }
 
@@ -77,10 +77,10 @@
 {
 	u32 val;
 
-	val = CFG_RREG32(mmIO_0_CFG_HALF_0_PSOC_ARC_MNG_LOCAL_BASE +
+	val = CFG_RREG32(mmIO_0_CFG_PSOC_ARC_MNG_LOCAL_BASE +
 			 mmARC_LOCAL_CONF_ARC_LBU_AXI_SPLIT_CTRL2);
 	val |= EARLY_WRITE_RESP_MASK;
-	CFG_WREG32(mmIO_0_CFG_HALF_0_PSOC_ARC_MNG_LOCAL_BASE +
+	CFG_WREG32(mmIO_0_CFG_PSOC_ARC_MNG_LOCAL_BASE +
 		   mmARC_LOCAL_CONF_ARC_LBU_AXI_SPLIT_CTRL2, val);
 }
 
@@ -172,7 +172,7 @@
 		     PCIE_DBI_MISC_CONTROL_1_OFF_DBI_RO_WR_EN_M);
 
 	/* switch to shadow registers access in order to set BAR masks */
-	CFG_WREG32(mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_DBI, PCIE_AUX_DBI_CS2_M);
+	CFG_WREG32(mmIO_0_CFG_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_DBI, PCIE_AUX_DBI_CS2_M);
 
 	/* set PF CFG BAR to 1GB */
 	CFG_WREG32(IO0_H0_PCIE_DBI(mmPCIE_DBI_BAR0_REG), BAR_SIZE_1GB);
@@ -183,7 +183,7 @@
 	CFG_WREG32(IO0_H0_PCIE_DBI(mmPCIE_DBI_SRIOV_BAR1_REG), 0);
 
 	/* disable shadow registers access */
-	CFG_WREG32(mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_DBI, 0);
+	CFG_WREG32(mmIO_0_CFG_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_DBI, 0);
 
 	/* set VF resizable BAR #2 allowed size */
 	CFG_WREG32(IO0_H0_PCIE_DBI(mmPCIE_DBI_VF_RESBAR_CAP_REG_2_REG), VF_RES_BAR_SIZES);
@@ -208,7 +208,7 @@
 
 	palad_pcie_params_init();
 
-	CFG_WREG32(mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_LTSSM_EN, LTTSM_ENA_MASK);
+	CFG_WREG32(mmIO_0_CFG_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_LTSSM_EN, LTTSM_ENA_MASK);
 
 	/* release request retry so the host can access pci config space */
 	CFG_WREG32(IO0_H0_PCIE_FLR(mmPCIE_FLR_APP_REQ_RETRY_EN), 0);
