From 20b3e44328beb6d94975072cf24e5191f6b0fcb8 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Wed, 16 Jun 2021 12:09:43 +0300
Subject: [PATCH] [SW-45099] pci: init device id while waiting for prstn

This patch solves 2 issues:
1. for some devices the efuse is read in order to assemble the
   device id. efuse reading is a fairly long operation and shouldn't
   be performed in time critical points in the code. for those
   devices the pci id is initialized while we are waiting for prstn
   de-assertion, and used later on when required.
2. Tests show that accessing pci_dbi registers during link
   establishment might cause the cpu to hang. because of that, it's
   risky to fetch the pci dev id from the pci_dbi block. instead,
   the pci dev id is initialized during preboot boot sequence and
   used later on when required.

Change-Id: I356f8af536296aa0635b290841fb00bc5fae24a2
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/common/module_i2c_slave.c b/common/module_i2c_slave.c
index adafc93..577c372 100644
--- a/common/module_i2c_slave.c
+++ b/common/module_i2c_slave.c
@@ -16,6 +16,7 @@
 #include <preboot/thermal.h>
 #include <hl_i2c_slave_events.h>
 #include <crc8.h>
+#include <common/pci_ids.h>
 
 #include "cmd_module.h"
 #include "pll.h"
@@ -224,24 +225,20 @@
 u8 i2cslave_pcie_vendor_id_cmd(u8 cmd)
 {
 	u8 ret;
-	u32 data = device_id_vendor_id;
+	u32 dev_id = preboot_device_id_get();
 
 	switch (cmd) {
 	case HL_PCIE_VENDOR_ID_VAL_LOW:
-		data &= 0xFFFF;
-		ret = (data & 0xFF00) >> 8;
+		ret = PCI_VENDOR_ID_HABANALABS >> 8;
 		break;
 	case HL_PCIE_VENDOR_ID_VAL_HIGH:
-		data &= 0xFFFF;
-		ret = data & 0xFF;
+		ret = PCI_VENDOR_ID_HABANALABS & 0xFF;
 		break;
 	case HL_PCIE_DEVICE_ID_VAL_LOW:
-		data >>= 16;
-		ret = (data & 0xFF00) >> 8;
+		ret = (u8)(dev_id >> 8);
 		break;
 	case HL_PCIE_DEVICE_ID_VAL_HIGH:
-		data >>= 16;
-		ret = data & 0xFF;
+		ret = (u8)dev_id;
 		break;
 	default:
 		ret = 0;
