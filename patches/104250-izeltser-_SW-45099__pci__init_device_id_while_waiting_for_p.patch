diff --git a/gaudi/common.c b/gaudi/common.c
index dc8d701..e648613 100644
--- a/gaudi/common.c
+++ b/gaudi/common.c
@@ -44,6 +44,7 @@
 #include <hl_fw_if.h>
 #include <security.h>
 #include <hl_boot_desc.h>
+#include <pci.h>
 
 #include "common.h"
 
@@ -118,16 +119,18 @@
 	preboot_init_pcie_phy_fw_update();
 }
 
-#define FUSE_DEV_ID_WORD_OFFSET	1
 #define GAUDI_SECURE_PCI_ID_EXT	BIT(4)
 
-u32 preboot_get_vendor_id_device_id(void)
+static u32 pci_dev_id;
+
+void preboot_device_id_init(void)
 {
-	u32 pci_dev_id = PCI_IDS_GAUDI;
 	char devid[5];
 
+	pci_dev_id = PCI_IDS_GAUDI;
+
 	/* Read the second part of the device ID which contains the step */
-	if (!preboot_fuse_read(FUSE_DEV_ID_WORD_OFFSET + 1, (u32 *)devid)) {
+	if (!preboot_fuse_read(EFUSE_PRODUCT_ID_OFFSET + 1, (u32 *)devid)) {
 		devid[4] = '\0';
 		/* Check for device type B1 and set the PCI ID accordingly */
 		if (!strcmp(&devid[2], "B1"))
@@ -143,13 +146,23 @@
 	if (preboot_security_is_enabled())
 		pci_dev_id |= GAUDI_SECURE_PCI_ID_EXT;
 
-	return (pci_dev_id << 16) | PCI_VENDOR_ID_HABANALABS;
+	/* using vendor id as a magic number */
+	pci_dev_id |= (PCI_VENDOR_ID_HABANALABS << 16);
+}
+
+u32 preboot_device_id_get(void)
+{
+	/* using vendor id as a magic number */
+	if ((pci_dev_id >> 16) != PCI_VENDOR_ID_HABANALABS)
+		return 0;
+
+	return pci_dev_id;
 }
 
 void preboot_init_pcie(void)
 {
 	u64 start;
-	u32 ven_id_dev_id = preboot_get_vendor_id_device_id();
+	u32 ven_id_dev_id = hl_pci_get_ven_id_dev_id();
 
 	preboot_init_pcie_phy();
 
@@ -302,6 +315,12 @@
 	 */
 	(void)preboot_security_is_enabled();
 
+	/*
+	 * Initializing device id early by CPU0, while it is used by CPU1,
+	 * for same reasons mentioned obove.
+	 */
+	preboot_device_id_init();
+
 	rst_addr_lsb = (u32)(uintptr_t)secondary_entry;
 	rst_addr_msb = (u32)(uintptr_t)(((uintptr_t)secondary_entry) >> 32);
 	regmap_writel(rst_addr_lsb, mmCPU_CA53_CFG_RST_ADDR_LSB_1);
