From 8ce7bfd6b8a61c8eed69cb84cf98c39ce03f032e Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Sun, 12 Sep 2021 15:53:06 +0300
Subject: [PATCH] [SW-55766] gaudi2: pci: disable mem access during iatu init

Experience with gaudi shows that completely blocking pci access
during iATU init can cause issues with the host, and it's against
the pci spec.
So to be on the safe side, only the memory access is disabled
during the iATU initialization.

Change-Id: I734ac2f70cf5c657c2b00ee4f87b09bab0f7a178
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/arch/gaudi2/common/asic.c b/arch/gaudi2/common/asic.c
index 0bad1f3..a1fb829 100644
--- a/arch/gaudi2/common/asic.c
+++ b/arch/gaudi2/common/asic.c
@@ -63,8 +63,7 @@
 	struct hl_pci_inbound_region inbound_region;
 	struct hl_pci_outbound_region outbound_region;
 
-	/* TODO: implement hl_pcie_disable_access() for gaudi2 */
-	hl_pcie_disable_access();
+	hl_pcie_disable_mem_access();
 
 	/* Inbound Region 0 - Bar 0 - Point to CFG */
 	inbound_region.mode = PCI_ADDRESS_MATCH_MODE;
@@ -93,6 +92,5 @@
 	outbound_region.size = HOST_PHYS_SIZE_0;
 	hl_pci_set_outbound_region(&outbound_region);
 
-	/* TODO: implement hl_pcie_enable_access() for gaudi2 */
-	hl_pcie_enable_access();
+	hl_pcie_enable_mem_access();
 }
