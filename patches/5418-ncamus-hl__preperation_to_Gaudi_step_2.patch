diff --git a/board/habanalabs/dali/post-image.sh b/board/habanalabs/dali/post-image.sh
deleted file mode 100755
index 34a94af..0000000
--- a/board/habanalabs/dali/post-image.sh
+++ /dev/null
@@ -1,88 +0,0 @@
-#!/usr/bin/env bash
-
-BOARD_BASE=${BR2_EXTERNAL_HL_DALI_PATH}/board/habanalabs/dali
-SPL_BINFILE=${SPL_BINFILE:-u-boot-spl.bin}
-UBOOT_CMDFILE=${UBOOT_CMDFILE:-${BOARD_BASE}/uboot-eeprom.cmd}
-UBOOT_FITFILE=u-boot.itb
-UBOOT_ITSFILE=${UBOOT_ITSFILE:-${BOARD_BASE}/dali_fit_spl.its}
-UBOOT_BINFILE=${UBOOT_BINFILE:-${UBOOT_FITFILE}}
-LINUX_FITFILE=fit.itb
-
-function swap_file {
-	INF=$1
-	OUTF=$2
-
-	# SWAP needs this to be 4B aligned in size
-	dd status=none conv=sync bs=4 if=${INF} > ${OUTF}.tmp
-	# Sadly --endian=big is not swapping for -tx1 so I used some gawk magic
-	od -Anone -v -tx1 -w4 ${OUTF}.tmp | gawk '{ print $4 $3 $2 $1 }' | xxd -r -p > ${OUTF}
-}
-
-pushd ${BINARIES_DIR}
-	cp ${BOARD_BASE}/dali_${HL_TARGET}.its .
-	cp ${BASE_DIR}/build/linux-custom/arch/arm64/boot/Image .
-	${HOST_DIR}/usr/bin/mkimage -D "-W no-unit_address_vs_reg" -f dali_${HL_TARGET}.its ${LINUX_FITFILE}
-
-	cp ${UBOOT_ITSFILE} dali_fit_spl.its
-	# In case ITSFILE points to locations under public directory /tools
-	ln -nfs /tools
-	# SPI IOMAP likes these to be 8B aligned in size
-	dd status=none conv=sync bs=8 if=${BASE_DIR}/build/uboot-custom/u-boot-nodtb.bin	 > u-boot-nodtb.bin
-	dd status=none conv=sync bs=8 if=${BASE_DIR}/build/uboot-custom/u-boot.dtb		 > u-boot.dtb
-	${HOST_DIR}/usr/bin/mkimage -f dali_fit_spl.its -E ${UBOOT_FITFILE}
-	${HOST_DIR}/usr/bin/mkimage -C none -A arm64 -T script -d ${UBOOT_CMDFILE} boot.scr
-
-	dd status=none conv=sync bs=8 if=${SPL_BINFILE}						 > dali-u-boot-spl.bin
-	# Swap SPL
-	swap_file dali-u-boot-spl.bin dali-u-boot-spl.bin.be
-	SPL_BINFILE=dali-u-boot-spl.bin.be
-
-	# KMD like this to be 4B aligned in size
-	dd status=none conv=sync bs=4 if=${LINUX_FITFILE}					 > dali-fit.itb
-	# Used by TRACE32 (Lauterbach JTAG)
-	dd status=none conv=sync bs=4 if=u-boot.bin						 > dali-u-boot.bin
-
-	### Construct bin file
-	# BTL likes these to be 16B aligned in size
-	dd status=none conv=sync bs=16 if=preboot.bin						 > dali-preboot.bin
-	# prepare BTL image
-	BTL_CMD_ARGS="${BTL_CMD_ARGS} SPL_SIZE=$(printf "0x%X\n" `stat -c "%s" ${SPL_BINFILE}`)"
-	BTL_CMD_ARGS="${BTL_CMD_ARGS} UBOOT_SIZE=$(printf "0x%X\n" `stat -c "%s" ${UBOOT_BINFILE}`)"
-	cp -a ${BOARD_BASE}/btl .
-	make -C btl clean all ${BTL_CMD_ARGS}
-	cp btl/sectors-be.bin .
-
-	# Metadata
-	dd status=none conv=sync bs=64K count=1 if=/dev/zero					 > dali-pkey-hash.bin
-	dd status=none conv=sync bs=64K count=1 if=/dev/zero					 > dali-ver.bin
-	echo "11110000" > dali-next-image.txt
-	dd status=none conv=sync bs=64K if=dali-next-image.txt					 > dali-next-image.bin
-	dd status=none conv=sync bs=64K count=1 if=/dev/zero					 > dali-images-pointers.bin
-
-	# BTL
-	dd status=none conv=sync bs=256K	if=sectors-be.bin				 > dali-spi-flash.bin.nocrc
-	# Metadata
-	dd status=none conv=sync bs=64K		if=dali-pkey-hash.bin				>> dali-spi-flash.bin.nocrc
-	dd status=none conv=sync bs=64K		if=dali-ver.bin					>> dali-spi-flash.bin.nocrc
-	dd status=none conv=sync bs=64K		if=dali-next-image.bin				>> dali-spi-flash.bin.nocrc
-	dd status=none conv=sync bs=64K		if=dali-images-pointers.bin			>> dali-spi-flash.bin.nocrc
-	# U-Boot ENV
-	dd status=none conv=sync bs=64K		if=uboot-env.bin				>> dali-spi-flash.bin.nocrc
-	# U-Boot ENV Redundand
-	dd status=none conv=sync bs=64K		if=uboot-env.bin				>> dali-spi-flash.bin.nocrc
-	# SPL
-	dd status=none conv=sync bs=64K		if=${SPL_BINFILE}				>> dali-spi-flash.bin.nocrc
-	# U-Boot
-	dd status=none conv=sync bs=1M		if=${UBOOT_BINFILE}				>> dali-spi-flash.bin.nocrc
-
-	# Prepare checksum
-	CKSUM=`cksum dali-spi-flash.bin.nocrc | cut -d' ' -f1`
-	CKSUM_BE=`printf "%08x" ${CKSUM}`
-	CKSUM_LE=${CKSUM_BE:6:2}${CKSUM_BE:4:2}${CKSUM_BE:2:2}${CKSUM_BE:0:2}
-	echo ${CKSUM_LE} | xxd -p -r								 > dali-spi-flash.crc
-	dd status=none conv=sync bs=64K		if=dali-spi-flash.bin.nocrc			 > dali-spi-flash.bin
-	dd status=none conv=sync bs=4		if=dali-spi-flash.crc				>> dali-spi-flash.bin
-
-	# Convert bin file into Palladium hex format
-	xxd -p -c1 -g1				dali-spi-flash.bin	 			 > dali-spi-flash.hex
-popd
