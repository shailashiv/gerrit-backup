From 9cd8c3a6afb3fd1a607c90451581c1a5a03ac0e0 Mon Sep 17 00:00:00 2001
From: Vitaly Margolin <vmargolin@habana.ai>
Date: Mon, 16 Jun 2025 14:23:34 +0300
Subject: [PATCH] [SW-232431] lfs: add support of lfs log cleaning

Add possibility to clean LFS flash log

Change-Id: Ifa7ef4061dab880625d09a26a69042fa478e4516
Signed-off-by: Vitaly Margolin <vmargolin@habana.ai>
---

diff --git a/src/fit.cpp b/src/fit.cpp
index 6068ceb..480df32 100644
--- a/src/fit.cpp
+++ b/src/fit.cpp
@@ -601,6 +601,25 @@
 	return 0;
 }
 
+static int process_lfs_cleanup(void *fit)
+{
+	const __u32 *fit_value;
+	__u32 value;
+
+	fit_value = (const __u32 *)fdt_getprop(fit, 0, HL_FIT_VALUE_PROP, NULL);
+
+	if (fit_value) {
+		value = fdt32_to_cpu(*fit_value);
+		if (value == 0)
+			HL_FL_LOG_INFO("Flash log cleanup succeeded\n");
+		else
+			HL_FL_LOG_ERR("Flash log cleanup failed: RC=%d\n", *((int *)(&value)));
+	} else
+		HL_FL_LOG_ERR("Flash log clenup failed\n");
+
+	return 0;
+}
+
 /*
  * TODO: turn the specific handling to a more generic handling by registering
  * an handler to the LOAD_TYPE
@@ -777,6 +796,9 @@
 	case FIT_LOAD_TYPE_READ_LOG:
 		process_lfs_logs(fit);
 		break;
+	case FIT_LOAD_TYPE_CLEANUP_LOG:
+		process_lfs_cleanup(fit);
+		break;
 	default:
 		HL_FL_LOG_WARN("Unknown load_type %d\n", load_type);
 		len = fit_get_size(fit);
