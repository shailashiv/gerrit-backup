From 7a37ea8d074fb3431b7c5fc72a53a28eeb559c48 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Thu, 20 Oct 2022 14:54:42 +0300
Subject: [PATCH] [SW-104157] gaudi2: pll: move pll init to pll c file

To maintain code tidiness, move the PLLs init code to the
pll source code file.

Change-Id: I4d3dcadee62bd4406e73794142ff420520333238
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/arch/gaudi2/arc/asic.c b/arch/gaudi2/arc/asic.c
index 56d3cf2..5031158 100644
--- a/arch/gaudi2/arc/asic.c
+++ b/arch/gaudi2/arc/asic.c
@@ -80,50 +80,6 @@
 							{4, 18}, /* D4R18 */
 };
 
-static struct hl_pll_cfg gaudi2_arch_pll_cfg[] = {
-	{
-		.name = "PSOC_CPU_PLL",
-		.base = mmPSOC_CPU_PLL_CTRL_BASE,
-		.nr = 1, .nf = 60, .od = 3, .nb = 2,	/* 500 */
-		.div_factor = { -1, -1, 4, -1 },
-		.div_sel = { HL_PLL_PLL_CLK,
-			     HL_PLL_PLL_CLK,
-			     HL_PLL_DIV_PLL,
-			     HL_PLL_REF_CLK
-		},
-	}
-};
-
-static struct hl_pll_cfg gaudi2_sram_pll_cfg[] = {
-	{
-		.name = "DCORE2_SRAM",
-		.base = mmDCORE2_XBAR_BANK_PLL_CTRL_BASE,
-		.nr = 1, .nf = 63, .od = 3, .nb = 3,	/* 350 */
-		.div_factor = { 0, -1, -1, -1 },
-		.div_sel = { HL_PLL_PLL_CLK,
-			     HL_PLL_REF_CLK,
-			     HL_PLL_REF_CLK,
-			     HL_PLL_REF_CLK
-		},
-	}, {
-		.name = "DCORE3_SRAM",
-		.base = mmDCORE3_XBAR_BANK_PLL_CTRL_BASE,
-		.nr = 1, .nf = 63, .od = 3, .nb = 3,	/* 350 */
-		.div_factor = { 0, -1, -1, -1 },
-		.div_sel = { HL_PLL_PLL_CLK,
-			     HL_PLL_REF_CLK,
-			     HL_PLL_REF_CLK,
-			     HL_PLL_REF_CLK
-		},
-	}
-};
-
-void hl_arch_pll_init(void)
-{
-	/* In case of secureboot flow psoc pll needs to be configured */
-	hl_pll_init(gaudi2_arch_pll_cfg, ARRAY_SIZE(gaudi2_arch_pll_cfg));
-}
-
 u64 lkd_dev_spec_get_img_addr(uintptr_t base)
 {
 	/* SPSRAM fit can only be in general region */
@@ -167,11 +123,6 @@
 
 	for (i = 0; i < (size / 4); i++)
 		*(dst + i) = *(src + i);
-}
-
-static void gaudi2_sram_pll_init(void)
-{
-	hl_pll_init(gaudi2_sram_pll_cfg, ARRAY_SIZE(gaudi2_sram_pll_cfg));
 }
 
 static int gaudi2_sms_check_pattern(uint32_t value, uint32_t ones_mask, uint32_t zeros_mask)
diff --git a/arch/gaudi2/common/hl.h b/arch/gaudi2/common/hl.h
index 9ae9b6f..e24f77c 100644
--- a/arch/gaudi2/common/hl.h
+++ b/arch/gaudi2/common/hl.h
@@ -17,5 +17,6 @@
 void run_arc(u8 id);
 void preboot_pcie_monitoring(void);
 void init_arc_mem(u8 id, u64 addr, u32 size);
+void gaudi2_sram_pll_init(void);
 
 #endif /* ARCH_GAUDI2_COMMON_HL_H_ */
diff --git a/arch/gaudi2/common/pll.c b/arch/gaudi2/common/pll.c
index 8dc85b8..7f691ee 100644
--- a/arch/gaudi2/common/pll.c
+++ b/arch/gaudi2/common/pll.c
@@ -4,6 +4,8 @@
  * All Rights Reserved.
  */
 
+#include <gaudi2_blocks_linux_driver.h>
+
 #include <stddef.h>
 #include <bitops.h>
 #include <preboot.h>
@@ -17,6 +19,44 @@
 #define GAUDI2_PLL_CFG_EN		(BIT(8) | BIT(0))
 #define GAUDI2_PLL_CFG_LOCK		BIT(16)
 #define GAUDI2_PLL_DIV_SEL_DELAY	0x1E0
+
+static struct hl_pll_cfg gaudi2_arch_pll_cfg[] = {
+	{
+		.name = "PSOC_CPU_PLL",
+		.base = mmPSOC_CPU_PLL_CTRL_BASE,
+		.nr = 1, .nf = 60, .od = 3, .nb = 2,	/* 500 */
+		.div_factor = { -1, -1, 4, -1 },
+		.div_sel = { HL_PLL_PLL_CLK,
+			     HL_PLL_PLL_CLK,
+			     HL_PLL_DIV_PLL,
+			     HL_PLL_REF_CLK
+		},
+	}
+};
+
+static struct hl_pll_cfg gaudi2_sram_pll_cfg[] = {
+	{
+		.name = "DCORE2_SRAM",
+		.base = mmDCORE2_XBAR_BANK_PLL_CTRL_BASE,
+		.nr = 1, .nf = 63, .od = 3, .nb = 3,	/* 350 */
+		.div_factor = { 0, -1, -1, -1 },
+		.div_sel = { HL_PLL_PLL_CLK,
+			     HL_PLL_REF_CLK,
+			     HL_PLL_REF_CLK,
+			     HL_PLL_REF_CLK
+		},
+	}, {
+		.name = "DCORE3_SRAM",
+		.base = mmDCORE3_XBAR_BANK_PLL_CTRL_BASE,
+		.nr = 1, .nf = 63, .od = 3, .nb = 3,	/* 350 */
+		.div_factor = { 0, -1, -1, -1 },
+		.div_sel = { HL_PLL_PLL_CLK,
+			     HL_PLL_REF_CLK,
+			     HL_PLL_REF_CLK,
+			     HL_PLL_REF_CLK
+		},
+	}
+};
 
 void hl_pll_reset(struct hl_pll_cfg *cfg, bool reset)
 {
@@ -78,3 +118,14 @@
 {
 	regmap_writel(1, cfg->base + GAUDI2_PLL_DIV_SEL_DELAY);
 }
+
+void hl_arch_pll_init(void)
+{
+	/* In case of secureboot flow psoc pll needs to be configured */
+	hl_pll_init(gaudi2_arch_pll_cfg, ARRAY_SIZE(gaudi2_arch_pll_cfg));
+}
+
+void gaudi2_sram_pll_init(void)
+{
+	hl_pll_init(gaudi2_sram_pll_cfg, ARRAY_SIZE(gaudi2_sram_pll_cfg));
+}
