From 3687daa4b97607355fa03e50d4af8c5c313b5c9b Mon Sep 17 00:00:00 2001
From: Karthikeyan K <karthikk@habana.ai>
Date: Wed, 08 Dec 2021 09:32:19 +0200
Subject: [PATCH] [SW-63186] gaudi2: security: set axprot for pmmu

Set axprot of pmmu to secured access level.

Change-Id: Ibe16c6cdbda1bf704176bf3fb6b6efa20a60c4d7
---

diff --git a/arch/gaudi2/common/security.c b/arch/gaudi2/common/security.c
index 8640316..00fe460 100644
--- a/arch/gaudi2/common/security.c
+++ b/arch/gaudi2/common/security.c
@@ -36,6 +36,7 @@
 #include <rot0_mstr_if_core_hbw_regs.h>
 #include <rot0_mstr_if_core_lbw_regs.h>
 #include <dcore0_hmmu0_mstr_if_core_hbw_regs.h>
+#include <pmmu_hbw_mstr_if_core_hbw_regs.h>
 
 /*
  * instances_num : Number of instances of RR to program.
@@ -999,6 +1000,12 @@
 	preboot_axprot_regs_init(AXPROT_HMMU);
 }
 
+static void preboot_secure_pmmu(void)
+{
+	/* Set ppmu to secure level */
+	regmap_writel(AXPROT_SEC_VAL, mmPMMU_HBW_MSTR_IF_CORE_HBW_AXPROT_OVRD);
+}
+
 void preboot_security_init(void)
 {
 	preboot_secure_pcie();
@@ -1010,6 +1017,7 @@
 		preboot_secure_vdec();
 		preboot_secure_rot();
 		preboot_secure_hmmu();
+		preboot_secure_pmmu();
 		preboot_secure_lbw();
 		preboot_secure_hbw();
 		preboot_puts("Security enabled.\n");
