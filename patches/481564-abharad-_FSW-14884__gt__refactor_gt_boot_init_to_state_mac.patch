+		RENDER_DEC_BGF_CONFIG_VAL);
+	GT_WREG32((mem_addr_t)(mmGT_0_MEDIA_PMA_BASE + mmGT_SGUNIT_RCSM_PHASE_COMMAND),
+		GO_DEC_GB_ELEC);
+}
+
+static inline void gt_boot_render_go_resume(struct mgmt_compute_config *config)
+{
+	GT_WREG32((mem_addr_t)(mmGT_0_MEDIA_PMA_BASE + mmGT_SGUNIT_RCSM_PHASE_COMMAND),
+		GO_RES_INTF);
+}
+
+static void gt_boot_execute_cmd(enum gt_boot_cmd cmd,
+		struct mgmt_compute_config *config)
+{
+	LOG_DBG("Executing GT boot command: %d", cmd);
+	switch (cmd) {
+	case GT_BOOT_CMD_UNLOCK_IOSF_PMSB:
+		gt_boot_unlock_iosf_pmsb();
+		break;
+	case GT_BOOT_CMD_SEND_TSC_SYNC:
+		gt_boot_send_tsc_sync();
+		break;
+	case GT_BOOT_CMD_INIT_SG_CTX_REGS:
+		gt_boot_write_to_sg_ctx_reg();
+		break;
+	case GT_BOOT_CMD_UPDATE_MSGR_SHADOW:
+		gt_boot_write_to_msgr_shadow();
+		break;
+	case GT_BOOT_CMD_ENABLE_BISR_BYPASS:
+		gt_boot_enable_bisr_bypass();
+		break;
+	case GT_BOOT_CMD_PROGRAM_WORKPOINTS:
+		gt_boot_write_to_workpoints();
+		break;
+	case GT_BOOT_CMD_SEND_GO_RES_INTF:
+		gt_boot_send_go_res_intf(config);
+		break;
+	case GT_BOOT_CMD_SET_RAMP_TYPE:
+		gt_boot_send_ramp_type();
+		break;
+	case GT_BOOT_CMD_CONFIGURE_GT1:
+		gt_boot_target_gt1();
+		break;
+	case GT_BOOT_CMD_CONFIGURE_GT2:
+		gt_boot_target_gt2();
+		break;
+	case GT_BOOT_CMD_TRIGGER_GO_BLOCK:
+		gt_boot_render_go_block(config);
+		break;
+	case GT_BOOT_CMD_TRIGGER_GO_INC:
+		gt_boot_render_go_inc(config);
+		break;
+	case GT_BOOT_CMD_TRIGGER_GO_DEC:
+		gt_boot_render_go_dec(config);
+		break;
+	case GT_BOOT_CMD_TRIGGER_GO_RESUME:
+		gt_boot_render_go_resume(config);
+		break;
+	case GT_BOOT_CMD_NOOP:
+		/* No operation, do nothing */
+		break;
+	default:
+		LOG_ERR("Unknown GT boot command: %d", cmd);
+		break;
+	}
+}
+
+/* Boot Sequencer */
+int gt_boot_run_sequence(const gt_boot_step_t *steps, size_t count,
+		struct mgmt_compute_config *config)
+{
+	int ret = 0;
+
+	for (size_t i = 0; i < count; ++i) {
+		gt_boot_execute_cmd(steps[i].cmd, config);
+		if (steps[i].wait != GT_BOOT_WAIT_NOOP) {
+			ret = wait_for_boot_state(config, steps[i].wait);
+			if (ret != 0) {
+				LOG_ERR("Timeout waiting for state %d at step %zu",
+						steps[i].wait, i);
+				return ret;
+			}
+		}
+	}
+	return 0;
+}
