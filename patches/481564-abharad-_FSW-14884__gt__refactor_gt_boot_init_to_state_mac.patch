+};
+
+/* Wait condition types (maps to boot state enums) */
+enum gt_boot_wait {
+	GT_BOOT_WAIT_NOOP = -1,
+	GT_BOOT_WAIT_FUSE_PULL_REQ_RECVD = FUSE_PULL_REQ_RECVD,
+	GT_BOOT_WAIT_IP_READY_RECVD = IP_READY_RECVD,
