+	GT_WREG32((mem_addr_t)GU_CNTL_LMEM_INIT, GU_CNTL_LMEM_INIT_VAL);
+	GT_WREG32((mem_addr_t)BGTSM_BASE_LO, BGTSM_BASE_LO_VAL);
+	GT_WREG32((mem_addr_t)BGTSM_BASE_HI, BTGSM_BASE_HI_VAL);
+	GT_WREG32((mem_addr_t)GMCH_GRAPHICS_CTRL, GMCH_GRAPHICS_CTRL_VAL);
+	GT_WREG32((mem_addr_t)BDSM_BASE_LO, BDSM_BASE_LO_VAL);
+	GT_WREG32((mem_addr_t)BDSM_BASE_HI, BDSM_BASE_HI_VAL);
+	GT_WREG32((mem_addr_t)TOLUD_BASE, CLEAR_REG);
+	GT_WREG32((mem_addr_t)TOUUD_BASE_LO, CLEAR_REG);
+	GT_WREG32((mem_addr_t)TOUUD_BASE_HI, TOUUD_BASE_HI_VAL);
+	GT_WREG32((mem_addr_t)TSEG_MEM_LO, TSEG_MEM_LO_VAL);
+	GT_WREG32((mem_addr_t)TSEG_MEM_HI, TSEG_MEM_HI_VAL);
+	GT_WREG32((mem_addr_t)PAVP_HI, PAVP_HI_VAL);
+	GT_WREG32((mem_addr_t)PAVP_LO, PAVP_LO_VAL);
+	GT_WREG32((mem_addr_t)GU_CNTL, GU_CNTL_VAL);
+	GT_WREG32((mem_addr_t)PKG_ADDR_BASE, PKG_ADDR_BASE_VAL);
+	GT_WREG32((mem_addr_t)SG_ADDR_RANGE_TILE0, SG_ADDR_RANGE_TILE0_VAL);
+	GT_WREG32((mem_addr_t)TOTAL_LOCAL_MEMORY, TOTAL_LOCAL_MEMORY_VAL);
+	GT_WREG32((mem_addr_t)SRIOV_NUMOFVFS_0_2_0_PCI, SRIOV_NUM_VF_VAL);
+	GT_WREG32((mem_addr_t)SRIOV_INITVFS_0_2_0_PCI, SRIOV_INIT_VF_VAL);
