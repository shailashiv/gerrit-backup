+		RAMP_TYPE_VAL);
+	GT_WREG32((mem_addr_t)(mmGT_0_MEDIA_PMA_BASE + mmGT_SGUNIT_TARGET_WP1),
+		WP1_VAL);
+}
+
+static inline void gt_boot_target_gt1(void)
+{
+	GT_WREG32((mem_addr_t)(mmGT_0_MEDIA_PMA_BASE + mmGT_SGUNIT_TARGET_WP_ACM),
+			GT1_WP_ACM_VAL);
+	GT_WREG32((mem_addr_t)(mmGT_0_MEDIA_PMA_BASE + mmGT_SGUNIT_TARGET_WP_ACM_CTL0),
+			GT1_WP_ACM_CTL0_VAL);
+	GT_WREG32((mem_addr_t)(mmGT_0_MEDIA_PMA_BASE + mmGT_SGUNIT_TARGET_GT1),
+			CLEAR_REG);
+	GT_WREG32((mem_addr_t)(mmGT_0_MEDIA_PMA_BASE + mmGT_SGUNIT_TARGET_WP1),
+		WP1_VAL);
+}
+
+static inline void gt_boot_target_gt2(void)
+{
+	GT_WREG32((mem_addr_t)(mmGT_0_MEDIA_PMA_BASE + mmGT_SGUNIT_TARGET_WP_ACM),
+			GT2_WP_ACM_VAL);
+	GT_WREG32((mem_addr_t)(mmGT_0_MEDIA_PMA_BASE + mmGT_SGUNIT_TARGET_WP_ACM_CTL0),
+			GT2_WP_ACM_CTL0_VAL);
+	GT_WREG32((mem_addr_t)(mmGT_0_MEDIA_PMA_BASE + mmGT_SGUNIT_TARGET_GT1),
+			CLEAR_REG);
+	GT_WREG32((mem_addr_t)(mmGT_0_MEDIA_PMA_BASE + mmGT_SGUNIT_TARGET_WP1), GT2_WP1_VAL);
+	GT_WREG32((mem_addr_t)(mmGT_0_MEDIA_PMA_BASE + mmGT_SGUNIT_TARGET_GT1),
+			GT2_TARGET_GT1_VAL);
+}
