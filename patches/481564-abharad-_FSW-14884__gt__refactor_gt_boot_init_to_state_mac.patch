+#define WAIT_BOOT_STATE_SLEEP_MS		1
+#define WAIT_BOOT_STATE_TIMEOUT_MS		500
+
+static int wait_for_boot_state(struct mgmt_compute_config *config, int target_state)
+{
+	int timeout = 0;
+
+	while (i2a_bridge_get_boot_state(config) != target_state) {
+		k_msleep(WAIT_BOOT_STATE_SLEEP_MS);
+		if (timeout++ > WAIT_BOOT_STATE_TIMEOUT_MS)
+			return -ETIMEDOUT;
+	}
+	return 0;
+}
+
+static inline void gt_boot_unlock_iosf_pmsb(void)
+{
