+	GT_BOOT_WAIT_RENDER_IS_UP = RENDER_IS_UP,
+};
+
+/* One step in the boot state machine */
+typedef struct {
+	enum gt_boot_cmd cmd;
+	enum gt_boot_wait wait;
+} gt_boot_step_t;
