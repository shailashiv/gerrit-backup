From a22d4b3143262cf24f95eb6215511636448627e0 Mon Sep 17 00:00:00 2001
From: Pardha Kesapragada <pkesapragada@habana.ai>
Date: Wed, 17 Feb 2021 20:46:12 +0200
Subject: [PATCH] [SW-20154] change the key storage function in psoc_security

PSOC SECURITY has specific entries to store the key
hashes, for user debugging. In gaudi2, it has been
decided to store just the 256 bits of the key (despite
the hash being 384 bits). This is as per recommendation
from Security architecture.

Change-Id: I27e081f58e531b1302dc22eadd481befe43725a3
Signed-off-by: Pardha Kesapragada <pkesapragada@habana.ai>
---

diff --git a/common/security.c b/common/security.c
index b033760..7da328c 100644
--- a/common/security.c
+++ b/common/security.c
@@ -241,46 +241,6 @@
 		      SECURITY_EFUSE_FW_VERSION_OFFSET);
 }
 
-__attribute__((weak)) void security_load_keys(void)
-{
-	uint8_t hash_key_index;
-	uint32_t key_hash[SECURITY_KEY_HASH_ARRAY_SIZE];
-	enum security_location key_location;
-
-	key_location = ((arcboot_rom_global.config_fuse >>
-			EFUSE_SYSCFG_KEY_LOCATION) &
-			EFUSE_SYSCFG_KEY_LOCATION_MASK);
-
-	arcboot_rom_status_update(PROGRESS_KEY_LOC);
-	arcboot_rom_status_update_location(PROGRESS_KEY_LOC_0, key_location);
-
-	switch (key_location) {
-	case SPI_FLASH:
-		spi_flash_get_hash(key_hash);
-		break;
-	case SPI_OTP:
-		spi_flash_otp_access(FLASH_OTP_ENABLE);
-		spi_flash_otp_get_hash(key_hash);
-		spi_flash_otp_access(FLASH_OTP_DISABLE);
-		break;
-	case ASIC_EFUSE:
-	default:
-		efuse_get_hash(key_hash);
-		break;
-	}
-
-	for (hash_key_index = 0; hash_key_index < SECURITY_KEY_HASH_ARRAY_SIZE;
-	     hash_key_index++) {
-		/* store habana key hash in PSOC_SECURITY */
-		regmap_writel(key_hash[hash_key_index],
-			      security_key_soc_location_offset(hash_key_index));
-		/* store key hashes in Scratch PAD Sram */
-		sp_sram_writel(key_hash[hash_key_index],
-			       SECURITY_EFUSE_KEYS_OFFSET + (hash_key_index *
-			       SECURITY_BYTE_PER_DWORD));
-	}
-}
-
 void security_report_img_fw(uint8_t index, uint32_t fw_ver)
 {
 	uint32_t offset;
