From 8f339e859c5dd37b6c83a0846e55dfe96abd3481 Mon Sep 17 00:00:00 2001
From: Guy Nisan <gnisan@habana.ai>
Date: Wed, 18 Aug 2021 18:45:12 +0300
Subject: [PATCH] [SW-0] gaudi: security: stlb fixup

Fixup for stlb secuirty same as master

Change-Id: Ib3bf83c312c32b61f2154e9f815de79f4b97add7
Signed-off-by: Guy Nisan <gnisan@habana.ai>
---

diff --git a/arch/gaudi/security.c b/arch/gaudi/security.c
index ad10cef..dbf292d 100644
--- a/arch/gaudi/security.c
+++ b/arch/gaudi/security.c
@@ -942,9 +942,6 @@
 	/* keep only regs used by LKD: offsets: 0 - 0x80 */
 	prot_base = base;
 	mask = ~(PROT_BIT(mmSTLB_CACHE_INV) &
-		 PROT_BIT(mmSTLB_CACHE_INV_BASE_39_8) &
-		 PROT_BIT(mmSTLB_CACHE_INV_BASE_49_40) &
-		 PROT_BIT(mmSTLB_HOP_CONFIGURATION) &
 		 PROT_BIT(mmSTLB_INV_PS) &
 		 PROT_BIT(mmSTLB_INV_SET) &
 		 PROT_BIT(mmSTLB_MEM_CACHE_INVALIDATION));
