From de2dbeb67bf3f393c3dac79e1464c0e816e77832 Mon Sep 17 00:00:00 2001
From: Meron Cohen <mecohen@habana.ai>
Date: Thu, 08 May 2025 20:03:33 +0300
Subject: [PATCH] [SW-227605] g2e: enable bis e compliant

Support flashing the bis-e-compliant bit to fuse.

Change-Id: Ic15d88b3f170ae394d65c37cc9f4d6124de4e467
Signed-off-by: Meron Cohen <mecohen@habana.ai>
---

diff --git a/common/include/security.h b/common/include/security.h
index 8d2009f..fd64e91 100644
--- a/common/include/security.h
+++ b/common/include/security.h
@@ -37,6 +37,7 @@
 int hl_sec_enable(void);
 int hl_sec_bis_compliant_enable(void);
 int hl_sec_bis_d_compliant_enable(void);
+int hl_sec_bis_e_compliant_enable(void);
 bool hl_sec_is_bis_compliant(void);
 int hl_sec_erom_recovery_enable(void);
 void hl_sec_dyn_img_open(uint64_t off, uint32_t size);
diff --git a/fw-loader/src/fit_loader.c b/fw-loader/src/fit_loader.c
index 423ee01..fa36e2a 100644
--- a/fw-loader/src/fit_loader.c
+++ b/fw-loader/src/fit_loader.c
@@ -1418,6 +1418,20 @@
 	return hl_sec_bis_d_compliant_enable();
 }
 
+static int fit_load_bis_e_compliant_enable(const void *fit, int conf)
+{
+	int err;
+	const char *stage;
+
+	fwupd_fit_rel_and_resp_fit_alloc(HL_FIT_RES_EMPTY, &stage, &err);
+	if (err) {
+		LOG_ERR("Fit load bis e compliant enable %s failed: %d", stage, err);
+		return -1;
+	}
+
+	return hl_sec_bis_e_compliant_enable();
+}
+
 static int fit_load_erom_recovery_enable(const void *fit, int conf)
 {
 	int err;
@@ -1994,6 +2008,14 @@
 		.post_load = true,
 		.pldm_pkg_version = false,
 	},
+	[FIT_LOAD_TYPE_BIS_E_COMPLIANT_ENABLE] = {
+		.load = fit_load_bis_e_compliant_enable,
+		.verify = NULL,
+		.secured_load = false,
+		.max_runtime_ms = FIT_LOADER_MAX_RUNTIME_UNDEFINED,
+		.post_load = true,
+		.pldm_pkg_version = false,
+	},
 	[FIT_LOAD_TYPE_EROM_RECOVERY_ENABLE] = {
 		.load = fit_load_erom_recovery_enable,
 		.verify = NULL,
diff --git a/fw-loader/src/gaudi/gaudi2/gaudi2.c b/fw-loader/src/gaudi/gaudi2/gaudi2.c
index e8e1a9f..d024906 100644
--- a/fw-loader/src/gaudi/gaudi2/gaudi2.c
+++ b/fw-loader/src/gaudi/gaudi2/gaudi2.c
@@ -518,6 +518,18 @@
 	return hl_sec_efuse_write_word(EFUSE_SEC_OFFSET, sec_word);
 }
 
+int hl_sec_bis_e_compliant_enable(void)
+{
+	uint32_t sec_word;
+
+	if (hl_sec_efuse_read_word(EFUSE_SEC_OFFSET, &sec_word))
+		return -1;
+
+	sec_word |= EFUSE_BIS_E_COMPLIANT_ENABLE;
+
+	return hl_sec_efuse_write_word(EFUSE_SEC_OFFSET, sec_word);
+}
+
 int hl_sec_erom_recovery_enable(void)
 {
 	uint32_t sec_word;
diff --git a/fw-loader/src/security.c b/fw-loader/src/security.c
index ccc8ff3..0f49470 100644
--- a/fw-loader/src/security.c
+++ b/fw-loader/src/security.c
@@ -45,6 +45,7 @@
 EMPTY_WEAK_FUNC(void hl_sec_config_dyn_rr(int rr, uint64_t min64, uint64_t max64),)
 EMPTY_WEAK_FUNC(int hl_sec_bis_compliant_enable(void), 1)
 EMPTY_WEAK_FUNC(int hl_sec_bis_d_compliant_enable(void), 1)
+EMPTY_WEAK_FUNC(int hl_sec_bis_e_compliant_enable(void), 1)
 EMPTY_WEAK_FUNC(bool hl_sec_is_bis_compliant(void), false)
 EMPTY_WEAK_FUNC(int hl_sec_erom_recovery_enable(void), 1)
 EMPTY_WEAK_FUNC(int hl_sec_write_tpm_devid(void), 0)
