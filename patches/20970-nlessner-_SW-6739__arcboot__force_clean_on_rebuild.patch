From 0e8e89b011352cc85e4328b7747ba8d4d9c285e9 Mon Sep 17 00:00:00 2001
From: Noam Lessner <nlessner@habana.ai>
Date: Sun, 10 Nov 2019 08:24:45 +0200
Subject: [PATCH] [SW-6739] arcboot: force clean on rebuild

force cleaning project before syncing to rebuild all

Change-Id: Id149835e6ebd90863ff8eebab44c19bf24673626
Signed-off-by: Noam Lessner <nlessner@habana.ai>
---

diff --git a/package/arcboot/arcboot.mk b/package/arcboot/arcboot.mk
index 4a2d5f5..8417df2 100644
--- a/package/arcboot/arcboot.mk
+++ b/package/arcboot/arcboot.mk
@@ -20,6 +20,12 @@
 	cp -dpf $(@D)/sdk/bin/sbtool $(HOST_DIR)/bin/
 endef
 
+# force BTL rebuild
+define ARCBOOT_CLEAN_BTL
+	$(MAKE) -C $(BR2_EXTERNAL) arcboot-dirclean
+endef
+
+ARCBOOT_PRE_RSYNC_HOOKS += ARCBOOT_CLEAN_BTL
 
 $(eval $(generic-package))
 $(eval $(host-generic-package))
