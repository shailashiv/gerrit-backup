index a1a1b5d..67f1a7c 100644
--- a/arch/gaudi3/ras/pldm/pldm_effecter_handlers.c
+++ b/arch/gaudi3/ras/pldm/pldm_effecter_handlers.c
@@ -258,12 +258,15 @@
 		(now >= reset_device_wait);
 }
 
-int pldm_effecter_set_limit_tdp_54v(const struct pldm_pdr_numeric_effecter *pdr,
-				    struct pldm_numeric_effecter_state *state,
-				    pldm_sensor_value_t new_state)
+int pldm_effecter_set_limit_tdp(const struct pldm_pdr_numeric_effecter *pdr,
+				struct pldm_numeric_effecter_state *state,
+				pldm_sensor_value_t new_state)
 {
 	enum cpucp_packet_rc ret;
 
+	/* PID handles differences between OAM and PCI systems and checks new state
+	 * values against the appropriate domain information
+	 */
 	ret = pid_power_write(W_TO_MILLW(new_state.u32));
 	if (ret)
 		return ret;
@@ -275,12 +278,15 @@
 	return 0;
 }
 
-int pldm_effecter_get_limit_tdp_54v(const struct pldm_pdr_numeric_effecter *pdr,
-				    struct pldm_numeric_effecter_state *state)
+int pldm_effecter_get_limit_tdp(const struct pldm_pdr_numeric_effecter *pdr,
+				struct pldm_numeric_effecter_state *state)
 {
 	enum cpucp_packet_rc ret;
 	uint64_t value;
 
+	/* PID handles differences between OAM and PCI systems and puts relevant
+	 * domain information into shared memory
+	 */
 	ret = hl_sensors_power_get_shmem(CPUCP_POWER_INPUT_MAX, &value);
 	if (ret)
 		return ret;
