+static void pdr_effecter_limit_tdp_init(struct pldm_pdr_record *record)
+{
+	const struct device *eeprom_dev = EEPROM_DEV_INST;
+	int power = hl_eeprom_get_max_power(eeprom_dev);
+
+	if (power < 0)
+		return;
+
+	record->numeric_effecter.normal_max = power;
+	record->numeric_effecter.max_settable = power;
 }
 
