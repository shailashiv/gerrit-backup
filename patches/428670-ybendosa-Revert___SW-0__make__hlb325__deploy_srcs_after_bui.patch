 	$(call hl-release-eval,$(patsubst %-release,%,$@))
 	$(call hlb325-release-push,$(patsubst %-release,%,$@))
 	$(call hlb325-release-test,$(patsubst %-release,%,$@))
@@ -86,6 +86,6 @@
 	@$(MAKE) hlb325-bmc-rsync
 
 .PHONY: hlb325-build hlb325-asic-build
-hlb325-build hlb325-asic-build: hlb325-asic-prepare hlb325-deploy-srcs
+hlb325-build hlb325-asic-build: hlb325-asic-prepare
