diff --git a/scripts/make/hlb325/Makefile b/scripts/make/hlb325/Makefile
index 72becf0..e498b81 100644
--- a/scripts/make/hlb325/Makefile
+++ b/scripts/make/hlb325/Makefile
@@ -66,7 +66,7 @@
 		$(IMAGES_DIR)
 
 .PHONY: hlb325-release
-hlb325-release: hlb325-check-release hlb325-check-branch
