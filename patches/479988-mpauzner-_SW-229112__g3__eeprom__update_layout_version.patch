From a9e6aa1e8b2dda60103afd4e9c11afca0006d59f Mon Sep 17 00:00:00 2001
From: Michael Pauzner <mpauzner@habana.ai>
Date: Mon, 19 May 2025 11:58:49 +0300
Subject: [PATCH] [SW-229112] g3: eeprom: update layout version

Set EEPROM default layout version 7.

Change-Id: I64eee31d04f5151e558a90b8918c33ef305dae11
Signed-off-by: Michael Pauzner <mpauzner@habana.ai>
---

diff --git a/scripts/make/gaudi3/Makefile b/scripts/make/gaudi3/Makefile
index cd8c2e6..a2bd5ff 100644
--- a/scripts/make/gaudi3/Makefile
+++ b/scripts/make/gaudi3/Makefile
@@ -81,7 +81,7 @@
 
 .PHONY: gaudi3-eeprom-set-defaults
 gaudi3-eeprom-set-defaults:
-	@echo "Layout Version=6" > $(IMAGES_DIR)/eeprom.txt
+	@echo "Layout Version=7" > $(IMAGES_DIR)/eeprom.txt
 	@echo "DDR Type and Speed=1c1b" >> $(IMAGES_DIR)/eeprom.txt
 	@echo "Max Frequency [MHz]=640" >> $(IMAGES_DIR)/eeprom.txt
 	@echo "Max Power [Watt]=0352" >> $(IMAGES_DIR)/eeprom.txt
@@ -115,7 +115,7 @@
 EEPROM_DATA_FILE = $(IMAGES_DIR)/eeprom-recovery.txt
 .PHONY: gaudi3-eeprom-set-recovery
 gaudi3-eeprom-set-recovery:
-	@echo "Layout Version=6" > $(EEPROM_DATA_FILE)
+	@echo "Layout Version=7" > $(EEPROM_DATA_FILE)
 	@echo "DDR Type and Speed=1c1b" >> $(EEPROM_DATA_FILE)
 	@echo "PCB Version=R0B" >> $(EEPROM_DATA_FILE)
 	@echo "HL Revision=0" >> $(EEPROM_DATA_FILE)
