index 0000000..31c01e0
--- /dev/null
+++ b/greco_arc_gnu/Makefile
@@ -0,0 +1,5 @@
+FW_SIZE := 0x8000
+
+PREBOOT_SRCS_C += $(shell ls $(HL_DEV)/pll.c)
+PREBOOT_SRCS_C += $(shell ls preboot/thermal_v2.c)
+PREBOOT_SRCS_C += $(shell ls $(HL_DEV)/security.c)
diff --git a/greco_arc_gnu/asic.c b/greco_arc_gnu/asic.c
new file mode 100644
index 0000000..fcc3647
--- /dev/null
+++ b/greco_arc_gnu/asic.c
@@ -0,0 +1,77 @@
+/*
+ * (C) Copyright 2019 HabanaLabs, Ltd.
+ * Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#include <psoc_global_conf_regs.h>
+#include <psoc_gpio0_regs.h>
+#include <dcon0_hbw_rtr_if0_rtr_h3_regs.h>
+#include <dcon0_hbw_rtr_if1_rtr_h3_regs.h>
+#include <dcon1_hbw_rtr_if0_rtr_h3_regs.h>
+#include <dcon1_hbw_rtr_if1_rtr_h3_regs.h>
+#include <dcon2_hbw_rtr_if0_rtr_h3_regs.h>
+#include <dcon2_hbw_rtr_if1_rtr_h3_regs.h>
+#include <dcon3_hbw_rtr_if0_rtr_h3_regs.h>
+#include <dcon3_hbw_rtr_if1_rtr_h3_regs.h>
+
+#include <bitops.h>
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+
+#include "common.h"
+
+u32 hl_skip_pcie_init(void)
+{
+	/* Use DumpSel[2] to skip PCIe initialization */
+	return regmap_readl(mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS_L) & BIT(10);
+}
+
+u64 hl_pll_timestamp_freq_get(void)
+{
+	return hl_pll_get_freq(mmPSOC_PCI_PLL_CTRL_BASE, HL_PLL_DIV3);
+}
+
+void hl_uart_init(void)
+{
+	u32 uart_clk_freq = hl_pll_get_freq(mmPSOC_PCI_PLL_CTRL_BASE,
+						HL_PLL_DIV3);
+
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_8);	/* UART0 RXD */
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_9);	/* UART0 TXD */
+	preboot_uart_init(uart_clk_freq / HL_UART_BAUDRATE);
+}
+
+/* configure yellow LED(GPIO2) in output mode and turn on(active low) */
+void preboot_led_on(void)
+{
+	u32 val = BIT(2);
+
+	/* configure GPIO in output mode */
+	regmap_writel(val, mmPSOC_GPIO0_OUTENSET);
+
+	/* Turn ON LED (pin is active low) */
+	val = regmap_readl(mmPSOC_GPIO0_DATAOUT);
+	val &= ~BIT(2);
+	regmap_writel(val, mmPSOC_GPIO0_DATAOUT);
+}
+
+/* initialize sram scrambling before u-boot is downloaded */
+static void sram_scrambling_init(void)
+{
+	regmap_writel(1, mmDCON0_HBW_RTR_IF0_RTR_H3_SCRAM_SRAM_EN);
+	regmap_writel(1, mmDCON0_HBW_RTR_IF1_RTR_H3_SCRAM_SRAM_EN);
+	regmap_writel(1, mmDCON1_HBW_RTR_IF0_RTR_H3_SCRAM_SRAM_EN);
+	regmap_writel(1, mmDCON1_HBW_RTR_IF1_RTR_H3_SCRAM_SRAM_EN);
+	regmap_writel(1, mmDCON2_HBW_RTR_IF0_RTR_H3_SCRAM_SRAM_EN);
+	regmap_writel(1, mmDCON2_HBW_RTR_IF1_RTR_H3_SCRAM_SRAM_EN);
+	regmap_writel(1, mmDCON3_HBW_RTR_IF0_RTR_H3_SCRAM_SRAM_EN);
+	regmap_writel(1, mmDCON3_HBW_RTR_IF1_RTR_H3_SCRAM_SRAM_EN);
+}
+
+void hl_ram_init(void)
+{
+	sram_scrambling_init();
+}
diff --git a/greco_arc_gnu/common.c b/greco_arc_gnu/common.c
new file mode 100644
index 0000000..0008810
--- /dev/null
+++ b/greco_arc_gnu/common.c
@@ -0,0 +1,245 @@
+/*
+ * (C) Copyright 2019 HabanaLabs, Ltd.
+ * Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#include <stdint.h>
+
+#include <pcie_phy_regs.h>
+#include <psoc_global_conf_regs.h>
+#include <psoc_gpio1_regs.h>
+#include <psoc_qspi_regs.h>
+#include <psoc_efuse_regs.h>
+#include <psoc_arc0_cfg_regs.h>
+#include <psoc_arc0_cfg_masks.h>
+#include <pcie_aux_regs.h>
+#include <pcie_wrap_regs.h>
+#include <pcie_core_regs.h>
+#include <pcie_dbi_regs.h>
+#include <cpu_ca53_cfg_regs.h>
+#include <cpu_timestamp_regs.h>
+
+#include <cpu_timestamp_regs.h>
+
+#include <hl_boot_if.h>				/* requires stdint.h */
+#include <greco/greco_reg_map.h>
+#include <common/pci_ids.h>
+//#include <greco_blocks_linux_driver.h>
+
+#include <bitops.h>
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+#include <string.h>
+#include <preboot/fit.h>
+#include "common.h"
+
+#include <dcon0_tstd_masks.h>
+#include <dcon0_tstd_regs.h>
+#include "preboot/thermal.h"
+
+#define FW_WORD_NUM		0x2200	/* FW_SIZE / 2 */
+
+#define mmPCIE_WRAP_VUART_TX_DATA       0xC15F60
+#define mmPCIE_WRAP_VUART_TX_STATUS     0xC15F64
+
+u32 get_efuse_read_reg(void)
+{
+	return mmPSOC_EFUSE_READ;
+}
+
+bool hl_is_debug_mode(enum hl_debug_hw_func func)
+{
+	u32 boot_strap = regmap_readl(mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS_L);
+	u32 strap_mask;
+
+	switch (func) {
+	case HL_DEBUG_HW_DBG_CARD:
+		strap_mask = BIT(11); /* Dump Select[3] */
+		break;
+	case HL_DEBUG_HW_PCIE:
+		strap_mask = BIT(10); /* Dump Select[2] */
+		break;
+	case HL_DEBUG_HW_DRAM:
+		strap_mask = BIT(8); /* Dump Select[0] */
+		break;
+	case HL_DEBUG_HW_I2C:
+		strap_mask = BIT(9); /* Dump Select[1] */
+		break;
+	default:
+		preboot_puts_hex("Unknown H/W function ", func, false);
+		return 0;
+	}
+
+	return boot_strap & strap_mask;
+}
+
+static void preboot_init_pcie_phy_fw_update(void)
+{
+	/* Configure FW update size */
+	regmap_writel(FW_WORD_NUM, mmPCIE_WRAP_PHY_FW_FSM_SIZE);
+
+	/*
+	 * PHY FW FSM EN and Direct FW write mechanism enable
+	 * FW FSM assumes that the data is present in the SRAM
+	 * The FSM will wait for SRAM init done before updating
+	 * the SRAM contents
+	 */
+	regmap_writel(9, mmPCIE_WRAP_PHY_FW_FSM);
+
+	/* Take the PHY out of reset */
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
+}
+
+__weak void preboot_init_pcie_phy(void)
+{
+	/* Reset PCIe PHY */
+	regmap_writel(0, mmPSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
+
+	/*
+	 * Set PCIe PHY CR Para I/F to CFG.
+	 * Select CR PARA I/F instead of JTAG
+	 */
+	regmap_writel(1, mmPCIE_PHY_CR_PARA_SEL_0);
+	regmap_writel(1, mmPCIE_PHY_CR_PARA_SEL_1);
+	regmap_writel(1, mmPCIE_PHY_CR_PARA_SEL_2);
+	regmap_writel(1, mmPCIE_PHY_CR_PARA_SEL_3);
+
+	/* Select indirect access to CR PARA I/F instead of PRBI */
+	regmap_writel(1, mmPCIE_PHY_CR_PARA_CFG);
+
+	/*
+	 * Use PHY configuration from SoC online
+	 * instead of default values
+	 */
+	regmap_writel(1, mmPCIE_PHY_PHY_EXT_CTRL_SEL);
+	preboot_init_pcie_phy_fw_update();
+}
+
+void preboot_delay(void) {}
+
+void preboot_putc_virt_uart(const char c)
+{
+	/*
+	 * update vUART to HOST
+	 * DATA: mmPCIE_WRAP_VUART_TX_DATA
+	 * STATUS: mmPCIE_WRAP_VUART_TX_STATUS
+	 */
+	regmap_writel(c, mmPCIE_WRAP_VUART_TX_DATA);
+	regmap_writel(1, mmPCIE_WRAP_VUART_TX_STATUS);
+}
+
+unsigned int get_cs_pad_sel(void)
+{
+	return mmPSOC_GLOBAL_CONF_PAD_SEL_19;
+}
+
+void preboot_sync_btl(void) {}
+
+void spi_ssi_cs0_get(unsigned int *mask, unsigned int *data_offset,
+		     unsigned int *out_en_offset)
+{
+	*mask = BIT(19 % 16);
+	*data_offset = mmPSOC_GPIO1_DATAOUT;
+	*out_en_offset = mmPSOC_GPIO1_OUTENSET;
+}
+
+void spi_base_get(unsigned int *regs)
+{
+	*regs = mmPSOC_QSPI_CTRLR0;
+}
+
+void preboot_copy_image(u64 dst, const void *buf, int len, const char *arch)
+{
+	/* Prepare the ARC SRAM address */
+	u32 arc_dst = ((u32)dst & 0xFFFFFFF) | BIT(28);
+
+	memcpy((void *)arc_dst, buf, len);
+}
+
+int preboot_decompress_image(u64 dst, const void *buf, int len,
+			     const char *arch, const char *compression)
+{
+	preboot_puts("Compression is not supported\n");
+	return 1;
+}
+
+void preboot_start_image(u64 startaddr)
+{
+	void (*image_entry)(void);
+	u32 lsb, msb;
+
+	if (startaddr) {
+		lsb = (u32)startaddr;
+		msb = (u32)(startaddr >> 32);
+		/* Set CPU0 Reset address to U-Boot */
+		regmap_writel(lsb, mmCPU_CA53_CFG_RST_ADDR_LSB_0);
+		regmap_writel(msb, mmCPU_CA53_CFG_RST_ADDR_MSB_0);
+
+		/* Wake up CPU0, after we put all CPUs in reset */
+		regmap_writel(0x0, mmCPU_CA53_CFG_ARM_RST_CONTROL);
+		regmap_writel(0x10111, mmCPU_CA53_CFG_ARM_RST_CONTROL);
+	}
+
+	/*
+	 * Set ARC0 in running state
+	 * 1. Set run bit in RUN_HALT_REQ register
+	 * 2. Wait for ACK from core in RUN_HALT_ACK register
+	 * 3. Clear run bit in RUN_HALT_REQ register
+	 */
+	regmap_writel(BIT(0), mmPSOC_ARC0_CFG_RUN_HALT_REQ);
+	while (!(regmap_readl(mmPSOC_ARC0_CFG_RUN_HALT_ACK) &
+				PSOC_ARC0_CFG_RUN_HALT_ACK_RUN_ACK_MASK))
+		;
+	regmap_writel(0x0, mmPSOC_ARC0_CFG_RUN_HALT_REQ);
+
+	/*
+	 * Jump to __reset of zephyr. After image_entry, control is not
+	 * expected to return here and continue.
+	 */
+	image_entry = (void *) (*(u32 *)ARC_ICCM_BASE);
+	image_entry();
+}
+
+void ppboot_cp_preboot(u64 loadaddr, u32 offset, u32 size, char *name)
+{
+	/* Not implemented - ARC BootROM copies and validates preboot */
+}
+
+u32 hl_pll_timestamp_base_get(void)
+{
+	return mmCPU_TIMESTAMP_CNTCR;
+}
+
+void pci_dev_specific_hot_rst(void)
+{
+	regmap_writel(0x10, mmPCIE_CORE_HOT_RST);
+	regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
+}
+
+static struct hl_ts_cfg greco_hl_ts_data[] = {
+	{.base = mmDCORE0_MME_TSTD_BASE, .alarm_a = 102, .alarm_b = 120,
+		.use_calib = false, .calib_offset = 10, .hl_tmp_data = { 0 }},
+	{.base = mmDCON0_TSTD_BASE, .alarm_a = 102, .alarm_b =  120,
+		.use_calib = false, .calib_offset = 9, .hl_tmp_data = { 0 }},
+	{.base = mmDCORE1_MME_TSTD_BASE, .alarm_a = 102, .alarm_b = 120,
+		.use_calib = false, .calib_offset = 8, .hl_tmp_data = { 0 }},
+	{.base = mmDCON2_TSTD_BASE, .alarm_a = 102, .alarm_b = 120,
+		.use_calib = false, .calib_offset = 7, .hl_tmp_data = { 0 }}
+};
+
+void hl_ts_data_init(void)
+{
+	greco_hl_ts_data[0].freq = hl_pll_get_freq(mmPSOC_SIF_PLL_CTRL_BASE,
+						HL_PLL_DIV3);
+	greco_hl_ts_data[1].freq = hl_pll_get_freq(mmPSOC_MME_PLL_CTRL_BASE,
+						HL_PLL_DIV3);
+	greco_hl_ts_data[2].freq = hl_pll_get_freq(mmPSOC_SIF_PLL_CTRL_BASE,
+						HL_PLL_DIV3);
+	greco_hl_ts_data[3].freq = hl_pll_get_freq(mmPSOC_MME_PLL_CTRL_BASE,
+						HL_PLL_DIV3);
+	memcpy(hl_ts_data, greco_hl_ts_data,
+			sizeof(struct hl_ts_cfg) * HL_ASIC_TS_MAX_COUNT);
+}
