+++ b/greco_arc_gnu/pldm.c
@@ -0,0 +1,69 @@
+/*
+ * (C) Copyright 2019 HabanaLabs, Ltd.
+ * Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#include <stdbool.h>
+
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+#include <psoc_pci_pll_ctrl_regs.h>
+#include <psoc_global_conf_regs.h>
+#include "common.h"
+
+#define SYS_CLOCK_FREQUENCY	155000ULL
+
+/*
+ * With Greco v88 PLDM image when PCI pll div3
+ * is bumped up tp 250 MHz actual clock goes
+ * to 12.9 KHz.
+ */
+#define UART_CLOCK_FREQUENCY	12900ULL
+
+/* Working BAUD rate on PLDM */
+#define PLDM_UART_BAUDRATE	300
+
+/*
+ * This cfg specific to PLDM bumps up uart freq
+ * to 250 MHz while keeping other div's on refclk
+ */
+static struct hl_pll_cfg greco_pll_cfg[] = {
+	{
+		.name = "PCI", .base = mmPSOC_PCI_PLL_CTRL_BASE,
+		.nr = 1, .nf = 60, .od = 2, .nb = 3,
+		.div_factor = { 0, 0, 4, 1 },
+		.div_sel = { HL_PLL_REF_CLK,
+			HL_PLL_REF_CLK,
+			HL_PLL_REF_CLK,
+			HL_PLL_DIV_PLL
+		},
+	}
+};
+
+u32 hl_skip_pcie_init(void)
+{
+	return 0;
+}
+
+u64 hl_pll_timestamp_freq_get(void)
+{
+	return SYS_CLOCK_FREQUENCY;
+}
+
+void hl_dev_pll_init(void)
+{
+	/* Bump up UART frequency */
+	hl_pll_init(greco_pll_cfg, 1);
+}
+
+void hl_uart_init(void)
+{
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_8);	/* UART0 RXD */
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_9);	/* UART0 TXD */
+	preboot_uart_init(UART_CLOCK_FREQUENCY / PLDM_UART_BAUDRATE);
+}
+
+void preboot_init_pcie_phy(void) {}
diff --git a/greco_arc_gnu/pll.c b/greco_arc_gnu/pll.c
new file mode 100644
index 0000000..f849dcd
--- /dev/null
+++ b/greco_arc_gnu/pll.c
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2016-2020 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <stddef.h>
+#include <bitops.h>
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+#include "common.h"
+
+
+#define GRECO_PLL_CFG_DIV		0x104
+
+u32 hl_pll_get_freq(u32 pll_base, enum hl_pll_div_out div)
+{
+	u32 div_sel, factor, offset;
+	u32 reg, fbdiv, refdiv, postdiv1, postdiv2;
+	u64 out_freq = SYS_REF_CLOCK;
+
+	offset = div * sizeof(u32);
+	div_sel = regmap_readl(pll_base + HL_PLL_DIV_SEL + offset);
+
+	if (div_sel == HL_PLL_PLL_CLK || div_sel == HL_PLL_DIV_PLL) {
+		reg = regmap_readl(pll_base + GRECO_PLL_CFG_DIV);
+		/* fbdiv : bits 0-11 */
+		fbdiv = EXTRACT_BITS(reg, 0, 12);
+		/* postdiv1 : bits 16-18 */
+		postdiv1 = EXTRACT_BITS(reg, 16, 3);
+		/* postdiv2 : bits 20-22 */
+		postdiv2 = EXTRACT_BITS(reg, 20, 3);
+		/* refdiv : bits 24-29 */
+		refdiv  = EXTRACT_BITS(reg, 24, 6);
+		out_freq = SYS_REF_CLOCK * fbdiv;
+		out_freq /= refdiv * postdiv1 * postdiv2;
+	}
+
+	if (div_sel == HL_PLL_DIV_REF || div_sel == HL_PLL_DIV_PLL) {
+		factor = regmap_readl(pll_base + HL_PLL_DIV_FACTOR + offset);
+		out_freq /= factor + 1;
+	}
+
+	/*
+	 * TODO : The clock relaxation is not accounted here.
+	 * We might need to deal with it in the future.
+	 */
+
+	return out_freq;
+}
+
+#ifdef TARGET_IS_PLDM
+
+#define GRECO_PLL_CFG		0x100
+#define GRECO_PLL_CFG_EN	BIT(0)
+#define GRECO_PLL_CFG_LOCK	BIT(16)
+#define GRECO_PLL_DIV_SEL_DELAY	0x1E0
+
+
+void hl_pll_reset(struct hl_pll_cfg *cfg, bool reset)
+{
+	u32 reg = regmap_readl(cfg->base + GRECO_PLL_CFG);
+
+	if (true == reset)
+		reg |= GRECO_PLL_CFG_EN;
+	else
+		reg &= ~GRECO_PLL_CFG_EN;
+
+	regmap_writel(reg, cfg->base + GRECO_PLL_CFG);
+}
+
+int hl_pll_is_locked(struct hl_pll_cfg *cfg)
+{
+	return regmap_readl(cfg->base + GRECO_PLL_CFG) & GRECO_PLL_CFG_LOCK;
+}
+
+#define GRECO_PLL_POSTDIV1_SHIFT	16
+#define GRECO_PLL_POSTDIV2_SHIFT	20
+#define GRECO_PLL_REFDIV_SHIFT		24
+#define GRECO_PLL_MAX_WAIT_TIME		1
+
+void hl_pll_cfg(struct hl_pll_cfg *cfg)
+{
+	u32 reg = 0;
+
+	/* put the PLL into reset by writing 0 to CTRL_CFG.EN */
+	hl_pll_reset(cfg, false);
+
+	/* FBDIV - bit 0
+	 * POSTDIV1 - bit 16
+	 * POSTDIV2 - bit 20
+	 * REFDIV - bit 24
+	 */
+	reg = cfg->nr << GRECO_PLL_REFDIV_SHIFT |
+		cfg->nb << GRECO_PLL_POSTDIV2_SHIFT |
+		cfg->od << GRECO_PLL_POSTDIV1_SHIFT | cfg->nf;
+
+	regmap_writel(reg, cfg->base + GRECO_PLL_CFG_DIV);
+
+	/* after updating the coefficients we need to wait >=1us */
+	udelay(GRECO_PLL_MAX_WAIT_TIME);
+
+	/* enable the PLL by writing a value of 1 to CTRL_CFG.EN*/
+	hl_pll_reset(cfg, true);
+}
+
+void hl_pll_ack_int(struct hl_pll_cfg *cfg) { }
+
+void hl_pll_clear_lock_status(struct hl_pll_cfg *cfg) { }
+
+void hl_pll_clk_relax_reset(struct hl_pll_cfg *cfg)
+{
+	/* TODO: implement resetting the clock relaxation */
+}
+
+void hl_pll_set_div_sel_delay(struct hl_pll_cfg *cfg)
+{
+	regmap_writel(1, cfg->base + GRECO_PLL_DIV_SEL_DELAY);
+}
+
+#endif /* TARGET_IS_PLDM */
