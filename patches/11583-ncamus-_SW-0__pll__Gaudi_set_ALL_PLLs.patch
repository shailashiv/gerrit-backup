diff --git a/gaudi/gaudi.h b/gaudi/gaudi.h
index 6f80dc9..37564b4 100644
--- a/gaudi/gaudi.h
+++ b/gaudi/gaudi.h
@@ -8,8 +8,24 @@
 /* Use DumpSel[11] to skip PCIe initialization */
 #define SKIP_PCIE_INIT BIT(19)
 
+#define mmDMA_W_PLL_BASE		0x487000
+#define mmIF_W_PLL_BASE			0x488000
+#define mmIF_E_PLL_BASE			0x4A7000
+#define mmDMA_E_PLL_BASE		0x4A8000
+#define mmMESH_W_PLL_BASE		0x4C7000
+#define mmSRAM_W_PLL_BASE		0x4C8000
+#define mmMESH_E_PLL_BASE		0x4E7000
+#define mmSRAM_E_PLL_BASE		0x4E8000
 #define mmPSOC_CPU_PLL_BASE		0xC70000
+#define mmPSOC_MME_PLL_BASE		0xC71000
 #define mmPSOC_PCI_PLL_BASE		0xC72000
+#define mmPSOC_TPC_PLL_BASE		0xC73000
+#define mmPSOC_HBM_PLL_BASE		0xC74000
+#define mmNIC0_PLL_BASE			0xCF9000
+#define mmNIC1_PLL_BASE			0xD39000
+#define mmNIC2_HBM_PLL_BASE		0xD78000
+#define mmNIC2_MME_PLL_BASE		0xD79000
+#define mmNIC2_TPC_PLL_BASE		0xD7A000
 #define CPU_PLL_BASE			mmPSOC_CPU_PLL_BASE
 
 #define HL_CPU_CYCELS_PER_USEC		120000000
