+
+	regmap_writel(rr_ctx->data_min,
+			mmD0_PCIE_MSTR_RR_MSTR_IF_RR_HBW_PRIV_RANGE_MIN_LO_0 + rr_dist);
+	regmap_writel(rr_ctx->data_min_hi,
+			mmD0_PCIE_MSTR_RR_MSTR_IF_RR_HBW_PRIV_RANGE_MIN_HI_0 + rr_dist);
+	regmap_writel(rr_ctx->data_max,
+			mmD0_PCIE_MSTR_RR_MSTR_IF_RR_HBW_PRIV_RANGE_MAX_LO_0 + rr_dist);
+	regmap_writel(rr_ctx->data_max_hi,
+			mmD0_PCIE_MSTR_RR_MSTR_IF_RR_HBW_PRIV_RANGE_MAX_HI_0 + rr_dist);
+	regmap_writel(rr_ctx->en_val,
+			mmD0_PCIE_MSTR_RR_MSTR_IF_RR_HBW_PRIV_RANGE_EN_0 + rr_dist);
+
+	security_rr_update_hit_reg(mmD0_PCIE_MSTR_RR_MSTR_IF_RR_HBW_PRIV_HIT_AW,
+				rr_ctx->rr_idx);
+
+	regmap_writel(rr_ctx->data_min,
+			mmD0_NRTR0_3CH_CTRL0_RR_HBW_PRIV_RANGE_MIN_LO_0 + rr_dist);
+	regmap_writel(rr_ctx->data_min_hi,
+			mmD0_NRTR0_3CH_CTRL0_RR_HBW_PRIV_RANGE_MIN_HI_0 + rr_dist);
+	regmap_writel(rr_ctx->data_max,
+			mmD0_NRTR0_3CH_CTRL0_RR_HBW_PRIV_RANGE_MAX_LO_0 + rr_dist);
+	regmap_writel(rr_ctx->data_max_hi,
+			mmD0_NRTR0_3CH_CTRL0_RR_HBW_PRIV_RANGE_MAX_HI_0 + rr_dist);
+	regmap_writel(rr_ctx->en_val,
+			mmD0_NRTR0_3CH_CTRL0_RR_HBW_PRIV_RANGE_EN_0 + rr_dist);
+
+	security_rr_update_hit_reg(mmD0_NRTR0_3CH_CTRL0_RR_HBW_PRIV_HIT_AW,
+					rr_ctx->rr_idx);
+}
