From 19c2be2912daa510b9e0e94edccc143cb60ec933 Mon Sep 17 00:00:00 2001
From: Sanyog Kale <skale@habana.ai>
Date: Thu, 04 Mar 2021 20:49:22 +0200
Subject: [PATCH] [SW-31170] greco: replace specs folder name to goya2

The external specs folder name is kept as goya2. In order to
overcome this issue, this patch adds change to rename specs
folder name to goya2 in case of greco HL_TARGET. This patch
will be reverted once external specs folder name is renamed to greco.

Change-Id: I62bfaf1bacb110a1421cbd3b949fac0df5c270a1
---

diff --git a/Makefile b/Makefile
index 20d3ad3..732b5fd 100644
--- a/Makefile
+++ b/Makefile
@@ -1,10 +1,15 @@
 CC = $(CROSS_COMPILE)gcc
 OBJCOPY = $(CROSS_COMPILE)objcopy
+SPECS_EMB_DEV := $(shell echo $(HL_DEV) | cut -d'_' -f1)
 SPECS_DEV := $(shell echo $(HL_DEV) | cut -d'_' -f1)
+ifeq ($(SPECS_DEV),greco)
+	SPECS_DEV := goya2
+endif
+
 CFLAGS += -I$(SPECS_DIR)
 CFLAGS += -I$(SPECS_DIR)/$(SPECS_DEV)/asic_reg
 CFLAGS += -I$(SPECS_EMBEDDED_DIR)
-CFLAGS += -include $(SPECS_EMBEDDED_DIR)/$(SPECS_DEV)/$(SPECS_DEV)_reg_map.h
+CFLAGS += -include $(SPECS_EMBEDDED_DIR)/$(SPECS_EMB_DEV)/$(SPECS_EMB_DEV)_reg_map.h
 CFLAGS += -Wall -Werror
 CFLAGS += -g -c -fno-builtin
 CFLAGS += -I ./include/ -I ./ -I ./common/ -I ./$(HL_DEV)/
diff --git a/recovery/Makefile b/recovery/Makefile
index 9bbd5ca..20638db 100644
--- a/recovery/Makefile
+++ b/recovery/Makefile
@@ -1,6 +1,10 @@
 CC = $(CROSS_COMPILE)gcc
 OBJCOPY = $(CROSS_COMPILE)objcopy
 SPECS_DEV := $(shell echo $(HL_DEV) | cut -d'_' -f1)
+ifeq ($(SPECS_DEV),greco)
+	SPECS_DEV := goya2
+endif
+
 CFLAGS += -I$(SPECS_EMBEDDED_DIR)
 CFLAGS += -I$(SPECS_DIR)/$(SPECS_DEV)/asic_reg
 CFLAGS += -Wall -Werror
