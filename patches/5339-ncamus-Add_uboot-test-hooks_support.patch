@@ -0,0 +1,4 @@
+config BR2_PACKAGE_UBOOT_TEST_HOOKS
+	bool "U-Boot Test hooks"
+	help
+	  This is U-Boot primary testing option
diff --git a/package/uboot-test-hooks/uboot-test-hooks.mk b/package/uboot-test-hooks/uboot-test-hooks.mk
new file mode 100644
index 0000000..fe403e2
--- /dev/null
+++ b/package/uboot-test-hooks/uboot-test-hooks.mk
@@ -0,0 +1,22 @@
+UBOOT_TEST_HOOKS_VERSION = 1.0.0
+UBOOT_TEST_HOOKS_SITE = https://github.com/swarren/uboot-test-hooks.git
+UBOOT_TEST_HOOKS_LICENSE = unclear
+
+HOST_UBOOT_TEST_HOOKS_DEPENDENCIES = uboot
+
+HOST_UBOOT_TEST_HOOKS_MAKE_OPTS += --build-dir=$(UBOOT_DIR)
+HOST_UBOOT_TEST_HOOKS_MAKE_OPTS += --board-type=$(HOST_UBOOT_TEST_HOOKS_BRD)
+HOST_UBOOT_TEST_HOOKS_MAKE_OPTS +=  -s
+HOST_UBOOT_TEST_HOOKS_MAKE_OPTS +=  -k dali
+HOST_UBOOT_TEST_HOOKS_MAKE_ENV   += PATH=$(PATH):$(@D)/bin
+HOST_UBOOT_TEST_HOOKS_MAKE_ENV   += PYTHONPATH=$(PYTHONPATH):$(@D)/py/habanalabs
+
+define HOST_UBOOT_TEST_HOOKS_BUILD_CMDS
+	(cd $(@D);					\
+		$(HOST_UBOOT_TEST_HOOKS_MAKE_ENV)	\
+		$(UBOOT_DIR)/test/py/test.py		\
+		$(HOST_UBOOT_TEST_HOOKS_MAKE_OPTS)	\
+	)
+endef
+
+$(eval $(host-generic-package))
