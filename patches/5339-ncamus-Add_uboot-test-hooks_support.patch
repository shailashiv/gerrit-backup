diff --git a/board/habanalabs/common/vivado_lab/viv.sh b/board/habanalabs/common/vivado_lab/viv.sh
new file mode 100755
index 0000000..f88fb61
--- /dev/null
+++ b/board/habanalabs/common/vivado_lab/viv.sh
@@ -0,0 +1,40 @@
+#!/bin/bash
+
+board=${1:-onix}
+action=${2:-none}
+
+case "$board" in
+*asic)
+        ;;
+*onix)
+        ;;
+*pldm)
+        ;;
+*)
+        echo "error - Unknown board name: $board"
+        exit 2
+        ;;
+esac
+
+# Expected hostname is monster<id>-nuc and relevant ONIX mounted on monster<id>
+HOST_NAME=${HOSTNAME%-*}
+if [ "${HOST_NAME}" == "monster4" ]; then
+	DEBUG_BRD_VENDOR=dspg
+else
+	DEBUG_BRD_VENDOR=avnet
+fi
+
+VIV_PROG_TCL=program-${DEBUG_BRD_VENDOR}.tcl
+VIV_ERASE_TCL=erase.tcl
+VIV_ARGS="-nojournal -nolog -mode batch"
+VIV_BASE=/opt/Xilinx/Vivado_Lab/2017.4/bin
+VIV_PROG_CMD="${VIV_BASE}/vivado_lab ${VIV_ARGS} -source ${VIV_PROG_TCL}"
+VIV_ERASE_CMD="${VIV_BASE}/vivado_lab ${VIV_ARGS} -source ${VIV_ERASE_TCL}"
+VIV_WORK=/var/lib/tftpboot/tests/vivado_lab
+
+if [ "${action}" == "erase" ]; then
+	sshpass -p123456 scp ${VIV_WORK}/${VIV_ERASE_TCL} root@${HOST_NAME}:${VIV_WORK}/
+	sshpass -p123456 ssh root@${HOST_NAME} "cd ${VIV_WORK} && ${VIV_ERASE_CMD} > /dev/null"
+fi
+sshpass -p123456 scp ${VIV_WORK}/${VIV_PROG_TCL} root@${HOST_NAME}:${VIV_WORK}/
+sshpass -p123456 ssh root@${HOST_NAME} "cd ${VIV_WORK} && ${VIV_PROG_CMD} > /dev/null"
