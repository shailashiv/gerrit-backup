 {
 	return HL_BOOT_INFO_VERSION;
 }
+
+void arcboot_rom_verify(void)
+{
+	struct hl_fw_boot_ptrs boot_ptr;
+	uint32_t boot_ptr_addr = 0;
+	int ret;
+	uint32_t img_plus_key_len;
+	uint8_t crc_bytes, num_chunks;
+
+	if (!security_efuse_image_validation_en())
+		return;
+
+	boot_ptr_addr = boot_desc_param_get(&boot_ptr);
+
+	if (!boot_ptr_addr)
+		execute_pcie_recovery();
+
+	num_chunks = boot_ptr.boot_ptrs_img_sz / MAX_DMA_SIZE_CRC;
+	if (boot_ptr.boot_ptrs_img_sz % MAX_DMA_SIZE_CRC)
+		num_chunks++;
+
+	crc_bytes = num_chunks * CRC32_SIZE;
+
+	img_plus_key_len = boot_ptr.boot_ptrs_img_sz - boot_ptr.sig_sz - crc_bytes;
+
+	ret = secureboot_verify_image_v2((uint8_t *)boot_ptr_addr, img_plus_key_len,
+			(uint8_t *)(boot_ptr_addr + img_plus_key_len - boot_ptr.pub_key_sz), boot_ptr.pub_key_sz,
+			(uint8_t *)(boot_ptr_addr + img_plus_key_len), boot_ptr.sig_sz,
+			boot_ptr.sec_ver, boot_ptr.key_idx);
+
+	if (ret == SECUREBOOT_VERIFY_SUCCESS) {
+		arcboot_rom_status_update(PROGRESS_BOOT_DESC_VERIFY_SUCCESS);
+	} else {
+		if (ret == SECUREBOOT_VERIFY_VER_FAILED)
+			arcboot_rom_status_update(PROGRESS_BOOT_DESC_VERIFY_VERSION_FAIL);
+		else if (ret == SECUREBOOT_VERIFY_KEY_REVOKED)
+			arcboot_rom_status_update(PROGRESS_BOOT_DESC_VERIFY_KEY_REVOKED);
+		else if (ret == SECUREBOOT_VERIFY_KEY_FAILED)
+			arcboot_rom_status_update(PROGRESS_BOOT_DESC_VERIFY_KEY_HASH_FAIL);
+		else // (ret = SECUREBOOT_VERIFY_FAILED)
+			arcboot_rom_status_update(PROGRESS_BOOT_DESC_VERIFY_AUTH_FAIL);
+
+		execute_pcie_recovery();
+	}
+}
