 	case I2C_SPEED_FAST:
-		__fallthrough;
+		if (I2C_CUSTOM_LCNT <= (read_hs_spklen(reg_base) + 7)) {
+			value = read_hs_spklen(reg_base) + 8;
+		} else {
+			value = I2C_CUSTOM_LCNT;
+		}
+
+		dw->lcnt = value;
+
+		if (I2C_CUSTOM_HCNT <= (read_hs_spklen(reg_base) + 5)) {
+			value = read_hs_spklen(reg_base) + 6;
+		} else {
+			value = I2C_CUSTOM_HCNT;
+		}
+
+		dw->hcnt = value;
+		break;
 	case I2C_SPEED_FAST_PLUS:
 		/*
 		 * Following the directions on DW spec page 59, IC_FS_SCL_LCNT
@@ -1095,7 +1110,7 @@
 	dw->app_config = i2c_map_dt_bitrate(rom->bitrate);
 
 	if (i2c_dw_runtime_configure(dev, dw->app_config) != 0) {
