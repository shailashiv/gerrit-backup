+#define I2C_FS_HCNT		((((I2C_INPUT_FREQ_MHZ * 1000) / I2C_FAST_FREQ_KHZ) / 2) - 17)
+#define I2C_FS_LCNT		((((I2C_INPUT_FREQ_MHZ * 1000) / I2C_FAST_FREQ_KHZ) / 2) - 1)
+#define I2C_HS_HCNT		((((I2C_INPUT_FREQ_MHZ * 1000) / I2C_HIGH_FREQ_KHZ) / 2) - 17)
+#define I2C_HS_LCNT		((((I2C_INPUT_FREQ_MHZ * 1000) / I2C_HIGH_FREQ_KHZ) / 2) - 1)
+#define I2C_CUSTOM_HCNT		((CONFIG_I2C_DW_CLOCK_SPEED * 6) / 8)
+#define I2C_CUSTOM_LCNT		((CONFIG_I2C_DW_CLOCK_SPEED * 7) / 8)
+/*
+ * DesignWare speed values don't directly translate from the Zephyr speed
+ * selections in include/i2c.h so here we do a little translation
+ */
+#define I2C_DW_SPEED_STANDARD		0x1
+#define I2C_DW_SPEED_FAST		0x2
+#define I2C_DW_SPEED_FAST_PLUS		0x2
+#define I2C_DW_SPEED_HIGH		0x3
+
+/*
+ * SDA Holdtime conversion from nanosecond to clock ticks.
+ * (0.5*10^6) added before division with 10^6 to avoid
+ * losing fraction.
+ */
+#define i2c_dw_ns_to_clks(x) (((x * CONFIG_I2C_DW_CLOCK_SPEED * 1000) + 500000)\
+								/ 1000000)
+
+
+/*
+ * These values have been randomly selected.  It would be good to test different
+ * watermark levels for performance capabilities
+ */
+#define I2C_DW_TX_WATERMARK		2
+#define I2C_DW_RX_WATERMARK		7
+
+
+struct i2c_dw_rom_config {
+	DEVICE_MMIO_ROM;
+	i2c_isr_cb_t	config_func;
+	uint32_t		bitrate;
+
+#if defined(CONFIG_PINCTRL)
+	const struct pinctrl_dev_config *pcfg;
+#endif
+#if defined(CONFIG_RESET)
+	const struct reset_dt_spec reset;
+#endif
+
+	uint32_t		sda_hold_time;
+#if DT_ANY_INST_ON_BUS_STATUS_OKAY(pcie)
+	struct pcie_dev *pcie;
+#endif /* I2C_DW_PCIE_ENABLED */
+
+#ifdef CONFIG_I2C_DW_LPSS_DMA
+	const struct device *dma_dev;
+#endif
+};
+
+struct i2c_dw_dev_config {
+	DEVICE_MMIO_RAM;
+	struct k_sem		device_sync_sem;
+	struct k_mutex		bus_mutex;
+	uint32_t app_config;
+
+	uint8_t			*xfr_buf;
+	uint32_t		xfr_len;
+	uint32_t		rx_pending;
+	bool			user_abort_pending;
+
+	uint16_t		hcnt;
+	uint16_t		lcnt;
+
+	volatile uint8_t	state;  /* last direction of transfer */
+	uint32_t		request_bytes;
+	uint8_t			xfr_flags;
+	bool			support_hs_mode;
+#ifdef CONFIG_I2C_DW_LPSS_DMA
+	uintptr_t phy_addr;
+	uintptr_t base_addr;
+	/* For dma transfer */
+	bool xfr_status;
+#endif
+
+	uint32_t		sda_hold_time_val;
+#ifdef CONFIG_I2C_TARGET
+	struct i2c_target_config *slave_cfg;
+	bool slave_attached;
+#endif
+
+	struct {
+		uint32_t	enable;
+		uint32_t	con;
+		uint32_t	intr_stat;
+		uint32_t	raw_intr_stat;
+		uint32_t	status;
+		uint32_t	tx_abrt_src;
+		uint32_t	rxtl;
+		uint32_t	txtl;
+		uint32_t	rxflr;
+		uint32_t	txflr;
+		uint32_t	comp_param_1;
+	} regs;
+	const char *failure_reason;
+};
+
+#define Z_REG_READ(__sz) sys_read##__sz
+#define Z_REG_WRITE(__sz) sys_write##__sz
+#define Z_REG_SET_BIT sys_set_bit
+#define Z_REG_CLEAR_BIT sys_clear_bit
+#define Z_REG_TEST_BIT sys_test_bit
+
+#define DEFINE_MM_REG_READ(__reg, __off, __sz)				\
+	static inline uint32_t read_##__reg(uintptr_t addr)			\
+	{								\
+		return Z_REG_READ(__sz)(addr + __off);			\
+	}
+#define DEFINE_MM_REG_WRITE(__reg, __off, __sz)				\
+	static inline void write_##__reg(uint32_t data, uintptr_t addr)	\
+	{								\
+		Z_REG_WRITE(__sz)(data, addr + __off);			\
+	}
+
+#define DEFINE_SET_BIT_OP(__reg_bit, __reg_off, __bit)			\
+	static inline void set_bit_##__reg_bit(uintptr_t addr)		\
+	{								\
+		Z_REG_SET_BIT(addr + __reg_off, __bit);			\
+	}
+
+#define DEFINE_CLEAR_BIT_OP(__reg_bit, __reg_off, __bit)		\
+	static inline void clear_bit_##__reg_bit(uintptr_t addr)		\
+	{								\
+		Z_REG_CLEAR_BIT(addr + __reg_off, __bit);		\
+	}
+
+#define DEFINE_TEST_BIT_OP(__reg_bit, __reg_off, __bit)			\
+	static inline int test_bit_##__reg_bit(uintptr_t addr)		\
+	{								\
+		return Z_REG_TEST_BIT(addr + __reg_off, __bit);		\
+	}
+
+#ifdef __cplusplus
+}
+#endif
+
+#if defined(CONFIG_I2C_DW_DEV_RECOVERY)
+int i2c_check_and_recover(const struct device *dev);
+void i2c_platform_spec_init(const struct device *dev);
+#else
+static inline int i2c_check_and_recover(const struct device *dev)
+{
+	return 1;
+}
+static void i2c_platform_spec_init(const struct device *dev) {}
+#endif
+
+#endif /* ZEPHYR_DRIVERS_I2C_I2C_DW_H_ */
