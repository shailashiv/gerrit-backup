From 369d66196d8c70579cc73afb574911a372393065 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Thu, 31 Oct 2024 10:29:44 +0200
Subject: [PATCH] [SW-207059] gaudi3: pci: update eq preset mask

For better GEN5 link stability in GT servers the equalization preset
mask is updated.

Change-Id: I28ab17d87325e62a1bc548c16e7bf8e7d93571bc
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/arch/gaudi3/arc/common.c b/arch/gaudi3/arc/common.c
index 14d1e0a..5b6561c 100644
--- a/arch/gaudi3/arc/common.c
+++ b/arch/gaudi3/arc/common.c
@@ -1002,7 +1002,7 @@
 static void pif_arc_config_dbi_params(void)
 {
 	regmap_writel(0x02402801, D0_PCIE_DBI_SIG_REG(mmPCIE_DBI_GEN3_RELATED_OFF));
-	regmap_writel(0x04002031, D0_PCIE_DBI_SIG_REG(mmPCIE_DBI_GEN3_EQ_CONTROL_OFF));
+	regmap_writel(0x05026031, D0_PCIE_DBI_SIG_REG(mmPCIE_DBI_GEN3_EQ_CONTROL_OFF));
 	regmap_rmwritel(D0_PCIE_DBI_SIG_REG(mmPCIE_DBI_DEVICE_CAPABILITIES2_REG),
 					ENABLE_PWRBRK_CTRL_VAL, EMR_PWR_M);
 
