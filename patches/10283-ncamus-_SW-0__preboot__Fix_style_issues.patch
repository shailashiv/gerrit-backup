From 7e3726bdbb439ef9d7ed92fa649272b668a875ee Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Wed, 20 Mar 2019 05:44:20 +0200
Subject: [PATCH] [SW-0] preboot: Fix style issues

Change-Id: I3f8fc22907116e9f6f0c99d879debe6918c787e3
---

diff --git a/Makefile b/Makefile
index 7cce54f..19a692b 100644
--- a/Makefile
+++ b/Makefile
@@ -14,6 +14,7 @@
 else
 	CFLAGS += -DDEV_IS_GAUDI
 endif
+
 ifeq ($(HL_TARGET),pldm)
 	CFLAGS += -DTARGET_IS_PLDM
 endif
@@ -53,4 +54,4 @@
 clean:
 	rm -f $(PREBOOT_OBJECTS) $(AUTO_GENERATED_FILE)
 
-.PHONY: clean
\ No newline at end of file
+.PHONY: clean
diff --git a/pll.c b/pll.c
index 55008f7..18ee3fc 100644
--- a/pll.c
+++ b/pll.c
@@ -1,9 +1,10 @@
 #include <common.h>
 #include <command.h>
 #include <linux/delay.h>
-#include <asm/io.h>
+#include <linux/io.h>
 #include <linux/types.h>
 #include "pll.h"
+#include "uart.h"
 
 #ifdef DEV_IS_GOYA
 #define HL_PLL_NR		0x100
@@ -58,26 +59,25 @@
 };
 
 static struct hl_pll_cfg goya_pll_cfg[] = {
-	{.name="CPU", .base=(void*)mmCPU_PLL_BASE,
-	 .nr=0, .nf=47, .od=1, .nb=23, .div_factor={0,23,1,-1}},
-	{.name="IC", .base=(void*)mmIC_PLL_BASE,
-	 .nr=0, .nf=63, .od=15, .nb=31, .div_factor={0,1,1,2}},
-	{.name="MME", .base=(void*)mmPSOC_MME_PLL_BASE,
-	 .nr=0, .nf=63, .od=15, .nb=31, .div_factor={0,1,2,8}},
+	{.name = "CPU", .base = (void *)mmCPU_PLL_BASE,
+	 .nr = 0, .nf = 47, .od = 1, .nb = 23, .div_factor = {0, 23, 1, -1} },
+	{.name = "IC", .base = (void *)mmIC_PLL_BASE,
+	 .nr = 0, .nf = 63, .od = 15, .nb = 31, .div_factor = {0, 1, 1, 2} },
+	{.name = "MME", .base = (void *)mmPSOC_MME_PLL_BASE,
+	 .nr = 0, .nf = 63, .od = 15, .nb = 31, .div_factor = {0, 1, 2, 8} },
 };
-
-extern void preboot_puts_raw(const char *str);
 
 static int hl_pll_get_cfg(struct hl_pll_cfg **hl_pll_cfg)
 {
-	int pll_num = sizeof(goya_pll_cfg) / sizeof(goya_pll_cfg[0]);
+	int pll_num = ARRAY_SIZE(goya_pll_cfg);
 
 	*hl_pll_cfg = goya_pll_cfg;
 
 	return pll_num;
 }
 
-static enum hl_pll_bypass_val hl_pll_bypass_get(struct hl_pll_cfg *cfg, enum hl_pll_div_out out)
+static enum hl_pll_bypass_val hl_pll_bypass_get(struct hl_pll_cfg *cfg,
+							enum hl_pll_div_out out)
 {
 	int offset = out * sizeof(u32);
 
@@ -92,7 +92,8 @@
 	 * 1) the CPU PLL offset in the array is 0
 	 * 2) DIV1 is the PLL output to timestamp counter.
 	 */
-	enum hl_pll_bypass_val bval = hl_pll_bypass_get(goya_pll_cfg, HL_PLL_DIV1);
+	enum hl_pll_bypass_val bval =
+			hl_pll_bypass_get(goya_pll_cfg, HL_PLL_DIV1);
 
 	if (bval == HL_PLL_REF_CLK || bval == HL_PLL_DIV_REF)
 		cnt = BYPASS_CYCLES_PER_USEC;
@@ -101,7 +102,8 @@
 
 	cnt = (cnt * usec) / MIN_CYCLES_PER_ITER;
 
-	while (cnt--);
+	while (cnt--)
+		;
 }
 
 static void hl_pll_reset(struct hl_pll_cfg *cfg, bool reset)
@@ -172,7 +174,8 @@
 		if (bypass)
 			writel(HL_PLL_REF_CLK, reg);
 		else
-			writel(cfg->div_factor[sel] ? HL_PLL_DIV_PLL : HL_PLL_PLL_CLK, reg);
+			writel(cfg->div_factor[sel] ?
+					HL_PLL_DIV_PLL : HL_PLL_PLL_CLK, reg);
 	}
 
 	/* just to be on a safe side, wait for bypass to propagate */
@@ -236,8 +239,9 @@
 		/* DIV0 is the undivided PLL output */
 		bval = hl_pll_bypass_get(hl_pll_cfg + i, HL_PLL_DIV0);
 		if ((u64)hl_pll_cfg[i].base == mmCPU_PLL_BASE &&
-			bval != HL_PLL_REF_CLK && bval != HL_PLL_DIV_REF)
-				continue;
+				bval != HL_PLL_REF_CLK &&
+				bval != HL_PLL_DIV_REF)
+			continue;
 
 		hl_pll_set(hl_pll_cfg + i);
 	}
diff --git a/preboot.c b/preboot.c
index 63fb26d..ab32f63 100644
--- a/preboot.c
+++ b/preboot.c
@@ -40,18 +40,22 @@
 
 	modifiable_image_pending = readl(mmPSOC_GLOBAL_CONF_NON_RST_FLOPS_3);
 	if (modifiable_image_pending == FLOPS_UPD_PENDING) {
-		next_image_modifiable = (*(unsigned int*)(HL_SPI_BASE + 0x60004) & 0xff) - '1';
+		next_image_modifiable =
+			(*(unsigned int *)(HL_SPI_BASE + 0x60004) & 0xff) - '1';
 		if (next_image_modifiable < 2) {
 			next_image = next_image_modifiable;
-			writel((next_image + FLOPS_UPD_NXT_IMG1), mmPSOC_GLOBAL_CONF_NON_RST_FLOPS_3);
+			writel((next_image + FLOPS_UPD_NXT_IMG1),
+					mmPSOC_GLOBAL_CONF_NON_RST_FLOPS_3);
 			try_new_image = true;
 		} else
-			writel(FLOPS_UPD_NOOP, mmPSOC_GLOBAL_CONF_NON_RST_FLOPS_3);
+			writel(FLOPS_UPD_NOOP,
+					mmPSOC_GLOBAL_CONF_NON_RST_FLOPS_3);
 	}
 
 	if (!try_new_image) {
 		spl_image = "stable";
-		next_image_stable = (*(unsigned int*)(HL_SPI_BASE + 0x60000) & 0xff) - '1';
+		next_image_stable =
+			(*(unsigned int *)(HL_SPI_BASE + 0x60000) & 0xff) - '1';
 		if (next_image_stable < 2)
 			next_image = next_image_stable;
 		else
@@ -70,7 +74,8 @@
 	preboot_puts(")\n");
 
 	*spl_off = image_base_offset + spl_offset;
-	writel((image_base_offset + uboot_offset), mmPSOC_GLOBAL_CONF_SCRATCHPAD_30);
+	writel((image_base_offset + uboot_offset)
+			, mmPSOC_GLOBAL_CONF_SCRATCHPAD_30);
 }
 
 
@@ -98,9 +103,9 @@
 	asm volatile("mrs %0, cntpct_el0" : "=r" (cntpct));
 	end = cntpct + BTL_COUNTER_MAX;
 
-	for (i=0; i<BTL_COUNTER_MAX; i++) {
+	for (i = 0; i < BTL_COUNTER_MAX; i++) {
 		asm volatile("mrs %0, cntpct_el0" : "=r" (cntpct));
-		if ( cntpct >= end)
+		if (cntpct >= end)
 			break;
 	}
 }
@@ -153,7 +158,7 @@
 
 void preboot_main(void)
 {
-	void (*spl_start)(void) = (void*)CONFIG_SPL_TEXT_BASE;
+	void (*spl_start)(void) = (void *)CONFIG_SPL_TEXT_BASE;
 
 	writel(CPU_BOOT_STATUS_IN_PREBOOT, mmPSOC_GLOBAL_CONF_WARM_REBOOT);
 
diff --git a/spi.c b/spi.c
index c0f803a..1315bd2 100644
--- a/spi.c
+++ b/spi.c
@@ -36,7 +36,8 @@
 #define READ_STATUS_BP2			BIT(4)
 #define READ_STATUS_BP3			BIT(5)
 #define READ_STATUS_SRWD		BIT(7)
-#define READ_STATUS_BP0_3		(READ_STATUS_BP0 | READ_STATUS_BP1 | READ_STATUS_BP2 | READ_STATUS_BP3)
+#define READ_STATUS_BP0_3		(READ_STATUS_BP0 | READ_STATUS_BP1 | \
+					READ_STATUS_BP2 | READ_STATUS_BP3)
 #define PROT_MASK			(READ_STATUS_BP0_3 | READ_STATUS_SRWD)
 #define frame_size_bits(b)		((b) << 16)
 
@@ -86,10 +87,12 @@
 {
 	unsigned int tmp;
 
-	while (!spi_fifo_is_empty(mmPSOC_SPI_TXFLR));
+	while (!spi_fifo_is_empty(mmPSOC_SPI_TXFLR))
+		;
 	writel(cmd, mmPSOC_SPI_DR0);
 
-	while (spi_fifo_is_empty(mmPSOC_SPI_RXFLR));
+	while (spi_fifo_is_empty(mmPSOC_SPI_RXFLR))
+		;
 	tmp = readl(mmPSOC_SPI_DR0);
 
 	if (val)
@@ -102,10 +105,12 @@
 
 	spi_dev_update_frame_size(sizeof(tmp));
 
-	while (!spi_fifo_is_empty(mmPSOC_SPI_TXFLR));
+	while (!spi_fifo_is_empty(mmPSOC_SPI_TXFLR))
+		;
 	writeb(cmd, mmPSOC_SPI_DR0);
 
-	while (spi_fifo_is_empty(mmPSOC_SPI_RXFLR));
+	while (spi_fifo_is_empty(mmPSOC_SPI_RXFLR))
+		;
 	tmp = readb(mmPSOC_SPI_DR0);
 
 	if (val)
@@ -124,7 +129,8 @@
 	spi_release_bus();
 }
 
-static void spi_special_cmd_csel(unsigned int cmd, unsigned char *val, size_t size)
+static void spi_special_cmd_csel(unsigned int cmd, unsigned char *val,
+								size_t size)
 {
 	int i;
 
@@ -132,17 +138,21 @@
 
 	spi_dev_update_frame_size(sizeof(*val));
 
-	while (!spi_fifo_is_empty(mmPSOC_SPI_TXFLR));
+	while (!spi_fifo_is_empty(mmPSOC_SPI_TXFLR))
+		;
 	writeb(cmd, mmPSOC_SPI_DR0);
-	for (i=0; i<size; i++) {
-		while (!spi_fifo_is_empty(mmPSOC_SPI_TXFLR));
+	for (i = 0; i < size; i++) {
+		while (!spi_fifo_is_empty(mmPSOC_SPI_TXFLR))
+			;
 		writeb(val[i], mmPSOC_SPI_DR0);
 	}
 
-	while (spi_fifo_is_empty(mmPSOC_SPI_RXFLR));
+	while (spi_fifo_is_empty(mmPSOC_SPI_RXFLR))
+		;
 	readb(mmPSOC_SPI_DR0);
-	for (i=0; i<size; i++) {
-		while (spi_fifo_is_empty(mmPSOC_SPI_RXFLR));
+	for (i = 0; i < size; i++) {
+		while (spi_fifo_is_empty(mmPSOC_SPI_RXFLR))
+			;
 		readb(mmPSOC_SPI_DR0);
 	}
 
@@ -176,14 +186,14 @@
 
 static void spi_read_spl(unsigned int offset)
 {
-	void *dst = (void*)CONFIG_SPL_TEXT_BASE;
+	void *dst = (void *)CONFIG_SPL_TEXT_BASE;
 	unsigned int cmd = (CMD_READ << 24) | offset;
 	int i;
 
 	spi_claim_bus();
 	spi_dev_update_frame_size(sizeof(cmd));
 	spi_dev_dword_cmd(cmd, NULL);
-	for (i=0; i < SPL_SIZE; i += sizeof(unsigned int))
+	for (i = 0; i < SPL_SIZE; i += sizeof(unsigned int))
 		spi_dev_dword_cmd(0, dst + i);
 	spi_dev_dword_cmd(0, NULL);
 	spi_release_bus();
diff --git a/start.S b/start.S
index 44d31f0..f988923 100644
--- a/start.S
+++ b/start.S
@@ -13,6 +13,6 @@
 _start:
 
 	ldr	x0, =(_start + 0x10000)
-	bic	sp, x0, #0xf		/* 16-byte alignment for ABI compliance */
-	mov	x29, sp			/* Set FP (x29) */
-	bl	preboot_main		/* Set LR (x30) */
+	bic	sp, x0, #0xf	/* 16-byte alignment for ABI compliance */
+	mov	x29, sp		/* Set FP (x29) */
+	bl	preboot_main	/* Set LR (x30) */
diff --git a/uart.c b/uart.c
index 92e8221..7177c76 100644
--- a/uart.c
+++ b/uart.c
@@ -28,18 +28,19 @@
 static inline void preboot_putc_virt_uart(const char c) {}
 #endif
 
-void preboot_puts_raw(const char* str)
+void preboot_puts_raw(const char *str)
 {
 	int i;
 
-	for (i=0; str[i] && (i < 128); i++) {
-		while (readl(mmPSOC_UART_0_STATUS) & UART_SR_TXFULL) ;
+	for (i = 0; str[i] && (i < 128); i++) {
+		while (readl(mmPSOC_UART_0_STATUS) & UART_SR_TXFULL)
+			;
 		writel(str[i], mmPSOC_UART_0_DATA);
 		preboot_putc_virt_uart(str[i]);
 	}
 }
 
-void preboot_puts(const char* str)
+void preboot_puts(const char *str)
 {
 	preboot_puts_raw(str);
 	preboot_puts_raw("\r");
@@ -59,9 +60,9 @@
 
 	/*
 	 * convert: if half byte is a number [0..9] => use '0' as an offset
-	 * 	    if half byte is a letter [0xa..0xf] => use 'a' as a base,
-	 * 	    but since 'a' is not 0, we need to subtract
-	 * 	    its base offset - 0xa.
+	 *	    if half byte is a letter [0xa..0xf] => use 'a' as a base,
+	 *	    but since 'a' is not 0, we need to subtract
+	 *	    its base offset - 0xa.
 	 */
 	return byte + ((byte >= 0xa) ? 'a' - 0xa : '0');
 }
@@ -113,14 +114,14 @@
 	preboot_puts("\n");
 }
 
-static inline void preboot_puts_hex(const char* log, unsigned int val, bool pad)
+static inline void preboot_puts_hex(const char *log, unsigned int val, bool pad)
 {
 	preboot_puts_raw(log);
 	preboot_puts_raw("0x");
 	preboot_puth(val, pad);
 }
 
-static inline void preboot_puts_char(const char* str, unsigned char val)
+static inline void preboot_puts_char(const char *str, unsigned char val)
 {
 	preboot_puts_hex(str, val, false);
 }
diff --git a/uart.h b/uart.h
index c0188e0..0d298f6 100644
--- a/uart.h
+++ b/uart.h
@@ -9,8 +9,8 @@
 #define _HL_UART_H_
 
 
-void preboot_puts_raw(const char* str);
-void preboot_puts(const char* str);
+void preboot_puts_raw(const char *str);
+void preboot_puts(const char *str);
 int preboot_uint2hexstring(char *str, unsigned int num, bool pad);
 void preboot_puth_raw(unsigned int val, bool pad);
 void preboot_puth(unsigned int val, bool pad);
