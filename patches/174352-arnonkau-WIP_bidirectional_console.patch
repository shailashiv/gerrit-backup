 			no_log_f=1
-			rmt_run_args=(stty -F /dev/ttyOAM${1:-0} -echo raw  \;cat /dev/ttyOAM${1:-0})
 			;;
 		--pci|--hl-lspci)
 			hl_lspci_f=1
@@ -1765,6 +1806,7 @@
 	show_env_op
 	login_shell_op
 	rmt_run_op
+	handle_console_op
 	host_depended_ops
 	err=$?
 	run_test_func
