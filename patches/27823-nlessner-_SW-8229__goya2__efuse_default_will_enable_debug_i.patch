From 97b9e0049b9e5c8813aaaf4a70e4fc6076d00bc4 Mon Sep 17 00:00:00 2001
From: Noam Lessner <nlessner@habana.ai>
Date: Thu, 13 Feb 2020 01:59:29 +0200
Subject: [PATCH] [SW-8229] goya2: efuse default will enable debug if

If efuse can't be read allow debug interfaces

Change-Id: I4ed4325cf252f099e496398b6e547b5909916228
Signed-off-by: Noam Lessner <nlessner@habana.ai>
---

diff --git a/app/arcboot_rom.c b/app/arcboot_rom.c
index 9a56685..81b0a83 100644
--- a/app/arcboot_rom.c
+++ b/app/arcboot_rom.c
@@ -126,8 +126,8 @@
 
 static void arcboot_rom_fuse(void)
 {
-	if (fuse_read(EFUSE_SYSCFG_OFFSET, &arcboot_rom_global.config_fuse) ==
-	    -1)
+	if (fuse_read(EFUSE_SYSCFG_OFFSET,
+		      &arcboot_rom_global.config_fuse) == -1)
 		arcboot_rom_global.config_fuse = EFUSE_SYSCFG_DEFAULT;
 	if (arcboot_rom_global.config_fuse & EFUSE_SYSCFG_DISABLE_DEBUG_IF_MASK)
 		security_disable_debug_if();
diff --git a/common/efuse.h b/common/efuse.h
index 8c9595a..f99e959 100644
--- a/common/efuse.h
+++ b/common/efuse.h
@@ -34,7 +34,6 @@
 #define EFUSE_SYSCFG_REVOKATION_LOCATION_SPI	BIT(6)
 
 #define EFUSE_SYSCFG_DEFAULT	(EFUSE_SYSCFG_SPI_CONTROLLER | \
-				 EFUSE_SYSCFG_DISABLE_DEBUG_IF_MASK | \
 				 EFUSE_SYSCFG_ENABLE_VALIDATION_MASK | \
 				 EFUSE_SYSCFG_FW_VERSION_LOCATION_SPI | \
 				 EFUSE_SYSCFG_KEY_LOCATION_SPI | \
