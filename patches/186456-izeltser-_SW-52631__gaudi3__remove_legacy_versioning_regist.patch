From 21dacf31b77cba9c795a2fa5543f2fa53d6d2496 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Tue, 08 Mar 2022 07:28:07 +0200
Subject: [PATCH] [SW-52631] gaudi3: remove legacy versioning registers

The versioning information of the preboot and efuse is passed
to other FW components via the bootinfo data, and to the host driver
via the COMMS protocol.
The registers that were used for the legacy method in gaudi3
are being removed.

Change-Id: I35e4b03fc9f39f7b3248e26e1db44e2ca36ad5a1
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/arch/gaudi3/arc/common.c b/arch/gaudi3/arc/common.c
index 6a6aa63..3eeb7df 100644
--- a/arch/gaudi3/arc/common.c
+++ b/arch/gaudi3/arc/common.c
@@ -255,8 +255,8 @@
 	global_conf.upd_pending_sts_map = mmUPD_PENDING_STS;
 	global_conf.upd_cmd_map = mmUPD_CMD;
 	global_conf.upd_sts_map = mmUPD_STS;
-	global_conf.preboot_ver_off_map = mmPREBOOT_VER_OFFSET;
-	global_conf.mmfuse_ver_off_map = mmFUSE_VER_OFFSET;
+	global_conf.preboot_ver_off_map = 0; /* unused */
+	global_conf.mmfuse_ver_off_map = 0; /* unused */
 }
 
 void device_init_ca53_cfg(void)
