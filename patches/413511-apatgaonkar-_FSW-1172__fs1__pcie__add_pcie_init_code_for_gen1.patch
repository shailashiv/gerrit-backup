+ *
+ * Copyright (C) 2024 HabanaLabs Ltd.
+ */
+
+#ifndef _PCIE_H_
+#define _PCIE_H_
+
+#include <stdint.h>
+#include <dev_pcie.h>
+
+void boot_rom_pcie_link_init(void);
+
+#endif /* _PCIE_H_ */
diff --git a/common/recovery.c b/common/recovery.c
index d12ae4f..cdf877f 100644
--- a/common/recovery.c
+++ b/common/recovery.c
@@ -10,11 +10,17 @@
 #include <fs1_blocks_linux_driver.h>
 #include <global_conf_masks.h>
 #include <global_conf_regs.h>
+#include <pcie.h>
 
 static void execute_rom_recovery(void)
 {
 	boot_rom_status_update(PROGRESS_BOOT_ROM_IN_ROM_RECOVERY);
 
+	/* TODO: Should add fuse cfg to skip pcie init? */
+
+	if (boot_rom_global.die_type == IO_DIE_MASTER)
+		boot_rom_pcie_link_init();
+
 	boot_rom_d2d_link_init();
 
 	boot_rom_status_update(PROGRESS_BOOT_ROM_RECOVERY_END);
