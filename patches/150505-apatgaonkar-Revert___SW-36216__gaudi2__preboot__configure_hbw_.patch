From c439bb7d763d1a2a60242027563af601ef789284 Mon Sep 17 00:00:00 2001
From: Abhishek <apatgaonkar@habana.ai>
Date: Thu, 25 Nov 2021 09:48:19 +0200
Subject: [PATCH] Revert "[SW-36216] gaudi2: preboot: configure hbw rr"

This reverts commit 268dd1c294e1bf41cffe04d5a43ef0fc40b875a5.

Change-Id: Id4161d0a6621619b4dd6ec8a2b37740408f79fd5
---

diff --git a/arch/gaudi2/common/security.c b/arch/gaudi2/common/security.c
index 6dfa14f..6e48247 100644
--- a/arch/gaudi2/common/security.c
+++ b/arch/gaudi2/common/security.c
@@ -601,9 +601,15 @@
 #define SRAM_RSVD_BASE	0x1000008000000000ull
 #define DRAM_RSVD_END	0xFF00000000000000ull
 
-static void hl_secure_hbw(struct hl_rr_eng_select rr_sel)
+static void ppboot_secure_hbw(void)
 {
 	u64 min, max;
+	struct hl_rr_eng_select rr_sel;
+
+	memset(&rr_sel, 0, sizeof(struct hl_rr_eng_select));
+
+	/* Only block pcie RR in ppboot */
+	rr_sel.pcie = true;
 
 	/*
 	 * SPI FLASH END to DBG SPACE BASE
@@ -646,31 +652,6 @@
 	hl_secure_hbw_rr(HL_SEC_HBW_HBM, min, max, rr_sel);
 }
 
-static void ppboot_secure_hbw(void)
-{
-	struct hl_rr_eng_select rr_sel;
-
-	memset(&rr_sel, 0, sizeof(struct hl_rr_eng_select));
-
-	/* Only block pcie RR in ppboot */
-	rr_sel.pcie = true;
-
-	hl_secure_hbw(rr_sel);
-}
-
-static void preboot_secure_hbw(void)
-{
-	struct hl_rr_eng_select rr_sel;
-
-	memset(&rr_sel, 0, sizeof(struct hl_rr_eng_select));
-
-	/* Block noc and psoc RR in preboot */
-	rr_sel.noc = true;
-	rr_sel.psoc = true;
-
-	hl_secure_hbw(rr_sel);
-}
-
 void ppboot_security_init(void)
 {
 	/* Initialize only if security is enabled */
@@ -691,5 +672,4 @@
 
 	hl_dev_prot_bits_init();
 	preboot_secure_lbw();
-	preboot_secure_hbw();
 }
