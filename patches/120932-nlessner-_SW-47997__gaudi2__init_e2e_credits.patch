 /* extracts "n" number of bits from position "p" in the given number "v" */
 #define EXTRACT_BITS(v, p, n) (((v) & (((1 << (n)) - 1) << (p))) >> (p))
-
+#define GENMASK_ULL(h, l)                    \
+	(((~ULL(0)) - (ULL(1) << (l)) + 1) & \
+	 (~ULL(0) >> (BITS_PER_LONG_LONG - 1 - (h))))
 
 #ifndef __ASSEMBLY__
 
 /**
+ * import test_bit from linux kernel bitops.h
+ * for arc from linux/arch/arc/include/asm/bitops.h
+ * for arm from linux/include/asm-generic/bitops/non-atomic.h
+ *
+ * these function allow to test bit from base long register address.
+ * e.g: bit 250 can be tested relative to a long register address space.
+ */
+
+#ifdef __arc__
+/**
+ * test_bit - Determine whether a bit is set
+ * @nr: bit number to test
+ * @addr: Address to start counting from
+ */
+static inline int test_bit(unsigned int nr, const unsigned long *addr)
+{
+	unsigned long mask;
+
+	addr += nr >> 5;
+
+	mask = 1UL << (nr & 0x1f);
+
+	return ((mask & *addr) != 0);
+}
+#endif
+
+#ifdef __aarch64__
+/**
+ * test_bit - Determine whether a bit is set
+ * @nr: bit number to test
+ * @addr: Address to start counting from
+ */
+static inline int test_bit(int nr, const unsigned long *addr)
+{
+	unsigned long mask;
+
+	addr += BIT_WORD(nr);
+
+	mask = BITS_PER_LONG - 1;
+
+	return 1UL & (*addr >> (nr & mask));
+}
+#endif
