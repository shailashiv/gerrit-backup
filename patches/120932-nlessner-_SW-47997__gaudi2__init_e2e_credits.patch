+		 mmDCORE0_RTR0_MSTR_IF_RR_SHRD_HBW_BASE)
+
+#define MSTR_IF_E2E_CRDT_E2E_PCI_WR_SIZE_OFFSET \
+		(mmDCORE0_RTR0_MSTR_IF_E2E_CRDT_E2E_PCI_WR_SIZE - \
+		 mmDCORE0_RTR0_MSTR_IF_RR_SHRD_HBW_BASE)
