From d728121aed2da2e44fe57839d0641cbbb0be3506 Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Wed, 15 Apr 2020 13:58:47 +0300
Subject: [PATCH] [SW-0] hl: add common libc routines header

Add declarations header for the common string.c routines.

Change-Id: Ic762b33e45643cec8226130fc683703647232004
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/common/string.c b/common/string.c
index e69575e..c213d17 100644
--- a/common/string.c
+++ b/common/string.c
@@ -6,8 +6,7 @@
  */
 
 #include <stddef.h>
-
-typedef unsigned long		ulong;
+#include <string.h>
 
 /**
  * memchr - Find a character in an area of memory.
diff --git a/include/string.h b/include/string.h
new file mode 100644
index 0000000..aa0f67f
--- /dev/null
+++ b/include/string.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright 2016-2020 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#ifndef _PREBOOT_STRING_H_
+#define _PREBOOT_STRING_H_
+
+#include <stddef.h>
+
+typedef unsigned long		ulong;
+
+void *memchr(const void *s, int c, size_t n);
+void *memcpy(void *dest, const void *src, size_t count);
+void *memmove(void * dest,const void *src,size_t count);
+void *memset(void * s,int c,size_t count);
+
+int memcmp(const void * cs,const void * ct, size_t count);
+int strcmp(const char * cs,const char * ct);
+
+size_t strlen(const char * s);
+size_t strnlen(const char * s, size_t count);
+
+char * strrchr(const char * s, int c);
+
+#endif /* _PREBOOT_STRING_H_ */
