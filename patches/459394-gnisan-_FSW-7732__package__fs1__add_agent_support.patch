From e9d08664ae9f2964991e1d77aff5138cb18d450e Mon Sep 17 00:00:00 2001
From: Guy Nisan <gnisan@habana.ai>
Date: Tue, 29 Oct 2024 15:57:43 +0200
Subject: [PATCH] [FSW-7732] package: fs1: add agent support

Ad FS1 agent support. Unlike Gaudi's agent, FS1 agent does not run on
SRAM hence the changes that were introduce to extract iccm/dccm and apply
them properly in itb file.

Change-Id: Ia218e47e8d6181ec4d8d3c26e62be23213b7d568
Signed-off-by: Guy Nisan <gnisan@habana.ai>
---

diff --git a/board/habanalabs/fs1/agent-fw_loader.its b/board/habanalabs/fs1/agent-fw_loader.its
index 9813adf..547c30a 100644
--- a/board/habanalabs/fs1/agent-fw_loader.its
+++ b/board/habanalabs/fs1/agent-fw_loader.its
@@ -59,6 +59,33 @@
 				algo = "sha384";
 			};
 		};
+
+		agent-iccm {
+			description = "Zephyr agent ICCM";
+			data = /incbin/("@BINS_DIR_PATH@@DEV_PREFIX@-zephyr-agent_fw_loader-iccm.bin.le");
+			type = "standalone";
+			arch = "arc";
+			core-id = <@FIT_CORE_ID_IO0_MGMT@>;
+			compression = "none";
+			loadaddr = @HL_ICCM_LOAD_ADDR@;
+			startaddr = @HL_START_ADDR@;
+			hash {
+				algo = "@SHA_VERSION@";
+			};
+		};
+
+		agent-dccm {
+			description = "Zephyr agent DCCM";
+			data = /incbin/("@BINS_DIR_PATH@@DEV_PREFIX@-zephyr-agent_fw_loader-dccm.bin.le");
+			type = "standalone";
+			arch = "arc";
+			core-id = <@FIT_CORE_ID_IO0_MGMT@>;
+			compression = "none";
+			loadaddr = @HL_DCCM_LOAD_ADDR@;
+			hash {
+				algo = "@SHA_VERSION@";
+			};
+		};
 	};
 
 	configurations {
@@ -69,6 +96,12 @@
 			loadables = "@FW_LOADER_CONF_LOADABLES@";
 			load-type = <@FIT_LOAD_TYPE_FLASH@>;
 		};
+
+		preboot-conf {
+			description = "Habanalabs device agent";
+			loadables = "agent-iccm", "agent-dccm";
+			load-type = <0>; /* FIT_LOAD_TYPE_RUN */
+		};
 	};
 };
 
