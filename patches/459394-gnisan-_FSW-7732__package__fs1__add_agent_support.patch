--- a/board/habanalabs/fs1_arc/fs1-image-utility.sh
+++ b/board/habanalabs/fs1_arc/fs1-image-utility.sh
@@ -95,8 +95,8 @@
 }
 
 function hl_extract_zephyr_bins_sections {
-	local bins_file=$1
-	local app=$(basename ${bins_file} | cut -d. -f1 | cut -d_ -f2)
+	local app=$1
+	local bins_file=$2
 	local sections=()
 	local bin_start
 	local bin_end
@@ -130,10 +130,42 @@
 	done < <(tail -n +2 ${bins_file} | hl_remove_empty_lines)
 }
 
-#This function should be called after hl_create_zephyr_bins_config
+# Find a bins file which fits the app
+function hl_zephyr_get_bins {
+	local app=$1
+	local bins_file
+	local bins_app
+
+	# Try to find to closest match between an elf and its bins file
+	while [ $(echo ${app} | tr "_" " " | wc -w) -gt 0 ]; do
+		for bins_file in $(ls $BINS_CONFIG_DIR/${HL_TARGET}_*.bins); do
+			bins_app=$(echo ${bins_file} | sed "s/.*\/${HL_TARGET}_\(.*\)\.bins/\1/")
+
+			if [ "${bins_app}" == "${app}" ]; then
+				echo -n ${bins_file}
+				return
+			fi
+		done
+
+		# Remove last word
+		app=$(echo ${app} | awk -F_ 'BEGIN {OFS="_"} {NF-=1} 1')
+	done
+}
+
+# This function should be called after hl_create_zephyr_bins_config
 function hl_extract_zephyr_elf_sections {
-	for sec_file in $(ls $BINS_CONFIG_DIR/${HL_TARGET}_*.bins); do
-		hl_extract_zephyr_bins_sections ${sec_file}
+	local elf_file
+	local bins_file
+	local app
+
+	for elf_file in $(ls ${ELFS_DIR}/zephyr_*.elf); do
+		app=$(echo ${elf_file} | sed "s/.*\/zephyr_\(.*\)\.elf/\1/")
+		bins_file=$(hl_zephyr_get_bins ${app})
+
+		if [ -n "${bins_file}" ]; then
+			hl_extract_zephyr_bins_sections ${app} ${bins_file}
+			continue
+		fi
 	done
 }
 
@@ -150,7 +182,7 @@
