 		HL_AGENT_ADDITIONAL_LOADABLES=', "external_fw"'
 
 		# Compress binary
@@ -133,31 +115,25 @@
 		AGENT_ITS_FILE=agent-${AGENT_NAME}-${HL_DEV}_${HL_TARGET}.its
 		AGENT_ITB_FILE=agent-${AGENT_NAME}-fit.itb
 		# Extract the load address and start address from stat file
-		LOADRADDR=$(grep LOAD $AGENT_STAT | head -1 | awk '{ print $3 }')
 		STARTADDR=$(grep "Entry point address" $AGENT_STAT | head -1 | awk -F: '{ print $2 }')
-		LOADRADDR=$((LOADRADDR | AGENT_BASE_ADDR))
-		STARTADDR=$((STARTADDR | AGENT_BASE_ADDR))
 
-		# Write the load address within the DTS template
-		ITS_SED_BIN_PARAMS="s/@HL_LOAD_ADDR@/$(print_fdt64 $LOADRADDR)/g;"
-		ITS_SED_BIN_PARAMS+="s/@HL_START_ADDR@/$(print_fdt64 $STARTADDR)/g;"
-		ITS_SED_BIN_PARAMS+="s/@HL_AGENT_BIN@/${AGENT_BIN}/g;"
-		#ITS_SED_BIN_PARAMS+="s/@HL_AGENT_VERSION@/${HL_AGENT_VERSION}/g;"
+		# Replace ARC core IDs
+		ITS_SED_BIN_PARAMS+="s/@FIT_CORE_ID_IO0_MGMT@/${FIT_CORE_ID_IO0_MGMT}/g;"
 
-		if [ ! -f ${AGENT_FW_NAME} ]; then
-			echo "No agent FW file"
-			dd bs=4 count=1 if=/dev/zero of=empty.bin
-			AGENT_FW_NAME=empty.bin
-			HL_AGENT_ADDITIONAL_LOADABLES=""
-		fi
-		ITS_SED_BIN_PARAMS+="s#@HL_AGENT_FW_BIN@#${AGENT_FW_NAME}#g;"
+		ARC_AGENT_ICCM=$(( (${ARC_AGENT_ICCM_HI} << 32) | ${ARC_AGENT_ICCM_LO} ))
+		ITS_SED_BIN_PARAMS+="s/@HL_ICCM_LOAD_ADDR@/$(print_fdt64 ${ARC_AGENT_ICCM})/g;"
+
+		ARC_AGENT_DCCM=$(( (${ARC_AGENT_DCCM_HI} << 32) | ${ARC_AGENT_DCCM_LO} ))
+		ITS_SED_BIN_PARAMS+="s/@HL_DCCM_LOAD_ADDR@/$(print_fdt64 ${ARC_AGENT_DCCM})/g;"
+
+		ITS_SED_BIN_PARAMS+="s/@HL_START_ADDR@/$(print_fdt64 $(( ${STARTADDR} + ${ARC_AGENT_ICCM} )))/g;"
 		ITS_SED_BIN_PARAMS+="s#@HL_AGENT_ADDITIONAL_LOADABLES@#${HL_AGENT_ADDITIONAL_LOADABLES}#g;"
 
 		AGENTS_ITS_SPEC_TEMPLATE=${BR2_EXTERNAL}/board/habanalabs/${HL_DEV}/agent-${AGENT_NAME}.its
 		AGENTS_ITS_SPEC_FILE=agent-${AGENT_NAME}-${HL_DEV}.its
 		if [ -f ${AGENTS_ITS_SPEC_TEMPLATE} ]; then
 			sed ${ITS_SED_PARAMS}${ITS_SED_BIN_PARAMS} ${AGENTS_ITS_SPEC_TEMPLATE} > ${STAGE_DIR}/${AGENTS_ITS_SPEC_FILE}
-			#ITS_SED_BIN_PARAMS+="s#@DEV_SPEC_ITS@#${STAGE_DIR}/${AGENTS_ITS_SPEC_FILE}#g;"
+			ITS_SED_BIN_PARAMS+="s#@DEV_SPEC_ITS@#${STAGE_DIR}/${AGENTS_ITS_SPEC_FILE}#g;"
 		fi
 
 		sed ${ITS_SED_PARAMS}${ITS_SED_BIN_PARAMS} ${AGENT_ITS_TEMPLATE} > ${STAGE_DIR}/${AGENT_ITS_FILE}
diff --git a/board/habanalabs/fs1_arc/fs1-image-utility.sh b/board/habanalabs/fs1_arc/fs1-image-utility.sh
