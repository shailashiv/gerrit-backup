 if [ -f ${BASE_DIR}/build/baremetal-custom/buildversion-habanalabs ]; then
@@ -79,39 +78,22 @@
 	rm -f ${STAGE_DIR}/${AGENT_ITB_FILE}
 }
 
-function create_dummy_agent_fw_loader_bin_file {
-	ZEPHYR_AGENT_FW_LOADER_BIN_FILE=${BR2_EXTERNAL}/output/${DEV_PREFIX}_arc/images/zephyr_agent_fw_loader.bin
-	touch ${ZEPHYR_AGENT_FW_LOADER_BIN_FILE}
-	echo "This is a dummy zephyr_agent_fw_loader.bin file" > ${ZEPHYR_AGENT_FW_LOADER_BIN_FILE}
-}
-
-function create_dummy_agent_fw_loader_stat_file {
-	cp ${BR2_EXTERNAL}/output/${DEV_PREFIX}_arc/images/zephyr_preboot.stat ${BR2_EXTERNAL}/output/${DEV_PREFIX}_arc/images/zephyr_agent_fw_loader.stat
-}
-
 pushd ${STAGE_DIR}
 
-	# The FWL agent image isn't ready yet, so:
-	# 1. Create a dummy zephyr_agent_fw_loader.bin file.
-	# 2. Use zephyr_preboot.stat as zephyr_agent_fw_loader.stat.
-	create_dummy_agent_fw_loader_bin_file
-	create_dummy_agent_fw_loader_stat_file
-
-	AGENT_BIN_FILES=$(ls zephyr_agent_*.bin 2>/dev/null)
+	AGENT_BIN_ICCM_FILES=$(ls zephyr-agent_*-iccm.bin 2>/dev/null)
 
 	handle_fw_copy
 
 	handle_preboot_loadaddr
 
 	# For each zephyr_agent_*.bin files
-	for AGENT_BIN in $AGENT_BIN_FILES; do
+	for AGENT_BIN_ICCM in $AGENT_BIN_ICCM_FILES; do
 		# Extract the agent name (remove prefix and suffix)
-		AGENT_NAME=$(echo $AGENT_BIN | sed 's/^zephyr_agent_\(.*\).bin/\1/')
+		AGENT_NAME=$(echo $AGENT_BIN_ICCM | sed 's/^zephyr-agent_\(.*\)-iccm.bin/\1/')
+
 		echo "Creating the ${AGENT_NAME} agent."
 		# Agent stat file, contains the ELF information, omited by Zephyr when the binary got created
-		AGENT_STAT=$(echo $AGENT_BIN | sed 's/\.bin/.stat/')
-		# Agent possible FW file
-		AGENT_FW_NAME=$(echo $AGENT_BIN | sed 's/\_agent_/_agentfw_/')
