+#define PCIE_OUTBOUND_RETRY_COUNT	10
+#define PCIE_OUTBOUND_DELAY_US		10
+
+#define PCIE_WRAP_RESET_MASK_REQ_VAL			(PCIE_WRAP_MASK_REQ_FROM_HBW_M | \
+							PCIE_WRAP_MASK_REQ_DBG_M | \
+							PCIE_WRAP_MASK_REQ_TRACE_M | \
+							PCIE_WRAP_MASK_REQ_ECT_M)
+
+#define PCIE_AUX_RESET_HOST_TERM_VAL		(PCIE_AUX_HOST_TERM_CTRL_MSTR_WR_TERM_M | \
+						PCIE_AUX_HOST_TERM_CTRL_MSTR_RD_TERM_M | \
+						PCIE_AUX_HOST_TERM_CTRL_ELBI_WR_TERM_M | \
+						PCIE_AUX_HOST_TERM_CTRL_ELBI_RD_TERM_M)
+
+void hl_pcie_disable_access(void)
+{
+	uint8_t retry = PCIE_OUTBOUND_RETRY_COUNT;
+
+	/* Terminate all downstream access */
+	regmap_writel(PCIE_AUX_RESET_HOST_TERM_VAL,
+					D0_PCIE_AUX_REG(mmPCIE_AUX_HOST_TERM_CTRL));
+
+	/* Isolate all PCIe outbound memory access */
+	regmap_writel(PCIE_WRAP_RESET_MASK_REQ_VAL,
+					D0_PCIE_WRAP_REG(mmPCIE_WRAP_MASK_REQ));
+
+	while (regmap_readl(D0_PCIE_WRAP_REG(mmPCIE_WRAP_OUTBOUND_OUTSTANDING))) {
+		udelay(PCIE_OUTBOUND_DELAY_US);
+		retry--;
+
+		if (!retry) {
+			preboot_puts("Outstanding transactions are non-zero, ");
+			preboot_puts("proceeding with reset\n");
+			return;
+		}
+	}
+
+	preboot_puts("Outstanding transaction are zero, proceeding with reset\n");
+}
