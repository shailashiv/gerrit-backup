+
+#include <baremetal.h>
+#include <gaudi3_blocks_linux_driver.h>
+#include <gaudi3_reg_map.h>
+#include <gaudi3_fw_if.h>
+#include <pif_arc_special_regs.h>
+#include <hl_pif_arc_if.h>
+#include <hl_pci_if.h>
+#include <hl_boot_if.h>
+#include <address_space.h>
+#include <boot_if.h>
+#include <bitops.h>
+#include <device.h>
+#include <uart.h>
+#include <pci.h>
+#include <hl.h>
+
+static u32 pif_prev_err;
+
+/* TODO: Move this functions to emb common modules */
+bool is_pcie_initialized(void)
+{
+	u32 regval;
+
+	regval = regmap_readl(mmD0_PIF_ARC_STATUS);
+	if (regval & PIF_STAT_PCIE_INIT_DONE)
+		return true;
+
+	return false;
+}
+
+u32 dev_pci_dbi_cfg_offset_get(void)
+{
+	return mmD0_PCIE_DBI_SIG_BASE;
+}
+
+/* TODO: Move this functions to emb common modules */
+static void pif_arc_ctrl_reset(bool enable)
+{
+	u32 val = regmap_readl(mmD0_PIF_ARC_CONTROL);
+
+	if (enable)
+		val |= PIF_CTRL_FLR_RST_EN;
+	else
+		val &= ~PIF_CTRL_FLR_RST_EN;
+
+	regmap_writel(val, mmD0_PIF_ARC_CONTROL);
+}
+
+/* TODO: Move this functions to emb common modules */
+void pci_dev_specific_setup(void)
+{
+	/* In Preboot no need to perform FLR - disable FLR reset */
+	pif_arc_ctrl_reset(false);
+
+	cpu_boot_dev_sts_set(CPU_BOOT_DEV_STS_FW_IATU_CONF_EN);
+}
+
+/* TODO: Move this functions to emb common modules */
+bool pci_dev_specific_pif_err_pending(void)
+{
+	u32 regval = regmap_readl(mmD0_PIF_ARC_ERROR);
+
+	return !(regval == pif_prev_err);
+}
+
+/* TODO: Move this functions to emb common modules */
+void hl_pif_report_err(u32 err_bit)
+{
+	char *msg;
+	enum pif_runtime_error err = err_bit;
+
+	switch (err) {
+	case ERR_PCI_OUTBOUND_TIMEOUT:
+		msg = "outbound transactions timeout";
+		break;
+	case ERR_FLR_HW_RESET_TIMEOUT:
+		msg = "FLR HW reset timeout";
+		break;
+	case ERR_SEC_DIE_READY_TIMEOUT:
+		msg = "slave die ready timeout";
+		break;
+	case ERR_TS_COUNTER_OVERFLOW:
+		msg = "ts counter overflow";
+		break;
+	case ERR_CPU_EXCEPTION_HALT:
+		msg = "ARC halt on exeption";
+		break;
+	case ERR_PHY_FW_LOAD_TIMEOUT:
+		msg = "PHY FW update timeout";
+		break;
+	case ERR_PCI_LINK_UP_TIMEOUT:
+		preboot_puts_raw("waiting for pci link for more than 500ms");
+		return;
+	default:
+		preboot_puts_hex_raw("Unknown PIF err reported ", err, false);
+		return;
+	}
+
+	preboot_puts_raw("PIF err reported: ");
+	preboot_puts(msg);
+	preboot_puts("\n");
+}
+
+void pci_dev_specific_pif_err_process(void)
+{
+	unsigned int err_idx = 0;
+	u32 regval, pending;
+
+	regval = regmap_readl(mmD0_PIF_ARC_ERROR);
+	pending = regval ^ pif_prev_err;
+	pending &= regval;
+
+	while (pending) {
+		if (pending & BIT(0))
+			hl_pif_report_err(err_idx);
+
+		pending >>= 1;
+		err_idx++;
+	}
+
+	pif_prev_err = regval;
+}
+
+struct hl_pci_inbound_region gaudi3_pci_inbound_regions[] = PCI_IATU_INBOUND_REGIONS_DATA;
+
+/* TODO: Move this functions to emb common modules */
+void hl_pci_iatu_init(void)
+{
+	int i;
+	struct hl_pci_outbound_region outbound_region;
+
+	for (i = 0; i < ARRAY_SIZE(gaudi3_pci_inbound_regions); ++i)
+		hl_pci_set_inbound_region(i, &gaudi3_pci_inbound_regions[i]);
+
+	/* Outbound Region 0 - Point to Host */
+	outbound_region.addr = HOST_PHYS_BASE_0;
+	outbound_region.size = HOST_PHYS_SIZE_0;
+	hl_pci_set_outbound_region(&outbound_region);
+}
+
+struct hl_bmu_region gaudi3_pci_bmu_regions[] = PCI_BMU_REGIONS_DATA;
+
+/* TODO: Move this functions to emb common modules */
+void hl_pci_bmu_init(void)
+{
+	int err, i;
+
+	hl_pci_bmu_set_cfg_base(CFG_PHYS_BASE);
+
+	for (i = 0; i < ARRAY_SIZE(gaudi3_pci_bmu_regions); ++i) {
+		err = hl_pci_set_bmu_region(&gaudi3_pci_bmu_regions[i]);
+		if (err)
+			preboot_puts_hex_raw("error initializing bmu region ", i, false);
+	}
+
+	hl_pci_bmu_enable(true);
+}
+
+#define BMU_CFG_SRC_START_OFF		0x8
+#define BMU_CFG_SRC_END_OFF		0x48
+#define BMU_CFG_DST_OFFS_R0_OFF		0x88
+#define BMU_CFG_DST_OFFS_R1_OFF		0xC8
+#define BMU_CFG_AWUSER_R0_OFF		0x108
+#define BMU_CFG_AWUSER_R1_OFF		0x148
+#define BMU_CFG_ARUSER_R0_OFF		0x1C8
+#define BMU_CFG_ARUSER_R1_OFF		0x208
+#define BMU_CFG_AXI_AW_PROT_OFF		0x288
+#define BMU_CFG_AXI_AW_CACHE_OFF	0x2A8
+#define BMU_CFG_AXI_AR_PROT_OFF		0x2C8
+#define BMU_CFG_AXI_AR_CACHE_OFF	0x2E8
+#define BMU_CFG_ADDR_SHIFT		2
+#define BMU_CFG_OFF_MASK		0xFFFFFFFFFCull /* GENMASK(39, 2) */
+
+static void hl_pci_set_bmu_cfg_region(struct hl_bmu_region *region)
+{
+	u32 base_addr = pci.bmu_base_addr + (region->id * SZ_4);
+	u32 start_addr = (u32)(region->src_start >> BMU_CFG_ADDR_SHIFT);
+	u32 end_addr = (u32)(region->src_end >> BMU_CFG_ADDR_SHIFT);
+	u64 dst_addr = region->dst_base - region->src_start;
+	u64 dst_off = (dst_addr & BMU_CFG_OFF_MASK) >> BMU_CFG_ADDR_SHIFT;
+
+	regmap_writel(start_addr, base_addr + BMU_CFG_SRC_START_OFF);
+	regmap_writel(end_addr, base_addr + BMU_CFG_SRC_END_OFF);
+	regmap_writel((u32)(dst_off), base_addr + BMU_CFG_DST_OFFS_R0_OFF);
+	regmap_writel((u32)(dst_off >> 32), base_addr + BMU_CFG_DST_OFFS_R1_OFF);
+
+	regmap_writel((u32)(region->perms.w_user), base_addr + BMU_CFG_AWUSER_R0_OFF);
+	regmap_writel((u32)(region->perms.w_user >> 32), base_addr + BMU_CFG_AWUSER_R1_OFF);
+	regmap_writel((u32)(region->perms.r_user), base_addr + BMU_CFG_ARUSER_R0_OFF);
+	regmap_writel((u32)(region->perms.r_user >> 32), base_addr + BMU_CFG_ARUSER_R1_OFF);
+	regmap_writel(region->perms.w_prot, base_addr + BMU_CFG_AXI_AW_PROT_OFF);
+	regmap_writel(region->perms.r_prot, base_addr + BMU_CFG_AXI_AR_PROT_OFF);
+	regmap_writel(region->perms.w_cache, base_addr + BMU_CFG_AXI_AW_CACHE_OFF);
+	regmap_writel(region->perms.r_cache, base_addr + BMU_CFG_AXI_AR_CACHE_OFF);
+}
+
+#define BMU_MEM_SRC_START_OFF		0x500
+#define BMU_MEM_SRC_END_OFF		0x520
+#define BMU_MEM_DST_OFFS_OFF		0x540
+#define BMU_MEM_AWUSER_R0_OFF		0x560
+#define BMU_MEM_AWUSER_R1_OFF		0x580
+#define BMU_MEM_ARUSER_R0_OFF		0x5C0
+#define BMU_MEM_ARUSER_R1_OFF		0x5E0
+#define BMU_MEM_AXI_AW_PROT_OFF		0x620
+#define BMU_MEM_AXI_AW_CACHE_OFF	0x630
+#define BMU_MEM_AXI_AR_PROT_OFF		0x640
+#define BMU_MEM_AXI_AR_CACHE_OFF	0x650
+#define BMU_MEM_DST_BASE_OFF		0x660
+#define BMU_MEM_ADDR_SHIFT		20
+#define BMU_MEM_DEST_BASE_SHIFT		48
+#define BMU_MEM_SRC_MASK		0x3FFFF00000ull	  /* GENMASK(37, 20) */
+#define BMU_MEM_DEST_MASK		0xFFFFFFF00000ull /* GENMASK(47, 20) */
+
+static void hl_pci_set_bmu_mem_region(struct hl_bmu_region *region)
+{
+	u32 base_addr = pci.bmu_base_addr + (region->id * SZ_4);
+	u32 start_addr = (u32)((region->src_start & BMU_MEM_SRC_MASK) >> BMU_MEM_ADDR_SHIFT);
+	u32 end_addr = (u32)((region->src_end & BMU_MEM_SRC_MASK) >> BMU_MEM_ADDR_SHIFT);
+	u32 mem_base = (u32)(region->dst_base >> BMU_MEM_DEST_BASE_SHIFT);
+	u64 dst_addr = region->dst_base - region->src_start;
+	u32 dst_off = (u32)((dst_addr & BMU_MEM_DEST_MASK) >> BMU_MEM_ADDR_SHIFT);
+
+	regmap_writel(start_addr, base_addr + BMU_MEM_SRC_START_OFF);
+	regmap_writel(end_addr, base_addr + BMU_MEM_SRC_END_OFF);
+	regmap_writel(mem_base, base_addr + BMU_MEM_DST_BASE_OFF);
+	regmap_writel(dst_off, base_addr + BMU_MEM_DST_OFFS_OFF);
+
+	regmap_writel((u32)(region->perms.w_user), base_addr + BMU_MEM_AWUSER_R0_OFF);
+	regmap_writel((u32)(region->perms.w_user >> 32), base_addr + BMU_MEM_AWUSER_R1_OFF);
+	regmap_writel((u32)(region->perms.r_user), base_addr + BMU_MEM_ARUSER_R0_OFF);
+	regmap_writel((u32)(region->perms.r_user >> 32), base_addr + BMU_MEM_ARUSER_R1_OFF);
+	regmap_writel(region->perms.w_prot, base_addr + BMU_MEM_AXI_AW_PROT_OFF);
+	regmap_writel(region->perms.r_prot, base_addr + BMU_MEM_AXI_AR_PROT_OFF);
+	regmap_writel(region->perms.w_cache, base_addr + BMU_MEM_AXI_AW_CACHE_OFF);
+	regmap_writel(region->perms.r_cache, base_addr + BMU_MEM_AXI_AR_CACHE_OFF);
+}
+
+#define BMU_REGION_EN_OFF	0x4
+#define BMU_NUM_CFG_REGIONS	8
+
+static void hl_pci_bmu_enable_region(enum hl_bmu_region_id id, enum hl_bmu_region_type type)
+{
+	u32 reg = regmap_readl(pci.bmu_base_addr + BMU_REGION_EN_OFF);
+	u32 reg_mask = BIT(id);
+
+	reg_mask = (type == BMU_REGION_TYPE_MEM) ? (reg_mask << BMU_NUM_CFG_REGIONS) : reg_mask;
+	reg |= reg_mask;
+	regmap_writel(reg, pci.bmu_base_addr + BMU_REGION_EN_OFF);
+}
+
+int hl_pci_set_bmu_region(struct hl_bmu_region *region)
+{
+	if (region->type == BMU_REGION_TYPE_MEM) {
+		if (region->id > BMU_MEM_REGION_MAX)
+			return -1;
+
+		hl_pci_set_bmu_mem_region(region);
+	} else {
+		if (region->id > BMU_CFG_REGION_MAX)
+			return -1;
+
+		hl_pci_set_bmu_cfg_region(region);
+	}
+
+	hl_pci_bmu_enable_region(region->id, region->type);
+
+	return 0;
+}
+
+#define BMU_CFG_BASE_SHIFT	40
+#define BMU_CFG_DST_BASE_OFFSET	0x308
+
+void hl_pci_bmu_set_cfg_base(u64 cfg_base_addr)
+{
+	u32 cfg_dst = (u32)(cfg_base_addr >> BMU_CFG_BASE_SHIFT);
+
+	regmap_writel(cfg_dst, pci.bmu_base_addr + BMU_CFG_DST_BASE_OFFSET);
+}
+
+void hl_pci_bmu_enable(bool enable)
+{
+	u32 val = enable ? 1 : 0;
+
+	regmap_writel(val, pci.bmu_base_addr);
+}
