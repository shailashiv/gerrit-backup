From 2fd1c44af6c70dfa3182325e083ab1e92e6b154b Mon Sep 17 00:00:00 2001
From: Sanyog Kale <skale@habana.ai>
Date: Tue, 07 Jun 2022 13:28:18 +0300
Subject: [PATCH] [SW-89972] gaudi3: verify erom/recovery image descriptor

EROM/Recovery image descriptors are stored at 0x0 offset. In previous
platform only hash verification was perform on erom images and executed
by ROM. Signature verification on EROM images was not perfomed as we
couldnt meet deadline of 100ms to establish PCIe link if we would
perform signature verification of three images (ppboot primary,
ppboot secondary and PCIe EROM).

As per OCP spec, any image from SPI should not be executed unverified.
Due to this requirement, this patch adds support to verify signature on
EROM image descriptor. Due to new design in gaudi3 where signature
verification is performed on image descriptor instead of individual
ppboot image and only hash verfication is performed on ppboot image,
we will be well within 100ms deadline with signature verification
enabled for EROM image descriptor.

Change-Id: Icfea5a2ab14eca64a62625e1d82699ed981c6a82
---

diff --git a/app/arcboot_rom.c b/app/arcboot_rom.c
index 47c62d3..769f60b 100644
--- a/app/arcboot_rom.c
+++ b/app/arcboot_rom.c
@@ -463,7 +463,10 @@
 __weak void arcboot_rom_disable_spi_gw(void) {}
 __weak void arcboot_rom_wait_for_signal(void) {}
 __weak void arcboot_rom_security_init(void) {}
-__weak void arcboot_rom_verify(void) {}
+__weak int arcboot_rom_verify(__unused enum hl_fw_boot_ptr_imgs img)
+{
+	return 0;
+}
 
 int arcboot_rom_main(void)
 {
@@ -474,7 +477,9 @@
 	arcboot_rom_wait_for_signal();
 	arcboot_rom_in_recovery();
 	arcboot_rom_request_cpld_wdog();
-	arcboot_rom_verify();
+	if (arcboot_rom_verify(HL_FW_BOOT_PTR_SPI))
+		execute_recovery();
+
 	arcboot_rom_bringup_pcie();
 	arcboot_rom_bringup_arcboot_ram();
 
diff --git a/arch/gaudi3/arc/common.c b/arch/gaudi3/arc/common.c
index b6bfcdb..4a7df1d 100644
--- a/arch/gaudi3/arc/common.c
+++ b/arch/gaudi3/arc/common.c
@@ -789,8 +789,9 @@
 	return HL_BOOT_INFO_VERSION;
 }
 
-void arcboot_rom_verify(void)
+int arcboot_rom_verify(enum hl_fw_boot_ptr_imgs img)
 {
+	enum arcboot_rom_progress verify_sts_base = PROGRESS_SPI_BOOT_DESC_VERIFY_START;
 	struct hl_fw_boot_ptrs boot_ptr;
 	uint32_t boot_ptr_addr = 0;
 	int ret;
@@ -798,12 +799,17 @@
 	uint8_t crc_bytes, num_chunks;
 
 	if ((arcboot_rom_global.validation_pass) || (!security_efuse_image_validation_en()))
-		return;
+		return 0;
 
-	boot_ptr_addr = boot_desc_param_get(&boot_ptr);
+	if (img == HL_FW_BOOT_PTR_EROM)
+		verify_sts_base = PROGRESS_EROM_BOOT_DESC_VERIFY_START;
+
+	boot_ptr_addr = boot_desc_param_get(img, &boot_ptr);
 
 	if (!boot_ptr_addr)
-		execute_recovery();
+		return 1;
+
+	arcboot_rom_status_update_bringup(verify_sts_base, PROGRESS_VERIFY_START);
 
 	num_chunks = boot_ptr.boot_ptrs_img_sz / MAX_DMA_SIZE_CRC;
 	if (boot_ptr.boot_ptrs_img_sz % MAX_DMA_SIZE_CRC)
@@ -819,19 +825,25 @@
 			boot_ptr.sec_ver, boot_ptr.key_idx);
 
 	if (ret == SECUREBOOT_VERIFY_SUCCESS) {
-		arcboot_rom_status_update(PROGRESS_BOOT_DESC_VERIFY_SUCCESS);
+		arcboot_rom_status_update_bringup(verify_sts_base, PROGRESS_VERIFY_SUCCESS);
 	} else {
 		if (ret == SECUREBOOT_VERIFY_VER_FAILED)
-			arcboot_rom_status_update(PROGRESS_BOOT_DESC_VERIFY_VERSION_FAIL);
+			arcboot_rom_status_update_bringup(verify_sts_base,
+					PROGRESS_VERIFY_VERSION_FAIL);
 		else if (ret == SECUREBOOT_VERIFY_KEY_REVOKED)
-			arcboot_rom_status_update(PROGRESS_BOOT_DESC_VERIFY_KEY_REVOKED);
+			arcboot_rom_status_update_bringup(verify_sts_base,
+					PROGRESS_VERIFY_KEY_REVOKED);
 		else if (ret == SECUREBOOT_VERIFY_KEY_FAILED)
-			arcboot_rom_status_update(PROGRESS_BOOT_DESC_VERIFY_KEY_HASH_FAIL);
+			arcboot_rom_status_update_bringup(verify_sts_base,
+					PROGRESS_VERIFY_KEY_HASH_FAIL);
 		else // (ret = SECUREBOOT_VERIFY_FAILED)
-			arcboot_rom_status_update(PROGRESS_BOOT_DESC_VERIFY_AUTH_FAIL);
+			arcboot_rom_status_update_bringup(verify_sts_base,
+					PROGRESS_VERIFY_AUTH_FAIL);
 
-		execute_recovery();
+		return 1;
 	}
+
+	return 0;
 }
 
