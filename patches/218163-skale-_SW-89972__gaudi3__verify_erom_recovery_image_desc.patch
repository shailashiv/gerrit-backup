 }
 
-static void execute_erom_recovery(void)
-{
-	uint32_t count, i;
-
-	/* EROM recovery not supported in slave die */
-	if (arcboot_rom_global.die_id)
-		return;
-
-	arcboot_rom_status_update(PROGRESS_ARCBOOT_IN_EROM_RECOVERY);
-
-	count = boot_desc_init(HL_FW_BOOT_PTR_EROM);
-	if (!count) {
-		arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_BOOT_DESC_ERROR);
-		return;
-	}
-
-	for (i = 0; i < count; i++)
-		ext_rom_load_erom_image(i);
-}
-
 static void rom_pcie_recovery(void)
 {
 	uint32_t pcie_ctrl_val = arcboot_rom_global.config_fuse & EFUSE_SYSCFG_PCIE_CONTROL_MASK;
@@ -190,6 +170,34 @@
 	rom_d2d_link_init();
 }
 
+static void execute_erom_recovery(void)
+{
+	uint32_t count, i;
+
+	/* EROM recovery not supported in slave die */
+	if (arcboot_rom_global.die_id)
+		return;
+
+	arcboot_rom_status_update(PROGRESS_ARCBOOT_IN_EROM_RECOVERY);
+
+	count = boot_desc_init(HL_FW_BOOT_PTR_EROM);
+	if (!count) {
+		arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_BOOT_DESC_ERROR);
+		goto rom_recovery;
+	}
+
+	if (arcboot_rom_verify(HL_FW_BOOT_PTR_EROM))
+		goto rom_recovery;
+
+	for (i = 0; i < count; i++)
+		ext_rom_load_erom_image(i);
+
+	return;
+
+rom_recovery:
+	execute_rom_recovery();
+}
+
 void execute_recovery(void)
 {
 	arcboot_rom_status_update(PROGRESS_ARCBOOT_IN_RECOVERY);
