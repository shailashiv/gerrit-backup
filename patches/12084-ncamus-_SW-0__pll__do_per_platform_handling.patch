+			.div_factor = { 0, 1, 2, 7 }
+		},
+};
+
+int hl_pll_get_cfg(struct hl_pll_cfg **hl_pll_cfg)
+{
+	int pll_num = ARRAY_SIZE(gaudi_pll_cfg);
+	int boot_strap = regmap_readl(mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS);
+
+	if (boot_strap & SKIP_PLL_INIT)
+		return 0;
+
+	*hl_pll_cfg = gaudi_pll_cfg;
+
+	return pll_num;
+}
+
