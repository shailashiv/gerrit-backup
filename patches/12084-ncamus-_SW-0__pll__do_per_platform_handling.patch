+			.nr = 0, .nf = 37, .od = 1, .nb = 18, /* 950 MHz */
+			.div_factor = { 0, 1, -1, -1 }
+		}, {
+			.name = "NIC0", .base = mmNIC0_PLL_BASE,
+			.nr = 24, .nf = 1665, .od = 3, .nb = 832, /* 833 MHz */
+			.div_factor = { 0, 4, 8, -1 }
+		}, {
+			.name = "NIC1", .base = mmNIC1_PLL_BASE,
+			.nr = 24, .nf = 1665, .od = 3, .nb = 832, /* 833 MHz */
+			.div_factor = { 0, 4, 8, -1 }
+		}, {
+			.name = "NIC2_HBM", .base = mmNIC2_HBM_PLL_BASE,
+			.nr = 0, .nf = 37, .od = 1, .nb = 18, /* 950 MHz */
+			.div_factor = { 0, 1, -1, -1 }
