From 3257b73483e30abf170653a54818c5ee32693f73 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Thu, 02 May 2019 04:54:01 +0300
Subject: [PATCH] [SW-0] pll: do per platform handling

In ONIX, and PLDM it is only an empty stub which returns that no PLLs
available.

Change-Id: I7fae4f9be39b3fbbdfeb4b8e5957c4c0b3248475
---

diff --git a/Makefile b/Makefile
index d500a49..7d84dbc 100644
--- a/Makefile
+++ b/Makefile
@@ -20,7 +20,8 @@
 LDLIBS := -lgcc
 
 PREBOOT_SRCS_C := $(shell ls common/*.c)
-PREBOOT_SRCS_C += $(shell ls $(HL_DEV)/*.c)
+PREBOOT_SRCS_C += $(shell ls $(HL_DEV)/common.c)
+PREBOOT_SRCS_C += $(shell ls $(HL_DEV)/$(HL_TARGET).c)
 PREBOOT_SRCS_S := $(shell ls common/*.S)
 
 PREBOOT_OBJECTS := $(PREBOOT_SRCS_C:.c=.o)
