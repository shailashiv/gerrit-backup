diff --git a/arch/gaudi3/arc/dev_efuse.h b/arch/gaudi3/arc/dev_efuse.h
new file mode 100644
index 0000000..4c862c8
--- /dev/null
+++ b/arch/gaudi3/arc/dev_efuse.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Copyright (C) 2022 HabanaLabs Ltd.
+ */
+
+#ifndef _GAUDI3_DEV_EFUSE_H_
+#define _GAUDI3_DEV_EFUSE_H_
+
+/* TODO: Replace with gaudi3 values */
+
+#define EFUSE_KEY_HASH_OFFSET				0x14
+
+/*
+ * 00: ROM, 01: EROM, 10: RSVD, 11:ROM
+ */
+#define EFUSE_SYSCFG_RECOVERY_CODE_LOCATION		13
+#define EFUSE_SYSCFG_RECOVERY_CODE_LOCATION_MASK	0x3
+#define EFUSE_SYSCFG_RECOVERY_CODE_LOCATION_EROM	0x1
+
+#define EFUSE_SYSCFG_ENABLE_TPM_MASK			BIT(11)
+#define EFUSE_SYSCFG_FW_VERSION_LOCATION		7
+#define EFUSE_SYSCFG_FW_VERSION_LOCATION_MASK		0x3
+#define EFUSE_SYSCFG_KEY_LOCATION			5
+#define EFUSE_SYSCFG_KEY_LOCATION_MASK			0x3
+#define EFUSE_SYSCFG_REVOKATION_LOCATION		7
+#define EFUSE_SYSCFG_REVOKATION_LOCATION_MASK		0x3
+
+#define EFUSE_SYSCFG_FW_VERSION_LOCATION_SPI		BIT(8)
+#define EFUSE_SYSCFG_REVOKATION_LOCATION_SPI		BIT(8)
+
+/*
+ * As per recommendation from Security Architect, if FUSE is not available,
+ * card should not continue in the secure boot mode. Hence the default
+ * can be 0 (with no enabling of the Signature of Validation also.
+ */
+#define EFUSE_SYSCFG_DEFAULT				0
+
+#endif /* _GAUDI3_DEV_EFUSE_H_ */
diff --git a/arch/gaudi3/arc/dev_security.h b/arch/gaudi3/arc/dev_security.h
new file mode 100644
index 0000000..719c06f
--- /dev/null
+++ b/arch/gaudi3/arc/dev_security.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Copyright (C) 2022 HabanaLabs Ltd.
+ */
+
+#ifndef _GAUDI3_DEV_SECURITY_H_
+#define _GAUDI3_DEV_SECURITY_H_
+
+#include <sha512.h>
+
+/* TODO: Replace with gaudi3 values */
+
+#define NUM_KEYS_IN_ROM					5
+#define NUM_KEYS_IN_EFUSE				3
+#define SECURITY_DWORD_PER_KEY				12
+#define SECURITY_KEY_HASH_COUNT				3
+#define NUM_DWORDS_AVLBL_IN_PSOC_SEC			8
+
+enum security_key_location {
+	KEY_LOCATION_ROM,
+	KEY_LOCATION_EFUSE
+};
+
+/* size of key properties in bytes */
+#define KEY_PROP_RR_SZ					384
+#define KEY_PROP_MOD_SZ					384
+#define KEY_PROP_EXP_SZ					8
+#define KEY_PROP_INV_SZ					4
+#define KEY_PROP_NB_SZ					4
+#define KEY_PROP_HDR_SZ					8
+
+/* 384 + 384 + 8 + 4 + 4 = 784 bytes */
+#define PUB_KEY_SZ		(KEY_PROP_RR_SZ + KEY_PROP_MOD_SZ + \
+				KEY_PROP_EXP_SZ + KEY_PROP_INV_SZ + \
+				KEY_PROP_NB_SZ)
+
+/* 784 + 8 = 792 */
+#define TOTAL_PUB_KEY_PROPS_SZ  (PUB_KEY_SZ + KEY_PROP_HDR_SZ)
+
+extern const uint8_t rom_key_hashes[NUM_KEYS_IN_ROM][SHA384_SUM_LEN];
+
+#endif /* _GAUDI3_DEV_SECURITY_H_ */
