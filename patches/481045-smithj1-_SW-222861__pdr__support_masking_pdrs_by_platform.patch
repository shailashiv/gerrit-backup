@@ -366,6 +369,7 @@
 	struct sensord_sensor_state *state;
 	int64_t start_time;
 	int64_t current_time;
+	uint8_t current_platform = pldm_get_current_platform();
 	int num_reviewed = 0;
 	int num_polled = 0;
 
@@ -393,6 +397,9 @@
 		state = get_sensor_state(sensord_state.next_sensor_to_poll);
 		sensord_state.next_sensor_to_poll++;
 		pdr = sensor->pdr;
+
+		if (pldm_pmc_unsupported_pdr(&sensor->pdr->meta, current_platform))
+			continue;
 
 		num_reviewed++;
 
@@ -607,12 +614,17 @@
 
 static int sensord_init_all_sensors(void)
 {
+	uint8_t current_platform = pldm_get_current_platform();
+
 	for (size_t i = 0; i < sensord_state.num_sensors; i++) {
 		struct sensord_sensor_entry *sensor = &sensord_state.sensors[i];
 		struct sensord_sensor_state *state = get_sensor_state(i);
 		const struct pldm_pdr_record *pdr = sensor->pdr;
 		int err;
 
+		if (pldm_pmc_unsupported_pdr(&pdr->meta, current_platform))
+			continue;
+
 		state->timestamp_next_poll = 0;
 
 		switch (pdr->common.type) {
