+function devs_list_add()
+{
+	local tmp_list
+	local wrong_list
+	local find=0
+
+	[[ ${devs_list[@]} =~ all ]] && return 0
+
+	for entry in $*; do
+		tmp_list=($(delimited_to_array ',' $entry))
+		for id in ${tmp_list[@]}; do
+			find=0
+			[[ "$id" == "all" ]] && { devs_list=(all); return 0; }
+
+			hlp_is_valid_pci_addr $id
+			[ $? -eq 0 ] && find=1
+			hlp_is_valid_oam_addr $id
+			[ $? -eq 0 ] && find=1
+			[[ $find -eq 0 ]] &&  {
+					pinfo  add to wrong $id
+					wrong_list+=($id)
+					continue
+			}
+			[[ ${devs_list[@]} =~ $id ]] || devs_list+=($id)
+		done
+	done
+	[[ ${#wrong_list[@]} -gt 0 ]] && {
+		perr "Wrong device IDs: ${wrong_list[@]}"
+		return 1
+	}
+	return 0
+}
