+function calc_args_num()
+{
+	local symbol
+	local count=0
+	for symbol in $*; do
+		case $symbol in
+		-[0-9\.]+)
+			;;
+		--*|-*)
+			break
+			;;
+		esac
+		((count++))
+	done
+	echo $count
+}
