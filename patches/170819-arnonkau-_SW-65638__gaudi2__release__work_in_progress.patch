+function create_config_file_op()
+{
+
+	[ "${create_cfg}" == "" ] && return 0
+
+	[ -f ${create_cfg:-""} ] && {
+		hlp_answer_yn "File exist. Is it ok to overrun it?"
+		[ $? -ne 0 ] && return 1
+		touch $create_cfg
+		[ $? -ne 0 ] && {
+			perr "Can't create file $1, assuming permission issue"
+			return 1
+		}
+
+	}
+
+	cat <<-END > $create_cfg
+		#####################################################
+		# Automaticly created by fwi
+		# Date: $(date)
+		# User: ${USER}
+		# Host: $(hostname)
+		# ARGS: $*
+		# log : level=${log_lvl}, verbose=${verbose_lvl}
+		#####################################################
+
+		platform_type=$platform_type
+		dev_type=$dev_type
+		rmt_host='$rmt_host'
+		rmt_user='$rmt_user'
+		rmt_passwd='$rmt_passwd'
+		ctrl_host='$ctrl_host'
+		ctrl_user='$ctrl_user'
+		ctrl_passwd='$ctrl_passwd'
+		bmc_host='$bmc_host'
+		bmc_host_user='$bmc_host_user'
+		bmc_host_passwd='$bmc_host_passwd'
+		bmc_oam='$bmc_oam'
+		bmc_oam_user='$bmc_oam_user'
+		bmc_oam_passwd='$bmc_oam_passwd'
+		bmc_oam_ssh_user='$bmc_oam_ssh_user'
+		bmc_oam_ssh_passwd='$bmc_oam_ssh_passwd'
+		log_file='$log_file'
+		log_dir='$log_dir'
+		fw_rev_id='$fw_rev_id'
+		fw_po_rev_id='$fw_po_rev_id'
+		cpld_rev_id='$cpld_rev_id'
+		cpld_file='$cpld_file'
+		rmt_host_ignore_f=$rmt_host_ignore_f
+		ctrl_host_ignore_f=$ctrl_host_ignore_f
+		ignore_ssh_init_f=$ignore_ssh_init_f
+		ssh_rmt_user_args='$ssh_rmt_user_args'
+		#is_burn_parallel_f=$is_burn_parallel_f
+		#burn_cpld_f=$burn_cpld_f
+		#burn_flash_f=$burn_flash_f
+		#burn_eeprom_f=$burn_eeprom_f
+		#pre_reboot_f=$pre_reboot_f
+		#fw_recovery_f=$fw_recovery_f
+		#skip_install_f=$skip_install_f
+		#skip_copy_f=$skip_copy_f
+	END
+	exit 0
+}
