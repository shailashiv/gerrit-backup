+
+function run_per_selected_devs ()
+{
+	local elem oam_id pci_id
+	local cmd=$1
+	shift
+
+	[ ${#devs_list[@]} -eq 0 ] && return 1
+
+	for elem in ${devs_list[@]}; do
+		echo ${elem} | grep ':' > /dev/null
+		[ $? -eq 0 ] && {
+			pci_id=$elem
+			oam_id=$(hls2_pci2oam $elem)
+			[ $? -ne 0 ] && {
+
+				pwarn "[${pci_id}] can't find related OAM, is ID correct?"
+				continue
+			} || true
+		} || {
