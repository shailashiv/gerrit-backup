 }
 
 function hls2_pci2oam()
 {
 	local pci_id=$1
+
 	[ $# -lt 1 ] && return 1
 	for ((i=0; i < 8; i++)); do
-		[ "${hls2_oam2pci_id[$i]}" == "${pci_id}" ] && {
