+#BEGIN { FS="'\''";  flag=0; count=0; }
+BEGIN { FS="'";  flag=0; count=0; }
+/<video/ { start=1; next }
+start==0 {next}
+/<hostdev/ {
+	flag=1
+	next
+}
+
+/<address/ && flag==1 {
+	r=sprintf("%02x:%02x.%x", strtonum($4), strtonum($6), strtonum($8))
+	flag=2
+	next
+}
+
+/<address/ && flag==2 {
+	results[r]=sprintf("%02x:%02x.%x", strtonum($6), strtonum($8), strtonum($10))
