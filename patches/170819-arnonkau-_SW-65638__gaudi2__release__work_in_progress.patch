+function handle_user_earlier_params()
+{
+	local err
+	local manip_cmd
+	local nargs args
+	local ptype dtype
+
+	while [[ $# -gt 0 ]]; do
+		cmd=$1 # keeps it in case of shifting
+		shift
+		nargs=$(calc_args_num $*)
+		args=($(hlp_slice_list 0 $(($nargs-1)) $*))
+		pinfo -l 3 "cmd $cmd nargs=${nargs}[${#args[@]}] args=${args[@]}"
+
+		case $cmd in
+		-c|--config|--cfg)
+			cfg_file=${args[0]}
+			;;
+		-p|--platform)
+			ptype=${args[0]}  # see supported_platforms
+			;;
+		-t|--type)
+			dtype=${args[0]}
+			;;
+		--ignore-cfg|--ignore-config)
+			dfl_cfg_file=""
+			;;
+		esac
+		shift $nargs
+	done
+
+	######################################
+	# load user's pre-config values
+	#
+	# loading first the default values
+	# then it can be run over by a cmdline
+	######################################
+	config_load_file $cfg_file
+
+	[ "$ptype" != "" ] && {
+		platform_type=$ptype
+		[[ ${supported_platforms[@]} =~ $ptype ]] || {
+			perr "Unrecognized platform $ptype"
+			exit 1
+		}
+	}
+	[ -n $dtype ] && dev_type=$dtype
+
+	return 0
+}
 
