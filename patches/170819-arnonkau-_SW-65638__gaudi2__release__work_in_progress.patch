+function mcp_check_and_get_id()
+{
+	local cpld_rev
+
+	dev_id=$(ctrl_run ${rmt_mcp_scr}/dev_id.sh)
+	[[ $? -ne 0 ]] && return 1
+	cpld_rev=$(ctrl_run_sudo ${rmt_mcp_scr}/cpld_read_version_num.sh ${dev_id})
+	[[ $? -ne 0 ]] && return 2
+
+	echo $cpld_rev
+	return 0
+}
+
+function is_mcp_operational()
+{
+	# OPTIMISTIC
+	# Check if sival scripts already installed
+	ctrl_run "i2cdetect -l | grep 2221"
+	[ $? -ne 0 ] && {
+		# try to use NFS' shared sival driver load script
+		ctrl_run_sudo /software/sival/tools/mcp2221_0_1/driver_load.sh
+		[ $? -ne 0 ] && {
+			# Loading MCP failed
+			return 0
+		} || {
+			# Check if i2c tools detect the MCP, if not reinstall MCP pack
+			ctrl_run "i2cdetect -l | grep 2221"
+			[ $? -ne 0 ] && {
+				return 0
+			}
+		}
+	}
+
+	return 1
+}
+
+function sys_tools_install()
+{
+	local mcp_op_f=0
+
+	pinfo -l 2 "Tools Install"
+
+	is_mcp_operational
+	mcp_op_f=$?
+	ctrl_copy_files $mcp_op_f
+	host_copy_files
+
+	# Only if MCP was not responsive till now, reinstall it
+	[ $mcp_op_f -eq 0 ] && {
+		ctrl_run ${rmt_home}${rmt_rel_mcp}/rmt_mcp_install.sh $rmt_passwd
+		return $?
+	}
+
+	return 0
+}
+
+function sys_copy_files()
+{
+	#host_copy_files
+	return 0
+}
