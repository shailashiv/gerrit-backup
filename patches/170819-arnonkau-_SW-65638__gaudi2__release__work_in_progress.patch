+		perr "dipsw gpio set data format 0xXX 0xYY 0xZZ"
+		return 1
+	}
+	fwi_ipmitool -I lanplus -H ${host} -U ${user} -P ${passwd} raw 0x3c 0x1 ${raw_data[@]}
+}
+
+function ipmi_read_pci_sw_gpio()
+{
+	local user=admin
+	local passwd=admin
+	local cfg_file=""
+	local sw_id
+	local gpio_idx
+
+	ipmi_get_min_opts ipmi_read_pci_sw_gpio $*
+	[ $? -ne 0 ] && return 1
+
+	sw_id=${raw_data[0]}
+	gpio_idx=${raw_data[1]}
+
