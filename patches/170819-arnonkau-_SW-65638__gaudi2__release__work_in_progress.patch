index 0000000..d43d25c
--- /dev/null
+++ b/scripts/fwi/sa_platform.rc
@@ -0,0 +1,522 @@
+mcp_tgz_pkg=mcp2221_0_1-flat.tgz
+rmt_rel_mcp=./fwi/mcp/
+rmt_mcp_scr=${rmt_home}${rmt_rel_mcp}/scripts
+
+function usage_sa()
+{
+cat << END>&3
+END
+}
+
+source ${scr_dir}/mcp.rc
+
+function ctrl_run()
+{
+	hlp_ssh ${ctrl_user}@${ctrl_host} $*
+}
+
+function ctrl_run_sudo()
+{
+	hlp_ssh_sudo ${ctrl_user}@${ctrl_host} $*
+}
+
+function host_run()
+{
+	hlp_ssh ${rmt_user}@${rmt_host} $*
+}
+
+function host_run_sudo()
+{
+	hlp_ssh_sudo ${rmt_user}@${rmt_host} $*
+}
+
+function sys_get_devs_list()
+{
+	echo ${lspci_devs_list[@]}
+}
+
+function oam_i2c_scan()
+{
+	local i
+
+	pinfo -l 3 "oam_i2c_scan"
+	ctrl_run "i2cdetect -r -y $1"
+	[ $? -eq 0 ] && { return 0; } || { perr "OAM[${1}]: I2C: failed to scan"; }
+	return 1
+}
+
+function oam_i2c_scan_op()
+{
+	local ret err
+
+	pinfo -l 3 "oam_i2c_scan_op"
+	[ "$i2c_scan" == "all" ] && {
+		run_per_all_devs oam_i2c_scan >& 3
+	} || {
+		# TODO: check range 0-7 [num of OAMs]
+		oam_i2c_scan ${i2c_scan}
+		#pinfo "I2C Scan[${i2c_scan}]: ${ret[@]}"
+	}
+}
+
+function oam_i2c_raw_cmd()
+{
+	local oam=$1
+	local bus=$2
+	local offset=$3
+
+	shift 3
+
+	perr "oam_i2c_raw_cmd command doesn't supported on this platform"
+}
+
+function oam_i2c_send_op()
+{
+	local ret err
+	pinfo -l 2 "oam_i2c_send ${i2c_send}"
+	ret=($(oam_i2c_raw_cmd $(delimited_to_array ',' ${i2c_send})))
+	err=$?
+	pinfo "I2C Res: ${ret[@]}"
+}
+
+function recovery_mode_op()
+{
+	case ${recovery_mode:-"NONE"} in
+	NONE)
+		;;
+	off|OFF|dis|disable)
+		#ctrl_run_sudo ${rmt_mcp_scr}/recovery_disable.sh ${dev_id}
+		#err=$?
+		pinfo "was not tested yet"
+		;;
+	on|ON|enb|enable)
+		#ctrl_run_sudo ${rmt_mcp_scr}/recovery_enable.sh ${dev_id}
+		#err=$?
+		pinfo "was not tested yet"
+		;;
+	*)
+		pwarn "[SA] uknown recovery mode argument: $recovery_mode. Ignoring"
+		;;
+	esac
+}
+
+function oams_power_op()
+{
+	case ${oams_power:-"NONE"} in
+	1|cyc|cycle)
+		pinfo "N/A yet"
+		;;
+	2|on)
+		pinfo "N/A yet"
+		;;
+	3|off)
+		pinfo "N/A yet"
+		;;
+	NONE)
+		;;
+	*)
+		pwarn "[HLS] uknown power mode argument: $power_mode. Ignoring"
+		return 1
+		;;
+	esac
+}
+
+function host_power_op()
+{
+	case ${host_power:-"NONE"} in
+	NONE)
+		;;
+
+	off|OFF|dis|disable)
+		perr "Not supported yet"
+		[ $? -eq 1 ] && return 1
+		;;
+	on|ON|enb|enable)
+		perr "Not supported yet"
+		[ $? -eq 1 ] && return 1
+		;;
+	*)
+		perr "Not supported yet"
+		;;
+	esac
+}
+
+function sys_special_commands()
+{
+	local err=0
+	#local dev_id=$1
+	[ "$i2c_scan" != "" ] && {
+		oam_i2c_scan_op
+		[ $? -ne 0 ] && return 1
+	}
+
+	[ "$i2c_send" != "" ] && {
+		bmc_i2c_send_op
+		[ $? -ne 0 ] && return 1
+	}
+
+	recovery_mode_op
+	oams_power_op
+	host_power_op
+
+	return $err
+}
+
+function host_init()
+{
+	plog -l 2 "host_init"
+
+	lspci_devs_list=($(host_run '(lspci | grep accel | grep Habana | cut -d" " -f1)'))
+	[ $? -ne 0 ] && {
+		perr "Failed to discover OAM device on PCI bus"
+		return 1
+	}
+
+	[ ${#lspci_devs_list[@]} -gt 1 ] && {
+		perr "Discovered more than a single OAM, try -p option"
+		return 1
+	}
+
+	host_run '(hostname; [ $(lsmod | grep habana | wc -l) -gt 0 ] && { sudo rmmod habanalabs && sudo rmmod habanalabs_en;} || true)'
+
+}
+
+function ctrl_init()
+{
+	pinfo "ctrl_init"
+	[ -z ${ctrl_host} ] && {
+		perr "Ctrl host address is missing"
+		return 1
+	}
+	# check ctrl host connectivity
+	return 0
+}
+
+function sys_param_check()
+{
+	[ "$rmt_host" == "" ] && {
+		perr "Host address is missing"
+		return 1
+	}
+	[ "$ctrl_host" == "" ] && {
+		ctrl_host=$rmt_host
+		ctrl_user=${ctrl_user:-${rmt_user}}
+		ctrl_passwd=${ctrl_passwd:-${rmt_passwd}}
+	}
+
+	[ "$rmt_passwd" == "" -o "$ctrl_passwd" == "" ] && {
+		perr "Missing Credentials - password"
+		return 1
+	}
+	[ "$rmt_user" == "" -o "$ctrl_user" == "" ] && {
+		perr "Missing Credentials - user"
+		return 1
+	}
+	return 0
+}
+
+function sys_init()
+{
+	[ ! -z ${rmt_passwd} ] && rmt_sudo="echo ${rmt_passwd} | sudo -S "
+	hlp_ssh_sync ${rmt_user}@${rmt_host}
+	[ $? -ne 0 ] && {
+		perr "Host connectivity error - check credentials"
+		perr "ssh-copy-id to ${rmt_host} fail"
+		perr "please run manually before. use key file ${ssh_key_file}, if exist"
+		perr "ssh-copy-id ${rmt_user}@${rmt_host}"
+		rmt_host_comm_err_ind=1
+		[ ${skip_rmt_host_on_err_f} -eq 0 ] && return 1
+	}
+
+	[[ "$ctrl_host" != "$rmt_host" ]] && {
+		hlp_ssh_sync ${ctrl_user}@${ctrl_host}
+		[ $? -ne 0 ] && {
+			perr "CTRL Host (NUC) connectivity error - check credentials"
+			perr "ssh-copy-id to ${ctrl_host} fail"
+			perr "please run manually before. use key file ${ssh_key_file}, if exist"
+			perr "ssh-copy-id ${ctrl_user}@${ctrl_host}"
+			rmt_ctrl_comm_err_ind=1
+			[ ${skip_ctrl_host_on_err_f} -eq 0 ] && return 1
+		}
+	}
+
+	[[ $rmt_host_comm_err_ind -eq 0 ]] && {
+		host_init
+		[ $? -ne 1 ] && {
+			[[ $ctrl_host_comm_err_ind -eq 0 ]] && {
+				ctrl_init
+				return $?
+			}
+		}
+	}
+
+	return $?
+}
+
+function sys_read_status()
+{
+	pinfo "Not supported yet"
+	return 0
+}
+
+function sys_check()
+{
+	local target_cpld_rev cpld_rev
+
+	mcp_check_and_get_id
+	[ $? -ne 0 ] && {
+		perr "OAM i2c bus not found - check connectivity"
+		return 1
+	}
+
+	pci_devs_list=($(host_run lspci -d 1da3: | awk '{print $1;}'))
+
+	[ "$pci_devs_list" == "" ] && {
+		pwarn "No devices found"
+		return 1
+	}
+
+	[ ${burn_cpld_f:-0} -eq 1 ] && { return 0; }
+
+	[ ${burn_flash_f:-0} -ne 1 ] && { return 0; }
+
+	target_cpld_rev=$(printf "0x%x" ${cpld_rev_id})
+	cpld_rev=$(mcp_check_and_get_id)
+
+	cpld_rev=$(printf "0x%x" ${cpld_rev})
+	# check if CPLD needs to be burn
+	[ $((${cpld_rev})) -eq $((${target_cpld_rev})) ] || {
+		perr "CPLD revision comparison failed, consider using option -C"
+		plog -l 1 "CPLD: current ${cpld_rev}, expected ${target_cpld_rev}"
+		return 1
+	}
+
+	return 0
+}
+
+function sys_pre_burn()
+{
+	local pci_dev=$1
+
+	[ disable_flash_wp_f -eq 1 ] && {
+		ctrl_run ${rmt_mcp_scr}/cpld_wp_disable.sh ${dev_id}
+		[ $? -eq 0 ] && {
+			echo [$pci_dev] i2c-${dev_id}: Disable WP
+			sleep 1
+			return 0
+		}
+	}
+	return 1
+}
+
+function sys_post_burn()
+{
+	local pci_dev=$1
+	local exit_err=$2
+
+	[ $burn_cpld_f -eq 1 ] && {
+		echo "[${pci_dev}] i2c-${dev_id}: Full power Cycle"
+		ctrl_run ${rmt_mcp_scr}/full_power_cycle.sh ${dev_id}
+		[ $? -ne 0 ] && return 1
+		sleep 3
+		# double tap
+		ctrl_run ${rmt_mcp_scr}/full_power_cycle.sh ${dev_id}
+		[ $? -ne 0 ] && return 1
+		sleep 3
+	}
+	return 0
+}
+
+function sys_pre_recovery()
+{
+	ctrl_run ${rmt_mcp_scr}/cpld_wp_disable.sh ${dev_id}
+	[ $? -ne 0 ] && return 1
+	sleep 0.5
+	ctrl_run ${rmt_mcp_scr}/cpld_secureboot_disable.sh ${dev_id}
+	[ $? -ne 0 ] && return 2
+	sleep 0.5
+	ctrl_run ${rmt_mcp_scr}/cpld_btl_disable.sh ${dev_id}
+	[ $? -ne 0 ] && return 3
+	sleep 0.5
+	ctrl_run ${rmt_mcp_scr}/cpld_power_cycle.sh ${dev_id}
+	[ $? -ne 0 ] && return 4
+
+	return 0
+}
+
+function sys_post_recovery()
+{
+	local i
+
+	for ((i=0; i < 2; i++)); do
+		ctrl_run ${rmt_mcp_scr}/full_power_cycle.sh ${dev_id}
+		[ $? -eq 0 ] && return 0
+		#sleep 0.5
+	done
+	return 1
+}
+
+function sys_reboot()
+{
+	host_run_sudo reboot
+	pinfo "Reboot triggered"
+	return 0
+}
+
+function sys_post_reboot()
+{
+	# TODO: needs to add sival checks, at least cpld version
+	return 0
+}
+
+function host_copy_files()
