+	/* If failed, read it using libsensors APIs */
+	if (ret != HLML_INT_SUCCESS)
+		ret = hl_smi_sensors_get_info(aip_info, HL_SMI_SENSORS_INFO_POW);
+
+	/* If failed, set an error sensor value and return an error */
+	if (ret != HLML_INT_SUCCESS) {
+		aip_info->psu_main_info.psu_main_power = ERROR_SENSOR_VALUE;
+		return ret;
+	}
+
+	/* The total power is set to the power drawn from the main PSU at first */
+	aip_info->total_power = aip_info->psu_main_info.psu_main_power;
+
+	/* If a seconday PSU exists in the system, reat it using libsensors APIs */
+	if (aip_info->psu_sec_info) {
+		ret = hl_smi_sensors_get_info(aip_info, HL_SMI_SENSORS_INFO_SEC_POW);
+
+		/* If failed, set an error sensor value and return an error */
+		if (ret != HLML_INT_SUCCESS) {
+			aip_info->psu_sec_info->psu_sec_power = ERROR_SENSOR_VALUE;
+			return ret;
+		} else {
+			/* Add the power drawn from the secondary PSU to the total power */
+			aip_info->total_power += aip_info->psu_sec_info->psu_sec_power;
+
+			HLML_LOG_DBG("main-power [W] = %u, sec-power [W] = %u",
+				aip_info->psu_main_info.psu_main_power,
+				aip_info->psu_sec_info->psu_sec_power);
+		}
+	}
+
+	HLML_LOG_DBG("total-power [W] = %u", aip_info->total_power);
 
 	return ret;
 }
