From 2a6badc061fe7e8ece81d640e7ca9788d06ca504 Mon Sep 17 00:00:00 2001
From: Yehuda Levavi <yehuda.levavi@tandemg.com>
Date: Wed, 15 Dec 2021 13:07:15 +0200
Subject: [PATCH] [SW-66520] comms: mme binning conf support

Extend binning conf support to support mme isolation info.

Change-Id: I3c35bcb0572d4e2024c1806cdc9ff19e50443b0d
Signed-off-by: Yehuda Levavi <yehuda.levavi@tandemg.com>
---

diff --git a/include/preboot.h b/include/preboot.h
index 1add4e0..00b7ec3 100644
--- a/include/preboot.h
+++ b/include/preboot.h
@@ -85,6 +85,7 @@
 	uint32_t dec;
 	uint32_t hbm;
 	uint32_t edma;
+	uint32_t mme;
 };
 
 struct hl_binning_conf {
diff --git a/lib/preboot/module_lkd.c b/lib/preboot/module_lkd.c
index 0e40d67..5e7cc31 100644
--- a/lib/preboot/module_lkd.c
+++ b/lib/preboot/module_lkd.c
@@ -140,6 +140,7 @@
 	masks.dec = mcomms->dec_binning_conf;
 	masks.hbm = mcomms->hbm_binning_conf;
 	masks.edma = mcomms->edma_binning_conf;
+	masks.mme = mcomms->mme_redundancy_conf;
 	preboot_set_binning_conf(&masks);
 
 	return 0;
