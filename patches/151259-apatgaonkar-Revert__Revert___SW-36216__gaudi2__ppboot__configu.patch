 #include <hl_protbits_fw_if.h>
+#include <string.h>
 #include <psoc_arc0_mstr_if_core_hbw_regs.h>
 #include <psoc_arc0_mstr_if_core_lbw_regs.h>
 #include <psoc_arc1_mstr_if_core_hbw_regs.h>
 #include <psoc_arc1_mstr_if_core_lbw_regs.h>
 #include <dcore0_rtr0_mstr_if_rr_shrd_lbw_regs.h>
 #include <pcie_lbw_rr_mstr_if_rr_shrd_lbw_regs.h>
-#include <psoc_mstr_if_rr_shrd_lbw_regs.h>
+#include <jt_mstr_if_rr_shrd_lbw_regs.h>
 #include <sft0_lbw_rtr_if_mstr_if_rr_shrd_lbw_regs.h>
 
 /*
@@ -95,6 +96,8 @@
  * transactions for the input address range.
  */
 enum gaudi2_sec_if_lbw_rrs {
+	HL_SEC_LBW_DBG_CFG_SPACE = 0,
+	HL_SEC_LBW_PSOC_GLBL_CONF = 1,
 	HL_SEC_LBW_MAX_RR_IDX = 18,
 };
 
@@ -102,7 +105,7 @@
 #define SFT_DIST	0x10000
 #define IF_RTR_DIST	0x8000
 #define PCIE_INST_NUM	1
-#define PSOC_INST_NUM	PCIE_INST_NUM
+#define PSOC_INST_NUM	3 /* JTAG, SMI, I2C */
 #define SFT_INST_NUM	PCIE_INST_NUM
 #define SHIFT_4K_POS	12
 
@@ -129,13 +132,13 @@
 	},
 	[HL_SEC_ENGINE_PSOC] = {
 		.instances_num = PSOC_INST_NUM,
-		.instances_dist = 0,
-		.min_short_breg = mmPSOC_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MIN_SHORT_0,
-		.max_short_breg = mmPSOC_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MAX_SHORT_0,
-		.min_full_breg = mmPSOC_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MIN_0,
-		.max_full_breg = mmPSOC_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MAX_0,
-		.hit_wr_breg = mmPSOC_MSTR_IF_RR_SHRD_LBW_PRIV_HIT_AW,
-		.hit_rd_breg = mmPSOC_MSTR_IF_RR_SHRD_LBW_PRIV_HIT_AR,
+		.instances_dist = 0x1000,
+		.min_short_breg = mmJT_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MIN_SHORT_0,
+		.max_short_breg = mmJT_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MAX_SHORT_0,
+		.min_full_breg = mmJT_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MIN_0,
+		.max_full_breg = mmJT_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MAX_0,
+		.hit_wr_breg = mmJT_MSTR_IF_RR_SHRD_LBW_PRIV_HIT_AW,
+		.hit_rd_breg = mmJT_MSTR_IF_RR_SHRD_LBW_PRIV_HIT_AR,
 	},
 	[HL_SEC_ENGINE_SFT] = {
 		.instances_num = SFT_INST_NUM,
@@ -213,7 +216,7 @@
 		hl_secure_update_rr_reg(rr_idx, cfg->instances_dist * i, &rr_reg);
 }
 
-__unused static void hl_secure_lbw_rr(int rr_idx, u64 min, u64 max, struct hl_rr_eng_select rr_sel)
+static void hl_secure_lbw_rr(int rr_idx, u64 min, u64 max, struct hl_rr_eng_select rr_sel)
 {
 	int i;
 
@@ -314,6 +317,31 @@
 	preboot_puts("gaudi2 protection bits configured\n");
 }
 
+static void ppboot_secure_lbw(void)
+{
+	u64 min, max;
+	struct hl_rr_eng_select rr_sel;
+
+	memset(&rr_sel, 0, sizeof(struct hl_rr_eng_select));
+
+	/* Block only pcie RR in ppboot */
+	rr_sel.pcie = true;
+
+	/* CFG SPACE: 0x1000007FF8000000 - 0x1000007FFFFFFFFF */
+	min = CFG_BASE;
+	max = CFG_BASE + CFG_SIZE - 1;
+	hl_secure_lbw_rr(HL_SEC_LBW_DBG_CFG_SPACE, min, max, rr_sel);
+}
+
+void ppboot_security_init(void)
+{
+	/* Initialize only if security is enabled */
+	if (!preboot_security_is_enabled())
+		return;
+
+	ppboot_secure_lbw();
+}
+
 void preboot_security_init(void)
 {
 	preboot_secure_arc();
