diff --git a/arch/gaudi2/arm/ppboot.lds.S b/arch/gaudi2/arm/ppboot.lds.S
index 57d6ad6..88d5084 100644
--- a/arch/gaudi2/arm/ppboot.lds.S
+++ b/arch/gaudi2/arm/ppboot.lds.S
@@ -32,5 +32,12 @@
 		__stack_top = . ;
 	} > .sram
 
+	.stack2 : {
+		. = ALIGN(8);
+		__stack2 = . ;
+		. = . + 512 ;
+		__stack_top2 = . ;
+	} > .sram
+
 	.note.gnu.build-id : { *(.note.gnu.build-id) } > .sram
 }
diff --git a/arch/gaudi2/arm/secondary.S b/arch/gaudi2/arm/secondary.S
new file mode 100644
index 0000000..5d68439
--- /dev/null
+++ b/arch/gaudi2/arm/secondary.S
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier:     GPL-2.0+ */
+/*
+ * Copyright (C) 2021 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+.global secondary_entry
+secondary_entry:
+	ldr	x0, =__stack_top2
+	bic	sp, x0, #0xf	/* 16-byte alignment for ABI compliance */
+	mov	x29, sp		/* Set FP (x29) */
+	bl	secondary_main
diff --git a/arch/gaudi2/common/common.c b/arch/gaudi2/common/common.c
index 5932a69..a2f82c1 100644
--- a/arch/gaudi2/common/common.c
+++ b/arch/gaudi2/common/common.c
@@ -719,6 +719,51 @@
 	regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
 }
 
+void preboot_pcie_monitoring(void)
+{
+	/* Wait for PRSTn */
+	while (!regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN))
+		;
+
+	/* Only after PRSTn is de-asserted */
+	preboot_pcie_enable();
+
+	while (1) {
+		unsigned int prstn, ltssm, smlh, rdlh;
+
+		prstn = regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN);
+		ltssm = regmap_readl(mmPCIE_AUX_LTSSM_EN);
+		smlh = regmap_readl(mmPCIE_AUX_SMLH_LINK_UP);
+		rdlh = regmap_readl(mmPCIE_AUX_RDLH_LINK_UP);
+
+		if (prstn && smlh && rdlh)
+			break;
+
+		/*
+		 * Some host assert prstn during link up while moving to GEN3
+		 * This cause BAR size to be reset
+		 * We stop link up process by disabling ltssm
+		 * till BAR is reconfigured
+		 */
+		if (!prstn && ltssm) {
+			regmap_writel(0, mmPCIE_AUX_LTSSM_EN);
+			continue;
+		}
+
+		if (prstn && !ltssm) {
+			regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
+			continue;
+		}
+	}
+
+	/*
+	 * W/A H/W bug (Gaudi1) that may lead to have a wrong mask (0x1)
+	 * in LTSSM. Probably can be removed for Gaudi2, but we keep it as it
+	 * does not hurt.
+	 */
+	regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
+}
+
 bool tpm_is_supported(void) { return true; }
 
 unsigned int get_cs_pad_sel_flash(void)
