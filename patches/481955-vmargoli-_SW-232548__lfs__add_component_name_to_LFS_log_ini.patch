From 7b438158fc74e4d07dacf322c9deeebaf8ee86ca Mon Sep 17 00:00:00 2001
From: Vitaly Margolin <vmargolin@habana.ai>
Date: Tue, 17 Jun 2025 16:14:10 +0300
Subject: [PATCH] [SW-232548] lfs: add component name to LFS log init

Add componont name to LFS logger initialization
This is done to simplify robot testing of LFS logger
feature

Change-Id: I45cb1c3f6a9f32b4aeda555ee03664b36f2d07a4
Signed-off-by: Vitaly Margolin <vmargolin@habana.ai>
---

diff --git a/app/io/mgmt.c b/app/io/mgmt.c
index 20c58ba..8562606 100644
--- a/app/io/mgmt.c
+++ b/app/io/mgmt.c
@@ -208,7 +208,7 @@
 #ifdef CONFIG_LFS_ENABLED
 static void start_lfs_logger(void)
 {
-	lfs_console_init();
+	lfs_console_init_by_component("ArcMgmt");
 }
 #else
 static void start_lfs_logger(void) {}
