From a1e109fefeb3ce8ed60dd8b2f1db8cbb02c41548 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Tue, 19 Mar 2019 23:41:33 +0200
Subject: [PATCH] [SW-0] preboot: remove device name from code

No more goya/gaudi in code.
This will make project cleanup easier before upstream to
linux-firmware
Any Gaudi code must not be published at this point of time

Change-Id: If122f91a684c7cadaeb40f9b38b9909510e94f7a
---

diff --git a/Makefile b/Makefile
index 19a692b..f3e40a1 100644
--- a/Makefile
+++ b/Makefile
@@ -9,11 +9,7 @@
 CFLAGS += -include ../uboot-custom/include/linux/kconfig.h
 CFLAGS += -Wall -Werror
 CFLAGS += -c
-ifeq ($(HL_DEV),goya)
-	CFLAGS += -DDEV_IS_GOYA
-else
-	CFLAGS += -DDEV_IS_GAUDI
-endif
+CFLAGS += -I ./ -I ./common/
 
 ifeq ($(HL_TARGET),pldm)
 	CFLAGS += -DTARGET_IS_PLDM
@@ -21,12 +17,17 @@
 ifneq ($(TARGET_IS_TESTER),)
 	CFLAGS += -DTARGET_IS_TESTER
 endif
-LDFLAGS := -g -T preboot.lds -nostdlib -static
+
+SFLAGS := $(CFLAGS)
+CFLAGS += -include $(HL_DEV)/$(HL_DEV).h
+
+LDFLAGS := -g -T common/preboot.lds -nostdlib -static
 LDFLAGS += -L ../../host/opt/ext-toolchain/lib/gcc/aarch64-linux-gnu/6.4.1
 LDLIBS := -lgcc
 
-PREBOOT_SRCS_C := $(shell ls *.c)
-PREBOOT_SRCS_S += $(shell ls *.S)
+PREBOOT_SRCS_C := $(shell ls common/*.c)
+PREBOOT_SRCS_C += $(shell ls $(HL_DEV)/*.c)
+PREBOOT_SRCS_S := $(shell ls common/*.S)
 
 PREBOOT_OBJECTS := $(PREBOOT_SRCS_C:.c=.o)
 PREBOOT_OBJECTS += $(PREBOOT_SRCS_S:.S=.o)
@@ -49,7 +50,7 @@
 	$(CC) $(CFLAGS) -o $@ $<
 
 %.o: %.S $(AUTO_GENERATED_FILE)
-	$(CC) $(CFLAGS) -o $@ $<
+	$(CC) $(SFLAGS) -o $@ $<
 
 clean:
 	rm -f $(PREBOOT_OBJECTS) $(AUTO_GENERATED_FILE)
diff --git a/common/preboot.c b/common/preboot.c
new file mode 100644
index 0000000..861afeb
--- /dev/null
+++ b/common/preboot.c
@@ -0,0 +1,154 @@
+/*
+ * (C) Copyright 2017 HabanaLabs, Ltd.
+ * Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#include <common.h>
+#include <linux/io.h>
+#include <mach/hl_regs.h>
+#include <mach/hl_fw_if.h>
+#include "auto_generated.h"
+#include <stddef.h>
+#include <stdbool.h>
+#include "uart.h"
+#include "spi.h"
+#include "pci.h"
+
+#define VERSION_MAX_LEN		128
+
+#define PREBOOT_VER_STR	"Preboot version " PREBOOT_VER \
+	" (" PREBOOT_DATE " - " PREBOOT_TIME ")"
+
+/*
+ * Using scratchpad registers for
+ * passing flash layout to CPU SW
+ */
+static void preboot_copy_prepare(unsigned int *spl_off)
+{
+	unsigned int spl_offset = 0xa0000;
+	unsigned int uboot_offset = 0xb0000;
+	unsigned int modifiable_image_pending;
+	unsigned int image_base_offset;
+	unsigned int next_image, next_image_stable, next_image_modifiable;
+	bool try_new_image = false;
+	char *spl_image = "candidate";
+
+	modifiable_image_pending = readl(mmPSOC_GLOBAL_CONF_NON_RST_FLOPS_3);
+	if (modifiable_image_pending == FLOPS_UPD_PENDING) {
+		next_image_modifiable =
+			(*(unsigned int *)(HL_SPI_BASE + 0x60004) & 0xff) - '1';
+		if (next_image_modifiable < 2) {
+			next_image = next_image_modifiable;
+			writel((next_image + FLOPS_UPD_NXT_IMG1),
+					mmPSOC_GLOBAL_CONF_NON_RST_FLOPS_3);
+			try_new_image = true;
+		} else
+			writel(FLOPS_UPD_NOOP,
+					mmPSOC_GLOBAL_CONF_NON_RST_FLOPS_3);
+	}
+
+	if (!try_new_image) {
+		spl_image = "stable";
+		next_image_stable =
+			(*(unsigned int *)(HL_SPI_BASE + 0x60000) & 0xff) - '1';
+		if (next_image_stable < 2)
+			next_image = next_image_stable;
+		else
+			next_image = 0;
+	}
+
+	if (!next_image)
+		image_base_offset = 0;
+	else
+		image_base_offset = 0x800000;
+
+	preboot_puts_raw("Preparing to run SPL ");
+	preboot_puts_raw(spl_image);
+	preboot_puts_raw(" (offset: 0x");
+	preboot_puth_raw(image_base_offset, false);
+	preboot_puts(")\n");
+
+	*spl_off = image_base_offset + spl_offset;
+	writel((image_base_offset + uboot_offset)
+			, mmPSOC_GLOBAL_CONF_SCRATCHPAD_30);
+}
+
+
+static void preboot_copy_spl(void)
+{
+	unsigned int  spl_offset;
+
+	preboot_copy_prepare(&spl_offset);
+
+	spi_copy_spl(spl_offset);
+}
+
+static void preboot_pcie_init(void)
+{
+	if (readl(mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS) & SKIP_PCIE_INIT) {
+		preboot_puts("PCIe initialization is skipped!\n");
+		return;
+	}
+
+	preboot_pcie_wait_for_link();
+	preboot_puts("PCIe link is UP!\n");
+}
+
+#ifndef TARGET_IS_TESTER
+static const char *preboot_ver_str = PREBOOT_VER_STR;
+static char preboot_btl_ver_str[VERSION_MAX_LEN] = "BTL version ";
+
+static void preboot_version(void)
+{
+	u64 offset = (u64) preboot_btl_ver_str;
+	u32 btlver = readl(mmPSOC_GLOBAL_CONF_SCRATCHPAD_28);
+	int i, btl_ver_sz;
+
+	preboot_puts("\n");
+	preboot_puts_raw(preboot_btl_ver_str);
+	preboot_puth(btlver, true);
+	preboot_puts_raw(preboot_ver_str);
+	preboot_puts("\n");
+
+	/* get to the end of the predefined btl string */
+	for (i = 0; i < VERSION_MAX_LEN; i++)
+		if (preboot_btl_ver_str[i] == '\0')
+			break;
+
+	/* convert and copy the btl version */
+	i += preboot_uint2hexstring(&preboot_btl_ver_str[i], btlver, true);
+
+	/* separate the btl from preboot */
+	preboot_btl_ver_str[i++] = '\n';
+	btl_ver_sz = i;
+
+	/* copy the preboot version */
+	for (int j = 0; j < VERSION_MAX_LEN - btl_ver_sz - 1; j++) {
+		preboot_btl_ver_str[i++] = preboot_ver_str[j];
+		if (preboot_ver_str[j] == '\0')
+			break;
+	}
+
+	writel((u32)(offset & ~CONFIG_SYS_SDRAM_BASE),
+			mmPSOC_GLOBAL_CONF_SCRATCHPAD_28);
+}
+#else	/* TARGET_IS_TESTER */
+static inline void preboot_version(void) {}
+#endif	/* TARGET_IS_TESTER */
+
+void preboot_main(void)
+{
+	void (*spl_start)(void) = (void *)CONFIG_SPL_TEXT_BASE;
+
+	writel(CPU_BOOT_STATUS_IN_PREBOOT, mmPSOC_GLOBAL_CONF_WARM_REBOOT);
+
+	preboot_version();
+	preboot_pcie_init();
+	preboot_delay();
+	hl_pll_init();
+	preboot_copy_spl();
+
+	spl_start();
+}
diff --git a/common/preboot.lds b/common/preboot.lds
new file mode 100644
index 0000000..ea1f531
--- /dev/null
+++ b/common/preboot.lds
@@ -0,0 +1,23 @@
+/*
+ * (C) Copyright 2017 HabanaLabs, Ltd.
+ * Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+MEMORY { .sram : ORIGIN = 0x7ff0000000,
+		LENGTH = 0x10000 }
+
+OUTPUT_FORMAT("elf64-littleaarch64", "elf64-littleaarch64", "elf64-littleaarch64")
+OUTPUT_ARCH(aarch64)
+ENTRY(_start)
+SECTIONS
+{
+	.text : {
+		. = ALIGN(8);
+		common/start.o (.text*)
+		* (.text*)
+	} >.sram
+
+	.note.gnu.build-id : { *(.note.gnu.build-id) } > .sram
+}
diff --git a/common/spi.c b/common/spi.c
new file mode 100644
index 0000000..1315bd2
--- /dev/null
+++ b/common/spi.c
@@ -0,0 +1,227 @@
+/*
+ * (C) Copyright 2017 HabanaLabs, Ltd.
+ * Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#include <config.h>
+#include <linux/io.h>
+#include <linux/sizes.h>
+#include <linux/bitops.h>
+#include <mach/hl_regs.h>
+
+#include "uart.h"
+
+#define mmPSOC_SPI_CTRLR0		(HL_CFG_BASE + 0xC43000)
+#define mmPSOC_SPI_SSIENR		(HL_CFG_BASE + 0xC43008)
+#define mmPSOC_SPI_SER			(HL_CFG_BASE + 0xC43010)
+#define mmPSOC_SPI_BAUDR		(HL_CFG_BASE + 0xC43014)
+#define mmPSOC_SPI_TXFTLR		(HL_CFG_BASE + 0xC43018)
+#define mmPSOC_SPI_RXFTLR		(HL_CFG_BASE + 0xC4301C)
+#define mmPSOC_SPI_TXFLR		(HL_CFG_BASE + 0xC43020)
+#define mmPSOC_SPI_RXFLR		(HL_CFG_BASE + 0xC43024)
+#define mmPSOC_SPI_IMR			(HL_CFG_BASE + 0xC4302C)
+#define mmPSOC_SPI_DR0			(HL_CFG_BASE + 0xC43060)
+#define SPL_SIZE			SZ_64K
+#define CMD_WRITE_STATUS		0x01
+#define CMD_READ			0x03
+#define CMD_WRITE_DISABLE		0x04
+#define CMD_READ_STATUS			0x05
+#define CMD_WRITE_ENABLE		0x06
+#define CMD_READ_CONF			0x15
+#define READ_STATUS_WIP			BIT(0)
+#define READ_STATUS_BP0			BIT(2)
+#define READ_STATUS_BP1			BIT(3)
+#define READ_STATUS_BP2			BIT(4)
+#define READ_STATUS_BP3			BIT(5)
+#define READ_STATUS_SRWD		BIT(7)
+#define READ_STATUS_BP0_3		(READ_STATUS_BP0 | READ_STATUS_BP1 | \
+					READ_STATUS_BP2 | READ_STATUS_BP3)
+#define PROT_MASK			(READ_STATUS_BP0_3 | READ_STATUS_SRWD)
+#define frame_size_bits(b)		((b) << 16)
+
+/*
+ * SSI device Chip Select (CS0) is muxed with GPIO53
+ * Using this we can realy do SSI bus claim/release
+ * GPIO53 is set through mmPSOC_GPIO3 where each
+ * mmPSOC_GPIO serve 16 GPIOs
+ * Note: CS0 is active low
+ */
+static void spi_ssi_cs0_init(void)
+{
+	unsigned int reg, mask = BIT_MASK(53 % 16);
+
+	reg  = readl(mmPSOC_GPIO3_DATAOUT);
+	reg  &= ~mask;
+	writel(reg,  mmPSOC_GPIO3_DATAOUT);
+
+	reg = readl(mmPSOC_GPIO3_OUTENSET);
+	reg |=  mask;
+	writel(reg, mmPSOC_GPIO3_OUTENSET);
+}
+
+static void spi_claim_bus(void)
+{
+	writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_53);
+}
+
+static void spi_release_bus(void)
+{
+	writel(0, mmPSOC_GLOBAL_CONF_PAD_SEL_53);
+}
+
+static inline void spi_dev_update_frame_size(unsigned int len)
+{
+	writel(0, mmPSOC_SPI_SSIENR);
+	writel(frame_size_bits((len * 8) - 1), mmPSOC_SPI_CTRLR0);
+	writel(1, mmPSOC_SPI_SSIENR);
+}
+
+static inline int spi_fifo_is_empty(unsigned long level_reg)
+{
+	return !readl(level_reg);
+}
+
+static void spi_dev_dword_cmd(unsigned int cmd, unsigned int *val)
+{
+	unsigned int tmp;
+
+	while (!spi_fifo_is_empty(mmPSOC_SPI_TXFLR))
+		;
+	writel(cmd, mmPSOC_SPI_DR0);
+
+	while (spi_fifo_is_empty(mmPSOC_SPI_RXFLR))
+		;
+	tmp = readl(mmPSOC_SPI_DR0);
+
+	if (val)
+		*val = tmp;
+}
+
+static void spi_special_cmd(unsigned int cmd, unsigned char *val)
+{
+	unsigned char tmp;
+
+	spi_dev_update_frame_size(sizeof(tmp));
+
+	while (!spi_fifo_is_empty(mmPSOC_SPI_TXFLR))
+		;
+	writeb(cmd, mmPSOC_SPI_DR0);
+
+	while (spi_fifo_is_empty(mmPSOC_SPI_RXFLR))
+		;
+	tmp = readb(mmPSOC_SPI_DR0);
+
+	if (val)
+		*val = tmp;
+}
+
+/* Hold chip select (CS) during transaction */
+static void spi_char_cmd_csel(unsigned char cmd, unsigned char *val)
+{
+	spi_claim_bus();
+
+	spi_special_cmd(cmd, NULL);
+	if (val)
+		spi_special_cmd(0, val);
+
+	spi_release_bus();
+}
+
+static void spi_special_cmd_csel(unsigned int cmd, unsigned char *val,
+								size_t size)
+{
+	int i;
+
+	spi_claim_bus();
+
+	spi_dev_update_frame_size(sizeof(*val));
+
+	while (!spi_fifo_is_empty(mmPSOC_SPI_TXFLR))
+		;
+	writeb(cmd, mmPSOC_SPI_DR0);
+	for (i = 0; i < size; i++) {
+		while (!spi_fifo_is_empty(mmPSOC_SPI_TXFLR))
+			;
+		writeb(val[i], mmPSOC_SPI_DR0);
+	}
+
+	while (spi_fifo_is_empty(mmPSOC_SPI_RXFLR))
+		;
+	readb(mmPSOC_SPI_DR0);
+	for (i = 0; i < size; i++) {
+		while (spi_fifo_is_empty(mmPSOC_SPI_RXFLR))
+			;
+		readb(mmPSOC_SPI_DR0);
+	}
+
+	spi_release_bus();
+}
+
+static void spi_common_write(unsigned int cmd, unsigned char *buf, size_t size)
+{
+	unsigned char sr;
+
+	spi_char_cmd_csel(CMD_WRITE_ENABLE, NULL);
+	spi_special_cmd_csel(cmd, buf, size);
+	do
+		spi_char_cmd_csel(CMD_READ_STATUS, &sr);
+	while (sr & READ_STATUS_WIP);
+	spi_char_cmd_csel(CMD_WRITE_DISABLE, NULL);
+}
+
+static unsigned char spi_prot(void)
+{
+	unsigned char sr, cr, data[2];
+
+	spi_char_cmd_csel(CMD_READ_CONF, &cr);
+	spi_char_cmd_csel(CMD_READ_STATUS, &sr);
+	sr |= PROT_MASK;
+	data[0] = sr;
+	data[1] = cr;
+	spi_common_write(CMD_WRITE_STATUS, data, sizeof(data));
+	return sr;
+}
+
+static void spi_read_spl(unsigned int offset)
+{
+	void *dst = (void *)CONFIG_SPL_TEXT_BASE;
+	unsigned int cmd = (CMD_READ << 24) | offset;
+	int i;
+
+	spi_claim_bus();
+	spi_dev_update_frame_size(sizeof(cmd));
+	spi_dev_dword_cmd(cmd, NULL);
+	for (i = 0; i < SPL_SIZE; i += sizeof(unsigned int))
+		spi_dev_dword_cmd(0, dst + i);
+	spi_dev_dword_cmd(0, NULL);
+	spi_release_bus();
+}
+
+static void spi_init(void)
+{
+	spi_ssi_cs0_init();
+	writel(0x00000000, mmPSOC_SPI_SSIENR);
+	writel(0x00000002, mmPSOC_SPI_BAUDR);	/* Min divisor */
+	writel(0x00000000, mmPSOC_SPI_RXFTLR);
+	writel(0x00000000, mmPSOC_SPI_TXFTLR);
+	writel(0x0000003F, mmPSOC_SPI_IMR);	/* Disable Interrupts */
+	writel(0x00000001, mmPSOC_SPI_SER);
+	writel(0x00000001, mmPSOC_SPI_SSIENR);
+}
+
+void spi_copy_spl(unsigned int spl_offset)
+{
+	unsigned char sr;
+
+	spi_init();
+	spi_read_spl(spl_offset);
+	sr = spi_prot();
+	preboot_puts("SPL copying from flash is completed\n");
+	if ((sr & PROT_MASK) == PROT_MASK)
+		preboot_puts("Flash may be protected, depend on WP# signal\n");
+	else
+		preboot_puts("Flash is not protected\n");
+
+}
