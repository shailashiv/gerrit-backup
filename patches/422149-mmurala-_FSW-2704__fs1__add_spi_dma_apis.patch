@@ -0,0 +1,112 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2024 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <boot_rom.h>
+#include <dev_dma.h>
+#include <parc_global_conf_masks.h>
+#include <status.h>
+#include "dma.h"
+
+enum dma_dest_type boot_rom_get_dma_dest_type(uint64_t addr)
+{
+	/* TODO: Add checks for all offsets in FW MEM */
+	if (addr >= HL_FW_SRAM_FULL_BASE &&
+	    addr < (HL_FW_SRAM_FULL_BASE + HL_FW_SRAM_SIZE))
+		return DMA_DEST_SRAM;
+
+	/* */
+	return DMA_DEST_HBW;
+}
+
+int boot_rom_process_dma_err(int err, enum boot_rom_progress dma_sts_base)
+{
+	if (err != DMA_SUCCESS) {
+		if (err == DMA_INVALID_CRC_ERROR)
+			boot_rom_status_update_bringup(dma_sts_base, PROGRESS_DMA_CRC_FAILED);
+		else if (err == DMA_UNALIGNED_DEST_ADDR)
+			boot_rom_status_update_bringup(dma_sts_base, PROGRESS_DMA_UNALIGNED_DEST);
+		else if (err == DMA_INVALID_IMG_SIZE)
+			boot_rom_status_update_bringup(dma_sts_base, PROGRESS_DMA_INVALID_IMG_SIZE);
+		else if (err == DMA_UNALIGNED_IMG_SIZE)
+			boot_rom_status_update_bringup(dma_sts_base,
+						       PROGRESS_DMA_UNALIGNED_IMG_SIZE);
+		else if (err == DMA_INVALID_FLASH_OFFSET)
+			boot_rom_status_update_bringup(dma_sts_base,
+						       PROGRESS_DMA_INVALID_FLASH_OFFSET);
+		else
+			boot_rom_status_update_bringup(dma_sts_base, PROGRESS_DMA_ERROR);
+		return 1;
+	}
+
+	return 0;
+}
+
+enum dma_error boot_rom_spi_dma(uint32_t image_size, uint32_t flash_offset,
+				uint64_t dest_addr, bool skip_crc_check,
+				bool manual_crc, uint32_t expected_crc)
+{
+	enum dma_dest_type dest_type;
+	uint32_t copy_size, dma_size, dma_chunks;
+	uint8_t i, restart_crc = 1, mask_crc = 0;
+	uint32_t max_dma_size = MAX_DMA_SIZE_CRC + CRC32_SIZE;
+	uint32_t max_dma_chunk_size = MAX_DMA_SIZE_CRC;
+	uint32_t min_dma_size = MIN_DMA_SIZE_CRC;
+	uint32_t crc_sz_per_chunk = CRC32_SIZE;
+
+	dest_type = boot_rom_get_dma_dest_type(dest_addr);
+
+	if (dest_type >= DMA_DEST_MAX)
+		return DMA_INVALID_DEST_TYPE;
+
+	if (dest_addr % ADDR_SIZE_ALIGNMENT)
+		return DMA_UNALIGNED_DEST_ADDR;
+
+	if (manual_crc) {
+		mask_crc = 1;
+		max_dma_chunk_size = MAX_DMA_SIZE_NO_CRC;
+		max_dma_size = MAX_DMA_SIZE_NO_CRC;
+		min_dma_size = MIN_DMA_SIZE_NO_CRC;
+		crc_sz_per_chunk = 0;
+	}
+
+	if (image_size < min_dma_size)
+		return DMA_INVALID_IMG_SIZE;
+
+	if ((flash_offset + image_size) > HL_FLASH_SIZE)
+		return DMA_INVALID_FLASH_OFFSET;
+
+	dma_chunks = image_size / max_dma_size;
+	if (image_size % max_dma_size)
+		dma_chunks++;
+
+	if ((image_size - (crc_sz_per_chunk * dma_chunks)) % ADDR_SIZE_ALIGNMENT)
+		return DMA_UNALIGNED_IMG_SIZE;
+
+	copy_size = image_size;
+
+	for (i = 0; i < dma_chunks; i++) {
+		dma_size = copy_size > max_dma_size ? max_dma_size : copy_size;
+		dma_copy_image_internal(dma_size, (flash_offset + (OFFSET_64KB * i)),
+					(dest_addr + (max_dma_chunk_size * i)), dest_type,
+					restart_crc, mask_crc);
+
+		if ((!skip_crc_check) &&
+		    (dma_wait_finish() == PARC_GLOBAL_CONF_SPI_DMA_STATUS_ERROR_M))
+			return DMA_INVALID_CRC_ERROR;
+
+		/* After first chunk restart crc calculation */
+		if (manual_crc)
+			restart_crc = 0;
+
+		copy_size -= dma_size;
+	}
+
+	if (manual_crc && (!skip_crc_check))
+		return dma_crc_check(expected_crc);
+
+	return DMA_SUCCESS;
+}
