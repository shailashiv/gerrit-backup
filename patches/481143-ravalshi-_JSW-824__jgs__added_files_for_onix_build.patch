From 2ede92fbe4ad523334bea6f2f0418f004860b68c Mon Sep 17 00:00:00 2001
From: Shivani Raval <sraval@habana.ai>
Date: Wed, 04 Jun 2025 19:39:33 +0300
Subject: [PATCH] [JSW-824] jgs: added files for onix build

Added board configurations and device tree files for
JGS onix build.

Change-Id: I73e43724036f6141f635dc82a4112dd58afa620d
Signed-off-by: Shivani Raval <sraval@habana.ai>
---

diff --git a/boards/intel/jgs/CMakeLists.txt b/boards/intel/jgs/CMakeLists.txt
index bc5027a..5ad5f81 100644
--- a/boards/intel/jgs/CMakeLists.txt
+++ b/boards/intel/jgs/CMakeLists.txt
@@ -3,8 +3,12 @@
 
 # TODO: use pinctrl driver for pinmux
 zephyr_sources_ifdef(CONFIG_BOARD_JGS_PREBOOT_ASIC pinmux_common.c)
+zephyr_sources_ifdef(CONFIG_BOARD_JGS_PREBOOT_ONIX pinmux_common.c)
 
 zephyr_sources_ifdef(CONFIG_BOARD_JGS_RST_ASIC pinmux_common.c)
+zephyr_sources_ifdef(CONFIG_BOARD_JGS_RST_ONIX pinmux_common.c)
 
 zephyr_sources_ifdef(CONFIG_BOARD_JGS_MGMT_ASIC pinmux_common.c)
+zephyr_sources_ifdef(CONFIG_BOARD_JGS_MGMT_ONIX pinmux_common.c)
+
 
diff --git a/boards/intel/jgs/Kconfig.jgs_mgmt_onix b/boards/intel/jgs/Kconfig.jgs_mgmt_onix
