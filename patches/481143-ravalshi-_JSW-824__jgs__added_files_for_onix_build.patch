diff --git a/boards/intel/jgs/jgs_preboot_onix_defconfig b/boards/intel/jgs/jgs_preboot_onix_defconfig
new file mode 100644
index 0000000..bfd9c67
--- /dev/null
+++ b/boards/intel/jgs/jgs_preboot_onix_defconfig
@@ -0,0 +1,39 @@
+# SPDX-License-Identifier: Apache-2.0
+
+CONFIG_CPU_ARCHS_NO_HW_ATOMIC=y
+CONFIG_COMMON_LIBC_MALLOC_ARENA_SIZE=2048
+CONFIG_BUILD_OUTPUT_BIN=y
+CONFIG_MAIN_STACK_SIZE=5120
+CONFIG_PRINTK=y
+CONFIG_LOG=y
+CONFIG_LOG_MODE_MINIMAL=y
+CONFIG_LOG_MAX_LEVEL=4
+CONFIG_CONSOLE=y
+CONFIG_SERIAL=y
+CONFIG_UART_CONSOLE=y
+CONFIG_MBEDTLS=y
+CONFIG_MBEDTLS_BUILTIN=y
+CONFIG_MBEDTLS_SHA384=y
+CONFIG_LIBFDT=y
+CONFIG_LIBBOOTINFO=y
+# boot info addr is spsram base
+CONFIG_BOOTINFO_ADDR=0x78a00000
+CONFIG_BOOTINFO_SIZE=0x8000
+CONFIG_LIBSOC_INIT=y
+CONFIG_HW_STACK_PROTECTION=y
+CONFIG_LINKER_ORPHAN_SECTION_PLACE=y
+CONFIG_FAULT_THREAD_DUMP=y
+CONFIG_HEAP_MEM_POOL_SIZE=3072
+CONFIG_MINIMAL_LIBC_OPTIMIZE_STRING_FOR_SIZE=n
+CONFIG_BOOT_IF_PSEUDO_RO_TIMER=y
+CONFIG_HL_EFUSE=y
+CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=35000000
+CONFIG_SYS_CLOCK_TICKS_PER_SEC=10000
+CONFIG_EMPTY_WEAK_FUNCTIONS=y
+CONFIG_MAIN_THREAD_PRIORITY=4
+CONFIG_ARCV2_INTERRUPT_UNIT=y
+CONFIG_ARCV2_TIMER=y
+CONFIG_POLL=y
+CONFIG_THREAD_NAME=y
+CONFIG_XIP=n
+CONFIG_CRC=y
diff --git a/boards/intel/jgs/jgs_rst_onix.dts b/boards/intel/jgs/jgs_rst_onix.dts
new file mode 100644
index 0000000..dba498e
--- /dev/null
+++ b/boards/intel/jgs/jgs_rst_onix.dts
@@ -0,0 +1,29 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2024 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+/dts-v1/;
+
+#include <jgs_rst.dtsi>
+
+/ {
+	model = "jgs_rst";
+	compatible = "intel,jgs_rst";
+
+	chosen {
+		zephyr,console = &uart0;
+		zephyr,shell-uart = &uart0;
+	};
+};
+
+&refclk {
+	clock-frequency = <35000000>;
+};
+
+&uart0 {
+	current-speed = <57600>;
+	status = "okay";
+};
diff --git a/boards/intel/jgs/jgs_rst_onix_defconfig b/boards/intel/jgs/jgs_rst_onix_defconfig
