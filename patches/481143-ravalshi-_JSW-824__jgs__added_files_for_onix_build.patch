diff --git a/boards/intel/jgs/jgs_mgmt_onix.dts b/boards/intel/jgs/jgs_mgmt_onix.dts
new file mode 100644
index 0000000..21fbff9
--- /dev/null
+++ b/boards/intel/jgs/jgs_mgmt_onix.dts
@@ -0,0 +1,19 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2024 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+/dts-v1/;
+
+#include <jgs_io_mgmt.dtsi>
+
+&refclk {
+	clock-frequency = <35000000>;
+};
+
+&uart0 {
+	current-speed = <57600>;
+	status = "okay";
+};
diff --git a/boards/intel/jgs/jgs_mgmt_onix_defconfig b/boards/intel/jgs/jgs_mgmt_onix_defconfig
new file mode 100644
index 0000000..bb49816
--- /dev/null
+++ b/boards/intel/jgs/jgs_mgmt_onix_defconfig
@@ -0,0 +1,19 @@
+# SPDX-License-Identifier: Apache-2.0
+
+CONFIG_CPU_ARCHS_NO_HW_ATOMIC=y
+#CONFIG_COMMON_LIBC_MALLOC_ARENA_SIZE=2048
+CONFIG_BUILD_OUTPUT_BIN=y
+CONFIG_MAIN_STACK_SIZE=5120
+CONFIG_PRINTK=y
+CONFIG_LOG=y
+CONFIG_LOG_MODE_MINIMAL=y
+CONFIG_LOG_MAX_LEVEL=4
+CONFIG_CONSOLE=y
+CONFIG_SERIAL=y
+CONFIG_UART_CONSOLE=y
+CONFIG_HW_STACK_PROTECTION=y
+CONFIG_EMPTY_WEAK_FUNCTIONS=y
+CONFIG_LINKER_ORPHAN_SECTION_PLACE=y
+CONFIG_XIP=n
+CONFIG_HEAP_MEM_POOL_SIZE=4096
+CONFIG_HL_EFUSE=y
diff --git a/boards/intel/jgs/jgs_preboot_onix.dts b/boards/intel/jgs/jgs_preboot_onix.dts
new file mode 100644
index 0000000..4d44f27
--- /dev/null
+++ b/boards/intel/jgs/jgs_preboot_onix.dts
@@ -0,0 +1,23 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2023 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+/dts-v1/;
+
+#include <jgs_preboot.dtsi>
+
+/ {
+	model = "jgs_preboot_d1";
+};
+
+&refclk {
+	clock-frequency = <35000000>;
+};
+
+&uart0 {
+	current-speed = <57600>;
+	status = "okay";
