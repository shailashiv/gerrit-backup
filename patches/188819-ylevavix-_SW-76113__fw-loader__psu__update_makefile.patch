From d4a7ffd05e2a5f6e74f8420d272b5495f9d9f04b Mon Sep 17 00:00:00 2001
From: Yehuda Levavi <yehuda.levavi@tandemg.com>
Date: Mon, 14 Mar 2022 10:49:47 +0200
Subject: [PATCH] [SW-76113] fw-loader: psu: update makefile

Update fw-loader standalone Makefile to include psu sources.

Signed-off-by: Yehuda Levavi <yehuda.levavi@tandemg.com>
Change-Id: Ib0a67f1e6645baf58317dddf05672bdf2dcea726
---

diff --git a/package/hl-fw-loader/Makefile b/package/hl-fw-loader/Makefile
index d562845..f7bbc34 100644
--- a/package/hl-fw-loader/Makefile
+++ b/package/hl-fw-loader/Makefile
@@ -15,6 +15,7 @@
 INCLUDE += -I ./src/platform
 INCLUDE += -I ./src/platform/bmc
 INCLUDE += -I ./src/platform/bmc/cpld
+INCLUDE += -I ./src/platform/bmc/psu
 INCLUDE += -I ./src/transport
 INCLUDE += -I ${HABANA_SOFTWARE_STACK}/embedded/hls-utils/hls-inventory/include
 
@@ -25,6 +26,7 @@
 SRC += $(wildcard src/platform/*.cpp)
 SRC += $(wildcard src/platform/bmc/*.cpp)
 SRC += $(wildcard src/platform/bmc/cpld/*.cpp)
+SRC += $(wildcard src/platform/bmc/psu/*.cpp)
 SRC += $(wildcard src/transport/*.cpp)
 
 VERSION_FILE := "./src/version-autogenerated.h"
