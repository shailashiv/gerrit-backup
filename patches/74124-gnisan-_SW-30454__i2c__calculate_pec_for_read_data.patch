index 6a3af95..a5ebb84 100644
--- a/common/module_i2c_slave.h
+++ b/common/module_i2c_slave.h
@@ -28,4 +28,9 @@
 bool i2cslave_is_reset_dev(void);
 void i2cslave_reset_dev(void);
 
+extern u8 i2cslave_pec;
+
+void i2cslave_pec_init(void);
+void i2cslave_pec_digest(u8 val);
+
 #endif /* _MODULE_I2C_SLAVE_H_ */
diff --git a/include/crc8.h b/include/crc8.h
new file mode 100644
index 0000000..e6d9446
--- /dev/null
+++ b/include/crc8.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Copyright (C) 2017-2020 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#ifndef _CRC8_H_
+#define _CRC8_H_
+
+#define CRC8_TABLE_SIZE		256
+
+void crc8_populate_msb(u8 table[CRC8_TABLE_SIZE], u8 polynomial);
+u8 crc8(const u8 table[CRC8_TABLE_SIZE], u8 *pdata, size_t nbytes, u8 crc);
+
+#endif
diff --git a/preboot/crc8.c b/preboot/crc8.c
new file mode 100644
index 0000000..ffcab61
--- /dev/null
+++ b/preboot/crc8.c
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2017-2020 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <preboot.h>
+#include <crc8.h>
+
+/* This code was copied from from linux/lib/crc8.c */
+
+/**
+ * crc8_populate_msb - fill crc table for given polynomial in reverse bit order.
+ *
+ * @table:	table to be filled.
+ * @polynomial:	polynomial for which table is to be filled.
+ */
+void crc8_populate_msb(u8 table[CRC8_TABLE_SIZE], u8 polynomial)
+{
+	int i, j;
+	const u8 msbit = 0x80;
+	u8 t = msbit;
+
+	table[0] = 0;
+
+	for (i = 1; i < CRC8_TABLE_SIZE; i *= 2) {
+		t = (t << 1) ^ (t & msbit ? polynomial : 0);
+		for (j = 0; j < i; j++)
+			table[i+j] = table[j] ^ t;
+	}
+}
+
+/**
+ * crc8 - calculate a crc8 over the given input data.
+ *
+ * @table: crc table used for calculation.
+ * @pdata: pointer to data buffer.
+ * @nbytes: number of bytes in data buffer.
+ * @crc: previous returned crc8 value.
+ */
+u8 crc8(const u8 table[CRC8_TABLE_SIZE], u8 *pdata, size_t nbytes, u8 crc)
+{
+	/* loop over the buffer data */
+	while (nbytes-- > 0)
+		crc = table[(crc ^ *pdata++) & 0xff];
+
+	return crc;
+}
diff --git a/preboot/module_i2c_slave.c b/preboot/module_i2c_slave.c
index d7f6ca8..8eb3595 100644
--- a/preboot/module_i2c_slave.c
+++ b/preboot/module_i2c_slave.c
@@ -10,11 +10,15 @@
 #include <hl_i2c_slave_events.h>
 #include <hl_i2c_indirect.h>
 #include <boot_if.h>
+#include <crc8.h>
 
 #include "thermal.h"
 #include "module_i2c_slave.h"
 #include "i2cslave_indirect.h"
 #include "fit.h"
+
+u8 i2cslave_pec;
+static u8 pec_table[CRC8_TABLE_SIZE];
 
 static bool is_fit_checked;
 
@@ -81,8 +85,10 @@
 		ret = i2csi_ctrl_handle_status(cmd);
 		break;
 	default:
-		/* NA */
-		ret = 0;
+		if (HL_I2C_EVENT_IS_PEC(cmd))
+			ret = i2cslave_pec;
+		else
+			ret = 0;
 		break;
 	}
 
@@ -152,3 +158,13 @@
 	cpu_boot_sts_set(CPU_BOOT_STATUS_IN_WFE);
 	hl_dev_reset();	/* should not return */
 }
+
+void i2cslave_pec_init(void)
+{
+	crc8_populate_msb(pec_table, HL_I2C_CRC8_POLYNOMIAL);
+}
+
+void i2cslave_pec_digest(u8 val)
+{
+	i2cslave_pec = crc8(pec_table, &val, 1, i2cslave_pec);
+}
