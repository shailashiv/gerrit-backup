index 3d0fcd0..e14e1b1 100644
--- a/arch/gaudi3/arc/Makefile
+++ b/arch/gaudi3/arc/Makefile
@@ -6,3 +6,4 @@
 ARCBOOT_COMMON_SRCS_C += $(shell ls $(HL_DEV_ARCH)/slave.c)
 ARCBOOT_COMMON_SRCS_C += $(shell ls $(HL_DEV_ARCH)/recovery.c)
 ARCBOOT_COMMON_SRCS_C += $(shell ls $(HL_DEV_ARCH)/dma.c)
+ARCBOOT_COMMON_SRCS_C += $(shell ls $(HL_DEV_ARCH)/tpm2.c)
\ No newline at end of file
diff --git a/arch/gaudi3/arc/common.c b/arch/gaudi3/arc/common.c
index d728833..e79afed 100644
--- a/arch/gaudi3/arc/common.c
+++ b/arch/gaudi3/arc/common.c
@@ -789,3 +789,22 @@
 	if (override == 0)
 		execute_recovery();
 }
+
+static void arcboot_rom_set_spi_tpm_cs_gpio(bool cs_en)
+{
+	uint32_t reg = regmap_readl(mmD0_PSOC_GPIO1_DATAOUT);
+	uint32_t mask = BIT(TPM_CS_GPIO_PIN % GPIOS_PER_BANK);
+
+	/* CS is active low */
+	if (cs_en)
+		reg &= ~mask;
+	else
+		reg |= mask;
+
+	regmap_writel(reg, mmD0_PSOC_GPIO1_DATAOUT);
+}
+
+void external_cs_manage(bool cs_en)
+{
+	arcboot_rom_set_spi_tpm_cs_gpio(cs_en);
+}
