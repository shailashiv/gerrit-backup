From 17ebab8946fddd6fe2030642c262bf8c963826d6 Mon Sep 17 00:00:00 2001
From: Murala S Swamy <ssmurala@habana.ai>
Date: Sat, 31 May 2025 07:46:52 +0300
Subject: [PATCH] [JSW-808] jgs: enable palad build

Added support for palad build

Change-Id: Iaf4a9a5ed0b7c27c9c185e7e11b1e7321d11beb1
---

diff --git a/board/habanalabs/jgs/jgs-post-image-spi-arc_global.sh b/board/habanalabs/jgs/jgs-post-image-spi-arc_global.sh
index b560e3c..f76cb0d 100755
--- a/board/habanalabs/jgs/jgs-post-image-spi-arc_global.sh
+++ b/board/habanalabs/jgs/jgs-post-image-spi-arc_global.sh
@@ -419,25 +419,26 @@
 		mv boot_rom_rom_ecc.hex ${HEXS_DIR}
 
 		# convert compute die bootrom to pallad hex images
-		${SCRIPTS_DIR}/palad/convert_app_to_compute_bootrom_hex.sh ${ARCBOOT_COMP_BINFILE} fs1-${HL_TARGET}-bootrom_comp
-		mv boot_rom_comp_*.hex ${HEXS_DIR}
-		mv jgs-${HL_TARGET}-bootrom_comp_*_ecc.hex ${HEXS_DIR}
+		# ${SCRIPTS_DIR}/palad/convert_app_to_compute_bootrom_hex.sh ${ARCBOOT_COMP_BINFILE} jgs-${HL_TARGET}-bootrom_comp
+		# mv jgs-${HL_TARGET}-bootrom_comp_*_ecc.hex ${HEXS_DIR}
 
-		# convert io die bootloader to pallad hex image
+		# convert io die palad_bootloader to pallad hex image
 		${SCRIPTS_DIR}/palad/convert_app_to_io_bootrom_hex.sh ${BOOTLOADER_BINFILE}
+		mv palad_bloader_rom_ecc.hex ${HEXS_DIR}
 
-		# convert compute die bootloader to pallad hex images
-		${SCRIPTS_DIR}/palad/convert_app_to_compute_bootrom_hex.sh ${COMP_BOOTLOADER_BINFILE} fs1-${HL_TARGET}-bloader_comp
+		# convert compute die palad_bootloader to pallad hex images
+		${SCRIPTS_DIR}/palad/convert_app_to_compute_bootrom_hex.sh ${COMP_BOOTLOADER_BINFILE} jgs-${HL_TARGET}-bloader_comp
 		mv jgs-${HL_TARGET}-bloader*.hex ${HEXS_DIR}
 
 		# convert preboot application to pallad hex images
 		${SCRIPTS_DIR}/palad/convert_app_to_ccm_hex.sh preboot.bin
-		mv iccm0_*.hex ${HEXS_DIR}
+		mv iccm0_0.hex ${HEXS_DIR}/preboot_iccm0_0.hex
+		mv iccm0_1.hex ${HEXS_DIR}/preboot_iccm0_1.hex
 
 		# convert preboot comp application to palad hex images
-		${SCRIPTS_DIR}/palad/convert_app_to_ccm_hex.sh preboot_compute.bin
-		mv iccm0_0.hex ${HEXS_DIR}/comp_iccm0_0.hex
-		mv iccm0_1.hex ${HEXS_DIR}/comp_iccm0_1.hex
+		# ${SCRIPTS_DIR}/palad/convert_app_to_ccm_hex.sh preboot_compute.bin
+		# mv iccm0_0.hex ${HEXS_DIR}/preboot_comp_iccm0_0.hex
+		# mv iccm0_1.hex ${HEXS_DIR}/preboot_comp_iccm0_1.hex
 	fi
 
 	if [ -f "${KEY_BASE}/spi-flash-layout-validator.sh" ]; then
diff --git a/configs/jgs_palad_defconfig b/configs/jgs_palad_defconfig
new file mode 100644
index 0000000..4074539
--- /dev/null
+++ b/configs/jgs_palad_defconfig
@@ -0,0 +1,27 @@
+BR2_USE_MMU=y
+BR2_arcle=y
+BR2_archs4x=y
+BR2_SVN="svn"
+BR2_DL_DIR="$(BR2_EXTERNAL_HABANALABS_PATH)/dl"
+BR2_SHARED_STATIC_LIBS=y
+BR2_PACKAGE_OVERRIDE_FILE="$(BR2_EXTERNAL_HABANALABS_PATH)/board/habanalabs/jgs/jgs-local.mk"
+BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_HABANALABS_PATH)/board/habanalabs/common/patches"
+BR2_TOOLCHAIN_EXTERNAL=y
+BR2_TARGET_GENERIC_HOSTNAME=""
+BR2_TARGET_GENERIC_ISSUE=""
+BR2_INIT_NONE=y
+BR2_SYSTEM_BIN_SH_NONE=y
+# BR2_TARGET_GENERIC_GETTY is not set
+BR2_PACKAGE_PREBOOT=y
+BR2_PIC_PIE=n
+BR2_SSP_NONE=y
+BR2_RELRO_NONE=y
+BR2_FORTIFY_SOURCE_NONE=y
+BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_HABANALABS_PATH)/board/habanalabs/jgs/jgs-post-image-fit-arc.sh $(BR2_EXTERNAL_HABANALABS_PATH)/board/habanalabs/jgs/jgs-post-image-spi-arc_global.sh $(BR2_EXTERNAL_HABANALABS_PATH)/board/habanalabs/jgs/post-image-agents.sh"
+BR2_PACKAGE_BAREMETAL=y
+BR2_PACKAGE_HOST_UBOOT_TOOLS=y
+BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT=y
+BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SIGNATURE_SUPPORT=y
+BR2_PACKAGE_ARCBOOT=y
+BR2_PACKAGE_MGMT=y
+BR2_PACKAGE_RESET=y
