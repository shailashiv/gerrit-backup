From 2d3fa44f1df4b8aabef263c2574f6f3146cff440 Mon Sep 17 00:00:00 2001
From: Guy Nisan <gnisan@habana.ai>
Date: Wed, 02 Dec 2020 20:16:56 +0200
Subject: [PATCH] [SW-26048] gaudi: security: remove fakes

Remove gaudi fake OTP and fake eFuse

Change-Id: I837f2e42edbea5e15f0c4e7d777b3cfb6fe0ddab
Signed-off-by: Guy Nisan <gnisan@habana.ai>
---

diff --git a/gaudi/security.c b/gaudi/security.c
index ebfa699..8d2cec8 100644
--- a/gaudi/security.c
+++ b/gaudi/security.c
@@ -109,14 +109,8 @@
 	struct hl_sec_otp *otp = &preboot_security_otp_cache.otp;
 
 	if (preboot_security_otp_cache.is_invalid) {
-#ifdef OTP_SUPPORT
 		spi_copy_otp(otp, OTP_SECURITY_OFFSET,
 			     sizeof(struct hl_sec_otp));
-#else
-#define FAKE_OTP_OFFSET	(2 * 1024 * 1024)
-		spi_copy(otp, FAKE_OTP_OFFSET, sizeof(struct hl_sec_otp),
-			 "FAKE OTP");
-#endif
 
 		if (otp->magic_number != OTP_SECURITY_MAGIC)
 			return NULL;
@@ -127,7 +121,6 @@
 	return otp;
 }
 
-#ifdef FUSE_SUPPORT
 static const struct hl_sec_efuse *preboot_security_get_fuse(void)
 {
 	struct hl_sec_efuse *fuse;
@@ -152,46 +145,6 @@
 {
 	/* Do nothing for real eFuse */
 }
-
-#else /* FUSE_SUPPORT */
-
-#define FAKE_FUSE_OFFSET ((2 * 1024 * 1024) + (64 * 1024))
-static const struct hl_sec_efuse *preboot_security_get_fuse(void)
-{
-	struct hl_sec_efuse *fuse;
-	u32 *val;
-	int i;
-
-	if (preboot_security_fuse_cache.is_invalid) {
-		fuse = &preboot_security_fuse_cache.fuse;
-
-		spi_copy(fuse, FAKE_FUSE_OFFSET +
-			 (EFUSE_SECURITY_OFFSET * sizeof(*val)), sizeof(*fuse),
-			 "FAKE FUSE");
-
-		/* Fake fuse data is stored in negative logic */
-		for (i = 0; i < ARRAY_SIZE(fuse->data); i++) {
-			val = &fuse->data[i];
-			*val = ~(*val);
-		}
-
-		preboot_security_fuse_cache.is_invalid = false;
-	}
-
-	return &preboot_security_fuse_cache.fuse;
-}
-
-static void preboot_security_sp_sram_write_efuse(void)
-{
-	const struct hl_sec_efuse *efuse;
-
-	efuse = preboot_security_get_fuse();
-	if (!efuse)
-		return;
-
-	boot_info_set(HL_BOOT_INFO_SECURITY_FUSE, efuse, sizeof(*efuse));
-}
-#endif /* FUSE_SUPPORT */
 
 static void preboot_security_sp_sram_write_otp(void)
 {
