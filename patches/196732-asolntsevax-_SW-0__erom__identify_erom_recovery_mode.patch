From bee5ef5350345a5f37265eb9f96a0bddae7f79f2 Mon Sep 17 00:00:00 2001
From: Alona Solntseva <alona.solntseva@tandemg.com>
Date: Tue, 05 Apr 2022 16:16:11 +0300
Subject: [PATCH] [SW-0] erom: identify erom recovery mode

Add log which identifies erom recovery mode

Signed-off-by: Alona Solntseva <alona.solntseva@tandemg.com>
Change-Id: I0284455f567357cc4a26b3d10e7cfa50f5fb3d1d
---

diff --git a/app/ext_rom/erom_recovery.c b/app/ext_rom/erom_recovery.c
index b3be286..8d1e82e 100644
--- a/app/ext_rom/erom_recovery.c
+++ b/app/ext_rom/erom_recovery.c
@@ -128,5 +128,7 @@
 
 	cpu_boot_sts_set(CPU_BOOT_STATUS_WAITING_FOR_BOOT_FIT);
 
+	preboot_puts("In recovery mode\n");
+
 	module_handle_cmds(cmd_ops, ARRAY_SIZE(cmd_ops));
 }
