From 0134d32151e8801902f07c0ddf8b7a773b9bf064 Mon Sep 17 00:00:00 2001
From: Pardha Kesapragada <pkesapragada@habana.ai>
Date: Mon, 06 Apr 2020 08:46:42 +0300
Subject: [PATCH] [SW-10909] goya2: ppboot: update pci id

This patch updates the device id of goya2
to 0x0020

Change-Id: Ie8078a1bdf63ccf75588d642af97c35512e7fdf8
Signed-off-by: Pardha Kesapragada <pkesapragada@habana.ai>
---

diff --git a/goya2/common.c b/goya2/common.c
index 60092f8..c3559c2 100644
--- a/goya2/common.c
+++ b/goya2/common.c
@@ -71,10 +71,10 @@
 	preboot_init_pcie_phy();
 
 	/* Update Vendor ID */
-	regmap_writel(0x10001DA3, mmPCIE_DBI_DEVICE_ID_VENDOR_ID_REG);
+	regmap_writel(0x00201DA3, mmPCIE_DBI_DEVICE_ID_VENDOR_ID_REG);
 
 	/* Update subsystem Vendor ID */
-	regmap_writel(0x10001DA3,
+	regmap_writel(0x00201DA3,
 		      mmPCIE_DBI_SUBSYSTEM_ID_SUBSYSTEM_VENDOR_ID_REG);
 
 	/* Disable the EQ REDO */
