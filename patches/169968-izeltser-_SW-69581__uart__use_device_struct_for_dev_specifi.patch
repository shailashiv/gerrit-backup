diff --git a/include/device.h b/include/device.h
index 46810c0..9cf3b6c 100644
--- a/include/device.h
+++ b/include/device.h
@@ -13,6 +13,15 @@
 	u32 words_per_bank;
 };
 
+struct device_uart {
+	u32 uart_data_reg;
+	u32 uart_state_reg;
+	u32 uart_ctrl_reg;
+	u32 uart_bauddiv_reg;
+};
+
 extern struct device_efuse efuse;
+extern struct device_uart uart;
 
 void device_init_efuse(void);
+void device_init_uart(void);
diff --git a/lib/common/uart.c b/lib/common/uart.c
index cf17ec9..5d43f06 100644
--- a/lib/common/uart.c
+++ b/lib/common/uart.c
@@ -6,9 +6,8 @@
  */
 #include <stddef.h>
 
-#include <psoc_uart_0_regs.h>
-
 #include <preboot.h>
+#include <device.h>
 #include <sizes.h>
 #include "uart.h"
 #include "pll.h"
@@ -18,6 +17,8 @@
 #define STR_UINT_SZ			8
 #define BITS_IN_SINGLE_CHAR		4
 #define RING_BUFF_SIZE			SZ_256
+
+struct device_uart uart;
 
 struct ring_buf_t {
 	char buf[RING_BUFF_SIZE];
@@ -60,7 +61,7 @@
 		tx_buf.tail = tail;
 
 		/* transferring data directly to HW */
-		regmap_writel(ch, mmPSOC_UART_0_DATA);
+		regmap_writel(ch, uart.uart_data_reg);
 		preboot_putc_virt_uart(ch);
 	}
 }
@@ -68,7 +69,7 @@
 void preboot_uart_rbuf_flush(void)
 {
 	while (tx_buf.head != tx_buf.tail) {
-		while (regmap_readl(mmPSOC_UART_0_STATE) & UART_SR_TXFULL)
+		while (regmap_readl(uart.uart_state_reg) & UART_SR_TXFULL)
 			;
 		preboot_uart_rbuf_pop();
 	}
@@ -98,14 +99,14 @@
 
 void preboot_uart_init(unsigned int val)
 {
-	regmap_writel(0x0, mmPSOC_UART_0_CTRL);
-	regmap_writel(val, mmPSOC_UART_0_BAUDDIV);
-	regmap_writel(0x3, mmPSOC_UART_0_CTRL);
+	regmap_writel(0x0, uart.uart_ctrl_reg);
+	regmap_writel(val, uart.uart_bauddiv_reg);
+	regmap_writel(0x3, uart.uart_ctrl_reg);
 }
 
 int preboot_uart_tstc(void)
 {
-	if (!(regmap_readl(mmPSOC_UART_0_STATE) & UART_SR_RXFULL))
+	if (!(regmap_readl(uart.uart_state_reg) & UART_SR_RXFULL))
 		return 0;
 
 	return 1;
@@ -116,12 +117,12 @@
 	if (!preboot_uart_tstc())
 		return -1;
 
-	return regmap_readl(mmPSOC_UART_0_DATA);
+	return regmap_readl(uart.uart_data_reg);
 }
 
 bool preboot_uart_tx_full(void)
 {
-	return !!(regmap_readl(mmPSOC_UART_0_STATE) & UART_SR_TXFULL);
+	return !!(regmap_readl(uart.uart_state_reg) & UART_SR_TXFULL);
 }
 
 /* timeout is 5 chars duration in usec*/
@@ -145,9 +146,9 @@
 		return;
 	}
 
-	while (regmap_readl(mmPSOC_UART_0_STATE) & UART_SR_TXFULL)
+	while (regmap_readl(uart.uart_state_reg) & UART_SR_TXFULL)
 		;
-	regmap_writel(ch, mmPSOC_UART_0_DATA);
+	regmap_writel(ch, uart.uart_data_reg);
 	preboot_putc_virt_uart(ch);
 }
 
