From 1977d717d2e7263f2a3d14e540f73d6bb8e2d559 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Thu, 20 Jan 2022 12:05:57 +0200
Subject: [PATCH] [SW-69581] uart: use device struct for dev specific data

Including device specific headers from common code is not allowed
anymore, and instead the device structures should be used.
Uart device code is refactored to use device structure.

Change-Id: Iae16d26ccc744bd2bc3d9b6397bf640ff2985464
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/app/ext_rom/erom_pcie.c b/app/ext_rom/erom_pcie.c
index 1cbaa59..705c869 100644
--- a/app/ext_rom/erom_pcie.c
+++ b/app/ext_rom/erom_pcie.c
@@ -9,9 +9,16 @@
 #include <pci.h>
 #include <pll.h>
 #include <preboot.h>
+#include <device.h>
+
+static void device_init(void)
+{
+	device_init_uart();
+}
 
 void erom_main_function(void)
 {
+	device_init();
 	/*
 	 * Note: we assume CPU frequency is not changed while CPU is running,
 	 * so the udelay init is done once before we start.
diff --git a/app/ppboot/ppboot.c b/app/ppboot/ppboot.c
index 3665b55..db39f4f 100644
--- a/app/ppboot/ppboot.c
+++ b/app/ppboot/ppboot.c
@@ -265,6 +265,7 @@
 static void device_init(void)
 {
 	device_init_efuse();
+	device_init_uart();
 }
 
 __weak void ppboot_security_init(void) {}
diff --git a/app/preboot/preboot.c b/app/preboot/preboot.c
index 4bc5b04..3ba446b 100644
--- a/app/preboot/preboot.c
+++ b/app/preboot/preboot.c
@@ -412,6 +412,7 @@
 static void device_init(void)
 {
 	device_init_efuse();
+	device_init_uart();
 }
 
 __weak void hl_set_reset_cause(uint32_t reset_cause) {}
diff --git a/app/recovery/recovery.c b/app/recovery/recovery.c
index 561e189..661f10e 100644
--- a/app/recovery/recovery.c
+++ b/app/recovery/recovery.c
@@ -7,7 +7,7 @@
 
 #include <stddef.h>
 #include <preboot.h>
-
+#include <device.h>
 #include "cmd_module.h"
 #include "pll.h"
 
@@ -24,9 +24,14 @@
 	},
 };
 
+static void device_init(void)
+{
+	device_init_uart();
+}
+
 void recovery_main(void)
 {
-
+	device_init();
 	udelay_init();
 	hl_uart_init();
 
