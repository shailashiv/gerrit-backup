From 7fcdaf7965a9e36b1a3d3fb25d3822d22c716056 Mon Sep 17 00:00:00 2001
From: Tal Yacobi <tyacobi@habana.ai>
Date: Tue, 15 Apr 2025 12:43:25 +0300
Subject: [PATCH] [SW-225904] gaudi3: pldm: create an image set for hl338

add an image set for hl338 pcie device
to all pldm packages

Change-Id: Id27e78c88360e904459ca54f9fa1efed7cd501f1
Signed-off-by: Tal Yacobi <tyacobi@habana.ai>
---

diff --git a/board/habanalabs/gaudi3/create-pldm-fwup-package-eeprom.sh b/board/habanalabs/gaudi3/create-pldm-fwup-package-eeprom.sh
index c660201..6c066ca 100755
--- a/board/habanalabs/gaudi3/create-pldm-fwup-package-eeprom.sh
+++ b/board/habanalabs/gaudi3/create-pldm-fwup-package-eeprom.sh
@@ -20,8 +20,8 @@
                              --package-release-date-time "${PACKAGE_RELEASE_DATE_TIME}" \
                              --package-version "${EEPROM_PACKAGE_VERSION}" \
                              --component-image-set-version "${EEPROM_PACKAGE_VERSION}" \
-                             --pci-device-id "${PCI_DEVICE_ID}" \
-                             --pci-subsystem-id "${PCI_SUBSYSTEM_ID}" \
+                             --pci-device-id "${PCI_DEVICE_ID}" "${PCI_DEVICE_ID_338}" \
+                             --pci-subsystem-id "${PCI_SUBSYSTEM_ID}" "${PCI_SUBSYSTEM_ID_338}" \
                              --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_FW_LOADER_1)) \
                                 "${AGENT_FW_LOADER_FIT_VERSION}" "${AGENT_FW_LOADER_FIT_VERSION_STAMP}"       \
                              --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_EEPROM))      \
diff --git a/board/habanalabs/gaudi3/create-pldm-fwup-package-main.sh b/board/habanalabs/gaudi3/create-pldm-fwup-package-main.sh
index 694c504..99187ed 100755
--- a/board/habanalabs/gaudi3/create-pldm-fwup-package-main.sh
+++ b/board/habanalabs/gaudi3/create-pldm-fwup-package-main.sh
@@ -40,8 +40,8 @@
                              --package-release-date-time "${PACKAGE_RELEASE_DATE_TIME}" \
                              --package-version "${MAIN_PACKAGE_VERSION}" \
                              --component-image-set-version "${MAIN_PACKAGE_VERSION}" \
-                             --pci-device-id "${PCI_DEVICE_ID}" \
-                             --pci-subsystem-id "${PCI_SUBSYSTEM_ID}" \
+                             --pci-device-id "${PCI_DEVICE_ID}" "${PCI_DEVICE_ID_338}" \
+                             --pci-subsystem-id "${PCI_SUBSYSTEM_ID}" "${PCI_SUBSYSTEM_ID_338}" \
                              --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_FW_LOADER_1))   \
                                 "${AGENT_FW_LOADER_FIT_VERSION}" "${AGENT_FW_LOADER_FIT_VERSION_STAMP}"         \
                              --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_SPI))           \
diff --git a/board/habanalabs/gaudi3/create-pldm-fwup-package-margin-tool.sh b/board/habanalabs/gaudi3/create-pldm-fwup-package-margin-tool.sh
index f84e0e2..9fc7c10 100755
--- a/board/habanalabs/gaudi3/create-pldm-fwup-package-margin-tool.sh
+++ b/board/habanalabs/gaudi3/create-pldm-fwup-package-margin-tool.sh
@@ -22,8 +22,8 @@
                              --package-release-date-time "${PACKAGE_RELEASE_DATE_TIME}" \
                              --package-version "${PACKAGE_VERSION}" \
                              --component-image-set-version "${PACKAGE_VERSION}" \
-                             --pci-device-id "${PCI_DEVICE_ID}" \
-                             --pci-subsystem-id "${PCI_SUBSYSTEM_ID}" \
+                             --pci-device-id "${PCI_DEVICE_ID}" "${PCI_DEVICE_ID_338}" \
+                             --pci-subsystem-id "${PCI_SUBSYSTEM_ID}" "${PCI_SUBSYSTEM_ID_338}" \
                              --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) ${COMPONENT_IDENTIFIER} "${MARGIN_TOOL_FIT_VERSION}" "${MARGIN_TOOL_FIT_VERSION_STAMP}"
 rv=$?
 if [[ ${rv} -ne 0 ]]; then
diff --git a/board/habanalabs/gaudi3/create-pldm-fwup-package-revoke-key.sh b/board/habanalabs/gaudi3/create-pldm-fwup-package-revoke-key.sh
index 6a96d0e..58f8593 100755
--- a/board/habanalabs/gaudi3/create-pldm-fwup-package-revoke-key.sh
+++ b/board/habanalabs/gaudi3/create-pldm-fwup-package-revoke-key.sh
@@ -20,8 +20,8 @@
                              --package-release-date-time "${PACKAGE_RELEASE_DATE_TIME}" \
                              --package-version "${REVOKE_KEY_PACKAGE_VERSION}" \
                              --component-image-set-version "${REVOKE_KEY_PACKAGE_VERSION}" \
-                             --pci-device-id "${PCI_DEVICE_ID}" \
-                             --pci-subsystem-id "${PCI_SUBSYSTEM_ID}" \
+                             --pci-device-id "${PCI_DEVICE_ID}" "${PCI_DEVICE_ID_338}" \
+                             --pci-subsystem-id "${PCI_SUBSYSTEM_ID}" "${PCI_SUBSYSTEM_ID_338}" \
                              --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_LOADER)) \
                                 "${AGENT_FW_LOADER_FIT_VERSION}" "${AGENT_FW_LOADER_FIT_VERSION_STAMP}"  \
                              --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_KEY_REVOKE)) \
diff --git a/board/habanalabs/gaudi3/create-pldm-fwup-package-update-svn.sh b/board/habanalabs/gaudi3/create-pldm-fwup-package-update-svn.sh
index dcf3a8f..1a11e7c 100755
--- a/board/habanalabs/gaudi3/create-pldm-fwup-package-update-svn.sh
+++ b/board/habanalabs/gaudi3/create-pldm-fwup-package-update-svn.sh
@@ -20,8 +20,8 @@
                              --package-release-date-time "${PACKAGE_RELEASE_DATE_TIME}" \
                              --package-version "${UPDATE_SVN_PACKAGE_VERSION}" \
                              --component-image-set-version "${UPDATE_SVN_PACKAGE_VERSION}" \
-                             --pci-device-id "${PCI_DEVICE_ID}" \
-                             --pci-subsystem-id "${PCI_SUBSYSTEM_ID}" \
+                             --pci-device-id "${PCI_DEVICE_ID}" "${PCI_DEVICE_ID_338}" \
+                             --pci-subsystem-id "${PCI_SUBSYSTEM_ID}" "${PCI_SUBSYSTEM_ID_338}" \
                              --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_LOADER)) \
                                 "${AGENT_FW_LOADER_FIT_VERSION}" "${AGENT_FW_LOADER_FIT_VERSION_STAMP}"  \
                              --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_SVN))    \
diff --git a/board/habanalabs/gaudi3/create-pldm-fwup-package.sh b/board/habanalabs/gaudi3/create-pldm-fwup-package.sh
index a36c0fb..37af1b6 100755
--- a/board/habanalabs/gaudi3/create-pldm-fwup-package.sh
+++ b/board/habanalabs/gaudi3/create-pldm-fwup-package.sh
@@ -10,10 +10,13 @@
 
 PACKAGE_RELEASE_DATE_TIME=$(TZ=UTC date +'%Y-%m-%d %H:%M:%S')
 
-# Device ID is 0x1060.
+# Device ID for HL325 is 0x1060.
+# Device ID for HL338 is 0x1063.
 # Must encode in little-endian byte order for PLDM
 PCI_DEVICE_ID="6010"
 PCI_SUBSYSTEM_ID="6010"
+PCI_DEVICE_ID_338="6310"
+PCI_SUBSYSTEM_ID_338="6310"
 
 function pldm_comp_class()
 {
diff --git a/scripts/pldm/hl_pldm_fwup_package_json_creator.py b/scripts/pldm/hl_pldm_fwup_package_json_creator.py
index 408e92c..0c32edf 100755
--- a/scripts/pldm/hl_pldm_fwup_package_json_creator.py
+++ b/scripts/pldm/hl_pldm_fwup_package_json_creator.py
@@ -57,7 +57,7 @@
 					},
 					{
 						"DescriptorType": PLDM_DESCRIPTOR_TYPE_PCI_DEVICE_ID,
-						"DescriptorData": args.pci_device_id,
+						"DescriptorData": args.pci_device_id[0],
 					},
 					{
 						"DescriptorType": PLDM_DESCRIPTOR_TYPE_PCI_SUBSYSTEM_VENDOR_ID,
@@ -65,7 +65,30 @@
 					},
 					{
 						"DescriptorType": PLDM_DESCRIPTOR_TYPE_PCI_SUBSYSTEM_ID,
-						"DescriptorData": args.pci_subsystem_id
+						"DescriptorData": args.pci_subsystem_id[0]
+					}
+				]
+			},
+			{
+				"DeviceUpdateOptionFlags": [],
+				"ComponentImageSetVersionString": args.component_image_set_version,
+				"ApplicableComponents": list(range(len(args.component))),
+				"Descriptors": [
+					{
+						"DescriptorType": PLDM_DESCRIPTOR_TYPE_PCI_VENDOR_ID,
+						"DescriptorData": args.pci_vendor_id,
+					},
+					{
+						"DescriptorType": PLDM_DESCRIPTOR_TYPE_PCI_DEVICE_ID,
+						"DescriptorData": args.pci_device_id[1],
+					},
+					{
+						"DescriptorType": PLDM_DESCRIPTOR_TYPE_PCI_SUBSYSTEM_VENDOR_ID,
+						"DescriptorData": args.pci_subsystem_vendor_id
+					},
+					{
+						"DescriptorType": PLDM_DESCRIPTOR_TYPE_PCI_SUBSYSTEM_ID,
+						"DescriptorData": args.pci_subsystem_id[1]
 					}
 				]
 			}
@@ -89,8 +112,8 @@
 	parser.add_argument('--package-release-date-time', type=str, required=True)
 	parser.add_argument('--package-version', type=str, required=True)
 	parser.add_argument('--component-image-set-version', type=str, required=True)
-	parser.add_argument('--pci-device-id', type=str, required=True)
-	parser.add_argument('--pci-subsystem-id', type=str, required=True)
+	parser.add_argument('--pci-device-id', nargs=2, type=str, required=True)
+	parser.add_argument('--pci-subsystem-id', nargs=2, type=str,required=True)
 	parser.add_argument('--pci-vendor-id', type=str, default=HL_PCIE_VENDOR_ID)
 	parser.add_argument('--pci-subsystem-vendor-id', type=str, default=HL_PCIE_VENDOR_SUBSYSTEM_ID)
 	parser.add_argument('--component', nargs='+', action='append', required=True, help="<class> <id> <ver> [<stamp>]")
