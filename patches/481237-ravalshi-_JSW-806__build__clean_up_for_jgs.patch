diff --git a/board/habanalabs/jgs/jgs-post-image-fit-create.sh b/board/habanalabs/jgs/jgs-post-image-fit-create.sh
new file mode 100755
index 0000000..aa2cd0d
--- /dev/null
+++ b/board/habanalabs/jgs/jgs-post-image-fit-create.sh
@@ -0,0 +1,64 @@
+#!/usr/bin/env bash
+
+set -e          # stop on any error in this script
+set -o pipefail # stop on any error in pipeline
+
+source ${BR2_EXTERNAL}/board/habanalabs/${HL_DEV}/jgs-image-utility.sh
+DEV_NAME=`echo $HL_DEV | cut -d'_' -f1`
+BOARD_BASE=${BR2_EXTERNAL}/board/habanalabs/${HL_DEV}
+MKIMAGE=${BR2_EXTERNAL}/output/${HL_DEV}/host/usr/bin/mkimage
+LZOP=${BR2_EXTERNAL}/output/${HL_DEV}/host/usr/bin/lzop
+
+# Set hl-version = "x.y.z"; inside FIT header to be used for KMD/FW compatability validation
+HL_VERSION=`cut -d- -f4 ${BR2_EXTERNAL}/output/${HL_DEV}/build/baremetal-custom/localversion-habanalabs`
+
+ZEPHYR_ITS_FILE=zephyr-${DEV_NAME}-${HL_TARGET}.its
+ZEPHYR_ITB_FILE=${ITBS_DIR}/zephyr-fit.itb
+
+# Set compression to lzo
+HL_COMPRESS=lzo
+
+source ${BOARD_BASE}/post-image-fit.sh
+source ${BOARD_BASE}/post-image-common.sh
+source ${BOARD_BASE}/post-image-exports.sh
+
+ZEPHYR_ITS_TEMPLATE=${BOARD_BASE}/jgs-zephyr.its
+
+ARC_MGMT_ICCM_EXT=${ARC_MGMT_ICCM_EXT:-iccm.bin.le}
+ARC_MGMT_DCCM_EXT=${ARC_MGMT_DCCM_EXT:-dccm.bin.le}
+
+ITS_SED_PARAMS+="s/@DEV_PREFIX@/${DEV_PREFIX}/g;"
+ITS_SED_PARAMS+="s/@HL_ARCH@/${HL_ARCH}/g;"
+ITS_SED_PARAMS+="s/@DEV_NAME@/${DEV_NAME}/g;"
+
+KEY_BASE=${BR2_EXTERNAL}/board/habanalabs/${DEV_PREFIX}/
+KEY_BASE_NAME=rsa3072
+KEY_NAME=hl_${KEY_BASE_NAME}
+
+ITS_SED_PARAMS+="s/@KEY_DTB@/${KEY_NAME}.dtb/g;"
+ITS_SED_PARAMS+="s/@KEY_EXT@/${KEY_NAME}_ext.bin.le/g;"
+
+# Replace ARC addresses
+ITS_SED_PARAMS+="s/@ARC_PID_DCCM_HI@/${ARC_PID_DCCM_HI}/g;"
+ITS_SED_PARAMS+="s/@ARC_PID_DCCM_LO@/${ARC_PID_DCCM_LO}/g;"
+ITS_SED_PARAMS+="s/@ARC_PID_ICCM_HI@/${ARC_PID_ICCM_HI}/g;"
+ITS_SED_PARAMS+="s/@ARC_PID_ICCM_LO@/${ARC_PID_ICCM_LO}/g;"
+ITS_SED_PARAMS+="s/@ARC_MGMT_DCCM_HI@/${ARC_MGMT_DCCM_HI}/g;"
+ITS_SED_PARAMS+="s/@ARC_MGMT_DCCM_LO@/${ARC_MGMT_DCCM_LO}/g;"
+ITS_SED_PARAMS+="s/@ARC_MGMT_ICCM_HI@/${ARC_MGMT_ICCM_HI}/g;"
+ITS_SED_PARAMS+="s/@ARC_MGMT_ICCM_LO@/${ARC_MGMT_ICCM_LO}/g;"
+
+# Replace ARC core IDs
+ITS_SED_PARAMS+="s/@FIT_CORE_ID_IO0_PID@/${FIT_CORE_ID_IO0_PID}/g;"
+ITS_SED_PARAMS+="s/@FIT_CORE_ID_IO0_MGMT@/${FIT_CORE_ID_IO0_MGMT}/g;"
+
+pushd ${STAGE_DIR}
+	hl_copy_keys ${BINS_DIR}
+
+	hl_copy_binaries ${BINS_DIR}
+
+	sed ${ITS_SED_PARAMS} ${ZEPHYR_ITS_TEMPLATE} > ${ZEPHYR_ITS_FILE}
+	${MKIMAGE} -D "-W no-unit_address_vs_reg" -f ${ZEPHYR_ITS_FILE} -k ${STAGE_DIR} ${ZEPHYR_ITB_FILE}
+
+	dd status=none conv=sync bs=4 if=${ZEPHYR_ITB_FILE} > ${ITBS_DIR}/${DEV_PREFIX}-boot-fit.itb
+popd
