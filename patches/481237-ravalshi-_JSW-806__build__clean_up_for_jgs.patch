-# This function parses header file spec/jgs_mem_addr_dt.h
-# and learns SPI flash layout: region names, their offsets
-# and sizes
-# Result:
-# function fills 2 associaive arrays:
-# region name to offset and region name to size
-function hl_parse_spi_flash_regions {
-	local -n spi_region_offsets=$1
-	local -n spi_region_sizes=$2
-	local platform=$3
-	local mem_addr_header_file=${BR2_EXTERNAL}/../specs/gpu/${platform}/${platform}_mem_addr_dt.h
-	local regex_offset="\#define(.*)SPI_FLASH_REGION_([A-Z_0-9]+)_OFFSET(\s+)([0-9a-fA-F]+)"
-	local regex_size="\#define(.*)SPI_FLASH_REGION_([A-Z_0-9]+)_SIZE(\s+)([0-9a-fA-F]+)"
-	local region_name
-	local region_offset
-	local region_size
-	local red=$(tput setaf 1)
-	local normal=$(tput sgr0)
-
-	if [ ! -f $mem_addr_header_file ]; then
-		printf "$red File %s not exists $normal \n" "$mem_addr_header_file"
-		exit 1
-	fi
-	IFS=$'\n'
-	for line in $(cat "$mem_addr_header_file"); do
-		if [[ $line =~ $regex_offset ]]; then
-			region_name=${BASH_REMATCH[2]}
-			region_offset=$(echo "ibase=16; ${BASH_REMATCH[4]^^}"|bc)
-			spi_region_offsets[${region_name}]=$region_offset
-		elif [[ $line =~ $regex_size ]]; then
-			region_name=${BASH_REMATCH[2]}
-			region_size=$(echo "ibase=16; ${BASH_REMATCH[4]^^}"|bc)
-			spi_region_sizes[${region_name}]=$region_size
-		fi
-	done
-}
