-static void hardware_training(struct hbm *hbm, int device)
-{
-	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-	u32 dll_inc, status;
-	int ch, err;
-
-	reduce_pll();
-
-	if (hbm->inc == 16)
-		dll_inc = 3;
-	else if (hbm->inc == 4)
-		dll_inc = 2;
-	else
-		dll_inc = 1;
-
-	/* Reset read FIFO */
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-		WREG32(base + ch * 0x1000 + 0x294, 1);
-		WREG32(base + ch * 0x1000 + 0x294, 0);
-	}
-
-	acc_training(hbm, device);
-
-	/* AWORD training */
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
-		WREG32(base + ch * 0x1000 + 0x454,
-			((hbm->hardware_training_repeat - 1) << 16) |
-				(hbm->training_delay << 8) | dll_inc);
-
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-		WREG32(base + ch * 0x1000 + 0x450, 1);
-		err = hbm_poll_timeout(base + ch * 0x1000 + 0x450, 0,
-				       GAUDI_HBM_CFG_TIMEOUT_US, &status);
-		if (err) {
-			preboot_puts("AWORD write done test failed\n");
-			goto hw_train_out;
-		}
-	}
-
-	/* Cleanup: Reset HBM + MRS setup */
-	dram_rstn(device, cke_state_high);
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
-		config_dram_state(hbm, base, ch, dram_state_training);
-
-	/* DWORD read training */
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
-		WREG32(base + ch * 0x1000 + 0x484,
-			((hbm->hardware_training_repeat - 1) << 16) |
-			(hbm->training_delay << 8) | dll_inc);
-
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-		WREG32(base + ch * 0x1000 + 0x480, 1);
-		err = hbm_poll_timeout(base + ch * 0x1000 + 0x480, 0,
-				       GAUDI_HBM_CFG_TIMEOUT_US, &status);
-		if (err) {
-			preboot_puts("DWORD read done test failed\n");
-			goto hw_train_out;
-		}
-	}
-
-	/* Cleanup: Reset HBM + MRS setup */
-	dram_rstn(device, cke_state_high);
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
-		config_dram_state(hbm, base, ch, dram_state_training);
-
-	/* DWORD write training */
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
-		WREG32(base + ch * 0x1000 + 0x464,
-			((hbm->hardware_training_repeat - 1) << 16) |
-			(hbm->training_delay << 8) | dll_inc);
-
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-		WREG32(base + ch * 0x1000 + 0x460, 1);
-		err = hbm_poll_timeout(base + ch * 0x1000 + 0x460, 0,
-				       GAUDI_HBM_CFG_TIMEOUT_US, &status);
-		if (err) {
-			preboot_puts("DWORD write done test failed\n");
-			goto hw_train_out;
-		}
-	}
-
-hw_train_out:
-	read_hardware_training_result(device);
-
-	restore_pll();
-}
-
-static int init_ecc(struct hbm *hbm, int unused)
-{
-	u32 base;
-	u32 status;
-	int device, err, ch, sid;
-
-	/* Clean transition from Functional mode to MCBIST mode */
-	for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
-		base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-		for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-			config_mlb_state(base, ch, phy_state_initial);
-			config_mc_state(hbm, device, ch, mc_state_bist);
-			config_mlb_state(base, ch, phy_state_bypass);
-		}
-	}
-
-	/* Configure MCBIST engine for ECC init in all channels */
-	for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
-		base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-		for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-			WREG32(base + ch * 0x1000 + 0x100, 0x100);
-			WREG32(base + ch * 0x1000 + 0x108, 0x800000);
-			WREG32(base + ch * 0x1000 + 0x10c, 0x0);
-			WREG32(base + ch * 0x1000 + 0x110, 0x0);
-			WREG32(base + ch * 0x1000 + 0x114, 0xFFFFFFFF);
-			WREG32(base + ch * 0x1000 + 0x118, 0xFFFFFFFF);
-		}
-	}
-
-	for (sid = 0; sid < 2; sid++) {
-		/* Start MCBIST engine */
-		for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
-			base = GAUDI_HBM_CFG_BASE +
-						device * GAUDI_HBM_CFG_OFFSET;
-			for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-				WREG32(base + ch * 0x1000 + 0x104,
-						(0x0 | sid << 28 | sid << 29));
-				WREG32(base + ch * 0x1000 + 0x11C, 0x3);
-			}
-		}
-
-		/* Poll for MCBIST completion */
-		for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
-			base = GAUDI_HBM_CFG_BASE +
-						device * GAUDI_HBM_CFG_OFFSET;
-			for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-				err = hbm_poll_timeout(
-						base + ch * 0x1000 + 0x11C,
-						0x03000000,
-						GAUDI_HBM_ECC_CFG_TIMEOUT_US,
-						&status);
-				if (err) {
-					preboot_puts("ECC init failed\n");
-					config_mc_state(hbm, device, ch,
-							mc_state_normal);
-					return -1;
-				}
-			}
-		}
-	}
-
-	/* Clean transition from MCBIST mode to Functional mode */
-	for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
-		base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-		for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-			config_mlb_state(base, ch, phy_state_initial);
-			config_mc_state(hbm, device, ch, mc_state_normal);
-			config_mlb_state(base, ch, phy_state_bypass);
-		}
-	}
-
-	return 0;
-}
-
-#define EXTEST_PC_SIZE		116
-#define EXTEST_BYTE_SIZE	12
-#define EXTEST_COL1_OFFSET	96
-#define EXTEST_COL2_OFFSET	97
-#define EXTEST_ROW1_OFFSET	106
-#define EXTEST_ROW2_OFFSET	108
-#define EXTEST_AW_IDX		3
-
-static int hbm_channel_dc_test_repair(int device, int ch)
-{
-	struct ch_lane_repair_info *lr = &lr_info[device][ch];
-	struct dev_fail_info *dev_fail = &dev_fail_info[device];
-	u32 extest_fails[EXTEST_WDR_REG_NUM];
-	int i, r, bit, byte, pc, extest_idx, dq, col, row;
-
-	/* Gather extest fails */
-	for (r = 0; r < EXTEST_WDR_REG_NUM; r++)
-		extest_fails[r] = lr->extest_rx_fails[r] |
-			lr->extest_tx_fails[r];
-
-	for (pc = 0; pc < PC_PER_CH; pc++) {
-		for (byte = 0; byte < BYTES_PER_PC; byte++) {
-			/* DM (ECC) */
-			extest_idx = pc * EXTEST_PC_SIZE + byte * EXTEST_BYTE_SIZE + 0;
-			r = extest_idx / 32;
-			i = extest_idx % 32;
-			if (!!(extest_fails[r] & BIT(i)))
-				lr->failed_dm[pc] |= BIT(byte);
-
-			/* DBI (bit inversion) */
-			extest_idx = pc * EXTEST_PC_SIZE + byte * EXTEST_BYTE_SIZE + 11;
-			r = extest_idx / 32;
-			i = extest_idx % 32;
-			if (!!(extest_fails[r] & BIT(i)))
-				lr->failed_dbi[pc] |= BIT(byte);
-
-			/* DQ (data) */
-			for (bit = 0; bit < 4; bit++) {
-				dq = byte * 8 + bit;
-				extest_idx = pc * EXTEST_PC_SIZE + byte *
-					EXTEST_BYTE_SIZE + (bit + 1);
-				r = extest_idx / 32;
-				i = extest_idx % 32;
-				if (!!(extest_fails[r] & BIT(i)))
-					lr->failed_dq[pc] |= BIT(dq);
-			}
-
-			for (bit = 4; bit < 8; bit++) {
-				dq = byte * 8 + bit;
-				extest_idx = pc * EXTEST_PC_SIZE + byte * EXTEST_BYTE_SIZE +
-					(bit + 3);
-				r = extest_idx / 32;
-				i = extest_idx % 32;
-				if (!!(extest_fails[r] & BIT(i)))
-					lr->failed_dq[pc] |= BIT(dq);
-			}
-
-			/* Rest of DWORD pins: PAR, RD, WDQS, RDQS, DERR */
-			for (bit = 0; bit < 2; bit++) {
-				extest_idx = pc * EXTEST_PC_SIZE + byte * EXTEST_BYTE_SIZE +
-					(bit + 5);
-				r = extest_idx / 32;
-				i = extest_idx % 32;
-				if (!!(extest_fails[r] & BIT(i)))
-					dev_fail->unrep_dw |= BIT(i);
-			}
-		}
-	}
-
-	/* Column */
-	for (col = 0; col < 4; col++) {
-		extest_idx = EXTEST_COL1_OFFSET + col;
-		r = extest_idx / 32;
-		i = extest_idx % 32;
-		if (!!(extest_fails[r] & BIT(i)))
-			lr->failed_c |= BIT(col);
-	}
-
-	for (col = 4; col < CBUS_LANES_NUM; col++) {
-		extest_idx = EXTEST_COL2_OFFSET + col;
-		r = extest_idx / 32;
-		i = extest_idx % 32;
-		if (!!(extest_fails[r] & BIT(i)))
-			lr->failed_c |= BIT(col);
-	}
-
-	/* Row */
-	for (row = 0; row < 4; row++) {
-		extest_idx = EXTEST_ROW1_OFFSET + row;
-		r = extest_idx / 32;
-		i = extest_idx % 32;
-		if (!!(extest_fails[r] & BIT(i)))
-			lr->failed_r |= BIT(row);
-	}
-
-	for (row = 4; row < RBUS_LANES_NUM; row++) {
-		extest_idx = EXTEST_ROW2_OFFSET + row;
-		r = extest_idx / 32;
-		i = extest_idx % 32;
-		if (!!(extest_fails[r] & BIT(i)))
-			lr->failed_r |= BIT(row);
-	}
-
-	/* Rest of AWORD pins */
-	dev_fail->unrep_aw =
-		(extest_fails[EXTEST_AW_IDX] & BIT(4)) ||   /* CKE  */
-		(extest_fails[EXTEST_AW_IDX] & BIT(9))  ||  /* RC   */
-		(extest_fails[EXTEST_AW_IDX] & BIT(14)) ||  /* CK_t */
-		(extest_fails[EXTEST_AW_IDX] & BIT(15)) ||  /* CK_c */
-		(extest_fails[EXTEST_AW_IDX] & BIT(18)) ||  /* RR   */
-		(extest_fails[EXTEST_AW_IDX] & BIT(19)) ||  /* AERR */
-		dev_fail->temp2 || dev_fail->temp1 ||
-		dev_fail->temp0 || dev_fail->cattrip;
-
-	return hbm_channel_lane_repair(device, ch);
-}
-
-static int lane_detection(int device)
-{
-	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-	int ch, rc;
-
-	/* Enter IODC mode */
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
-		WREG32(base + ch * 0x1000 + 0x900, 1);
-
-	extest_rx(device);
-	extest_tx(device);
-
-	/* Exit IODC mode */
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
-		WREG32(base + ch * 0x1000 + 0x900, 0);
-
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-		rc = hbm_channel_dc_test_repair(device, ch);
-		if (rc)
-			break;
-	}
-
-	return 0;
-}
-
-static void lane_remap(int device)
-{
-	struct ch_lane_repair_info *lr;
-	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-	u32 reg_800, reg_804, reg_808;
-	int mc_ch;
-
-	/* Clearing HLR information for all channels */
-	for (mc_ch = 0; mc_ch < GAUDI_HBM_CHANNELS; mc_ch++) {
-		lr = &lr_info[device][mc_ch];
-		lr->count.pc0 = 0;
-		lr->count.pc1 = 0;
-		lr->count.aw = 0;
-		lr->status = false;
-	}
-
-	for (mc_ch = 0; mc_ch < GAUDI_HBM_CHANNELS; mc_ch++) {
-		lr = &lr_info[device][mc_ch];
-		/* Read HBM lane repair eFuse information */
-		ieee1500_inst(device, hbm_ch_mapping[mc_ch],
-			      ieee1500_hard_lane_repair, EXTEST_READ_INST);
-		reg_800 = RREG32(base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) +
-				 0x800 + (hbm_ch_mapping[mc_ch] * 0x100));
-		reg_804 = RREG32(base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) +
-				 0x804 + (hbm_ch_mapping[mc_ch] * 0x100));
-		reg_808 = RREG32(base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) +
-				 0x808 + (hbm_ch_mapping[mc_ch] * 0x100));
-
-		lr->dw01_code = reg_800;
-		lr->aw_code = reg_804 & 0xFF;
-		lr->dw23_code = ((reg_804 & 0xFFFFFF00) >> 8) |
-			((reg_808 & 0xFF) << 24);
-
-		lane_update_phy(device, mc_ch);
-
-		lr->is_repair_code_valid = true;
-	}
-}
-
-static int temperature_read(int device)
-{
-	u32 base, rdata, ignore = 0;
-	bool invalid;
-
-	base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-	ieee1500_inst(device, ignore, ieee1500_temperature, EXTEST_READ_INST);
-	rdata = RREG32(base + GAUDI_HBM_CENTER_CHANNEL * 0x1000 + 0x800);
-	invalid = (rdata >> 7) & 1;
-
-	return invalid ? -1 : rdata & 0x7F;
-}
-
-static int temperature_check(int device)
-{
-	int temp = temperature_read(device);
-
-	if (temp < 0 || temp > GAUDI_MAX_TEMP_THRESHOLD)/* system power down? */
-		preboot_puts("HBM temp is invalid or high\n");
-
-	return temp;
-}
-
-static void hbm_reset(void)
-{
-	/* assert reset: set bits 33-36 (HBM) */
-	regmap_writel(0, mmPSOC_GLOBAL_CONF_UNIT_RST_N_L);
-	regmap_writel(0x1E, mmPSOC_GLOBAL_CONF_UNIT_RST_N_H);
-	regmap_writel(1, mmPSOC_GLOBAL_CONF_UNIT_RST_N);
-	udelay(250);
-	/* deassert reset */
-	regmap_writel(0, mmPSOC_GLOBAL_CONF_UNIT_RST_N_L);
-	regmap_writel(0, mmPSOC_GLOBAL_CONF_UNIT_RST_N_H);
-	regmap_writel(1, mmPSOC_GLOBAL_CONF_UNIT_RST_N);
-}
-
-static void hl_hbm_row_repair_flash_list(void)
-{
-	int err;
-	struct rma_table *table = NULL;
-	size_t size = 0;
-	u8 *p;
-
-	err = rma_table_read(RMA_HBM_ROW_REPLACEMENT_TABLE, &table, &size);
-	if (err || (size == 0))
-		return; /* no row replacement info, nothing to be done */
-
-	for (p = table->data; p < &table->data[size]; p += table->header.entry_size) {
-		struct rma_hbm_row_replacement_entry *entry =
-			(struct rma_hbm_row_replacement_entry *)p;
-
-		gaudi_hbm_row_repair(entry->device, entry->pc, entry->sid,
-				     entry->bank, entry->row);
-	}
-
-	rma_table_free(table, size);
-}
-
-/**
- * gaudi_hbm_init - Initialize HBM controller of the chip and HBM memories
- *		    Scrub the memories.
- *
- * Return: 0 for success, 1 for failure
- *
- */
-int gaudi_hbm_init(void)
-{
-	struct hbm *hbm = &hbm_data;
-	int dev, err;
-
-	hbm_reset();
-
-	for (dev = 0; dev < GAUDI_HBM_DEVICES; dev++) {
-		/* Initialization */
-
-		/* PHY requires 100ns delay from mc_rstn */
-		udelay(1);
-
-		phy_init(dev);
-		dram_rstn(dev, cke_state_low);
-
-		/* Lane remapping */
-		lane_remap(dev);
-
-		/* Internal Loopback (bring-up only) */
-		if (internal_loopback_test(hbm, dev)) {
-			preboot_puts("HBM intern loopback failed\n");
-			return 1;
-		}
-
-		/* IO connectivity test (bring-up only) */
-		if (lane_detection(dev)) {
-			preboot_puts("HBM lane det failed\n");
-			return 1;
-		}
-		dram_rstn(dev, cke_state_low);
-
-
-		/* Training */
-		hardware_training(hbm, dev);
-		check_training_result(hbm, dev);
-
-		/* Initialize MC for functional operation */
-		init_mc(hbm, dev);
-	}
-
-	/* Reset repaired failures before AC test */
-	hbm_reset_failures();
-
-	hl_hbm_row_repair_flash_list();
-
-	/* MC BIST (validate Training result and attempt repair) */
-	do {
-		err = mcbist_write_read_full(hbm, 0, true);
-	} while (err > 0);
-	if (err)
-		return 1;
-
-	/* If ECC enabled, perform ECC scrubbing */
-	if (hbm->ecc_enable)
-		if (init_ecc(hbm, 0))
-			return 1;
-
-	/* Temperature readout and Enable traffic */
-	for (dev = 0; dev < GAUDI_HBM_DEVICES; dev++) {
-		temperature_check(dev);
-		enable_traffic(dev);
-	}
-
-	return 0;
