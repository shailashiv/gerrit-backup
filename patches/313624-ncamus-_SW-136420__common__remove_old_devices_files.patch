-static void gaudi_mask_nics_ints(void)
-{
-	int i, j;
-	u32 reg, base, eng_base;
-
-	for (i = 0; i < GAUDI_NICS_NUM; i++) {
-		base = GAUDI_NICS_DIST * i;
-		for (j = 0; j < GAUDI_NIC_ENGS_IN_NIC; j++) {
-			eng_base = base + GAUDI_NIC_ENGS_DIST * j;
-
-			reg = eng_base + mmNIC0_QPC0_INTERRUPT_MASK;
-			regmap_writel(0, reg);
-
-			reg = eng_base + mmNIC0_QPC0_INTRRRUPT_RESP_ERR_MASK;
-			regmap_writel(0, reg);
-
-			reg = eng_base + mmNIC0_RXE0_CQ_CFG0;
-			regmap_writel(0, reg);
-
-			reg = eng_base + mmNIC0_RXE0_SPI_MASK;
-			regmap_writel(0xFFFFFFFF, reg);
-
-			reg = eng_base + mmNIC0_RXE0_SEI_MASK;
-			regmap_writel(0x7, reg);
-
-			reg = eng_base + mmNIC0_RXE0_MSI_CASUE_MASK;
-			regmap_writel(0, reg);
-
-			reg = eng_base + mmNIC0_TXE0_INTERRUPT_MASK;
-			regmap_writel(0, reg);
-
-			reg = eng_base + mmNIC0_TXS0_INTERRUPT_MASK;
-			regmap_writel(0, reg);
-		}
-
-		reg = base + mmNIC0_RXB_DBG_SEI_INTR;
-		regmap_writel(0x4, reg);
-
-		reg = base + mmNIC0_TMR_INTERRUPT_MASK;
-		regmap_writel(0, reg);
-	}
-}
-
-static void gaudi_nics_rxb_drop_reset(void)
-{
-	int i, j;
-	unsigned int off;
-
-	for (i = 0; i < GAUDI_NICS_NUM; i++) {
-		for (j = 0; j < 16; j++) {
-			off = mmNIC0_RXB_DROP_THRESHOLD_0 + j * 4 + i * 0x40000;
-			regmap_writel(0, off);
-		}
-	}
-}
-
-static void gaudi_nics_txe_read_choke(void)
-{
-	int i, j;
-	u32 reg, base, eng_base;
-
-	for (i = 0; i < GAUDI_NICS_NUM; i++) {
-		base = GAUDI_NICS_DIST * i;
-		for (j = 0; j < GAUDI_NIC_ENGS_IN_NIC; j++) {
-			eng_base = base + GAUDI_NIC_ENGS_DIST * j;
-			reg = eng_base + mmNIC0_TXE0_READ_CREDIT_FORCE_FULL;
-			regmap_writel(0x1, reg);
-		}
-	}
-}
-
-static void gaudi_nic_qpc_disable(unsigned int reg, int nic, int qpc)
-{
-	unsigned int off, mask = BIT(6);
-
-	off = reg + nic * 0x40000 + qpc * 0x1000;
-	reg = regmap_readl(off);
-	reg |= mask;
-	regmap_writel(reg, off);
-}
-
-static void gaudi_nics_qpcs_disable(void)
-{
-	int nic, qpc;
-
-	for (nic = 0; nic < GAUDI_NICS_NUM; nic++) {
-		for (qpc = 0; qpc < GAUDI_QPCS_NUM; qpc++) {
-			gaudi_nic_qpc_disable(mmNIC0_QPC0_REQ_STATIC_CONFIG,
-					      nic, qpc);
-			gaudi_nic_qpc_disable(mmNIC0_QPC0_RES_STATIC_CONFIG,
-					      nic, qpc);
-		}
-	}
-}
-
-static void gaudi_nics_handle(void)
