-{
-	halt_n_reset_arc(0);
-	halt_n_reset_arc(1);
-
-	/*
-	 * Program Reset vector address for ARC0 and ARC1 to ICCM 0x0
-	 * location where vector table first entry will be available and
-	 * then bring ARC0 and ARC1 out of reset. ARCs when out of reset
-	 * is by default in halt state.
-	 */
-	regmap_writel(ARC_RST_VEC_ADDR, mmPSOC_ARC0_CFG_RST_VEC_ADDR);
-	regmap_writel(ARC_RST_VALUE, mmPSOC_ARC0_CFG_ARC_RST);
-	regmap_writel(ARC_RST_VEC_ADDR, mmPSOC_ARC1_CFG_RST_VEC_ADDR);
-	regmap_writel(ARC_RST_VALUE, mmPSOC_ARC1_CFG_ARC_RST);
-
-}
-
-/*
- * initialize scratch SRAM to avoid ECC exceptions ECC errors are observed due
- * to byte copy to SP memory which turns to be read-modify-write transaction
- */
-void preboot_sp_sram_init(void)
-{
-	u32 mem_cfg, cpy_sts;
-	u8 retry = HL_INIT_SP_SRAM_RETRIES;
-
-	/* Use memblock to initialize scratchpad memory */
-	regmap_writel((u32)HL_SP_SRAM_BASE,
-			mmPSOC_GLOBAL_CONF_MEM_CPY_DEST_ADDR_L);
-	regmap_writel((u32)(HL_SP_SRAM_BASE >> 32),
-			mmPSOC_GLOBAL_CONF_MEM_CPY_DEST_ADDR_H);
-
-	mem_cfg = regmap_readl(mmPSOC_GLOBAL_CONF_MEM_CPY_CTRL2);
-	mem_cfg &= ~(PSOC_GLOBAL_CONF_MEM_CPY_CTRL2_FLD_SIZE_MASK);
-	/* set size of 64k in granuality of 16 bytes */
-	mem_cfg |= (0x1000 & PSOC_GLOBAL_CONF_MEM_CPY_CTRL2_FLD_SIZE_MASK);
-	mem_cfg |= (0x1 << PSOC_GLOBAL_CONF_MEM_CPY_CTRL2_USE_CONST_SHIFT);
-
-	regmap_writel(mem_cfg, mmPSOC_GLOBAL_CONF_MEM_CPY_CTRL2);
-
-	/* Enable copy and wait for completion */
-	regmap_writel(0x1, mmPSOC_GLOBAL_CONF_MEM_CPY_CTRL);
-	while (1) {
-		cpy_sts = regmap_readl(mmPSOC_GLOBAL_CONF_MEM_CPY_STATUS);
-		if (cpy_sts)
-			break;
-		/*
-		 * Do not wait indefinitely on copy status
-		 * Wait for 5 seconds (50 retries with 100 milli-
-		 * seconds sleep), else bailout.
-		 */
-		retry--;
-		if (!retry) {
-			preboot_puts("Timed-out waiting for SP SRAM copy\n");
-			break;
-		}
-		udelay(100000);
-	}
-
-}
-
-static void axi_enable_pcie_drain(void)
-{
-	u32 val;
-
-	/* Set timeout and enable drain */
-	regmap_writel(PCIE_AXI_DRAIN_TIMEOUT, mmPCIE_WRAP_HBW_DRAIN_TIMEOUT);
-	regmap_writel(PCIE_AXI_DRAIN_TIMEOUT, mmPCIE_WRAP_LBW_DRAIN_TIMEOUT);
-
-	val = regmap_readl(mmPCIE_WRAP_HBW_DRAIN_CFG);
-	val |= BIT(PCIE_WRAP_HBW_DRAIN_CFG_EN_SHIFT);
-	regmap_writel(val, mmPCIE_WRAP_HBW_DRAIN_CFG);
-
-	val = regmap_readl(mmPCIE_WRAP_LBW_DRAIN_CFG);
-	val |= BIT(PCIE_WRAP_LBW_DRAIN_CFG_EN_SHIFT);
-	regmap_writel(val, mmPCIE_WRAP_LBW_DRAIN_CFG);
-}
-
-void hl_plat_early_init(void)
-{
-	axi_enable_drain();
-	axi_enable_pcie_drain();
-	cpu_boot_dev_sts_set(CPU_BOOT_DEV_STS_FW_IATU_CONF_EN);
-}
-
-void ppboot_log_waiting_for_pcie(void)
-{
-	/* we are waiting for link, so do not waste too much time on log */
-	preboot_puts("5\n");
-}
-
-void image_start(u64 loadaddr)
-{
-	void (*image_entry)(void) = (void *)loadaddr;
-
-	image_entry();
-}
-
-void preboot_start_image(u64 startaddr, bool valid_arc_img)
-{
-	/*
-	 * Set ARC0 and ARC1 in running state. Don't run
-	 * ARCs if no arc images received as part of fit.
-	 */
-	if (valid_arc_img) {
-		run_arc(0);
-		run_arc(1);
-	}
-
-	/*
-	 * After image_entry, control is not expected to return
-	 * here and continue.
-	 */
-	image_start(startaddr);
-}
-
-static void fit_copy_arc_image(u64 dst, const void *buf, int len)
-{
-	u32 mem_cfg;
-
-	/*
-	 * For ARC images:
-	 * 1. Copy FIT image to scratchpad SRAM base. This is required
-	 *    for using memcopy block as memcopy requires source and
-	 *    destination addressess to be 16 bytes aligned.
-	 * 2. Copy from scratchpad SRAM to ICCM/DCCM using memcopy block.
-	 */
-	memcpy((void *)HL_SP_SRAM_BASE, buf, len);
-
-	/* Set source and destination address in memcopy block */
-	regmap_writel((u32)dst, mmPSOC_GLOBAL_CONF_MEM_CPY_DEST_ADDR_L);
-	regmap_writel((u32)(dst >> 32), mmPSOC_GLOBAL_CONF_MEM_CPY_DEST_ADDR_H);
-	regmap_writel((u32)HL_SP_SRAM_BASE,
-			mmPSOC_GLOBAL_CONF_MEM_CPY_START_ADDR_L);
-	regmap_writel((u32)(HL_SP_SRAM_BASE >> 32),
-			mmPSOC_GLOBAL_CONF_MEM_CPY_START_ADDR_H);
-
-
-	/* Align length to 16 bytes */
-	if (len % 16)
-		len += (16 - (len % 16));
-
-	/* Set length in memcopy register in granuality of 16 bytes */
-	len = len >> 4;
-	mem_cfg = regmap_readl(mmPSOC_GLOBAL_CONF_MEM_CPY_CTRL2);
-	mem_cfg &= ~(PSOC_GLOBAL_CONF_MEM_CPY_CTRL2_USE_CONST_MASK);
-	mem_cfg &= ~(PSOC_GLOBAL_CONF_MEM_CPY_CTRL2_FLD_SIZE_MASK);
-	mem_cfg |= (len & PSOC_GLOBAL_CONF_MEM_CPY_CTRL2_FLD_SIZE_MASK);
-	regmap_writel(mem_cfg, mmPSOC_GLOBAL_CONF_MEM_CPY_CTRL2);
-
-	/* Enable copy and wait for completion */
-	regmap_writel(0x1, mmPSOC_GLOBAL_CONF_MEM_CPY_CTRL);
-	while (!regmap_readl(mmPSOC_GLOBAL_CONF_MEM_CPY_STATUS))
-		;
-
-
-}
-
-void preboot_copy_image(u64 dst, const void *buf, int len, const char *arch)
-{
-	if (!strcmp(arch, "arc"))
-		fit_copy_arc_image(dst, buf, len);
-	else
-		memcpy((void *)dst, buf, len);
-}
-
-void ppboot_cp_preboot(u64 loadaddr, u32 offset, u32 size, char *name)
-{
-	preboot_puts_hex_raw("Preboot loadaddr: ",
-			     (u32)(loadaddr >> 32), false);
-	preboot_puth((u32)loadaddr, false);
-
-	spi_flash_copy((void *)loadaddr, offset, size, name);
-}
-
-u32 dev_pci_dbi_cfg_offset_get(void)
-{
-	return (u32)mmPCIE_DBI_BASE & 0xFFFFFF;
-}
-
-void preboot_pcie_wait_for_link(void)
-{
-	u64 start = timestamp_get_us();
-
-	/* init dev id as soon as possible, while waiting for prstn */
-	preboot_device_id_init();
-
-	/* Wait for PRSTn */
-	while (!regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN)) {
-		/* If PRSTn does not happen in 5 seconds
-		 * timeout and return
-		 */
-		if (timeout_expired(start, PCIE_WAIT_TIMEOUT_US)) {
-			preboot_puts("Timed-out waiting for PRSTn!\n");
-			return;
-		}
-	}
-
-	/* Only after PRSTn is de-asserted */
-	preboot_pcie_enable();
-
-	preboot_puts("Waiting for PCIe UP status\n");
-
-	/* Reset start timer */
-	start = timestamp_get_us();
-
-	while (1) {
-		unsigned int prstn, ltssm, smlh, rdlh;
-
-		prstn = regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN);
-		ltssm = regmap_readl(mmPCIE_AUX_LTSSM_EN);
-		smlh = regmap_readl(mmPCIE_AUX_SMLH_LINK_UP);
-		rdlh = regmap_readl(mmPCIE_AUX_RDLH_LINK_UP);
-
-		if (prstn && smlh && rdlh) {
-			preboot_puts("PCIe link is UP!\n");
-			break;
-		}
-
-		if (timeout_expired(start, PCIE_WAIT_TIMEOUT_US)) {
-			preboot_puts("Timed-out waiting for PCIe link UP!\n");
-			break;
-		}
-
-		/*
-		 * Some host assert prstn during link up while moving to GEN3
-		 * This cause BAR size to be reset
-		 * We stop link up process by disabling ltssm
-		 * till BAR is reconfigured
-		 */
-		if (!prstn && ltssm) {
-			regmap_writel(0, mmPCIE_AUX_LTSSM_EN);
-			continue;
-		}
-
-		if (prstn && !ltssm) {
-			regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
-			continue;
-		}
-	}
-
-	/* W/A H/W bug that may lead to have a wrong mask (0x1) in LTSSM */
-	regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
-}
