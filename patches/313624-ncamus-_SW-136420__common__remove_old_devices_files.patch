-void preboot_security_init(void)
-{
-	bool is_sec_en;
-
-	cpu_boot_err_set(CPU_BOOT_ERR_SECURITY_NOT_RDY);
-	preboot_puts("Security init started...\n");
-
-	is_sec_en = preboot_security_is_enabled();
-	if (is_sec_en) {
-		preboot_secure_cpu();
-		preboot_secure_psoc();
-		preboot_secure_pci();
-		preboot_secure_mme();
-		preboot_secure_tpc();
-		preboot_secure_pll();
-		preboot_secure_nic();
-		preboot_secure_if();
-		preboot_secure_sram_cfg();
-		preboot_secure_dma();
-		preboot_secure_sm();
-		preboot_secure_dbg();
-
-		preboot_secure_lbw();
-		preboot_secure_hbw();
-
-		preboot_puts("Security is enabled\n");
-	} else {
-		preboot_security_pci_disable();
-		preboot_puts("Security is disabled\n");
-	}
-
-	/* Store security info to be used by the booted image */
-	preboot_security_sp_sram_init();
-
-	if (is_sec_en)
-		cpu_boot_dev_sts_set(CPU_BOOT_DEV_STS_SECURITY_EN);
-	else
-		cpu_boot_dev_sts_clr(CPU_BOOT_DEV_STS_SECURITY_EN);
-
-	cpu_boot_err_clr(CPU_BOOT_ERR_SECURITY_NOT_RDY);
-	preboot_puts("Security init finished.\n");
-}
