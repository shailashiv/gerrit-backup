-
-/* configure yellow LED(GPIO2) in output mode and turn on(active low) */
-void preboot_led_on(void)
-{
-	u32 val = BIT(2);
-
-	/* configure GPIO in output mode */
-	regmap_writel(val, mmPSOC_GPIO0_OUTENSET);
-
-	/* Turn ON LED (pin is active low) */
-	val = regmap_readl(mmPSOC_GPIO0_DATAOUT);
-	val &= ~BIT(2);
-	regmap_writel(val, mmPSOC_GPIO0_DATAOUT);
-}
-
-bool ppboot_is_valid_img_desc(struct boot_desc *desc)
-{
-	u8 hash[SHA256_SUM_LEN];
-
-	sha256_csum((void *)(uintptr_t)desc->loadaddr, desc->img_size, hash);
-
-	return !memcmp(hash, desc->chksum, ARRAY_SIZE(hash));
-}
-
-/*
- * Wait for Boot Manager to complete PCIe image execution
- * and return to idle state, so it won't initiate UART access anymore
- */
-__weak void preboot_sync_btl(void)
-{
-	u64 start = timestamp_get_us();
-
-	while (regmap_readl(mmPSOC_GLOBAL_CONF_BTM_FSM)) {
-		/*
-		 * Boot manager is supposed to complete entire execution
-		 * of FSM, BTL primary/secondary at this point. Though
-		 * It should not take more than 100ms for it to finish
-		 * timeout of half second is used here.
-		 */
-		if (timeout_expired(start, BTL_SYNC_TIMEOUT_US))
-			break;
-	}
-}
