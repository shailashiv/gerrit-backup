-struct preboot_sec_dyn_pcie_rr_cfg {
-	int rr;
-	u64 min;
-	u64 max;
-};
-
-static struct preboot_sec_dyn_pcie_rr_cfg preboot_sec_dyn_cfg[] = {
-	[SRAM_BGN_TO_VERS] = {
-		.rr = PCIE_DYN_RR_SRAM_BGN,
-		.min = SDRAM_BASE - 1,
-		.max = 0,	/* version start */
-	},
-	[VERSION] = {
-		.rr = PCIE_DYN_RR_SRAM_R1,
-		.min = 0,	/* version start */
-		.max = 0,	/* version end */
-	},
-	[VERS_END_TO_IMG] = {
-		.rr = PCIE_DYN_RR_SRAM_R2,
-		.min = 0,	/* version end */
-		.max = 0,
-	},
-	[IMAGE] = {
-		.rr = PCIE_DYN_RR_SRAM_R3,
-		.min = 0,
-		.max = 0,
-	},
-	[IMG_END_TO_SRAM_END] = {
-		.rr = PCIE_DYN_RR_SRAM_END,
-		.min = 0,
-		.max = SRAM_END,
-	},
-	[STM_SF_MEMMAP] = {
-		.rr = PCIE_DYN_RR_STM_SF,
-		.min = mmSTM_BASE - 1,
-		.max = HL_SPI_END,
-	},
-	[SPSRAM_IMAGE] = {
-		.rr = PCIE_DYN_RR_SPSRAM_IMG,
-		.min = FIT_IMG_SPSRAM_BASE - 1,
-		.max = FIT_IMG_SPSRAM_END,
-	},
-	[CFG_LOW] = {
-		.rr = PCIE_DYN_RR_CFG_LOW,
-		.min = HL_CFG_BASE - 1,
-		.max = mmPSOC_GLOBAL_CONF_BASE,
-	},
-	[CFG_HIGH] = {
-		.rr = PCIE_DYN_RR_CFG_HIGH,
-		.min = mmPSOC_GPIO0_BASE - 1,
-		/*
-		 * The PCIe RR can take only values of 32 bits, then H/W is
-		 * extending these with 0x7F in the bits 32-39.
-		 * This means we cannot provide the HOST_PHYS_BASE as it will
-		 * just turn into 0x7F00000000 which is not what we want.
-		 * Subtract 1 from HOST_PHYS_BASE to hae a valid value.
-		 */
-		.max = HOST_PHYS_BASE - 1,
-	},
-};
