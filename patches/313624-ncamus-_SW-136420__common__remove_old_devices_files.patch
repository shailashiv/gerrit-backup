-{
-	/* Prepare the ARC SRAM address */
-	u32 arc_dst = ((u32)dst & 0xFFFFFFF) | BIT(28);
-
-	memcpy((void *)arc_dst, buf, len);
-}
-
-void preboot_start_image(u64 startaddr, bool valid_arc_img)
-{
-	void (*image_entry)(void);
-	u32 lsb, msb;
-
-	if (startaddr) {
-		lsb = (u32)startaddr;
-		msb = (u32)(startaddr >> 32);
-		/* Set CPU0 Reset address to U-Boot */
-		regmap_writel(lsb, mmCPU_CA53_CFG_RST_ADDR_LSB_0);
-		regmap_writel(msb, mmCPU_CA53_CFG_RST_ADDR_MSB_0);
-
-		/* Wake up CPU0, after we put all CPUs in reset */
-		regmap_writel(0x0, mmCPU_CA53_CFG_ARM_RST_CONTROL);
-		regmap_writel(0x10111, mmCPU_CA53_CFG_ARM_RST_CONTROL);
-	}
-
-	if (!valid_arc_img) {
-		/*
-		 * Dont run ARC0 or jump to ARC1 ICCM if no arc images
-		 * received as part of fit.
-		 */
-		wfe();
-	}
-
-	 /* Set ARC0 in running state */
-	run_arc(0);
-
-	/*
-	 * Jump to __reset of zephyr. After image_entry, control is not
-	 * expected to return here and continue.
-	 */
-	image_entry = (void *) (*(u32 *)ARC_ICCM_BASE);
-	image_entry();
-}
-
-bool preboot_sram_is_valid_address_range(u64 addr, int len)
-{
-	/* Prepare the ARC SRAM address */
-	u32 arc_addr = ((u32)addr & 0xFFFFFFF) | BIT(28);
-
-	if (arc_addr >= SDRAM_BASE && arc_addr + len <= SDRAM_BASE + SRAM_SIZE)
-		return !preboot_is_overlap_address_range(addr, len);
-
-	if (addr >= FIT_IMG_SPSRAM_BASE && addr + len <= FIT_IMG_SPSRAM_END)
-		return true;
-
-	return false;
-}
-
-u32 dev_pci_dbi_cfg_offset_get(void)
-{
-	return (u32)mmPCIE_DBI_BASE & 0xFFFFFF;
-}
-
-bool is_pcie_initialized(void)
-{
-	u32 secondary_sts;
-
-	secondary_sts = regmap_readl(mmPSOC_ARC0_CFG_RUN_HALT_ACK);
-
-	/*
-	 * Secondary CPU is put to sleep once PCIe initialization
-	 * is done So notify PCIe is initialized if secondary CPU
-	 * (ARC0) is in sleep state or in halt state.
-	 */
-	if ((secondary_sts & PSOC_ARC0_CFG_RUN_HALT_ACK_SYS_SLEEP_R_MASK) ||
-		(secondary_sts & PSOC_ARC0_CFG_RUN_HALT_ACK_SYS_HALT_R_MASK))
-		return true;
-	else
-		return false;
-}
-
-void preboot_secondary_cpu_stop(void)
-{
-	u32 *secondary_iccm_addr = (u32 *) ARC0_ICCM_BASE;
-
-	/*
-	 * Secondary CPU will be in sleep once pcie initialization
-	 * is done, clean 0th location of ICCM, halt and reset ARC0
-	 * so that it can ready to load and run zephyr images received
-	 * via FIT.
-	 */
-	*secondary_iccm_addr = 0x0;
-
-	halt_n_reset_arc(0);
-
-	regmap_writel(ARC_RST_VEC_ADDR, mmPSOC_ARC0_CFG_RST_VEC_ADDR);
-	regmap_writel(ARC_RST_VALUE, mmPSOC_ARC0_CFG_ARC_RST);
-}
-
-bool hl_is_legacy_boot(void)
-{
-	/*
-	 * Due to DCCM ECC issue in arcboot rom, hybrid mode is enabled
-	 * for greco where execution starts from BTL and BTL starts
-	 * ROM flow on ARC1. Due to this, BTL_EN bit is set but still
-	 * ROM flow is executed. In mixed flow, BTL version needs to
-	 * be passed to host. To distinguish between mixed flow and
-	 * arcboot flow Security bypass strap is used.
-	 */
-	u32 boot_strap = regmap_readl(mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS_H);
-
-	return !(boot_strap &
-		 PSOC_GLOBAL_CONF_BOOT_STRAP_PINS_H_SECURITY_BYPASS_MASK);
-}
-
-#define SP_SRAM_64K_SZ_16B_GRANULARITY	0x1000
-void preboot_sp_sram_init(void)
-{
-	u32 mem_cfg, cpy_sts, rst_src;
-	u64 start;
-	u32 address = SP_SRAM_BASE + EEPROM_SPM_COPY_OFFSET;
-	struct eeprom_spsram_layout *eeprom_copy = (struct eeprom_spsram_layout *)address;
-
-	/* Clear indication on eeprom data ready */
-	*((volatile u32 *)(&eeprom_copy->status)) = 0x0;
-
-	rst_src = hl_rst_src_get();
-	if (rst_src != HL_COLD_RST)
-		return;
-
-	/* Use memblock to initialize scratchpad memory */
-	regmap_writel((u32)(HL_SP_SRAM_BASE),
-			mmPSOC_GLOBAL_CONF_MEM_CPY_DEST_ADDR_L);
-	regmap_writel((u32)((HL_SP_SRAM_BASE) >> 32),
-			mmPSOC_GLOBAL_CONF_MEM_CPY_DEST_ADDR_H);
-
-	mem_cfg = regmap_readl(mmPSOC_GLOBAL_CONF_MEM_CPY_CTRL2);
-	mem_cfg &= ~(PSOC_GLOBAL_CONF_MEM_CPY_CTRL2_FLD_SIZE_MASK);
-	/* set size of 64k in granuality of 16 bytes */
-	mem_cfg |= (SP_SRAM_64K_SZ_16B_GRANULARITY & PSOC_GLOBAL_CONF_MEM_CPY_CTRL2_FLD_SIZE_MASK);
-	mem_cfg |= (BIT(PSOC_GLOBAL_CONF_MEM_CPY_CTRL2_USE_CONST_SHIFT));
-
-	regmap_writel(mem_cfg, mmPSOC_GLOBAL_CONF_MEM_CPY_CTRL2);
-
-	/* Enable copy and wait for completion */
-	regmap_writel(BIT(0), mmPSOC_GLOBAL_CONF_MEM_CPY_CTRL);
-	start = timestamp_get_us();
-
-	while (1) {
-		cpy_sts = regmap_readl(mmPSOC_GLOBAL_CONF_MEM_CPY_STATUS);
-		if (cpy_sts)
-			break;
-
-		/* If copy does not happen in 5 seconds
-		 * timeout and return
-		 */
-		if (timeout_expired(start, MEM_CPY_TIMEOUT_US)) {
-			preboot_puts("mem_cpy timedout\n");
-			break;
-		}
-	}
-}
-
-u64 preboot_get_arch_view_addr(u64 addr)
-{
-	return ((u32)addr & 0xFFFFFFF) | BIT(28);
-}
-
-#define SEE_REG			0xF4
-#define SEE_DATA_CMD_VAL	0x201
-#define GPIO_EX1_DEV_ADDR	0x50
-#define GPIO_EX2_DEV_ADDR	0x51
-static void preboot_set_gpio_ex_see_bit(u32 dev_addr)
-{
-	/* Disable the controller */
-	regmap_writel(0x0, mmPSOC_I2C_M1_IC_ENABLE);
-	/* Disable intr mask */
-	regmap_writel(0x0, mmPSOC_I2C_M1_IC_INTR_MASK);
-	/* Set target address register */
-	regmap_writel(dev_addr, mmPSOC_I2C_M1_IC_TAR);
-	/* Enable the controller */
-	regmap_writel(0x1, mmPSOC_I2C_M1_IC_ENABLE);
-
-	regmap_writel(SEE_REG, mmPSOC_I2C_M1_IC_DATA_CMD);
-
-	udelay(50);
-
-	/* Write 1 to SEE BIT */
-	regmap_writel(SEE_DATA_CMD_VAL, mmPSOC_I2C_M1_IC_DATA_CMD);
-
-	/* Disable the controller */
-	regmap_writel(0x0, mmPSOC_I2C_M1_IC_ENABLE);
-}
-
-void preboot_close_strap_eeprom_write(void)
-{
-	/* Set padsel for I2C M1 */
-	regmap_writel(0x1, mmPSOC_GLOBAL_CONF_PAD_SEL_32);
-	regmap_writel(0x1, mmPSOC_GLOBAL_CONF_PAD_SEL_33);
-
-	/* Set i2c configuration */
-	regmap_writel(0x4b, mmPSOC_I2C_M1_IC_FS_SCL_HCNT);
-	regmap_writel(0x57, mmPSOC_I2C_M1_IC_FS_SCL_LCNT);
-	regmap_writel(0x28, mmPSOC_I2C_M1_IC_SDA_HOLD);
-
-	preboot_set_gpio_ex_see_bit(GPIO_EX1_DEV_ADDR);
-	preboot_set_gpio_ex_see_bit(GPIO_EX2_DEV_ADDR);
-}
-
-void preboot_read_straps(void)
-{
-	u32 boot_strap = regmap_readl(mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS_L);
-
-	preboot_puts_hex_raw("Boot strap pins low: ", boot_strap, true);
-	boot_strap = regmap_readl(mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS_H);
-	preboot_puts_hex_raw(" high: ", boot_strap, true);
-	preboot_puts("\n");
-}
