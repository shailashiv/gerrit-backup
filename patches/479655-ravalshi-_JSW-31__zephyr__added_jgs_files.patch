+			compatible = "intel,fs1";
+			reg = <0xfc4e3000 0x1000>;
+			label = "INTEL_FS1";
+			sw_intr_index = <127 0>;
+			sw_intr_halt_req = <127 1>;
+			wdt_rst_intr = <61 0>;
+			cfg_reg_base = <0xf0000000>;
+			pci_dbi_offset = <0xc402000>;
+		};
+
+		mbx_iod0mgmt_iod0pid: fs-mbx@f9caa000 {
+			compatible = "intel,fs_mbx_tx";
+			reg = <0xf9caa000 0x590>, <0x789a0000 0x1000>;
+			reg-names = "cfg", "data";
+			interrupts = <160 2>;
+			mbx_type = <1>;
+			label = "FS_MBX_IOD0MGMT_IOD0PID";
+		};
+
+		mbx_iod0pid_iod0mgmt: fs-mbx@f9ca9000 {
+			compatible = "intel,fs_mbx_rx";
+			reg = <0xf9ca9000 0x590>, <0x789a1000 0x1000>;
+			reg-names = "cfg", "data";
+			interrupts = <161 2>;
+			mbx_type = <2>;
+			label = "FS_MBX_IOD0PID_IOD0MGMT";
+		};
+
+		queueirq: fs_queue_irq@4 {
+			reg = <0x4 0x4>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+			compatible = "shared-irq";
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupts = <173 2>;
+			interrupt-names = "shared_irq";
+			label = "FS_QUEUE_SHARED_IRQ";
+
+			d2hqueue0: fs_queue@f9ce2400 {
+				reg = <0xf9ce2400 0x30>,
+				      <0xf9ce2180 0xf>,
+				      <0xf9cd4bc0 0xf>,
+				      <0xf9cd45b0 0xf>;
+				reg-names = "base", "intr_local", "intr_global", "intr_mask";
+				#address-cells = <3>;
+				compatible = "intel,fs_queue_d2h";
+				local_idx = <0>;
+				global_idx = <6>;
+				mask_idx = <11>;
+				label = "FS_QUEUE_D2H0";
+			};
+
+			d2hqueue1: fs_queue@f9ce2440 {
+				reg = <0xf9ce2440 0x30>,
+				      <0xf9ce2180 0xf>,
+				      <0xf9cd4bc0 0xf>,
+				      <0xf9cd45b0 0xf>;
+				reg-names = "base", "intr_local", "intr_global", "intr_mask";
+				#address-cells = <3>;
+				compatible = "intel,fs_queue_d2h";
+				local_idx = <1>;
+				global_idx = <6>;
+				mask_idx = <11>;
+				label = "FS_QUEUE_D2H1";
+			};
+
+			h2dqueue0: fs_queue@f9ce2200 {
+				reg = <0xf9ce2200 0x20>,
+				      <0xf9ce2160 0xf>,
+				      <0xf9cd4bc0 0xf>,
+				      <0xf9cd45b0 0xf>;
+				reg-names = "base", "intr_local", "intr_global", "intr_mask";
+				compatible = "intel,fs_queue_h2d";
+				local_idx = <0>;
+				global_idx = <6>;
+				mask_idx = <11>;
+				label = "FS_QUEUE_H2D0";
+			};
+		};
+	};
+};
+
+&clk_noc_io {
+	skip_init;
+};
+
+&clk_psoc_io {
+	skip_init;
+};
+
+&clk_pcie_io {
+	skip_init;
+};
+
+&efuse {
+	status = "okay";
+};
