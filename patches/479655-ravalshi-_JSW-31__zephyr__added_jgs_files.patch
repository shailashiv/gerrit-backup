+ */
+
+#ifndef _HL_MISC_COMMON_JGS_ITERATORS_H
+#define _HL_MISC_COMMON_JGS_ITERATORS_H
+
+#include <zephyr/drivers/misc/common/jgs/hl_platform_defs.h>
+#include <jgs_fw_if.h>
+
+/**
+ * struct iterate_module_ctx - HW module iterator
+ * @fn: function to apply to each HW module instance
+ * @data: optional internal data to the function iterator
+ * @die_id: enum specifying the die id
+ */
+struct iterate_module_ctx {
+	/*
+	 * callback for the HW module iterator
+	 * @offset: current HW module instance offset
+	 * @data: function specific data
+	 * @redun: redundancy ctx for binned blocks (optional)
+	 */
+	void (*fn)(uint32_t offset, void *data);
+	void *data;
+	enum fs1_die_id die_id;
+	struct fs1_redundancy_ctx *redun;
+};
+
+enum axiovrd_type {
+	lbw_axiovrd,
+	hbw_axiovrd,
+};
+
+void fs_iterate_edmas(struct iterate_module_ctx *ctx);
+void fs_iterate_pdmas(struct iterate_module_ctx *ctx);
+void fs_iterate_cache(struct iterate_module_ctx *ctx);
+void fs_iterate_nss_nms_sms(struct iterate_module_ctx *ctx);
+void fs_iterate_nss_nms_farms(struct iterate_module_ctx *ctx);
+void fs_iterate_nss_nms_farm_arcs(struct iterate_module_ctx *ctx);
+void fs_iterate_nics(struct iterate_module_ctx *ctx);
+void fs_iterate_io_die_cfg_psoc(struct iterate_module_ctx *ctx);
+void fs_iterate_io_die_dbg_psoc(struct iterate_module_ctx *ctx);
+int fs_iterate_axiovrd(struct iterate_module_ctx *ctx, enum axiovrd_type axiovrd_type);
+int fs_comp_iterate_axiovrd(struct iterate_module_ctx *ctx, enum axiovrd_type axiovrd_type);
+
+bool fs_is_edma_engine_missing(enum fs1_die_id die_id, unsigned int engine_inst);
+bool fs_is_pdma_engine_missing(enum fs1_die_id die_id);
+bool fs_is_cu0_cs_missing(enum fs1_die_id die_id, unsigned int cu0_cs_inst);
+bool fs_is_cu1_cs_missing(enum fs1_die_id die_id, unsigned int cu1_cs_inst);
+bool fs_is_nss_nms_sms_missing(enum fs1_die_id die_id);
+bool fs_is_nss_nms_farm_missing(enum fs1_die_id die_id, unsigned int farm_inst);
+bool fs_is_nss_nms_farm_arc_missing(enum fs1_die_id die_id, unsigned int farm_inst,
+				    unsigned int engine_inst);
+bool fs_is_nic_missing(enum fs1_die_id die_id, unsigned int engine_inst);
+bool fs_is_io_die_cfg_psoc_missing(enum fs1_die_id die_id);
+bool fs_is_io_die_dbg_psoc_missing(enum fs1_die_id die_id);
+
+#endif /* _HL_MISC_COMMON_JGS_ITERATORS_H */
