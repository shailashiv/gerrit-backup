diff --git a/soc/intel/gpu/jgs/emb/jgs_linker.ld b/soc/intel/gpu/jgs/emb/jgs_linker.ld
new file mode 100644
index 0000000..23b24b5
--- /dev/null
+++ b/soc/intel/gpu/jgs/emb/jgs_linker.ld
@@ -0,0 +1,60 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2024 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+/**
+ * @brief Linker script for the jgs
+ */
+
+#include <zephyr/devicetree.h>
+#include <autoconf.h>
+
+#define SZ_1K	1024
+
+#ifdef CONFIG_HARVARD
+
+	/* Instruction Closely Coupled Memory (ICCM) base address and size */
+	#if DT_NODE_HAS_PROP(DT_INST(0, arc_iccm), reg) && \
+		(DT_REG_SIZE(DT_INST(0, arc_iccm)) > 0)
+	#define ICCM_START		DT_REG_ADDR(DT_INST(0, arc_iccm))
+	#define ICCM_SIZE		DT_REG_SIZE(DT_INST(0, arc_iccm)) * SZ_1K
+	#endif
+
+	/* Data Closely Coupled Memory (DCCM) base address and size */
+	#if DT_NODE_HAS_PROP(DT_INST(0, arc_dccm), reg) && \
+		(DT_REG_SIZE(DT_INST(0, arc_dccm)) > 0)
+	#define DCCM_START		DT_REG_ADDR(DT_INST(0, arc_dccm))
+	#define DCCM_SIZE		DT_REG_SIZE(DT_INST(0, arc_dccm)) * SZ_1K
+	#endif
+
+#else /* CONFIG_HARVARD */
+
+	#if defined(CONFIG_PREBOOT_RUN_FROM_ICCM) || defined(CONFIG_MGMT_RUN_FROM_ICCM) || defined(CONFIG_DSM_RUN_FROM_ICCM)
+		#if DT_NODE_HAS_PROP(DT_INST(0, arc_iccm), reg) && \
+			(DT_REG_SIZE(DT_INST(0, arc_iccm)) > 0)
+		#define SRAM_START		DT_REG_ADDR(DT_INST(0, arc_iccm))
+		#define SRAM_SIZE		DT_REG_SIZE(DT_INST(0, arc_iccm)) * SZ_1K
+		#endif
+	#else
+		/* SRAM base address and size */
+		#if DT_NODE_HAS_PROP(DT_INST(0, mmio_sram), reg) && \
+			(DT_REG_SIZE(DT_INST(0, mmio_sram)) > 0)
+			#if DT_NODE_HAS_PROP(DT_NODELABEL(bootinfo_partition), reg) && \
+				(DT_REG_ADDR(DT_NODELABEL(bootinfo_partition)) == 0)
+				#define SRAM_START	DT_REG_ADDR(DT_INST(0, mmio_sram)) + \
+					(DT_REG_SIZE(DT_NODELABEL(bootinfo_partition)) * SZ_1K)
+				#define SRAM_SIZE	(DT_REG_SIZE(DT_INST(0, mmio_sram)) - \
+					DT_REG_SIZE(DT_NODELABEL(bootinfo_partition))) * SZ_1K
+			#else
+				#define SRAM_START	DT_REG_ADDR(DT_INST(0, mmio_sram))
+				#define SRAM_SIZE	DT_REG_SIZE(DT_INST(0, mmio_sram)) * SZ_1K
+			#endif
+		#endif
+	#endif
+
+#endif /* CONFIG_HARVARD */
+
+#include <zephyr/arch/arc/v2/linker.ld>
