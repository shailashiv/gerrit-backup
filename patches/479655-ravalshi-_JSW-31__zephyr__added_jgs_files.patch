+};
+
+static int get_axiovrd_list_len(int die, enum axiovrd_type axiovrd_type,
+				enum axiovrd_sublist subtype)
+{
+	int ret = -1;
+
+	switch (die) {
+	case FS1_IO_DIE_0:
+	case FS1_IO_DIE_1:
+		switch (axiovrd_type) {
+		case lbw_axiovrd:
+			ret = (subtype == cmn_axiovrd_list) ?
+				ARRAY_SIZE(cmn_lbw_axiovrd_base) : ARRAY_SIZE(h0_lbw_axiovrd_base);
+			break;
+		case hbw_axiovrd:
+			ret = (subtype == cmn_axiovrd_list) ?
+				ARRAY_SIZE(cmn_hbw_axiovrd_base) : ARRAY_SIZE(h0_hbw_axiovrd_base);
+			break;
+		default:
+			return -1;
+		}
+		break;
+	case FS1_IO_DIE_0_HALF_1:
+	case FS1_IO_DIE_1_HALF_1:
+		switch (axiovrd_type) {
+		case lbw_axiovrd:
+			ret = (subtype == cmn_axiovrd_list) ?
+				ARRAY_SIZE(cmn_lbw_axiovrd_base) : ARRAY_SIZE(h1_lbw_axiovrd_base);
+			break;
+		case hbw_axiovrd:
+			ret = (subtype == cmn_axiovrd_list) ?
+				ARRAY_SIZE(cmn_hbw_axiovrd_base) : ARRAY_SIZE(h1_hbw_axiovrd_base);
+			break;
+		default:
+			return -1;
+		}
+		break;
+	default:
+		return -1;
+	}
+
+	return ret;
+}
+
+static uint32_t get_axiovrd_base(int die, int axiovrd_idx, enum axiovrd_type axiovrd_type,
+			  enum axiovrd_sublist subtype)
+{
+	uint32_t base = 0;
+	bool is_half_1 = false;
+
+	switch (die) {
+	case FS1_IO_DIE_0:
+	case FS1_IO_DIE_1:
+		switch (axiovrd_type) {
+		case lbw_axiovrd:
+			base = (subtype == cmn_axiovrd_list) ?
+				cmn_lbw_axiovrd_base[axiovrd_idx] :
+				h0_lbw_axiovrd_base[axiovrd_idx];
+			break;
+		case hbw_axiovrd:
+			base = (subtype == cmn_axiovrd_list) ?
+				cmn_hbw_axiovrd_base[axiovrd_idx] :
+				h0_hbw_axiovrd_base[axiovrd_idx];
+			break;
+		default:
+			return 0;
+		}
+		break;
+	case FS1_IO_DIE_0_HALF_1:
+	case FS1_IO_DIE_1_HALF_1:
+		switch (axiovrd_type) {
+		case lbw_axiovrd:
+			base = (subtype == cmn_axiovrd_list) ?
+				(cmn_lbw_axiovrd_base[axiovrd_idx] + HALF_IO_DIE_DIFF) :
+				0;
+			break;
+		case hbw_axiovrd:
+			base = (subtype == cmn_axiovrd_list) ?
+				(cmn_hbw_axiovrd_base[axiovrd_idx] + HALF_IO_DIE_DIFF) :
+				h1_hbw_axiovrd_base[axiovrd_idx];
+			break;
+		default:
+			return 0;
+		}
+		break;
+
+	default:
+		break;
+	}
+
+	if (subtype == cmn_axiovrd_list)
+		base += is_half_1 ? HALF_IO_DIE_DIFF : 0;
+
+	return base;
+}
+
+int fs_iterate_axiovrd(struct iterate_module_ctx *ctx, enum axiovrd_type axiovrd_type)
+{
+	uint32_t axiovrd_idx, die_id, base;
+	uint32_t num_axiovrd;
+	enum axiovrd_sublist subtype;
+	bool is_die_avail;
+
+	for (die_id = ctx->die_id; die_id <= ctx->die_id + 1; die_id++) {
+		is_die_avail = dev_is_die_available(die_id);
+		if (!is_die_avail)
+			continue;
+
+		for (subtype = cmn_axiovrd_list; subtype <= spec_half_axiovrd_list; subtype++) {
+			num_axiovrd = get_axiovrd_list_len(die_id, axiovrd_type, subtype);
+			if (num_axiovrd < 1)
+				continue;
+
+			for (axiovrd_idx = 0; axiovrd_idx < num_axiovrd; axiovrd_idx++) {
+				base = get_axiovrd_base(die_id, axiovrd_idx, axiovrd_type, subtype);
+				ctx->fn(base, ctx->data);
+			}
+		}
+	}
+
+	return 0;
+}
