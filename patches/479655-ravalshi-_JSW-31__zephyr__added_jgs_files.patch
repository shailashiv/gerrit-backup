diff --git a/include/zephyr/drivers/misc/common/jgs/hl_platform_defs.h b/include/zephyr/drivers/misc/common/jgs/hl_platform_defs.h
new file mode 100644
index 0000000..4d63f4a
--- /dev/null
+++ b/include/zephyr/drivers/misc/common/jgs/hl_platform_defs.h
@@ -0,0 +1,195 @@
+/*
+ * Copyright (c) 2022 Habanalabs
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef _HL_JGS_PLATFORM_DEFS_H
+#define _HL_JGS_PLATFORM_DEFS_H
+
+#include <arc/arch_utils.h> /* required for hl_util.h */
+#include <hl_utils.h>
+#include <jgs_blocks_linux_driver.h>
+#include <common_utils.h>
+
+#define HL_CFG_BASE		0x80000000
+#define HL_CFG_BASE_MASK	0x7FFFFFFF
+#define CFG_RREG32(c)		sys_read32((HL_CFG_BASE | ((c) & HL_CFG_BASE_MASK)))
+#define CFG_WREG32(c, v)	sys_write32((v), (HL_CFG_BASE | ((c) & HL_CFG_BASE_MASK)))
+
+#define CFG_RMWREG32(reg, val, mask)				\
+	do {							\
+		uint32_t tmp_ = CFG_RREG32(reg);		\
+		tmp_ &= ~(mask);				\
+		tmp_ |= ((val) << __ffs(mask));			\
+		CFG_WREG32((reg), tmp_);			\
+	} while (0)
+
+
+/*
+ * Note: Below API's should be only used with compute die 0 addresses,
+ * which performs compute die region changes (bits 31 to 28) based on die id.
+ */
+#define GT_CFG_BASE		0xA0000000
+#define GT_CFG_BASE_MASK	0xFFFFFFF
+
+#define GT_RREG32(c)							\
+	({								\
+		uint32_t die_id = intel_gpu_read_die_id();		\
+		uint32_t base = ((die_id * 1) << 28) + GT_CFG_BASE;	\
+		sys_read32((base | ((c) & GT_CFG_BASE_MASK)));		\
+	})
+
+#define GT_WREG32(c, v)							\
+	do {								\
+		uint32_t die_id = intel_gpu_read_die_id();		\
+		uint32_t base = ((die_id * 1) << 28) + GT_CFG_BASE;	\
+		sys_write32((v), (base | ((c) & GT_CFG_BASE_MASK)));	\
+	} while (0)
+
+#define GT_RMWREG32(reg, val, mask)					\
+	do {								\
+		uint32_t tmp_ = GT_RREG32(reg);				\
+		tmp_ &= ~(mask);					\
+		tmp_ |= ((val) << __ffs(mask));				\
+		GT_WREG32((reg), tmp_);					\
+	} while (0)
+
+/* TODO: should update as per fs1 cpld regmap*/
+#define CPLD_LINK_CONFIG_REG			0x25
+#define CPLD_STATUS1_REG			0x10
+#define CPLD_I2C_MASTER_SEL1			0x16
