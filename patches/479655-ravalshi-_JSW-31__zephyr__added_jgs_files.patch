@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2024 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <zephyr/kernel.h>
+#include <efuse.h>
+#include <hl_devs.h>
+#include <zephyr/logging/log.h>
+#include <fs1_fw_if.h>
+#include <fs1_efuse.h>
+
+LOG_MODULE_REGISTER(fs1_palad);
+
+bool dev_is_die_available(enum fs1_die_id target_die_id)
+{
+	int32_t ret;
+	uint32_t available_dies;
+	uint32_t is_target_die_available;
+	const struct device *efuse_dev = EFUSE_DEV_INST;
+
+	ret = efuse_read_word(efuse_dev, EFUSE_PALAD_AVAILABLE_DIES_OFFSET, &available_dies);
+	if (ret) {
+		LOG_ERR("efuse_read_word failed for offset:0x%x",
+			EFUSE_PALAD_AVAILABLE_DIES_OFFSET);
+		return false;
+	}
+
+	available_dies = (available_dies & PALAD_AVAILABLE_DIES_M);
+	is_target_die_available = (BIT(target_die_id) & available_dies) ? 1 : 0;
+
+	return is_target_die_available;
+}
