+				num_of_irqs = <1>;
+				msg_data = <514>;
+				intr_info;
+				node_label = "INTEL_FS_ICTL_84";
+				label = "INTEL_FS_ICTL_84";
+				msg_id = <2>;
+				int_cfg_reg_start_idx = <4>;
+				int_cfg_reg_end_idx = <6>;
+				bit_map = <0xffffffff 0x7fffffff 0xfffffffe>;
+				status = "okay";
+			};
+
+			ictl85: intel_fs-ictl85@f9cd12f0 {
+				compatible = "intel,fs-ictl";
+				reg = <0xf9cd12f0 0x10>;
+				interrupt-controller;
+				#interrupt-cells = <2>;
+				#address-cells = <1>;
+				interrupts = <85 3>;
+				interrupt-parent = <&intc>;
+				num_of_irqs = <1>;
+				msg_data = <515>;
+				intr_info;
+				node_label = "INTEL_FS_ICTL_85";
+				label = "INTEL_FS_ICTL_85";
+				msg_id = <3>;
+				int_cfg_reg_start_idx = <7>;
+				int_cfg_reg_end_idx = <15>;
+				bit_map = <0xffffffff 0xffffffff 0xffffffff
+					   0xffffffff 0xffffffff 0xffffffff
+					   0xffffffff 0xffffffff 0xffffffff>;
+				status = "okay";
+			};
+
+			ictl86: intel_fs-ictl86@f9cd1300 {
+				compatible = "intel,fs-ictl";
+				reg = <0xf9cd1300 0x10>;
+				interrupt-controller;
+				#interrupt-cells = <2>;
+				#address-cells = <1>;
+				interrupts = <86 3>;
+				interrupt-parent = <&intc>;
+				num_of_irqs = <1>;
+				msg_data = <516>;
+				intr_info;
+				node_label = "INTEL_FS_ICTL_86";
+				label = "INTEL_FS_ICTL_86";
+				msg_id = <4>;
+				int_cfg_reg_start_idx = <16>;
+				int_cfg_reg_end_idx = <17>;
+				bit_map = <0xffffffff 0xffffffff>;
+				status = "okay";
+			};
+
+			ictl87: intel_fs-ictl87@f9cd1310 {
+				compatible = "intel,fs-ictl";
+				reg = <0xf9cd1310 0x10>;
+				interrupt-controller;
+				#interrupt-cells = <2>;
+				#address-cells = <1>;
+				interrupts = <87 3>;
+				interrupt-parent = <&intc>;
+				num_of_irqs = <1>;
+				msg_data = <517>;
+				intr_info;
+				node_label = "INTEL_FS_ICTL_87";
+				label = "INTEL_FS_ICTL_87";
+				msg_id = <5>;
+				int_cfg_reg_start_idx = <5>;
+				int_cfg_reg_end_idx = <6>;
+				bit_map = <0x80000000 0x00000001>;
+
+				/*
+				 * Destination ARC for ictl87 is PID,
+				 * As per the initial design decision, This interrupt is handled by
+				 * MGMT as a PSOC Direct interrupt and forwarded to PID via
+				 * FW Mailbox.
+				 * M2W block is disabled for this interrupt. as of now!
+				 */
+				status = "disabled";
+			};
+
+			gpio0: gpio@f9cca000 {
+				status = "disabled";
+				compatible = "arm,cmsdk-gpio";
+				reg = <0xf9cca000 0x1000>;
+				gpio-controller;
+				#gpio-cells = <2>;
+				node_label = "GPIO_0";
+				label = "GPIO_0";
+			};
+
+			spi0: spi@f9cb3000 {
+				status = "disabled";
+				compatible = "snps,designware-spi";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				reg = <0xf9cb3000  0x100>;
+				clocks = <&refclk>;
+				interrupts = <141 2>;
+				fifo-depth = <16>;
+				max-xfer-size = <32>;
+				cs-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
+				node_label = "SPI_0";
+				label = "SPI_0";
+
+				flash0: flash@0 {
+					status = "disabled";
+					compatible = "jedec,spi-nor";
+					reg = <0 0 0xf9ca4420 0xf9cb4040 0 0 0 0 0>;
+					reg-names = "spi_dev_idx", "cfg_base_h", "spi_pad_sel",
+						    "spi_mem_en", "mmio_wo_addr", "wo_tmr_mx_h",
+						    "wo_tmr_mx_l", "wo_tmr_mx_cfg_h",
+							"wo_tmr_mx_cfg_l";
+					spi-max-frequency = <25000000>;
+					node_label = "MX25U1633FZUI";
+					label = "MX25U1633FZUI";
+					jedec-id = [c2 2b 25];
+					size = <0x1000000>;
+					flash_wo_time_sec = <30>;
+				};
+			};
+
+			i2c0: i2c@f9cb0000 {
+				status = "disabled";
+				compatible = "snps,designware-i2c";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				reg = <0xf9cb0000 0x100>;
+				interrupts = <137 1>;
+				clock-frequency = <I2C_BITRATE_FAST_PLUS>;
+				node_label = "I2C_0";
+				label = "I2C_0";
+				sda-hold-time-ns = <100>;
+			};
+
+			i2c1: i2c@f9cb1000 {
+				status = "disabled";
+				compatible = "snps,designware-i2c";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				reg = <0xF9CB1000 0x100>;
+				interrupts = <138 1>;
+				clock-frequency = <I2C_BITRATE_FAST_PLUS>;
+				node_label = "I2C_1";
+				label = "I2C_1";
+				sda-hold-time-ns = <100>;
+
+				eeprom: eeprom@54 {
+					status = "disabled";
+					compatible = "atmel,at24";
+					reg = <0x54>;
+					pagesize = <16>;
+					size = <512>;
+					address-width = <8>;
+					timeout = <4>;
+					node_label = "EEPROM_FW";
+					label = "EEPROM_FW";
+				};
+			};
+
+			/* ictl88-ictl89 are reserved and unused */
+		};
+
+		dup_eng0_io: dup@DUP_ENGINE_IO_REGION_0_OFFSET {
+			status = "disabled";
+			reg = <0xf9cfc000 0x1000 0xf9cfe000 0x1000>;
+			reg-names = "region", "cmn";
+			compatible = "intel,fs_dup";
+			push_addr = <PREFIX_0X(DUP_ENGINE_IO_REGION_0_PUSH_BASE)>;
+			node_label = "FS_IO_DUP_0";
+			label = "FS_IO_DUP_0";
