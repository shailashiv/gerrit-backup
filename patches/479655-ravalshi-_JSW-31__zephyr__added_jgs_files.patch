+	};
+
+	soc {
+
+		intel_gpu_intr: intel-gpu_intr {
+			compatible = "intel,gpu_intr";
+			label = "INTEL_GPU_INTR";
+			/*
+			 * Level 1:  85
+			 * Level 2: 168
+			 */
+			interrupts = <43093 3>;
+			interrupt-parent = <&intc>;
+			interrupt-names = "psoc_spi_arc";
+		};
+
+		/* IMPORTANT: there is a need to validate each property and its value */
