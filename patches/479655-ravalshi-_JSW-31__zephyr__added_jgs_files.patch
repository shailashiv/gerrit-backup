+static uint32_t get_axiovrd_base(int die, int axiovrd_idx, enum axiovrd_type axiovrd_type)
+{
+	uint32_t base = 0;
+
+	switch (axiovrd_type) {
+	case lbw_axiovrd:
+		base = cmn_lbw_axiovrd_base[axiovrd_idx];
+		break;
+	case hbw_axiovrd:
+		base = cmn_hbw_axiovrd_base[axiovrd_idx];
+		break;
+	default:
+		LOG_ERR("Illegal axiovrd type %d\n", axiovrd_type);
+	}
+
+	return base;
+}
+
+int fs_comp_iterate_axiovrd(struct iterate_module_ctx *ctx, enum axiovrd_type axiovrd_type)
+{
+	uint32_t axiovrd_idx, die_id, base;
+	uint32_t num_axiovrd = 0;
+	bool is_die_avail;
+
+	/* how to iterate over all comp dies ? */
+	for (die_id = ctx->die_id; die_id <= (ctx->die_id + 1); die_id++) {
+		is_die_avail = dev_is_die_available(die_id);
+		if (!is_die_avail)
+			continue;
+
+		switch (axiovrd_type) {
+		case lbw_axiovrd:
+			num_axiovrd = ARRAY_SIZE(cmn_lbw_axiovrd_base);
+			break;
+		case hbw_axiovrd:
+			num_axiovrd = ARRAY_SIZE(cmn_hbw_axiovrd_base);
+			break;
+		default:
+			LOG_ERR("Illegal axiovrd type %d\n", axiovrd_type);
+			return -1;
+		}
+
+		if (num_axiovrd < 1)
+			return 0;
+
+		for (axiovrd_idx = 0; axiovrd_idx < num_axiovrd; axiovrd_idx++) {
+			base = get_axiovrd_base(die_id, axiovrd_idx, axiovrd_type);
+			if (base)
+				ctx->fn(base, ctx->data);
+		}
+	}
+
+	return 0;
+}
