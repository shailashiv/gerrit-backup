diff --git a/soc/intel/gpu/jgs/soc.c b/soc/intel/gpu/jgs/soc.c
new file mode 100644
index 0000000..de49796
--- /dev/null
+++ b/soc/intel/gpu/jgs/soc.c
@@ -0,0 +1,138 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2024 Intel, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <zephyr/device.h>
+#include <zephyr/init.h>
+#include "soc.h"
+#include <stdio.h>
+#include <zephyr/kernel.h>
+#include <zephyr/init.h>
+#include <zephyr/irq.h>
+#include <zephyr/irq_nextlevel.h>
+
+static const struct device *arch_irq_get_device_ptr(unsigned int irq)
+{
+	char label[20];
+
+	snprintf(label, sizeof(label), "INTEL_FS_ICTL_%d", ARCV2_IRQ_NUMBER(irq));
+	return device_get_binding(label);
+}
+
+void arch_irq_enable(unsigned int irq)
+{
+#ifdef CONFIG_MULTI_LEVEL_INTERRUPTS
+	const struct device *dev;
+#endif
+
+	z_arc_v2_irq_unit_int_enable(ARCV2_IRQ_NUMBER(irq));
+#ifdef CONFIG_MULTI_LEVEL_INTERRUPTS
+	dev = arch_irq_get_device_ptr(irq);
+	if (dev)
+		irq_enable_next_level(dev, FS_IRQ_NUMBER(irq));
+#endif
+}
+
+void arch_irq_disable(unsigned int irq)
+{
+	const struct device *dev;
+
+	dev = arch_irq_get_device_ptr(irq);
+	if (!dev) {
+		z_arc_v2_irq_unit_int_disable(ARCV2_IRQ_NUMBER(irq));
+		return;
+	}
+
+#ifdef CONFIG_MULTI_LEVEL_INTERRUPTS
+	irq_disable_next_level(dev, FS_IRQ_NUMBER(irq));
+
+	if (!irq_is_enabled_next_level(dev)) {
+		z_arc_v2_irq_unit_int_disable(ARCV2_IRQ_NUMBER(irq));
+	}
+#endif
+}
+
+int arch_irq_is_enabled(unsigned int irq)
+{
+	const struct device *dev;
+
+	dev = arch_irq_get_device_ptr(irq);
+	if (!dev) {
+		return z_arc_v2_irq_unit_int_enabled(ARCV2_IRQ_NUMBER(irq));
+	}
+
+#ifdef CONFIG_MULTI_LEVEL_INTERRUPTS
+	return irq_line_is_enabled_next_level(dev, FS_IRQ_NUMBER(irq));
+#else
+	return z_arc_v2_irq_unit_int_enabled(ARCV2_IRQ_NUMBER(irq));
+#endif
+}
+
+void arch_irq_mask(unsigned int irq)
+{
+#ifdef CONFIG_MULTI_LEVEL_INTERRUPTS
+	const struct device *dev;
+
+	dev = arch_irq_get_device_ptr(irq);
+	if (dev)
+		irq_mask_next_level(dev, FS_IRQ_NUMBER(irq));
+#endif
+}
+
+void arch_irq_unmask(unsigned int irq)
+{
+#ifdef CONFIG_MULTI_LEVEL_INTERRUPTS
+	const struct device *dev;
+
+	dev = arch_irq_get_device_ptr(irq);
+	if (dev)
+		irq_unmask_next_level(dev, FS_IRQ_NUMBER(irq));
+#endif
+}
+
+void arch_irq_init(unsigned int irq)
+{
+#ifdef CONFIG_MULTI_LEVEL_INTERRUPTS
+	const struct device *dev;
+
+	dev = arch_irq_get_device_ptr(irq);
+	if (dev)
+		irq_late_init_next_level(dev, FS_IRQ_NUMBER(irq));
+#endif
+}
+
+void arch_irq_clear(unsigned int irq)
+{
+#ifdef CONFIG_MULTI_LEVEL_INTERRUPTS
+	const struct device *dev;
+
+	dev = arch_irq_get_device_ptr(irq);
+	if (dev)
+		irq_clear_next_level(dev, FS_IRQ_NUMBER(irq));
+#endif
+}
+
+#define ARC_NUM_TIMER_IRQS      2
+
+static int arc_jgs_init(const struct device *dev)
+{
+	ARG_UNUSED(dev);
+
+	uint32_t i, start;
+
+	/*
+	 * Disable all interrupts as part of init except for exception
+	 * and timer interrupts
+	 */
+	start = CONFIG_GEN_IRQ_START_VECTOR + ARC_NUM_TIMER_IRQS;
+	for (i = start; i < CONFIG_NUM_IRQS; i++) {
+		z_arc_v2_irq_unit_int_disable(i);
+	}
+
+	return 0;
+}
+
+SYS_INIT(arc_jgs_init, PRE_KERNEL_1, CONFIG_KERNEL_INIT_PRIORITY_DEFAULT);
diff --git a/soc/intel/gpu/jgs/soc.h b/soc/intel/gpu/jgs/soc.h
new file mode 100644
index 0000000..14976b4
--- /dev/null
+++ b/soc/intel/gpu/jgs/soc.h
@@ -0,0 +1,52 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2024 Intel, Ltd.
+ * All Rights Reserved.
+ */
+
+#ifndef _SOC_H_
+#define _SOC_H_
+
+#include <zephyr/sys/util.h>
+
+/* ARC fs1 Core IRQs */
+#define IRQ_TIMER0	16
+#define IRQ_TIMER1	17
+
+/* macros related to interrupt handling */
+#define ARCV2_IRQ_NUM_SHIFT		0
+#define INTEL_GPU_IRQ_NUM_SHIFT		8
+#define ARCV2_IRQ_NUM_MASK		0xFF
+#define INTEL_GPU_IRQ_NUM_MASK		0xFFFF
+
+#define ARCV2_IRQ_NUMBER(_irq) \
+	((_irq >> ARCV2_IRQ_NUM_SHIFT) & ARCV2_IRQ_NUM_MASK)
+#define FS_IRQ_NUMBER(_irq) \
+	(((_irq >> INTEL_GPU_IRQ_NUM_SHIFT) & INTEL_GPU_IRQ_NUM_MASK) - 1)
+
+/* Macro that aggregates the bi-level interrupt into an IRQ number */
+#define SOC_AGGREGATE_IRQ(irq_l2, irq_l1)		\
+	( \
+	 ((irq_l1 & ARCV2_IRQ_NUM_MASK) << ARCV2_IRQ_NUM_SHIFT) | \
+	 (((irq_l2 + 1) & INTEL_GPU_IRQ_NUM_MASK) << INTEL_GPU_IRQ_NUM_SHIFT) \
+	)
+
+/*
+ * ARC1 released from reset first, so its ID in HW is always default 0.
+ * other ARCs ID is set relatively to ARC1.
+ * return normalized cpu id: arc0 = 0, arc1 = 1, arc2 = 2
+ */
+#define FS_ARC_V2_CORE_ID()			\
+({						\
+	int8_t __id = z_arc_v2_core_id();	\
+						\
+	++__id;					\
+})
+
+void arch_irq_mask(unsigned int irq);
+void arch_irq_unmask(unsigned int irq);
+void arch_irq_init(unsigned int irq);
+void arch_irq_clear(unsigned int irq);
+
+#endif /* _SOC_H_ */
