new file mode 100644
index 0000000..39d6cb9
--- /dev/null
+++ b/drivers/misc/common_utils/gpu/fs1/gpu_utils.c
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2024 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <zephyr/kernel.h>
+#include <common_utils.h>
+#include <fs1_efuse.h>
+#include <efuse.h>
+#include <zephyr/device.h>
+#include <zephyr/logging/log.h>
+
+#include "gpu_utils.h"
+
+LOG_MODULE_REGISTER(gpu_utils);
+
+__weak bool intel_gpu_is_sim_mode(void)
+{
+	uint32_t efuse_val;
+	int rc;
+	const struct device *efuse_dev;
+
+	efuse_dev = device_get_binding("EFUSE");
+	if (!efuse_dev) {
+		LOG_ERR("failed to get eFuse device binding");
+		return false;
+	}
+
+	rc = efuse_read_word(efuse_dev, IO_EFUSE_PALAD_CFG_0_OFFSET, &efuse_val);
+
+	return efuse_val & SIM_MODE;
+}
+
+__weak bool intel_gpu_get_spi_gw_disable(void) { return false; }
+__weak uint8_t intel_gpu_get_sku_type(void) { return 0; }
+__weak bool intel_gpu_is_card_type_pcie(void) { return false; }
+
+uint32_t intel_gpu_read_die_id(void)
+{
+	return dev_read_die_id();
+}
+
+uint8_t intel_gpu_get_die_id(uint32_t addr)
+{
+	return dev_get_die_id(addr);
+}
+
+bool intel_gpu_is_cfg_addr_valid(uint32_t addr, uint8_t current_die_id,
+			       uint8_t num_dies, bool spi_gw_dis)
+{
+	return dev_is_cfg_addr_valid(addr, current_die_id, num_dies, spi_gw_dis);
+}
