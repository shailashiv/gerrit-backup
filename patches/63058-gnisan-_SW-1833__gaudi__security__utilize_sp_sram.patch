+#include <boot_info.h>
 #include "common.h"
 #include "uart.h"
 #include "fit.h"
@@ -649,6 +650,7 @@
 		break;
 	}
 
+	boot_info_finalize();
 	preboot_start_image(startaddr);
 }
 
