index f70fc39..79c5fe7 100644
--- a/goya2_arc_gnu/common.h
+++ b/goya2_arc_gnu/common.h
@@ -21,6 +21,12 @@
 #define PPBOOT_TEXT_BASE	(FW_SRAM_BASE + 0xC)
 #define PREBOOT_TEXT_BASE	(SP_SRAM_BASE + SP_SRAM_PREBOOT_OFFSET + 0x8)
 
+/*
+ * TODO: this address is wrong, a good address must be set in order to use
+ * boot info API.
+ */
+#define BOOT_INFO_BASE		SP_SRAM_BASE
+
 #define FUSE_WORDS_PER_BANK	0x40
 #define I2C_SLAVE_ADDRESS	0x6A
 #define I2C_SLAVE_ADDRESS_DBG	I2C_SLAVE_ADDRESS
diff --git a/include/boot_info.h b/include/boot_info.h
new file mode 100644
index 0000000..9d5558e
--- /dev/null
+++ b/include/boot_info.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Copyright (C) 2017-2020 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+#ifndef _BOOT_INFO_H_
+#define _BOOT_INFO_H_
+
+#include <preboot.h>
+
+void boot_info_finalize(void);
+int boot_info_set(u32 type, const void *data, u32 size);
+
+#endif /* _BOOT_INFO_H_ */
diff --git a/preboot/boot_info.c b/preboot/boot_info.c
new file mode 100644
index 0000000..4e27182
--- /dev/null
+++ b/preboot/boot_info.c
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2017-2020 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+#include <string.h>
+#include <stdbool.h>
+#include <preboot.h>
+#include <hl_boot_desc.h>
+#include <common.h>
+#include <sha256.h>
+
+#include "boot_info.h"
+#include "uart.h"
+
+#define MAX_INFO_DESCS	5
+
+#define ROUND_UP4(n)	(((n) + sizeof(u32) - 1) & ~(sizeof(u32) - 1))
+#define BOOT_INFO_SZ	(sizeof(struct hl_boot_info_ptrs) + \
+			sizeof(struct hl_boot_info_desc) * MAX_INFO_DESCS)
+
+struct boot_info {
+	union {
+		struct {
+			struct hl_boot_info_ptrs ptrs;
+			struct hl_boot_info_desc descs[MAX_INFO_DESCS];
+		};
+		u32 data[ROUND_UP4(BOOT_INFO_SZ) / sizeof(u32)];
+	};
+};
+
+static struct boot_info boot_info = { .ptrs = { .count = 0 } };
+
+static inline void *offset2ptr(u32 offset, uintptr_t base)
+{
+	return (void *)(base + offset);
+}
+
+static inline u32 ptr2offset(const void *ptr, uintptr_t base)
+{
+	return (u32)((uintptr_t)ptr) - base;
+}
+
+static bool boot_info_type_is_exists(u32 type)
+{
+	int i;
+
+	for (i = 0; i < boot_info.ptrs.count; i++)
+		if (boot_info.descs[i].type == type)
+			return true;
+
+	return false;
+}
+
+void boot_info_finalize(void)
+{
+	struct hl_boot_info_desc *desc;
+	u32 offsets[MAX_INFO_DESCS];
+	u32 offset, copy_sz;
+	const u32 *src;
+	u32 *dst;
+	int i, j;
+
+	if (!boot_info.ptrs.count)
+		return;
+
+	boot_info.ptrs.magic = HL_BOOT_INFO_MAGIC;
+
+	/* Data offset */
+	offset = sizeof(struct hl_boot_info_ptrs) +
+		(sizeof(struct hl_boot_info_desc) + sizeof(u32)) *
+		boot_info.ptrs.count;
+
+	dst = offset2ptr(offset, BOOT_INFO_BASE);
+
+	/* Store data */
+	for (i = 0; i < boot_info.ptrs.count; i++) {
+		desc = &boot_info.descs[i];
+		src = offset2ptr(desc->offset, PREBOOT_TEXT_BASE);
+		sha256_csum((u8 *)src, desc->size, desc->chksum);
+		copy_sz = ROUND_UP4(desc->size);
+
+		for (j = 0; j < copy_sz / sizeof(u32); j++)
+			dst[j] = src[j];
+
+		desc->offset = ptr2offset(dst, BOOT_INFO_BASE);
+		dst += j;
+	}
+
+	/* Store descriptors */
+	offset = sizeof(struct hl_boot_info_ptrs) +
+		(sizeof(u32)) * boot_info.ptrs.count;
+	dst = offset2ptr(offset, BOOT_INFO_BASE);
+	for (i = 0; i < boot_info.ptrs.count; i++) {
+		src = (u32 *)&boot_info.descs[i];
+		copy_sz = ROUND_UP4(sizeof(struct hl_boot_info_desc));
+
+		for (j = 0; j < copy_sz / sizeof(u32); j++)
+			dst[j] = src[j];
+
+		offsets[i] = ptr2offset(dst, BOOT_INFO_BASE);
+		dst += j;
+	}
+
+	/* Store offsets array */
+	offset = sizeof(struct hl_boot_info_ptrs);
+	dst = offset2ptr(offset, BOOT_INFO_BASE);
+	for (i = 0; i < boot_info.ptrs.count; i++)
+		dst[i] = offsets[i];
+
+	/* Store the ptr */
+	dst = offset2ptr(0, BOOT_INFO_BASE);
+	for (i = 0; i < sizeof(boot_info.ptrs) / sizeof(u32); i++)
+		dst[i] = boot_info.data[i];
+}
+
+int boot_info_set(u32 type, const void *data, u32 size)
+{
+	struct hl_boot_info_desc *desc;
+
+	if (boot_info.ptrs.count >= MAX_INFO_DESCS) {
+		preboot_puts_hex("No room to store boot info type: ", type, 0);
+		return 1;
+	}
+
+	if (boot_info_type_is_exists(type)) {
+		preboot_puts_hex("Boot info type already exists: ", type, 0);
+		return 1;
+	}
+
+	desc = &boot_info.descs[boot_info.ptrs.count];
+	desc->type = type;
+	desc->size = size;
+	desc->magic = HL_BOOT_INFO_DESC_MAGIC | type;
+	/* Store offset relative to preboot text */
+	desc->offset = ptr2offset(data, PREBOOT_TEXT_BASE);
+	boot_info.ptrs.count++;
+
+	return 0;
+}
diff --git a/preboot/fit.c b/preboot/fit.c
index b7b3179..6bccd43 100644
--- a/preboot/fit.c
+++ b/preboot/fit.c
@@ -11,6 +11,7 @@
 #include <preboot.h>
