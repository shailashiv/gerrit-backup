index 0df56d6..910682c 100644
--- a/goya2/common.h
+++ b/goya2/common.h
@@ -19,6 +19,12 @@
 #define PPBOOT_TEXT_BASE		0x7FF0000000
 #define PREBOOT_TEXT_BASE		(PPBOOT_TEXT_BASE + PPBOOT_SIZE)
 
+/*
+ * TODO: this address is wrong, a good address must be set in order to use
+ * boot info API.
+ */
+#define BOOT_INFO_BASE			HL_SP_SRAM_BASE
+
 #define FUSE_WORDS_PER_BANK		0x40
 #define I2C_SLAVE_ADDRESS		0x6A
 #define I2C_SLAVE_ADDRESS_DBG		0x47
