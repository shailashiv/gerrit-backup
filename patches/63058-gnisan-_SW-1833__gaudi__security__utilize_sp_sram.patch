From 937d322a2e2a3160c72a8158bd70a3901da4b851 Mon Sep 17 00:00:00 2001
From: Guy Nisan <gnisan@habana.ai>
Date: Mon, 30 Nov 2020 00:39:52 +0200
Subject: [PATCH] [SW-1833] gaudi: security: utilize sp sram

Use SP SRAM in order to store the OTP and eFuse security information.
This is needed in order to provide u-boot with security data in early
boot stages when flash driver access is limited.

This review uses boot info descriptors instead of known offset.

Change-Id: I95b30577dcf20eebb95a8657645c73b9d7e84090
Signed-off-by: Guy Nisan <gnisan@habana.ai>
(cherry picked from commit 88389a890093d64010f83922dc347c9028c60723)
---

diff --git a/gaudi/common.h b/gaudi/common.h
index 0cf5524..f58b515 100644
--- a/gaudi/common.h
+++ b/gaudi/common.h
@@ -14,6 +14,8 @@
 #define HL_SP_SRAM_BASE			0x7FFBFE0000
 #define HL_SP_SRAM_SIZE			0x10000
 
+#define BOOT_INFO_BASE			HL_SP_SRAM_BASE
+
 #define HL_FW_BOOT_PTRS_BASE		0x60000
 #define HL_SPI_LEGACY_PREBOOT_OFF	0xA0000
 
diff --git a/gaudi/security.c b/gaudi/security.c
index fe84029..ebfa699 100644
--- a/gaudi/security.c
+++ b/gaudi/security.c
@@ -47,7 +47,9 @@
 #include <preboot.h>
 #include <uart.h>
 #include <hl_boot_if.h>
+#include <hl_boot_desc.h>
 #include <boot_if.h>
+#include <boot_info.h>
 #include <string.h>
 #include <efuse.h>
 #include <gaudi/gaudi_security.h>
@@ -125,13 +127,13 @@
 	return otp;
 }
 
+#ifdef FUSE_SUPPORT
 static const struct hl_sec_efuse *preboot_security_get_fuse(void)
 {
 	struct hl_sec_efuse *fuse;
 	u32 *val;
 	int i;
 
-#ifdef FUSE_SUPPORT
 	if (preboot_security_fuse_cache.is_invalid) {
 		fuse = &preboot_security_fuse_cache.fuse;
 
@@ -142,8 +144,24 @@
 		}
 		preboot_security_fuse_cache.is_invalid = false;
 	}
-#else
+
+	return &preboot_security_fuse_cache.fuse;
+}
+
+static void preboot_security_sp_sram_write_efuse(void)
+{
+	/* Do nothing for real eFuse */
+}
+
+#else /* FUSE_SUPPORT */
+
 #define FAKE_FUSE_OFFSET ((2 * 1024 * 1024) + (64 * 1024))
+static const struct hl_sec_efuse *preboot_security_get_fuse(void)
+{
+	struct hl_sec_efuse *fuse;
+	u32 *val;
+	int i;
+
 	if (preboot_security_fuse_cache.is_invalid) {
 		fuse = &preboot_security_fuse_cache.fuse;
 
@@ -159,9 +177,37 @@
 
 		preboot_security_fuse_cache.is_invalid = false;
 	}
-#endif
 
 	return &preboot_security_fuse_cache.fuse;
+}
+
+static void preboot_security_sp_sram_write_efuse(void)
+{
+	const struct hl_sec_efuse *efuse;
+
+	efuse = preboot_security_get_fuse();
+	if (!efuse)
+		return;
+
+	boot_info_set(HL_BOOT_INFO_SECURITY_FUSE, efuse, sizeof(*efuse));
+}
+#endif /* FUSE_SUPPORT */
+
+static void preboot_security_sp_sram_write_otp(void)
+{
+	const struct hl_sec_otp *otp;
+
+	otp = preboot_security_get_otp();
+	if (!otp)
+		return;
+
+	boot_info_set(HL_BOOT_INFO_SECURITY_OTP, otp, sizeof(*otp));
+}
+
+static void preboot_security_sp_sram_init(void)
+{
+	preboot_security_sp_sram_write_otp();
+	preboot_security_sp_sram_write_efuse();
 }
 
 bool preboot_security_key_is_valid(int key_idx, const void *pub_key,
@@ -1363,6 +1409,10 @@
 		preboot_security_pci_disable();
 		preboot_puts("Security is disabled\n");
 	}
+
+	/* Store security info to be used by the booted image */
+	preboot_security_sp_sram_init();
+
 	cpu_boot_dev_sts_clrset(CPU_BOOT_DEV_STS0_SECURITY_EN, is_sec_en);
 
 	cpu_boot_err_clrset(CPU_BOOT_ERR0_SECURITY_NOT_RDY, false);
diff --git a/goya/common.h b/goya/common.h
index 5bfcc1e..265e0f1 100644
--- a/goya/common.h
+++ b/goya/common.h
@@ -15,6 +15,12 @@
 #define PPBOOT_TEXT_BASE	0x7FF0000000
 #define PREBOOT_TEXT_BASE	(PPBOOT_TEXT_BASE + PPBOOT_SIZE)
 
+/* Scratchpad SRAM (32KB) */
+#define HL_SP_SRAM_BASE		0x7FF9000000
+#define HL_SP_SRAM_SIZE		0x8000
+
+#define BOOT_INFO_BASE		HL_SP_SRAM_BASE
+
 #define FUSE_WORDS_PER_BANK	0x10
 #define I2C_SLAVE_ADDRESS	0x4f
 #define I2C_SLAVE_ADDRESS_DBG	0x47
