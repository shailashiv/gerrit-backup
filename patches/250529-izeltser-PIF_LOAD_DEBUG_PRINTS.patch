+	return false; //hl_is_debug_mode(HL_DEBUG_HW_PCIE);
 }
 
 u64 hl_pll_timestamp_freq_get(void)
diff --git a/arch/gaudi3/arc/common.c b/arch/gaudi3/arc/common.c
index 55ddcc8..38ea070 100644
--- a/arch/gaudi3/arc/common.c
+++ b/arch/gaudi3/arc/common.c
@@ -752,6 +752,7 @@
 	u32 addr, actual_size;
 	unsigned int num_crc;
 	int ret;
+	u64 ts_start, ts_end;
 
 	num_crc = ppboot_get_num_crc(desc->img_size);
 	actual_size = desc->img_size - (num_crc * CRC32_SIZE);
@@ -761,7 +762,10 @@
 		return false;
 	}
 
+	ts_start = timestamp_get_us();
 	ret = secureboot_verify_image_hash384(desc->chksum, (unsigned char *)addr, actual_size);
+	ts_end = timestamp_get_us();
+	preboot_puts_hex64("valid_img dur ", ts_end - ts_start, false);
 
 	return !ret;
 }
@@ -784,6 +788,7 @@
 	u32 buff_addr;
 	u32 ccm_terminate_reg = data->cpu_cfg_base + PIF_CCM_TERM_OFF;
 	u32 mem_addr = ppboot_get_arc_addr(desc->loadaddr);
+	u64 ts_end1, ts_end2, ts_start;
 
 	/* By default CCM termination is enabled, should be disabled when accessing the CCMs */
 	regmap_writel(~CCM_TERMINATE_MASK, ccm_terminate_reg);
@@ -794,9 +799,15 @@
 	 * copying PIF_ARC_CCM_SIZE of bytes, in a single memcpy the image is copied
 	 * from ICCM1 to PIF CCM, and the rest of the PIF CCM is initialized.
 	 */
+	preboot_puts_hex("copying image to ", mem_addr, false);
+	ts_start = timestamp_get_us();
 	memcpy((void *)mem_addr, (void *)buff_addr, PIF_ARC_CCM_SIZE);
+	ts_end1 = timestamp_get_us();
 	/* wait for all writes to complete */
 	HL_ARC_W_BARRIER();
+	ts_end2 = timestamp_get_us();
+	preboot_puts_hex64("memcpy dur ", ts_end1 - ts_start, false);
+	preboot_puts_hex64("mem_init dur ", ts_end2 - ts_start, false);
 
 	regmap_writel(CCM_TERMINATE_MASK, ccm_terminate_reg);
 }
@@ -821,7 +832,9 @@
 	enum hl_fw_img_type img_type;
 	u32 idx;
 	bool is_psoc_mem;
+	u64 ts_start, ts_end;
 
+	preboot_puts(">> ppboot_copy_pif_arc_img\n");
 	img_type = data->img_type[data->img_idx];
 	idx = boot_desc_get_img_desc(FLOPS_UPD_NOOP, img_type, &desc);
 	if (idx == HL_FW_IMG_NOT_FOUND) {
@@ -829,6 +842,11 @@
 		return -1;
 	}
 
+	preboot_puts_hex("spi offset: ", desc.spi_offset, false);
+	preboot_puts_hex64("dest addr ", desc.loadaddr, false);
+	preboot_puts_hex("img size ", desc.img_size, false);
+
+	ts_start = timestamp_get_us();
 	dma_type = preboot_get_dma_dest_type(data->inter_buffer_addr);
 	is_psoc_mem = preboot_is_dma_dest_psoc_mem(data->inter_buffer_addr);
 
@@ -846,10 +864,17 @@
 		return -1;
 	}
 
+	ts_end = timestamp_get_us();
+	preboot_puts_hex64("dma_copy dur ", ts_end - ts_start, false);
+
+	preboot_puts("spi copy finished successfully\n");
+
 	if (!pif_is_valid_image(data, &desc)) {
 		preboot_puts("pif fw hash validation failed\n");
 		return -1;
 	}
+
+	preboot_puts("image is valid\n");
 
 	pif_arc_mem_init(data, &desc);
 
@@ -866,6 +891,7 @@
 	u32 run_req_reg = data->cpu_cfg_base + PIF_RUN_HALT_REQ_OFF;
 	u64 start;
 
+	preboot_puts(">> ppboot_run_pif_arc\n");
 	/* Set ARC in running state */
 	regmap_writel(D0_PIF_ARC_RUN_HALT_REQ_RUN_REQ_M, run_req_reg);
 
@@ -892,6 +918,7 @@
 	u32 val;
 	u64 start;
 
+	preboot_puts(">> ppboot_halt_n_reset_pif_arc\n");
 	/* Check if already in reset state */
 	val = regmap_readl(rst_reg);
 	if (val & D0_PIF_ARC_ARC_RST_CORE_M)
@@ -928,6 +955,7 @@
 	u32 rst_vec_reg = data->cpu_cfg_base + PIF_RST_VEC_ADDR_OFF;
 	u32 rst_reg = data->cpu_cfg_base + PIF_ARC_RST_OFF;
 
+	preboot_puts(">> ppboot_load_and_run_pif_arc\n");
 	ppboot_halt_n_reset_pif_arc(data->cpu_cfg_base);
 
 	/*
@@ -959,6 +987,7 @@
 	}
 
 	ppboot_run_pif_arc(data);
+	preboot_puts("<< ppboot_load_and_run_pif_arc\n");
 }
 
