diff --git a/app/ppboot/ppboot.c b/app/ppboot/ppboot.c
index bbffefa..0b20022 100644
--- a/app/ppboot/ppboot.c
+++ b/app/ppboot/ppboot.c
@@ -287,34 +287,50 @@
 	device_init_pll(); /* used for uart and delay */
 }
 
-static void ppboot_time_critical_section_start(void)
-{
-	/* prints are stored in mem buffer */
-	preboot_uart_rbuf_init();
-}
+// static void ppboot_time_critical_section_start(void)
+// {
+// 	/* prints are stored in mem buffer */
+// 	preboot_uart_rbuf_init();
+// }
 
-static void ppboot_time_critical_section_end(void)
-{
-	preboot_uart_rbuf_flush();
-	preboot_uart_rbuf_disable();
-}
+// static void ppboot_time_critical_section_end(void)
+// {
+// 	preboot_uart_rbuf_flush();
+// 	preboot_uart_rbuf_disable();
+// }
 
 __weak void ppboot_security_init(void) {}
 __weak void ppboot_secure_arc(void) {}
 __weak void hl_sram_self_repair(void) {}
 __weak void ppboot_init_fw_info(void) {}
 __weak void ppboot_plls_init(void) {}
-__weak void hl_pcie_enable_elbi_access(void) {}
-__weak void ppboot_tpm_extend(void) {}
+
+#define CPU_PLL_FREQ_MHZ	1000
+
+static inline void udelaytest(unsigned long usec)
+{
+
+	unsigned long loops = CPU_PLL_FREQ_MHZ * usec;
+
+       __asm__ __volatile__(
+       "       mov lp_count, %0        \n"
+       "       lp  1f                  \n"
+       "       nop                     \n"
+       "1:                             \n"
+       :
+        : "r"(loops)
+        : "lp_count");
+}
 
 void ppboot_main(void)
 {
 	u64 loadaddr;
 	bool ret;
+	u64 t1, t2;
 
 	ppboot_init_stack_monitor();
 	/************time critical section**************/
-	ppboot_time_critical_section_start();
+	// ppboot_time_critical_section_start();
 	device_init();
 	/* Set ARCs to privileged mode */
 	ppboot_secure_arc();
@@ -335,16 +351,14 @@
 	hl_uart_init();
 	spi_flash_prot_early();
 	ppboot_security_init();
+
+	t1 = timestamp_get_us();
+	udelaytest(1000);
+	t2 = timestamp_get_us();
+	preboot_puts_hex("1ms delay = ", t2 - t1, false);
+
 	hl_pcie_init();
-	ppboot_tpm_extend();
-	/*
-	 * Enabling pcie elbi after ppboot_tpm_extend since elbi protection level
-	 * is usually secured and it can access configuration space. This access
-	 * can interfere with tpm extend.
-	 */
-	if (link_is_up)
-		hl_pcie_enable_elbi_access();
-	ppboot_time_critical_section_end();
+	// ppboot_time_critical_section_end();
 	/**********time critical section end************/
 	ppboot_pcie_drain_init();
 	ppboot_version();
