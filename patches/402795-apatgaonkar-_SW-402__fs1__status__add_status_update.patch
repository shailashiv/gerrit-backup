+	PROGRESS_DMA_ERROR,
+	PROGRESS_DMA_FINISH,
+	PROGRESS_BOOT_DESC_HDR_MAGIC_FAIL,
+	PROGRESS_BOOT_DESC_INVALID_IMG_OFFSET,
+	PROGRESS_BOOT_DESC_VERIFICATION_FAIL,
+};
+
+enum boot_rom_boot_desc_verify_progress {
+	PROGRESS_VERIFY_START,
+	PROGRESS_VERIFY_VERSION_FAIL,
+	PROGRESS_VERIFY_KEY_REVOKED,
+	PROGRESS_VERIFY_KEY_HASH_FAIL,
+	PROGRESS_VERIFY_AUTH_FAIL,
+	PROGRESS_VERIFY_SUCCESS,
+};
+
+enum boot_rom_erom_img_progress {
+	PROGRESS_EROM_BRINGUP_START,
+	PROGRESS_EROM_LOADADDR_INVALID,
+	PROGRESS_EROM_STARTADDR_INVALID,
+	PROGRESS_EROM_DMA_START,
+	PROGRESS_EROM_DMA_CRC_FAILED,
+	PROGRESS_EROM_DMA_UNALIGNED_DEST_ADDR,
+	PROGRESS_EROM_DMA_INVALID_IMG_SIZE,
+	PROGRESS_EROM_DMA_UNALIGNED_IMG_SIZE,
+	PROGRESS_EROM_DMA_ERROR,
+	PROGRESS_EROM_DMA_FINISH,
+	PROGRESS_EROM_IMG_VERIFICATION_FAIL,
+	PROGRESS_EROM_IMG_START,
+	PROGRESS_EROM_IMG_FINISH,
+};
+
+void boot_rom_status_update(enum boot_rom_progress progress);
+void boot_rom_status_update_bringup(enum boot_rom_progress progress, uint32_t position);
+void boot_rom_status_update_val(enum boot_rom_progress progress, uint32_t val, uint8_t bits);
+uint32_t boot_rom_get_status_base(void);
+
+#endif /* _STATUS_H_ */
