From b7cc19c2cff69e1d35eb80ebc0cec3f22a3a83fc Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Wed, 22 Aug 2018 11:17:25 +0300
Subject: [PATCH] BTL [Gaudi]: update BUDDIV for ONIX

We use clock of 35MHz and baudrate of 57600
---

diff --git a/board/habanalabs/common/btl/uart.s b/board/habanalabs/common/btl/uart.s
index d06b846..1a69b79 100644
--- a/board/habanalabs/common/btl/uart.s
+++ b/board/habanalabs/common/btl/uart.s
@@ -18,6 +18,8 @@
 cfg mmPSOC_UART_0_BAUDDIV, 0x17
 #elif TARGET_IS_ASIC
 cfg mmPSOC_UART_0_BAUDDIV, 0x1B2
+#elif DEV_IS_GAUDI
+cfg mmPSOC_UART_0_BAUDDIV, 0x260
 #else
 cfg mmPSOC_UART_0_BAUDDIV, 0x364
 #endif
