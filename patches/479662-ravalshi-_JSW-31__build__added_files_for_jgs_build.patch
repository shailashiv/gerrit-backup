diff --git a/board/habanalabs/jgs/jgs-image-utility.sh b/board/habanalabs/jgs/jgs-image-utility.sh
new file mode 100755
index 0000000..ef02bb6
--- /dev/null
+++ b/board/habanalabs/jgs/jgs-image-utility.sh
@@ -0,0 +1,300 @@
+source ${BR2_EXTERNAL}/board/habanalabs/common/dirs.sh
+
+BINS_CONFIG_DIR="${BR2_EXTERNAL}/output/${HL_DEV}/images/bins_config"
+
+function swap_file {
+	local INF=$1
+	local OUTF=$2
+	local DBG=${3:-}
+
+	# SWAP needs this to be 4B aligned in size
+	dd status=none conv=sync bs=4 if=${INF} > ${OUTF}.tmp
+	# Sadly --endian=big is not swapping for -tx1 so I used some gawk magic
+	od -Anone -v -tx1 -w4 ${OUTF}.tmp | gawk '{ print $4 $3 $2 $1 }' | xxd -r -p > ${OUTF}
+
+	if [ -z "$DBG" ]; then
+		rm -f ${OUTF}.tmp
+	fi
+}
+
+function rev_bytes_stdin {
+	local str=$(cat -)
+
+	local len=${#str}
+	local reverse=""
+
+	[[ $len -eq 0 || $((len % 2)) -ne 0 ]] && return 1;
+	for ((i=((len - 2)); i>=0; i-=2)); do
+		reverse+=${str:$i:2}
+	done
+
+	echo -n $reverse
+}
+
+# get_image_property - returns value of a variable named: <name><property>
+function get_image_property {
+	local name=${1^^}
+	local property=${2^^}
+	local value=$(eval "echo \${${name}${property}}")
+
+	if [ -z "$value" ]; then
+		echo "Error: no \"${name}${property}\" value exist..."
+		exit 1;
+	else
+		echo $value
+	fi
+}
+
+function get_image_fname {
+	get_image_property $1 "_BINFILE"
+}
+
+function get_image_base {
+	get_image_property $1 "_OFFSET"
+}
+
+function get_image_loadaddr {
+	get_image_property $1 "_TEXT_BASE"
+}
+
+function get_image_startaddr {
+	get_image_property $1 "_START_ADDR"
+}
+
+function get_image_size {
+	local name=${1^^}
+
+	stat -Lc "%s" $(eval "echo \${${name}_BINFILE}")
+}
+
+function hl_zephyr_objcopy_sections() {
+	local PREFIX=$1
+	local MEM=$2
+	local ALIGN=$3
+	local SECTIONS=${*:4}
+
+	${OBJCOPY} -S --gap-fill 0xff --output-target=binary --remove-section=.comment --remove-section=COMMON \
+	--remove-section=.eh_frame $(echo -n $SECTIONS | sed 's/[^ ]* */ --only-section=&/g') ${ELFS_DIR}/zephyr_${PREFIX}.elf \
+	--set-section-flags=bss=alloc,load,contents --set-section-flags=noinit=alloc,load,contents \
+	${STAGE_DIR}/zephyr-${PREFIX}-${MEM}.bin
+
+	dd status=none conv=sync bs=${ALIGN} if=${STAGE_DIR}/zephyr-${PREFIX}-${MEM}.bin > \
+	${BINS_DIR}/${DEV_PREFIX}-zephyr-${PREFIX}-${MEM}.bin
+}
+
+function hl_print_elf_sections_csv {
+	local app=$1
+
+	echo "name,size,address"
+	arc-linux-objdump -h ${ELFS_DIR}/zephyr_${app}.elf | \
+		awk '/^[ \t]+[0-9]+ [^.]/ { printf("%s,0x%s,0x%s\n", $2, $3, $4);}'
+}
+
+function hl_remove_empty_lines {
+	sed '/^[[:space:]]*$/d'
+}
+
+function hl_extract_zephyr_bins_sections {
+	local app=$1
+	local bins_file=$2
+	local sections=()
+	local bin_start
+	local bin_end
+	local sec_start
+	local sec_end
+
+	echo "Extracting sections for ${app} app"
+	while IFS=',' read -r bin_name bin_addr bin_size bin_align; do
+		echo -e "\tBinary ${bin_name} ($((${bin_size} * 1024))@${bin_addr})"
+		sections=()
+		bin_start=$((${bin_addr}))
+		bin_end=$((${bin_addr} + $((${bin_size} * 1024))))
+
+		while IFS=',' read -r sec_name sec_size sec_addr; do
+			sec_start=$((${sec_addr}))
+			sec_end=$((${sec_addr} + ${sec_size}))
+
+			if [ ${sec_start} -lt ${bin_start} -o ${sec_end} -gt ${bin_end} ]; then
+				continue
+			fi
+
+			sections+=(${sec_name})
+
+			echo -e "\t\tSection ${sec_name} ($((${sec_size}))@${sec_addr})";
+		done < <(hl_print_elf_sections_csv ${app} | tail -n +2)
+
+		hl_zephyr_objcopy_sections ${app} ${bin_name} ${bin_align} ${sections[@]}
+
+		echo ""
+
+	done < <(tail -n +2 ${bins_file} | hl_remove_empty_lines)
+}
+
+# Find a bins file which fits the app
+function hl_zephyr_get_bins {
+	local app=$1
+	local bins_file
+	local bins_app
+
+	# Try to find to closest match between an elf and its bins file
+	while [ $(echo ${app} | tr "_" " " | wc -w) -gt 0 ]; do
+		for bins_file in $(ls $BINS_CONFIG_DIR/${HL_TARGET}_*.bins); do
+			bins_app=$(echo ${bins_file} | sed "s/.*\/${HL_TARGET}_\(.*\)\.bins/\1/")
+
+			if [ "${bins_app}" == "${app}" ]; then
+				echo -n ${bins_file}
+				return
+			fi
+		done
+
+		# Remove last word
+		app=$(echo ${app} | awk -F_ 'BEGIN {OFS="_"} {NF-=1} 1')
+	done
+}
+
+# This function should be called after hl_create_zephyr_bins_config
+function hl_extract_zephyr_elf_sections {
+	local elf_file
+	local bins_file
+	local app
+
+	for elf_file in $(ls ${ELFS_DIR}/zephyr_*.elf); do
+		app=$(echo ${elf_file} | sed "s/.*\/zephyr_\(.*\)\.elf/\1/")
+		bins_file=$(hl_zephyr_get_bins ${app})
+
+		if [ -n "${bins_file}" ]; then
+			hl_extract_zephyr_bins_sections ${app} ${bins_file}
+			continue
+		fi
+	done
+}
+
+function hl_create_zephyr_bins_config {
+mkdir -p $BINS_CONFIG_DIR
+	rm $BINS_CONFIG_DIR/* -fr
+	mem_sections_hdr_path=${SPECS_EMB_PROJ_DIR}/${DEV_PREFIX}/${DEV_PREFIX}_mem_addr_dt.h
+
+	while read -r module; do
+		if echo "$module" | grep -q -E "iccm" || echo "$module" | grep -q -E "dccm"; then
+			module=$(echo "$module" | cut -d '_' -f 1)
+		fi
+
+		# TEMPORARY:
+		# Skip all the modules except "mgmt", because they are not implemented yet.
+		# Only a basic implementation of arcmgmt is being implemented for now.
+		if ! echo "$module" | grep -q -E  -e "mgmt" -e "agent"; then
+			continue;
+		fi
+
+		bins_path=$BINS_CONFIG_DIR/${HL_TARGET}_${module}.bins
+		echo "name,address,size_kb,align_bytes" > $bins_path
+		if echo "$module" | grep -q -E "io" ||  echo "$module" | grep -q -E "compute"; then
+			while read -r section; do
+				off=`grep ${module^^}_$section.*_OFFSET $mem_sections_hdr_path | sed 's/[[:space:]]\+/ /g' | cut -d ' ' -f3`
+				sz=`grep ${module^^}_$section.*_SIZE $mem_sections_hdr_path | sed 's/[[:space:]]\+/ /g' | cut -d ' ' -f3`
+				echo ${section,,},0x$off,$sz,16 >> $bins_path
+			done <<< `grep "_SECTION" $mem_sections_hdr_path | grep ${module^^} | cut -d '_' -f4| sort -u` #section
+		else
+			while read -r section; do
+				if [ "$section" == "ICCM" ] || [ "$section" == "DCCM" ]; then
+					off=`grep ${module^^}_$section.*_OFFSET $mem_sections_hdr_path | sed 's/[[:space:]]\+/ /g' | cut -d ' ' -f3`
+					sz=`grep ${module^^}_$section.*_SIZE $mem_sections_hdr_path | sed 's/[[:space:]]\+/ /g' | cut -d ' ' -f3`
+					echo ${section,,},0x$off,$sz,16 >> $bins_path
+				fi
+			done <<< `grep "_SECTION" $mem_sections_hdr_path | grep ${module^^} | cut -d '_' -f3`
+		fi
+	done <<< `grep "_SECTION" $mem_sections_hdr_path | cut -d '_' -f2,3 | tr [:upper:] [:lower:]`   #module}
+}
+
+function hl_create_section_variables {
+	local mem_sections_hdr_path=${SPECS_EMB_PROJ_DIR}/${DEV_PREFIX}/${DEV_PREFIX}_mem_addr_dt.h
+
+	while read line; do
+		export $line
+	done <<< `grep "define" $mem_sections_hdr_path | sed 's/[[:space:]]\+/ /g' | cut -d ' ' -f2-3 | sed  's/ /=/g'`
+}
+
+function get_struct_size {
+	header_file="$1"
+	struct_name="$2"
+
+	# Check if a filename is provided
+	if [ -z "$header_file" ]; then
+		echo "Usage: get_struct_size <header_file> <struct_name>"
+		exit 1
+	fi
+
+	# Check if a struct name is provided
+	if [ -z "$struct_name" ]; then
+		echo "Usage: get_struct_size <header_file> <struct_name>"
+		exit 1
+	fi
+
+	# Use gcc to preprocess the header file and calculate the size of the struct
+	size=$(echo "#include \"$header_file\"
+	#include <stdio.h>
+	int main() {
+		printf(\"%zu\", sizeof(struct $struct_name));
+		return 0;
+	}" | gcc -x c - -o tmp - && ./tmp)
+
+	if [ -z "$size" ]; then
+		echo "Error: Struct '$struct_name' not found in '$header_file'"
+		exit 1
+	else
+		echo $size
+	fi
+
+	# Clean up
+	rm -f tmp
+}
+
+function get_fake_fuse_bin_list_array {
+	HEADER_FILE="$1"
+	TARGET_ENUM="$2"
+
+	# Check if the header file exists
+	if [[ ! -f "$HEADER_FILE" ]]; then
+		echo "Header file '$HEADER_FILE' does not exist."
+		exit 1
+	fi
+
+	# Extract enum members for the specific enum using awk
+	ENUM_MEMBERS=$(awk -v enum_name="$TARGET_ENUM" '
+		BEGIN { inside_enum = 0 }
+		/enum[[:space:]]+[^[:space:]]*[[:space:]]*{/{
+			if ($0 ~ "enum[[:space:]]+" enum_name "[[:space:]]*{") {
+				inside_enum = 1
+			}
+		}
+		/}/ { if (inside_enum) { inside_enum = 0; next } }
+		inside_enum && /^[[:space:]]*[[:upper:]][[:alnum:]_]*/ {
+			gsub(/[[:space:]]*,?[[:space:]]*$/, "", $0)
+			print $0
+		}
+	' "$HEADER_FILE")
+
+	IFS=' ' read -r -a FAKE_FUSE_ARRAY <<< "$(echo "$ENUM_MEMBERS" | awk '{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0); gsub(/[[:space:]]+/, " ", $0); printf "%s ", $0}' | sed 's/ $//')"
+
+	export FAKE_FUSE_ARRAY
+}
+
+function hl_palad_hex {
+	local NAME=$(echo "$1" | cut -f 1 -d '.')
+	local FULLFILENAME=$2
+	local FILE=$(basename ${FULLFILENAME})
+	local BYTES_PER_LINE=$3
+	local DESTDIR=${4:-${HEXS_DIR}}
+	# pad file to 128bit (16Byte) as pladium emulates 128bit memory, so xxd wont trunc lines
+	dd status=none conv=sync bs=16 if=${FULLFILENAME} > ${STAGE_DIR}/${FILE}.tmp
+	xxd -e -g ${BYTES_PER_LINE} ${STAGE_DIR}/${FILE}.tmp | xxd -r | xxd -ps -c${BYTES_PER_LINE} > ${DESTDIR}/${DEV_PREFIX}-${HL_TARGET}-${NAME}.hex
+	rm ${STAGE_DIR}/${FILE}.tmp
+}
+
+function hl_palad_flash_hex {
+	local NAME=$(echo "$1" | cut -f 1 -d '.')
+	local FILE=$2
+	local DESTDIR=${3:-${HEXS_DIR}}
+	# save hex as a 1 byte list of values
+	xxd -e -g 4 ${FILE} | xxd -r | xxd -ps -c1 > ${DESTDIR}/${DEV_PREFIX}-${HL_TARGET}-${NAME}.hex
+}
