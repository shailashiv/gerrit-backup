+	declare -rA REGION_TO_FILENAME=(["IMAGE_DESC_PRIMARY"]=$IMG_PTR_BIN \
+					["PPBOOT_PRIMARY"]=$PPBOOT_BIN \
+					["PREBOOT_IO_DIE_PRIMARY"]=$PREBOOT_BIN \
+					["PREBOOT_COMPUTE_DIE_PRIMARY"]="FF" \
+					["CXL_ARC_ICCM_PRIMARY"]="FF" \
+					["CXL_ARC_DCCM_PRIMARY"]="FF" \
+					["DSM_ARC_ICCM_PRIMARY"]="FF" \
+					["DSM_ARC_DCCM_PRIMARY"]="FF" \
+					["RECOVERY_IMAGE_PCIE_PRIMARY"]="FF" \
+					["RECOVERY_IMAGE_FW_UPD_PRIMARY"]="FF" \
+					["FAKE_FUZE_PRIMARY"]=$FAKE_FUSE_BIN \
+					["RESERVED_1"]="FF" \
+					["IMAGE_DESC_SECONDARY"]=$IMG_PTR_BIN \
+					["PPBOOT_SECONDARY"]=$PPBOOT_BIN \
+					["PREBOOT_IO_DIE_SECONDARY"]=$PREBOOT_BIN \
+					["PREBOOT_COMPUTE_DIE_SECONDARY"]="FF" \
+					["CXL_ARC_ICCM_SECONDARY"]="FF" \
+					["CXL_ARC_DCCM_SECONDARY"]="FF" \
+					["DSM_ARC_ICCM_SECONDARY"]="FF" \
+					["DSM_ARC_DCCM_SECONDARY"]="FF" \
+					["RECOVERY_IMAGE_PCIE_SECONDARY"]="FF" \
+					["RECOVERY_IMAGE_FW_UPD_SECONDARY"]="FF" \
+					["FAKE_FUZE_SECONDARY"]=$FAKE_FUSE_BIN \
+					["RESERVED_2"]="FF")
+	declare -A SPI_REGION_OFFSETS
+	declare -A SPI_REGION_SIZES
+
+	hl_parse_spi_flash_regions SPI_REGION_OFFSETS SPI_REGION_SIZES fs1
+	hl_validate_spi_flash_layout REGION_TO_FILENAME SPI_REGION_OFFSETS SPI_REGION_SIZES
+	hl_check_length_of_spi_files  REGION_TO_FILENAME SPI_REGION_SIZES
+	hl_build_spi_flash_file REGION_TO_FILENAME SPI_REGION_OFFSETS SPI_REGION_SIZES OUTF
+}
+
