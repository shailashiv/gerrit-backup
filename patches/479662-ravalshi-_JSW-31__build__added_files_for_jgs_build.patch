diff --git a/board/habanalabs/jgs/post-image-agents.sh b/board/habanalabs/jgs/post-image-agents.sh
new file mode 100755
index 0000000..be740f0
--- /dev/null
+++ b/board/habanalabs/jgs/post-image-agents.sh
@@ -0,0 +1,85 @@
+# !/usr/bin/env bash
+
+# TODO: security and agent image related lines commented out intentionally and will be supported later on.
+
+set -e  	# stop on any error in this script
+set -u 		# stop on any reference to undefine variable
+set -o pipefail # stop on any error in pipeline
+
+source ${BR2_EXTERNAL}/board/habanalabs/${HL_DEV}/post-image-spi.sh
+#source ${BR2_EXTERNAL}/board/habanalabs/${HL_DEV}/create-fake-fuse-image.sh
+
+DEV_BASE=${BR2_EXTERNAL}/board/habanalabs/${HL_DEV}
+source ${DEV_BASE}/jgs-image-utility.sh
+
+hl_create_section_variables
+
+HL_COMPRESS=none
+HL_PREBOOT_VERSION_SECUREBOOT=`cat ${BR2_EXTERNAL}/output/${HL_DEV}/build/preboot-custom/build/buildversion-habanalabs`
+HL_PPBOOT_VERSION_SECUREBOOT=`cat ${BR2_EXTERNAL}/output/${HL_DEV}/build/baremetal-custom/buildversion-habanalabs | cut -d ' ' -f1`
+HL_FW_VERSION=""
+AGENT_BASE_ADDR=0x0000000000000000
+#SECURITY_SPI_OFFSET=0xFFFFFFFF
+ENDIANNESS="be"
+AGENT_ARCH="arc"
+
+LOADABLES="ppboot\", \"preboot\", \"img-ptr"
+
+# Extract the load address and start address from stat file
+ITS_SED_PARAMS+="s/@HL_PREBOOT_VERSION_SECUREBOOT@/${HL_PREBOOT_VERSION_SECUREBOOT}/g;"
+ITS_SED_PARAMS+="s/@HL_PPBOOT_VERSION_SECUREBOOT@/${HL_PPBOOT_VERSION_SECUREBOOT}/g;"
+ITS_SED_PARAMS+="s|@HL_DEV@|${DEV_PREFIX}|g;"
+ITS_SED_PARAMS+="s/@ENDIANNESS@/${ENDIANNESS}/g;"
+ITS_SED_PARAMS+="s/@AGENT_ARCH@/${AGENT_ARCH}/g;"
+#ITS_SED_PARAMS+="s/@SEC_OFFSET@/${SECURITY_SPI_OFFSET}/g;"
+ITS_SED_PARAMS+="s/@IMG_PTR_PRI_OFFSET@/0x${SPI_FLASH_REGION_IMAGE_DESC_PRIMARY_OFFSET}/g;"
+ITS_SED_PARAMS+="s/@IMG_PTR_SEC_OFFSET@/0x${SPI_FLASH_REGION_IMAGE_DESC_SECONDARY_OFFSET}/g;"
+ITS_SED_PARAMS+="s/@PPBOOT_PRI_OFFSET@/0x${SPI_FLASH_REGION_PPBOOT_PRIMARY_OFFSET}/g;"
+ITS_SED_PARAMS+="s/@PPBOOT_SEC_OFFSET@/0x${SPI_FLASH_REGION_PPBOOT_SECONDARY_OFFSET}/g;"
+ITS_SED_PARAMS+="s/@PREBOOT_PRI_OFFSET@/0x${SPI_FLASH_REGION_PREBOOT_IO_DIE_PRIMARY_OFFSET}/g;"
+ITS_SED_PARAMS+="s/@PREBOOT_SEC_OFFSET@/0x${SPI_FLASH_REGION_PREBOOT_IO_DIE_SECONDARY_OFFSET}/g;"
+ITS_SED_PARAMS+="s/@PREBOOT_COMPUTE_PRI_OFFSET@/0x${SPI_FLASH_REGION_PREBOOT_COMPUTE_DIE_PRIMARY_OFFSET}/g;"
+ITS_SED_PARAMS+="s/@PREBOOT_COMPUTE_SEC_OFFSET@/0x${SPI_FLASH_REGION_PREBOOT_COMPUTE_DIE_SECONDARY_OFFSET}/g;"
+ITS_SED_PARAMS+="s/@FAKE_FUSE_PRI_OFFSET@/0x${SPI_FLASH_REGION_FAKE_FUZE_PRIMARY_OFFSET}/g;"
+ITS_SED_PARAMS+="s/@FAKE_FUSE_SEC_OFFSET@/0x${SPI_FLASH_REGION_FAKE_FUZE_SECONDARY_OFFSET}/g;"
+ITS_SED_PARAMS+="s/@IMG_BIN@/images-pointers/g;"
+ITS_SED_PARAMS+="s/@PPBOOT_BIN@/ppboot-pcie_phy_fw/g;"
+ITS_SED_PARAMS+="s/@FAKE_FUSE_BIN@/fake-fuse/g;"
+ITS_SED_PARAMS+="s/@PREBOOT_BIN@/preboot/g;"
+ITS_SED_PARAMS+="s/@PREBOOT_COMPUTE_BIN@/preboot_compute/g;"
+ITS_SED_PARAMS+="s/@FW_LOADER_CONF_LOADABLES@/${LOADABLES}/g;"
+
+#AGENT_NIC_FW_FILE=${BR2_EXTERNAL}/output/${DEV_NAME}_arc/images/${DEV_NAME}-eth-phy.bin.le
