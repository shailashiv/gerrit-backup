+ITS_SED_PARAMS+="s/@MGMT_IO_DCCM_SIZE@/${MGMT_IO_DCCM_SIZE}/g;"
+ITS_SED_PARAMS+="s/@PID_IO_ICCM_SIZE@/${PID_IO_ICCM_SIZE}/g;"
+ITS_SED_PARAMS+="s/@PID_IO_DCCM_SIZE@/${PID_IO_DCCM_SIZE}/g;"
