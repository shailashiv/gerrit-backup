diff --git a/scripts/make/jgs/Makefile b/scripts/make/jgs/Makefile
new file mode 100644
index 0000000..b3197cc
--- /dev/null
+++ b/scripts/make/jgs/Makefile
@@ -0,0 +1,93 @@
+export SPECS_H17_DIR ?= $(SPECS_ROOT_H17)
+
+JGS_RELEASE_REPOS_DIRS := embedded/buildroot embedded/buildroot-external \
+	embedded/fw_loader embedded/preboot embedded/robot \
+	embedded/hl-smi embedded/eeprom-util \
+	embedded/specs embedded/arcboot \
+	embedded/zephyr-apps/arcpid embedded/zephyr-apps/arcmgmt \
+	embedded/zephyr embedded/zephyr-modules/mbedtls embedded/zephyr-modules/fdt \
+	embedded/zephyr-modules/eeprom embedded/zephyr-modules/lz4 embedded/zephyr-plugins embedded/zephyr-modules/boot_info \
+	embedded/zephyr-apps/preboot embedded/zephyr-modules/soc_init \
+	embedded/zephyr-modules/hl_shell embedded/hl-test embedded/zephyr-modules/common \
+	embedded/zephyr-apps/pcie-ss embedded/zephyr-modules/spdm/hlspdm \
+	embedded/zephyr-modules/spdm/spdm-emu embedded/zephyr-modules/spdm/libspdm embedded/zephyr-apps/reset
+
+JGS_RELEASE_REPOS := buildroot buildroot-external fw_loader \
+	preboot robot hl-smi eeprom-util \
+	embedded-specs arcboot arcpid arcmgmt \
+	zephyr mbedtls fdt eeprom boot_info lz4 zephyr-plugins \
+	preboot_rtos soc_init hl_shell embedded-test emb-common-mods \
+	pcie-ss spdm spdm-emu libspdm reset
+
+JGS_INTERNAL_FITS := ${DEV_PREFIX}-security_enable.itb	\
+	${DEV_PREFIX}-secureboot_config.itb		\
+	${DEV_PREFIX}-secureboot_config_dbg.itb		\
+	${DEV_PREFIX}-secureboot_config_no_rev.itb	\
+	${DEV_PREFIX}-write_tpm_devid.itb		\
+	${DEV_PREFIX}-erom_recovery_enable.itb		\
+	${DEV_PREFIX}-erom_erase.itb			\
+	${DEV_PREFIX}-bis_compliant_enable.itb		\
+	${DEV_PREFIX}-slt_set.itb			\
+	${DEV_PREFIX}-rr_dump.itb
+
+.PHONY: jgs-internal-fit-create
+jgs-internal-fit-create: jgs-security-enable-create				\
+				jgs-secureboot-config-create			\
+				jgs-secureboot-config-dbg-create		\
+				jgs-secureboot-config-no-rev-create		\
+				jgs-write-tpm-devid-create			\
+				jgs-erom-recovery-enable-create			\
+				jgs-erom-erase-create				\
+				jgs-bis-compliant-enable-create			\
+				jgs-slt-set-create				\
+				jgs-rr-dump-create
+
+	@$(call hl-check-files,$(JGS_INTERNAL_FITS))
+	@tar czf $(IMAGES_DIR)/${DEV_PREFIX}-int-fit.tgz -C $(ITBS_DIR)/ $(JGS_INTERNAL_FITS)
+
+.PHONY: jgs-nic-sec-create
+jgs-nic-sec-create: hl-create-nic-default-ffffff
+
+JGS_SECURITY_FITS := ${DEV_PREFIX}-eeprom_read.itb	\
+	${DEV_PREFIX}-revoke_key.itb			\
+	${DEV_PREFIX}-security_status.itb		\
+	${DEV_PREFIX}-update_svn.itb			\
+	${DEV_PREFIX}-fw_upd_closure.itb		\
+	${DEV_PREFIX}-sram_sf-open.itb			\
+	${DEV_PREFIX}-sram_sf-close.itb			\
+	${DEV_PREFIX}-rma_erase.itb			\
+	${DEV_PREFIX}-rma_status.itb			\
+	${DEV_PREFIX}-efuse_read.itb
+
+.PHONY: jgs-security-fit-create
+jgs-security-fit-create: jgs-eeprom-read-create						\
+				jgs-key-revoke-create jgs-security-status-create	\
+				jgs-update-svn-create jgs-fw-upd-closure-create		\
+				jgs-sram-sf-access-create				\
+				jgs-rma-erase-create jgs-rma-status-create		\
+				jgs-efuse-read-create
+
+	@$(call hl-check-files,$(JGS_SECURITY_FITS))
+	@tar czf $(IMAGES_DIR)/${DEV_PREFIX}-sec-fit.tgz -C $(ITBS_DIR)/ $(JGS_SECURITY_FITS)
+
+.PHONY: jgs-print-release-repos
+jgs-print-release-repos:
+	@echo $(JGS_RELEASE_REPOS)
+
+.PHONY: jgs-print-release-dirs
+jgs-print-release-dirs:
+	@echo $(JGS_RELEASE_REPOS_DIRS)
+
+.PHONY: jgs-post-image
+jgs-post-image:
+	@echo "Creating jgs-spi-flash.bin"
+	@$(MAKE) jgs-bin-create
+
+ifeq ($(HL_TARGET),palad)
+	@echo "Convert SPI flash bin image into Palladium hex format"
+	source ${BR2_EXTERNAL}/board/habanalabs/${HL_DEV}/jgs-image-utility.sh && \
+	swap_file ${BINS_DIR}/${DEV_PREFIX}-spi-flash.bin ${BINS_DIR}/${DEV_PREFIX}-spi-flash.bin.be && \
+	hl_palad_flash_hex spi-flash ${BINS_DIR}/${DEV_PREFIX}-spi-flash.bin.be ${HEXS_DIR}
+endif
+
+JGS_BIN_FITS = ${DEV_PREFIX}-agent-fw_loader-fit.itb
