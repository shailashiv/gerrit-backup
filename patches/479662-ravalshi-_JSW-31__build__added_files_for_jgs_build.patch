+#!/usr/bin/env bash
+
+set -e          # stop on any error in this script
+set -u          # stop on any reference to undefine variable
+set -o pipefail # stop on any error in pipeline
+
+SHA256_SIZE=32
+SHA256_CHKSUM=sha256sum
+BOOTLOADER_BINFILE=${HL_TARGET}_bloader.bin
+COMP_BOOTLOADER_BINFILE=${HL_TARGET}_bloader_comp.bin
+HL_BASE_PATH=${BR2_EXTERNAL}/board/habanalabs
+BOARD_BASE=${HL_BASE_PATH}/${HL_DEV}
+DEVICE_BASE=${HL_BASE_PATH}/${HL_DEV}
+KEY_BASE=${BR2_EXTERNAL}/board/habanalabs/${DEV_PREFIX}
+SCRIPTS_DIR=${BR2_EXTERNAL}/scripts
+source ${DEVICE_BASE}/jgs-image-utility.sh
+OBJCOPY=objcopy
+ARCBOOT_BINFILE=${ARCBOOT_BINFILE:-boot_rom.bin}
+ARCBOOT_COMP_BINFILE=${ARCBOOT_COMP_BINFILE:-boot_rom_comp.bin}
+PPBOOT_BINFILE=${PPBOOT_BINFILE:-ppboot.bin}
+PREBOOT_BINFILE=${PREBOOT_BINFILE:-preboot.bin}
+#PREBOOT_COMPUTE_BINFILE=${PREBOOT_COMPUTE_BINFILE:-preboot_compute.bin}
+PCIE_PHY_BINFILE=${PCIE_PHY_BINFILE:-pcie_phy_fw.bin}
+
+#SECURITY_BOOT_MODE
+SECURE_BOOT=1
+
+#[REVOKE/HASH/FW_VERSION]_LOCATION
+ASIC_EFUSE=0
+
+#SPI_CONTROLLER
+SPI_CONT=1
+
+# current efuse settings
+REVOKE_LOCATION=${ASIC_EFUSE}
+HASH_LOCATION=${ASIC_EFUSE}
+SECURITY_BOOT_MODE=${SECURE_BOOT}
+ENABLE_SECURITY_VALIDATION=1
+DISBLE_DEBUG_IF=0
+FW_VERSION_LOCATION=${ASIC_EFUSE}
+SPI_CONTROLLER=${SPI_CONT}
+
+FLASH_BASE_ADDR=0x60000
+
+HABANA_KEY_REVOKE=0
+PROD1_KEY_REVOKE=0
+PROD2_KEY_REVOKE=0
+PROD3_KEY_REVOKE=0
+PROD4_KEY_REVOKE=0
+
+PRIME_IMAGE_PPBOOT_KEY=0
+PRIME_IMAGE_RAM_KEY=0
+
+PRIME_IMAGE_PPBOOT_CRC_ERROR=0
+PRIME_IMAGE_RAM_CRC_ERROR=0
+
+PRIME_IMAGE_PPBOOT_SIGN_ERROR=0
+PRIME_IMAGE_RAM_SIGN_ERROR=0
+
+KEY_BASE_NAME=rsa3072
+
+SECURITY_VER_FILE=${SPECS_EMB_PROJ_DIR}/${DEV_PREFIX}/${DEV_PREFIX}_security.h
+export BOOT_POINTER_HEADER=${SPECS_EMB_PROJ_DIR}/common/hl_boot_desc.h
+export FW_IF_HEADER=${SPECS_EMB_PROJ_DIR}/jgs/jgs_fw_if.h
+
+source ${DEVICE_BASE}/post-image-spi.sh
+
+SECURITY_FW_VERSION=$(grep -owE "HL_SEC_FW_VERSION[[:space:]]+[0-9]+" $SECURITY_VER_FILE | sed 's/^.*[ \t]\([0-9]\+\)/\1/;')
+ENDIANNESS="${ENDIANNESS:-be}"
+
+function hl_reverse_words {
+	FILE=$1
+	OUT_FILE=$2
+	WORD_SIZE=${3}
+
+	local filesize=$(wc -c < $FILE)
+	echo $FILE $filesize $WORD_SIZE
+	${OBJCOPY}  -Ibinary --reverse-bytes=${WORD_SIZE} ${FILE} ${OUT_FILE}
+}
+function hl_calc_crc32 {
+	FILE=$1
+
+	# reverse CRC32 source as DMA engine works like that
+	hl_reverse_words ${FILE} ${FILE}.out 4
+	CRC32=$(crc32 ${FILE}.out)
+	echo ${CRC32} | xxd -r -p > ${FILE}.crc32
+}
+
+function hl_sec_fw {
+	FILE=${1}
+	if [ ${2} -ge 64 ]; then
+		VERSION=$(printf "%016x" $(( ~$((1<<${2})) )))
+		VERSION+=$(printf "%016x" $(( ~0 )))
+	else
+		VERSION=$(printf "%016x" $(( ~0 )))
+		VERSION+=$(printf "%016x" $(( ~$((1<<${2})) )))
+	fi
+	echo ${VERSION} | xxd -r -p | xxd -e -g16 | xxd -r		> ${FILE}.tmp
+	dd status=none conv=notrunc seek=0 bs=16 if=${FILE}.tmp of=${FILE}
+
+	if [ ${HL_TARGET} == "palad" ]; then
+		if [ ${2} -ge 64 ]; then
+				VERSION=$(printf "%016x" $((1<<${2})))
+				VERSION+=$(printf "%016x" $((0)))
+			else
+				VERSION=$(printf "%016x" $((0)))
+				VERSION+=$(printf "%016x" $((1<<${2})))
+		fi
+		for i in {0..3}; do
+			DWORD=$(echo ${VERSION} | xxd -r -p | xxd -g4 | cut -d' ' -f$(( 5 - ${i} )))
+			FORCE="{h5_core.h5_psoc_top.psoc_macro.efuse.efuse_cfg_reg.u_efuse_cfg_reg_fields.u_cfg_reg_base_data_$(( 59 + ${i}))_r.data_in_r[31:0]}"
+			echo "force ${FORCE} 'h${DWORD}" >> ${HL_TARGET}-force.hex
+		done
+	fi
+}
+
+function hl_sec_key {
+	FILE=${1}
+	NAME=${2}
+        KEY_OFFSET=${3}
+        KEY_BASE_NAME_PUB=${KEY_BASE_NAME}.pub
+
+	calculate_hash ${STAGE_DIR}/${NAME}_${KEY_BASE_NAME_PUB} ${STAGE_DIR}/${NAME}_${KEY_BASE_NAME_PUB}.hash
+	cat ${STAGE_DIR}/${NAME}_${KEY_BASE_NAME_PUB}.hash				> ${FILE}.tmp
+	dd status=none conv=notrunc seek=$(( ${KEY_OFFSET}*2 + 1 )) bs=16 if=${FILE}.tmp of=${FILE}
+
+	if [ ${HL_TARGET} == "palad" ]; then
+		for i in $(seq 1 $HASH_SZ); do
+			DWORD=$(xxd -e -c32 -g4 ${STAGE_DIR}/${NAME}_${KEY_BASE_NAME_PUB}.hash | cut -d' ' -f$(( ${i} + 2 )))
+			OFFSET=$(( $(( ${KEY_OFFSET}*8 )) +  ${i} ))
+			FORCE="{h5_core.h5_psoc_top.psoc_macro.efuse.efuse_cfg_reg.u_efuse_cfg_reg_fields.u_cfg_reg_base_data_$(( 18 + ${OFFSET}))_r.data_in_r[31:0]}"
+			echo "force ${FORCE} 'h${DWORD}" >> ${STAGE_DIR}/${HL_TARGET}-force.hex
+		done
+	fi
+}
+
+function hl_key_revoke {
+	REVOKE_STATUS=$1
+	if [ $REVOKE_STATUS -eq 1 ]; then
+		echo -n fe >> ${STAGE_DIR}/revoke_status.hex
+	else
+		echo -n ff >> ${STAGE_DIR}/revoke_status.hex
+	fi
+}
+
+function hl_efuse_sys_config_generate {
+	DWORD=${HABANA_KEY_REVOKE}
+	DWORD=$(( DWORD + $((${PROD1_KEY_REVOKE}<<1))))
+	DWORD=$(( DWORD + $((${PROD2_KEY_REVOKE}<<2))))
+	DWORD=$(( DWORD + $((${PROD3_KEY_REVOKE}<<3))))
+	DWORD=$(( DWORD + $((${PROD4_KEY_REVOKE}<<4))))
+	DWORD=$(( DWORD + $((${REVOKE_LOCATION}<<5))))
+	DWORD=$(( DWORD + $((${HASH_LOCATION}<<7))))
+	DWORD=$(( DWORD + $((${SECURITY_BOOT_MODE}<<9))))
+	DWORD=$(( DWORD + $((${ENABLE_SECURITY_VALIDATION}<<10))))
+	DWORD=$(( DWORD + $((${DISBLE_DEBUG_IF}<<12))))
+	DWORD=$(( DWORD + $((${FW_VERSION_LOCATION}<<13))))
+	DWORD=$(( DWORD + $((${SPI_CONTROLLER}<<17))))
+	DWORD=$(printf "%08x" ${DWORD})
+	echo "force {h5_core.h5_psoc_top.psoc_macro.efuse.efuse_cfg_reg.u_efuse_cfg_reg_fields.u_cfg_reg_base_data_58_r.data_in_r[31:0]} 'h${DWORD}" > ${HEXS_DIR}${HL_TARGET}-force.hex
+}
+
+function hl_report_missing_spi_region_offset_and_exit {
+	local red=$(tput setaf 1)
+	local normal=$(tput sgr0)
+
+	printf "$red The offset of SPI flash region %s is not defined $normal \n" $1
+	exit 1
+}
+
+function hl_report_missing_spi_region_size_and_exit {
+	local red=$(tput setaf 1)
+	local normal=$(tput sgr0)
+
+	printf "$red The size of SPI flash region %s is not defined $normal \n" $1
+	exit 1
+}
+
+# This function checks, that for each SPI flash region
+# both offset and size are defined in jgs_mem_addr_dt.h
+#
+# Parameters:
+# 1 - associative array region name to file name
+# 2 - associative array region name to offset
+# 3 - associative array region name to size
+# Result:
+# normal return if everything is OK
+# printing error message and exit if problem encountered
+function hl_validate_spi_flash_layout {
+	local -n spi_region_to_file=$1
+	local -n spi_region_offsets=$2
+	local -n spi_region_sizes=$3
+	local region_name
+
+	for region_name in "${!spi_region_to_file[@]}"; do
+		if [[ -z "${spi_region_offsets[$region_name]+unset}" ]]; then
+			hl_report_missing_spi_region_offset_and_exit $region_name
+		fi
+		if [[ -z "${spi_region_sizes[$region_name]+unset}" ]]; then
+			hl_report_missing_spi_region_size_and_exit $region_name
+		fi
+	done
+}
+
+# This function parses header file spec/jgs_mem_addr_dt.h
+# and learns SPI flash layout: region names, their offsets
+# and sizes
+# Result:
+# function fills 2 associaive arrays:
+# region name to offset and region name to size
+function hl_parse_spi_flash_regions {
+	local -n spi_region_offsets=$1
+	local -n spi_region_sizes=$2
+	local platform=$3
+	local mem_addr_header_file=${BR2_EXTERNAL}/../specs/fs/${platform}/${platform}_mem_addr_dt.h
+	local regex_offset="\#define(.*)SPI_FLASH_REGION_([A-Z_0-9]+)_OFFSET(\s+)([0-9a-fA-F]+)"
+	local regex_size="\#define(.*)SPI_FLASH_REGION_([A-Z_0-9]+)_SIZE(\s+)([0-9a-fA-F]+)"
+	local region_name
+	local region_offset
+	local region_size
+	local red=$(tput setaf 1)
+	local normal=$(tput sgr0)
+
+	if [ ! -f $mem_addr_header_file ]; then
+		printf "$red File %s not exists $normal \n" "$mem_addr_header_file"
+		exit 1
+	fi
+	IFS=$'\n'
+	for line in $(cat "$mem_addr_header_file"); do
+		if [[ $line =~ $regex_offset ]]; then
+			region_name=${BASH_REMATCH[2]}
+			region_offset=$(echo "ibase=16; ${BASH_REMATCH[4]^^}"|bc)
+			spi_region_offsets[${region_name}]=$region_offset
+		elif [[ $line =~ $regex_size ]]; then
+			region_name=${BASH_REMATCH[2]}
+			region_size=$(echo "ibase=16; ${BASH_REMATCH[4]^^}"|bc)
+			spi_region_sizes[${region_name}]=$region_size
+		fi
+	done
+}
+
+# This function is intended to check, that the length of
+# given files does not exceed the size of appropriate SPI
+# flash region
+function hl_check_length_of_spi_files {
+	local -n region_to_file=$1
+	local -n region_to_size=$2
+	local file_name
+	local region_name
+	local block_size
+	local diff
+	local red=$(tput setaf 1)
+	local normal=$(tput sgr0)
+
+	for region_name in "${!region_to_file[@]}"; do
+		file_name="${region_to_file[${region_name}]}"
+		[[ $file_name == FF ]] && continue
+		[[ $file_name == 00 ]] && continue
+		block_size="${region_to_size[${region_name}]}"
+		if [ ! -f $file_name ]; then
+			printf "$red File %s not exists $normal \n" "$file_name"
+			exit 1
+		fi
+		file_size=$(wc -c <"$file_name")
+		if [ $file_size -eq 0 ]; then
+			printf "$red File %s is empty $normal \n" "$file_name"
+			exit 1
+		fi
+		if [ $file_size -gt $block_size ]; then
+			diff=$(expr $file_size - $block_size)
+			printf "$red File %s size %s exceeds SPI block size %s by %s bytes $normal \n" \
+				"$file_name" "$file_size" "$block_size" "$diff"
+			exit 1
+		else
+			printf "Region %s file size: %s    SPI block size: %s\n" \
+				"$region_name" "$file_size" "$block_size"
+		fi
+	done
+}
+
+# This function builds SPI flash file
+function hl_build_spi_flash_file {
+	local -n region_to_file=$1
+	local -n region_to_offset=$2
+	local -n region_to_size=$3
+	local -n out_file=$4
+	local file_length=0
+	local input_file
+	local file_length
+	local offset
+	local size
+	local kb
+	local end_of_region
+	local current_region_offset=0
+	local region_found
+	local red=$(tput setaf 1)
+	local normal=$(tput sgr0)
+
+	for region_name in "${!region_to_offset[@]}"; do
+		offset="${region_to_offset[${region_name}]}"
+		size="${region_to_size[${region_name}]}"
+		end_of_region=$(expr $offset + $size)
+		if [ $end_of_region -gt $file_length ]; then
+			file_length=$end_of_region
+		fi
+	done
+
+	printf "\nLength of flash image file %s: 0x%x bytes \n\n" "$out_file" "$file_length"
+	rm -f "$out_file"
+	touch "$out_file"
+
+	while [ $current_region_offset -lt $file_length ]; do
+		region_found=false
+		for region_name in "${!region_to_offset[@]}"; do
+			offset="${region_to_offset[${region_name}]}"
+			size="${region_to_size[${region_name}]}"
+			kb=$(expr "$size" \/ 1024)
+			if [ $offset -eq $current_region_offset ]; then
+				region_found=true
+				input_file="${region_to_file[${region_name}]}"
+				if [ "$input_file" = "FF" ]; then
+					printf "Writing FF to offset 0x%x  %sK (Region name: %s)\n" "$offset" "$kb" "$region_name"
+					dd status=none conv=sync bs=${kb}K count=1 if=/dev/zero | tr "\000" "\377" >> ${out_file}
+				elif [ "$input_file" = "00" ]; then
+					printf "Writing 00 to offset 0x%x  %sK (Region name: %s)\n" "$offset" "$kb" "$region_name"
+					dd status=none conv=sync bs=${kb}K count=1 if=/dev/zero >> ${out_file}
+				else
+					printf "Writing %s from %s to offset 0x%x  %sK \n" "$region_name" "$input_file" "$offset" "$kb"
+					dd status=none conv=sync bs=${kb}K if=${input_file} >> ${out_file}
+				fi
+				current_region_offset=$(expr $offset + $size)
+				break
+			fi
+		done
+		if [ "$region_found" = false ]; then
+			printf "$red SPI flash region with offset 0x%x not defined $normal \n" "$current_region_offset"
+			exit 1
+		fi
+	done
+}
+
+pushd ${STAGE_DIR}
+
+	hl_copy_binaries ${BINS_DIR}
+
+	export IMG_PTR_SZ="$(get_struct_size $BOOT_POINTER_HEADER hl_fw_boot_ptrs)"
+	export IMG_DESC_SZ="$(get_struct_size $BOOT_POINTER_HEADER hl_fw_img_desc)"
+
+	for i in $(seq 1 $NUM_PROD_KEYS); do
+		CUST=cust${i}
+		hl_gen_cert ${CUST} "Habana Embedded Team"
+	done
+
+	## create otp spi image
+	dd status=none conv=sync count=12 bs=16 if=/dev/zero | tr '\000' $'\xFF' > ${BINS_DIR}/${DEV_PREFIX}-spi-otp-flash.bin
+
+	# get private and public keys
+	copy_all_keys ${BINS_PROD_DIR}
+
+	#generate public key components
+	generate_public_keys
+
+	# Create erom binaries
+	prep_image_erom ${BINS_DIR}/${DEV_PREFIX}-erom.bin.le
+
+	# Create fake fuse binary
+	prep_image_fake_fuse ${BINS_DIR}/${DEV_PREFIX}-fake-fuse.bin.le
+
+	# Pad preboot binary and then pack
+	zephyr_preboot_pack ${BINS_DIR}/${PREBOOT_BINFILE} ${PRIME_IMAGE_RAM_KEY} ${PRIME_IMAGE_RAM_CRC_ERROR} ${PRIME_IMAGE_RAM_SIGN_ERROR}
+	#zephyr_preboot_pack ${BINS_DIR}/${PREBOOT_COMPUTE_BINFILE} ${PRIME_IMAGE_RAM_KEY} ${PRIME_IMAGE_RAM_CRC_ERROR} ${PRIME_IMAGE_RAM_SIGN_ERROR}
+
+	# create combined name of ppboot and pcie
+	PPBOOT=$(echo "$PPBOOT_BINFILE" | cut -f 1 -d '.')
+	PCIE_PHY=$(echo "$PCIE_PHY_BINFILE" | cut -f 1 -d '.')
+	PPBOOT_PCIE_PHY_BINFILE=${PPBOOT}-${PCIE_PHY}.bin
+	PPBOOT_PCIE_PHY_PADDED_BINFILE=${PPBOOT_PCIE_PHY_BINFILE}.pad
+
+	# concatenate both FW
+	hl_join_bin ${BINS_DIR}/${PPBOOT} ${PCIE_PHY} ${BINS_DIR}/${PPBOOT_PCIE_PHY_BINFILE}
+
+	# pack and sign image
+	hl_pack_bin ${BINS_DIR}/${PPBOOT_PCIE_PHY_BINFILE} 64K ${PRIME_IMAGE_PPBOOT_KEY} ${PRIME_IMAGE_PPBOOT_CRC_ERROR} ${PRIME_IMAGE_PPBOOT_SIGN_ERROR}
+
+	# Create image pointers
+	prep_image_ptrs ${BINS_DIR}/${DEV_PREFIX}-images-pointers.bin.le
+
+	if [ ${HL_TARGET} == "palad" ]; then
+		hl_efuse_sys_config_generate
+	fi
+	swap_file ${BINS_DIR}/${DEV_PREFIX}-ppboot-pcie_phy_fw.bin.le ${BINS_DIR}/${DEV_PREFIX}-ppboot-pcie_phy_fw.bin.be
+	swap_file ${BINS_DIR}/${DEV_PREFIX}-images-pointers.bin.le  ${BINS_DIR}/${DEV_PREFIX}-images-pointers.bin.be
+	swap_file ${BINS_DIR}/${DEV_PREFIX}-fake-fuse.bin.le ${BINS_DIR}/${DEV_PREFIX}-fake-fuse.bin.be
+	swap_file ${BINS_DIR}/${DEV_PREFIX}-preboot.bin.le ${BINS_DIR}/${DEV_PREFIX}-preboot.bin.be
+	#swap_file ${BINS_DIR}/${DEV_PREFIX}-preboot_compute.bin.le ${BINS_DIR}/${DEV_PREFIX}-preboot_compute.bin.be
+
+	# ToDo change it to unified wat from agent fw it check FSW-3432
+	create_spi_image ${BINS_DIR}/${DEV_PREFIX}-spi-flash.bin.nocrc \
+			 ${BINS_DIR}/${DEV_PREFIX}-ppboot-pcie_phy_fw.bin.${ENDIANNESS} \
+			 ${BINS_DIR}/${DEV_PREFIX}-preboot.bin.${ENDIANNESS} \
+			 ${BINS_DIR}/${DEV_PREFIX}-images-pointers.bin.${ENDIANNESS} \
+			 ${BINS_DIR}/${DEV_PREFIX}-fake-fuse.bin.${ENDIANNESS}
+
+	# SPI flash binary is provided as Big Endian, for manufacturing programmer.
+	swap_file ${BINS_DIR}/${DEV_PREFIX}-spi-flash.bin.nocrc ${BINS_DIR}/${DEV_PREFIX}-spi-flash.bin.nocrc.le
+
+	# Prepare checksum
+	CKSUM=`${SHA256_CHKSUM} ${BINS_DIR}/${DEV_PREFIX}-spi-flash.bin.nocrc.le | cut -d' ' -f1`
+	echo ${CKSUM} | xxd -p -r								> ${BINS_DIR}/${DEV_PREFIX}-spi-flash.crc
+	dd status=none conv=sync bs=64K			if=${BINS_DIR}/${DEV_PREFIX}-spi-flash.bin.nocrc.le	> ${BINS_DIR}/${DEV_PREFIX}-spi-flash.bin
+	dd status=none conv=sync bs=$SHA256_SIZE	if=${BINS_DIR}/${DEV_PREFIX}-spi-flash.crc		>> ${BINS_DIR}/${DEV_PREFIX}-spi-flash.bin
+
+	rm -rf ${BINS_DIR}/${PPBOOT_PCIE_PHY_BINFILE}
+
+	if [ ${HL_TARGET} == "palad" ]; then
+		# convert io die bootrom to pallad hex image
+		hl_pad_arcboot_rom
+		${SCRIPTS_DIR}/palad/convert_app_to_io_bootrom_hex.sh ${ARCBOOT_BINFILE}
+		mv boot_rom_rom_ecc.hex ${HEXS_DIR}
+
+		# convert compute die bootrom to pallad hex images
+		${SCRIPTS_DIR}/palad/convert_app_to_compute_bootrom_hex.sh ${ARCBOOT_COMP_BINFILE} fs1-${HL_TARGET}-bootrom_comp
+		mv boot_rom_comp_*.hex ${HEXS_DIR}
+		mv jgs-${HL_TARGET}-bootrom_comp_*_ecc.hex ${HEXS_DIR}
+
+		# convert io die bootloader to pallad hex image
+		${SCRIPTS_DIR}/palad/convert_app_to_io_bootrom_hex.sh ${BOOTLOADER_BINFILE}
+
+		# convert compute die bootloader to pallad hex images
+		${SCRIPTS_DIR}/palad/convert_app_to_compute_bootrom_hex.sh ${COMP_BOOTLOADER_BINFILE} fs1-${HL_TARGET}-bloader_comp
+		mv jgs-${HL_TARGET}-bloader*.hex ${HEXS_DIR}
+
+		# convert preboot application to pallad hex images
+		${SCRIPTS_DIR}/palad/convert_app_to_ccm_hex.sh preboot.bin
+		mv iccm0_*.hex ${HEXS_DIR}
+
+		# convert preboot comp application to palad hex images
+		${SCRIPTS_DIR}/palad/convert_app_to_ccm_hex.sh preboot_compute.bin
+		mv iccm0_0.hex ${HEXS_DIR}/comp_iccm0_0.hex
+		mv iccm0_1.hex ${HEXS_DIR}/comp_iccm0_1.hex
+	fi
+
+	if [ -f "${KEY_BASE}/spi-flash-layout-validator.sh" ]; then
+		source ${KEY_BASE}/spi-flash-layout-validator.sh
+		validate_spi_flash_layout ${BINS_DIR}/${DEV_PREFIX}-ppboot-pcie_phy_fw.bin.${ENDIANNESS} \
+					  ${BINS_DIR}/${DEV_PREFIX}-preboot.bin.${ENDIANNESS} \
+					  ${BINS_DIR}/${DEV_PREFIX}-images-pointers.bin.${ENDIANNESS} \
+					  ${BINS_DIR}/${DEV_PREFIX}-fake-fuse.bin.${ENDIANNESS}
+	fi
+popd
diff --git a/board/habanalabs/jgs/jgs-zephyr.its b/board/habanalabs/jgs/jgs-zephyr.its
new file mode 100644
index 0000000..1f935e2
--- /dev/null
+++ b/board/habanalabs/jgs/jgs-zephyr.its
@@ -0,0 +1,95 @@
+/dts-v1/;
+
+/ {
+	hl-version = "@HL_VERSION@";
+	hl-device = "@DEV_PREFIX@";
+	description = "FIT image with Zephyr loadables";
+	#address-cells = <2>;
+
+	images {
+
+		/* TEMPORARY:
+		 * arcpid implementation isn't ready yet, so comment out
+		 * zephyr-pid-iccm & zephyr-pid-dccm.
+		pid-io-iccm {
+			description = "Zephyr pid ICCM";
+			data = /incbin/("@BINS_DIR_PATH@@DEV_NAME@-zephyr-pid-iccm.bin.le");
+			type = "standalone";
+			compression = "none";
+			loadaddr = <@ARC_PID_ICCM_HI@ @ARC_PID_ICCM_LO@>;
+			hash {
+				algo = "@SHA_VERSION@";
+			};
+		};
+
+		pid-io-dccm {
+			description = "Zephyr pid DCCM";
+			data = /incbin/("@BINS_DIR_PATH@@DEV_NAME@-zephyr-pid-dccm.bin.le");
+			type = "standalone";
+			compression = "none";
+			loadaddr = <@ARC_PID_DCCM_HI@ @ARC_PID_DCCM_LO@>;
+			hash {
+				algo = "@SHA_VERSION@";
+			};
+		};
+		*/
+
+		mgmt-io-iccm {
+			description = "Zephyr mgmt io ICCM";
+			data = /incbin/("@BINS_DIR_PATH@@DEV_NAME@-zephyr-mgmt-iccm.bin.le");
+			type = "standalone";
+			compression = "none";
+			instances = <1>;
+			loadaddr = <@ARC_MGMT_ICCM_HI@ @ARC_MGMT_ICCM_LO@>;
+			hash {
+				algo = "@SHA_VERSION@";
+			};
+		};
+
+		mgmt-io-dccm {
+			description = "Zephyr mgmt io DCCM";
+			data = /incbin/("@BINS_DIR_PATH@@DEV_NAME@-zephyr-mgmt-dccm.bin.le");
+			type = "standalone";
+			compression = "none";
+			instances = <1>;
+			loadaddr = <@ARC_MGMT_DCCM_HI@ @ARC_MGMT_DCCM_LO@>;
+			hash {
+				algo = "@SHA_VERSION@";
+			};
+		};
+	};
+
+	cpus {
+		arc-io-mgmt {
+			arch = "arc";
+			cpubase = <@MGMT_IO_BASEADDR_HI@ @MGMT_IO_BASEADDR_LO@>;
+			cputype = <0>; /* 0 - PSOC ARC, 1 - ARCFARM */
+			memnum = <2>;
+			membase = <@ARC_MGMT_ICCM_HI@ @ARC_MGMT_ICCM_LO@ @ARC_MGMT_DCCM_HI@ @ARC_MGMT_DCCM_LO@>;
+			memsize = <@MGMT_IO_ICCM_SIZE@ @MGMT_IO_DCCM_SIZE@>;
+			startaddr = <@MGMT_STARTADDR_HI@ @MGMT_STARTADDR_LO@>;
+		};
+
+		arc-io-pid {
+			arch = "arc";
+			cpubase = <@PID_IO_BASEADDR_HI@ @PID_IO_BASEADDR_LO@>;
+			cputype = <0>; /* 0 - PSOC ARC, 1 - ARCFARM */
+			memnum = <2>;
+			membase = <@ARC_PID_ICCM_HI@ @ARC_PID_ICCM_LO@ @ARC_PID_DCCM_HI@ @ARC_PID_DCCM_LO@>;
+			memsize = <@PID_IO_ICCM_SIZE@ @PID_IO_DCCM_SIZE@>;
+			startaddr = <@PID_STARTADDR_HI@ @PID_STARTADDR_LO@>;
+		};
+	};
+
+	configurations {
+		default = "preboot-conf";
+
+		preboot-conf {
+			load-type = <0>; /* FIT_LOAD_TYPE_RUN */
+			description = "Habanalabs device preboot";
+			loadables = /* "pid-io-iccm", "pid-io-dccm", */ "mgmt-io-iccm",
+				    "mgmt-io-dccm";
+			processors = "arc-io-mgmt"; /*, "arc-io-pid";*/
+		};
+	};
+};
