+function export_desc_var {
+	FAKE_FUSE_DIE_PARAM="${1}${2}"
+	export "$FAKE_FUSE_DIE_PARAM"=${3}
+}
+
+function get_aligned_size {
+	local param=$1
+	local alignment=1024
+
+	if [[ "$param" =~ ^[0-9]+$ ]]; then
+		local size=$param
+	elif [ -f "$param" ]; then
+		local size=$(stat -Lc "%s" $(eval "echo \$param"))
+	else
+		echo "Error: Unexpected entry for size alignment"
+		exit 1
+	fi
+
+	local remainder=$((size % $alignment))
+	if [ $remainder -eq 0 ]; then
+		echo $size
+	else
+		echo $(($size + $alignment - $remainder))
+	fi
+}
+
+function prep_image_fake_fuse {
+	local OUTF=$1
+	local FAKE_FUSE_TMP_BIN=die_fake_fuse.bin
+
+	get_fake_fuse_bin_list_array ${FW_IF_HEADER} "fake_fuse_bin_index"
+
+	# Boot pointer struct size + (Image count * pointer size)
+	local BOOT_POINTER_SIZE_ALLOC=$((IMG_PTR_SZ + (${#FAKE_FUSE_ARRAY[@]} * 4)))
+	# Boot pointer struct size + (Image count * pointer size) + (Img desc * Image count)
+	BOOT_POINTER_SIZE_ALLOC=$((BOOT_POINTER_SIZE_ALLOC + (IMG_DESC_SZ * ${#FAKE_FUSE_ARRAY[@]})))
+	local align_sz=16
+	#ALIGN(payload)
+	BOOT_POINTER_SIZE_ALLOC=$(((BOOT_POINTER_SIZE_ALLOC+align_sz-1)/align_sz*align_sz))
+	#ALIGN(payload) + CRC32
+	BOOT_POINTER_SIZE_ALLOC=$((BOOT_POINTER_SIZE_ALLOC+4))
+
+	# Binary insertion alignment
+	BOOT_POINTER_SIZE_ALLOC="$(get_aligned_size $BOOT_POINTER_SIZE_ALLOC)"
+
+	local CUR_OFFSET_IN_BIN=$BOOT_POINTER_SIZE_ALLOC
+	local FUSE_BIN_SIZE=0
+
+	# Create 16Byte aligned 6 Fuse binaries from text files.
+	for FUSE_FILE_INDEX in "${!FAKE_FUSE_ARRAY[@]}"; do
+		FAKE_FUSE_DIE="${FAKE_FUSE_ARRAY[$FUSE_FILE_INDEX]}"
+
+		FAKE_FUSE_DIE_TEXT_FILE_VAR="${FAKE_FUSE_DIE}_TEXT_FILE" # Storing variable name
+
+		FAKE_FUSE_DIE_TEXT_FILE_NAME=$(basename "${!FAKE_FUSE_DIE_TEXT_FILE_VAR}")
+		FAKE_FUSE_DIE_BINFILE_NAME="${FAKE_FUSE_DIE_TEXT_FILE_NAME%.txt}.bin"
+
+		#Bank 0
+		xxd -r -p ${!FAKE_FUSE_DIE_TEXT_FILE_VAR} > ${FAKE_FUSE_TMP_BIN}
+		#Bank 1
+		xxd -r -p ${!FAKE_FUSE_DIE_TEXT_FILE_VAR} >> ${FAKE_FUSE_TMP_BIN}
+		# Prepare Fuse binary with 2 Banks
+		dd status=none conv=sync bs=16 if=${FAKE_FUSE_TMP_BIN}	> ${FAKE_FUSE_DIE_BINFILE_NAME}
+
+		# Insert Die Fake fuse bin file.
+		FUSE_BIN_SIZE="$(get_aligned_size $FAKE_FUSE_DIE_BINFILE_NAME)"
+		dd status=none conv=sync seek=$(printf %d ${CUR_OFFSET_IN_BIN}) if=$FAKE_FUSE_DIE_BINFILE_NAME bs=1 of=${OUTF}
+
+		export_desc_var $FAKE_FUSE_DIE "_BINFILE" $FAKE_FUSE_DIE_BINFILE_NAME
+		export_desc_var $FAKE_FUSE_DIE "_TEXT_BASE" 0x0
+		export_desc_var $FAKE_FUSE_DIE "_START_ADDR" 0x0
+		export_desc_var $FAKE_FUSE_DIE "_PRI_OFFSET" $CUR_OFFSET_IN_BIN
+		export_desc_var $FAKE_FUSE_DIE "_SEC_OFFSET" $((CUR_OFFSET_IN_BIN + SECONDARY_MANIFEST_OFFSET))
+
+		CUR_OFFSET_IN_BIN=$((CUR_OFFSET_IN_BIN + FUSE_BIN_SIZE))
+	done
+	rm -f $FAKE_FUSE_TMP_BIN
+
+	# Create fake fuse boot pointer bin.
+	prep_image_ptrs_common_v1 ${DEV_PREFIX}-fake-fuse-pointers.bin.le $IMAGE_TYPE_FAKE_FUSE
+	FILE_SIZE=$(get_aligned_size "${DEV_PREFIX}-fake-fuse-pointers.bin.le")
+
+	# If Boot pointer bin size greater than BOOT_POINTER_SIZE_ALLOC, break the execution.
+	if [ "$FILE_SIZE" -gt "$BOOT_POINTER_SIZE_ALLOC" ]; then
+		echo "Error: Fake fuse Boot pointer construction failed"
+		exit 1
+	fi
+
+	# Insert Fake fuse pointer bin at FAKE_FUSE starting.
+	dd status=none conv=notrunc seek=0 if=${DEV_PREFIX}-fake-fuse-pointers.bin.le bs=1 of=${OUTF}
+}
+
+function zephyr_preboot_pack {
+	local PREBOOT_BINFILE=$1
+	local PRIME_IMAGE_RAM_KEY=$2
+	local PRIME_IMAGE_RAM_CRC_ERROR=$3
+	local PRIME_IMAGE_RAM_SIGN_ERROR=$4
+
+	hl_pack_bin ${PREBOOT_BINFILE} 64K ${PRIME_IMAGE_RAM_KEY} ${PRIME_IMAGE_RAM_CRC_ERROR} ${PRIME_IMAGE_RAM_SIGN_ERROR}
+
+	return
+}
+
+function hl_join_bin {
+	NAME_1=$1
+	NAME_2=$2
+	PACK_NAME=$3
+	# make file lineup to 16byte chunks
+	dd status=none conv=sync bs=16 if=${NAME_1}.bin		> ${NAME_1}.bin.algn
+	cat ${NAME_1}.bin.algn ${NAME_2}.bin	> ${PACK_NAME}
+	rm ${NAME_1}.bin.* -rf
+}
+
+# TODO: JGS
+MAX_SPI_DMA_DATA_TRANSFER=65520
+SPI_DMA_DEST_64KB_OFFS=65536
+function hl_pack_bin {
+	FILEFULLPATH=$1
+	FILENAME=$(basename ${FILEFULLPATH})
+	FILEPATH=$(dirname ${FILEFULLPATH})
+	BSIZE=$2
+	KEY_NUM=$3
+	CRC_ERROR=$4
+	SIGN_ERROR=$5
+
+	PADFULLBINFILE=${FILEFULLPATH}.pad
+	dd status=none conv=sync bs=16 if=${FILEFULLPATH} of=${PADFULLBINFILE}
+
+	SIZE_WITHOUT_CRC=$(stat --printf="%s" ${PADFULLBINFILE})
+	NUM_SLICES=$((SIZE_WITHOUT_CRC/MAX_SPI_DMA_DATA_TRANSFER))
+	MODULO_SLICES=$((SIZE_WITHOUT_CRC%MAX_SPI_DMA_DATA_TRANSFER))
+	if [ ${MODULO_SLICES} -ne 0 ]; then
+		NUM_SLICES=$((NUM_SLICES+1))
+	fi
+
+	# image size to be computed as part of image descriptor function
+	local leftover=${SIZE_WITHOUT_CRC}
+	local skip_offset=0
+
+
+	# image packing example:
+	# image_size = 200kb + 16 bytes CRC = 0x32010
+	# num_slice: 4
+	# 1st slice: flash offset: 0x0 DST: 0x0 (dma_size: 0xFFF4 left_size: 0x2201C)
+	# 2nd slice: flash offset: 0x10000 DST: 0xFFF0 (dma_size: 0xFFF4 left_size: 0x12028)
+	# 3nd slice: flash offset: 0x20000 DST: 0x1FFE0 (dma_size: 0xFFF4 left_size: 0x2034)
+	# 4th slice: flash offset: 0x30000 DST: 0x2FFD0 (dma_size: 0x2034 left_size: 0x0)
+	#
+	#  =========================================================
+	# | PPBOOT IMG SLICE1 + CRC + PADDING (0xFFF0 + 0x4 + 0x12) |
+	#  ---------------------------------------------------------
+	# | PPBOOT IMG SLICE2 + CRC + PADDING (0xFFF0 + 0x4 + 0x12) |
+	#  ---------------------------------------------------------
+	# | PPBOOT IMG SLICE3 + CRC + PADDING (0xFFF0 + 0x4 + 0x12) |
+	#  ---------------------------------------------------------
+	# | PPBOOT IMG SLICE4 + CRC (0x2030 + 0x4)		    |
+	#  =========================================================
+	#
+	# Note: Padding size is not included in total size as DMA is
+	# not expected to copy padding data.
+	for ((slice_cnt=0; slice_cnt<${NUM_SLICES}; slice_cnt++)); do
+		# bin file: (64KB-16) + CRC
+		local BIN_FILE=${PADFULLBINFILE}.part${slice_cnt}
+		if [ $leftover -lt $MAX_SPI_DMA_DATA_TRANSFER ]; then
+			size_bytes=$leftover
+		else
+			size_bytes=$MAX_SPI_DMA_DATA_TRANSFER
+		fi
+
+		size_words=$((size_bytes/4))
+		dd status=none skip=${skip_offset} conv=sync bs=4 if=${PADFULLBINFILE} count=${size_words} > ${BIN_FILE}
+		hl_calc_crc32 ${BIN_FILE}
+		if [ ${CRC_ERROR} -eq 0 ]; then
+			cat ${BIN_FILE}.crc32 >> ${BIN_FILE}
+		fi
+		flash_offset=$((SPI_DMA_DEST_64KB_OFFS/4))
+		flash_offset=$((flash_offset*slice_cnt))
+		dd status=none conv=sync if=${BIN_FILE} bs=4 seek=$flash_offset of=${STAGE_DIR}/${DEV_PREFIX}-${FILENAME}.le.int
+		leftover=$((leftover-size_bytes))
+		skip_offset=$((skip_offset+size_words))
+	done
+
+	hl_reverse_words ${STAGE_DIR}/${DEV_PREFIX}-${FILENAME}.le.int ${FILEPATH}/${DEV_PREFIX}-${FILENAME}.le 4
+	rm -f ${STAGE_DIR}/${DEV_PREFIX}-${FILENAME}.le.int
+}
+
+function hl_sign_bin {
+	BASENAME=$1
+	CERT=$2
+	$OPENSSL dgst -sha384 -sign ${CERT}.key -out ${BASENAME}.sig ${BASENAME}
+}
+
+function extract_key_props {
+	KEY_NAME=$1
+	PROP_NAME=$2
+	OUT_NAME=$3
+
+	TMPNAME=${STAGE_DIR}/${KEY_NAME}-${PROP_NAME}.txt
+	fdtget ${BINS_PROD_DIR}/${KEY_NAME}.dtb /signature/key-${KEY_NAME} rsa,${PROP_NAME} -t bx > ${TMPNAME}
+	sed 's/\s\+/\n/g' ${TMPNAME} > ${TMPNAME}.tmp
+	sed -e 's/\b[0-9]\b/0&/' -e 's/\b[a-f]\b/0&/' ${TMPNAME}.tmp  > ${TMPNAME}.tmp.le
+	xxd -r -p ${TMPNAME}.tmp.le > ${OUT_NAME}
+	rm -f ${TMPNAME}.*
+}
+
+function hl_get_key_props {
+	KEY_NUM=$1
+
+	if [ ${KEY_NUM} -eq 0 ]; then
+		KEY_NAME=$(echo -n "hl_${KEY_BASE_NAME}")
+	else
+		KEY_NAME=$(echo -n "cust${KEY_NUM}_${KEY_BASE_NAME}")
+	fi
+
+	extract_key_props ${KEY_NAME} r-squared ${STAGE_DIR}/rr.prop
+
+	extract_key_props ${KEY_NAME} modulus ${STAGE_DIR}/mod.prop
+
+	extract_key_props ${KEY_NAME} exponent ${STAGE_DIR}/exp.prop
+
+	extract_key_props ${KEY_NAME} n0-inverse ${STAGE_DIR}/inv.proptemp
+	swap_file ${STAGE_DIR}/inv.proptemp ${STAGE_DIR}/inv.prop
+
+	extract_key_props ${KEY_NAME} num-bits ${STAGE_DIR}/nb.proptemp
+	swap_file ${STAGE_DIR}/nb.proptemp ${STAGE_DIR}/nb.prop
+
+	#no separate public key will be part of the image, since these props serve the purpose.
+	# Hash will be computed on the Props itself
+	cat ${STAGE_DIR}/rr.prop ${STAGE_DIR}/mod.prop ${STAGE_DIR}/exp.prop ${STAGE_DIR}/inv.prop ${STAGE_DIR}/nb.prop	> ${BINS_PROD_DIR}/${KEY_NAME}.pub
+	cat ${STAGE_DIR}/rr.prop ${STAGE_DIR}/mod.prop ${STAGE_DIR}/exp.prop ${STAGE_DIR}/inv.prop ${STAGE_DIR}/nb.prop	> ${BINS_PROD_DIR}/${KEY_NAME}-key-props.bin
+
+	rm -f ${STAGE_DIR}/*.txt ${STAGE_DIR}/*.proptemp ${STAGE_DIR}/*.prop
+}
+
+function hl_chksum_padding {
+	# Add zero padding for compatibility with image descriptors size.
+	local pad_dwords=$1
+	local pad_data=0
+
+	for i in $(seq 1 $pad_dwords); do
+		printf "%08x" $pad_data
+	done
+}
+
+function prep_img_desc_with_crc {
+	BINFILE=$1
+	OUTFILENAME=$(basename $1)
+	cat ${BINFILE}>${BINFILE}.tmp.pad
+	dd status=none conv=sync bs=16 if=${BINFILE}.tmp.pad of=${BINFILE}.tmp.algn
+	hl_calc_crc32 ${BINFILE}.tmp.algn
+	cat ${BINFILE}.tmp.algn ${BINFILE}.tmp.algn.crc32 > ${BINS_DIR}/${DEV_PREFIX}-${OUTFILENAME}
+	rm -rf ${BINFILE}.tmp*
+}
+
+function hl_chksum_add {
+	local checksum=$1
+
+	# Update the sha384 checksum field
+	echo $checksum
+}
+
+function print_image_chksum {
+	local name=${1^^}
+	local BINFILE=$(eval "echo \${${name}_BINFILE}")
+
+	#align the source binaries to 16 bytes
+	dd status=none conv=sync bs=16 if=${BINFILE} of=${BINFILE}.tmp.pad
+	# Prepare checksum
+	local CKSUM=`sha384sum ${BINFILE}.tmp.pad`
+	hl_chksum_add ${CKSUM}
+	rm -f ${BINFILE}.tmp.pad
+}
+
+function prep_img_crc32 {
+	local name=${1^^}
+	local BINFILE=$(eval "echo \${${name}_BINFILE}")
+
+	# reverse CRC32 source as DMA engine works like that
+	hl_reverse_words ${BINFILE} ${BINFILE}.out 4
+	CRC32=$(crc32 ${BINFILE}.out)
+	echo ${CRC32}
+}
+
+function get_spi_component_ver() {
+	local img_name=${1^^}
+	local baremetal_comp=("PPBOOT" "EROM_PCIE" "EROM_RECOVERY")
+	local preboot_comp=("PREBOOT")
+	local ver
+
+	if [ $img_name == $preboot_comp ]; then
+		ver=$(cat ${BR2_EXTERNAL}/output/${DEV_PREFIX}/build/preboot-custom/localversion-habanalabs)
+		echo ${ver#*-}
+		return
+	fi
+
+	for i in "${baremetal_comp[@]}"; do
+		if [ $img_name == $i ]; then
+			ver=$(cat ${BR2_EXTERNAL}/output/${DEV_PREFIX}/build/baremetal-custom/localversion-habanalabs)
+			echo ${ver#*-}
+			return
+		fi
+	done
+
+	echo "no version"
+}
+
+function print_image_version {
+	local img_name=${1}
+	local img_ver_str=$(get_spi_component_ver $img_name)
+	local max_ver_len=128
+
+	echo -n $img_ver_str | xxd -p
+
+	#pad the remaining space with zeroes
+	local ver_len=${#img_ver_str}
+	local ver_pad=$(($max_ver_len - $ver_len))
+	if [ $ver_len -eq $max_ver_len ]; then
+		return;
+	fi
+
+	for i in $(seq 1 $ver_pad); do
+		printf "%02x" 0
+	done
+}
+
+function print_image_desc {
+	local img_name=$1
+	local img_num=$2
+	local -n spi_reg_offsets=$3
+	local img_base_pri=$(get_image_base "$img_name"_PRI)
+	local img_base_sec=$(get_image_base "$img_name"_SEC)
+	local img_load=$(get_image_loadaddr $img_name)
+	local img_loadh=$((img_load >> 32))		# take upper bytes
+	local img_loadl=$((img_load & 0xFFFFFFFF))	# take lower bytes
+	local img_dma_alt_h_0=${img_loadh}
+	local img_dma_alt_l_0=${img_loadl}
+	local img_dma_alt_h_1=${img_loadh}
+	local img_dma_alt_l_1=${img_loadl}
+	local img_name_2=$img_name
+	local img_flags=0
+	local img_cpu_base=0
+	local img_mem_base_l=0
+	local img_mem_base_h=0
+	local img_mem_size=0
+
+	if [ $img_name == "PPBOOT" ]
+	then
+		img_name_2="PPBOOT_PCIE_PHY_PADDED"
+		# prefetch location address for secondary ppboot image
+		img_dma_alt_h_1=$((PPBOOT_ALT_DMA_ADDR >> 32))		# take upper bytes
+		img_dma_alt_l_1=$((PPBOOT_ALT_DMA_ADDR & 0xFFFFFFFF))	# take lower bytes
+		img_base_pri=${spi_reg_offsets[PPBOOT_PRIMARY]}
+		img_base_sec=${spi_reg_offsets[PPBOOT_SECONDARY]}
+	fi
+
+	if [ $img_name == "PREBOOT" ]
+	then
+		img_base_pri=${spi_reg_offsets[PREBOOT_IO_DIE_PRIMARY]}
+		img_base_sec=${spi_reg_offsets[PREBOOT_IO_DIE_SECONDARY]}
+		img_cpu_base=${PREBOOT_CPU_BASE_ADDR}
+		img_flags=${PREBOOT_IMAGE_FLAGS}
+	fi
+
+	if [ $img_name == "FAKE_FUSE" ]
+	then
+		img_base_pri=${spi_reg_offsets[FAKE_FUZE_PRIMARY]}
+		img_base_sec=${spi_reg_offsets[FAKE_FUZE_SECONDARY]}
+	fi
+
+	if [ $img_name == "EROM_PCIE" -o $img_name == "EROM_RECOVERY" -o $img_name == "PREBOOT" -o $img_name == "PREBOOT_D1" ]
+	then
+		img_name_2=${img_name}_PADDED
+	fi
+
+	local img_size=$(get_image_size $img_name_2)
+	local start_addr=$(get_image_startaddr $img_name)
+	local start_addr_h=$((start_addr >> 32))		# take upper bytes
+	local start_addr_l=$((start_addr & 0xFFFFFFFF))	# take lower bytes
+	local size_corr_fac=0
+
+	if [[ ${ipnames[$i]} != "FAKE_FUSE"* ]];
+	then
+		local num_slices=$((img_size / MAX_SPI_DMA_DATA_TRANSFER))
+		local modulo_slices=$((img_size % MAX_SPI_DMA_DATA_TRANSFER))
+		if [ ${modulo_slices} -ne 0 ]; then
+			((++num_slices))
+		fi
+
+		size_corr_fac=$((num_slices * 4))
+	fi
+
+	local img_size_final=$((img_size+size_corr_fac))
+
+	# Prepare descriptor magic "PTR"0x$img_num
+	printf "%x%x%x%02x" "'P" "'T" "'R" $img_num | rev_bytes_stdin
+
+	# Prepare descriptor version
+	local ver=$(grep CUR_VER ${SPEC_BOOT_DESC_HDR_FILE} | awk '{print $3}')
+	printf "%08x" $ver | rev_bytes_stdin
+
+	# Array of spi offsets, for primary and secondary images
+	printf "%08x" $img_base_pri | rev_bytes_stdin
+	printf "%08x" $img_base_sec | rev_bytes_stdin
+
+	# Prepare image size
+	printf "%08x" $img_size_final | rev_bytes_stdin
+
+	# If one of the addresses is empty use 0x0 instead
+	# Prepare image load address high
+	printf "%08x" $img_loadh | rev_bytes_stdin
+	# Prepare image load address low
+	printf "%08x" $img_loadl | rev_bytes_stdin
+
+	prep_img_crc32 $img_name_2
+
+	print_image_chksum $img_name_2
+
+	# Prepare image start address high
+	printf "%08x" $start_addr_h | rev_bytes_stdin
+	# Prepare image start address low
+	printf "%08x" $start_addr_l | rev_bytes_stdin
+
+	# Prepare default image dma address high
+	printf "%08x" $img_dma_alt_h_0 | rev_bytes_stdin
+	# Prepare alternative image dma address high
+	printf "%08x" $img_dma_alt_h_1 | rev_bytes_stdin
+	# Prepare default image dma address low
+	printf "%08x" $img_dma_alt_l_0 | rev_bytes_stdin
+	# Prepare alternative image dma address low
+	printf "%08x" $img_dma_alt_l_1 | rev_bytes_stdin
+
+	# Prepare component version
+	print_image_version $img_name
+
+	# Prepare autoload parameters
+	printf "%08x" $img_cpu_base | rev_bytes_stdin
+	printf "%08x" $img_mem_base_h | rev_bytes_stdin
+	printf "%08x" $img_mem_base_l | rev_bytes_stdin
+	printf "%08x" $img_mem_size | rev_bytes_stdin
+	printf "%08x" $img_flags | rev_bytes_stdin
+}
+
+function prep_image_ptrs_common_v1 {
+	local img_file=$1
+	local out_file=$1
+	local KEY_NUM=0
+	local IMG_TYPE=$2
+	declare -A SPI_REGION_OFFSETS
+	declare -A SPI_REGION_SIZES
+
+	if [ ${IMG_TYPE} == ${IMAGE_TYPE_FAKE_FUSE} ]
+	then
+		KEY_NUM=0 # 255 to stop, < 255 to write slave Fake fuse values.
+	fi
+
+	hl_parse_spi_flash_regions SPI_REGION_OFFSETS SPI_REGION_SIZES jgs
+
+	# Prepare empty space for size of boot pointer and size of image pointer.
+	echo -ne '\x00\x00\x00\x00\x00\x00\x00\x00' > $img_file
+
+	local ipnames=0
+
+	# The elements in the array should be in the order of hl_fw_img_type enums
+	local ipnames_spi_img=("PREBOOT" "PPBOOT" "FAKE_FUSE")
+	local ipnames_erom=("EROM_PCIE" "EROM_RECOVERY")
+
+	# Image pointers
+	if [ ${IMG_TYPE} == ${IMAGE_TYPE_EROM} ]
+	then
+		ipnames=("${ipnames_erom[@]}")
+		# Pointers structure magic "NXT"0x0
+		printf "%x%x%x00" "'N" "'X" "'T" | rev_bytes_stdin | xxd -r -p -s +8 - $img_file
+	elif [ ${IMG_TYPE} == ${IMAGE_TYPE_SPI} ]
+	then
+		ipnames=("${ipnames_spi_img[@]}")
+		# Pointers structure magic "NXT"0x0
+		printf "%x%x%x00" "'N" "'X" "'T" | rev_bytes_stdin | xxd -r -p -s +8 - $img_file
+	elif [ ${IMG_TYPE} == ${IMAGE_TYPE_FAKE_FUSE} ]
+	then
+		ipnames=("${FAKE_FUSE_ARRAY[@]}")
+		# Fake Fuse Low Voltage Attack magic "LVA"0x2
+		printf "%x%x%x%02x" "'L" "'V" "'A" $IMG_TYPE | rev_bytes_stdin | xxd -r -p -s +8 - $img_file
+	else
+		echo "Error: wrong Image type"
+		exit 1
+	fi
+
+	local ipnum=${#ipnames[*]}
+
+	local offs_corr_fac=0
+
+	printf "%08x" $ipnum | rev_bytes_stdin | xxd -r -p -s +12 - $img_file
+
+	local pub_key_size=784
+	#Prepare pub key size
+	printf "%08x" $pub_key_size | rev_bytes_stdin | xxd -r -p -s +16 - $img_file
+
+	local sig_size=384
+	#Prepare signature size
+	printf "%08x" $sig_size | rev_bytes_stdin | xxd -r -p -s +20 - $img_file
+
+	local sec_version=$(grep FW_VERSION ${SPEC_SECURITY_HDR_FILE} | awk '{print $3}')
+	#Prepare security version
+	printf "%02x" $sec_version | rev_bytes_stdin | xxd -r -p -s +24 - $img_file
+
+	local key_idx=$KEY_NUM
+	#Prepare key index
+	printf "%02x" $key_idx | rev_bytes_stdin | xxd -r -p -s +25 - $img_file
+
+	local boot_ptrs_version=$(grep HL_FW_BOOT_VERSION ${SPEC_HL_BOOT_DESC_HDR_FILE} | awk '{print $3}')
+	#Prepare boot_ptrs_version
+	printf "%02x" $boot_ptrs_version | rev_bytes_stdin | xxd -r -p -s +26 - $img_file
+
+	local boot_ptrs_size=$IMG_PTR_SZ
+	#Prepare boot_ptrs_size
+	printf "%02x" $boot_ptrs_size | rev_bytes_stdin | xxd -r -p -s +27 - $img_file
+
+	local offset_array=$IMG_PTR_SZ
+	#Prepare security version for Stable image
+	printf "%08x" $offset_array | rev_bytes_stdin | xxd -r -p -s +28 - $img_file
+
+	# Pointer structure offsets
+	local img_descs_base_off=$((IMG_PTR_SZ + (ipnum * 4)))
+	for ((i=0; i<$ipnum; i++)); do
+		local offset=$((img_descs_base_off + (i * IMG_DESC_SZ)))
+		local offloc=$((IMG_PTR_SZ + (i * 4)))
+
+		# Prepare pointer (offset) to descriptor
+		printf "%08x" $offset | rev_bytes_stdin | xxd -r -p -s +$offloc - $img_file
+
+		# Prepare descriptor
+		print_image_desc ${ipnames[$i]} $((i + 1)) SPI_REGION_OFFSETS | xxd -r -p -s +$offset - $img_file
+	done
+
+	if [ ${IMG_TYPE} != ${IMAGE_TYPE_FAKE_FUSE} ]
+	then
+		if [ ${KEY_NUM} -eq 0 ]; then
+			KEY_NAME=$(echo -n "hl_${KEY_BASE_NAME}")
+		else
+			KEY_NAME=$(echo -n "cust${KEY_NUM}_${KEY_BASE_NAME}")
+		fi
+
+		#Extract Key Properties and store them in a bin file
+		hl_get_key_props ${KEY_NUM}
+
+		TEMPNAME=${FUNCNAME}
+		TEMPFULLNAME=${STAGE_DIR}/${FUNCNAME}
+		dd status=none conv=sync bs=16 if=$img_file			> ${TEMPFULLNAME}
+
+		PKFILE=${TEMPNAME}.payload.key
+		PKFULLFILE=${TEMPFULLNAME}.payload.key
+
+		cat ${TEMPFULLNAME} ${BINS_PROD_DIR}/${KEY_NAME}-key-props.bin > ${PKFULLFILE}
+
+		#The size of the complete image(Payload + Key + Signature) needs to be calculated
+		#and placed in the manifest even before hashing and signing over it as the size
+		#data itself needs to be hashed. Due to this we are required to calculate the
+		#complete image size to be dmaed by considering payload + key + signature + CRC size.
+		#PL NOTE: We also need to consider the 16 byte alignment in case the resultant
+		#size of (payload + key + signature) is not 16 byte aligned. This is because
+		#of dma requirement to place the crc at the end of a 16 byte aligned image.
+		#Hence the final formula = ALIGN_16(Payload + Key + Signature) + CRC
+
+		#payload + key size
+		local pk_sz=$(stat -Lc "%s" $(eval "echo \${PKFULLFILE}"))
+		#size to be aligned to
+		local align_sz=16
+		#payload + key + signature size
+		local pk_sig_sz=$((pk_sz+sig_size))
+		#ALIGN(payload + key + signature size)
+		local pk_sig_align_sz=$(((pk_sig_sz+align_sz-1)/align_sz*align_sz))
+		#ALIGN(payload + key + signature size) + CRC size
+		printf "%08x" $((pk_sig_align_sz+4)) | rev_bytes_stdin | xxd -r -p -s +0 - ${PKFILE}
+
+		printf "%08x" $IMG_DESC_SZ | rev_bytes_stdin | xxd -r -p -s +4 - ${PKFILE}
+
+		$OPENSSL dgst -sha384 -binary ${PKFULLFILE} > ${PKFULLFILE}.sha384
+
+		hl_sign_bin ${PKFULLFILE} ${STAGE_DIR}/${KEY_NAME}
+
+		SIGBINFILE=${PKFILE}.sig.bin
+
+		cat ${PKFULLFILE} ${PKFULLFILE}.sig > ${STAGE_DIR}/${SIGBINFILE}
+
+		prep_img_desc_with_crc ${STAGE_DIR}/${SIGBINFILE}
+
+		hl_reverse_words ${STAGE_DIR}/${DEV_PREFIX}-${SIGBINFILE} $out_file 4
+	else
+		local boot_ptr_size=$(stat -Lc "%s" $(eval "echo \${img_file}"))
+		local align_sz=16
+		#ALIGN(payload)
+		boot_ptr_size=$(((boot_ptr_size+align_sz-1)/align_sz*align_sz))
+		#ALIGN(payload) + CRC size
+		printf "%08x" $((boot_ptr_size+4)) | rev_bytes_stdin | xxd -r -p -s +0 - ${img_file}
+		printf "%08x" $IMG_DESC_SZ | rev_bytes_stdin | xxd -r -p -s +4 - ${img_file}
+		prep_img_desc_with_crc ${img_file}
+		hl_reverse_words ${DEV_PREFIX}-${img_file} $out_file 4
+	fi
+}
+
+function prep_image_ptrs {
+	prep_image_ptrs_common_v1 $1 $IMAGE_TYPE_SPI
+	return
+}
+
+function calculate_hash {
+	# TODO fill with content
+
+	# creating temporary dummy hash result
+	touch ${BINS_PROD_DIR}/hl_rsa3072.pub.hash
+
+	return
+}
+
+function hl_pad_arcboot_rom {
+	cp ${BINS_DIR}/${ARCBOOT_BINFILE} ${BINS_DIR}/${ARCBOOT_BINFILE_ORIG}
+
+	# TODO: pad size different for compute
+	# pad arcboot rom binary to size of ROM memory
+	dd status=none conv=sync bs=128K if=${ARCBOOT_BINFILE_ORIG} > ${ARCBOOT_BINFILE}
+}
+
+# ToDo remove after agent fw check patches related to FSW-3432
+function create_spi_image {
+	local OUTF=${1}
+	local PPBOOT_BIN=${2}
+	local PREBOOT_BIN=${3}
+	local IMG_PTR_BIN=${4}
+	local FAKE_FUSE_BIN=${5}
