From db52d4f278e23956335235283185e324a8e3175f Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Sat, 28 Apr 2018 16:18:21 +0300
Subject: [PATCH] Add Raspberry Pi build support

Invoke run_armcp_regs_cli or armcpd
---

diff --git a/Makefile b/Makefile
index 0ffd62b..d5449a9 100644
--- a/Makefile
+++ b/Makefile
@@ -4,6 +4,7 @@
 	@echo '  dali-distclean       - Delete all Dali files created by build'
 	@echo
 	@echo 'Build:'
+	@echo '  dali-rpi-build       - Build for Raspberry Pi'
 	@echo '  dali-<borad>-build   - Build for <board> e.g. onix, pldm, asic'
 	@echo '  optional environment variables:'
 	@echo '    SPL_BINFILE        - Alternative SPL binary <PATH>'
@@ -54,6 +55,26 @@
 dali-onix-build dali-pldm-build dali-asic-build: $(OUTPUT_DIR)/.config
 	@$(MAKE) all
 
+.PHONY: dali-rpi-build dali-rpi-armcp dali-rpi-gpio-mdio dali-rpi-regs-cli
+dali-rpi-gpio-mdio: SHELL=/bin/bash
+dali-rpi-gpio-mdio: .SHELLFLAGS=-i -c
+dali-rpi-regs-cli: SHELL=/bin/bash
+dali-rpi-regs-cli: .SHELLFLAGS=-i -c
+dali-rpi-armcp:
+	@mkdir -p $(OUTPUT_DIR)/build
+	@rsync -au --exclude .git $(BR2_EXTERNAL)/../specs/ ${OUTPUT_DIR}/build/specs-custom
+	@rsync -au --exclude .git $(BR2_EXTERNAL)/../specs_external/ ${OUTPUT_DIR}/build/specs_external-custom
+	@rsync -au --exclude .git $(BR2_EXTERNAL)/../3rd-parties/spdlog/ ${OUTPUT_DIR}/build/spdlog-custom
+	@rsync -au --exclude .git $(BR2_EXTERNAL)/../armcp/ ${OUTPUT_DIR}/build/armcp-custom
+	@mkdir -p ${OUTPUT_DIR}/build/armcp-custom/build
+	@cd ${OUTPUT_DIR}/build/armcp-custom/build && cmake -DTARGET_BUILD:STRING=Fpga ../
+	@cd ${OUTPUT_DIR}/build/armcp-custom/build && make -j 4
+dali-rpi-gpio-mdio:
+	@cd && build_and_insmod_gpio_mdio
+dali-rpi-regs-cli:
+	@cd && build_armcp_regs_cli
+dali-rpi-build: dali-rpi-armcp dali-rpi-gpio-mdio dali-rpi-regs-cli
+
 IMAGES_DIR := ${OUTPUT_DIR}/images
 UBOOT_BASE := ${OUTPUT_DIR}/build/uboot-custom
 LINUX_BASE := ${OUTPUT_DIR}/build/linux-custom
