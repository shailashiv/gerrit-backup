From e34b54f302dde3a950aaf2b4be0d1c8766e2a188 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Tue, 23 Jul 2024 17:00:30 +0300
Subject: [PATCH] [FSW-7266] fs1: update descriptors location

Descriptors are placed in the beginning of the flash

Change-Id: I58eddb7788d135850352709870aed5430bb240e1
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/arch/fs1/arc/soc.h b/arch/fs1/arc/soc.h
index 58219c8..1b43769 100644
--- a/arch/fs1/arc/soc.h
+++ b/arch/fs1/arc/soc.h
@@ -107,8 +107,8 @@
 #define BOOT_PTR_REC_DMA_DEST_ARC	(HL_FW_MEM_BASE + BOOT_DESC_REC_OFFSET)
 
 
-/* spi images(ppboot, preboot etc) pointer binary placed in flash at sector 6 */
-#define SPI_IMG_PTRS_BASE			(0x60000)
+/* spi images(ppboot, preboot etc) pointer binary placed in flash at sector 0 */
+#define SPI_IMG_PTRS_BASE		0
 /* spi img boot descriptors are DMA trans to ARC1 ICCM at offset 0 */
 #define BOOT_DESC_SPI_IMG_OFFSET	(HL_ICCM_OFFSET)
 #define BOOT_PTR_SPI_DMA_DEST		(HL_FW_MEM_BASE_FULL + BOOT_DESC_SPI_IMG_OFFSET)
