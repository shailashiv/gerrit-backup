From 95d53791e486b0b1e6b7d14f96b4cf423144d8ed Mon Sep 17 00:00:00 2001
From: Akshay Pradip Bharad <apbharad@habana.ai>
Date: Fri, 06 Jun 2025 07:32:42 +0000
Subject: [PATCH] Revert "[SW-227647] ipm: process no of msgs based on pi count"

This reverts commit 6e552e295eebfa4a09a0e885a410bc4357bc6a75.

Change-Id: I7f85f8f75602783648c7a233ee9cb13252c6cdb8
---

diff --git a/drivers/ipm/ipm_hl.c b/drivers/ipm/ipm_hl.c
index ca79d53..552cc6a 100644
--- a/drivers/ipm/ipm_hl.c
+++ b/drivers/ipm/ipm_hl.c
@@ -17,49 +17,28 @@
 #define LOG_MODULE_NAME			ipm_hl
 LOG_MODULE_REGISTER(LOG_MODULE_NAME, CONFIG_IPM_LOG_LEVEL);
 
-/*
- * Beware that this function is called from ISR. It processes the message and
- * sends an ACK to the sender.
- */
-static void process_message(const struct device *dev, struct ipm_hl_msg_hdr *msg)
-{
-	struct ipm_hl_data *data = DEV_DATA(dev);
-	uint8_t *addr = (uint8_t *)msg;
 
-	LOG_DBG("MSG RECEIVED: id: %d size: %d", msg->id, msg->size);
-	LOG_HEXDUMP_DBG((addr + sizeof(struct ipm_hl_msg_hdr)), msg->size, "receive");
-
-	/* Use zero copy */
-	if (data->callback)
-		data->callback(dev, data->user_data, msg->id,
-			(void *)(addr + sizeof(struct ipm_hl_msg_hdr)));
-	else
-		LOG_ERR("Callback not registered for IPM HL dev %p", dev);
-
-	msg->ack = true;
-	data->rx_ctrl->ci++;
-}
-
-/*
- * Beware that this function is called from ISR. It finds the message in the mailbox
- * and process it. If the message is not found, it returns false.
- */
-
-static bool find_and_process_message(const struct device *dev)
+void ipm_hl_isr(const struct device *dev)
 {
 	const struct ipm_hl_config *config = DEV_CFG(dev);
 	struct ipm_hl_data *data = DEV_DATA(dev);
 	struct ipm_hl_msg_hdr *msg = NULL;
+	uint8_t *addr;
 	uint32_t i;
+
+	if (data->rx_ctrl->pi == data->rx_ctrl->ci) {
+		LOG_WRN("Spurious interrupt received. PI: %d, CI: %d",
+			data->rx_ctrl->pi, data->rx_ctrl->ci);
+		return;
+	}
 
 	for (i = 0; i < config->rx.num_non_data_chunks; i++) {
 		msg = (struct ipm_hl_msg_hdr *) (data->rx_ndata_base +
-			   (i * data->chunk_hdr_sz));
+						(i * data->chunk_hdr_sz));
 
 		if ((msg->busy) && (!msg->ack)) {
 			if (msg->seq_no == data->rx_ctrl->ci) {
-				process_message(dev, msg);
-				return true;
+				goto process_msg;
 			} else {
 				LOG_DBG("Out of Order Msg. seq_no: %d expected: %d",
 					msg->seq_no, data->rx_ctrl->ci);
@@ -73,8 +52,7 @@
 
 		if ((msg->busy) && (!msg->ack)) {
 			if (msg->seq_no == data->rx_ctrl->ci) {
-				process_message(dev, msg);
-				return true;
+				goto process_msg;
 			} else {
 				LOG_DBG("Out of Order Msg. seq_no: %d expected: %d",
 					msg->seq_no, data->rx_ctrl->ci);
@@ -82,27 +60,24 @@
 		}
 	}
 
-	LOG_WRN("Spurious interrupt received. PI: %d, CI: %d",
-		data->rx_ctrl->pi, data->rx_ctrl->ci);
-	return false;
-}
+	LOG_WRN("Spurious interrupt received. Possibly due to sequence number mismatch");
 
-void ipm_hl_isr(const struct device *dev)
-{
-	struct ipm_hl_data *data = DEV_DATA(dev);
-	uint32_t num_of_msgs = data->rx_ctrl->pi - data->rx_ctrl->ci;
+	return;
 
-	if (num_of_msgs == 0) {
-		LOG_WRN("Spurious interrupt received");
-		return;
-	}
+process_msg:
+	addr = (uint8_t *) msg;
+	LOG_DBG("MSG RECEIVED: id: %d size: %d", msg->id, msg->size);
+	LOG_HEXDUMP_DBG((addr + sizeof(struct ipm_hl_msg_hdr)), msg->size, "receive");
 
-	while (num_of_msgs > 0) {
-		if (!find_and_process_message(dev)) {
-			break;
-		}
-		num_of_msgs = data->rx_ctrl->pi - data->rx_ctrl->ci;
-	}
+	/* Use zero copy */
+	if (data->callback)
+		data->callback(dev, data->user_data, msg->id,
+				(void *)(addr + sizeof(struct ipm_hl_msg_hdr)));
+	else
+		LOG_ERR("Callback not registered for IPM HL dev %p", dev);
+
+	msg->ack = true;
+	data->rx_ctrl->ci++;
 }
 
 /*
