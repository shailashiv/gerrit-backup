From b6361f21728fefa3e82718be8a249705ac444c38 Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Sun, 20 Jun 2021 23:36:09 +0300
Subject: [PATCH] [SW-46313] gaudi: security: make sf memmap dyn cfg

Add support for enabling the read-only access to the memory-mapped SPI
flash reagion.
The preboot_security_sf_pci_set_ro() function can be used to
enable/disable the R/O access.

Change-Id: I11c7ab805894355f0d1aec7da2af6ed42e10ae4d
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/gaudi/security.c b/gaudi/security.c
index 4d6b0ba..e02573c 100644
--- a/gaudi/security.c
+++ b/gaudi/security.c
@@ -1657,6 +1657,7 @@
 	VERS_END_TO_IMG,
 	IMAGE,
 	IMG_END_TO_SRAM_END,
+	STM_SF_MEMMAP,
 	SPSRAM_IMAGE,
 };
 
@@ -1691,6 +1692,11 @@
 		.rr = PCIE_DYN_RR_SRAM_END,
 		.min = 0,
 		.max = SRAM_END,
+	},
+	[STM_SF_MEMMAP] = {
+		.rr = PCIE_DYN_RR_STM_SF,
+		.min = mmSTM_BASE - 1,
+		.max = HL_SPI_END,
 	},
 	[SPSRAM_IMAGE] = {
 		.rr = PCIE_DYN_RR_SPSRAM_IMG,
@@ -1962,3 +1968,16 @@
 				  HBM_RR_MASK, true);
 	preboot_hbw_rr_set_rtr_ar(HBW_RR_HBM, PCI_RTR_NO, 0, 0, false);
 }
+
+void preboot_security_sf_pci_set_ro(bool en)
+{
+	struct preboot_sec_dyn_pcie_rr_cfg *cfg;
+
+	if (!preboot_security_is_enabled())
+		return;
+
+	cfg = &preboot_sec_dyn_cfg[STM_SF_MEMMAP];
+	preboot_secure_pcie_rr_wr(cfg->rr, cfg->min, cfg->max);
+	preboot_secure_pcie_rr_rd(cfg->rr, cfg->min,
+				  en ? HL_SPI_BASE : cfg->max);
+}
diff --git a/include/security.h b/include/security.h
index bbca703..61e2cfb 100644
--- a/include/security.h
+++ b/include/security.h
@@ -21,5 +21,6 @@
 void preboot_security_cleanup_before_run(void);
 void preboot_security_sp_sram_write_key_hash(u8 *key, size_t len);
 void preboot_security_hbm_pci_open_ro(void);
+void preboot_security_sf_pci_set_ro(bool en);
 
 #endif /* _HL_SECURITY_H_ */
