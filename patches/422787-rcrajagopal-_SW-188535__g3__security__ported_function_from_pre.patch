 #define EN_ARC_SEC_PRIV				0x3
diff --git a/arch/gaudi3/common/security.c b/arch/gaudi3/common/security.c
index 790f0c8..b9c9eb6 100644
--- a/arch/gaudi3/common/security.c
+++ b/arch/gaudi3/common/security.c
@@ -33,6 +33,12 @@
 #include <hl_protbits_fw_if.h>
 #include <security.h>
 #include "security_defs.h"
+#include <hl_boot_desc.h>
+#include <boot_info.h>
+#include <arcboot_export_dev.h>
+#include <fit.h>
+#include <fit_rsa.h>
+#include <sha.h>
 
 #define RR_HBW_PRIV_RANGE_MIN		0x0
 /* Below value is to keep HBW RRs configured at 16KB granularity */
@@ -1078,3 +1084,90 @@
 		preboot_puts("Security disabled.");
 	}
 }
+
+void preboot_security_boot_info_write_key_idx(u32 *key_idx)
+{
+	if (hl_boot_info_set(HL_BOOT_INFO_KEY_IDX, key_idx, sizeof(u32)))
+		preboot_puts("BOOT_INFO: Failed to set fw info\n");
+}
+
+bool preboot_security_is_enabled(void)
+{
+	return !!(sec_data.efuse_sys_cfg & EFUSE_SEC_EN_MASK);
+}
+
+bool preboot_img_validation_is_enabled(void)
+{
+	return !!(sec_data.efuse_sys_cfg & EFUSE_SEC_SIG_VAL_EN_MASK);
+}
+
+int preboot_security_get_svn_ver(void)
+{
+	return sec_data.sec_ver;
+}
+
+int preboot_security_get_minimal_svn(void)
+{
+	return preboot_security_get_svn_ver();
+}
+
+bool hl_extract_hash_from_key(const void *pub_key, u8 *value)
+{
+	struct rsa_key_prop prop;
+	u8 key_props[PUB_KEY_SZ];
+	const char *key_name = HL_SEC_KEY_NAME;
+
+	/*
+	 * ROM stores hash of public key properties. The public
+	 * key received as part of fit is the complete public key dtb of
+	 * 3144-bytes. Extract key properties and compute hash on 784 bytes
+	 * of key properties to compare with stored ROM/eFUSE hash.
+	 */
+	if (fit_get_key_prop(pub_key, key_name, &prop)) {
+		preboot_puts("Failed to get key properties\n");
+		return false;
+	}
+
+	memset(key_props, 0, sizeof(key_props));
+	memcpy(key_props, prop.rr, KEY_PROP_RR_SZ);
+	memcpy((key_props + KEY_PROP_RR_SZ), prop.modulus, KEY_PROP_MOD_SZ);
+	memcpy((key_props + KEY_PROP_RR_SZ + KEY_PROP_MOD_SZ), prop.public_exponent,
+		KEY_PROP_EXP_SZ);
+	memcpy((key_props + KEY_PROP_RR_SZ + KEY_PROP_MOD_SZ + KEY_PROP_EXP_SZ),
+		&prop.n0inv, KEY_PROP_INV_SZ);
+	memcpy((key_props + KEY_PROP_RR_SZ + KEY_PROP_MOD_SZ + KEY_PROP_EXP_SZ +
+		KEY_PROP_INV_SZ), &prop.num_bits, KEY_PROP_NB_SZ);
+
+	sha_csum(key_props, PUB_KEY_SZ, value);
+
+	return true;
+}
+
+bool preboot_security_key_is_valid(int key_idx, const void *pub_key,
+			 int pub_key_len, const void *pub_key_ext,
+			 int pub_key_ext_len)
+{
+	u8 value[SHA_SUM_LEN];
+	uint8_t expected_hash[SHA384_SUM_LEN];
+
+	if (!hl_extract_hash_from_key(pub_key, value))
+		return false;
+
+	if (security_rom_get_key_hash_by_idx((uint32_t *)expected_hash, key_idx))
+		return false;
+
+	return !memcmp(value, expected_hash, SHA384_SUM_LEN);
+}
+
+bool preboot_security_key_is_revoked(int key_idx)
+{
+	if (key_idx < 0 || key_idx >= SEC_KEY_HASH_COUNT_IN_ROM)
+		return true;
+
+	if (sec_data.key_revoke & BIT(key_idx))
+		return true;
+
+	fw_info.sec_revoked_keys = sec_data.key_revoke;
+
+	return false;
+}
