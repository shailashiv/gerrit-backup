+	// This check is for preboot log lines:
+	// Category is in position 0
+	if (length >= LFS_SEVERITY_POS_WITHOUT_TIMESTAMP + strlen(LFS_ERROR_WITHOUT_TIMESTAMP))
+		if (memcmp(data + LFS_SEVERITY_POS_WITHOUT_TIMESTAMP,
+				LFS_ERROR_WITHOUT_TIMESTAMP,
+				strlen(LFS_ERROR_WITHOUT_TIMESTAMP)) == 0)
+			res = true;
+
+	// This check is for arcmgmt log lines:
+	// [27-05-2025 08:42:45:031:807]: W: Failed to poll PLDM sensor: sensor_id 237 err 1
+	// Category is in position 30
+	if (!res && length >= LFS_SEVERITY_POS_WITH_TIMESTAMP + strlen(LFS_ERROR_WITH_TIMESTAMP))
+		if (memcmp(data + LFS_SEVERITY_POS_WITH_TIMESTAMP,
