+static void lfs_work_handler(struct k_work *item)
+{
+	struct lfs_work *work = CONTAINER_OF(item, struct lfs_work, work);
+	lfs_t *lfs = get_lfs();
+
+	switch (work->type) {
+	case LFS_FILE_SYNC_WORK:
+		if (lfs_logger.is_dirty) {
+			lfs_file_sync(lfs, &lfs_logger.log_file);
+			lfs_fs_gc(lfs);
+			lfs_logger.is_dirty = false;
+		}
+
