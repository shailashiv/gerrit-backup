+	lfs_remove(lfs, LFS_ROOT_FOLDER LOG_BACKUP_FILE_NAME);
+	rc = lfs_rename(lfs, LFS_ROOT_FOLDER LOG_FILE_NAME, LFS_ROOT_FOLDER LOG_BACKUP_FILE_NAME);
+
+	if (!rc)
+		rc = lfs_open_log_file(lfs, LFS_O_CREAT | LFS_O_WRONLY);
+
+	if (rc) {
+		backend.backend_state = BACKEND_LFS_CORRUPTED;
+		LOG_ERR("LFS: Failed to swap log files, RC=%d", rc);
