+
+static int bmu_devel_init(struct bmu_configs *config)
+{
+	switch (config->sriov) {
+	case BMU_1PF_MODE:
+		pcie_wrap_devel_1pf_init(config);
+		cfg_bmu_devel_1pf_init(config);
+		mem_bmu_1pf_init(config);
+		break;
+	case BMU_1PF_1VF_MODE:
+		pcie_wrap_devel_1vf_init(config);
+		cfg_bmu_devel_1vf_init(config);
+		mem_bmu_1vf_init(config);
+		break;
+	case BMU_1PF_4VF_MODE:
+		pcie_wrap_devel_4vf_init(config);
+		cfg_bmu_devel_4vf_init(config);
+		mem_bmu_4vf_init(config);
+		break;
+	default:
+		LOG_ERR("%s unsupported sriov mode %d", __func__, config->sriov);
+		return 1;
+	}
+
+	return 0;
+}
+
+static int bmu_prod_init(struct bmu_configs *config)
+{
+	switch (config->sriov) {
+	case BMU_1PF_MODE:
+		pcie_wrap_prod_1pf_init(config);
+		cfg_bmu_prod_1pf_init(config);
+		mem_bmu_1pf_init(config);
+		break;
+	case BMU_1PF_1VF_MODE:
+		pcie_wrap_prod_1vf_init(config);
+		cfg_bmu_prod_1vf_init(config);
+		mem_bmu_1vf_init(config);
+		break;
+	case BMU_1PF_4VF_MODE:
+		pcie_wrap_prod_4vf_init(config);
+		cfg_bmu_prod_4vf_init(config);
+		mem_bmu_4vf_init(config);
+		break;
+	default:
+		LOG_ERR("%s unsupported sriov mode %d", __func__, config->sriov);
+		return 1;
+	}
+
+	return 0;
+}
+
+/*
+ * BMU configs are taken from H15_BMU_Configs spreadsheet provided by Architecture.
+ * supported bmu config modes:
+ * phase:
+ *   - development
+ *   - production
+ * SRIOV:
+ *   - 1PF
+ *   - 1PF + 1VF
+ *   - 1PF + 4VF
+ */
+int fs1_bmu_init(struct bmu_configs *config)
+{
+	int err;
+
+	LOG_INF("BMU configs version %s", BMU_CONFIGS_VERSION);
+
+	switch (config->phase) {
+	case BMU_DEVELOPMENT_MODE:
+		err = bmu_devel_init(config);
+		break;
+	case BMU_PRODUCTION_MODE:
+		err = bmu_prod_init(config);
+		break;
+	default:
+		LOG_ERR("unsupported BMU mode %d", config->phase);
+		err = -1;
+	}
+
+	return err;
+}
