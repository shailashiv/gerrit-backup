diff --git a/include/jgs/hl_pcie.h b/include/jgs/hl_pcie.h
new file mode 100644
index 0000000..3c8a79e
--- /dev/null
+++ b/include/jgs/hl_pcie.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2024 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#ifndef NOC_CFG_INCLUDE_JGS_HL_PCIE_H_
+#define NOC_CFG_INCLUDE_JGS_HL_PCIE_H_
+
+#include <zephyr/types.h>
+
+enum bmu_phase {
+	BMU_DEVELOPMENT_MODE,
+	BMU_PRODUCTION_MODE,
+};
+
+enum bmu_sriov_mode {
+	BMU_1PF_MODE,
+	BMU_1PF_1VF_MODE,
+	BMU_1PF_4VF_MODE,
+};
+
+struct bmu_configs {
+	enum bmu_phase phase;
+	enum bmu_sriov_mode sriov;
+	uint32_t hbm_size_mb;	/* depends on hbm type and binning */
+};
+
+int fs1_bmu_init(struct bmu_configs *config);
+
+#endif /* NOC_CFG_INCLUDE_JGS_HL_PCIE_H_ */
