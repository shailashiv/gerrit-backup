From 08356fbcab4c415852494d0b594193a8a52bbda7 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Mon, 05 Aug 2024 10:31:13 +0300
Subject: [PATCH] [FSW-7920] fs1: fix cpu reg for 1.15

In image 1.15 the CPU block moved to IO0 HALF1

Change-Id: Ifc387d7030e07ba470d72552ca2087580762e9ef
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/arch/fs1/arc/common.c b/arch/fs1/arc/common.c
index 4a836db..a163c3e 100644
--- a/arch/fs1/arc/common.c
+++ b/arch/fs1/arc/common.c
@@ -151,7 +151,7 @@
 
 void device_init_ca53_cfg(void)
 {
-	ca53_cfg.arm_rst_control_reg = mmIO_0_CFG_HALF_0_SOC_0_CPU_CA53_CFG_BASE +
+	ca53_cfg.arm_rst_control_reg = mmIO_0_CFG_HALF_1_SOC_1_CPU_CA53_CFG_BASE +
 				       mmCA53_CFG_ARM_RST_CONTROL;
 }
 
