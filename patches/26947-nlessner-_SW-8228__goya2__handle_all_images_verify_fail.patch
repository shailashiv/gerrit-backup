From 06f41892e9be0eab798be3db8d9d08107954b953 Mon Sep 17 00:00:00 2001
From: Noam Lessner <nlessner@habana.ai>
Date: Sun, 02 Feb 2020 01:53:55 +0200
Subject: [PATCH] [SW-8228] goya2: handle all images verify fail

If we fail to verify primary and secondary image
deal with fallback.
Recover PCIe if ppboot/pcie_fw is bad.
Enable I2C slave if arcboot_ram is bad.

Change-Id: I46e0c7de4bb982d42ad62c1b9ab7dcff8e049409
Signed-off-by: Noam Lessner <nlessner@habana.ai>
---

diff --git a/app/arcboot_rom.c b/app/arcboot_rom.c
index e94a8d0..718142e 100644
--- a/app/arcboot_rom.c
+++ b/app/arcboot_rom.c
@@ -12,6 +12,7 @@
 #include "security.h"
 #include "secureboot.h"
 #include "spi_flash.h"
+#include "pcie.h"
 
 struct arcboot_global_s arcboot_rom_global = {
 	.config_fuse = 0,
@@ -19,12 +20,6 @@
 
 #define ARCBOOT_BRINGUP_ERROR		-1
 #define ARCBOOT_BRINGUP_OK		1
-
-static void arcboot_rom_recovery(void)
-{
-	/* TODO: add "all debug components should bypass the MMU" */
-}
-
 
 static void arcboot_rom_init(void)
 {
@@ -88,6 +83,7 @@
 
 static uint32_t arcboot_flash_image_offset(uint8_t image_ptr)
 {
+	/* TODO: switch prim/secondary relative to flag in flash */
 	uint32_t flash_image_offset;
 
 	if (image_ptr == ARCBOOT_SECONDARY) {
@@ -148,12 +144,12 @@
 
 static void arcboot_rom_bringup_pcie(void)
 {
-	/* TODO: add FLASH_IMAGE_PTR decides which image first */
 	if (arcboot_rom_bringup_pcie_images(ARCBOOT_PRIMARY) !=
 	    ARCBOOT_BRINGUP_OK) {
 		if (arcboot_rom_bringup_pcie_images(ARCBOOT_SECONDARY) !=
 		    ARCBOOT_BRINGUP_OK) {
-			arcboot_rom_recovery();
+			pcie_recovery();
+			/* TODO: deal with PCI */
 		}
 	}
 }
@@ -184,12 +180,13 @@
 	    ARCBOOT_BRINGUP_OK) {
 		if (arcboot_rom_bringup_ram_images(ARCBOOT_SECONDARY) !=
 		    ARCBOOT_BRINGUP_OK) {
-			/* TODO:					*
-			 * if (!EFUSE_SYSTEM_CONFIG_DISABLE_DEBUG_IF)	*
-			 * then enable i2c_s				*
-			 */
+			/* if debug I/F is enabled then fall back on I2C_S */
+			if ((arcboot_rom_global.config_fuse &
+			     EFUSE_SYSCFG_DISABLE_DEBUG_IF_MASK) == 0)
+				secuirty_i2c_s_enable();
 		}
 	}
+
 	/* jump to iccm start location */
 	goto *(void *)(0);
 }
