diff --git a/common/pcie.c b/common/pcie.c
new file mode 100644
index 0000000..50a07c5
--- /dev/null
+++ b/common/pcie.c
@@ -0,0 +1,112 @@
+/*
+ * Copyright 2016-2019 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ *
+ * SPDX-License-Identifier:	GPL-2.0+
+ */
+
+#include <unistd.h>
+#include "arcboot.h"
+#include "security.h"
+#include "efuse.h"
+#include "pcie.h"
+#include "delay.h"
+
+static uint8_t pcie_ltssm_en(void)
+{
+	uint8_t ltssm_en;
+
+	ltssm_en = regmap_readl(mmPCIE_AUX_LTSSM_EN);
+	return (ltssm_en & 0x1);
+}
+
+static void pcie_config(void)
+{
+	uint8_t pcie_prstn, sram_init_done;
+	uint32_t boot_strap;
+
+	if (pcie_ltssm_en()) {
+		do {
+			pcie_prstn = regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN);
+		} while (pcie_prstn != 1);
+
+		regmap_writel(0, mmPSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
+		regmap_writel(1, mmPCIE_PHY_CR_PARA_SEL_0);
+		regmap_writel(1, mmPCIE_PHY_CR_PARA_SEL_1);
+
+		boot_strap = regmap_readl(mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS_L);
+
+		if (boot_strap &
+		    PSOC_GLOBAL_CONF_BOOT_STRAP_PINS_L_SRIS_MODE_MASK)
+			regmap_writel(1, mmPCIE_PHY_PIPE_RX_SRIS_MODE_EN);
+
+		regmap_writel(1, mmPSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
+		do {
+			sram_init_done =
+				regmap_readl(mmPCIE_PHY_PHYX_SRAM_INIT_DONE_0);
+		} while (sram_init_done != 1);
+
+		do {
+			sram_init_done =
+				regmap_readl(mmPCIE_PHY_PHYX_SRAM_INIT_DONE_1);
+		} while (sram_init_done != 1);
+
+		regmap_writel(1, mmPCIE_PHY_PHYX_SRAM_EXT_LD_DONE_0);
+		regmap_writel(1, mmPCIE_PHY_PHYX_SRAM_EXT_LD_DONE_1);
+
+		/* Configure IATU */
+		regmap_writel(0x300000, mmPCIE_AUX_DBI);
+		regmap_writel(0xF0000000, mmPCIE_DBI_CORR_ERR_MASK_OFF);
+		regmap_writel(0x7F, mmPCIE_DBI_ADV_ERR_CAP_CTRL_OFF);
+		regmap_writel(0, mmPCIE_DBI_AER_EXT_CAP_HDR_OFF);
+		regmap_writel(0xC0080000, mmPCIE_DBI_UNCORR_ERR_STATUS_OFF);
+		regmap_writel(0x3, mmPCIE_AUX_LTSSM_EN);
+	}
+
+}
+
+void pcie_recovery(void)
+{
+	security_debug_if_secure();
+	security_debug_if_shared();
+
+	if (arcboot_rom_global.config_fuse & EFUSE_SYSCFG_DISABLE_DEBUG_IF_MASK)
+		secuirty_debug_if_hbw_config();
+	else
+		secuirty_i2c_s_enable();
+
+	security_spi_dma_mmu_bypass();
+	security_mem_cpy_mmu_bypass();
+	security_pcie_config();
+	pcie_config();
+}
+
+/*
+ * Wait for Boot Manager to complete PCIe image execution
+ * and return to idle state, so it won't initiate UART access anymore
+ */
+static void pcie_sync_btl(void)
+{
+	while (regmap_readl(mmPSOC_GLOBAL_CONF_BTM_FSM))
+		;
+}
+
+void pcie_warm_reset_handle(void)
+{
+	uint8_t pcie_prstn;
+	/* TODO: move to function*/
+	do {
+		pcie_prstn = regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN);
+	} while (pcie_prstn);
+
+	/* TODO: add 1uS delay */
+	udelay(BOOTMNG_STARTUP_DELAY_AFTER_PERSTN);
+	pcie_sync_btl();
+	pcie_recovery();
+}
+
+/* TODO: move to correct file */
+void fw_reset_handle(void)
+{
+
+}
