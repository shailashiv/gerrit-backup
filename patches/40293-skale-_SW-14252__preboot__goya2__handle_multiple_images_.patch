+++ b/preboot/module_lkd.c
@@ -97,7 +97,7 @@
 		wfe();
 		break;
 	case KMD_MSG_FIT_RDY:
-		image_start(sts.images[FIT_UBOOT_INDEX].loadaddr);
+		preboot_fit_start_images(sts.images);
 		/* no break */
 	default:
 		break;
