From 0a6aba1014cf0a83acb5da155c6f949ce1daaf54 Mon Sep 17 00:00:00 2001
From: Sanyog Kale <skale@habana.ai>
Date: Fri, 26 Jun 2020 11:51:27 +0300
Subject: [PATCH] [SW-14252] preboot: goya2: handle multiple images start

As boot FIT contains multiple images which are copied into respective
load address, this patch adds preboot_fit_start_images function to
handle multiple boot FIT images. preboot_fit_start_images function of
goya2_arc_gnu HL_TARGET is also modified to boot ARC0 with zephyr pid
image and jump ARC1 to zephyr mgmt image along with booting UBOOT on
ARM.

Change-Id: I229559b60ec22d9382080972da96e9e5e9918562
---

diff --git a/gaudi/common.c b/gaudi/common.c
index af1cbb8..6f0f564 100644
--- a/gaudi/common.c
+++ b/gaudi/common.c
@@ -22,6 +22,7 @@
 #include <uart.h>
 #include <string.h>
 #include <ppboot/spi.h>
+#include <preboot/fit.h>
 #include <thermal.h>
 
 #include "common.h"
@@ -249,6 +250,26 @@
 	image_entry();
 }
 
+void preboot_fit_start_images(struct fit_image *image)
+{
+	void (*image_entry)(void) = NULL;
+	u32 i;
+
+	for (i = 0; i < FIT_MAX_IMAGES; i++) {
+		if (strcmp(image[i].arch, "arm64"))
+			continue;
+
+		image_entry = (void *)image[i].loadaddr;
+		break;
+	}
+
+	/*
+	 * After image_entry, control is not expected to return
+	 * here and continue.
+	 */
+	image_entry();
+}
+
 void fit_copy_image(u64 dst, const void *buf, int len)
 {
 	preboot_puts_hex_raw("FIT loadaddr: ", (u32)(dst >> 32), false);
