From 46a606f0759c458149e98e8cddd9807e771573f8 Mon Sep 17 00:00:00 2001
From: Josh Fazekas <Josh.Fazekas@Intel.com>
Date: Fri, 23 May 2025 00:05:55 +0300
Subject: [PATCH] [SW-184431] g3: allocate real size for rma table

Change memory allocation for rma table to use actual rma table size
instead of fixed 25KB size

Change-Id: I14139cd8df646b5c8b4b6dcb8ef7e3cb73378d0b
Signed-off-by: Josh Fazekas <Josh.Fazekas@Intel.com>
---

diff --git a/arch/gaudi3/rma/rma.c b/arch/gaudi3/rma/rma.c
index f40a3c3..e3778f4 100644
--- a/arch/gaudi3/rma/rma.c
+++ b/arch/gaudi3/rma/rma.c
@@ -17,8 +17,6 @@
 #include <zephyr/logging/log.h>
 LOG_MODULE_REGISTER(GAUDI3_HBM_RMA);
 
-#define RMA_TABLE_SIZE			(25 * 1024)
-
 #define MAX_HBM_COUNT			15
 
 #define GAUDI3_HBM_PARITY_THRESHOLD	8
@@ -88,14 +86,14 @@
 
 static int table_init(struct sys_heap *mem_pool)
 {
-	rma_table = sys_heap_alloc(mem_pool, RMA_TABLE_SIZE);
+	rma_table = sys_heap_alloc(mem_pool, RMA_MAX_TOTAL_SZ);
 	if (!rma_table) {
 		LOG_ERR("Not enough memory to allocate rma_table on HBM");
 		return -ENOMEM;
 	}
 
-	memset(rma_table, 0x0, RMA_TABLE_SIZE);
-	rma_table_init((uintptr_t)rma_table, RMA_TABLE_SIZE);
+	memset(rma_table, 0x0, RMA_MAX_TOTAL_SZ);
+	rma_table_init((uintptr_t)rma_table, RMA_MAX_TOTAL_SZ);
 	return 0;
 }
 
