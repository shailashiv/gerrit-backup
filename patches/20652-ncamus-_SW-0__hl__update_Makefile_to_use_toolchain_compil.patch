From a834ef20d67eba27e25ec4c767cec810d0febcc0 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Wed, 06 Nov 2019 13:33:48 +0200
Subject: [PATCH] [SW-0] hl: update Makefile to use toolchain compiler

Do not use host compliler for preproccessing

Change-Id: I9beb1ee21c6128972df1708f4bcc56fd74f0789d
---

diff --git a/Makefile b/Makefile
index 8236064..f73ff9e 100644
--- a/Makefile
+++ b/Makefile
@@ -47,16 +47,16 @@
 	@cut -d' ' -f2- $< | xxd -r -p | dd status=none bs=16 count=$$(($(FW_SIZE) / 16)) conv=sync,swab of=$@
 
 common/pcie_phy_fw.i: common/pcie_phy_fw.hex
-	@gcc -x c -E -P -nostdinc -o $@ $<
+	@$(CC) -x c -E -P -nostdinc -o $@ $<
 
 $(LD_SCRIPT): $(LD_SCRIPT).S
 	@$(CC) -E -P -nostdinc -o $@ $<
 
 %.o: %.c $(AUTO_GENERATED_FILE)
-	$(CC) $(CFLAGS) -o $@ $<
+	@$(CC) $(CFLAGS) -o $@ $<
 
 %.o: %.S $(AUTO_GENERATED_FILE)
-	$(CC) $(SFLAGS) -o $@ $<
+	@$(CC) $(SFLAGS) -o $@ $<
 
 clean:
 	rm -f $(PREBOOT_OBJECTS) $(AUTO_GENERATED_FILE)
