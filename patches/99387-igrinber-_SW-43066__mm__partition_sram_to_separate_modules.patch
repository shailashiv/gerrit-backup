@@ -0,0 +1,62 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2021 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <preboot.h>
+#include <memory.h>
+
+static struct mem_desc mem_desc[MEM_NOENT] = {
+	[MEM_GP] = {
+		.base = MEM_GP_BASE,
+		.size = MEM_GP_SZ,
+	},
+	[MEM_LKD_PCI] = {
+		.base = MEM_LKD_PCI_BASE,
+		.size = MEM_LKD_PCI_SZ,
+	},
+	[MEM_FWUPD_PCI] = {
+		.base = MEM_FWUPD_PCI_BASE,
+		.size = MEM_FWUPD_PCI_SZ,
+	},
+	[MEM_I2C] = {
+		.base = MEM_I2C_BASE,
+		.size = MEM_I2C_SZ,
+	},
+};
+
+__weak int preboot_get_dev_spec_mem_region(enum mem_region region,
+					   struct mem_desc *desc)
+{
+	return 1; /* not dev spec */
+}
+
+int preboot_get_mem_region(enum mem_region region, struct mem_desc *desc)
+{
+	int err;
+
+	switch (region) {
+	case MEM_GP:
+	case MEM_LKD_PCI:
+	case MEM_FWUPD_PCI:
+	case MEM_I2C:
+		break;
+	default:
+		return 1;
+	}
+
+	if (!desc)
+		return 1;
+
+	/* device defined memory regions */
+	err = preboot_get_dev_spec_mem_region(region, desc);
+	if (!err)
+		return err;
+
+	desc->base = mem_desc[region].base;
+	desc->size = mem_desc[region].size;
+
+	return 0;
+}
