From 37091a34bc1a2c7c40caac579a97abf662f2c2dc Mon Sep 17 00:00:00 2001
From: Jason Smith <jsmith@habana.ai>
Date: Thu, 21 Nov 2024 22:05:04 +0000
Subject: [PATCH] Revert "[SW-195861] gaudi3: pldm: include 3 cplds in unified creation script"

This reverts commit 13e8c3430820e8ffd673bf0ff1309329e01c4ab6.

Change-Id: Ie4e77a0e6007ebb921a2256e81bf5992a5f01e40
---

diff --git a/board/habanalabs/gaudi3/create-pldm-fwup-package-unified.sh b/board/habanalabs/gaudi3/create-pldm-fwup-package-unified.sh
index 40bf90c..0afd2dd 100755
--- a/board/habanalabs/gaudi3/create-pldm-fwup-package-unified.sh
+++ b/board/habanalabs/gaudi3/create-pldm-fwup-package-unified.sh
@@ -16,18 +16,8 @@
         exit 1
 fi
 
-if [[ ! -f ${CPLD_FIT_2} ]]; then
-        echo "$0: CPLD 2 FW file (${CPLD_FIT_2}) doesn't exist - cannot create PLDM package"
-        exit 1
-fi
-
-if [[ ! -f ${CPLD_FIT_3} ]]; then
-        echo "$0: CPLD 3 FW file (${CPLD_FIT_3}) doesn't exist - cannot create PLDM package"
-        exit 1
-fi
-
-if [[ ! -f ${CPLD_FIT_4} ]]; then
-        echo "$0: CPLD 4 FW file (${CPLD_FIT_4}) doesn't exist - cannot create PLDM package"
+if [[ ! -f ${CPLD_FIT} ]]; then
+        echo "$0: CPLD FW file (${CPLD_FIT}) doesn't exist - cannot create PLDM package"
         exit 1
 fi
 
@@ -42,9 +32,7 @@
                              --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_LOADER)) "${AGENT_FW_LOADER_FIT_VERSION}" \
                              --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_EROM))   "${EROM_FW_LOADER_FIT_VERSION}"  \
                              --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_LOADER)) "${AGENT_FW_LOADER_FIT_VERSION}" \
-                             --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_CPLD_2)) "${CPLD_2_FIT_VERSION}"          \
-                             --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_CPLD_3)) "${CPLD_3_FIT_VERSION}"          \
-                             --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_CPLD_4)) "${CPLD_4_FIT_VERSION}"
+                             --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_CPLD))   "${CPLD_FIT_VERSION}"
 
 rv=$?
 if [[ ${rv} -ne 0 ]]; then
@@ -58,9 +46,7 @@
         ${AGENT_FW_LOADER_FIT} \
         ${EROM_FW_LOADER_FIT} \
         ${AGENT_FW_LOADER_FIT} \
-        ${CPLD_FIT_2} \
-        ${CPLD_FIT_3} \
-        ${CPLD_FIT_4}
+        ${CPLD_FIT}
 
 rv=$?
 if [[ ${rv} -ne 0 ]]; then
diff --git a/board/habanalabs/gaudi3/create-pldm-fwup-package.sh b/board/habanalabs/gaudi3/create-pldm-fwup-package.sh
index 90cd240..face9b9 100755
--- a/board/habanalabs/gaudi3/create-pldm-fwup-package.sh
+++ b/board/habanalabs/gaudi3/create-pldm-fwup-package.sh
@@ -47,10 +47,7 @@
 COMPONENT_ID_LOADER=${COMPONENT_ID_FW_LOADER_1}
 COMPONENT_ID_SPI=$(pldm_comp_id spi)
 COMPONENT_ID_EROM=$(pldm_comp_id erom)
-COMPONENT_ID_CPLD_1=$(pldm_comp_id cpld_1)
-COMPONENT_ID_CPLD_2=$(pldm_comp_id cpld_2)
-COMPONENT_ID_CPLD_3=$(pldm_comp_id cpld_3)
-COMPONENT_ID_CPLD_4=$(pldm_comp_id cpld_4)
+COMPONENT_ID_CPLD=$(pldm_comp_id cpld)
 COMPONENT_ID_PCIE_MARGIN=$(pldm_comp_id pcie_margin)
 COMPONENT_ID_SERDES_MARGIN=$(pldm_comp_id serdes_margin)
 COMPONENT_ID_KEY_REVOKE=$(pldm_comp_id key_revoke)
