From 902e57bd783b4fbb97c462188422154c182c0dea Mon Sep 17 00:00:00 2001
From: Prakash.Kumar <prakumar@habana.ai>
Date: Tue, 17 Aug 2021 06:49:56 +0300
Subject: [PATCH] [SW-36138] gaudi2: wd de-assertion

At PRSTn CPLD asserts GPIO62 and starts WD timer.
Before ppboot is loaded it checks GPIO2 to determine
if recovery code to be executed. In normal flow GPIO2 is
de-asserted, so PPBOOT, PREBOOT normal flow get executed.
PREBOOT is supposed to de-asserts the GPIO62 pin to avoid
expiry of WD timer. Failing to do so would result in expiry
of WD timer which asserts GPIO2 and triggers PRSTn. So in the
boot cycle, flow goes to recovery mode.

This patch adds the de-assertion of GPIO62(i.e. port "GPIO3",
pin 14). This de-assertion is done at the end of preboot when
all initializations are done successfully.

Change-Id: I922cc7e198bbc1629e94e7b29356c921f333cb28
Signed-off-by: Prakash.Kumar <prakumar@habana.ai>
---

diff --git a/app/preboot/preboot.c b/app/preboot/preboot.c
index 0c40e7b..48082ca 100644
--- a/app/preboot/preboot.c
+++ b/app/preboot/preboot.c
@@ -443,6 +443,8 @@
 
 	preboot_engines_init();
 
+	preboot_clear_wd_gpio();
+
 	module_handle_cmds(cmd_ops, ARRAY_SIZE(cmd_ops));
 }
 
diff --git a/arch/gaudi2/common/common.c b/arch/gaudi2/common/common.c
index 2a6c5d2..1e7a23c 100644
--- a/arch/gaudi2/common/common.c
+++ b/arch/gaudi2/common/common.c
@@ -679,3 +679,15 @@
 
 	preboot_puts("\n");
 }
+
+#define WD_ASSERTION_GPIO	14
+void preboot_clear_wd_gpio(void)
+{
+	u32 val, mask;
+
+	mask = BIT(WD_ASSERTION_GPIO);
+	regmap_writel(mask, mmPSOC_GPIO3_OUTENSET);
+	val  = regmap_readl(mmPSOC_GPIO3_DATAOUT);
+	val &= ~mask;
+	regmap_writel(val, mmPSOC_GPIO3_DATAOUT);
+}
diff --git a/include/preboot.h b/include/preboot.h
index f7c1919..dcaa966 100644
--- a/include/preboot.h
+++ b/include/preboot.h
@@ -208,6 +208,7 @@
 void preboot_disable_pcie_ltr(void);
 void preboot_init_pcie_phy(void);
 void preboot_engines_init(void);
+void preboot_clear_wd_gpio(void);
 
 void preboot_main(void);
 
