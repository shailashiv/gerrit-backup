+#define TIMESTAMP_CNTCR_CNTCR_EN_M		P0_TIMESTAMP_CNTCR_CNTCR_EN_M
+
+#define SPI_DMA_CTRL_ADDR_SHIFT			PA_MISC_SPI_DMA_CTRL_ADDR_SHIFT_S
+#define SPI_DMA_CTRL_DST_SRAM_SHIFT		PA_MISC_SPI_DMA_CTRL_DST_SRAM_S
+#define SPI_DMA_STATUS_ERROR_MASK		PA_MISC_SPI_DMA_STATUS_ERROR_M
+#define SPI_DMA_STATUS_ERROR_SHIFT		PA_MISC_SPI_DMA_STATUS_ERROR_S
+#define SPI_DMA_STATUS_DONE_MASK		PA_MISC_SPI_DMA_STATUS_DONE_M
+#define SPI_DMA_CTRL_FLD_SIZE_SHIFT		PA_MISC_SPI_DMA_CTRL_MEM_SIZE_S
+#define SPI_DIRECT_WR_RD_CTRL_BYTE_SWAP_MASK	\
+					P1_MISC_SPI_DIRECT_WR_RD_CTRL_BYTE_SWAP_M
+#define PRSTN_MASK_IND_MASK			IO_PSOC_CFG_BOOT_PRSTN_RST_MASK_IND_M
+#define MEM_CPY_CTRL2_USE_CONST_SHIFT		P1_MISC_MEM_CPY_CTRL2_USE_CONST_S
