From 7807644067764651b11c55e0a4816f13614d9cfd Mon Sep 17 00:00:00 2001
From: Arnon Kaufman <akaufman@habana.ai>
Date: Sun, 12 Sep 2021 09:01:43 +0300
Subject: [PATCH] [SW-54394] gaudi2,arc: check memory access range

Need to adjust Gaudi2's address range verification.

Change-Id: Ibd2c5347ccdb56341bedc7765419d6791ea0fd2e
Signed-off-by: Arnon Kaufman <akaufman@habana.ai>
---

diff --git a/arch/gaudi2/arc/common.c b/arch/gaudi2/arc/common.c
index 49e5e24..3ecb0ac 100644
--- a/arch/gaudi2/arc/common.c
+++ b/arch/gaudi2/arc/common.c
@@ -361,3 +361,30 @@
 	regmap_writel(ARC_RST_VEC_ADDR, mmPSOC_ARC0_CFG_RST_VEC_ADDR);
 	regmap_writel(ARC_RST_VALUE, mmPSOC_ARC0_CFG_ARC_RST);
 }
+
+bool preboot_is_valid_address_range(u64 addr, int len)
+{
+	if (addr >= HL_SP_SRAM_BASE &&
+	    addr + len <= HL_SP_SRAM_BASE + HL_SP_SRAM_SIZE)
+		return true;
+
+	if (preboot_sram_is_valid_address_range(addr, len))
+		return true;
+
+	if (addr >= ARC0_ICCM_FULL_BASE &&
+	    addr + len <= ARC0_ICCM_FULL_BASE + ARC0_MEM_SIZE)
+		return true;
+
+	if (addr >= ARC1_ICCM_FULL_BASE &&
+	    addr + len <= ARC1_ICCM_FULL_BASE + ARC1_MEM_SIZE)
+		return true;
+
+	if (addr >= ARM_SDRAM_BASE &&
+	    (u64)(addr + (u64)len) <= (u64)(ARM_SDRAM_BASE + ARM_SDRAM_SIZE))
+		return true;
+
+	preboot_puts_hex64("ERROR: invalid address range addr = ",
+			   addr, true);
+	return false;
+}
+
diff --git a/arch/gaudi2/arc/common.h b/arch/gaudi2/arc/common.h
index 9134b2c..4d5c578 100644
--- a/arch/gaudi2/arc/common.h
+++ b/arch/gaudi2/arc/common.h
@@ -22,6 +22,12 @@
 #define SDRAM_BASE		0x10000000
 #define SDRAM_FULL_BASE		0x1001000200000000ull
 #define ARM_ADDR_MASK		0xFFFFFFFull
+/*
+ * SDRAM size is 6MB (split to 3M + 3M)
+ * using only the first 3M of DRAM
+ * located on HBM0 offset 0x0
+ */
+#define ARM_SDRAM_SIZE		0x300000ull
 #else
 /*
  * The SRAM region in ARC address extension is mapped to 0x10000000, but the
@@ -32,8 +38,24 @@
 #define SDRAM_BASE		0x11000000
 #define SDRAM_FULL_BASE		0x1000FFFFFD000000ull
 #define ARM_ADDR_MASK		0x1FFFFFFull
+#define ARM_SDRAM_SIZE		0x3000000
 #endif
 
+//#define GENERAL_CFG_MSB_ADDR	0x1000007F00000000ull
+#define ARC0_ICCM_FULL_BASE	0x1000007FF7000000ull
+#define ARC0_ICCM_SIZE		0x20000			/* 128KB */
+#define ARC0_DCCM_FULL_BASE	0x1000007FF7020000ull
+#define ARC0_DCCM_SIZE		0x8000			/* 32KB */
+#define ARC1_ICCM_FULL_BASE	0x1000007FF7040000ull
+#define ARC1_ICCM_SIZE		0x20000			/* 128KB */
+#define ARC1_DCCM_FULL_BASE	0x1000007FF7060000ull
+#define ARC1_DCCM_SIZE		0x8000			/* 32KB */
+
+#define ARC0_MEM_SIZE (ARC0_ICCM_SIZE + ARC0_DCCM_SIZE)
+#define ARC1_MEM_SIZE (ARC1_ICCM_SIZE + ARC1_DCCM_SIZE)
+
+#define ARM_SDRAM_BASE		0x8200000000ull
+
 #define GEN_REGION_BASE		0x20000000
 #define PCIE_FW_SRAM_BASE	(GEN_REGION_BASE + 0x7FF0000)
 #define FW_SRAM_BASE		(GEN_REGION_BASE + 0x7FD0000)
