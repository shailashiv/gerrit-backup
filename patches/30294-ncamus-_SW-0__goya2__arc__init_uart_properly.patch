From 5da4dc0489178d4233663a0577b1af73ce86af2e Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Thu, 19 Mar 2020 00:54:55 +0200
Subject: [PATCH] [SW-0] goya2: arc: init uart properly

Used to be done by BTL in legacy flow

Change-Id: I3bf5a9c16285e2949e6050bdc4707ec7f8d109fc
---

diff --git a/common/uart.c b/common/uart.c
index f08af2b..8e12eb8 100644
--- a/common/uart.c
+++ b/common/uart.c
@@ -17,7 +17,9 @@
 
 void preboot_uart_init(unsigned int val)
 {
+	regmap_writel(0x0, mmPSOC_UART_0_CTRL);
 	regmap_writel(val, mmPSOC_UART_0_BAUDDIV);
+	regmap_writel(0x3, mmPSOC_UART_0_CTRL);
 }
 
 void preboot_putc_raw(const char ch)
diff --git a/goya2_arc/onix.c b/goya2_arc/onix.c
index 63a4e66..8b11127 100644
--- a/goya2_arc/onix.c
+++ b/goya2_arc/onix.c
@@ -11,6 +11,8 @@
 #include <pll.h>
 #include <uart.h>
 
+#include <psoc_global_conf_regs.h>
+
 #define SYS_CLOCK_FREQUENCY	35000000ULL
 #define UART_CLOCK_FREQUENCY	SYS_CLOCK_FREQUENCY
 #define PLDM_UART_BAUDRATE	57600
@@ -27,6 +29,8 @@
 
 void hl_uart_init(void)
 {
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_8);	/* UART0 RXD */
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_9);	/* UART0 TXD */
 	preboot_uart_init(UART_CLOCK_FREQUENCY / PLDM_UART_BAUDRATE);
 }
 
