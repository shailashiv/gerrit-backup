 #include <uart.h>
 #include <efuse.h>
 #include <string.h>
@@ -43,6 +44,7 @@
 #include <hl.h>
 #include <address_space.h>
 #include <gaudi2/gaudi2_security.h>
+#include <tpm2.h>
 
 #define PRODUCT_ID_STR_SIZE			0x8
 
@@ -287,6 +289,16 @@
 		return spi_flash_readl(FLASH_PREBOOT_PRIMARY_OFFSET);
 }
 
+__weak int tpm_pcr_extend(uint32_t image_index, uint8_t *hash)
+{
+	return -1;
+}
+
+__weak int tpm_init(void)
+{
+	return -1;
+}
+
 /* SPI DMA can transfer max of data (64KB-8) = 0xFFF8 + (additional CRC)
  * But destination is 16 byte aligned. So, setting max as (64K-16) (excluding CRC)
  */
@@ -310,6 +322,7 @@
 	u32 flash_offset;
 	u32 num_cycles;
 	int ret;
+	uint8_t hash[SHA384_SUM_LEN];
 
 	flash_offset = ppboot_flash_image_offset(image_ptr);
 	image_size = spi_flash_readl(flash_offset);
@@ -365,6 +378,17 @@
 			== SECUREBOOT_VERIFY_FAILED)
 		return ARCBOOT_BRINGUP_ERROR;
 
+	/* Hash is encrypted, and only first 48 bytes of it are used
+	 * Hash is read and not calculated because of ppboot image size
+	 * limitations
+	 */
+	if (!tpm_init()) {
+		memcpy(hash, (void *)(SDRAM_BASE + IMG_LEN_SIZE + image_size),
+		       SHA384_SUM_LEN);
+		if (tpm_pcr_extend(TPM2_PREBOOT_PCR_IDX, hash))
+			preboot_puts("PPBOOT: pcr extend failed\n");
+	}
+
 	return ARCBOOT_BRINGUP_OK;
 }
 
