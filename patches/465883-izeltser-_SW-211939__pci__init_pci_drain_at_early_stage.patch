From 34915586e0b3341fdb031926772b7949e3432637 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Wed, 11 Dec 2024 12:27:10 +0200
Subject: [PATCH] [SW-211939] pci: init pci drain at early stage

Until now PCI drain was initialized after pci init, which might be too
late. it is moved to early init stage.
In addition, in gaudi3, the pci init code is accessing pcos regs from
the PIF ARC and we see that sometimes there is a drain, probably because
PLLs are not initialized yet. To solve this the PCI LBW drain timeout is
increased for gaudi3.

Change-Id: I4c35981dbd3220fbc601818f74daa5ca379c56cd
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/app/ppboot/ppboot.c b/app/ppboot/ppboot.c
index 24f9acf..ebc57dd 100644
--- a/app/ppboot/ppboot.c
+++ b/app/ppboot/ppboot.c
@@ -244,8 +244,6 @@
 
 __weak void hl_init_pcie_phy_fw(void) {}
 
-__weak void ppboot_pcie_drain_init(void) {}
-
 __weak void hl_plat_init(void) {}
 __weak void ppboot_send_version(void) {}
 
@@ -356,7 +354,6 @@
 		hl_pcie_enable_elbi_access();
 	ppboot_time_critical_section_end();
 	/**********time critical section end************/
-	ppboot_pcie_drain_init();
 	hl_check_pcie_link_up_by_erom();
 	ppboot_version();
 	rst_src_dump();
diff --git a/arch/fs1/arc/common.c b/arch/fs1/arc/common.c
index 63f95dc..26e233a 100644
--- a/arch/fs1/arc/common.c
+++ b/arch/fs1/arc/common.c
@@ -275,6 +275,7 @@
 void hl_plat_early_init(void)
 {
 	hl_psoc_drain_init();
+	ppboot_pcie_drain_init();
 	hl_init_cpu_ids();
 	hl_lbw_early_write_resp_enable();
 	hl_dev_pll_init();
diff --git a/arch/gaudi2/arc/common.c b/arch/gaudi2/arc/common.c
index 48a7a27..d3743ff 100644
--- a/arch/gaudi2/arc/common.c
+++ b/arch/gaudi2/arc/common.c
@@ -196,6 +196,7 @@
 		cpu_boot_dev_sts_set(CPU_BOOT_DEV_STS_FW_IATU_CONF_EN);
 
 	gaudi2_axi_drain_ena();
+	ppboot_pcie_drain_init();
 
 	/* set reset source */
 	hl_reset_src_init();
diff --git a/arch/gaudi2/arm/common.c b/arch/gaudi2/arm/common.c
index 3990446..3a6c448 100644
--- a/arch/gaudi2/arm/common.c
+++ b/arch/gaudi2/arm/common.c
@@ -138,6 +138,7 @@
 		cpu_boot_dev_sts_set(CPU_BOOT_DEV_STS_FW_IATU_CONF_EN);
 
 	gaudi2_axi_drain_ena();
+	ppboot_pcie_drain_init();
 
 	/* set reset source */
 	hl_reset_src_init();
diff --git a/arch/gaudi3/arc/common.c b/arch/gaudi3/arc/common.c
index c30b5d8..7b2ac3a 100644
--- a/arch/gaudi3/arc/common.c
+++ b/arch/gaudi3/arc/common.c
@@ -335,7 +335,7 @@
 To be reverted after root cause is identified */
 
 #define HBW_DRAIN_TIMEOUT	0xF0000
-#define LBW_DRAIN_TIMEOUT	0xF000
+#define LBW_DRAIN_TIMEOUT	0xF0000
 
 void ppboot_pcie_drain_init(void)
 {
@@ -400,6 +400,7 @@
 void hl_plat_early_init(void)
 {
 	hl_psoc_drain_init();
+	ppboot_pcie_drain_init();
 	hl_lbw_early_write_resp_enable(true);
 	init_prstn();
 	hl_dev_cpu_pll_init();
