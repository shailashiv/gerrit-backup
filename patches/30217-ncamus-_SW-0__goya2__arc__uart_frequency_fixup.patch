From 422cac37174f34c6ff4e396439b4158f64b1fd4e Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Wed, 18 Mar 2020 08:10:56 +0200
Subject: [PATCH] [SW-0] goya2: arc: uart frequency fixup

No need to divide by 5

Change-Id: I2dcff50b799d77af07f0e893c5b45c7ab3054816
---

diff --git a/goya2_arc/onix.c b/goya2_arc/onix.c
index ef00ec3..63a4e66 100644
--- a/goya2_arc/onix.c
+++ b/goya2_arc/onix.c
@@ -12,7 +12,7 @@
 #include <uart.h>
 
 #define SYS_CLOCK_FREQUENCY	35000000ULL
-#define UART_CLOCK_FREQUENCY	(SYS_CLOCK_FREQUENCY / 5)
+#define UART_CLOCK_FREQUENCY	SYS_CLOCK_FREQUENCY
 #define PLDM_UART_BAUDRATE	57600
 
 u32 hl_skip_pcie_init(void)
