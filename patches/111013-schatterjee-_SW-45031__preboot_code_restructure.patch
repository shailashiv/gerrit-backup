-
-/**
- * memchr - Find a character in an area of memory.
- * @s: The memory area
- * @c: The byte to search for
- * @n: The size of the area.
- *
- * returns the address of the first occurrence of @c, or %NULL
- * if @c is not found
- */
-void *memchr(const void *s, int c, size_t n)
-{
-	const unsigned char *p = s;
-	while (n-- != 0) {
-		if ((unsigned char)c == *p++) {
-			return (void *)(p-1);
-		}
-	}
-	return NULL;
-}
-
-/**
- * memcmp - Compare two areas of memory
- * @cs: One area of memory
- * @ct: Another area of memory
- * @count: The size of the area.
- */
-int memcmp(const void * cs,const void * ct,size_t count)
-{
-	const unsigned char *su1, *su2;
-	int res = 0;
-
-	for( su1 = cs, su2 = ct; 0 < count; ++su1, ++su2, count--)
-		if ((res = *su1 - *su2) != 0)
-			break;
-	return res;
-}
-
-/**
- * memcpy - Copy one area of memory to another
- * @dest: Where to copy to
- * @src: Where to copy from
- * @count: The size of the area.
- *
- * You should not use this function to access IO space, use memcpy_toio()
- * or memcpy_fromio() instead.
- */
-void * memcpy(void *dest, const void *src, size_t count)
-{
-	unsigned long *dl = (unsigned long *)dest, *sl = (unsigned long *)src;
-	char *d8, *s8;
-
-	if (src == dest)
-		return dest;
-
-	/* while all data is aligned (common case), copy a word at a time */
-	if ( (((ulong)dest | (ulong)src) & (sizeof(*dl) - 1)) == 0) {
-		while (count >= sizeof(*dl)) {
-			*dl++ = *sl++;
-			count -= sizeof(*dl);
-		}
-	}
-	/* copy the reset one byte at a time */
-	d8 = (char *)dl;
-	s8 = (char *)sl;
-	while (count--)
-		*d8++ = *s8++;
-
-	return dest;
-}
-
-/**
- * memmove - Copy one area of memory to another
- * @dest: Where to copy to
- * @src: Where to copy from
- * @count: The size of the area.
- *
- * Unlike memcpy(), memmove() copes with overlapping areas.
- */
-void * memmove(void * dest,const void *src,size_t count)
-{
-	char *tmp, *s;
-
-	if (dest <= src) {
-		memcpy(dest, src, count);
-	} else {
-		tmp = (char *) dest + count;
-		s = (char *) src + count;
-		while (count--)
-			*--tmp = *--s;
-		}
-
-	return dest;
-}
-
-/**
- * memset - Fill a region of memory with the given value
- * @s: Pointer to the start of the area.
- * @c: The byte to fill the area with
- * @count: The size of the area.
- *
- * Do not use memset() to access IO space, use memset_io() instead.
- */
-void * memset(void * s,int c,size_t count)
-{
-	unsigned long *sl = (unsigned long *) s;
-	char *s8;
-
-	s8 = (char *)sl;
-	while (count--)
-		*s8++ = c;
-
-	return s;
-}
-
-/**
- * memset32() - Fill a memory area with a uint32_t
- * @s: Pointer to the start of the area.
- * @v: The value to fill the area with
- * @count: The number of values to store
- *
- * Differs from memset() in that it fills with a uint32_t instead
- * of a byte.  Remember that @count is the number of uint32_ts to
- * store, not the number of bytes.
- */
-void *memset32(uint32_t *s, uint32_t v, size_t count)
-{
-	uint32_t *xs = s;
-
-	while (count--)
-		*xs++ = v;
-	return s;
-}
-
-/**
- * strcmp - Compare two strings
- * @cs: One string
- * @ct: Another string
- */
-int strcmp(const char * cs,const char * ct)
-{
-	register signed char __res;
-
-	while (1) {
-		if ((__res = *cs - *ct++) != 0 || !*cs++)
-			break;
-	}
-
-	return __res;
-}
-
-/**
- * strlen - Find the length of a string
- * @s: The string to be sized
- */
-size_t strlen(const char * s)
-{
-	const char *sc;
-
-	for (sc = s; *sc != '\0'; ++sc)
-		/* nothing */;
-	return sc - s;
-}
-
-/**
- * strnlen - Find the length of a length-limited string
- * @s: The string to be sized
- * @count: The maximum number of bytes to search
- */
-size_t strnlen(const char * s, size_t count)
-{
-	const char *sc;
-
-	for (sc = s; count-- && *sc != '\0'; ++sc)
-		/* nothing */;
-	return sc - s;
-}
-
-/**
- * strrchr - Find the last occurrence of a character in a string
- * @s: The string to be searched
- * @c: The character to search for
- */
-char * strrchr(const char * s, int c)
-{
-       const char *p = s + strlen(s);
-       do {
-	   if (*p == (char)c)
-	       return (char *)p;
-       } while (--p >= s);
-       return NULL;
-}
-
-/**
- * strncpy - Copy a length-limited, %NUL-terminated string
- * @dest: Where to copy the string to
- * @src: Where to copy the string from
- * @count: The maximum number of bytes to copy
- *
- * Note that unlike userspace strncpy, this does not %NUL-pad the buffer.
- * However, the result is not %NUL-terminated if the source exceeds
- * @count bytes.
- */
-char * strncpy(char * dest,const char *src, size_t count)
-{
-	char *tmp = dest;
-
-	while (count-- && (*dest++ = *src++) != '\0')
-		/* nothing */;
-
-	return tmp;
-}
diff --git a/common/uart.c b/common/uart.c
deleted file mode 100644
index 22068ec..0000000
--- a/common/uart.c
+++ /dev/null
@@ -1,210 +0,0 @@
-/*
- * (C) Copyright 2017 HabanaLabs, Ltd.
- * Noam Camus <noamikong@gmail.com>
- *
- * SPDX-License-Identifier:     GPL-2.0+
- */
-#include <stddef.h>
-
-#include <psoc_uart_0_regs.h>
-
-#include "preboot.h"
-#include "uart.h"
-
-#define UART_SR_TXFULL			(1 << 0) /* TX Buffer Full */
-#define UART_SR_RXFULL			(1 << 1) /* RX Buffer Full */
-#define STR_UINT_SZ			8
-#define BITS_IN_SINGLE_CHAR		4
-#define RING_BUFF_SIZE			256
-
-struct ring_buf_t {
-	char buf[RING_BUFF_SIZE];
-	unsigned int head;
-	unsigned int tail;
-	bool initialized;
-};
-
-static struct ring_buf_t tx_buf;
-
-void preboot_uart_rbuf_init(void)
-{
-	tx_buf.initialized = true;
-}
-
-static void preboot_uart_rbuf_push(char ch)
-{
-	unsigned int head = tx_buf.head + 1;
-
-	head &= RING_BUFF_SIZE - 1;
-
-	/* if buffer is full, ignoring data */
-	if (head != tx_buf.tail) {
-		tx_buf.buf[tx_buf.head] = ch;
-		tx_buf.head = head;
-	}
-}
-
-void preboot_uart_rbuf_pop(void)
-{
-	unsigned int tail = tx_buf.tail;
-	char ch;
-
-	/* if buffer is empty do nothing */
-	if (tx_buf.head != tail) {
-		ch = tx_buf.buf[tail];
-		tail++;
-		tail &= RING_BUFF_SIZE - 1;
-
-		tx_buf.tail = tail;
-
-		/* transferring data directly to HW */
-		regmap_writel(ch, mmPSOC_UART_0_DATA);
-		preboot_putc_virt_uart(ch);
-	}
-}
-
-void preboot_uart_rbuf_flush(void)
-{
-	while (tx_buf.head != tx_buf.tail) {
-		while (regmap_readl(mmPSOC_UART_0_STATE) & UART_SR_TXFULL)
-			;
-		preboot_uart_rbuf_pop();
-	}
-}
-
-bool preboot_uart_rbuf_empty(void)
-{
-	return tx_buf.head == tx_buf.tail;
-}
-
-static bool dbg_enabled; /* by default debug prints are disabled */
-
-void preboot_set_dbg_prints_ena(bool enable_dbg)
-{
-	dbg_enabled = enable_dbg;
-	preboot_puts_raw("debug prints ");
-	if (dbg_enabled)
-		preboot_puts("enabled\n");
-	else
-		preboot_puts("disabled\n");
-}
-
-bool preboot_get_dbg_prints_ena(void)
-{
-	return dbg_enabled;
-}
-
-void preboot_uart_init(unsigned int val)
-{
-	regmap_writel(0x0, mmPSOC_UART_0_CTRL);
-	regmap_writel(val, mmPSOC_UART_0_BAUDDIV);
-	regmap_writel(0x3, mmPSOC_UART_0_CTRL);
-}
-
-int preboot_uart_tstc(void)
-{
-	if (!(regmap_readl(mmPSOC_UART_0_STATE) & UART_SR_RXFULL))
-		return 0;
-
-	return 1;
-}
-
-int preboot_uart_getc(void)
-{
-	if (!preboot_uart_tstc())
-		return -1;
-
-	return regmap_readl(mmPSOC_UART_0_DATA);
-}
-
-bool preboot_uart_tx_full(void)
-{
-	return !!(regmap_readl(mmPSOC_UART_0_STATE) & UART_SR_TXFULL);
-}
-
-void preboot_putc_raw(const char ch)
-{
-	if (tx_buf.initialized) {
-		preboot_uart_rbuf_push(ch);
-		return;
-	}
-
-	while (regmap_readl(mmPSOC_UART_0_STATE) & UART_SR_TXFULL)
-		;
-	regmap_writel(ch, mmPSOC_UART_0_DATA);
-	preboot_putc_virt_uart(ch);
-}
-
-void preboot_puts_raw(const char *str)
-{
-	int i;
-
-	for (i = 0; str[i] && (i < 128); i++)
-		preboot_putc_raw(str[i]);
-}
-
-void preboot_puts(const char *str)
-{
-	preboot_puts_raw(str);
-	preboot_puts_raw("\r");
-}
-
-int preboot_uint2hexstring(char *str, unsigned int num, bool pad)
-{
-	int j = 0;
-	char ch;
-	int shift_start = (STR_UINT_SZ - 1) * BITS_IN_SINGLE_CHAR;
-
-	for (int i = shift_start; i >= 0; i -= BITS_IN_SINGLE_CHAR) {
-		ch = (num >> i) & 0xf;
-		/*
-		 * if char is a number [0..9] => use '0' as an offset
-		 * if char is a letter [0xa..0xf] => use 'a' as a base,
-		 * but since 'a' is not 0, we need to subtract
-		 * its base offset - 0xa.
-		 */
-		ch += ch >= 0xa ? 'a' - 0xa : '0';
-		if (!pad && ch == '0' && i != 0)
-			continue;
-
-		if (str)
-			str[j++] = ch;
-		else
-			preboot_putc_raw(ch);
-
-		pad = true;
-	}
-
-	/* for !pad, return how many characters were actually written */
-	return j;
-}
-
-void preboot_puth_raw(unsigned int val, bool pad)
-{
-	preboot_uint2hexstring(NULL, val, pad);
-}
-
-void preboot_puth(unsigned int val, bool pad)
-{
-	preboot_puth_raw(val, pad);
-	preboot_puts("\n");
-}
-
-void preboot_puts_hex_raw(const char *log, unsigned int val, bool pad)
-{
-	preboot_puts_raw(log);
-	preboot_puts_raw("0x");
-	preboot_puth_raw(val, pad);
-}
-
-void preboot_puts_hex(const char *log, unsigned int val, bool pad)
-{
-	preboot_puts_raw(log);
-	preboot_puts_raw("0x");
-	preboot_puth(val, pad);
-}
-
-void preboot_puts_char(const char *str, unsigned char val)
-{
-	preboot_puts_hex(str, val, false);
-}
