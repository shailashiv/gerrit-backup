-#define PPBOOT_OFFSET_PRIMARY	0x00000
-#define PPBOOT_OFFSET_SECONDARY	0x20000
-#define PPBOOT_MAX_SIZE		0x20000
-#define BTL_CMD_SIZE		8 /* Followed by 4 bytes CRC */
-#define BTL_CMD_MEM		4
-#define BTL_CMD_END		2
-#define BTL_CMD_CRC		4
-#define BTL_BLK_MUL		16
-/* Op is the last nibble in command */
-#define BTL_OP_OFFSET		3
-#define BTL_OP_SHIFT		4
-/* Mem commnad number of blocks */
-#define BTL_BLK_OFFSET_LOW	4
-#define BTL_BLK_OFFSET_HIGH	5
-
-u32 btl_crc32(u32 crc, unsigned char const *p, size_t len)
-{
-	u32 data;
-
-	while (len >= sizeof(u32)) {
-		data = __builtin_bswap32(*(u32 const *)p);
-		crc = crc32(crc, (unsigned char const *)&data, sizeof(u32));
-		len -= sizeof(u32);
-		p += sizeof(u32);
-	}
-
-	return crc;
-}
-
-bool hl_ppboot_is_valid(bool is_prime)
-{
-	struct mem_desc desc;
-	u8 *buf;
-	u32 offset, memoff, memsz, crc_calc, crc_cmd;
-	u16 blk_num;
-	int i, op;
-
-	if (is_prime)
-		offset = PPBOOT_OFFSET_PRIMARY;
-	else
-		offset = PPBOOT_OFFSET_SECONDARY;
-
-	if (preboot_get_mem_region(MEM_GP, &desc))
-		return false;
-
-	buf = (u8 *)desc.base;
-	spi_copy(buf, offset, PPBOOT_MAX_SIZE, NULL);
-
-	i = 0;
-	while (i < PPBOOT_MAX_SIZE) {
-		crc_calc = btl_crc32(0, &buf[i], BTL_CMD_SIZE);
-		crc_cmd = __builtin_bswap32(*(u32 *)(&buf[i] + BTL_CMD_SIZE));
-		if (crc_calc != crc_cmd)
-			return false;
-
-		op = buf[i + BTL_OP_OFFSET] >> BTL_OP_SHIFT;
-		switch (op) {
-		case BTL_CMD_MEM:
-			blk_num = (buf[i + BTL_BLK_OFFSET_HIGH] << 8) |
-				buf[i + BTL_BLK_OFFSET_LOW];
-			memsz = blk_num * BTL_BLK_MUL;
-			memoff = BTL_CMD_SIZE + BTL_CMD_CRC;
-
-			crc_calc = btl_crc32(0, &buf[i] + memoff, memsz);
-			crc_cmd = __builtin_bswap32(*(u32 *)(&buf[i] + memoff +
-							     memsz));
-			if (crc_calc != crc_cmd)
-				return false;
-
-			i += memsz;
-		case BTL_CMD_END:
-			return true;
-		default:
-			break;
-		}
-
-		i += BTL_CMD_SIZE + BTL_CMD_CRC;
-	}
-
-	return false; /* No end */
-}
-
-void hl_pci_iatu_init(void)
-{
-	u64 sp_sram_offset;
-	struct hl_pci_inbound_region inbound_region;
-	struct hl_pci_outbound_region outbound_region;
-
-	hl_pcie_disable_access();
-
-	/* Inbound Region 0 - Bar 0 - Point to SRAM + CFG */
-	inbound_region.mode = PCI_BAR_MATCH_MODE;
-	inbound_region.bar = PCI_BAR_ID_0;
-	inbound_region.addr = SDRAM_BASE;
-	hl_pci_set_inbound_region(0, &inbound_region);
-
-	/* Inbound Region 1 - Bar 4 - Point to HBM */
-	inbound_region.mode = PCI_BAR_MATCH_MODE;
-	inbound_region.bar = PCI_BAR_ID_4;
-	inbound_region.addr = DRAM_BASE;
-	hl_pci_set_inbound_region(1, &inbound_region);
-
-	hl_pci_get_bar_phys_addr(PCI_BAR_ID_2, &inbound_region.pcie_bar_phys);
-
-	/* Inbound Region 2 - Bar 2 - SPI FLASH till start of SP SRAM */
-	inbound_region.mode = PCI_ADDRESS_MATCH_MODE;
-	inbound_region.bar = PCI_BAR_ID_2;
-	inbound_region.offset_in_bar = 0;
-	inbound_region.addr = HL_SPI_BASE;
-	sp_sram_offset = HL_SP_SRAM_BASE - HL_SPI_BASE;
-	inbound_region.size = sp_sram_offset;
-	hl_pci_set_inbound_region(2, &inbound_region);
-
-	/* Inbound Region 3 - Bar 2 - End of SP SRAM till end of config */
-	inbound_region.mode = PCI_ADDRESS_MATCH_MODE;
-	inbound_region.bar = PCI_BAR_ID_2;
-	inbound_region.offset_in_bar = sp_sram_offset + HL_SP_SRAM_SIZE;
-	inbound_region.addr = HL_SP_SRAM_BASE + HL_SP_SRAM_SIZE;
-	inbound_region.size = HOST_PHYS_BASE - HL_SP_SRAM_BASE +
-			       HL_SP_SRAM_SIZE;
-	hl_pci_set_inbound_region(3, &inbound_region);
-
-	/* Outbound Region 0 - Point to Host */
-	outbound_region.addr = HOST_PHYS_BASE;
-	outbound_region.size = HOST_PHYS_SIZE;
-	hl_pci_set_outbound_region(&outbound_region);
-
-	hl_pcie_enable_access();
-}
