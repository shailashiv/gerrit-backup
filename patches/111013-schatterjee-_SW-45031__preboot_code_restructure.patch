-void preboot_pcie_enable(void)
-{
-	u32 rst_src;
-
-	rst_src = regmap_readl(mmPSOC_GLOBAL_CONF_RST_SRC);
-	switch (rst_src) {
-	case HL_COLD_RST:
-	case HL_PRSTN_RST:
-		/* PCIe is reset, so must initialize PCIe */
-		break;
-	case HL_MANUAL_RST:
-	case HL_WD_RST:
-	case HL_SW_ALL_RST:
-		/*
-		 * Currently, keep using the same flow as done before,
-		 * i.e. PCIe should already be initialized by default.
-		 * During hard reset triggered by LKD keep PCIe intact.
-		 */
-		return;
-	default:
-		break;
-	}
-
-	preboot_init_pcie();
-}
-
-static void rst_src_dump(void)
-{
-	unsigned int rst_src = regmap_readl(mmPSOC_GLOBAL_CONF_RST_SRC);
-	char *cause;
-
-	switch (rst_src) {
-	case HL_COLD_RST:
-		cause = "cold";
-		break;
-	case HL_MANUAL_RST:
-		cause = "manual";
-		break;
-	case HL_PRSTN_RST:
-		cause = "prstn";
-		break;
-	case HL_WD_RST:
-		cause = "watch dog";
-		break;
-	case HL_SW_ALL_RST:
-		cause = "software all";
-		break;
-	default:
-		cause = "unknown";
-		break;
-	}
-	preboot_puts_raw("Last reset cause is: ");
-	preboot_puts_raw(cause);
-	preboot_puts(" reset\n");
-}
-
-static bool hl_pcie_link_up(void)
-{
-	unsigned int prstn, smlh, rdlh, rst_src;
-
-	/* check source of reset */
-	rst_src = regmap_readl(mmPSOC_GLOBAL_CONF_RST_SRC);
-	if (rst_src < HL_WD_RST)
-		return false;
-
-	prstn = regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN);
-	smlh = regmap_readl(mmPCIE_AUX_SMLH_LINK_UP);
-	rdlh = regmap_readl(mmPCIE_AUX_RDLH_LINK_UP);
-
-	if (prstn && smlh && rdlh)
-		return true;
-
-	return false;
-}
-
-__weak void ppboot_log_waiting_for_pcie(void) {}
-
-static void ppboot_pcie_init(void)
-{
-	if (hl_pcie_link_up()) {
-		hl_pcie_enable_access();
-		preboot_puts("PCIe link is already UP!\n");
-		return;
-	}
-
-	if (hl_skip_pcie_init()) {
-		preboot_puts("PCIe initialization is skipped!\n");
-		return;
-	}
-
-	/* let the log be device specific according to its restrictions */
-	ppboot_log_waiting_for_pcie();
-	preboot_pcie_wait_for_link();
-}
-
-__weak bool hl_is_jtag_enabled(void)
-{
-	return true;
-}
-
-void hl_jtag_init(void)
-{
-	u32 reg;
-	bool is_debug_en;
-
-	is_debug_en = hl_is_jtag_enabled();
-	cpu_boot_dev_sts_clrset(CPU_BOOT_DEV_STS0_DEBUG_EN, is_debug_en);
-	reg = regmap_readl(mmCPU_CA53_CFG_ARM_RST_CONTROL);
-	if (is_debug_en)
-		reg |= BIT(12);
-	else
-		reg &= ~BIT(12);
-	regmap_writel(reg, mmCPU_CA53_CFG_ARM_RST_CONTROL);
-}
-
-__weak void hl_init_pcie_phy_fw(void) {}
-
-__weak void ppboot_pcie_drain_init(void) {}
