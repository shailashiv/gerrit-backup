+static int hbm_poll_timeout(u32 cfg_addr, u32 ref_val, u64 tout_us, u32 *val)
+{
+	u64 current, start = timestamp_get_us();
+	u64 timeout = start + tout_us;
+	bool overlap = false;
+	u32 reg;
+
+	if (timeout < start)
+		overlap = true;
+
+	while (1) {
+		reg = regmap_readl(cfg_addr);
+		if (reg == ref_val)
+			return 0;
+
+		current = timestamp_get_us();
+		if (!overlap) {
+			if (current > timeout || current <= start)
+				break;
+		} else {
+			if (current > timeout && current < start)
+				break;
+		}
+	}
+
+	*val = reg;
+
+	return -1;
+}
+
+static void ieee1500_inst(int device, u32 ch,
+				enum ieee1500_instruction instruction,
+				bool write)
+{
+	/*
+	 * Write instructions - WDR registers (0x9100 - 0x9188) should be
+	 * written prior to calling this function.
+	 * Read instructions - WDR registers (0x9800 - 0x9F88) should be read
+	 * after calling this function.
+	 */
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+	u32 wir, op, status, err;
+
+	/* Configure WDR length */
+	WREG32(base + 0x9020, ieee_wdr_len_t[instruction] - 1);
+
+	/*
+	 * Configure WIR
+	 * {ch, instruction} - ch may be 0xF to indicate ALL channels
+	 */
+	wir = (instruction & 0xFF) | ((ch & 0xF) << 8);
+	WREG32(base + 0x9024, wir);
+
+	/* Send WIR and write/read WDR */
+	op = write ? 0x6 : 0x5;
+	WREG32(base + 0x9028, op);
+
+	/* Poll for MLB interrupt */
+	err = hbm_poll_timeout(base + 0x9034, op,
+			       GAUDI_HBM_CFG_TIMEOUT_US, &status);
+	if (err) {
+		preboot_puts_hex_raw("MLB interrupt poll failed, dev: ",
+				     device, false);
+		preboot_puts_hex_raw(", ch: ", ch, false);
+		preboot_puts_hex(", status: ", status, false);
+	}
+
+	/* Clear MLB interrupts */
+	WREG32(base + 0x9034, 0);
+}
+
+int get_lane_skip_info(int device, int ch, struct extest_skip_info lane_skip_info_arr[])
+{
+	struct ch_lane_repair_info *lr = &lr_info[device][ch];
+	u32 pc_code, dw_code;
+	u32 byte_code, adj_byte_code;
+	int pc_idx, dw_idx, byte_idx;
+	u32 extest_wdr_entry, bit_to_clear;
+	u32 extest_wdr_bit_pos;
+	int info_arr_idx;
+
+	/* EXTEST WDR mask value corresponds to lane_repair WDR value */
+	u32 hlr_dword_code_to_extest_map[] = {
+			0, 1, 2, 3, 4, 7, 8, 9, 10, 11
+	};
+
+	if (!lr->status)
+		return 0;
+
+	info_arr_idx = 0;
+
+	for (pc_idx = 0; pc_idx < PC_PER_CH; pc_idx++) {
+		pc_code = (pc_idx == 0) ? lr->dw01_code : lr->dw23_code;
+		for (dw_idx = 0; dw_idx < DWORDS_PER_PC; dw_idx++) {
+			dw_code = (pc_code >> (dw_idx * HLR_DWORD_CODE_SHIFT)) & 0xFFFF;
+			/* Looping over byte-paires inside a DWORD */
+			for (byte_idx = 0; byte_idx < BYTES_PER_DWORD; byte_idx += 2) {
+				byte_code = (dw_code  >> (4 * byte_idx)) & 0xF;
+				adj_byte_code = (dw_code >> (4 * (byte_idx + 1))) & 0xF;
+
+				if  (byte_code != 0xF && adj_byte_code == 0xE) {
+					extest_wdr_bit_pos = hlr_dword_code_to_extest_map[byte_code] +
+							     byte_idx * EXTEST_WDR_BYTE_OFFSET +
+							     dw_idx * EXTEST_WDR_DWORD_OFFSET;
+					extest_wdr_entry = extest_wdr_bit_pos / 32;
+					bit_to_clear = extest_wdr_bit_pos - (32 * extest_wdr_entry);
+
+					lane_skip_info_arr[info_arr_idx].bit = bit_to_clear;
+					lane_skip_info_arr[info_arr_idx].wdr_entry = extest_wdr_entry;
+					info_arr_idx++;
+				} else if (byte_code == 0xE && adj_byte_code != 0xF) {
+					extest_wdr_bit_pos = hlr_dword_code_to_extest_map[adj_byte_code] +
+							     (byte_idx + 1) * EXTEST_WDR_BYTE_OFFSET +
+							     dw_idx * EXTEST_WDR_DWORD_OFFSET;
+					extest_wdr_entry = extest_wdr_bit_pos / 32;
+					bit_to_clear = extest_wdr_bit_pos - (32 * extest_wdr_entry);
+
+					lane_skip_info_arr[info_arr_idx].bit = bit_to_clear;
+					lane_skip_info_arr[info_arr_idx].wdr_entry = extest_wdr_entry;
+					info_arr_idx++;
+				}
+			}
+		}
+	}
+	return info_arr_idx;
+}
+
+static int extest_rx(int device)
+{
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+	u32 received, expected, mask, addr, idx;
+	int pat, ch, i, j, err = 0;
+	struct extest_skip_info lane_skip_info[GAUDI_HBM_CHANNELS][MAX_REPAIRED_LANES_PER_CH];
+	int num_repaired_lanes[GAUDI_HBM_CHANNELS] = { 0, 0, 0, 0, 0, 0, 0, 0 };
+
+	/* Enable all outputs, except for HBM TX-only signals */
+	for (ch = 0 ; ch < GAUDI_HBM_CHANNELS ; ch++) {
+		num_repaired_lanes[ch] = get_lane_skip_info(device, ch, &lane_skip_info[ch][0]);
+
+		/* Enable all outputs, except for HBM TX-only signals */
+		WREG32(base + ch * 0x1000 + 0x920, 0x60000000);
+		WREG32(base + ch * 0x1000 + 0x924, 0x00000200);
+		WREG32(base + ch * 0x1000 + 0x928, 0x02006000);
+		WREG32(base + ch * 0x1000 + 0x92c, 0x00080000);
+		WREG32(base + ch * 0x1000 + 0x930, 0x20060000);
+		WREG32(base + ch * 0x1000 + 0x934, 0x00000000);
+		WREG32(base + ch * 0x1000 + 0x938, 0x00002006);
+
+		/* Skip repaired signals */
+		for (j = 0; j < num_repaired_lanes[ch]; j++)
+			RMWREG32(base + ch * 0x1000 + 0x920 + lane_skip_info[ch][j].wdr_entry * 0x4,
+				 0x1, 1 << lane_skip_info[ch][j].bit);
+	}
+
+	/* Patterns loop */
+	for (pat = 0; pat < 16; pat++) {
+		/* Configure output values */
+		if (pat <= 7) {
+			/* Configure all channels to same pattern */
+			for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+				for (i = 0; i < EXTEST_WDR_REG_NUM; i++) {
+					addr = base + ch * 0x1000 + 0x940 +
+									(i * 4);
+					idx = pat * EXTEST_WDR_REG_NUM + i;
+					WREG32(addr, extest_wdr_pattern[idx]);
+				}
+			}
+		} else {
+			/* Configure all channels to Pattern 8 */
+			for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+				for (i = 0; i < EXTEST_WDR_REG_NUM; i++) {
+					addr = base + ch * 0x1000 + 0x940 +
+									(i * 4);
+					idx = 8 * EXTEST_WDR_REG_NUM + i;
+					WREG32(addr, extest_wdr_pattern[idx]);
+				}
+			}
+			/* Reconfigure a selected channel to Pattern 9 */
+			for (i = 0; i < EXTEST_WDR_REG_NUM; i++) {
+				addr = base + (pat - 8) * 0x1000 + 0x940 +
+									(i * 4);
+				idx = 9 * EXTEST_WDR_REG_NUM + i;
+				WREG32(addr, extest_wdr_pattern[idx]);
+			}
+		}
+
+		for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+			/* Perform EXTEST_RX command */
+			ieee1500_inst(device, hbm_ch_mapping[ch],
+				      ieee1500_extest_rx, EXTEST_READ_INST);
+
+			/* Compare results */
+			for (i = 0; i < EXTEST_WDR_REG_NUM; i++) {
+				if (pat <= 7)
+					idx = pat * EXTEST_WDR_REG_NUM + i;
+				else if (ch == (pat - 8))
+					idx = 9 * EXTEST_WDR_REG_NUM + i;
+				else
+					idx = 8 * EXTEST_WDR_REG_NUM + i;
+
+				expected = extest_wdr_pattern[idx];
+
+				addr = base +
+					(GAUDI_HBM_CENTER_CHANNEL * 0x1000) +
+					0x800 + (hbm_ch_mapping[ch] * 0x100) +
+					(i * 4);
+				received = RREG32(addr);
+
+				mask = extest_wdr_rx_mask[i];
+				/* executed 16 times (per pattern) */
+				for (j = 0; j < num_repaired_lanes[ch]; j++) {
+					if (lane_skip_info[ch][j].wdr_entry == i)
+						mask &= ~(1 << lane_skip_info[ch][j].bit);
+				}
+
+				if ((received & mask) != (expected & mask)) {
+					err++;
+					preboot_puts_hex_raw("mismatch: pattern ", pat, false);
+					preboot_puts_hex_raw(", ch ", ch, false);
+					preboot_puts_hex_raw(", WDR[", i * 32 + 31, false);
+					preboot_puts_hex_raw(":", i * 32, false);
+					preboot_puts_hex_raw("], expected ", expected, true);
+					preboot_puts_hex_raw(", received ", received, true);
+					preboot_puts_hex(", mask ", mask, true);
+				}
+
+				lr_info[device][ch].extest_rx_fails[i] |=
+					(received & mask) ^ (expected & mask);
+			}
+		}
+	}
+
+	return err;
+}
+
+static int extest_tx(int device)
+{
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+	u32 received, expected, mask, addr, idx;
+	int pat, ch, i, j, err = 0;
+	struct extest_skip_info lane_skip_info[GAUDI_HBM_CHANNELS][MAX_REPAIRED_LANES_PER_CH];
+	int num_repaired_lanes[GAUDI_HBM_CHANNELS] = { 0, 0, 0, 0, 0, 0, 0, 0 };
+
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+		/* Disable all outputs */
+		for (i = 0; i < EXTEST_WDR_REG_NUM; i++)
+			WREG32(base + ch * 0x1000 + 0x920 + (i * 4),
+					0xFFFFFFFF);
+
+		num_repaired_lanes[ch] = get_lane_skip_info(device, ch, &lane_skip_info[ch][0]);
+
+		/* Skip repaired lanes */
+		for (j = 0; j < num_repaired_lanes[ch]; j++)
+			RMWREG32(base + ch * 0x1000 + 0x920 + lane_skip_info[ch][j].wdr_entry * 0x4,
+				 0x0, 1 << lane_skip_info[ch][j].bit);
+	}
+
+	/*
+	 * Patterns 0 - 7
+	 */
+
+	/* Patterns loop */
+	for (pat = 0; pat < 8; pat++) {
+		/* Configure WDR write values */
+		for (i = 0; i < EXTEST_WDR_REG_NUM; i++) {
+			addr = base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) +
+					0x100 + (i*4);
+			idx = pat * EXTEST_WDR_REG_NUM + i;
+			WREG32(addr, extest_wdr_pattern[idx]);
+		}
+
+		/* Perform EXTEST_TX command to all channels */
+		ieee1500_inst(device, 0xF, ieee1500_extest_tx,
+			      EXTEST_WRITE_INST);
+
+		/* Compare results */
+		for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+			for (i = 0; i < EXTEST_WDR_REG_NUM; i++) {
+				if (pat <= 7)
+					idx = pat * EXTEST_WDR_REG_NUM + i;
+				else if (ch == (pat - 8))
+					idx = 9 * EXTEST_WDR_REG_NUM + i;
+				else
+					idx = 8 * EXTEST_WDR_REG_NUM + i;
+
+				expected = extest_wdr_pattern[idx];
+
+				received = RREG32(base + (ch * 0x1000) + 0x960
+								+ (i * 4));
+
+				mask = extest_wdr_tx_mask[i];
+
+				for (j = 0; j < num_repaired_lanes[ch]; j++) {
+					if (lane_skip_info[ch][j].wdr_entry == i)
+						mask &= ~(1 << lane_skip_info[ch][j].bit);
+				}
+
+				if ((received & mask) != (expected & mask))
+					err++;
+
+				lr_info[device][ch].extest_tx_fails[i] |=
+					(received & mask) ^ (expected & mask);
+			}
+
+			/* Special case - pins TEMP[2:0] + CATTRIP */
+			if (ch == 0) {
+				received = RREG32(base + 0x8000 + 0x04c);
+				if (((received >> 2) & 1) !=
+						((expected  >>  20) & 1)) {
+					err++;
+					dev_fail_info[device].temp2 |= 1;
+				}
+
+				if (((received >> 1) & 1) !=
+						((expected >> 21) & 1)) {
+					err++;
+					dev_fail_info[device].temp1 |= 1;
+				}
+
+				if (((received >> 0) & 1) !=
+						((expected  >>  22) & 1)) {
+					err++;
+					dev_fail_info[device].temp0 |= 1;
+				}
+			}
+
+			if (ch == 1) {
+				received = RREG32(base + 0x8000 + 0x04c);
+				if (((received >> 3) & 1) !=
+						((expected >> 20) & 1)) {
+					err++;
+					dev_fail_info[device].cattrip |= 1;
+				}
+			}
+		}
+	}
+
+	/*
+	 * Patterns 8 - 15
+	 */
+
+	/* Patterns loop */
+	for (pat = 8; pat < 15; pat++) {
+		for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+			/* Configure WDR write values */
+			for (i = 0; i < EXTEST_WDR_REG_NUM; i++) {
+				addr = base +
+					(GAUDI_HBM_CENTER_CHANNEL * 0x1000) +
+					0x100 + (i*4);
+				if (ch == pat - 8)
+					idx = 9 * EXTEST_WDR_REG_NUM + i;
+				else
+					idx = 8 * EXTEST_WDR_REG_NUM + i;
+
+				WREG32(addr, extest_wdr_pattern[idx]);
+			}
+
+			/* Perfrom EXTEST_TX command to the selected channel */
+			ieee1500_inst(device, hbm_ch_mapping[ch],
+				      ieee1500_extest_tx, EXTEST_WRITE_INST);
+
+			/* Compare results */
+			for (i = 0; i < EXTEST_WDR_REG_NUM; i++) {
+				if (ch == pat - 8)
+					idx = 9 * EXTEST_WDR_REG_NUM + i;
+				else
+					idx = 8 * EXTEST_WDR_REG_NUM + i;
+
+				expected = extest_wdr_pattern[idx];
+
+				received = RREG32(base + (ch * 0x1000) + 0x960
+								+ (i * 4));
+
+				mask = extest_wdr_tx_mask[i];
+
+				for (j = 0; j < num_repaired_lanes[ch]; j++) {
+					if (lane_skip_info[ch][j].wdr_entry == i)
+						mask &= ~(1 << lane_skip_info[ch][j].bit);
+				}
+
+				if ((received & mask) != (expected & mask))
+					err++;
+
+				lr_info[device][ch].extest_tx_fails[i] |=
+					(received & mask) ^ (expected & mask);
+			}
+
+			/* Special case - pins TEMP[2:0] + CATTRIP */
+			if (ch == 0) {
+				received = RREG32(base + 0x8000 + 0x04c);
+				if (((received >> 2) & 1) !=
+						((expected  >>  20) & 1)) {
+					err++;
+					dev_fail_info[device].temp2 |= 1;
+				}
+
+				if (((received >> 1) & 1) !=
+						((expected >> 21) & 1)) {
+					err++;
+					dev_fail_info[device].temp1 |= 1;
+				}
+
+				if (((received >> 0) & 1) !=
+						((expected  >>  22) & 1)) {
+					err++;
+					dev_fail_info[device].temp0 |= 1;
+				}
+			}
+
+			if (ch == 1) {
+				received = RREG32(base + 0x8000 + 0x04c);
+				if (((received >> 3) & 1) !=
+						((expected >> 20) & 1)) {
+					err++;
+					dev_fail_info[device].cattrip |= 1;
+				}
+			}
+		}
+	}
+
+	return err;
+}
+
+static void change_pll(u32 val)
+{
+	int i;
+	u32 div_base;
+	u32 nic_pll_base[] = { mmNIC0_PLL_BASE & ~HL_CFG_BASE,
+			       mmNIC1_PLL_BASE & ~HL_CFG_BASE };
+
+	for (i = 0; i < ARRAY_SIZE(nic_pll_base); i++) {
+		div_base = nic_pll_base[i] + (HL_PLL_DIV2 * sizeof(u32));
+
+		regmap_writel(HL_PLL_REF_CLK, div_base + HL_PLL_DIV_SEL);
+		udelay(1);
+		regmap_writel(val, div_base + HL_PLL_DIV_FACTOR);
+		regmap_writel(1, div_base + HL_PLL_DIV_FACTOR_CMD);
+		udelay(1);
+		regmap_writel(HL_PLL_DIV_REF, div_base + HL_PLL_DIV_SEL);
+		udelay(1);
+		regmap_writel(HL_PLL_DIV_PLL, div_base + HL_PLL_DIV_SEL);
+	}
+}
+
+static inline void reduce_pll(void)
+{
+	change_pll(15);
+}
+
+static inline void restore_pll(void)
+{
+	change_pll(8);
+}
+
+static void set_dll_val(u32 base, int ch, u32 reg, u32 val)
+{
+	u32 add16, add4, add1, address;
+	int i;
+
+	add16 = val >> 4;
+	add4 = (val % 16) >> 2;
+	add1 = (val % 16) % 4;
+
+	address = base + ch * 0x1000 + reg;
+
+	RMWREG32(address, 4, 0xFF);
+
+	for (i = 0; i < add16; i++)
+		RMWREG32(address, 3, 0xFF);
+
+	for (i = 0; i < add4; i++)
+		RMWREG32(address, 2, 0xFF);
+
+	for (i = 0; i < add1; i++)
+		RMWREG32(address, 1, 0xFF);
+}
+
+static void set_acc_dll(u32 base, int ch, int dw, u32 val)
+{
+	set_dll_val(base, ch, (dw + 4) * 0x100 + 0x14, val);
+}
+
+static void set_dword_read_dll(u32 base, int ch, int dw, u32 val)
+{
+	set_dll_val(base, ch, (dw + 5) * 0x100 + 0x18, val);
+	set_dll_val(base, ch, (dw + 5) * 0x100 + 0x1C, val);
+}
+
+static void set_dword_write_dll(u32 base, int ch, int dw, u32 val)
+{
+	set_dll_val(base, ch, (dw + 5) * 0x100 + 0x28, val);
+}
+
+static u32 aword_acc_window(u32 base, int ch)
+{
+	return RREG32_MASK(base + ch * 0x1000 + 0x414, 0x1FF0000);
+}
+
+static u32 dword_acc_window(u32 base, int ch, int dw)
+{
+	return RREG32_MASK(base + ch * 0x1000 + 0x100 * (dw + 5) + 0x14,
+				0x1FF0000);
+}
+
+static void copy_acc(u32 base)
+{
+	u32 val, add16, add4, add1;
+	int i, ch;
+
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch += 2) {
+		val = aword_acc_window(base, ch);
+
+		add16 = val >> 4;
+		add4 = (val % 16) >> 2;
+		add1 = (val % 16) % 4;
+
+		RMWREG32(base + (ch + 1) * 0x1000 + 0x414, 4, 0xFF);
+
+		for (i = 0; i < add16; i++)
+			RMWREG32(base + (ch + 1) * 0x1000 + 0x414, 3, 0xFF);
+
+		for (i = 0; i < add4; i++)
+			RMWREG32(base + (ch + 1) * 0x1000 + 0x414, 2, 0xFF);
+
+		for (i = 0; i < add1; i++)
+			RMWREG32(base + (ch + 1) * 0x1000 + 0x414, 1, 0xFF);
+	}
+}
+
+static void config_mlb_state(u32 base, int ch, enum phy_state next_state)
+{
+	enum phy_state curr_state =
+				RREG32_MASK(base + ch * 0x1000 + 0x200, 0xFF00);
+	int offset = next_state - curr_state;
+	int i;
+
+	if (!offset)
+		return;
+
+	/* mdelay(20); */
+
+	for (i = 0; i < abs(offset); i++)
+		RMWREG32(base + ch * 0x1000 + 0x200,
+				(offset > 0) ? 1 : 2, 0xFF);
+
+	/* mdelay(20); */
+}
+
+static void set_mode_reg_by_mlb(u32 base, int ch, u32 num, u32 op)
+{
+	u32 count = 0, i, one = 1, parity;
+	u32 value = (num << 8) | op;
+
+	for (i = 0; i < 12; i++)
+		if (value & (one << i))
+			count++;
+
+	parity = count & 1;
+
+	WREG32(base + ch * 0x1000 + 0x210, (parity << 16) | value);
+	WREG32(base + ch * 0x1000 + 0x214, 4);
+
+	mdelay(1);
+}
+
+static void config_dram_state(struct hbm *hbm, u32 base,
+					int ch, enum dram_state state)
+{
+	config_mlb_state(base, ch, phy_state_initial);
+
+	if (state == dram_state_training) {
+		/* CA Par=en, Wr Par=en, Rd Par=en, WDBI=en, RDBI=en */
+		set_mode_reg_by_mlb(base, ch, 0, 0x73);
+		/* drive strength=15mA, WR=16 */
+		set_mode_reg_by_mlb(base, ch, 1, 0x70);
+		/* RL=22, WL=7 */
+		set_mode_reg_by_mlb(base, ch, 2, 0xA6);
+		/* BL=4, BG=enable, tRAS=33 */
+		set_mode_reg_by_mlb(base, ch, 3, 0xE1);
+		/* PL=0, DM=disable, ECC=enable */
+		set_mode_reg_by_mlb(base, ch, 4, 0x03);
+		/* Vref=50% */
+		set_mode_reg_by_mlb(base, ch, 15, 0x00);
+
+		/* Adjust MLB for PL=0 */
+		RMWREG32(base + ch * 0x1000 + 0x204, 0x0, 0x300);
+	} else if (state == dram_state_bypass) {
+		/* CA Par=en, Wr Par=en, Rd Par=en, WDBI=en, RDBI=en */
+		set_mode_reg_by_mlb(base, ch, 0, 0x70 |
+					(hbm->dbi_enable << 1) |
+					(hbm->dbi_enable << 0));
+		/* drive strength=15mA, WR=16 */
+		set_mode_reg_by_mlb(base, ch, 1, 0x70);
+		/* RL=22, WL=7 */
+		set_mode_reg_by_mlb(base, ch, 2, 0xA6);
+		/* BL=4, BG=enable, tRAS=33 */
+		set_mode_reg_by_mlb(base, ch, 3, 0xE1);
+		/* PL=2, DM=disable, ECC=enable */
+		set_mode_reg_by_mlb(base, ch, 4, 0x8 |
+					(hbm->ecc_enable << 1) |
+					(hbm->ecc_enable << 0));
+		/* Vref=50% */
+		set_mode_reg_by_mlb(base, ch, 15, 0x00);
+
+		/* Adjust MLB for PL=2 */
+		RMWREG32(base + ch * 0x1000 + 0x204, 0x2, 0x300);
+	}
+}
+
+static void set_timing_params(int device, int ch)
+{
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+
+	/* Support only 800MHz */
+
+	/* trfc_sb_fix=128, r_r2w = 18 to support PL=2 */
+	WREG32(base + (ch * 0x1000) + 0x04C, 0x80030812);
+	/* r_trfc_sb=256, r_trrefd_norm=92, trrefd_min=8 */
+	WREG32(base + (ch * 0x1000) + 0x050, 0x205C0100);
+	/* tRTP_L=5, tWTP_L=22, tRP=12 */
+	WREG32(base + (ch * 0x1000) + 0x058, 0xC1605);
+	/* r_tcksre=r_tcksrx=14, trefi=97, txp=6, trfc=280 */
+	WREG32(base + (ch * 0x1000) + 0x05C, 0xEE616118);
+	/*
+	 * r_t_rddata_en=0x15, r_t_phy_wrlat=0x6, r_t_phy_wrdata=0x1,
+	 * r_rrq_switch_lvl_low=0x0
+	 */
+	WREG32(base + (ch * 0x1000) + 0x054, 0x10615);
+}
+
+static void config_mc_state(struct hbm *hbm, int device, int ch,
+				enum mc_state state)
+{
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+
+	if (state == mc_state_bist) {
+		RMWREG32(base + ch * 0x1000 + 0x004, 1, 0x1);
+		/* Adjust the refresh rate */
+		WREG32(base + (ch * 0x1000) + 0x050, 0x20360098);
+	} else if (state == mc_state_normal) {
+		/* Allow time for issuing REFab */
+		udelay(100);
+		RMWREG32(base + ch * 0x1000 + 0x004, 0, 0x1);
+		set_timing_params(device, ch);
+	}
+}
+
+static void lane_update_phy(int device, int mc_ch)
+{
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+	struct ch_lane_repair_info *lr = &lr_info[device][mc_ch];
+
+	/* Configure MLB according to remapped lanes */
+	if (lr->dw01_code != 0xFFFFFFFF) {
+		lr->dw01_code = lr->dw01_code;
+		lr->count.pc0 = 1;
+		if (((lr->dw01_code & 0xFFFF) != 0xFFFF) &&
+		    (((lr->dw01_code >> 16) & 0xFFFF) != 0xFFFF))
+			lr->count.pc0 = 2;
+
+		lr->status = true;
+
+		WREG32(base + (mc_ch * 0x1000) + 0x2F0, lr->dw01_code);
+	}
+
+	if (lr->dw23_code != 0xFFFFFFFF) {
+		lr->dw23_code = lr->dw23_code;
+		lr->count.pc1 = 1;
+		if (((lr->dw23_code & 0xFFFF) != 0xFFFF) &&
+		    (((lr->dw23_code >> 16) & 0xFFFF) != 0xFFFF))
+			lr->count.pc1 = 2;
+
+		lr->status = true;
+
+		WREG32(base + (mc_ch * 0x1000) + 0x2F4, lr->dw23_code);
+	}
+
+	if (lr->aw_code != 0xFF) {
+		lr->aw_code = lr->aw_code;
+		lr->count.aw = 1;
+		lr->status = true;
+
+		WREG32(base + (mc_ch * 0x1000) + 0x2F8, lr->aw_code);
+	}
+}
+
+static void lane_update_hbm(int device, int mc_ch)
+{
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+	struct ch_lane_repair_info *lr = &lr_info[device][mc_ch];
+
+	/* Check if we need to update HBM */
+	if (!lr->is_repair_code_valid ||
+	    (lr->dw01_code == 0xFFFFFFFF && lr->dw23_code == 0xFFFFFFFF &&
+	     lr->aw_code == 0xFF))
+		return;
+
+	/* HBM device configuration */
+	WREG32(base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) + 0x100,
+	       lr->dw01_code);
+	WREG32(base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) + 0x104,
+	       (lr->dw23_code << 8) | (lr->aw_code & 0xff));
+	WREG32(base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) + 0x108,
+	       lr->dw23_code >> 24);
+
+	ieee1500_inst(device, hbm_ch_mapping[mc_ch], ieee1500_soft_lane_repair,
+		      EXTEST_WRITE_INST);
+}
+
+static void lr_reset_failures(struct ch_lane_repair_info *lr,
+			       bool is_reset_count)
+{
+	memset(lr->extest_rx_fails, 0, sizeof(lr->extest_rx_fails));
+	memset(lr->extest_tx_fails, 0, sizeof(lr->extest_tx_fails));
+	memset(lr->failed_dq, 0, sizeof(lr->failed_dq));
+	memset(lr->failed_dm, 0, sizeof(lr->failed_dm));
+	memset(lr->failed_dbi, 0, sizeof(lr->failed_dbi));
+	lr->failed_r = 0;
+	lr->failed_c = 0;
+
+	if (is_reset_count)
+		memset(lr->fails_in_byte, 0, sizeof(lr->fails_in_byte));
+}
+
+static void hbm_reset_failures(void)
+{
+	int device, ch;
+
+	for (device = 0; device < GAUDI_HBM_DEVICES; device++)
+		for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
+			lr_reset_failures(&lr_info[device][ch], true);
+}
+
+/*
+ * Return 0 if HBM was repaired or does not need repair.
+ */
+static int hbm_channel_lane_repair(int device, int ch)
+{
+	struct hbm *hbm = &hbm_data;
+	struct ch_lane_repair_info *lr = &lr_info[device][ch];
+	struct dev_fail_info *dev_fail = &dev_fail_info[device];
+	int fails_in_cbus = 0, fails_in_rbus = 0;
+	u8 repair_code[PC_PER_CH][8], repair_code_c, repair_code_r;
+	u32 *dw_code;
+	int pc, byte, bit;
+
+	if (dev_fail->unrep_dw)  /* Failures in unrepairable pins */
+		return 1;
+
+	/* Create repair vector */
+	for (pc = 0; pc < PC_PER_CH; pc++) {
+		dw_code = pc ? &lr->dw23_code : &lr->dw01_code;
+
+		/* Convert dw codes nibbles to repair_code array */
+		for (byte = 0; byte < BYTES_PER_PC; byte++)
+			repair_code[pc][byte] = (*dw_code >> (4 * byte)) & 0xf;
+
+		for (byte = 0; byte < BYTES_PER_PC; byte++) {
+			/* repair_code should contains the repair codes that we
+			 * introduce during ATE (hard repair)
+			 */
+			if (repair_code[pc][byte] < REPAIR_CODE_ADJ)
+				lr->fails_in_byte[pc][byte] = 1;
+			else
+				lr->fails_in_byte[pc][byte] = 0;
+
+			/* Check result of current byte */
+			for (bit = 0; bit < BITS_PER_BYTE; bit++) {
+				if (!!(lr->failed_dq[pc] &
+				       BIT(byte * 8 + bit))) {
+					lr->fails_in_byte[pc][byte]++;
+					repair_code[pc][byte] = bit + REPAIR_CODE_DQ0;
+				}
+			}
+
+			/* In case that DBI (data bit inversion) is enabled and
+			 * we got more than 8 flipped bits, than probably dbi
+			 * lane is failing
+			 */
+			if (hbm->dbi_enable &&
+			    lr->fails_in_byte[pc][byte] >= 8 &&
+			    !(lr->failed_dm[pc] & BIT(byte))) {
+				/* DBI fault - detect for AC test */
+				lr->failed_dbi[pc] |= BIT(byte);
+				lr->fails_in_byte[pc][byte] -= 8;
+			}
+
+			/* ECC */
+			if (!!(lr->failed_dm[pc] & BIT(byte))) {
+				lr->fails_in_byte[pc][byte]++;
+				repair_code[pc][byte] = REPAIR_CODE_DM;
+			}
+
+			/* Data bit inversion */
+			if (!!(lr->failed_dbi[pc] & BIT(byte))) {
+				lr->fails_in_byte[pc][byte]++;
+				repair_code[pc][byte] = REPAIR_CODE_DBI;
+			}
+
+			/* more than one lane per byte, cannot repair */
+			if (lr->fails_in_byte[pc][byte] > REDUNDENT_BYTE_PAIR_LANES)
+				return 1;
+		}
+
+		/* Check result of byte pair */
+		for (byte = 0; byte < BYTES_PER_PC; byte += 2) {
+			/* more than one lane per byte pair */
+			if (lr->fails_in_byte[pc][byte] +
+			    lr->fails_in_byte[pc][byte + 1] > REDUNDENT_BYTE_PAIR_LANES)
+				return 1;
+
+			/* mark repair in adjacent byte */
+			if (lr->fails_in_byte[pc][byte])
+				repair_code[pc][byte + 1] = REPAIR_CODE_ADJ;
+
+			if (lr->fails_in_byte[pc][byte + 1])
+				repair_code[pc][byte] = REPAIR_CODE_ADJ;
+		}
+	}
+
+	/* AWORD: Check whether repairable and create repair vector */
+	if (dev_fail->unrep_aw)  /* Failures in unrepairable pins */
+		return 1;
+
+	repair_code_c = lr->aw_code & 0xf;
+	repair_code_r = (lr->aw_code >> 4) & 0xf;
+
+	/* Check if we already fixed this bus */
+	if (repair_code_c < REPAIR_CODE_NONE)
+		fails_in_cbus = 1;
+
+	/* Check result of current C bus */
+	for (bit = 0; bit < CBUS_LANES_NUM; bit++) {
+		if (!(lr->failed_c & BIT(bit)))
+			continue;
+
+		fails_in_cbus++;
+		repair_code_c = bit;
+	}
+
+	if (fails_in_cbus > REDUNDENT_CBUS_LANES)
+		return 1;
+
+	/* Check if we already fixed this bus */
+	if (repair_code_r < REPAIR_CODE_NONE)
+		fails_in_rbus = 1;
+
+	/* Check result of current R bus */
+	for (bit = 0; bit < RBUS_LANES_NUM; bit++) {
+		if (!(lr->failed_r & BIT(bit)))
+			continue;
+
+		fails_in_rbus++;
+		repair_code_r = bit;
+	}
+
+	if (fails_in_rbus > REDUNDENT_RBUS_LANES)
+		return 1;
+
+	/* Convert back the repair code arrays */
+	for (pc = 0; pc < PC_PER_CH; pc++) {
+		dw_code = pc ? &lr->dw23_code : &lr->dw01_code;
+
+		*dw_code = 0;
+		for (byte = 0; byte < BYTES_PER_PC; byte++)
+			*dw_code |= repair_code[pc][byte] << (byte * 4);
+	}
+
+	lr->aw_code = repair_code_c | (repair_code_r << 4);
+
+	lane_update_hbm(device, ch);
+	lane_update_phy(device, ch);
+
+	/* Since soft repair is an iterative process, reset handled failures to
+	 * prevent redudant repair attempts.
+	 */
+	lr_reset_failures(lr, false);
+
+	return 0;
+}
+
+#define DM_MISMATCH_REG		0x12c
+#define DM_EXPECTED_REG		0x128
+#define DM_BIT_GROUP_SIZE	4
+#define DM_BIT_GROUP_COUNT	2
+
+const static int dm_bit[DM_BIT_GROUP_COUNT][DM_BIT_GROUP_SIZE] = {
+	{ 0, 4, 16, 20 },
+	{ 8, 12, 24, 28 }
+};
+
+static u8 calc_dm_bit(u32 flipped, int dm_idx)
+{
+	int bit, nibble;
+	u8 res = 0;
+
+	for (bit = 0; bit < DM_BIT_GROUP_SIZE; bit++)
+		for (nibble = 0; nibble < DM_BIT_GROUP_COUNT; nibble++)
+			if (!!(flipped & BIT(dm_bit[nibble][bit] + dm_idx)))
+				res |= BIT(dm_idx + nibble * BITS_PER_NIBBLE);
+
+	return res;
+}
+
+struct failed_dq_reg {
+	u32 mismatch_reg;
+	u32 expected_reg;
+	int shift_res;
+};
+
+const static struct failed_dq_reg failed_dq_reg[] = {
+	{ 0x16c, 0x14c, 0 },  /*   0 ..  31 */
+	{ 0x168, 0x148, 0 },  /*  32 ..  63 */
+	{ 0x15c, 0x13c, 0 },  /* 128 .. 159 */
+	{ 0x158, 0x138, 0 },  /* 160 .. 191 */
+	{ 0x164, 0x144, 32 }, /*  64 ..  95 */
+	{ 0x160, 0x140, 32 }, /*  96 .. 128 */
+	{ 0x154, 0x134, 32 }, /* 192 .. 223 */
+	{ 0x150, 0x130, 32 }, /* 224 .. 255 */
+};
+
+static int hbm_channel_ac_test_repair(int device, int ch)
+{
+	struct hbm *hbm = &hbm_data;
+	struct ch_lane_repair_info *lr = &lr_info[device][ch];
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+	u32 status = RREG32(base + ch * 0x1000 + 0x11C);
+	u32 mismatch, expected, flipped;
+	int pc, i;
+
+	if (hbm->lane_repair_iter[device] == MAX_LANE_REPAIR_ITERATIONS)
+		return 1;
+
+	hbm->lane_repair_iter[device]++;
+
+	for (pc = 0; pc < PC_PER_CH; pc++) {
+		if (!!(status & BIT(24 + pc))) /* No failures */
+			continue;
+
+		/* Select pseudo channel */
+		RMWREG32(base + ch * 0x1000 + 0x100, pc, BIT(5));
+
+		/* Gather mismatched bits */
+		for (i = 0; i < ARRAY_SIZE(failed_dq_reg); i++) {
+			mismatch = RREG32(base + ch * 0x1000 +
+					  failed_dq_reg[i].mismatch_reg);
+			expected = RREG32(base + ch * 0x1000 +
+					  failed_dq_reg[i].expected_reg);
+			flipped = mismatch ^ expected;
+			lr->failed_dq[pc] |= ((u64)flipped) <<
+				failed_dq_reg[i].shift_res;
+		}
+
+		mismatch = RREG32(base + ch * 0x1000 + DM_MISMATCH_REG);
+		expected = RREG32(base + ch * 0x1000 + DM_EXPECTED_REG);
+		flipped = mismatch ^ expected;
+		for (i = 0; i < BITS_PER_NIBBLE; i++)
+			lr->failed_dm[pc] |= calc_dm_bit(flipped, i);
+	}
+
+	return hbm_channel_lane_repair(device, ch);
+}
+
+static int mcbist_err_restart_next_row(int sid, int dev, int ch, u32 status,
+				       struct mcbist_err_row_addr *row_err)
+{
+	u32 base = GAUDI_HBM_CFG_BASE + dev * GAUDI_HBM_CFG_OFFSET;
+	struct mcbist_err_start_addr naddr;
+	int started = 0;
+	int pc;
+
+	for (pc = 0; pc < PC_PER_CH; pc++) {
+		if (!!(status & BIT(0 + pc)))
+			continue;
+
+		if (!!(status & BIT(24 + pc)))
+			continue; /* Test pass on PC */
+
+		/* Select pseudo channel */
+		RMWREG32(base + ch * 0x1000 + 0x100, pc, BIT(5));
+
+		/* Read failed addess */
+		row_err[pc].addr.val = RREG32(base + ch * 0x1000 + 0x124);
+		row_err[pc].is_error = true;
+
+		/* Restart from the beginning of the next row */
+		naddr = row_err[pc].addr;
+		naddr.col = 0;
+		if (!++naddr.row)			/* Final row */
+			if (!++naddr.bank)		/* Final bank */
+				if (!++naddr.bg)	/* Final bank group */
+					continue;	/* Last row */
+
+		/* Set start address to next row */
+		WREG32(base + ch * 0x1000 + 0x104,
+		       naddr.val | sid << 28 | sid << 29);
+
+		/* Start BIST on specific PC */
+		WREG32(base + ch * 0x1000 + 0x11C, BIT(pc));
+		started++;
+	}
+
+	return !started;
+}
+
+static int hbm_dma_ch_to_map_ch(int dev, int dma_ch)
+{
+	int ret = 0;
+	/* mapping from PC in bus to mapped phy channel */
+	int dma_ch_to_map_ch[GAUDI_HBM_CHANNELS] = {
+		4, 5, 6, 7, 0, 1, 2, 3,
+	};
+
+	if ((dma_ch >= 0 && dma_ch < GAUDI_HBM_CHANNELS) &&
+	    (dev >= 0 && dev < GAUDI_HBM_DEVICES)) {
+		if (dev == 1 || dev == 2)
+			ret = dma_ch_to_map_ch[dma_ch];
+		else
+			ret = dma_ch;
+	} else {
+		preboot_puts("hbm_pc: Illegal input");
+		return -1;
+	}
+
+	return ret;
+}
+
+#define HBM_SID_BITMASK			0x1
+#define HBM_ROW_REP_WAIT_TIME		1000
+#define HBM_ROW_SOFT_REP_DQ_BIT		18
+#define HBM_ROW_SOFT_REP_SID_BIT	19
+#define HBM_ROW_SOFT_REP_EN_BIT		20
+
+void gaudi_hbm_row_repair(int dev, int dma_pc, int sid, u32 bank, u32 page)
+{
+	u32 write_wdr_addr, base, hbm_ch, row;
+	int ch;
+
+	if (dma_pc < 0 || dma_pc >= (GAUDI_HBM_CHANNELS * PC_PER_CH)) {
+		preboot_puts("ERROR : hbm_row_repair: Illegal pc value\n");
+		return;
+	}
+
+	if (dev < 0 || dev >= GAUDI_HBM_DEVICES) {
+		preboot_puts("ERROR : hbm_row_repair: Illegal HBM device\n");
+		return;
+	}
+
+	row = bank << 14 | page;
+
+	if (dma_pc % 2)
+		row = row | BIT(HBM_ROW_SOFT_REP_DQ_BIT);
+	else
+		row = row & ~BIT(HBM_ROW_SOFT_REP_DQ_BIT);
+
+	if (sid)
+		row = row | BIT(HBM_ROW_SOFT_REP_SID_BIT);
+	else
+		row = row & ~BIT(HBM_ROW_SOFT_REP_SID_BIT);
+
+	row = row | BIT(HBM_ROW_SOFT_REP_EN_BIT);
+	base = GAUDI_HBM_CFG_BASE + dev * GAUDI_HBM_CFG_OFFSET;
+	write_wdr_addr = base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) + 0x100;
+	ch = hbm_dma_ch_to_map_ch(dev, (dma_pc / 2));
+	hbm_ch = hbm_ch_mapping[ch];
+
+	/* enter self refresh */
+	RMWREG32(base + 0x4, 1, 1 << 16);
+	WREG32(write_wdr_addr, row);
+	ieee1500_inst(dev, hbm_ch, ieee1500_soft_repair, EXTEST_WRITE_INST);
+
+	/*
+	 * WRCK is ~44ns. So the minimal delay is 44*300 = 13.5usec.
+	 * See MCBIST samsung doc page 21. increase to 1msec for safety.
+	 */
+	udelay(HBM_ROW_REP_WAIT_TIME);
+
+	/* Exit self refresh */
+	RMWREG32(base + 0x4, 1, 1 << 17);
+
+	/* WRSTN assert */
+	RMWREG32(base + GAUDI_HBM_CENTER_CHANNEL * 0x1000 + 0x14, 0x0, 0x1);
+}
+
+static int hbm_pc_row_repair(int sid, int device, int ch, int pc,
+			     struct mcbist_err_start_addr addr)
+{
+	int dma_ch;
+	struct hbm *hbm = &hbm_data;
+
+	preboot_puts("perform row repair");
+
+	if (hbm->row_replacement_iter[device] == MAX_ROW_REPLACEMENT_ITERATIONS) {
+		preboot_puts("Max row replacement iteration reached\n");
+		return 1;
+	}
+
+	hbm->row_replacement_iter[device]++;
+
+	/* same function is used also for conversion from mapped-ch(phy) to dma-ch */
+	dma_ch = hbm_dma_ch_to_map_ch(device, ch);
+
+	gaudi_hbm_row_repair(device, (dma_ch * 2) + 1, sid,
+			     (addr.bg << 2) | addr.bank, addr.row);
+
+	return 0;
+}
+
+static int hbm_channel_row_repair(int sid, int device, int ch,
+				  struct mcbist_err_row_addr row_err[])
+{
+	int err;
+	int pc;
+
+	for (pc = 0; pc < PC_PER_CH; pc++) {
+		if (!row_err[pc].is_error)
+			continue;
+
+		err = hbm_pc_row_repair(sid, device, ch, pc, row_err[pc].addr);
+		if (err)
+			return err;
+	}
+
+	return 0;
+}
+
+#define MCBIST_CH_MAX_RETRIES	2
+
+/*
+ * Return 0 if successful, -1 for failure, and 1 for re-run AC test.
+ */
+static int mcbist_poll(int sid, int dev, bool is_repair)
+{
+	struct mcbist_err_row_addr row_err[PC_PER_CH];
+	int err, ch, rc = 0, retry;
+
+	u32 base, status;
+
+	base = GAUDI_HBM_CFG_BASE + dev * GAUDI_HBM_CFG_OFFSET;
+
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+		memset(row_err, 0, sizeof(row_err));
+
+		for (retry = 0; retry < MCBIST_CH_MAX_RETRIES; retry++) {
+			if (retry > 0) {
+				err = mcbist_err_restart_next_row(sid, dev, ch,
+								  status,
+								  row_err);
+				/* Failed to restart MCBIST, this may happen in
+				 * the rare case where the failed row is also
+				 * the last row. We should attempt row
+				 * replacement.
+				 */
+				if (err) {
+					err = 0;
+					break;
+				}
+			}
+
+			err = hbm_poll_timeout(base + ch * 0x1000 + 0x11C, 0x03000000,
+				       GAUDI_HBM_ECC_CFG_TIMEOUT_US, &status);
+			if (!err)
+				break;
+
+			if (!is_repair) {
+				rc = -1;
+				break;
+			}
+		}
+
+		if ((!retry && !err) || !is_repair)
+			continue;
+
+		rc = 1; /* Run AC test again */
+
+		/* In case that MCBIST failed after retry suggest a lane issue,
+		 * while single failure may suggest row issue.
+		 */
+		if (err)
+			err = hbm_channel_ac_test_repair(dev, ch);
+		else
+			err = hbm_channel_row_repair(sid, dev, ch, row_err);
+
+		if (err) {
+			is_repair = false; /* Don't attempt to repair others */
+			rc = -1;
+		}
+	}
+
+	return rc;
+}
+
+static int mcbist_write_read_full(struct hbm *hbm, int unused, bool is_repair)
+{
+	int device, ch, sid, err, acc_err = 0;
+	u32 base, pseudo_rand = 0x1, interleave = 0x0;
+	enum mc_bist_mode bist_mode = mc_bist_mode_once;
+
+	/* Clean transition from Functional mode to MCBIST mode */
+	for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
+		base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+		for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+			config_mlb_state(base, ch, phy_state_initial);
+			config_mc_state(hbm, device, ch, mc_state_bist);
+			config_mlb_state(base, ch, phy_state_bypass);
+		}
+	}
+
+	for (sid = 0; sid < 2; sid++) {
+		/* Configure MCBIST for all channels */
+		for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
+			base = GAUDI_HBM_CFG_BASE +
+					device * GAUDI_HBM_CFG_OFFSET;
+
+			for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+				WREG32(base + ch * 0x1000 + 0x100, pseudo_rand |
+						(interleave << 1) |
+						(bist_mode << 2) |
+						(hbm->ecc_enable  << 3));
+				WREG32(base + ch * 0x1000 + 0x104,
+						(0x0 | sid << 28 | sid << 29));
+				WREG32(base + ch * 0x1000 + 0x108, 0x800000);
+				WREG32(base + ch * 0x1000 + 0x10c, 0x12345678);
+				WREG32(base + ch * 0x1000 + 0x110, 0x9ABCDEF0);
+				WREG32(base + ch * 0x1000 + 0x114, 0x5A5A5A5A);
+				WREG32(base + ch * 0x1000 + 0x118, 0xA5A5A5A5);
+			}
+		}
+
+		/* Start MCBIST */
+		for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
+			base = GAUDI_HBM_CFG_BASE +
+					device * GAUDI_HBM_CFG_OFFSET;
+
+			for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
+				WREG32(base + ch * 0x1000 + 0x11C, 0x3);
+		}
+
+		/* Poll for MCBIST completion */
+		for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
+			err = mcbist_poll(sid, device, is_repair);
+			if (err && acc_err >= 0)
+				acc_err = err;
+		}
+
+		if (acc_err)
+			break;
+	}
+
+	/* Clean transition from MCBIST mode to Functional mode */
+	for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
+		base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+		for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+			config_mlb_state(base, ch, phy_state_initial);
+			config_mc_state(hbm, device, ch, mc_state_normal);
+			config_mlb_state(base, ch, phy_state_bypass);
+		}
+	}
+
+	return acc_err;
+}
+
+static int do_loopback(struct hbm *hbm, u32 base, int ch,
+			enum loopback_state state)
+{
+	int i, j = ch * 16/*, cnt = 0*/;
+	u32 val;
+
+	if (state == loopback_state_initial) {
+		/* Internal Loopback mode */
+		RMWREG32(base + ch * 0x1000 + 0x370, 3, 0xFF);
+		for (i = 0; i < 16; i++)
+			WREG32(base + ch * 0x1000 + 0x380 + i * 4,
+					hbm_golden_registers[i + j]);
+		return 0;
+	}
+
+	if (state != loopback_state_check)
+		return -1;
+
+	WREG32(base + ch * 0x1000 + 0x294, 1);
+	WREG32(base + ch * 0x1000 + 0x294, 0);
+
+	RMWREG32(base + ch * 0x1000 + 0x378, 0xF, 0xFF);
+	RMWREG32(base + ch * 0x1000 + 0x374, 0xF, 0xFF);
+
+	val = RREG32(base + ch * 0x1000 + 0x37C);
+	if (val)
+		return -1;
+
+	return 0;
+}
+
+static int internal_loopback_test(struct hbm *hbm, int device)
+{
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+	int ch, dw;
+
+	/* Add delay from previous SRX */
+	udelay(1);
+
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+		/* SRE */
+		WREG32(base + ch * 0x1000 + 0x214, 2);
+		/* ILB ctrl_rddv_sel */
+		WREG32(base + ch * 0x1000 + 0x298, 5);
+		/* Reset read FIFO */
+		WREG32(base + ch * 0x1000 + 0x294, 1);
+		WREG32(base + ch * 0x1000 + 0x294, 0);
+
+		do_loopback(hbm, base, ch, loopback_state_initial);
+
+		for (dw = 0; dw < 4; dw++)
+			set_dword_read_dll(base, ch, dw, 0);
+
+		for (dw = 0; dw < 4; dw++)
+			set_dword_write_dll(base, ch, dw, 0x50);
+
+		if (do_loopback(hbm, base, ch, loopback_state_check))
+			return 1;
+
+		WREG32(base + ch * 0x1000 + 0x378, 0);
+		WREG32(base + ch * 0x1000 + 0x370, 0);
+		/* functional ctrl_rddv_sel */
+		WREG32(base + ch * 0x1000 + 0x298, 4);
+		/* SRX */
+		WREG32(base + ch * 0x1000 + 0x214, 1);
+	}
+
+	return 0;
+}
+
+static void acc_training(struct hbm *hbm, int device)
+{
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+	u32 dll_inc, status;
+	int ch, dw, err;
+
+	if (hbm->inc == 16)
+		dll_inc = 3;
+	else if (hbm->inc == 4)
+		dll_inc = 2;
+	else
+		dll_inc = 1;
+
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+		for (dw = 0; dw < 5; dw++)
+			set_acc_dll(base, ch, dw, hbm->acc_initial);
+
+		WREG32(base + ch * 0x1000 + 0x444,
+				(hbm->training_delay << 8) | dll_inc);
+	}
+
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch += 2) {
+		WREG32(base + ch * 0x1000 + 0x440, 0x1F);
+		WREG32(base + (ch + 1) * 0x1000 + 0x440, 0xF);
+	}
+
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+		err = hbm_poll_timeout(base + ch * 0x1000 + 0x440, 0,
+				       GAUDI_HBM_CFG_TIMEOUT_US, &status);
+		if (err) {
+			preboot_puts("ACC done polling failed\n");
+			return;
+		}
+	}
+
+	copy_acc(base);
+
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+		if (!aword_acc_window(base, ch))
+			preboot_puts("aword acc_window can't be 0\n");
+
+		for (dw = 0; dw < 4; dw++)
+			if (!dword_acc_window(base, ch, dw))
+				preboot_puts("dword acc_window can't be 0\n");
+	}
+}
+
+static void check_training_result(struct hbm *hbm, int dev)
+{
+	int ch, dw, min_window_size = 50; /* percentage of UI */
+
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+		for (dw = 0; dw < 5; dw++)
+			if (acc[ch][dw] <= hbm->acc_initial)
+				preboot_puts("HBM err: ACC UI size not obtained\n");
+
+		if (aword[ch][1] == 0 || aword[ch][2] == 0 ||
+			aword[ch][3] < ((acc[ch][0] * min_window_size) / 100))
+			preboot_puts("HBM err: valid AWORD window not found\n");
+
+		for (dw = 0; dw < 4; dw++) {
+			if (dword_wr[ch][dw][2] == 0 ||
+			    dword_wr[ch][dw][3] < ((acc[ch][dw + 1] * min_window_size) / 100))
+				preboot_puts("HBM err: valid DWORD Write window not found\n");
+
+			if (dword_rd[ch][dw][2] == 0 ||
+			    dword_rd[ch][dw][3] < ((acc[ch][dw + 1] * min_window_size) / 100))
+				preboot_puts("HBM err: valid DWORD Read window not found\n");
+		}
+	}
+}
+
+static void phy_init(int device)
+{
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+	u32 ctrl_rddv_sel = 4;
+	u32 rdatvld_dly;
+	u32 dev_id = preboot_device_id_get();
+	int ch;
+
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+		switch (dev_id) {
+		case PCI_IDS_GAUDI_HL2000M:
+		case PCI_IDS_GAUDI_HL2000M_SEC:
+			if (ch == 0 || ch == 4) {
+				/* Release PHY RSTN (set bit 1) */
+				RMWREG32(base + ch * 0x1000 + 0x284, 1, 0x2);
+				mdelay(1);
+
+				/* non-deskew PLL settings 2Gbps */
+				WREG32(base + ch * 0x1000 + 0x2B8, 0x19180F3F);
+				WREG32(base + ch * 0x1000 + 0x2BC, 0x0000001B);
+
+				/* Release PLL power-down (clear bit 0) */
+				RMWREG32(base + ch * 0x1000 + 0x284, 0, 0x1);
+				mdelay(1);
+
+				/* Release PLL clock divider rstn */
+				WREG32(base + ch * 0x1000 + 0x288, 0x0000001);
+				mdelay(1);
+
+				/* Release PLL stable_n (clear bit 7) */
+				RMWREG32(base + ch * 0x1000 + 0x284, 0, 0x80);
+				mdelay(1);
+			}
+
+			/* Release MLB & PHASE FIFO RSTN (set bit 7) */
+			RMWREG32(base + ch * 0x1000 + 0x174, 1, 0x80);
+			mdelay(1);
+			/* PHASE FIFO start (set bit 15) */
+			RMWREG32(base + ch * 0x1000 + 0x174, 1, 0x8000);
+
+			if (ch == 0 || ch == 4) {
+				/* Release DLL power-down */
+				WREG32(base + ch * 0x1000 + 0x28C, 0x0000000);
+				mdelay(1);
+
+				/* Drive strength */
+				WREG32(base + ch * 0x1000 + 0x2A0, 0x681F0);
+				WREG32(base + ch * 0x1000 + 0x2A4, 0x6A1F0);
+			}
+			break;
+		default:
+			if (ch == 0 || ch == 4) {
+				/* PLL settings */
+				WREG32(base + ch * 0x1000 + 0x2B8, 0x0CD80303);
+				WREG32(base + ch * 0x1000 + 0x2BC, 0x0000001E);
+
+				/* PLL and DLL power up */
+				RMWREG32(base + ch * 0x1000 + 0x288, 0x1, 0x1);
+				mdelay(1);
+				RMWREG32(base + ch * 0x1000 + 0x284, 0x0, 0x1);
+				mdelay(1);
+				RMWREG32(base + ch * 0x1000 + 0x28C, 0x0, 0x1);
+				mdelay(1);
+
+				/* Drive strength */
+				WREG32(base + ch * 0x1000 + 0x2A0, 0x681F0);
+				WREG32(base + ch * 0x1000 + 0x2A4, 0x6A1F0);
+			}
+		}
+
+		/* Reset read FIFO */
+		RMWREG32(base + ch * 0x1000 + 0x294, 0x1, 0x1);
+		RMWREG32(base + ch * 0x1000 + 0x294, 0x0, 0x1);
+
+		/* DFI setting - PHY */
+		WREG32(base + ch * 0x1000 + 0x208, 0x140106);
+
+		/* DFI setting - MC:
+		 * r_t_rddata_en=0x15, r_t_phy_wrlat=0x6, r_t_phy_wrdata=0x1,
+		 * r_rrq_switch_lvl_low=0x0. TODO: remove later
+		 */
+		WREG32(base + (ch * 0x1000) + 0x054, 0x10615);
+
+		/* trfc_sb_fix=152, r_r2w = 18 to support PL=2
+		 * TODO: remove later
+		 */
+		WREG32(base + (ch * 0x1000) + 0x04C, 0xA0030812);
+
+		/* ctrl_rddv_sel */
+		WREG32(base + ch * 0x1000 + 0x298, ctrl_rddv_sel);
+
+		/* Enable HBM CK, set PL=0, set rdatvld_dly */
+		if ((dev_id != PCI_IDS_GAUDI_HL2000M) && (dev_id != PCI_IDS_GAUDI_HL2000M_SEC))
+			rdatvld_dly = ctrl_rddv_sel + 8;
+		else
+			rdatvld_dly = ctrl_rddv_sel + 10;
+
+		if (ch == 0 || ch == 1 || ch == 4 || ch == 5)
+			WREG32(base + ch * 0x1000 + 0x204,
+					0x1 | (rdatvld_dly << 16));
+		else if (ch == 2 || ch == 3 || ch == 6 || ch == 7)
+			WREG32(base + ch * 0x1000 + 0x204,
+					0x1 | ((rdatvld_dly + 1) << 16));
+
+		/* Enable ECC. TODO: remove later */
+		WREG32(base + (ch * 0x1000) + 0x000, 0x413000);
+	}
+}
+
+static void dram_rstn(int device, enum cke_state cke)
+{
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+	int ch;
+
+	/* SRE (CKE low) */
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
+		WREG32(base + ch * 0x1000 + 0x214, 0x2);
+
+	/* WRCK disable */
+	WREG32(base + GAUDI_HBM_CENTER_CHANNEL * 0x1000 + 0x18, 0x0);
+
+	/* WRSTn low */
+	WREG32(base + GAUDI_HBM_CENTER_CHANNEL * 0x1000 + 0x14, 0x0);
+
+	/* hbm_RESETn low */
+	WREG32(base + GAUDI_HBM_CENTER_CHANNEL * 0x1000 + 0x10, 0x0);
+
+	/* tINIT1=200us for initial power-up or tPW_RESET=1us with stable
+	 * power
+	 */
+	mdelay(1);
+
+	/* hbm_RESETn high */
+	WREG32(base + GAUDI_HBM_CENTER_CHANNEL * 0x1000 + 0x10, 0x1);
+
+	/* tINIT3: 500us from RESETn deassertion to WRSTn/CKE high */
+	mdelay(1);
+
+	/* WRCK divider */
+	WREG32(base + GAUDI_HBM_CENTER_CHANNEL * 0x1000 + 0x00, 0x1);
+
+	/* WRSTn high */
+	WREG32(base + GAUDI_HBM_CENTER_CHANNEL * 0x1000 + 0x14, 0x1);
+
+	/* WRCK enable */
+	WREG32(base + GAUDI_HBM_CENTER_CHANNEL * 0x1000 + 0x18, 0x1);
+
+	/* IEEE1500 IO strength
+	 * RMWREG32(base + GAUDI_HBM_CENTER_CHANNEL * 0x1000 + 0x40, 0xF, 0xF);
+	 */
+
+	/* tINIT4 / tWINIT1 */
+	udelay(1);
+
+	if (cke == cke_state_high) {
+		/* SRX (CKE high) */
+		for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
+			WREG32(base + ch * 0x1000 + 0x214, 0x1);
+
+		/* tINIT5 */
+		udelay(1);
+	}
+
+	/* Lane repair info was lost during reset - restore it */
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
+		lane_update_hbm(device, ch);
+}
+
+static void init_mc(struct hbm *hbm, int device)
+{
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+	int ch;
+
+	/* Cleanup: Reset HBM + MRS setup */
+	dram_rstn(device, cke_state_high);
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
+		config_dram_state(hbm, base, ch, dram_state_bypass);
+
+	/* Set dfi_init_complete */
+	WREG32(base + 0x9004, 1);
+
+	/* Enable DBI (MCCTL) */
+	if (hbm->dbi_enable) {
+		WREG32(base + 0x8004, 0xFFFFFFFF);
+		WREG32(base + 0x8008, 0xFFFFFFFF);
+		WREG32(base + 0x800C, 0xFFFFFFFF);
+		WREG32(base + 0x8010, 0xFFFFFFFF);
+		WREG32(base + 0x8014, 0xFFFFFFFF);
+		WREG32(base + 0x8018, 0xFFFFFFFF);
+		WREG32(base + 0x801C, 0xFFFFFFFF);
+		WREG32(base + 0x8020, 0xFFFFFFFF);
+	}
+
+	/* Enable CATTRIP interrupt */
+	WREG32(base + 0x8000 + 0x044, 0x8);
+
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+		/* Reset PHY read FIFO */
+		WREG32(base + (ch * 0x1000) + 0x294, 1);
+		WREG32(base + (ch * 0x1000) + 0x294, 0);
+
+		/* Pass control to MC */
+		config_mlb_state(base, ch, phy_state_bypass);
+		config_mc_state(hbm, device, ch, mc_state_normal);
+
+		/* Basic configuration */
+		WREG32(base + (ch * 0x1000) + 0x000,
+				0x21012010 | (hbm->ecc_enable << 22));
+
+		/* Enable interrupts. Clear them from leftovers from init. */
+		RMWREG32(base + (ch * 0x1000) + 0x060, 0x8, 0xF);
+		RMWREG32(base + (ch * 0x1000) + 0x070, 0x8, 0xF);
+		WREG32(base + (ch * 0x1000) + 0x06C, 0x1F1F);
+		WREG32(base + (ch * 0x1000) + 0x07C, 0x1F1F);
+		WREG32(base + (ch * 0x1000) + 0x068, 0x817);
+		WREG32(base + (ch * 0x1000) + 0x078, 0x817);
+		RMWREG32(base + (ch * 0x1000) + 0x060, 0x0, 0xF);
+		RMWREG32(base + (ch * 0x1000) + 0x070, 0x0, 0xF);
+	}
+}
+
+static void enable_traffic(int device)
+{
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+	int ch;
+
+	/* Enable traffic */
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+		RMWREG32(base + (ch * 0x1000) + 0x000, 0x1, 0x8);
+		WREG32(base + (ch * 0x1000) + 0x004, 0xC0);
+	}
+}
+
+static void read_hardware_training_result(int device)
+{
+	int ch;
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+		acc[ch][0] = RREG32_MASK(base + (ch * 0x1000) + 0x414,
+					0x1FF0000);
+		acc[ch][1] = RREG32_MASK(base + (ch * 0x1000) + 0x514,
+					0x1FF0000);
+		acc[ch][2] = RREG32_MASK(base + (ch * 0x1000) + 0x614,
+					0x1FF0000);
+		acc[ch][3] = RREG32_MASK(base + (ch * 0x1000) + 0x714,
+					0x1FF0000);
+		acc[ch][4] = RREG32_MASK(base + (ch * 0x1000) + 0x814,
+					0x1FF0000);
+
+		aword[ch][0] = RREG32_MASK(base + (ch * 0x1000) + 0x428,
+					0x1FF0000);
+		aword[ch][1] = RREG32_MASK(base + (ch * 0x1000) + 0x458, 0x1FF);
+		aword[ch][2] = RREG32_MASK(base + (ch * 0x1000) + 0x458,
+					0x1FF0000);
+		aword[ch][3] = aword[ch][2] - aword[ch][1] + 1;
+
+		dword_wr[ch][0][0] = RREG32_MASK(base + (ch * 0x1000) + 0x528,
+						0x1FF0000);
+		dword_wr[ch][0][1] = RREG32_MASK(base + (ch * 0x1000) + 0x470,
+						0x1FF);
+		dword_wr[ch][0][2] = RREG32_MASK(base + (ch * 0x1000) + 0x470,
+						0x1FF0000);
+		dword_wr[ch][0][3] = dword_wr[ch][0][2] -
+					dword_wr[ch][0][1] + 1;
+		dword_wr[ch][1][0] = RREG32_MASK(base + (ch * 0x1000) + 0x628,
+						0x1FF0000);
+		dword_wr[ch][1][1] = RREG32_MASK(base + (ch * 0x1000) + 0x474,
+						0x1FF);
+		dword_wr[ch][1][2] = RREG32_MASK(base + (ch * 0x1000) + 0x474,
+						0x1FF0000);
+		dword_wr[ch][1][3] = dword_wr[ch][1][2] -
+					dword_wr[ch][1][1] + 1;
+		dword_wr[ch][2][0] = RREG32_MASK(base + (ch * 0x1000) + 0x728,
+						0x1FF0000);
+		dword_wr[ch][2][1] = RREG32_MASK(base + (ch * 0x1000) + 0x478,
+						0x1FF);
+		dword_wr[ch][2][2] = RREG32_MASK(base + (ch * 0x1000) + 0x478,
+						0x1FF0000);
+		dword_wr[ch][2][3] = dword_wr[ch][2][2] -
+					dword_wr[ch][2][1] + 1;
+		dword_wr[ch][3][0] = RREG32_MASK(base + (ch * 0x1000) + 0x828,
+						0x1FF0000);
+		dword_wr[ch][3][1] = RREG32_MASK(base + (ch * 0x1000) + 0x47C,
+						0x1FF);
+		dword_wr[ch][3][2] = RREG32_MASK(base + (ch * 0x1000) + 0x47C,
+						0x1FF0000);
+		dword_wr[ch][3][3] = dword_wr[ch][3][2] -
+					dword_wr[ch][3][1] + 1;
+
+		dword_rd[ch][0][0] = RREG32_MASK(base + (ch * 0x1000) + 0x518,
+						0x1FF0000);
+		dword_rd[ch][0][1] = RREG32_MASK(base + (ch * 0x1000) + 0x490,
+						0x1FF);
+		dword_rd[ch][0][2] = RREG32_MASK(base + (ch * 0x1000) + 0x490,
+						0x1FF0000);
+		dword_rd[ch][0][3] = dword_rd[ch][0][2] -
+					dword_rd[ch][0][1] + 1;
+		dword_rd[ch][1][0] = RREG32_MASK(base + (ch * 0x1000) + 0x618,
+						0x1FF0000);
+		dword_rd[ch][1][1] = RREG32_MASK(base + (ch * 0x1000) + 0x494,
+						0x1FF);
+		dword_rd[ch][1][2] = RREG32_MASK(base + (ch * 0x1000) + 0x494,
+						0x1FF0000);
+		dword_rd[ch][1][3] = dword_rd[ch][1][2] -
+					dword_rd[ch][1][1] + 1;
+		dword_rd[ch][2][0] = RREG32_MASK(base + (ch * 0x1000) + 0x718,
+						0x1FF0000);
+		dword_rd[ch][2][1] = RREG32_MASK(base + (ch * 0x1000) + 0x498,
+						0x1FF);
+		dword_rd[ch][2][2] = RREG32_MASK(base + (ch * 0x1000) + 0x498,
+						0x1FF0000);
+		dword_rd[ch][2][3] = dword_rd[ch][2][2] -
+					dword_rd[ch][2][1] + 1;
+		dword_rd[ch][3][0] = RREG32_MASK(base + (ch * 0x1000) + 0x818,
+						0x1FF0000);
+		dword_rd[ch][3][1] = RREG32_MASK(base + (ch * 0x1000) + 0x49C,
+						0x1FF);
+		dword_rd[ch][3][2] = RREG32_MASK(base + (ch * 0x1000) + 0x49C,
+						0x1FF0000);
+		dword_rd[ch][3][3] = dword_rd[ch][3][2] -
+					dword_rd[ch][3][1] + 1;
+	}
+}
+
+static void hardware_training(struct hbm *hbm, int device)
+{
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+	u32 dll_inc, status;
+	int ch, err;
+
+	reduce_pll();
+
+	if (hbm->inc == 16)
+		dll_inc = 3;
+	else if (hbm->inc == 4)
+		dll_inc = 2;
+	else
+		dll_inc = 1;
+
+	/* Reset read FIFO */
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+		WREG32(base + ch * 0x1000 + 0x294, 1);
+		WREG32(base + ch * 0x1000 + 0x294, 0);
+	}
+
+	acc_training(hbm, device);
+
+	/* AWORD training */
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
+		WREG32(base + ch * 0x1000 + 0x454,
+			((hbm->hardware_training_repeat - 1) << 16) |
+				(hbm->training_delay << 8) | dll_inc);
+
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+		WREG32(base + ch * 0x1000 + 0x450, 1);
+		err = hbm_poll_timeout(base + ch * 0x1000 + 0x450, 0,
+				       GAUDI_HBM_CFG_TIMEOUT_US, &status);
+		if (err) {
+			preboot_puts("AWORD write done test failed\n");
+			goto hw_train_out;
+		}
+	}
+
+	/* Cleanup: Reset HBM + MRS setup */
+	dram_rstn(device, cke_state_high);
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
+		config_dram_state(hbm, base, ch, dram_state_training);
+
+	/* DWORD read training */
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
+		WREG32(base + ch * 0x1000 + 0x484,
+			((hbm->hardware_training_repeat - 1) << 16) |
+			(hbm->training_delay << 8) | dll_inc);
+
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+		WREG32(base + ch * 0x1000 + 0x480, 1);
+		err = hbm_poll_timeout(base + ch * 0x1000 + 0x480, 0,
+				       GAUDI_HBM_CFG_TIMEOUT_US, &status);
+		if (err) {
+			preboot_puts("DWORD read done test failed\n");
+			goto hw_train_out;
+		}
+	}
+
+	/* Cleanup: Reset HBM + MRS setup */
+	dram_rstn(device, cke_state_high);
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
+		config_dram_state(hbm, base, ch, dram_state_training);
+
+	/* DWORD write training */
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
+		WREG32(base + ch * 0x1000 + 0x464,
+			((hbm->hardware_training_repeat - 1) << 16) |
+			(hbm->training_delay << 8) | dll_inc);
+
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+		WREG32(base + ch * 0x1000 + 0x460, 1);
+		err = hbm_poll_timeout(base + ch * 0x1000 + 0x460, 0,
+				       GAUDI_HBM_CFG_TIMEOUT_US, &status);
+		if (err) {
+			preboot_puts("DWORD write done test failed\n");
+			goto hw_train_out;
+		}
+	}
+
+hw_train_out:
+	read_hardware_training_result(device);
+
+	restore_pll();
+}
+
+static int init_ecc(struct hbm *hbm, int unused)
+{
+	u32 base;
+	u32 status;
+	int device, err, ch, sid;
+
+	/* Clean transition from Functional mode to MCBIST mode */
+	for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
+		base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+		for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+			config_mlb_state(base, ch, phy_state_initial);
+			config_mc_state(hbm, device, ch, mc_state_bist);
+			config_mlb_state(base, ch, phy_state_bypass);
+		}
+	}
+
+	/* Configure MCBIST engine for ECC init in all channels */
+	for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
+		base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+		for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+			WREG32(base + ch * 0x1000 + 0x100, 0x100);
+			WREG32(base + ch * 0x1000 + 0x108, 0x800000);
+			WREG32(base + ch * 0x1000 + 0x10c, 0x0);
+			WREG32(base + ch * 0x1000 + 0x110, 0x0);
+			WREG32(base + ch * 0x1000 + 0x114, 0xFFFFFFFF);
+			WREG32(base + ch * 0x1000 + 0x118, 0xFFFFFFFF);
+		}
+	}
+
+	for (sid = 0; sid < 2; sid++) {
+		/* Start MCBIST engine */
+		for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
+			base = GAUDI_HBM_CFG_BASE +
+						device * GAUDI_HBM_CFG_OFFSET;
+			for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+				WREG32(base + ch * 0x1000 + 0x104,
+						(0x0 | sid << 28 | sid << 29));
+				WREG32(base + ch * 0x1000 + 0x11C, 0x3);
+			}
+		}
+
+		/* Poll for MCBIST completion */
+		for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
+			base = GAUDI_HBM_CFG_BASE +
+						device * GAUDI_HBM_CFG_OFFSET;
+			for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+				err = hbm_poll_timeout(
+						base + ch * 0x1000 + 0x11C,
+						0x03000000,
+						GAUDI_HBM_ECC_CFG_TIMEOUT_US,
+						&status);
+				if (err) {
+					preboot_puts("ECC init failed\n");
+					config_mc_state(hbm, device, ch,
+							mc_state_normal);
+					return -1;
+				}
+			}
+		}
+	}
+
+	/* Clean transition from MCBIST mode to Functional mode */
+	for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
+		base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+		for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+			config_mlb_state(base, ch, phy_state_initial);
+			config_mc_state(hbm, device, ch, mc_state_normal);
+			config_mlb_state(base, ch, phy_state_bypass);
+		}
+	}
+
+	return 0;
+}
+
+#define EXTEST_PC_SIZE		116
+#define EXTEST_BYTE_SIZE	12
+#define EXTEST_COL1_OFFSET	96
+#define EXTEST_COL2_OFFSET	97
+#define EXTEST_ROW1_OFFSET	106
+#define EXTEST_ROW2_OFFSET	108
+#define EXTEST_AW_IDX		3
+
+static int hbm_channel_dc_test_repair(int device, int ch)
+{
+	struct ch_lane_repair_info *lr = &lr_info[device][ch];
+	struct dev_fail_info *dev_fail = &dev_fail_info[device];
+	u32 extest_fails[EXTEST_WDR_REG_NUM];
+	int i, r, bit, byte, pc, extest_idx, dq, col, row;
+
+	/* Gather extest fails */
+	for (r = 0; r < EXTEST_WDR_REG_NUM; r++)
+		extest_fails[r] = lr->extest_rx_fails[r] |
+			lr->extest_tx_fails[r];
+
+	for (pc = 0; pc < PC_PER_CH; pc++) {
+		for (byte = 0; byte < BYTES_PER_PC; byte++) {
+			/* DM (ECC) */
+			extest_idx = pc * EXTEST_PC_SIZE + byte * EXTEST_BYTE_SIZE + 0;
+			r = extest_idx / 32;
+			i = extest_idx % 32;
+			if (!!(extest_fails[r] & BIT(i)))
+				lr->failed_dm[pc] |= BIT(byte);
+
+			/* DBI (bit inversion) */
+			extest_idx = pc * EXTEST_PC_SIZE + byte * EXTEST_BYTE_SIZE + 11;
+			r = extest_idx / 32;
+			i = extest_idx % 32;
+			if (!!(extest_fails[r] & BIT(i)))
+				lr->failed_dbi[pc] |= BIT(byte);
+
+			/* DQ (data) */
+			for (bit = 0; bit < 4; bit++) {
+				dq = byte * 8 + bit;
+				extest_idx = pc * EXTEST_PC_SIZE + byte *
+					EXTEST_BYTE_SIZE + (bit + 1);
+				r = extest_idx / 32;
+				i = extest_idx % 32;
+				if (!!(extest_fails[r] & BIT(i)))
+					lr->failed_dq[pc] |= BIT(dq);
+			}
+
+			for (bit = 4; bit < 8; bit++) {
+				dq = byte * 8 + bit;
+				extest_idx = pc * EXTEST_PC_SIZE + byte * EXTEST_BYTE_SIZE +
+					(bit + 3);
+				r = extest_idx / 32;
+				i = extest_idx % 32;
+				if (!!(extest_fails[r] & BIT(i)))
+					lr->failed_dq[pc] |= BIT(dq);
+			}
+
+			/* Rest of DWORD pins: PAR, RD, WDQS, RDQS, DERR */
+			for (bit = 0; bit < 2; bit++) {
+				extest_idx = pc * EXTEST_PC_SIZE + byte * EXTEST_BYTE_SIZE +
+					(bit + 5);
+				r = extest_idx / 32;
+				i = extest_idx % 32;
+				if (!!(extest_fails[r] & BIT(i)))
+					dev_fail->unrep_dw |= BIT(i);
+			}
+		}
+	}
+
+	/* Column */
+	for (col = 0; col < 4; col++) {
+		extest_idx = EXTEST_COL1_OFFSET + col;
+		r = extest_idx / 32;
+		i = extest_idx % 32;
+		if (!!(extest_fails[r] & BIT(i)))
+			lr->failed_c |= BIT(col);
+	}
+
+	for (col = 4; col < CBUS_LANES_NUM; col++) {
+		extest_idx = EXTEST_COL2_OFFSET + col;
+		r = extest_idx / 32;
+		i = extest_idx % 32;
+		if (!!(extest_fails[r] & BIT(i)))
+			lr->failed_c |= BIT(col);
+	}
+
+	/* Row */
+	for (row = 0; row < 4; row++) {
+		extest_idx = EXTEST_ROW1_OFFSET + row;
+		r = extest_idx / 32;
+		i = extest_idx % 32;
+		if (!!(extest_fails[r] & BIT(i)))
+			lr->failed_r |= BIT(row);
+	}
+
+	for (row = 4; row < RBUS_LANES_NUM; row++) {
+		extest_idx = EXTEST_ROW2_OFFSET + row;
+		r = extest_idx / 32;
+		i = extest_idx % 32;
+		if (!!(extest_fails[r] & BIT(i)))
+			lr->failed_r |= BIT(row);
+	}
+
+	/* Rest of AWORD pins */
+	dev_fail->unrep_aw =
+		(extest_fails[EXTEST_AW_IDX] & BIT(4)) ||   /* CKE  */
+		(extest_fails[EXTEST_AW_IDX] & BIT(9))  ||  /* RC   */
+		(extest_fails[EXTEST_AW_IDX] & BIT(14)) ||  /* CK_t */
+		(extest_fails[EXTEST_AW_IDX] & BIT(15)) ||  /* CK_c */
+		(extest_fails[EXTEST_AW_IDX] & BIT(18)) ||  /* RR   */
+		(extest_fails[EXTEST_AW_IDX] & BIT(19)) ||  /* AERR */
+		dev_fail->temp2 || dev_fail->temp1 ||
+		dev_fail->temp0 || dev_fail->cattrip;
+
+	return hbm_channel_lane_repair(device, ch);
+}
+
+static int lane_detection(int device)
+{
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+	int ch, rc;
+
+	/* Enter IODC mode */
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
+		WREG32(base + ch * 0x1000 + 0x900, 1);
+
+	extest_rx(device);
+	extest_tx(device);
+
+	/* Exit IODC mode */
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
+		WREG32(base + ch * 0x1000 + 0x900, 0);
+
+	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
+		rc = hbm_channel_dc_test_repair(device, ch);
+		if (rc)
+			break;
+	}
+
+	return 0;
+}
+
+static void lane_remap(int device)
+{
+	struct ch_lane_repair_info *lr;
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+	u32 reg_800, reg_804, reg_808;
+	int mc_ch;
+
+	/* Clearing HLR information for all channels */
+	for (mc_ch = 0; mc_ch < GAUDI_HBM_CHANNELS; mc_ch++) {
+		lr = &lr_info[device][mc_ch];
+		lr->count.pc0 = 0;
+		lr->count.pc1 = 0;
+		lr->count.aw = 0;
+		lr->status = false;
+	}
+
+	for (mc_ch = 0; mc_ch < GAUDI_HBM_CHANNELS; mc_ch++) {
+		lr = &lr_info[device][mc_ch];
+		/* Read HBM lane repair eFuse information */
+		ieee1500_inst(device, hbm_ch_mapping[mc_ch],
+			      ieee1500_hard_lane_repair, EXTEST_READ_INST);
+		reg_800 = RREG32(base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) +
+				 0x800 + (hbm_ch_mapping[mc_ch] * 0x100));
+		reg_804 = RREG32(base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) +
+				 0x804 + (hbm_ch_mapping[mc_ch] * 0x100));
+		reg_808 = RREG32(base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) +
+				 0x808 + (hbm_ch_mapping[mc_ch] * 0x100));
+
+		lr->dw01_code = reg_800;
+		lr->aw_code = reg_804 & 0xFF;
+		lr->dw23_code = ((reg_804 & 0xFFFFFF00) >> 8) |
+			((reg_808 & 0xFF) << 24);
+
+		lane_update_phy(device, mc_ch);
+
+		lr->is_repair_code_valid = true;
+	}
+}
+
+static int temperature_read(int device)
+{
+	u32 base, rdata, ignore = 0;
+	bool invalid;
+
+	base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+	ieee1500_inst(device, ignore, ieee1500_temperature, EXTEST_READ_INST);
+	rdata = RREG32(base + GAUDI_HBM_CENTER_CHANNEL * 0x1000 + 0x800);
+	invalid = (rdata >> 7) & 1;
+
+	return invalid ? -1 : rdata & 0x7F;
+}
+
+static int temperature_check(int device)
+{
+	int temp = temperature_read(device);
+
+	if (temp < 0 || temp > GAUDI_MAX_TEMP_THRESHOLD)/* system power down? */
+		preboot_puts("HBM temp is invalid or high\n");
+
+	return temp;
+}
+
+static void hbm_reset(void)
+{
+	/* assert reset: set bits 33-36 (HBM) */
+	regmap_writel(0, mmPSOC_GLOBAL_CONF_UNIT_RST_N_L);
+	regmap_writel(0x1E, mmPSOC_GLOBAL_CONF_UNIT_RST_N_H);
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_UNIT_RST_N);
+	udelay(250);
+	/* deassert reset */
+	regmap_writel(0, mmPSOC_GLOBAL_CONF_UNIT_RST_N_L);
+	regmap_writel(0, mmPSOC_GLOBAL_CONF_UNIT_RST_N_H);
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_UNIT_RST_N);
+}
+
+static void hl_hbm_row_repair_flash_list(void)
+{
+	int err;
+	struct rma_table *table = NULL;
+	size_t size = 0;
+	u8 *p;
+
+	err = rma_table_read(RMA_HBM_ROW_REPLACEMENT_TABLE, &table, &size);
+	if (err || (size == 0))
+		return; /* no row replacement info, nothing to be done */
+
+	for (p = table->data; p < &table->data[size]; p += table->header.entry_size) {
+		struct rma_hbm_row_replacement_entry *entry =
+			(struct rma_hbm_row_replacement_entry *)p;
+
+		gaudi_hbm_row_repair(entry->device, entry->pc, entry->sid,
+				     entry->bank, entry->row);
+	}
+
+	rma_table_free(table, size);
+}
+
+/**
+ * gaudi_hbm_init - Initialize HBM controller of the chip and HBM memories
+ *		    Scrub the memories.
+ *
+ * Return: 0 for success, 1 for failure
+ *
+ */
+int gaudi_hbm_init(void)
+{
+	struct hbm *hbm = &hbm_data;
+	int dev, err;
+
+	hbm_reset();
+
+	for (dev = 0; dev < GAUDI_HBM_DEVICES; dev++) {
+		/* Initialization */
+
+		/* PHY requires 100ns delay from mc_rstn */
+		udelay(1);
+
+		phy_init(dev);
+		dram_rstn(dev, cke_state_low);
+
+		/* Lane remapping */
+		lane_remap(dev);
+
+		/* Internal Loopback (bring-up only) */
+		if (internal_loopback_test(hbm, dev)) {
+			preboot_puts("HBM intern loopback failed\n");
+			return 1;
+		}
+
+		/* IO connectivity test (bring-up only) */
+		if (lane_detection(dev)) {
+			preboot_puts("HBM lane det failed\n");
+			return 1;
+		}
+		dram_rstn(dev, cke_state_low);
+
+
+		/* Training */
+		hardware_training(hbm, dev);
+		check_training_result(hbm, dev);
+
+		/* Initialize MC for functional operation */
+		init_mc(hbm, dev);
+	}
+
+	/* Reset repaired failures before AC test */
+	hbm_reset_failures();
+
+	hl_hbm_row_repair_flash_list();
+
+	/* MC BIST (validate Training result and attempt repair) */
+	do {
+		err = mcbist_write_read_full(hbm, 0, true);
+	} while (err > 0);
+	if (err)
+		return 1;
+
+	/* If ECC enabled, perform ECC scrubbing */
+	if (hbm->ecc_enable)
+		if (init_ecc(hbm, 0))
+			return 1;
+
+	/* Temperature readout and Enable traffic */
+	for (dev = 0; dev < GAUDI_HBM_DEVICES; dev++) {
+		temperature_check(dev);
+		enable_traffic(dev);
+	}
+
+	return 0;
+}
+
+int hl_dram_get_adjusted_max_temp(void)
+{
+	int dev, temp, max = 0;
+
+	for (dev = 0; dev < GAUDI_HBM_DEVICES; dev++) {
+		temp = temperature_read(dev);
+		if (temp > max)
+			max = temp;
+	}
+
+	return max + HBM_TEMP_ADJUST_COEFF;
+}
