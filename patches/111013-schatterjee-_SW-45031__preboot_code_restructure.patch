+#define PROT_REGS_COUNT		32
+#define PROT_REGS_MAX		(PROT_REGS_COUNT - 1) /* Secure config -> LKD */
+#define BITS_IN_REG		32
+#define SNGL_REG_PROT_SIZE	(BITS_IN_REG * sizeof(u32))
+#define PROT_SIZE_MAX		(PROT_REGS_MAX * SNGL_REG_PROT_SIZE)
+
+/*
+ * Protection register calculation:
+ *
+ * prot_reg_base = (reg & 0xFFF000) + (secure_or_priv ? 0xE80 : 0xF80)
+ * prot_reg_offset = (reg & 0xF80) / 32
+ * prot_offset = prot_reg_base + prot_reg_offset
+ *
+ * Protection value (bit) calculation:
+ *
+ * val = ~(1 << ((reg & 0x7F) / 4))
+ */
+
+/* Protection bits helpers */
+#define PAGE_BASE(x)		((x) & 0xFFF000)
+#define PROT_REG_BASE(x, off)	((PAGE_BASE(x)) + (off))
+#define PROT_REG_OFF(x)		(((x) & 0xF80) / 32)
+#define PRIV_PROT_REG(x)	(PROT_REG_BASE((x), 0xE80) + PROT_REG_OFF(x))
+#define SEC_PROT_REG(x)		(PROT_REG_BASE((x), 0xF80) + PROT_REG_OFF(x))
+#define PROT_BIT(x)		(~(1 << (((x) & 0x7F) / 4)))
+
+#define PROT_OVR_SECURE		0
+#define PROT_OVR_PRIV		BIT(0)
+#define PROT_OVR_USER		BIT(1)
+
+struct preboot_security_efuse_cache {
+	bool is_invalid;
+	struct hl_sec_efuse fuse;
+};
+
+static struct preboot_security_efuse_cache preboot_security_fuse_cache = {
+	.is_invalid = true,
+};
+
+struct preboot_security_otp_cache {
+	bool is_invalid;
+	struct hl_sec_otp otp;
+};
+
+static struct preboot_security_otp_cache preboot_security_otp_cache = {
+	.is_invalid = true,
+};
+
+#ifdef FAKE_SECURITY
+#define FAKE_OTP_OFFSET	(2 * 1024 * 1024)
+static void preboot_security_copy_otp(struct hl_sec_otp *otp)
+{
+	spi_copy(otp, FAKE_OTP_OFFSET, sizeof(struct hl_sec_otp), "FAKE OTP");
+}
+
+#define FAKE_FUSE_OFFSET ((2 * 1024 * 1024) + (64 * 1024))
+static const struct hl_sec_efuse *preboot_security_get_fuse(void)
+{
+	struct hl_sec_efuse *fuse;
+	u32 *val;
+	int i;
+
+	if (preboot_security_fuse_cache.is_invalid) {
+		fuse = &preboot_security_fuse_cache.fuse;
+		preboot_puts("preboot in fake security mode\n");
+		spi_copy(fuse, FAKE_FUSE_OFFSET +
+			 (EFUSE_SECURITY_OFFSET * sizeof(*val)), sizeof(*fuse),
+			 "FAKE FUSE");
+
+		/* Fake fuse data is stored in negative logic */
+		for (i = 0; i < ARRAY_SIZE(fuse->data); i++) {
+			val = &fuse->data[i];
+			*val = ~(*val);
+		}
+
+		preboot_security_fuse_cache.is_invalid = false;
+	}
+
+	return &preboot_security_fuse_cache.fuse;
+}
+
+static void preboot_security_sp_sram_write_efuse(void)
+{
+	const struct hl_sec_efuse *efuse;
+
+	efuse = preboot_security_get_fuse();
+	if (!efuse)
+		return;
+
+	boot_info_set(HL_BOOT_INFO_SECURITY_FUSE, efuse, sizeof(*efuse));
+}
+
+#else
+static void preboot_security_copy_otp(struct hl_sec_otp *otp)
+{
+	spi_copy_otp(otp, OTP_SECURITY_OFFSET, sizeof(struct hl_sec_otp));
+}
+
+static const struct hl_sec_efuse *preboot_security_get_fuse(void)
+{
+	struct hl_sec_efuse *fuse;
+	u32 *val;
+	int i;
+
+	if (preboot_security_fuse_cache.is_invalid) {
+		fuse = &preboot_security_fuse_cache.fuse;
+
+		for (i = 0; i < ARRAY_SIZE(fuse->data); i++) {
+			val = &fuse->data[i];
+			if (preboot_fuse_read(EFUSE_SECURITY_OFFSET + i, val))
+				return NULL;
+		}
+		preboot_security_fuse_cache.is_invalid = false;
+	}
+
+	return &preboot_security_fuse_cache.fuse;
+}
+
+static void preboot_security_sp_sram_write_efuse(void)
+{
+	/* Do nothing for real eFuse */
+}
+
+#endif /* FAKE_SECURITY */
+
+static const struct hl_sec_otp *preboot_security_get_otp(void)
+{
+	struct hl_sec_otp *otp = &preboot_security_otp_cache.otp;
+
+	if (preboot_security_otp_cache.is_invalid) {
+		preboot_security_copy_otp(otp);
+		if (otp->magic_number != OTP_SECURITY_MAGIC)
+			return NULL;
+
+		preboot_security_otp_cache.is_invalid = false;
+	}
+
+	return otp;
+}
+
+static void preboot_security_sp_sram_write_otp(void)
+{
+	const struct hl_sec_otp *otp;
+
+	otp = preboot_security_get_otp();
+	if (!otp)
+		return;
+
+	boot_info_set(HL_BOOT_INFO_SECURITY_OTP, otp, sizeof(*otp));
+}
+
+static void preboot_security_sp_sram_init(void)
+{
+	preboot_security_sp_sram_write_otp();
+	preboot_security_sp_sram_write_efuse();
+}
+
+bool preboot_security_key_is_revoked(int key_idx)
+{
+	const struct hl_sec_efuse *fuse = preboot_security_get_fuse();
+
+	if (!fuse)
+		return true;
+
+	if (key_idx < SEC_KEY_REVOKE_BIT_START ||
+	    key_idx > SEC_KEY_REVOKE_BIT_END)
+		return true;
+
+	if (fuse->key_revoke & SEC_KEY_REVOKE_BIT(key_idx))
+		return true;
+
+	return false;
+}
+
+bool preboot_security_key_is_valid(int key_idx, const void *pub_key,
+				   int pub_key_len, const void *pub_key_ext,
+				   int pub_key_ext_len)
+{
+	const struct hl_sec_otp *otp = preboot_security_get_otp();
+	u8 value[SHA256_SUM_LEN];
+
+	if (!otp)
+		return false;
+
+	if (key_idx < SEC_KEY_REVOKE_BIT_START ||
+	    key_idx > SEC_KEY_REVOKE_BIT_END)
+		return false;
+
+	sha256_csum(pub_key, pub_key_len, value);
+	return !memcmp(&otp->keys[key_idx * SHA256_SUM_LEN], value,
+		       SHA256_SUM_LEN);
+}
+
+static int preboot_security_get_minimal_svn(void)
+{
+	const struct hl_sec_efuse *fuse = preboot_security_get_fuse();
+	const u32 *svn_bits;
+	int i, svn = 0;
+
+	if (!fuse)
+		return -1;
+
+	/* Use 32bit because the data may not be 64bit aligned */
+	svn_bits = (const u32 *)fuse->sec_ver_num;
+
+	/* Count how many consecutive LSB bits out of 128 are set in 4 32bit
+	 * iterations.
+	 */
+	for (i = 0; i < 4; i++) {
+		/* No bits are set, stop counting */
+		if (!svn_bits[i])
+			break;
+		/* All bits are set, move to next iteration, bits are counted
+		 * by the iterator at the end. Move to the next iteration.
+		 */
+		if (!~svn_bits[i])
+			continue;
+
+		/* Some bits are set, count them by __builtin_ctz() the bitwise
+		 * NOT value of the SVN since __builtin_ctz() count unset bits.
+		 */
+		svn += __builtin_ctz(~svn_bits[i]);
+		break;
+	}
+	/* Add bits counted by iterator in case that all the bits are set */
+	svn += i * 32;
+
+	preboot_puts_hex("SVN on eFuse: ", svn, 0);
+	return svn;
+}
+
+bool preboot_security_svn_is_valid(int sec_ver)
+{
+	int svn = preboot_security_get_minimal_svn();
+
+	if (svn < 0)
+		return false;
+
+	if (sec_ver < svn || sec_ver > SVN_MAX_VERSIONS) {
+		preboot_puts_hex("Illegal security version: ",
+				sec_ver, false);
+		return false;
+	}
+
+	return true;
+}
+
+/* Enable bit is SOC_STRAP10 in schematics */
+#define SECURITY_ENABLE_SW BIT(10)
+
+/* The routine shall return true in case of security enable in strap.
+ * Otherwise, shall return false (The polarity of strap is inverted:
+ * meaning '0' is for security enable).
+ */
+static bool preboot_security_is_strap_enabled(void)
+{
+	u32 boot_strap;
+
+	boot_strap = regmap_readl(mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS);
+
+	if (boot_strap & SECURITY_ENABLE_SW)
+		return false;
+
+	/* Check if OTP is valid.
+	 * This is done due to boards with HW rev lower then E which
+	 * has undetermined security strap value.
+	 * In case that security strap is 0 (on) and OTP is invalid, ignore the
+	 * strap.
+	 */
+	if (!preboot_security_get_otp()) {
+		preboot_puts("*** Security strap is ON while OTP is invalid - ignoring strap\n");
+		return false;
+	}
+
+	return true;
+}
+
+/* Security is enabled in the following condition:
+ * Boot strap pin for security is enabled or efuse bit
+ * for "security enabled" is true.
+ */
+bool preboot_security_is_enabled(void)
+{
+	const struct hl_sec_efuse *fuse = preboot_security_get_fuse();
+
+	if (preboot_security_is_strap_enabled())
+		return true;
+
+	/* If eFuse read failed, assume an attacker sabotage, security in on */
+	if (!fuse)
+		return true;
+
+	return !!fuse->security_enable;
+}
+
+static void set_prot_bits_range_all(u32 base, int size)
+{
+	int i, count = size / SNGL_REG_PROT_SIZE;
+	u32 prot_base;
+
+	for (i = 0; i < count; i++) {
+		/* each write protects 32 registers starting from prot_base */
+		prot_base = base + i * SNGL_REG_PROT_SIZE;
+		regmap_writel(0, PRIV_PROT_REG(prot_base));
+	}
+}
+
+static void set_prot_bits_pages_range_all(u32 base, u32 dist, int count)
+{
+	int i;
+	u32 prot_base;
+
+	for (i = 0; i < count; i++) {
+		prot_base = base + dist * i;
+		set_prot_bits_range_all(prot_base, PROT_SIZE_MAX);
+	}
+}
+
+static void set_prot_bits_priv_int_conf(u64 page_base)
+{
+	/* Calculate the private protection bits base register */
+	u32 base = PRIV_PROT_REG(page_base & ~HL_CFG_BASE);
+
+	/* Protect the private and internal registers */
+	set_prot_bits_range_all(base, SNGL_REG_PROT_SIZE * 2);
+}
+
+static void preboot_secure_dma_if_down_regs(u32 base)
+{
+	u32 mask, prot_base = base;
+
+	/* offsets: 0 - 0x580 */
+	set_prot_bits_range_all(prot_base, SNGL_REG_PROT_SIZE * 11);
+
+	/* offsets: 0x580 - 0x600 */
+	prot_base += SNGL_REG_PROT_SIZE * 11;
+	mask = ~(PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AW_0) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AW_1) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AW_2) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AW_3) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AW_4) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AW_5) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AW_6));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	/*
+	 * offsets: 0x600 - 0x680 allowed access
+	 * offsets: 0x680 - 0x700 as following:
+	 */
+	prot_base += SNGL_REG_PROT_SIZE * 2;
+	mask = (PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_PRIV_BASE_LOW_AW_0) &
+		PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_PRIV_BASE_LOW_AW_1) &
+		PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_PRIV_BASE_LOW_AW_2) &
+		PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_PRIV_BASE_LOW_AW_3) &
+		PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_PRIV_BASE_LOW_AW_4) &
+		PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_PRIV_BASE_LOW_AW_5) &
+		PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_PRIV_BASE_LOW_AW_6));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	/* offsets: 0x700 - 0x800 */
+	prot_base += SNGL_REG_PROT_SIZE;
+	set_prot_bits_range_all(prot_base, SNGL_REG_PROT_SIZE * 2);
+
+	/* offsets: 0x800 - 0x880 as following */
+	prot_base += SNGL_REG_PROT_SIZE * 2;
+	mask = ~(PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AR_0) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AR_1) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AR_2) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AR_3) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AR_4) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AR_5) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AR_6) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AR_7) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AR_8) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AR_9) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AR_10) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AR_11) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AR_12) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AR_13) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AR_14) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_LOW_AR_15) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_HIGH_AR_0) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_HIGH_AR_1) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_HIGH_AR_2) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_HIGH_AR_3) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_HIGH_AR_4) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_HIGH_AR_5) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_BASE_HIGH_AR_6));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	/* offsets: 0x880 - 0x900 allowed access */
+
+	/* offsets: 0x900 - 0x980 as following: */
+	prot_base += SNGL_REG_PROT_SIZE * 2;
+	mask = ~(PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_MASK_HIGH_AR_7) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_MASK_HIGH_AR_8) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_MASK_HIGH_AR_9) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_MASK_HIGH_AR_10) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_MASK_HIGH_AR_11) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_MASK_HIGH_AR_12) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_MASK_HIGH_AR_13) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_MASK_HIGH_AR_14) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_MASK_HIGH_AR_15));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	/* offsets: 0x980 - 0xA00 */
+	prot_base += SNGL_REG_PROT_SIZE;
+	set_prot_bits_range_all(prot_base, SNGL_REG_PROT_SIZE);
+
+	/* offsets: 0xA00 - 0xA80 */
+	prot_base += SNGL_REG_PROT_SIZE;
+	mask = ~(PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_HIT_AR) &
+		 PROT_BIT(mmDMA_IF_W_S_DOWN_CH0_RANGE_SEC_HIT_AW));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	/* offsets: 0xA80 - 0xF80 */
+	prot_base += SNGL_REG_PROT_SIZE;
+	set_prot_bits_range_all(prot_base, PROT_SIZE_MAX - (prot_base - base));
+}
+
+static void preboot_secure_dma_if_regs(u32 base)
+{
+	u32 mask, prot_base = base;
+
+	/* 0 - 0x300 */
+	set_prot_bits_range_all(prot_base, SNGL_REG_PROT_SIZE * 6);
+
+	/*
+	 * 0x300 - 0x400 allowed
+	 * 0x400 - 0x500 not allowed access
+	 */
+	prot_base += SNGL_REG_PROT_SIZE * 8;
+	set_prot_bits_range_all(prot_base, SNGL_REG_PROT_SIZE * 2);
+
+	/* 0x500 - 0x600 allowed */
+	/* 0x600 - 0x700 not allowed */
+	prot_base += SNGL_REG_PROT_SIZE * 4;
+	set_prot_bits_range_all(prot_base, SNGL_REG_PROT_SIZE * 2);
+
+	/* 0x700 - 0x780 as following: */
+	prot_base += SNGL_REG_PROT_SIZE * 2;
+	mask = ~(PROT_BIT(mmDMA_IF_W_S_DMA0_HIT_RPROT) &
+		 PROT_BIT(mmDMA_IF_W_S_DMA0_HIT_WPROT) &
+		 PROT_BIT(mmDMA_IF_W_S_DMA1_HIT_RPROT) &
+		 PROT_BIT(mmDMA_IF_W_S_DMA1_HIT_WPROT));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	/* 0x780 - 0xF80 as following: */
+	prot_base += SNGL_REG_PROT_SIZE;
+	set_prot_bits_range_all(prot_base, PROT_SIZE_MAX - (prot_base - base));
+}
+
+#define DMA_DIST		0x20000
+#define DMA_ENGINES		4
+#define DMA_CHANNELS		8
+static void preboot_secure_dma(void)
+{
+	u32 i, base, prot_base;
+
+	for (i = 0; i < DMA_ENGINES; i++) {
+		base = i * DMA_DIST;
+		prot_base = base + (mmDMA_IF_W_S_BASE & ~HL_CFG_BASE);
+		preboot_secure_dma_if_regs(prot_base);
+		prot_base = base + (mmDMA_IF_W_S_DOWN_BASE & ~HL_CFG_BASE);
+		set_prot_bits_range_all(prot_base, PROT_SIZE_MAX);
+		prot_base = base + (mmDMA_IF_W_S_DOWN_CH0_BASE & ~HL_CFG_BASE);
+		preboot_secure_dma_if_down_regs(prot_base);
+		prot_base = base + (mmDMA_IF_W_S_DOWN_CH1_BASE & ~HL_CFG_BASE);
+		preboot_secure_dma_if_down_regs(prot_base);
+	}
+
+	/* Protect open pages of DMA CORE and DMA QM */
+	for (i = 0; i < DMA_CHANNELS; i++) {
+		base = i * DMA_DIST;
+		set_prot_bits_priv_int_conf(mmDMA0_CORE_BASE + base);
+		set_prot_bits_priv_int_conf(mmDMA0_QM_BASE + base);
+	}
+}
+
+static void preboot_secure_cpu(void)
+{
+	u32 prot_base, base = mmCPU_CA53_CFG_BASE & ~HL_CFG_BASE;
+	u32 mask;
+
+	/* Set CPU level to privilege */
+	mask = CPU_IF_PROT_OVR_WR_EN_MASK |
+		CPU_IF_PROT_OVR_RD_EN_MASK |
+		BIT(CPU_IF_PROT_OVR_READ_SHIFT) |
+		BIT(CPU_IF_PROT_OVR_WRITE_SHIFT);
+	regmap_writel(mask, mmCPU_IF_PROT_OVR);
+
+	/* Protect CPU_CA53_CFG - 4K */
+	set_prot_bits_range_all(base, PROT_SIZE_MAX);
+
+	/* Protect CPU_IF */
+	base = mmCPU_IF_BASE & ~HL_CFG_BASE;	/* offsets: 0 - 0x200 */
+	set_prot_bits_range_all(base, SNGL_REG_PROT_SIZE * 4);
+
+	prot_base = base + SNGL_REG_PROT_SIZE * 4; /* offsets: 0x200 - 0x280 */
+	mask = ~(PROT_BIT(mmCPU_IF_PF_PQ_PI) &
+		PROT_BIT(mmCPU_IF_PQ_BASE_ADDR_LOW) &
+		PROT_BIT(mmCPU_IF_PQ_BASE_ADDR_HIGH) &
+		PROT_BIT(mmCPU_IF_PQ_LENGTH) &
+		PROT_BIT(mmCPU_IF_CQ_BASE_ADDR_LOW) &
+		PROT_BIT(mmCPU_IF_CQ_BASE_ADDR_HIGH) &
+		PROT_BIT(mmCPU_IF_CQ_LENGTH) &
+		PROT_BIT(mmCPU_IF_EQ_BASE_ADDR_LOW) &
+		PROT_BIT(mmCPU_IF_EQ_BASE_ADDR_HIGH) &
+		PROT_BIT(mmCPU_IF_EQ_LENGTH) &
+		PROT_BIT(mmCPU_IF_EQ_RD_OFFS) &
+		PROT_BIT(mmCPU_IF_QUEUE_INIT));
+	/* allow only secured access */
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	prot_base += SNGL_REG_PROT_SIZE;	/* offsets: 0x280 - 0xF80 */
+	set_prot_bits_range_all(prot_base, PROT_SIZE_MAX - (prot_base - base));
+}
+
+static void preboot_secure_pll(void)
+{
+	u32 base;
+
+	/* DMA_W, IF_E, MESH_W, MESH_E */
+	base = mmDMA_W_PLL_BASE & ~HL_CFG_BASE;
+	set_prot_bits_pages_range_all(base, 0x20000, 4);
+
+	/* IF_W, DMA_E, SRAM_W, SRAM_E */
+	base = mmIF_W_PLL_BASE & ~HL_CFG_BASE;
+	set_prot_bits_pages_range_all(base, 0x20000, 4);
+
+	/* PSOC_CPU, PSOC_MME, PSOC_PCI, PSOC_TPC, PSOC_HBM */
+	base = mmPSOC_CPU_PLL_BASE & ~HL_CFG_BASE;
+	set_prot_bits_pages_range_all(base, 0x1000, 5);
+
+	/* NIC0, NIC1 */
+	base = mmNIC0_PLL_BASE & ~HL_CFG_BASE;
+	set_prot_bits_pages_range_all(base, 0x40000, 2);
+
+	/* NIC2_HBM, NIC2_MME, NIC2_TPC */
+	base = mmNIC2_HBM_PLL_BASE & ~HL_CFG_BASE;
+	set_prot_bits_pages_range_all(base, 0x1000, 3);
+}
+
+static void preboot_secure_set_prot_bits_if_rtr(u32 base)
+{
+	u32 mask, prot_base = base, reg;
+
+	/* offsets: 0 - 0x400 */
+	set_prot_bits_range_all(prot_base, SNGL_REG_PROT_SIZE * 8);
+
+	/* offsets: 0x400 - 0x480 - close 3 regs gap between open registers */
+	prot_base += SNGL_REG_PROT_SIZE * 8;
+	reg = mmSIF_RTR_0_LBW_RANGE_PROT_HIT_AW + sizeof(u32);
+	mask = PROT_BIT(reg) & PROT_BIT(reg + sizeof(u32)) &
+		PROT_BIT(reg + 2 * sizeof(u32));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	/* offsets: 0x480 - 0x500 - close 3 regs gap between open registers */
+	prot_base += SNGL_REG_PROT_SIZE;
+	reg = mmSIF_RTR_0_LBW_RANGE_PROT_HIT_AR + sizeof(u32);
+	mask = PROT_BIT(reg) & PROT_BIT(reg + sizeof(u32)) &
+		PROT_BIT(reg + 2 * sizeof(u32));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	/* offsets: 0x500 - 0x580 */
+	prot_base += SNGL_REG_PROT_SIZE;
+	mask = ~(PROT_BIT(mmSIF_RTR_0_LBW_RANGE_PROT_MAX_AR_8) &
+		 PROT_BIT(mmSIF_RTR_0_LBW_RANGE_PROT_MAX_AR_9) &
+		 PROT_BIT(mmSIF_RTR_0_LBW_RANGE_PROT_MAX_AR_10) &
+		 PROT_BIT(mmSIF_RTR_0_LBW_RANGE_PROT_MAX_AR_11) &
+		 PROT_BIT(mmSIF_RTR_0_LBW_RANGE_PROT_MAX_AR_12) &
+		 PROT_BIT(mmSIF_RTR_0_LBW_RANGE_PROT_MAX_AR_13) &
+		 PROT_BIT(mmSIF_RTR_0_LBW_RANGE_PROT_MAX_AR_14) &
+		 PROT_BIT(mmSIF_RTR_0_LBW_RANGE_PROT_MAX_AR_15));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	/* offsets: 0x580 - 0xF80 */
+	prot_base += SNGL_REG_PROT_SIZE;
+	set_prot_bits_range_all(prot_base, PROT_SIZE_MAX - (prot_base - base));
+}
+
+static void preboot_secure_set_prot_bits_if_rtr_ctrl(u32 base)
+{
+	u32 mask, prot_base = base;
+
+	/* offsets: 0 - 0x580 */
+	set_prot_bits_range_all(prot_base, SNGL_REG_PROT_SIZE * 11);
+
+	/* offsets: 0x580 - 0x600 */
+	prot_base += SNGL_REG_PROT_SIZE * 11;
+	mask = ~(PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AW_0) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AW_1) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AW_2) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AW_3) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AW_4) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AW_5) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AW_6));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	/* offsets: 0x600 - 0x680 allowed access */
+	prot_base += SNGL_REG_PROT_SIZE;
+	regmap_writel(~0, PRIV_PROT_REG(prot_base));
+
+	/* offsets: 0x680 - 0x700 as following: */
+	prot_base += SNGL_REG_PROT_SIZE;
+	mask = (PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_PRIV_BASE_LOW_AW_0) &
+		PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_PRIV_BASE_LOW_AW_1) &
+		PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_PRIV_BASE_LOW_AW_2) &
+		PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_PRIV_BASE_LOW_AW_3) &
+		PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_PRIV_BASE_LOW_AW_4) &
+		PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_PRIV_BASE_LOW_AW_5) &
+		PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_PRIV_BASE_LOW_AW_6));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	/* offsets: 0x700 - 0x800 not allowed access */
+	prot_base += SNGL_REG_PROT_SIZE;
+	set_prot_bits_range_all(prot_base, SNGL_REG_PROT_SIZE * 2);
+
+	/* offsets: 0x800 - 0x880 as following: */
+	prot_base += SNGL_REG_PROT_SIZE * 2;
+	mask = ~(PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AR_0) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AR_1) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AR_2) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AR_3) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AR_4) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AR_5) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AR_6) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AR_7) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AR_8) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AR_9) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AR_10) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AR_11) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AR_12) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AR_13) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AR_14) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AR_15) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_HIGH_AR_0) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_HIGH_AR_1) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_HIGH_AR_2) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_HIGH_AR_3) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_HIGH_AR_4) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_HIGH_AR_5) &
+		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_HIGH_AR_6));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	/* offsets: 0x880 - 0x900 allowed access */
+	prot_base += SNGL_REG_PROT_SIZE;
+	regmap_writel(~0, PRIV_PROT_REG(prot_base));
+
+	/* offsets: 0x900 - 0x980 as following: */
+	prot_base += SNGL_REG_PROT_SIZE;
+	mask = ~(PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_MASK_HIGH_AR_7) &
+		PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_MASK_HIGH_AR_8) &
+		PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_MASK_HIGH_AR_9) &
+		PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_MASK_HIGH_AR_10) &
+		PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_MASK_HIGH_AR_11) &
+		PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_MASK_HIGH_AR_12) &
+		PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_MASK_HIGH_AR_13) &
+		PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_MASK_HIGH_AR_14) &
+		PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_MASK_HIGH_AR_15));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	/* offsets: 0x980 - 0xA00 not allowed access */
+	prot_base += SNGL_REG_PROT_SIZE;
+	set_prot_bits_range_all(prot_base, SNGL_REG_PROT_SIZE);
+
+	/* offsets: 0xA00 - 0xA80 as following: */
+	prot_base += SNGL_REG_PROT_SIZE;
+	mask = ~(PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_HIT_AW) &
+		PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_HIT_AR));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	/* offsets: 0xA80 - 0xF80 */
+	prot_base += SNGL_REG_PROT_SIZE;
+	set_prot_bits_range_all(prot_base, PROT_SIZE_MAX - (prot_base - base));
+}
+
+#define IF_RTRS_DIST		0x10000
+#define IF_RTR_TO_RTR_CTRL_DIST	0x6000
+#define IF_RTRS_NUM		16
+
+static void preboot_secure_if(void)
+{
+	int i;
+	u32 prot_base, base = mmSIF_RTR_0_BASE & ~HL_CFG_BASE;
+
+	for (i = 0; i < IF_RTRS_NUM; i++) {
+		prot_base = base + i * IF_RTRS_DIST;
+		preboot_secure_set_prot_bits_if_rtr(prot_base);
+
+		prot_base += IF_RTR_TO_RTR_CTRL_DIST;
+		preboot_secure_set_prot_bits_if_rtr_ctrl(prot_base);
+	}
+}
+
+static void preboot_secure_psoc_global_conf(void)
+{
+	u32 mask, prot_base, base = mmPSOC_GLOBAL_CONF_BASE & ~HL_CFG_BASE;
+
+	prot_base = base;	/* offsets: 0 - 0x80 */
+	mask = ~(PROT_BIT(mmPSOC_GLOBAL_CONF_NON_RST_FLOPS_0) &
+		PROT_BIT(mmPSOC_GLOBAL_CONF_BTM_FSM));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	prot_base += SNGL_REG_PROT_SIZE;	/* offsets: 0x80 - 0x100 */
+	set_prot_bits_range_all(prot_base, SNGL_REG_PROT_SIZE);
+
+	/* Unprotect SCRATCHPADs: offsets: 0x100 - 0x180 */
+	prot_base += SNGL_REG_PROT_SIZE;
+	regmap_writel(~0, PRIV_PROT_REG(prot_base));
+
+	/* offsets: 0x180 - 0x300 */
+	prot_base += SNGL_REG_PROT_SIZE;
+	set_prot_bits_range_all(prot_base, SNGL_REG_PROT_SIZE * 3);
+
+	/* offsets: 0x300 - 0x380 */
+	prot_base += SNGL_REG_PROT_SIZE * 3;
+	mask = ~(PROT_BIT(mmPSOC_GLOBAL_CONF_CPU_BOOT_STATUS) &
+		PROT_BIT(mmPSOC_GLOBAL_CONF_KMD_MSG_TO_CPU) &
+		PROT_BIT(mmPSOC_GLOBAL_CONF_TRACE_ADDR) &
+		PROT_BIT(mmPSOC_GLOBAL_CONF_TRACE_AWUSER) &
+		PROT_BIT(mmPSOC_GLOBAL_CONF_TRACE_ARUSER));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	prot_base += SNGL_REG_PROT_SIZE;	/* offsets: 0x380 - 0x480 */
+	set_prot_bits_range_all(prot_base, SNGL_REG_PROT_SIZE * 2);
+
+	prot_base += SNGL_REG_PROT_SIZE * 2;	/* offsets: 0x480 - 0x500 */
+	mask = ~PROT_BIT(mmPSOC_GLOBAL_CONF_SW_ALL_RST);
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	prot_base += SNGL_REG_PROT_SIZE;	/* offsets: 0x500 - 0xF80 */
+	set_prot_bits_range_all(prot_base, PROT_SIZE_MAX - (prot_base - base));
+}
+
+static void preboot_secure_psoc(void)
+{
+	u32 mask, base;
+
+	/* Set PSOC level to privilege */
+	mask = BIT(PSOC_GLOBAL_CONF_PROT_AR_SHIFT) |
+		BIT(PSOC_GLOBAL_CONF_PROT_AW_SHIFT);
+	regmap_writel(mask, mmPSOC_GLOBAL_CONF_PROT);
+
+	/* Note: PSOC_TIMESTAMP should not be protected */
+
+	/* Protect EFUSE */
+	base = mmPSOC_EFUSE_BASE & ~HL_CFG_BASE;
+	set_prot_bits_range_all(base, PROT_SIZE_MAX);
+
+	/* Protect GLOBAL_CONF - 4K */
+	preboot_secure_psoc_global_conf();
+
+	/* Set ETR level to user */
+	mask = BIT(PSOC_ETR_AXICTL_PROTCTRLBIT1_SHIFT);
+	regmap_writel(mask, mmPSOC_ETR_AXICTL);
+}
+
+static void preboot_secure_pci_wrap(void)
+{
+	u32 mask, prot_base, base = mmPCIE_WRAP_BASE & ~HL_CFG_BASE;
+
+	/* Set PCI level to secured */
+	mask = PCIE_WRAP_LBW_PROT_OVR_WR_EN_MASK |
+		PCIE_WRAP_LBW_PROT_OVR_RD_EN_MASK;
+	regmap_writel(mask, mmPCIE_WRAP_LBW_PROT_OVR);
+
+	prot_base = base;	/* offsets: 0 - 0x200 */
+	set_prot_bits_range_all(prot_base, SNGL_REG_PROT_SIZE * 4);
+
+	prot_base += SNGL_REG_PROT_SIZE * 4;	/* offsets: 0x200 - 0x280 */
+	mask = ~(PROT_BIT(mmPCIE_WRAP_RR_ELBI_WR_SEC_REG_CTRL) &
+		PROT_BIT(mmPCIE_WRAP_RR_ELBI_RD_SEC_REG_CTRL));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	prot_base += SNGL_REG_PROT_SIZE;	/* offsets: 0x280 - 0xF80 */
+	set_prot_bits_range_all(prot_base, PROT_SIZE_MAX - (prot_base - base));
+}
+
+void preboot_secure_mmu_up(void)
+{
+	u32 mask, prot_base, base = mmMMU_UP_BASE & ~HL_CFG_BASE;
+
+
+	/* blocking regs within offsets: 0 - 0x80 */
+	prot_base = base;
+	mask = (PROT_BIT(mmMMU_UP_FEATURE_ENABLE) |
+		PROT_BIT(mmMMU_UP_VA_ORDERING_MASK_31_7) |
+		PROT_BIT(mmMMU_UP_VA_ORDERING_MASK_31_7) |
+		PROT_BIT(mmMMU_UP_LOG2_DDR_SIZE) |
+		PROT_BIT(mmMMU_UP_SCRAMBLER) |
+		PROT_BIT(mmMMU_UP_MEM_INIT_BUSY) |
+		PROT_BIT(mmMMU_UP_DBG_MEM_WRAP_RM) |
+		PROT_BIT(mmMMU_UP_PIPE_CREDIT) |
+		PROT_BIT(mmMMU_UP_SLICE_CREDIT) |
+		PROT_BIT(mmMMU_UP_MMU_BYPASS));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	prot_base += SNGL_REG_PROT_SIZE;	/* offsets: 0x80 - 0xF80 */
+	set_prot_bits_range_all(prot_base, PROT_SIZE_MAX - (prot_base - base));
+}
+
+void preboot_secure_stlb(void)
+{
+	u32 mask, prot_base, base = mmSTLB_BASE & ~HL_CFG_BASE;
+
+	/* blocking regs within offsets: 0 - 0x80 */
+	prot_base = base;
+	mask = (PROT_BIT(mmSTLB_STLB_FEATURE_EN) |
+		PROT_BIT(mmSTLB_STLB_AXI_CACHE) |
+		PROT_BIT(mmSTLB_HOP_CONFIGURATION) |
+		PROT_BIT(mmSTLB_LINK_LIST) |
+		PROT_BIT(mmSTLB_MEM_CACHE_CONFIG) |
+		PROT_BIT(mmSTLB_SET_THRESHOLD_HOP0) |
+		PROT_BIT(mmSTLB_SET_THRESHOLD_HOP1) |
+		PROT_BIT(mmSTLB_SET_THRESHOLD_HOP2) |
+		PROT_BIT(mmSTLB_SET_THRESHOLD_HOP3) |
+		PROT_BIT(mmSTLB_SET_THRESHOLD_HOP4));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	/* leaving 1 reg unblocked within offsets: 0x80 - 0x100 */
+	prot_base += SNGL_REG_PROT_SIZE;
+	mask = ~(PROT_BIT(mmSTLB_MEM_READ_ARPROT));
+	regmap_writel(mask, PRIV_PROT_REG(prot_base));
+
+	prot_base += SNGL_REG_PROT_SIZE;	/* offsets: 0x100 - 0xF80 */
+	set_prot_bits_range_all(prot_base, PROT_SIZE_MAX - (prot_base - base));
+}
+
+static void preboot_secure_pci(void)
+{
+	/* Protect PCIE_WRAP - 4K */
+	preboot_secure_pci_wrap();
+
+	/* protect registers in MMU_UP */
+	preboot_secure_mmu_up();
+
+	/* protect registers in STLB */
+	preboot_secure_stlb();
+
+	/* The rest is protected by RRs */
+}
+
+#define MMES_NUM	4
+#define MMES_DIST	0x80000
+static void preboot_secure_mme(void)
+{
+	u32 reg;
+	int i;
+
+	/* Set MME engines level to user */
+	for (i = 0; i < MMES_NUM; i++) {
+		/* Set ACC to user */
+		reg = mmMME0_ACC_PROT + MMES_DIST * i;
+		regmap_writel(PROT_OVR_USER, reg);
+		/* Protect the ACC configuration */
+		regmap_writel(PROT_BIT(mmMME0_ACC_PROT), PRIV_PROT_REG(reg));
+		set_prot_bits_priv_int_conf(mmMME0_ACC_BASE + MMES_DIST * i);
+
+		/* Set SBAB to user */
+		reg = mmMME0_SBAB_PROT + MMES_DIST * i;
+		regmap_writel(PROT_OVR_USER, reg);
+		/* Protect the SBAB configuration */
+		regmap_writel(PROT_BIT(mmMME0_SBAB_PROT), PRIV_PROT_REG(reg));
+		set_prot_bits_priv_int_conf(mmMME0_SBAB_BASE + MMES_DIST * i);
+
+		/* Set CTRL to user */
+		reg = mmMME0_CTRL_PROT + MMES_DIST * i;
+		regmap_writel(PROT_OVR_USER, reg);
+		/* Protect the CTRL configuration */
+		regmap_writel(PROT_BIT(mmMME0_CTRL_PROT), PRIV_PROT_REG(reg));
+		set_prot_bits_priv_int_conf(mmMME0_CTRL_BASE + MMES_DIST * i);
+
+		/*
+		 * For MME1 and MME3 QMANs configuration the LBW clock
+		 * is disabled by default, so we have to enable the LBW clock
+		 * before accessing, otherwise we stuck.
+		 */
+		if (i & BIT(0)) {
+			reg = mmMME0_CTRL_QM_SLV_LBW_CLK_EN + MMES_DIST * i;
+			regmap_writel(1, reg);
+		}
+
+		/* protect QM priv and conf bits */
+		set_prot_bits_priv_int_conf(mmMME0_QM_BASE + MMES_DIST * i);
+
+		/* close the clock back */
+		if (i & BIT(0)) {
+			reg = mmMME0_CTRL_QM_SLV_LBW_CLK_EN + MMES_DIST * i;
+			regmap_writel(0, reg);
+		}
+	}
+}
+
+#define TPCS_NUM	8
+#define TPCS_DIST	0x40000
+static void preboot_secure_tpc(void)
+{
+	u32 mask, reg;
+	int i;
+
+	/* Set TPC engines level to user */
+	mask = PROT_OVR_USER << TPC0_CFG_PROT_ARPROT_SHIFT |
+		PROT_OVR_USER << TPC0_CFG_PROT_AWPROT_SHIFT;
+	for (i = 0; i < TPCS_NUM; i++) {
+		reg = mmTPC0_CFG_PROT + TPCS_DIST * i;
+		regmap_writel(mask, reg);
+
+		/* Protect the TPC configuration */
+		regmap_writel(PROT_BIT(mmTPC0_CFG_PROT), PRIV_PROT_REG(reg));
+		set_prot_bits_priv_int_conf(mmTPC0_CFG_BASE + TPCS_DIST * i);
+
+		/* Protect the E2E Creds */
+		reg = mmTPC0_E2E_CRED_BASE & ~HL_CFG_BASE;
+		set_prot_bits_range_all(reg + TPCS_DIST * i, PROT_SIZE_MAX);
+
+		/* Protect the QM priv and int conf bits */
+		set_prot_bits_priv_int_conf(mmTPC0_QM_BASE + TPCS_DIST * i);
+	}
+}
+
+static void preboot_secure_set_nic_eng_role(u32 prot_reg, u32 mask, int eng_cnt)
+{
+	int i, j;
+	u32 reg;
+
+	for (i = 0; i < GAUDI_NICS_NUM; i++) {
+		for (j = 0; j < eng_cnt; j++) {
+			/* Set the engine role (security level) */
+			reg = prot_reg + GAUDI_NICS_DIST * i +
+							GAUDI_NIC_ENGS_DIST * j;
+			regmap_writel(mask, reg);
+		}
+	}
+}
+
+/*
+ * preboot_secure_prot_nics_engs_regs	- protects several registers (up to 32)
+ *					  that are protected by the same
+ *					  protection register
+ *
+ * @base_reg	- one of the registers to protect - used for calculating the
+ *		  protection register offset.
+ * @mask	- the mask to write into the protection register
+ * @eng_cnt	- amount of engines to work on (usually 1, or 2)
+ */
+static void preboot_secure_prot_nics_engs_regs(u32 base_reg,
+					       u32 mask, int eng_cnt)
+{
+	int i, j;
+	u32 reg;
+
+	for (i = 0; i < GAUDI_NICS_NUM; i++) {
+		for (j = 0; j < eng_cnt; j++) {
+			reg = base_reg + GAUDI_NICS_DIST * i +
+							GAUDI_NIC_ENGS_DIST * j;
+			/* Protect the engine configuration */
+			regmap_writel(mask, PRIV_PROT_REG(reg));
+			/* Protect the private prot bits and config space */
+			set_prot_bits_priv_int_conf(PAGE_BASE(reg));
+		}
+	}
+}
+
+/* This function only suitable for single PROT OVR register protection */
+static void preboot_secure_nic_role_single(u32 reg, u32 mask, int eng_cnt)
+{
+	u32 prot_mask = PROT_BIT(reg);
+
+	preboot_secure_set_nic_eng_role(reg, mask, eng_cnt);
+	preboot_secure_prot_nics_engs_regs(reg, prot_mask, eng_cnt);
+}
+
+#define NIC_QM_DIST	0x2000
+static void preboot_secure_nic_open_pages(void)
+{
+	int i;
+	u32 nic_off;
+	u64 base;
+
+	for (i = 0; i < GAUDI_NICS_NUM; i++) {
+		nic_off = GAUDI_NICS_DIST * i;
+
+		/* STAT */
+		base = nic_off + mmNIC0_STAT_BASE;
+		set_prot_bits_priv_int_conf(base);
+
+		/* MAC CORE */
+		base = nic_off + mmNIC0_MAC_CORE_BASE;
+		set_prot_bits_priv_int_conf(base);
+
+		/* MAC AUX */
+		base = nic_off + mmNIC0_MAC_AUX_BASE;
+		set_prot_bits_priv_int_conf(base);
+
+		/* QM[0-1] */
+		base = nic_off + mmNIC0_QM0_BASE;
+		set_prot_bits_priv_int_conf(base);
+		set_prot_bits_priv_int_conf(base + NIC_QM_DIST);
+
+		/* TXB */
+		base = nic_off + mmNIC0_TXB_BASE;
+		set_prot_bits_priv_int_conf(base);
+	}
+}
+
+/* registers 0xF60-0xF80 are allowed access */
+#define PHY_RX_PROTECT_HIGH	0xF60
+
+static void preboot_secure_nic_phy(void)
+{
+	u32 mask, port, prot_base, base = mmNIC0_PHY_BASE & ~HL_CFG_BASE;
+
+	for (port = 0; port < GAUDI_NICS_NUM; port++) {
+		/* Protect PHY_RX_CFG registers in each NIC block */
+		mask = (PROT_BIT(mmNIC0_PHY_PHY_RX_CFG_0) &
+			PROT_BIT(mmNIC0_PHY_PHY_RX_CFG_1) &
+			PROT_BIT(mmNIC0_PHY_PHY_RX_CFG_2) &
+			PROT_BIT(mmNIC0_PHY_PHY_RX_CFG_3));
+		regmap_writel(mask, PRIV_PROT_REG(base));
+
+		/* offsets: 0x80 - 0xF60 */
+		prot_base = base + SNGL_REG_PROT_SIZE;
+		set_prot_bits_range_all(prot_base,
+					PHY_RX_PROTECT_HIGH - SNGL_REG_PROT_SIZE);
+		base += GAUDI_NICS_DIST;
+	}
+}
+
+static void preboot_secure_nic(void)
+{
+	u32 reg, mask;
+
+	/* STAT, MAC CORE/AUX, QMs, TXB */
+	preboot_secure_nic_open_pages();
+
+	/* QPC */
+	reg = mmNIC0_QPC0_AXI_PROT;
+	mask = PROT_OVR_SECURE << NIC0_QPC0_AXI_PROT_R_SHIFT;
+	preboot_secure_nic_role_single(reg, mask, 2);
+
+	/* RXB */
+	reg = mmNIC0_RXB_AXI_AXPROT_PRIV;
+	mask = PROT_OVR_SECURE << NIC0_RXB_AXI_AXPROT_PRIV_AXPROT_SHIFT;
+	preboot_secure_nic_role_single(reg, mask, 1);
+
+	/* TXS */
+	reg = mmNIC0_TXS0_AXI_PROT;
+	mask = PROT_OVR_SECURE << NIC0_TXS0_AXI_PROT_R_SHIFT;
+	preboot_secure_nic_role_single(reg, mask, 2);
+
+	/* TXE DATA, TXE WQE */
+	reg = mmNIC0_TXE0_DATA_FETCH_AXI_PROT;
+	mask = PROT_OVR_USER << NIC0_TXE0_DATA_FETCH_AXI_PROT_UNSECURED_SHIFT;
+	preboot_secure_nic_role_single(reg, mask, 2);
+	reg = mmNIC0_TXE0_WQE_FETCH_AXI_PROT;
+	mask = PROT_OVR_USER << NIC0_TXE0_WQE_FETCH_AXI_PROT_UNSECURED_SHIFT;
+	preboot_secure_nic_role_single(reg, mask, 2);
+
+	/* RXE AW LBW, RXE AR HBW */
+	reg = mmNIC0_RXE0_AWPROT_LBW;
+	mask = PROT_OVR_USER << NIC0_RXE0_AWPROT_LBW_AWPROT_LBW_UNSECURED_SHIFT;
+	preboot_secure_set_nic_eng_role(reg, mask, 2);
+	reg = mmNIC0_RXE0_ARPROT_HBW;
+	mask = PROT_OVR_USER << NIC0_RXE0_ARPROT_HBW_ARPROT_HBW_UNSECURED_SHIFT;
+	mask |= PROT_OVR_USER << NIC0_RXE0_ARPROT_HBW_ARPROT_HBW_SECURED_SHIFT;
+	mask |= PROT_OVR_USER <<
+		NIC0_RXE0_ARPROT_HBW_ARPROT_HBW_PRIVILEGED_SHIFT;
+	preboot_secure_set_nic_eng_role(reg, mask, 2);
+	mask = PROT_BIT(mmNIC0_RXE0_AWPROT_LBW) & PROT_BIT(reg);
+	preboot_secure_prot_nics_engs_regs(reg, mask, 2);
+
+	/* TMR LIST, TMR STATE */
+	reg = mmNIC0_TMR_TMR_LIST_AXI_PROT;
+	mask = PROT_OVR_SECURE << NIC0_TMR_TMR_LIST_AXI_PROT_R_SHIFT;
+	preboot_secure_set_nic_eng_role(reg, mask, 1);
+	reg = mmNIC0_TMR_TMR_STATE_AXI_PROT;
+	mask = PROT_OVR_SECURE << NIC0_TMR_TMR_STATE_AXI_PROT_R_SHIFT;
+	preboot_secure_set_nic_eng_role(reg, mask, 1);
+	mask = PROT_BIT(mmNIC0_TMR_TMR_LIST_AXI_PROT) & PROT_BIT(reg);
+	preboot_secure_prot_nics_engs_regs(reg, mask, 1);
+
+	preboot_secure_nic_phy();
+}
+
+#define SRAM_BANKS_NUM	32
+#define SRAM_BANKS_DIST	0x8000
+static void preboot_secure_sram_cfg(void)
+{
+	u32 base;
+
+	base = mmSRAM_Y0_X0_BANK_BASE & ~HL_CFG_BASE;
+	set_prot_bits_pages_range_all(base, SRAM_BANKS_DIST, SRAM_BANKS_NUM);
+
+	/*
+	 * There is an integration version mismatch bug in Gaudi
+	 * resulting in absence of the Privilege protection bits registers.
+	 * Therefore we cannot use the protection bits to protect the
+	 * SRAM_Y_X_RTRs.
+	 * LBW RRs are used instead.
+	 */
+}
+
+static void preboot_secure_pcie_rr_wr(int rr, u64 min64, u64 max64)
+{
+	u32 min = (u32)min64;
+	u32 max = (u32)max64;
+	u32 rr_base = rr * sizeof(u32), rr_dest;
+
+	/* Set WP RR */
+	rr_dest = rr_base + mmPCIE_WRAP_RR_WR_PRV_RANGE_REG_MIN_0;
+	regmap_writel(min, rr_dest);
+	rr_dest = rr_base + mmPCIE_WRAP_RR_WR_PRV_RANGE_REG_MAX_0;
+	regmap_writel(max, rr_dest);
+}
+
+static void preboot_secure_pcie_rr_rd(int rr, u64 min64, u64 max64)
+{
+	u32 min = (u32)min64;
+	u32 max = (u32)max64;
+	u32 rr_base = rr * sizeof(u32), rr_dest;
+
+	/* Set RP RR */
+	rr_dest = rr_base + mmPCIE_WRAP_RR_RD_PRV_RANGE_REG_MIN_0;
+	regmap_writel(min, rr_dest);
+	rr_dest = rr_base + mmPCIE_WRAP_RR_RD_PRV_RANGE_REG_MAX_0;
+	regmap_writel(max, rr_dest);
+}
+
+static void preboot_secure_pcie_rr(int rr, u64 min64, u64 max64)
+{
+	preboot_secure_pcie_rr_wr(rr, min64, max64);
+	preboot_secure_pcie_rr_rd(rr, min64, max64);
+}
+
+struct preboot_sec_lbw_rrs_cfg {
+	int instances_num;
+	u32 instances_dist;
+	u32 min_wr_breg;
+	u32 max_wr_breg;
+	u32 min_rd_breg;
+	u32 max_rd_breg;
+	u32 hit_wr_breg;
+	u32 hit_rd_breg;
+};
+
+enum preboot_sec_lbw_rr_type {
+	IF_RTR,
+	DMA_IF_SOB,
+	DMA_IF_CH0,
+	DMA_IF_CH1,
+};
+
+#define DMA_IF_NUM	4
+#define DMA_IF_DIST	0x20000
+
+struct preboot_sec_lbw_rrs_cfg preboot_sec_lbw_rrs_cfg[] = {
+	[IF_RTR] = {
+		.instances_num = IF_RTRS_NUM,
+		.instances_dist = IF_RTRS_DIST,
+		.min_wr_breg = mmSIF_RTR_0_LBW_RANGE_PRIV_MIN_AW_0,
+		.max_wr_breg = mmSIF_RTR_0_LBW_RANGE_PRIV_MAX_AW_0,
+		.min_rd_breg = mmSIF_RTR_0_LBW_RANGE_PRIV_MIN_AR_0,
+		.max_rd_breg = mmSIF_RTR_0_LBW_RANGE_PRIV_MAX_AR_0,
+		.hit_wr_breg = mmSIF_RTR_0_LBW_RANGE_PRIV_HIT_AW,
+		.hit_rd_breg = mmSIF_RTR_0_LBW_RANGE_PRIV_HIT_AR,
+	},
+	[DMA_IF_SOB] = {
+		.instances_num = DMA_IF_NUM,
+		.instances_dist = DMA_IF_DIST,
+		.min_wr_breg = mmDMA_IF_W_S_SOB_MIN_WPRIV_0,
+		.max_wr_breg = mmDMA_IF_W_S_SOB_MAX_WPRIV_0,
+		.min_rd_breg = mmDMA_IF_W_S_SOB_MIN_RPRIV_0,
+		.max_rd_breg = mmDMA_IF_W_S_SOB_MAX_RPRIV_0,
+		.hit_wr_breg = mmDMA_IF_W_S_SOB_HIT_WPRIV,
+		.hit_rd_breg = mmDMA_IF_W_S_SOB_HIT_RPRIV,
+	},
+	[DMA_IF_CH0] = {
+		.instances_num = DMA_IF_NUM,
+		.instances_dist = DMA_IF_DIST,
+		.min_wr_breg = mmDMA_IF_W_S_DMA0_MIN_WPRIV_0,
+		.max_wr_breg = mmDMA_IF_W_S_DMA0_MAX_WPRIV_0,
+		.min_rd_breg = mmDMA_IF_W_S_DMA0_MIN_RPRIV_0,
+		.max_rd_breg = mmDMA_IF_W_S_DMA0_MAX_RPRIV_0,
+		.hit_wr_breg = mmDMA_IF_W_S_DMA0_HIT_WPRIV,
+		.hit_rd_breg = mmDMA_IF_W_S_DMA0_HIT_RPRIV,
+	},
+	[DMA_IF_CH1] = {
+		.instances_num = DMA_IF_NUM,
+		.instances_dist = DMA_IF_DIST,
+		.min_wr_breg = mmDMA_IF_W_S_DMA1_MIN_WPRIV_0,
+		.max_wr_breg = mmDMA_IF_W_S_DMA1_MAX_WPRIV_0,
+		.min_rd_breg = mmDMA_IF_W_S_DMA1_MIN_RPRIV_0,
+		.max_rd_breg = mmDMA_IF_W_S_DMA1_MAX_RPRIV_0,
+		.hit_wr_breg = mmDMA_IF_W_S_DMA1_HIT_WPRIV,
+		.hit_rd_breg = mmDMA_IF_W_S_DMA1_HIT_RPRIV,
+	},
+};
+
+static void preboot_secure_lbw_rr_gen(int rr, u64 min64, u64 max64,
+				      enum preboot_sec_lbw_rr_type type)
+{
+	int i;
+	u32 min = min64 & ~HL_CFG_BASE;
+	u32 max = max64 & ~HL_CFG_BASE;
+	u32 rr_base, rr_dest, hit;
+	struct preboot_sec_lbw_rrs_cfg *cfg = &preboot_sec_lbw_rrs_cfg[type];
+
+	for (i = 0; i < cfg->instances_num; i++) {
+		rr_base = rr * sizeof(u32) + cfg->instances_dist * i;
+		rr_dest = rr_base + cfg->min_wr_breg;
+		regmap_writel(min, rr_dest);
+		rr_dest = rr_base + cfg->max_wr_breg;
+		regmap_writel(max, rr_dest);
+		rr_dest = rr_base + cfg->min_rd_breg;
+		regmap_writel(min, rr_dest);
+		rr_dest = rr_base + cfg->max_rd_breg;
+		regmap_writel(max, rr_dest);
+
+		/* Enable (hit) RR */
+		rr_base = cfg->instances_dist * i;
+		rr_dest = rr_base + cfg->hit_wr_breg;
+		hit = regmap_readl(rr_dest);
+		regmap_writel(hit | BIT(rr), rr_dest);
+
+		rr_dest = rr_base + cfg->hit_rd_breg;
+		hit = regmap_readl(rr_dest);
+		regmap_writel(hit | BIT(rr), rr_dest);
+	}
+}
+
+static void preboot_secure_lbw_rr_if(int rr, u64 min, u64 max)
+{
+	preboot_secure_lbw_rr_gen(rr, min, max, IF_RTR);
+	preboot_secure_lbw_rr_gen(rr, min, max, DMA_IF_SOB);
+	preboot_secure_lbw_rr_gen(rr, min, max, DMA_IF_CH0);
+	preboot_secure_lbw_rr_gen(rr, min, max, DMA_IF_CH1);
+}
+
+static void preboot_secure_lbw_rr(int rr, u64 min, u64 max)
+{
+	preboot_secure_lbw_rr_if(rr, min, max);
+	preboot_secure_pcie_rr(rr, min, max);
+}
+
+enum gaudi_sec_lbw_rrs {
+	LBW_RR_MME1_QM,
+	LBW_RR_MME3_QM_SRAM_CFG,
+	LBW_RR_CPU_TSTAMP,
+	LBW_RR_HBM_GIC,
+	LBW_RR_PCIE_DBI_COREBGN,
+	LBW_RR_PCIE_COREEND_AUX_PHY,
+	LBW_RR_PCIE_MSI_PSOC0,
+	LBW_RR_PSOC1_NIC0_MAC_CH,
+	LBW_RR_NIC0_TS_NIC1_MAC_CH,
+	LBW_RR_NIC1_TS_NIC2_MAC_CH,
+	LBW_RR_NIC3_MAC_CH,
+	LBW_RR_NIC3_TS_NIC4_MAC_CH,
+	LBW_RR_DBG_ETR,
+};
+
+#define SYNC_MNGR_DIST		0x20000
+#define SYNC_MNGR_SIZE		0x10000
+
+static void preboot_secure_lbw(void)
+{
+	int i;
+	u64 min, max, base;
+
+	/*
+	 * NOTE: The LBW and PCIe RRs HIT is: min < hit < max
+	 * meaning - not inclusive, so we need to provide it the min address
+	 * below the forbidden one and max address above the forbidden one.
+	 */
+	/* MME1_QM: RR(LBW_RR_MME1_QM) */
+	min = mmMME1_QM_BASE - 1;
+	max = mmMME2_ACC_BASE;
+	preboot_secure_lbw_rr(LBW_RR_MME1_QM, min, max);
+
+	/* MME3_QM, SRAM_CFG up to SIF: RR(LBW_RR_MME3_QM_SRAM_CFG) */
+	min = mmMME3_QM_BASE - 1;
+	max = mmSIF_RTR_0_BASE;
+	preboot_secure_lbw_rr(LBW_RR_MME3_QM_SRAM_CFG, min, max);
+
+	/* CPU_TIMESTAMP: RR(LBW_RR_CPU_TSTAMP) */
+	min = mmCPU_TIMESTAMP_BASE - 1;
+	max = mmDMA_IF_W_S_BASE;
+	preboot_secure_lbw_rr(LBW_RR_CPU_TSTAMP, min, max);
+
+	/* HBM_CFG up to PCIE_WRAP: RR(LBW_RR_HBM_GIC) */
+	min = mmHBM0_BASE - 1;
+	max = mmPCIE_WRAP_BASE;
+	preboot_secure_lbw_rr(LBW_RR_HBM_GIC, min, max);
+
+	/* PCIE_DBI up to PCIE_CORE_L: RR(LBW_RR_PCIE_DBI_COREBGN) */
+	min = mmPCIE_DBI_BASE - 1;
+	max = HL_CFG_BASE + mmPCIE_CORE_MSI_REQ;
+	preboot_secure_lbw_rr(LBW_RR_PCIE_DBI_COREBGN, min, max);
+
+	/* PCIE_CORE_H up to MMU_UP: RR(LBW_RR_PCIE_COREEND_AUX_PHY) */
+	min = max + sizeof(u32) - 1;
+	max = mmMMU_UP_BASE;
+	preboot_secure_lbw_rr(LBW_RR_PCIE_COREEND_AUX_PHY, min, max);
+
+	/* PCIE_MSI up to PSOC_TIMESTAMP: RR(LBW_RR_PCIE_MSI_PSOC0) */
+	min = mmPCIE_MSI_BASE - 1;
+	max = mmPSOC_TIMESTAMP_BASE;
+	preboot_secure_lbw_rr(LBW_RR_PCIE_MSI_PSOC0, min, max);
+
+	/* PSOC_GPIO0 up to NIC0_STAT: RR(LBW_RR_PSOC1_NIC0_MAC_CH) */
+	min = mmPSOC_GPIO0_BASE - 1;
+	max = mmNIC0_STAT_BASE;
+	preboot_secure_lbw_rr(LBW_RR_PSOC1_NIC0_MAC_CH, min, max);
+
+	/* NIC0_TS up to NIC1_STAT: RR(LBW_RR_NIC0_TS_NIC1_MAC_CH) */
+	min = mmNIC0_TS_BASE - 1;
+	max = mmNIC1_STAT_BASE;
+	preboot_secure_lbw_rr(LBW_RR_NIC0_TS_NIC1_MAC_CH, min, max);
+
+	/* NIC1_TS up to NIC2_STAT: RR(LBW_RR_NIC1_TS_NIC2_MAC_CH) */
+	min = mmNIC1_TS_BASE - 1;
+	max = mmNIC2_STAT_BASE;
+	preboot_secure_lbw_rr(LBW_RR_NIC1_TS_NIC2_MAC_CH, min, max);
+
+	/* NIC3_MAC_CH0 up to NIC3_STAT: RR(LBW_RR_NIC3_MAC_CH) */
+	min = mmNIC3_MAC_CH0_BASE - 1;
+	max = mmNIC3_STAT_BASE;
+	preboot_secure_lbw_rr(LBW_RR_NIC3_MAC_CH, min, max);
+
+	/* NIC3_TS up to NIC4_STAT: RR(LBW_RR_NIC3_TS_NIC4_MAC_CH) */
+	min = mmNIC3_TS_BASE - 1;
+	max = mmNIC4_STAT_BASE;
+	preboot_secure_lbw_rr(LBW_RR_NIC3_TS_NIC4_MAC_CH, min, max);
+
+	/* mmPSOC_ETR_AXICTL (single register): RR(LBW_RR_ETR) */
+	min = HL_CFG_BASE + mmPSOC_ETR_AXICTL - 1;
+	max = HL_CFG_BASE + mmPSOC_ETR_AXICTL + sizeof(u32);
+	preboot_secure_pcie_rr(LBW_RR_DBG_ETR, min, max);
+
+	/*
+	 * H3_errata:
+	 * Due to Router LBW address decoder bug
+	 * RR is defined for DBG block such that
+	 * DBG access via the address decoder are
+	 * blocked. Only PCIe/CA53/PSOC are allowed
+	 * to access as they do not contain address
+	 * decoding.
+	 */
+	/* Debug address space : 0x7FFE000000 - 0x7FFFFFFFFF */
+	min = mmMME_S_ROM_TABLE_BASE - 1;
+	/*
+	 * Spl case: As per LBW RR config 'min<hit<max' which means
+	 * address ranges of min-1 and max+1 should be configured, as
+	 * hit is not inclusive. But for DBG address max address is 0x7FFFFFFFFF
+	 * and max+1(0x80_0000_0000) is not a valid location.
+	 * Hence max+1 logic should not be applied for this case alone
+	 * and the max address is configured as 0x7FFFFFFFFF and not
+	 * 0x80_0000_0000.
+	 */
+	max = mmTPC7_EML_CS_BASE + TPC7_EML_CS_MAX_OFFSET - 1;
+	preboot_secure_lbw_rr_if(LBW_RR_DBG_ETR, min, max);
+
+	/* SYNC_MNGR: PCIe only! PCIe RR_28 up to PCIe RR_31 */
+	for (i = 0; i < 4; i++) {
+		base = mmSYNC_MNGR_GLBL_W_S_BASE + SYNC_MNGR_DIST * i;
+		min = base - 1;
+		max = base + SYNC_MNGR_SIZE;
+		preboot_secure_pcie_rr(28 + i, min, max);
+	}
+}
+
+static void preboot_hbw_rr_set_rtr_wr(int rr, int rtr, u64 base, u64 mask,
+				      bool is_lock)
+{
+	u32 base_l = (u32)base, base_h = (u32)(base >> BITS_IN_REG);
+	u32 mask_l = (u32)mask, mask_h = (u32)(mask >> BITS_IN_REG);
+	u32 rr_base, rr_dest, hit;
+
+	rr_base = rr * sizeof(u32) + IF_RTRS_DIST * rtr;
+	rr_dest = rr_base + mmSIF_RTR_CTRL_0_RANGE_PRIV_BASE_LOW_AW_0;
+	regmap_writel(base_l, rr_dest);
+	rr_dest = rr_base + mmSIF_RTR_CTRL_0_RANGE_PRIV_BASE_HIGH_AW_0;
+	regmap_writel(base_h, rr_dest);
+	rr_dest = rr_base + mmSIF_RTR_CTRL_0_RANGE_PRIV_MASK_LOW_AW_0;
+	regmap_writel(mask_l, rr_dest);
+	rr_dest = rr_base + mmSIF_RTR_CTRL_0_RANGE_PRIV_MASK_HIGH_AW_0;
+	regmap_writel(mask_h, rr_dest);
+
+	/* Enable (hit) RR */
+	rr_base = IF_RTRS_DIST * rtr;
+	rr_dest = rr_base + mmSIF_RTR_CTRL_0_RANGE_PRIV_HIT_AW;
+	hit = regmap_readl(rr_dest);
+	if (is_lock)
+		regmap_writel(hit | BIT(rr), rr_dest);
+	else
+		regmap_writel(hit & ~BIT(rr), rr_dest);
+}
+
+static void preboot_hbw_rr_set_rtr_ar(int rr, int rtr, u64 base, u64 mask,
+				      bool is_lock)
+{
+	u32 base_l = (u32)base, base_h = (u32)(base >> BITS_IN_REG);
+	u32 mask_l = (u32)mask, mask_h = (u32)(mask >> BITS_IN_REG);
+	u32 rr_base, rr_dest, hit;
+
+	rr_base = rr * sizeof(u32) + IF_RTRS_DIST * rtr;
+	rr_dest = rr_base + mmSIF_RTR_CTRL_0_RANGE_PRIV_BASE_LOW_AR_0;
+	regmap_writel(base_l, rr_dest);
+	rr_dest = rr_base + mmSIF_RTR_CTRL_0_RANGE_PRIV_BASE_HIGH_AR_0;
+	regmap_writel(base_h, rr_dest);
+	rr_dest = rr_base + mmSIF_RTR_CTRL_0_RANGE_PRIV_MASK_LOW_AR_0;
+	regmap_writel(mask_l, rr_dest);
+	rr_dest = rr_base + mmSIF_RTR_CTRL_0_RANGE_PRIV_MASK_HIGH_AR_0;
+	regmap_writel(mask_h, rr_dest);
+
+	/* Enable (hit) RR */
+	rr_base = IF_RTRS_DIST * rtr;
+	rr_dest = rr_base + mmSIF_RTR_CTRL_0_RANGE_PRIV_HIT_AR;
+	hit = regmap_readl(rr_dest);
+	if (is_lock)
+		regmap_writel(hit | BIT(rr), rr_dest);
+	else
+		regmap_writel(hit & ~BIT(rr), rr_dest);
+}
+
+static void preboot_hbw_rr_set_rtr(int rr, int rtr, u64 base, u64 mask,
+				   bool is_lock)
+{
+	preboot_hbw_rr_set_rtr_wr(rr, rtr, base, mask, is_lock);
+	preboot_hbw_rr_set_rtr_ar(rr, rtr, base, mask, is_lock);
+}
+
+static void preboot_secure_hbw_rr(int rr, u64 base, u64 mask)
+{
+	int i;
+
+	for (i = 0; i < IF_RTRS_NUM; i++)
+		preboot_hbw_rr_set_rtr(rr, i, base, mask, true);
+}
+
+static void preboot_secure_hbw_tpc3_seclvl_rr(u64 base, u64 mask, bool close)
+{
+	u32 base_l = (u32)base, base_h = (u32)(base >> BITS_IN_REG);
+	u32 mask_l = (u32)mask, mask_h = (u32)(mask >> BITS_IN_REG);
+	u32 hit;
+
+	regmap_writel(base_l, mmSIF_RTR_CTRL_7_RANGE_SEC_BASE_LOW_AW_0);
+	regmap_writel(base_h, mmSIF_RTR_CTRL_7_RANGE_SEC_BASE_HIGH_AW_0);
+	regmap_writel(mask_l, mmSIF_RTR_CTRL_7_RANGE_SEC_MASK_LOW_AW_0);
+	regmap_writel(mask_h, mmSIF_RTR_CTRL_7_RANGE_SEC_MASK_HIGH_AW_0);
+	regmap_writel(base_l, mmSIF_RTR_CTRL_7_RANGE_SEC_BASE_LOW_AR_0);
+	regmap_writel(base_h, mmSIF_RTR_CTRL_7_RANGE_SEC_BASE_HIGH_AR_0);
+	regmap_writel(mask_l, mmSIF_RTR_CTRL_7_RANGE_SEC_MASK_LOW_AR_0);
+	regmap_writel(mask_h, mmSIF_RTR_CTRL_7_RANGE_SEC_MASK_HIGH_AR_0);
+
+	/* Enable (hit) RR */
+	hit = regmap_readl(mmSIF_RTR_CTRL_7_RANGE_SEC_HIT_AW) & ~BIT(0);
+	if (close)
+		hit |= BIT(0);
+	regmap_writel(hit, mmSIF_RTR_CTRL_7_RANGE_SEC_HIT_AW);
+
+	hit = regmap_readl(mmSIF_RTR_CTRL_7_RANGE_SEC_HIT_AR) & ~BIT(0);
+	if (close)
+		hit |= BIT(0);
+	regmap_writel(hit, mmSIF_RTR_CTRL_7_RANGE_SEC_HIT_AR);
+}
+
+static void preboot_secure_hbw_tpc3_seclvl_close(void)
+{
+	u32 prot_base = mmSIF_RTR_CTRL_7_BASE & ~HL_CFG_BASE;
+
+	/* secure protection bits */
+	set_prot_bits_range_all(prot_base, PROT_SIZE_MAX);
+
+	/* Define mask of 32MB, so we close the SRAM in one shot */
+	preboot_secure_hbw_tpc3_seclvl_rr(SDRAM_BASE, 0x3FFFFE000000, true);
+}
+
+static void preboot_secure_hbw_tpc3_seclvl_open(void)
+{
+	u32 prot_base = mmSIF_RTR_CTRL_7_BASE & ~HL_CFG_BASE;
+
+	preboot_secure_hbw_tpc3_seclvl_rr(0, 0, false);
+
+	/* secure protection bits */
+	preboot_secure_set_prot_bits_if_rtr_ctrl(prot_base);
+}
+
+static void preboot_secure_hbw_sram(void)
+{
+	/* SRAM RR 0x7F_F000_0000 - 0x7F_F100_0000 (16MB) */
+	preboot_secure_hbw_rr(HBW_RR_SRAM_BGN,
+			      HBW_RR_SRAM_BGN_BASE, HBW_RR_SRAM_BGN_MASK);
+
+	/* SRAM RR 0x7F_F100_0000 - 0x7F_F140_0000 (4MB) */
+	preboot_secure_hbw_rr(HBW_RR_SRAM_END,
+			      HBW_RR_SRAM_END_BASE, HBW_RR_SRAM_END_MASK);
+}
+
+#define mmSTM_BASE	0x7FF4000000ULL
+#define mmRAZWI_BASE	0x7FFBFFF000ULL
+
+#define HBM_RR_BASE	0
+#define HBM_RR_MASK	0x3FFF800000000
+
+#define HL_SPI_END	(HL_SPI_BASE + HL_SPI_SIZE)
+
+static void preboot_secure_hbw(void)
+{
+	/* SRAM RR 0x7F_F000_0000 - 0x7F_F140_0000 (20MB) */
+	preboot_secure_hbw_sram();
+
+	/* SRAM Reduct. RR 0x7F_F140_0000 - 0x7F_F180_0000 (4MB) */
+	preboot_secure_hbw_rr(HBW_RR_SRAM_R_BGN, 0x7FF1400000, 0x3FFFFFC00000);
+
+	/* SRAM Reduct. RR 0x7F_F180_0000 - 0x7F_F200_0000 (8MB) */
+	preboot_secure_hbw_rr(HBW_RR_SRAM_R_1, 0x7FF1800000, 0x3FFFFF800000);
+
+	/* SRAM Reduct. RR 0x7F_F200_0000 - 0x7F_F280_0000 (8MB) */
+	preboot_secure_hbw_rr(HBW_RR_SRAM_R_END, 0x7FF2000000, 0x3FFFFF800000);
+
+	/* STM RR 0x7F_F400_0000 - 0x7F_F800_0000 (64MB) */
+	preboot_secure_hbw_rr(HBW_RR_STM, 0x7FF4000000, 0x3FFFFC000000);
+
+	/* SPI Flash RR 0x7F_F800_0000 - 0x7F_FA00_0000 (32MB) */
+	preboot_secure_hbw_rr(HBW_RR_SPI_FLASH, HL_SPI_BASE, 0x3FFFFE000000);
+
+	/* Scratchpad SRAM RR 0x7F_FBFE_0000 - 0x7F_FBFF_0000 (64KB) */
+	preboot_secure_hbw_rr(HBW_RR_SP_SRAM, 0x7FFBFE0000, 0x3FFFFFFF0000);
+
+	/* PCIe FW SRAM RR 0x7F_FBFF_0000 - 0x7F_FBFF_8000 (32KB) */
+	preboot_secure_hbw_rr(HBW_RR_PCIE_FW, 0x7FFBFF0000, 0x3FFFFFFF8000);
+
+	/* HBM RR 0 - 32GB */
+	/* Keep RR_0 last, as it replaces the BTL settings */
+	preboot_secure_hbw_rr(HBW_RR_HBM, HBM_RR_BASE, HBM_RR_MASK);
+
+	/*
+	 * PCIe IF HBW RRs are for direct access from PCIe IF to PSOC domain:
+	 * STM, SPI Flash, Scratchpad SRAM, PCIe FW SRAM.
+	 * SPSRAM space for fit is used in dynamic RR.
+	 * Assign the PCIe IF RR_16, RR_22, RR_24 (0-15 and 28-31 are allocated
+	 * for LBW) for this job.
+	 * NOTE: The PCIe RRs use min/max concept and HIT is: min < hit < max
+	 */
+	preboot_secure_pcie_rr(PCIE_DYN_RR_STM_SF, mmSTM_BASE - 1, HL_SPI_END);
+	preboot_secure_pcie_rr(22, HL_SPI_END - 1, FIT_IMG_SPSRAM_BASE);
+	preboot_secure_pcie_rr(24, FIT_IMG_SPSRAM_END - 1, mmRAZWI_BASE);
+}
+
+static void preboot_security_pci_rtr_disable(int rr)
+{
+	u32 reg = rr * sizeof(u32);
+	u32 hit;
+
+	/* PCIe RTR RR - HBM WP 0x0 - 0x07FFFFFFFF */
+	regmap_writel(0, reg + mmSIF_RTR_CTRL_7_RANGE_PRIV_BASE_LOW_AW_0);
+	regmap_writel(0, reg + mmSIF_RTR_CTRL_7_RANGE_PRIV_BASE_HIGH_AW_0);
+	regmap_writel(0, reg + mmSIF_RTR_CTRL_7_RANGE_PRIV_MASK_LOW_AW_0);
+	regmap_writel(0, reg + mmSIF_RTR_CTRL_7_RANGE_PRIV_MASK_HIGH_AW_0);
+	/* PCIe RTR RR - Disable (hit) RR */
+	hit = regmap_readl(mmSIF_RTR_CTRL_7_RANGE_PRIV_HIT_AW);
+	regmap_writel(hit & ~BIT(rr), mmSIF_RTR_CTRL_7_RANGE_PRIV_HIT_AW);
+
+	/* PCIe RTR RR - HBM RP 0x0 - 0x07FFFFFFFF */
+	regmap_writel(0, reg + mmSIF_RTR_CTRL_7_RANGE_PRIV_BASE_LOW_AR_0);
+	regmap_writel(0, reg + mmSIF_RTR_CTRL_7_RANGE_PRIV_BASE_HIGH_AR_0);
+	regmap_writel(0, reg + mmSIF_RTR_CTRL_7_RANGE_PRIV_MASK_LOW_AR_0);
+	regmap_writel(0, reg + mmSIF_RTR_CTRL_7_RANGE_PRIV_MASK_HIGH_AR_0);
+	/* PCIe RTR RR - Disable (hit) RR */
+	hit = regmap_readl(mmSIF_RTR_CTRL_7_RANGE_PRIV_HIT_AR);
+	regmap_writel(hit & ~BIT(rr), mmSIF_RTR_CTRL_7_RANGE_PRIV_HIT_AR);
+}
+
+#define PCIE_WRAP_RRS_NUM	32
+
+static void preboot_security_pci_disable(void)
+{
+	int i;
+	u32 base, prot_base;
+
+	for (i = 0; i < PCIE_WRAP_RRS_NUM; i++) {
+		base = i * sizeof(u32);
+		prot_base = base + mmPCIE_WRAP_RR_WR_PRV_RANGE_REG_MIN_0;
+		regmap_writel(0, prot_base);
+		prot_base = base + mmPCIE_WRAP_RR_WR_PRV_RANGE_REG_MAX_0;
+		regmap_writel(0, prot_base);
+		prot_base = base + mmPCIE_WRAP_RR_RD_PRV_RANGE_REG_MIN_0;
+		regmap_writel(0, prot_base);
+		prot_base = base + mmPCIE_WRAP_RR_RD_PRV_RANGE_REG_MAX_0;
+		regmap_writel(0, prot_base);
+	}
+
+	preboot_security_pci_rtr_disable(0);
+}
+
+void preboot_security_init(void)
+{
+	bool is_sec_en;
+
+	cpu_boot_err_clrset(CPU_BOOT_ERR0_SECURITY_NOT_RDY, true);
+	preboot_puts("Security init started...\n");
+
+	is_sec_en = preboot_security_is_enabled();
+	if (is_sec_en) {
+		preboot_secure_cpu();
+		preboot_secure_psoc();
+		preboot_secure_pci();
+		preboot_secure_mme();
+		preboot_secure_tpc();
+		preboot_secure_pll();
+		preboot_secure_nic();
+		preboot_secure_if();
+		preboot_secure_sram_cfg();
+		preboot_secure_dma();
+
+		preboot_secure_lbw();
+		preboot_secure_hbw();
+
+		preboot_puts("Security is enabled\n");
+	} else {
+		preboot_security_pci_disable();
+		preboot_puts("Security is disabled\n");
+	}
+
+	/* Store security info to be used by the booted image */
+	preboot_security_sp_sram_init();
+
+	cpu_boot_dev_sts_clrset(CPU_BOOT_DEV_STS0_SECURITY_EN, is_sec_en);
+
+	cpu_boot_err_clrset(CPU_BOOT_ERR0_SECURITY_NOT_RDY, false);
+	preboot_puts("Security init finished.\n");
+}
+
+#define SRAM_SIZE	0x1400000	/* 20MB */
+#define SRAM_END	(SDRAM_BASE + SRAM_SIZE)
+
+enum preboot_sec_rr_names {
+	SRAM_BGN_TO_VERS = 0,
+	VERSION,
+	VERS_END_TO_IMG,
+	IMAGE,
+	IMG_END_TO_SRAM_END,
+	STM_SF_MEMMAP,
+	SPSRAM_IMAGE,
+};
+
+struct preboot_sec_dyn_pcie_rr_cfg {
+	int rr;
+	u64 min;
+	u64 max;
+};
+
+static struct preboot_sec_dyn_pcie_rr_cfg preboot_sec_dyn_cfg[] = {
+	[SRAM_BGN_TO_VERS] = {
+		.rr = PCIE_DYN_RR_SRAM_BGN,
+		.min = SDRAM_BASE - 1,
+		.max = 0,	/* version start */
+	},
+	[VERSION] = {
+		.rr = PCIE_DYN_RR_SRAM_R1,
+		.min = 0,	/* version start */
+		.max = 0,	/* version end */
+	},
+	[VERS_END_TO_IMG] = {
+		.rr = PCIE_DYN_RR_SRAM_R2,
+		.min = 0,	/* version end */
+		.max = 0,
+	},
+	[IMAGE] = {
+		.rr = PCIE_DYN_RR_SRAM_R3,
+		.min = 0,
+		.max = 0,
+	},
+	[IMG_END_TO_SRAM_END] = {
+		.rr = PCIE_DYN_RR_SRAM_END,
+		.min = 0,
+		.max = SRAM_END,
+	},
+	[STM_SF_MEMMAP] = {
+		.rr = PCIE_DYN_RR_STM_SF,
+		.min = mmSTM_BASE - 1,
+		.max = HL_SPI_END,
+	},
+	[SPSRAM_IMAGE] = {
+		.rr = PCIE_DYN_RR_SPSRAM_IMG,
+		.min = FIT_IMG_SPSRAM_BASE - 1,
+		.max = FIT_IMG_SPSRAM_END,
+	},
+};
+
+void preboot_security_dynamic_img_sram_close(void)
+{
+	struct preboot_sec_dyn_pcie_rr_cfg *cfg = &preboot_sec_dyn_cfg[IMAGE];
+
+	if (!preboot_security_is_enabled())
+		return;
+
+	preboot_secure_pcie_rr(cfg->rr, cfg->min, cfg->max);
+}
+
+void preboot_security_dynamic_img_sram_open(enum mem_region img_region,
+					    enum preboot_mem_access_mode mode)
+{
+	struct preboot_sec_dyn_pcie_rr_cfg *cfg;
+	struct mem_desc mdesc;
+	u64 img_max;
+
+	if (!preboot_security_is_enabled())
+		return;
+
+	switch (img_region) {
+	case MEM_LKD_PCI:
+	case MEM_FWUPD_PCI:
+		if (preboot_get_mem_region(img_region, &mdesc))
+			preboot_puts_hex("SEC: failed requesting mem region ",
+					 img_region, false);
+		break;
+	default:
+		preboot_puts_hex("SEC: forbidden opening mem region ",
+				 img_region, false);
+		return;
+	}
+
+	/* Move the image window to the requested image memory region */
+	img_max = mdesc.base + mdesc.size;
+	preboot_sec_dyn_cfg[VERS_END_TO_IMG].max = mdesc.base;
+	preboot_sec_dyn_cfg[IMAGE].min = mdesc.base - 1;
+	preboot_sec_dyn_cfg[IMAGE].max = img_max;
+	preboot_sec_dyn_cfg[IMG_END_TO_SRAM_END].min = img_max - 1;
+
+	/* Apply the new window limits */
+	cfg = &preboot_sec_dyn_cfg[VERS_END_TO_IMG];
+	preboot_secure_pcie_rr(cfg->rr, cfg->min, cfg->max);
+	cfg = &preboot_sec_dyn_cfg[IMG_END_TO_SRAM_END];
+	preboot_secure_pcie_rr(cfg->rr, cfg->min, cfg->max);
+
+	/* Finally open the image memory space */
+	switch (mode) {
+	case ACCESS_RO:
+		preboot_secure_pcie_rr_rd(preboot_sec_dyn_cfg[IMAGE].rr, 0, 0);
+		break;
+	case ACCESS_WR:
+		preboot_secure_pcie_rr_wr(preboot_sec_dyn_cfg[IMAGE].rr, 0, 0);
+		break;
+	case ACCESS_RW:
+		preboot_secure_pcie_rr(preboot_sec_dyn_cfg[IMAGE].rr, 0, 0);
+		break;
+	}
+}
+
+void preboot_security_dynamic_img_spsram_close(void)
+{
+	struct preboot_sec_dyn_pcie_rr_cfg *cfg =
+					&preboot_sec_dyn_cfg[SPSRAM_IMAGE];
+
+	if (!preboot_security_is_enabled())
+		return;
+
+	preboot_secure_pcie_rr(cfg->rr, cfg->min, cfg->max);
+}
+
+void preboot_security_dynamic_img_spsram_open(void)
+{
+	preboot_secure_pcie_rr(preboot_sec_dyn_cfg[SPSRAM_IMAGE].rr, 0, 0);
+}
+
+void preboot_security_dynamic_vers_init(u64 vers_off, u32 size)
+{
+	struct preboot_sec_dyn_pcie_rr_cfg *cfg;
+	u64 vers_max = vers_off + size;
+	int i;
+
+	if (!preboot_security_is_enabled())
+		return;
+
+	/* Set PCIe RRs to allow read access to versions */
+	preboot_sec_dyn_cfg[SRAM_BGN_TO_VERS].max = vers_off;
+	preboot_sec_dyn_cfg[VERSION].min = vers_off - 1;
+	preboot_sec_dyn_cfg[VERSION].max = vers_max;
+	preboot_sec_dyn_cfg[VERS_END_TO_IMG].min = vers_max - 1;
+
+	/* Apply the versions RRs configuration */
+	for (i = SRAM_BGN_TO_VERS; i <= VERS_END_TO_IMG; i++) {
+		cfg = &preboot_sec_dyn_cfg[i];
+		if (i == VERSION) {	/* keep the version read only */
+			preboot_secure_pcie_rr_wr(cfg->rr, cfg->min, cfg->max);
+			preboot_secure_pcie_rr_rd(cfg->rr, 0, 0);
+			continue;
+		}
+
+		preboot_secure_pcie_rr(cfg->rr, cfg->min, cfg->max);
+	}
+}
+
+void preboot_security_dynamic_init(void)
+{
+	struct preboot_sec_dyn_pcie_rr_cfg *cfg;
+	struct mem_desc mdesc;
+	u64 img_max;
+	int i;
+
+	if (!preboot_security_is_enabled())
+		return;
+
+	/* Initialize image related configuration with default settings */
+	preboot_get_mem_region(MEM_LKD_PCI, &mdesc);
+	img_max = mdesc.base + mdesc.size;
+	preboot_sec_dyn_cfg[VERS_END_TO_IMG].max = mdesc.base;
+	preboot_sec_dyn_cfg[IMAGE].min = mdesc.base - 1;
+	preboot_sec_dyn_cfg[IMAGE].max = img_max;
+	preboot_sec_dyn_cfg[IMG_END_TO_SRAM_END].min = img_max - 1;
+
+	/*
+	 * TPC_3 is sharing SIF_7 RTR with PCIe, so we close its access to SRAM
+	 * via the secured level RRs. This is to prevent it from
+	 * accessing SRAM while opening part of SRAM to PCIe access.
+	 */
+	preboot_secure_hbw_tpc3_seclvl_close();
+
+	/* Start of init - close SRAM for PCIe access */
+	preboot_secure_pcie_rr(PCIE_DYN_RR_SRAM_END, SDRAM_BASE - 1, SRAM_END);
+
+	/* Apply all already known configurations */
+	for (i = SRAM_BGN_TO_VERS; i <= SPSRAM_IMAGE; i++) {
+		cfg = &preboot_sec_dyn_cfg[i];
+
+		if (cfg->rr >= 0 && cfg->min && cfg->max)
+			preboot_secure_pcie_rr(cfg->rr, cfg->min, cfg->max);
+	}
+
+	/* Disable the SIF7 HBW SRAM_IF_DYN_RR_BGN - SRAM_IF_DYN_RR_END */
+	for (i = HBW_RR_SRAM_BGN; i <= HBW_RR_SRAM_END; i++)
+		preboot_security_pci_rtr_disable(i);
+}
+
+void preboot_security_cleanup_before_run(void)
+{
+	if (!preboot_security_is_enabled())
+		return;
+
+	/* Enable the SIF7 HBW SRAM_IF_DYN_RR_BGN - SRAM_IF_DYN_RR_END */
+	preboot_secure_hbw_sram();
+
+	preboot_secure_hbw_tpc3_seclvl_open();
+}
+
+void preboot_security_sp_sram_write_key_idx(u32 *key_idx)
+{
+	boot_info_set(HL_BOOT_INFO_KEY_IDX, key_idx, sizeof(u32));
+}
+
+void preboot_security_sp_sram_write_key_hash(u8 *key, size_t len)
+{
+	boot_info_set(HL_BOOT_INFO_PUB_KEY_HASH, key, len);
+}
+
+int preboot_verify_img_sig(const void *img, size_t img_size,
+			   enum fit_sec_failure *res, u32 *key_idx)
+{
+	struct hl_fit_sec_desc fit_sec;
+	const void *fit_sec_off;
+	const void *pub_key_fit;
+	u8 signature[FIT_SIGNATURE_SIZE];
+
+	if (!preboot_security_is_enabled())
+		return 0;
+
+	/* hl fit files are padded so the size is 4 bytes aligned */
+	img_size = ROUND_UP4(img_size);
+
+	/* security descriptor is at the footer of the image */
+	fit_sec_off = (const void *)((u8 *)img + img_size);
+
+	/* check that the calculated memory range are legal */
+	if (!preboot_sram_is_valid_address_range((uintptr_t)fit_sec_off,
+						 sizeof(fit_sec))) {
+		preboot_puts("Invalid address range\n");
+		return 1;
+	}
+
+	memcpy(&fit_sec, fit_sec_off, FIT_SEC_DESC_SIZE);
+
+	if (fit_sec.magic_number != FIT_SEC_MAGIC) {
+		preboot_puts("Bad magic, security descriptor not found\n");
+		return 1;
+	}
+
+	if ((fit_sec.desc_version_maj != FIT_SEC_DESC_VER_MAJOR) ||
+	    (fit_sec.desc_version_min != FIT_SEC_DESC_VER_MINOR)) {
+		preboot_puts("security descriptor version mismatch\n");
+		return 1;
+	}
+
+	if (fit_sec.desc_size < FIT_SEC_DESC_SIZE) {
+		preboot_puts("security descriptor size too small\n");
+		return 1;
+	}
+
+	if (fit_sec.img_size != img_size) {
+		preboot_puts("image size mismatch with security descriptor\n");
+		return 1;
+	}
+
+	if (!preboot_security_svn_is_valid(fit_sec.sec_version)) {
+		preboot_puts("security descriptor svn not valid\n");
+		*res = FIT_SEC_SVN_INVALID;
+		return 1;
+	}
+
+	if (preboot_security_key_is_revoked(fit_sec.key_num)) {
+		preboot_puts_hex("Key revoked: ", fit_sec.key_num, false);
+		*res = FIT_SEC_KEY_REVOKED;
+		return 1;
+	}
+
+	pub_key_fit = &fit_sec.pub_key;
+
+	if (!preboot_security_key_is_valid(fit_sec.key_num, pub_key_fit,
+					   FIT_PUB_KEY_SIZE, NULL, 0)) {
+		preboot_puts("Key validation failed\n");
+		*res = FIT_SEC_SIGN_FAILED;
+		return 1;
+	}
+
+	/*
+	 * signature is calculated on both the fit image and the security
+	 * descriptor with the signature field of the descriptor zeroized.
+	 */
+	memcpy(signature, fit_sec.signature, FIT_SIGNATURE_SIZE);
+	memset(fit_sec.signature, 0, FIT_SIGNATURE_SIZE);
+
+	if (fit_verify_img_sig(img, img_size, &fit_sec, FIT_SEC_DESC_SIZE,
+			       pub_key_fit, signature, FIT_SIGNATURE_SIZE)) {
+		preboot_puts("image signature verification failed\n");
+		*res = FIT_SEC_SIGN_FAILED;
+		return 1;
+	}
+
+	*key_idx = fit_sec.key_num;
+
+	return 0;
+}
+
+size_t preboot_get_img_sec_desc_size(void)
+{
+	return FIT_SEC_DESC_SIZE;
+}
+
+bool preboot_is_image_sig_supported(void)
+{
+	return true;
+}
+
+#define PCI_RTR_NO	7
+
+void preboot_security_hbm_pci_open_ro(void)
+{
+	if (!preboot_security_is_enabled())
+		return;
+
+	preboot_hbw_rr_set_rtr_wr(HBW_RR_HBM, PCI_RTR_NO, HBM_RR_BASE,
+				  HBM_RR_MASK, true);
+	preboot_hbw_rr_set_rtr_ar(HBW_RR_HBM, PCI_RTR_NO, 0, 0, false);
+}
+
+void preboot_security_sf_pci_set_ro(bool en)
+{
+	struct preboot_sec_dyn_pcie_rr_cfg *cfg;
+
+	if (!preboot_security_is_enabled())
+		return;
+
+	cfg = &preboot_sec_dyn_cfg[STM_SF_MEMMAP];
+	preboot_secure_pcie_rr_wr(cfg->rr, cfg->min, cfg->max);
+	preboot_secure_pcie_rr_rd(cfg->rr, cfg->min,
+				  en ? HL_SPI_BASE : cfg->max);
+}
+
+/*
+ * preboot_security_sram_pci_set_ro() function assumes the TPC3 has already been
+ * moved to be secured through the secure level RRs and thus only opens the PCIe
+ * RRs for reading.
+ */
+void preboot_security_sram_pci_set_ro(bool en)
+{
+	int i;
+	u64 min, max;
+	struct preboot_sec_dyn_pcie_rr_cfg *cfg;
+
+
+	for (i = SRAM_BGN_TO_VERS; i <= IMG_END_TO_SRAM_END; i++) {
+		cfg = &preboot_sec_dyn_cfg[i];
+		min = en ? 0 : cfg->min;
+		max = en ? 0 : cfg->max;
+
+		if (cfg->rr >= 0 && cfg->min && cfg->max) {
+			preboot_secure_pcie_rr_wr(cfg->rr, cfg->min, cfg->max);
+			preboot_secure_pcie_rr_rd(cfg->rr, min, max);
+		}
+	}
+
+}
