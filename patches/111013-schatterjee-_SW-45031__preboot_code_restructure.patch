diff --git a/common/pll.c b/common/pll.c
deleted file mode 100644
index c8a7e3f..0000000
--- a/common/pll.c
+++ /dev/null
@@ -1,333 +0,0 @@
-/*
- * Copyright (C) 2017 HabanaLabs Ltd.
- *   Author: Noam Camus <noamikong@gmail.com>
- *
- * SPDX-License-Identifier:     GPL-2.0+
- */
-
-#include "preboot.h"
-#include "uart.h"
-#include "pll.h"
-
-#define HL_PLL_NR		0x100
-#define HL_PLL_NF		0x104
-#define HL_PLL_OD		0x108
-#define HL_PLL_NB		0x10c
-#define HL_PLL_CFG		0x110
-#define HL_PLL_CFG_LOCK		(1 << 4)
-#define HL_PLL_LOCK_INTR	0x128
-#define HL_PLL_DATA_CHNG	0x130
-#define HL_PLL_RST		0x134
-#define HL_PLL_CLK_GATER	0x300
-#define HL_PLL_CLK_RLX		0x310
-
-#define TIMESTAMP_CNTCR		0x00
-#define TIMESTAMP_CNTSR		0x04
-#define TIMESTAMP_CNTCVL	0x08
-#define TIMESTAMP_CNTCVU	0x0C
-#define TIMESTAMP_CNTFID0	0x20
-
-#define MIN_CYCLES_PER_ITER	5
-
-static u32 timestamp_base;
-static u64 cycles_per_usec = BYPASS_CYCLES_PER_USEC;
-
-void udelay_init(void)
-{
-	u32 timestamp_freq = hl_pll_timestamp_freq_get();
-
-	timestamp_base = hl_pll_timestamp_base_get();
-	cycles_per_usec = timestamp_freq / USEC_PER_SEC;
-
-	/* timer init */
-	regmap_writel(timestamp_freq, timestamp_base + TIMESTAMP_CNTFID0);
-	regmap_writel(0x3, timestamp_base + TIMESTAMP_CNTCR); /* EN | HDBG */
-}
-
-static u64 udelay_timestamp_get(void)
-{
-	u32 low, up1, up2;
-
-	up1 = regmap_readl(timestamp_base + TIMESTAMP_CNTCVU);
-	low = regmap_readl(timestamp_base + TIMESTAMP_CNTCVL);
-	up2 = regmap_readl(timestamp_base + TIMESTAMP_CNTCVU);
-	/* In case of overlap read low part again */
-	if (up1 != up2)
-		low = regmap_readl(timestamp_base + TIMESTAMP_CNTCVL);
-
-	return ((u64)up2 << 32) + low;
-}
-
-u64 timestamp_get_us(void)
-{
-	return udelay_timestamp_get() / cycles_per_usec;
-}
-
-bool timeout_expired(u64 start_tv, u32 delay)
-{
-	u64 current, timeout_tv = start_tv + delay;
-	bool overlap = false;
-
-	if (timeout_tv < start_tv)
-		overlap = true;
-
-	current = timestamp_get_us();
-	if (!overlap) {
-		if (current > timeout_tv || current <= start_tv)
-			return true;
-	} else {
-		if (current > timeout_tv && current < start_tv)
-			return true;
-	}
-
-	return false;
-}
-
-void udelay(unsigned int usec)
-{
-	u64 start, current, end = cycles_per_usec * usec;
-	bool overlap = false;
-
-	start = udelay_timestamp_get();
-	end += start;
-
-	if (end < start)
-		overlap = true;
-
-	while (1) {
-		current = udelay_timestamp_get();
-		if (!overlap) {
-			/* Check also for unplanned overlap */
-			if (current > end || current <= start)
-				break;
-		} else {
-			if (current > end && current < start)
-				break;
-		}
-	}
-}
-
-__weak u32 hl_pll_get_freq(u32 pll_base, enum hl_pll_div_out div)
-{
-	u32 nr, nf, od, div_sel, factor, offset;
-	u64 out_freq = SYS_REF_CLOCK;
-
-	offset = div * sizeof(u32);
-	div_sel = regmap_readl(pll_base + HL_PLL_DIV_SEL + offset);
-
-	if (div_sel == HL_PLL_PLL_CLK || div_sel == HL_PLL_DIV_PLL) {
-		nr = regmap_readl(pll_base + HL_PLL_NR) + 1;
-		nf = regmap_readl(pll_base + HL_PLL_NF) + 1;
-		od = regmap_readl(pll_base + HL_PLL_OD) + 1;
-		out_freq = (SYS_REF_CLOCK * nf) / (nr * od);
-	}
-
-	if (div_sel == HL_PLL_DIV_REF || div_sel == HL_PLL_DIV_PLL) {
-		factor = regmap_readl(pll_base + HL_PLL_DIV_FACTOR + offset);
-		out_freq /= factor + 1;
-	}
-
-	return out_freq;
-}
-
-__weak void hl_pll_reset(struct hl_pll_cfg *cfg, bool reset)
-{
-	regmap_writel(reset, cfg->base + HL_PLL_RST);
-}
-
-__weak int hl_pll_is_locked(struct hl_pll_cfg *cfg)
-{
-	return regmap_readl(cfg->base + HL_PLL_CFG) & HL_PLL_CFG_LOCK;
-}
-
-__weak void hl_pll_clear_lock_status(struct hl_pll_cfg *cfg)
-{
-	u32 reg = regmap_readl(cfg->base + HL_PLL_CFG);
-
-	regmap_writel(reg & ~HL_PLL_CFG_LOCK, cfg->base + HL_PLL_CFG);
-}
-
-#define HL_PLL_CLK_RLX_RST_VAL	0x100010
-__weak void hl_pll_clk_relax_reset(struct hl_pll_cfg *cfg)
-{
-	int sel;
-	u32 reg;
-
-	for (sel = 0; sel < HL_PLL_DIV_SIZE; sel++) {
-		reg = cfg->base + HL_PLL_CLK_RLX + (sel * sizeof(u32));
-		regmap_writel(HL_PLL_CLK_RLX_RST_VAL, reg);
-	}
-}
-
-__weak void hl_pll_cfg(struct hl_pll_cfg *cfg)
-{
-	hl_pll_reset(cfg, true);
-
-	regmap_writel(cfg->nr, cfg->base + HL_PLL_NR);
-	regmap_writel(cfg->nf, cfg->base + HL_PLL_NF);
-	regmap_writel(cfg->od, cfg->base + HL_PLL_OD);
-	regmap_writel(cfg->nb, cfg->base + HL_PLL_NB);
-	regmap_writel(0x11, cfg->base + HL_PLL_DATA_CHNG);
-
-	/* after updating the coefficients we need to wait >=5us */
-	udelay(HL_PLL_MAX_WAIT_TIME);
-
-	hl_pll_reset(cfg, false);
-
-	/* Wait >500 (10us) reference cycles until PLL re-locks. */
-	udelay(HL_PLL_MAX_WAIT_TIME);
-}
-
-void hl_pll_clk_switch_to_ref(u32 pll_base, int div_num)
-{
-	u32 reg = pll_base + HL_PLL_DIV_SEL + (div_num * sizeof(u32));
-
-	switch (regmap_readl(reg)) {
-	case HL_PLL_DIV_PLL:
-		/* first change DIV_REF, then DIV_PLL */
-		regmap_writel(HL_PLL_DIV_REF, reg);
-		udelay(1);
-		/* no break */
-	case HL_PLL_PLL_CLK:
-	case HL_PLL_DIV_REF:
-		regmap_writel(HL_PLL_REF_CLK, reg);
-		break;
-	case HL_PLL_REF_CLK:
-	default:
-		break;
-	}
-}
-
-void hl_pll_switch_to_ref(struct hl_pll_cfg *cfg)
-{
-	int sel;
-
-	for (sel = 0; sel < HL_PLL_DIV_SIZE; sel++) {
-		hl_pll_clk_switch_to_ref(cfg->base, sel);
-	}
-
-	/* just to be on a safe side, wait for bypass to propagate */
-	udelay(1);
-}
-
-void hl_pll_clk_switch_to_pll(u32 pll_base, int div_num, int div_sel)
-{
-	u32 reg = pll_base + HL_PLL_DIV_SEL + (div_num * sizeof(u32));
-
-	switch (div_sel) {
-	case HL_PLL_DIV_PLL:
-		/* first change DIV_REF, then DIV_PLL */
-		regmap_writel(HL_PLL_DIV_REF, reg);
-		udelay(1);
-		/* no break */
-	case HL_PLL_DIV_REF:
-	case HL_PLL_PLL_CLK:
-		regmap_writel(div_sel, reg);
-		break;
-	case HL_PLL_REF_CLK:
-	default:
-		break;
-	}
-}
-
-static void hl_pll_switch_to_pll(struct hl_pll_cfg *cfg)
-{
-	int sel;
-
-	for (sel = 0; sel < HL_PLL_DIV_SIZE; sel++) {
-		hl_pll_clk_switch_to_pll(cfg->base, sel, cfg->div_sel[sel]);
-	}
-
-	/* just to be on a safe side, wait for bypass to propagate */
-	udelay(1);
-}
-
-static void hl_pll_div_init(struct hl_pll_cfg *cfg)
-{
-	int sel;
-	u32 div_base;
-
-	for (sel = 0; sel < HL_PLL_DIV_SIZE; sel++) {
-		if (cfg->div_sel[sel] == HL_PLL_REF_CLK ||
-		    cfg->div_factor[sel] < 0)
-			continue;
-
-		div_base = cfg->base + (sel * sizeof(u32));
-
-		regmap_writel(cfg->div_factor[sel],
-				div_base + HL_PLL_DIV_FACTOR);
-		regmap_writel(1, div_base + HL_PLL_DIV_FACTOR_CMD);
-		regmap_writel(1, div_base + HL_PLL_DIV_EN);
-	}
-
-	/* just to be on a safe side, wait for DIV init to propagate */
-	udelay(1);
-}
-
-static bool hl_pll_wait_for_lock(struct hl_pll_cfg *cfg)
-{
-	int tout = HL_PLL_LOCK_TOUT;
-	bool is_locked = true;
-
-	while (!hl_pll_is_locked(cfg) && tout--)
-		udelay(1);
-
-	if (tout < 0) {
-		preboot_puts_raw("PLL lock timedout for");
-		preboot_puts(cfg->name);
-		is_locked = false;
-	}
-
-	return is_locked;
-}
-
-__weak void hl_pll_ack_int(struct hl_pll_cfg *cfg)
-{
-	regmap_writel(1, cfg->base + HL_PLL_LOCK_INTR);
-}
-
-__weak void hl_pll_set_div_sel_delay(struct hl_pll_cfg *cfg) { }
-
-static void hl_pll_set(struct hl_pll_cfg *cfg)
-{
-	bool is_locked;
-	int retries = HL_PLL_LOCK_MAX_RETRY;
-
-	hl_pll_set_div_sel_delay(cfg);
-
-	hl_pll_switch_to_ref(cfg);
-	hl_pll_clk_relax_reset(cfg);
-
-	hl_pll_cfg(cfg);
-
-	hl_pll_div_init(cfg);
-
-	/* to be on a safe side, poll on the PLL lock status bit */
-	is_locked = hl_pll_wait_for_lock(cfg);
-
-	while (!is_locked && retries--) {
-		hl_pll_reset(cfg, true);
-		udelay(HL_PLL_MAX_WAIT_TIME);
-		hl_pll_reset(cfg, false);
-		is_locked = hl_pll_wait_for_lock(cfg);
-	}
-
-	/* w/a the h/w erratum: lock status bit isn't getting cleared */
-	hl_pll_clear_lock_status(cfg);
-
-	hl_pll_ack_int(cfg);
-
-	if (is_locked)
-		hl_pll_switch_to_pll(cfg);
-}
-
-/**
- * hl_pll_init - Initialize pll registers
- */
-void hl_pll_init(struct hl_pll_cfg *hl_pll_cfg, int size)
-{
-	int i;
-
-	for (i = 0; i < size; i++)
-		hl_pll_set(hl_pll_cfg + i);
-}
