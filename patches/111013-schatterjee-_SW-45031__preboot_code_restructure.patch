-static void change_pll(u32 val)
-{
-	int i;
-	u32 div_base;
-	u32 nic_pll_base[] = { mmNIC0_PLL_BASE & ~HL_CFG_BASE,
-			       mmNIC1_PLL_BASE & ~HL_CFG_BASE };
-
-	for (i = 0; i < ARRAY_SIZE(nic_pll_base); i++) {
-		div_base = nic_pll_base[i] + (HL_PLL_DIV2 * sizeof(u32));
-
-		regmap_writel(HL_PLL_REF_CLK, div_base + HL_PLL_DIV_SEL);
-		udelay(1);
-		regmap_writel(val, div_base + HL_PLL_DIV_FACTOR);
-		regmap_writel(1, div_base + HL_PLL_DIV_FACTOR_CMD);
-		udelay(1);
-		regmap_writel(HL_PLL_DIV_REF, div_base + HL_PLL_DIV_SEL);
-		udelay(1);
-		regmap_writel(HL_PLL_DIV_PLL, div_base + HL_PLL_DIV_SEL);
-	}
-}
-
-static inline void reduce_pll(void)
-{
-	change_pll(15);
-}
-
-static inline void restore_pll(void)
-{
-	change_pll(8);
-}
-
-static void set_dll_val(u32 base, int ch, u32 reg, u32 val)
-{
-	u32 add16, add4, add1, address;
-	int i;
-
-	add16 = val >> 4;
-	add4 = (val % 16) >> 2;
-	add1 = (val % 16) % 4;
-
-	address = base + ch * 0x1000 + reg;
-
-	RMWREG32(address, 4, 0xFF);
-
-	for (i = 0; i < add16; i++)
-		RMWREG32(address, 3, 0xFF);
-
-	for (i = 0; i < add4; i++)
-		RMWREG32(address, 2, 0xFF);
-
-	for (i = 0; i < add1; i++)
-		RMWREG32(address, 1, 0xFF);
-}
-
-static void set_acc_dll(u32 base, int ch, int dw, u32 val)
-{
-	set_dll_val(base, ch, (dw + 4) * 0x100 + 0x14, val);
-}
-
-static void set_dword_read_dll(u32 base, int ch, int dw, u32 val)
-{
-	set_dll_val(base, ch, (dw + 5) * 0x100 + 0x18, val);
-	set_dll_val(base, ch, (dw + 5) * 0x100 + 0x1C, val);
-}
-
-static void set_dword_write_dll(u32 base, int ch, int dw, u32 val)
-{
-	set_dll_val(base, ch, (dw + 5) * 0x100 + 0x28, val);
-}
-
-static u32 aword_acc_window(u32 base, int ch)
-{
-	return RREG32_MASK(base + ch * 0x1000 + 0x414, 0x1FF0000);
-}
-
-static u32 dword_acc_window(u32 base, int ch, int dw)
-{
-	return RREG32_MASK(base + ch * 0x1000 + 0x100 * (dw + 5) + 0x14,
-				0x1FF0000);
-}
-
-static void copy_acc(u32 base)
-{
-	u32 val, add16, add4, add1;
-	int i, ch;
-
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch += 2) {
-		val = aword_acc_window(base, ch);
-
-		add16 = val >> 4;
-		add4 = (val % 16) >> 2;
-		add1 = (val % 16) % 4;
-
-		RMWREG32(base + (ch + 1) * 0x1000 + 0x414, 4, 0xFF);
-
-		for (i = 0; i < add16; i++)
-			RMWREG32(base + (ch + 1) * 0x1000 + 0x414, 3, 0xFF);
-
-		for (i = 0; i < add4; i++)
-			RMWREG32(base + (ch + 1) * 0x1000 + 0x414, 2, 0xFF);
-
-		for (i = 0; i < add1; i++)
-			RMWREG32(base + (ch + 1) * 0x1000 + 0x414, 1, 0xFF);
-	}
-}
-
-static void config_mlb_state(u32 base, int ch, enum phy_state next_state)
-{
-	enum phy_state curr_state =
-				RREG32_MASK(base + ch * 0x1000 + 0x200, 0xFF00);
-	int offset = next_state - curr_state;
-	int i;
-
-	if (!offset)
-		return;
-
-	/* mdelay(20); */
-
-	for (i = 0; i < abs(offset); i++)
-		RMWREG32(base + ch * 0x1000 + 0x200,
-				(offset > 0) ? 1 : 2, 0xFF);
-
-	/* mdelay(20); */
-}
-
-static void set_mode_reg_by_mlb(u32 base, int ch, u32 num, u32 op)
-{
-	u32 count = 0, i, one = 1, parity;
-	u32 value = (num << 8) | op;
-
-	for (i = 0; i < 12; i++)
-		if (value & (one << i))
-			count++;
-
-	parity = count & 1;
-
-	WREG32(base + ch * 0x1000 + 0x210, (parity << 16) | value);
-	WREG32(base + ch * 0x1000 + 0x214, 4);
-
-	mdelay(1);
-}
-
-static void config_dram_state(struct hbm *hbm, u32 base,
-					int ch, enum dram_state state)
-{
-	config_mlb_state(base, ch, phy_state_initial);
-
-	if (state == dram_state_training) {
-		/* CA Par=en, Wr Par=en, Rd Par=en, WDBI=en, RDBI=en */
-		set_mode_reg_by_mlb(base, ch, 0, 0x73);
-		/* drive strength=15mA, WR=16 */
-		set_mode_reg_by_mlb(base, ch, 1, 0x70);
-		/* RL=22, WL=7 */
-		set_mode_reg_by_mlb(base, ch, 2, 0xA6);
-		/* BL=4, BG=enable, tRAS=33 */
-		set_mode_reg_by_mlb(base, ch, 3, 0xE1);
-		/* PL=0, DM=disable, ECC=enable */
-		set_mode_reg_by_mlb(base, ch, 4, 0x03);
-		/* Vref=50% */
-		set_mode_reg_by_mlb(base, ch, 15, 0x00);
-
-		/* Adjust MLB for PL=0 */
-		RMWREG32(base + ch * 0x1000 + 0x204, 0x0, 0x300);
-	} else if (state == dram_state_bypass) {
-		/* CA Par=en, Wr Par=en, Rd Par=en, WDBI=en, RDBI=en */
-		set_mode_reg_by_mlb(base, ch, 0, 0x70 |
-					(hbm->dbi_enable << 1) |
-					(hbm->dbi_enable << 0));
-		/* drive strength=15mA, WR=16 */
-		set_mode_reg_by_mlb(base, ch, 1, 0x70);
-		/* RL=22, WL=7 */
-		set_mode_reg_by_mlb(base, ch, 2, 0xA6);
-		/* BL=4, BG=enable, tRAS=33 */
-		set_mode_reg_by_mlb(base, ch, 3, 0xE1);
-		/* PL=2, DM=disable, ECC=enable */
-		set_mode_reg_by_mlb(base, ch, 4, 0x8 |
-					(hbm->ecc_enable << 1) |
-					(hbm->ecc_enable << 0));
-		/* Vref=50% */
-		set_mode_reg_by_mlb(base, ch, 15, 0x00);
-
-		/* Adjust MLB for PL=2 */
-		RMWREG32(base + ch * 0x1000 + 0x204, 0x2, 0x300);
-	}
-}
-
-static void set_timing_params(int device, int ch)
-{
-	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-
-	/* Support only 800MHz */
-
-	/* trfc_sb_fix=128, r_r2w = 18 to support PL=2 */
-	WREG32(base + (ch * 0x1000) + 0x04C, 0x80030812);
-	/* r_trfc_sb=256, r_trrefd_norm=92, trrefd_min=8 */
-	WREG32(base + (ch * 0x1000) + 0x050, 0x205C0100);
-	/* tRTP_L=5, tWTP_L=22, tRP=12 */
-	WREG32(base + (ch * 0x1000) + 0x058, 0xC1605);
-	/* r_tcksre=r_tcksrx=14, trefi=97, txp=6, trfc=280 */
-	WREG32(base + (ch * 0x1000) + 0x05C, 0xEE616118);
-	/*
-	 * r_t_rddata_en=0x15, r_t_phy_wrlat=0x6, r_t_phy_wrdata=0x1,
-	 * r_rrq_switch_lvl_low=0x0
-	 */
-	WREG32(base + (ch * 0x1000) + 0x054, 0x10615);
-}
-
-static void config_mc_state(struct hbm *hbm, int device, int ch,
-				enum mc_state state)
-{
-	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-
-	if (state == mc_state_bist) {
-		RMWREG32(base + ch * 0x1000 + 0x004, 1, 0x1);
-		/* Adjust the refresh rate */
-		WREG32(base + (ch * 0x1000) + 0x050, 0x20360098);
-	} else if (state == mc_state_normal) {
-		/* Allow time for issuing REFab */
-		udelay(100);
-		RMWREG32(base + ch * 0x1000 + 0x004, 0, 0x1);
-		set_timing_params(device, ch);
-	}
-}
-
-static void lane_update_phy(int device, int mc_ch)
-{
-	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-	struct ch_lane_repair_info *lr = &lr_info[device][mc_ch];
-
-	/* Configure MLB according to remapped lanes */
-	if (lr->dw01_code != 0xFFFFFFFF) {
-		lr->dw01_code = lr->dw01_code;
-		lr->count.pc0 = 1;
-		if (((lr->dw01_code & 0xFFFF) != 0xFFFF) &&
-		    (((lr->dw01_code >> 16) & 0xFFFF) != 0xFFFF))
-			lr->count.pc0 = 2;
-
-		lr->status = true;
-
-		WREG32(base + (mc_ch * 0x1000) + 0x2F0, lr->dw01_code);
-	}
-
-	if (lr->dw23_code != 0xFFFFFFFF) {
-		lr->dw23_code = lr->dw23_code;
-		lr->count.pc1 = 1;
-		if (((lr->dw23_code & 0xFFFF) != 0xFFFF) &&
-		    (((lr->dw23_code >> 16) & 0xFFFF) != 0xFFFF))
-			lr->count.pc1 = 2;
-
-		lr->status = true;
-
-		WREG32(base + (mc_ch * 0x1000) + 0x2F4, lr->dw23_code);
-	}
-
-	if (lr->aw_code != 0xFF) {
-		lr->aw_code = lr->aw_code;
-		lr->count.aw = 1;
-		lr->status = true;
-
-		WREG32(base + (mc_ch * 0x1000) + 0x2F8, lr->aw_code);
-	}
-}
-
-static void lane_update_hbm(int device, int mc_ch)
-{
-	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-	struct ch_lane_repair_info *lr = &lr_info[device][mc_ch];
-
-	/* Check if we need to update HBM */
-	if (!lr->is_repair_code_valid ||
-	    (lr->dw01_code == 0xFFFFFFFF && lr->dw23_code == 0xFFFFFFFF &&
-	     lr->aw_code == 0xFF))
-		return;
-
-	/* HBM device configuration */
-	WREG32(base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) + 0x100,
-	       lr->dw01_code);
-	WREG32(base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) + 0x104,
-	       (lr->dw23_code << 8) | (lr->aw_code & 0xff));
-	WREG32(base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) + 0x108,
-	       lr->dw23_code >> 24);
-
-	ieee1500_inst(device, hbm_ch_mapping[mc_ch], ieee1500_soft_lane_repair,
-		      EXTEST_WRITE_INST);
-}
-
-static void lr_reset_failures(struct ch_lane_repair_info *lr,
-			       bool is_reset_count)
-{
-	memset(lr->extest_rx_fails, 0, sizeof(lr->extest_rx_fails));
-	memset(lr->extest_tx_fails, 0, sizeof(lr->extest_tx_fails));
-	memset(lr->failed_dq, 0, sizeof(lr->failed_dq));
-	memset(lr->failed_dm, 0, sizeof(lr->failed_dm));
-	memset(lr->failed_dbi, 0, sizeof(lr->failed_dbi));
-	lr->failed_r = 0;
-	lr->failed_c = 0;
-
-	if (is_reset_count)
-		memset(lr->fails_in_byte, 0, sizeof(lr->fails_in_byte));
-}
-
-static void hbm_reset_failures(void)
-{
-	int device, ch;
-
-	for (device = 0; device < GAUDI_HBM_DEVICES; device++)
-		for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
-			lr_reset_failures(&lr_info[device][ch], true);
-}
-
-/*
- * Return 0 if HBM was repaired or does not need repair.
- */
-static int hbm_channel_lane_repair(int device, int ch)
-{
-	struct hbm *hbm = &hbm_data;
-	struct ch_lane_repair_info *lr = &lr_info[device][ch];
-	struct dev_fail_info *dev_fail = &dev_fail_info[device];
-	int fails_in_cbus = 0, fails_in_rbus = 0;
-	u8 repair_code[PC_PER_CH][8], repair_code_c, repair_code_r;
-	u32 *dw_code;
-	int pc, byte, bit;
-
-	if (dev_fail->unrep_dw)  /* Failures in unrepairable pins */
-		return 1;
-
-	/* Create repair vector */
-	for (pc = 0; pc < PC_PER_CH; pc++) {
-		dw_code = pc ? &lr->dw23_code : &lr->dw01_code;
-
-		/* Convert dw codes nibbles to repair_code array */
-		for (byte = 0; byte < BYTES_PER_PC; byte++)
-			repair_code[pc][byte] = (*dw_code >> (4 * byte)) & 0xf;
-
-		for (byte = 0; byte < BYTES_PER_PC; byte++) {
-			/* repair_code should contains the repair codes that we
-			 * introduce during ATE (hard repair)
-			 */
-			if (repair_code[pc][byte] < REPAIR_CODE_ADJ)
-				lr->fails_in_byte[pc][byte] = 1;
-			else
-				lr->fails_in_byte[pc][byte] = 0;
-
-			/* Check result of current byte */
-			for (bit = 0; bit < BITS_PER_BYTE; bit++) {
-				if (!!(lr->failed_dq[pc] &
-				       BIT(byte * 8 + bit))) {
-					lr->fails_in_byte[pc][byte]++;
-					repair_code[pc][byte] = bit + REPAIR_CODE_DQ0;
-				}
-			}
-
-			/* In case that DBI (data bit inversion) is enabled and
-			 * we got more than 8 flipped bits, than probably dbi
-			 * lane is failing
-			 */
-			if (hbm->dbi_enable &&
-			    lr->fails_in_byte[pc][byte] >= 8 &&
-			    !(lr->failed_dm[pc] & BIT(byte))) {
-				/* DBI fault - detect for AC test */
-				lr->failed_dbi[pc] |= BIT(byte);
-				lr->fails_in_byte[pc][byte] -= 8;
-			}
-
-			/* ECC */
-			if (!!(lr->failed_dm[pc] & BIT(byte))) {
-				lr->fails_in_byte[pc][byte]++;
-				repair_code[pc][byte] = REPAIR_CODE_DM;
-			}
-
-			/* Data bit inversion */
-			if (!!(lr->failed_dbi[pc] & BIT(byte))) {
-				lr->fails_in_byte[pc][byte]++;
-				repair_code[pc][byte] = REPAIR_CODE_DBI;
-			}
-
-			/* more than one lane per byte, cannot repair */
-			if (lr->fails_in_byte[pc][byte] > REDUNDENT_BYTE_PAIR_LANES)
-				return 1;
-		}
-
-		/* Check result of byte pair */
-		for (byte = 0; byte < BYTES_PER_PC; byte += 2) {
-			/* more than one lane per byte pair */
-			if (lr->fails_in_byte[pc][byte] +
-			    lr->fails_in_byte[pc][byte + 1] > REDUNDENT_BYTE_PAIR_LANES)
-				return 1;
-
-			/* mark repair in adjacent byte */
-			if (lr->fails_in_byte[pc][byte])
-				repair_code[pc][byte + 1] = REPAIR_CODE_ADJ;
-
-			if (lr->fails_in_byte[pc][byte + 1])
-				repair_code[pc][byte] = REPAIR_CODE_ADJ;
-		}
-	}
-
-	/* AWORD: Check whether repairable and create repair vector */
-	if (dev_fail->unrep_aw)  /* Failures in unrepairable pins */
-		return 1;
-
-	repair_code_c = lr->aw_code & 0xf;
-	repair_code_r = (lr->aw_code >> 4) & 0xf;
-
-	/* Check if we already fixed this bus */
-	if (repair_code_c < REPAIR_CODE_NONE)
-		fails_in_cbus = 1;
-
-	/* Check result of current C bus */
-	for (bit = 0; bit < CBUS_LANES_NUM; bit++) {
-		if (!(lr->failed_c & BIT(bit)))
-			continue;
-
-		fails_in_cbus++;
-		repair_code_c = bit;
-	}
-
-	if (fails_in_cbus > REDUNDENT_CBUS_LANES)
-		return 1;
-
-	/* Check if we already fixed this bus */
-	if (repair_code_r < REPAIR_CODE_NONE)
-		fails_in_rbus = 1;
-
-	/* Check result of current R bus */
-	for (bit = 0; bit < RBUS_LANES_NUM; bit++) {
-		if (!(lr->failed_r & BIT(bit)))
-			continue;
-
-		fails_in_rbus++;
-		repair_code_r = bit;
-	}
-
-	if (fails_in_rbus > REDUNDENT_RBUS_LANES)
-		return 1;
-
-	/* Convert back the repair code arrays */
-	for (pc = 0; pc < PC_PER_CH; pc++) {
-		dw_code = pc ? &lr->dw23_code : &lr->dw01_code;
-
-		*dw_code = 0;
-		for (byte = 0; byte < BYTES_PER_PC; byte++)
-			*dw_code |= repair_code[pc][byte] << (byte * 4);
-	}
-
-	lr->aw_code = repair_code_c | (repair_code_r << 4);
-
-	lane_update_hbm(device, ch);
-	lane_update_phy(device, ch);
-
-	/* Since soft repair is an iterative process, reset handled failures to
-	 * prevent redudant repair attempts.
-	 */
-	lr_reset_failures(lr, false);
-
-	return 0;
-}
-
-#define DM_MISMATCH_REG		0x12c
-#define DM_EXPECTED_REG		0x128
-#define DM_BIT_GROUP_SIZE	4
-#define DM_BIT_GROUP_COUNT	2
-
-const static int dm_bit[DM_BIT_GROUP_COUNT][DM_BIT_GROUP_SIZE] = {
-	{ 0, 4, 16, 20 },
-	{ 8, 12, 24, 28 }
-};
-
-static u8 calc_dm_bit(u32 flipped, int dm_idx)
-{
-	int bit, nibble;
-	u8 res = 0;
-
-	for (bit = 0; bit < DM_BIT_GROUP_SIZE; bit++)
-		for (nibble = 0; nibble < DM_BIT_GROUP_COUNT; nibble++)
-			if (!!(flipped & BIT(dm_bit[nibble][bit] + dm_idx)))
-				res |= BIT(dm_idx + nibble * BITS_PER_NIBBLE);
-
-	return res;
-}
-
-struct failed_dq_reg {
-	u32 mismatch_reg;
-	u32 expected_reg;
-	int shift_res;
-};
-
-const static struct failed_dq_reg failed_dq_reg[] = {
-	{ 0x16c, 0x14c, 0 },  /*   0 ..  31 */
-	{ 0x168, 0x148, 0 },  /*  32 ..  63 */
-	{ 0x15c, 0x13c, 0 },  /* 128 .. 159 */
-	{ 0x158, 0x138, 0 },  /* 160 .. 191 */
-	{ 0x164, 0x144, 32 }, /*  64 ..  95 */
-	{ 0x160, 0x140, 32 }, /*  96 .. 128 */
-	{ 0x154, 0x134, 32 }, /* 192 .. 223 */
-	{ 0x150, 0x130, 32 }, /* 224 .. 255 */
-};
-
-static int hbm_channel_ac_test_repair(int device, int ch)
-{
-	struct hbm *hbm = &hbm_data;
-	struct ch_lane_repair_info *lr = &lr_info[device][ch];
-	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-	u32 status = RREG32(base + ch * 0x1000 + 0x11C);
-	u32 mismatch, expected, flipped;
-	int pc, i;
-
-	if (hbm->lane_repair_iter[device] == MAX_LANE_REPAIR_ITERATIONS)
-		return 1;
-
-	hbm->lane_repair_iter[device]++;
-
-	for (pc = 0; pc < PC_PER_CH; pc++) {
-		if (!!(status & BIT(24 + pc))) /* No failures */
-			continue;
-
-		/* Select pseudo channel */
-		RMWREG32(base + ch * 0x1000 + 0x100, pc, BIT(5));
-
-		/* Gather mismatched bits */
-		for (i = 0; i < ARRAY_SIZE(failed_dq_reg); i++) {
-			mismatch = RREG32(base + ch * 0x1000 +
-					  failed_dq_reg[i].mismatch_reg);
-			expected = RREG32(base + ch * 0x1000 +
-					  failed_dq_reg[i].expected_reg);
-			flipped = mismatch ^ expected;
-			lr->failed_dq[pc] |= ((u64)flipped) <<
-				failed_dq_reg[i].shift_res;
-		}
-
-		mismatch = RREG32(base + ch * 0x1000 + DM_MISMATCH_REG);
-		expected = RREG32(base + ch * 0x1000 + DM_EXPECTED_REG);
-		flipped = mismatch ^ expected;
-		for (i = 0; i < BITS_PER_NIBBLE; i++)
-			lr->failed_dm[pc] |= calc_dm_bit(flipped, i);
-	}
-
-	return hbm_channel_lane_repair(device, ch);
-}
-
-static int mcbist_err_restart_next_row(int sid, int dev, int ch, u32 status,
-				       struct mcbist_err_row_addr *row_err)
-{
-	u32 base = GAUDI_HBM_CFG_BASE + dev * GAUDI_HBM_CFG_OFFSET;
-	struct mcbist_err_start_addr naddr;
-	int started = 0;
-	int pc;
-
-	for (pc = 0; pc < PC_PER_CH; pc++) {
-		if (!!(status & BIT(0 + pc)))
-			continue;
-
-		if (!!(status & BIT(24 + pc)))
-			continue; /* Test pass on PC */
-
-		/* Select pseudo channel */
-		RMWREG32(base + ch * 0x1000 + 0x100, pc, BIT(5));
-
-		/* Read failed addess */
-		row_err[pc].addr.val = RREG32(base + ch * 0x1000 + 0x124);
-		row_err[pc].is_error = true;
-
-		/* Restart from the beginning of the next row */
-		naddr = row_err[pc].addr;
-		naddr.col = 0;
-		if (!++naddr.row)			/* Final row */
-			if (!++naddr.bank)		/* Final bank */
-				if (!++naddr.bg)	/* Final bank group */
-					continue;	/* Last row */
-
-		/* Set start address to next row */
-		WREG32(base + ch * 0x1000 + 0x104,
-		       naddr.val | sid << 28 | sid << 29);
-
-		/* Start BIST on specific PC */
-		WREG32(base + ch * 0x1000 + 0x11C, BIT(pc));
-		started++;
-	}
-
-	return !started;
-}
-
-static int hbm_dma_ch_to_map_ch(int dev, int dma_ch)
-{
-	int ret = 0;
-	/* mapping from PC in bus to mapped phy channel */
-	int dma_ch_to_map_ch[GAUDI_HBM_CHANNELS] = {
-		4, 5, 6, 7, 0, 1, 2, 3,
-	};
-
-	if ((dma_ch >= 0 && dma_ch < GAUDI_HBM_CHANNELS) &&
-	    (dev >= 0 && dev < GAUDI_HBM_DEVICES)) {
-		if (dev == 1 || dev == 2)
-			ret = dma_ch_to_map_ch[dma_ch];
-		else
-			ret = dma_ch;
-	} else {
-		preboot_puts("hbm_pc: Illegal input");
-		return -1;
-	}
-
-	return ret;
-}
-
-#define HBM_SID_BITMASK			0x1
-#define HBM_ROW_REP_WAIT_TIME		1000
-#define HBM_ROW_SOFT_REP_DQ_BIT		18
-#define HBM_ROW_SOFT_REP_SID_BIT	19
-#define HBM_ROW_SOFT_REP_EN_BIT		20
-
-void gaudi_hbm_row_repair(int dev, int dma_pc, int sid, u32 bank, u32 page)
-{
-	u32 write_wdr_addr, base, hbm_ch, row;
-	int ch;
-
-	if (dma_pc < 0 || dma_pc >= (GAUDI_HBM_CHANNELS * PC_PER_CH)) {
-		preboot_puts("ERROR : hbm_row_repair: Illegal pc value\n");
-		return;
-	}
-
-	if (dev < 0 || dev >= GAUDI_HBM_DEVICES) {
-		preboot_puts("ERROR : hbm_row_repair: Illegal HBM device\n");
-		return;
-	}
-
-	row = bank << 14 | page;
-
-	if (dma_pc % 2)
-		row = row | BIT(HBM_ROW_SOFT_REP_DQ_BIT);
-	else
-		row = row & ~BIT(HBM_ROW_SOFT_REP_DQ_BIT);
-
-	if (sid)
-		row = row | BIT(HBM_ROW_SOFT_REP_SID_BIT);
-	else
-		row = row & ~BIT(HBM_ROW_SOFT_REP_SID_BIT);
-
-	row = row | BIT(HBM_ROW_SOFT_REP_EN_BIT);
-	base = GAUDI_HBM_CFG_BASE + dev * GAUDI_HBM_CFG_OFFSET;
-	write_wdr_addr = base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) + 0x100;
-	ch = hbm_dma_ch_to_map_ch(dev, (dma_pc / 2));
-	hbm_ch = hbm_ch_mapping[ch];
-
-	/* enter self refresh */
-	RMWREG32(base + 0x4, 1, 1 << 16);
-	WREG32(write_wdr_addr, row);
-	ieee1500_inst(dev, hbm_ch, ieee1500_soft_repair, EXTEST_WRITE_INST);
-
-	/*
-	 * WRCK is ~44ns. So the minimal delay is 44*300 = 13.5usec.
-	 * See MCBIST samsung doc page 21. increase to 1msec for safety.
-	 */
-	udelay(HBM_ROW_REP_WAIT_TIME);
-
-	/* Exit self refresh */
-	RMWREG32(base + 0x4, 1, 1 << 17);
-
-	/* WRSTN assert */
-	RMWREG32(base + GAUDI_HBM_CENTER_CHANNEL * 0x1000 + 0x14, 0x0, 0x1);
-}
-
-static int hbm_pc_row_repair(int sid, int device, int ch, int pc,
-			     struct mcbist_err_start_addr addr)
-{
-	int dma_ch;
-	struct hbm *hbm = &hbm_data;
-
-	preboot_puts("perform row repair");
-
-	if (hbm->row_replacement_iter[device] == MAX_ROW_REPLACEMENT_ITERATIONS) {
-		preboot_puts("Max row replacement iteration reached\n");
-		return 1;
-	}
-
-	hbm->row_replacement_iter[device]++;
-
-	/* same function is used also for conversion from mapped-ch(phy) to dma-ch */
-	dma_ch = hbm_dma_ch_to_map_ch(device, ch);
-
-	gaudi_hbm_row_repair(device, (dma_ch * 2) + 1, sid,
-			     (addr.bg << 2) | addr.bank, addr.row);
-
-	return 0;
-}
-
-static int hbm_channel_row_repair(int sid, int device, int ch,
-				  struct mcbist_err_row_addr row_err[])
-{
-	int err;
-	int pc;
-
-	for (pc = 0; pc < PC_PER_CH; pc++) {
-		if (!row_err[pc].is_error)
-			continue;
-
-		err = hbm_pc_row_repair(sid, device, ch, pc, row_err[pc].addr);
-		if (err)
-			return err;
-	}
-
-	return 0;
-}
-
-#define MCBIST_CH_MAX_RETRIES	2
-
-/*
- * Return 0 if successful, -1 for failure, and 1 for re-run AC test.
- */
-static int mcbist_poll(int sid, int dev, bool is_repair)
-{
-	struct mcbist_err_row_addr row_err[PC_PER_CH];
-	int err, ch, rc = 0, retry;
-
-	u32 base, status;
-
-	base = GAUDI_HBM_CFG_BASE + dev * GAUDI_HBM_CFG_OFFSET;
-
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-		memset(row_err, 0, sizeof(row_err));
-
-		for (retry = 0; retry < MCBIST_CH_MAX_RETRIES; retry++) {
-			if (retry > 0) {
-				err = mcbist_err_restart_next_row(sid, dev, ch,
-								  status,
-								  row_err);
-				/* Failed to restart MCBIST, this may happen in
-				 * the rare case where the failed row is also
-				 * the last row. We should attempt row
-				 * replacement.
-				 */
-				if (err) {
-					err = 0;
-					break;
-				}
-			}
-
-			err = hbm_poll_timeout(base + ch * 0x1000 + 0x11C, 0x03000000,
-				       GAUDI_HBM_ECC_CFG_TIMEOUT_US, &status);
-			if (!err)
-				break;
-
-			if (!is_repair) {
-				rc = -1;
-				break;
-			}
-		}
-
-		if ((!retry && !err) || !is_repair)
-			continue;
-
-		rc = 1; /* Run AC test again */
-
-		/* In case that MCBIST failed after retry suggest a lane issue,
-		 * while single failure may suggest row issue.
-		 */
-		if (err)
-			err = hbm_channel_ac_test_repair(dev, ch);
-		else
-			err = hbm_channel_row_repair(sid, dev, ch, row_err);
-
-		if (err) {
-			is_repair = false; /* Don't attempt to repair others */
-			rc = -1;
-		}
-	}
-
-	return rc;
-}
-
-static int mcbist_write_read_full(struct hbm *hbm, int unused, bool is_repair)
-{
-	int device, ch, sid, err, acc_err = 0;
-	u32 base, pseudo_rand = 0x1, interleave = 0x0;
-	enum mc_bist_mode bist_mode = mc_bist_mode_once;
-
-	/* Clean transition from Functional mode to MCBIST mode */
-	for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
-		base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-		for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-			config_mlb_state(base, ch, phy_state_initial);
-			config_mc_state(hbm, device, ch, mc_state_bist);
-			config_mlb_state(base, ch, phy_state_bypass);
-		}
-	}
-
-	for (sid = 0; sid < 2; sid++) {
-		/* Configure MCBIST for all channels */
-		for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
-			base = GAUDI_HBM_CFG_BASE +
-					device * GAUDI_HBM_CFG_OFFSET;
-
-			for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-				WREG32(base + ch * 0x1000 + 0x100, pseudo_rand |
-						(interleave << 1) |
-						(bist_mode << 2) |
-						(hbm->ecc_enable  << 3));
-				WREG32(base + ch * 0x1000 + 0x104,
-						(0x0 | sid << 28 | sid << 29));
-				WREG32(base + ch * 0x1000 + 0x108, 0x800000);
-				WREG32(base + ch * 0x1000 + 0x10c, 0x12345678);
-				WREG32(base + ch * 0x1000 + 0x110, 0x9ABCDEF0);
-				WREG32(base + ch * 0x1000 + 0x114, 0x5A5A5A5A);
-				WREG32(base + ch * 0x1000 + 0x118, 0xA5A5A5A5);
-			}
-		}
-
-		/* Start MCBIST */
-		for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
-			base = GAUDI_HBM_CFG_BASE +
-					device * GAUDI_HBM_CFG_OFFSET;
-
-			for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
-				WREG32(base + ch * 0x1000 + 0x11C, 0x3);
-		}
-
-		/* Poll for MCBIST completion */
-		for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
-			err = mcbist_poll(sid, device, is_repair);
-			if (err && acc_err >= 0)
-				acc_err = err;
-		}
-
-		if (acc_err)
-			break;
-	}
-
-	/* Clean transition from MCBIST mode to Functional mode */
-	for (device = 0; device < GAUDI_HBM_DEVICES; device++) {
-		base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-		for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-			config_mlb_state(base, ch, phy_state_initial);
-			config_mc_state(hbm, device, ch, mc_state_normal);
-			config_mlb_state(base, ch, phy_state_bypass);
-		}
-	}
-
-	return acc_err;
-}
-
-static int do_loopback(struct hbm *hbm, u32 base, int ch,
-			enum loopback_state state)
-{
-	int i, j = ch * 16/*, cnt = 0*/;
-	u32 val;
-
-	if (state == loopback_state_initial) {
-		/* Internal Loopback mode */
-		RMWREG32(base + ch * 0x1000 + 0x370, 3, 0xFF);
-		for (i = 0; i < 16; i++)
-			WREG32(base + ch * 0x1000 + 0x380 + i * 4,
-					hbm_golden_registers[i + j]);
-		return 0;
-	}
-
-	if (state != loopback_state_check)
-		return -1;
-
-	WREG32(base + ch * 0x1000 + 0x294, 1);
-	WREG32(base + ch * 0x1000 + 0x294, 0);
-
-	RMWREG32(base + ch * 0x1000 + 0x378, 0xF, 0xFF);
-	RMWREG32(base + ch * 0x1000 + 0x374, 0xF, 0xFF);
-
-	val = RREG32(base + ch * 0x1000 + 0x37C);
-	if (val)
-		return -1;
-
-	return 0;
-}
-
-static int internal_loopback_test(struct hbm *hbm, int device)
-{
-	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-	int ch, dw;
-
-	/* Add delay from previous SRX */
-	udelay(1);
-
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-		/* SRE */
-		WREG32(base + ch * 0x1000 + 0x214, 2);
-		/* ILB ctrl_rddv_sel */
-		WREG32(base + ch * 0x1000 + 0x298, 5);
-		/* Reset read FIFO */
-		WREG32(base + ch * 0x1000 + 0x294, 1);
-		WREG32(base + ch * 0x1000 + 0x294, 0);
-
-		do_loopback(hbm, base, ch, loopback_state_initial);
-
-		for (dw = 0; dw < 4; dw++)
-			set_dword_read_dll(base, ch, dw, 0);
-
-		for (dw = 0; dw < 4; dw++)
-			set_dword_write_dll(base, ch, dw, 0x50);
-
-		if (do_loopback(hbm, base, ch, loopback_state_check))
-			return 1;
-
-		WREG32(base + ch * 0x1000 + 0x378, 0);
-		WREG32(base + ch * 0x1000 + 0x370, 0);
-		/* functional ctrl_rddv_sel */
-		WREG32(base + ch * 0x1000 + 0x298, 4);
-		/* SRX */
-		WREG32(base + ch * 0x1000 + 0x214, 1);
-	}
-
-	return 0;
-}
-
-static void acc_training(struct hbm *hbm, int device)
-{
-	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-	u32 dll_inc, status;
-	int ch, dw, err;
-
-	if (hbm->inc == 16)
-		dll_inc = 3;
-	else if (hbm->inc == 4)
-		dll_inc = 2;
-	else
-		dll_inc = 1;
-
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-		for (dw = 0; dw < 5; dw++)
-			set_acc_dll(base, ch, dw, hbm->acc_initial);
-
-		WREG32(base + ch * 0x1000 + 0x444,
-				(hbm->training_delay << 8) | dll_inc);
-	}
-
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch += 2) {
-		WREG32(base + ch * 0x1000 + 0x440, 0x1F);
-		WREG32(base + (ch + 1) * 0x1000 + 0x440, 0xF);
-	}
-
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-		err = hbm_poll_timeout(base + ch * 0x1000 + 0x440, 0,
-				       GAUDI_HBM_CFG_TIMEOUT_US, &status);
-		if (err) {
-			preboot_puts("ACC done polling failed\n");
-			return;
-		}
-	}
-
-	copy_acc(base);
-
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-		if (!aword_acc_window(base, ch))
-			preboot_puts("aword acc_window can't be 0\n");
-
-		for (dw = 0; dw < 4; dw++)
-			if (!dword_acc_window(base, ch, dw))
-				preboot_puts("dword acc_window can't be 0\n");
-	}
-}
-
-static void check_training_result(struct hbm *hbm, int dev)
-{
-	int ch, dw, min_window_size = 50; /* percentage of UI */
-
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-		for (dw = 0; dw < 5; dw++)
-			if (acc[ch][dw] <= hbm->acc_initial)
-				preboot_puts("HBM err: ACC UI size not obtained\n");
-
-		if (aword[ch][1] == 0 || aword[ch][2] == 0 ||
-			aword[ch][3] < ((acc[ch][0] * min_window_size) / 100))
-			preboot_puts("HBM err: valid AWORD window not found\n");
-
-		for (dw = 0; dw < 4; dw++) {
-			if (dword_wr[ch][dw][2] == 0 ||
-			    dword_wr[ch][dw][3] < ((acc[ch][dw + 1] * min_window_size) / 100))
-				preboot_puts("HBM err: valid DWORD Write window not found\n");
-
-			if (dword_rd[ch][dw][2] == 0 ||
-			    dword_rd[ch][dw][3] < ((acc[ch][dw + 1] * min_window_size) / 100))
-				preboot_puts("HBM err: valid DWORD Read window not found\n");
-		}
-	}
-}
-
-static void phy_init(int device)
-{
-	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-	u32 ctrl_rddv_sel = 4;
-	u32 rdatvld_dly;
-	u32 dev_id = preboot_device_id_get();
-	int ch;
-
-	for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++) {
-		switch (dev_id) {
-		case PCI_IDS_GAUDI_HL2000M:
-		case PCI_IDS_GAUDI_HL2000M_SEC:
-			if (ch == 0 || ch == 4) {
-				/* Release PHY RSTN (set bit 1) */
-				RMWREG32(base + ch * 0x1000 + 0x284, 1, 0x2);
-				mdelay(1);
-
-				/* non-deskew PLL settings 2Gbps */
-				WREG32(base + ch * 0x1000 + 0x2B8, 0x19180F3F);
-				WREG32(base + ch * 0x1000 + 0x2BC, 0x0000001B);
-
-				/* Release PLL power-down (clear bit 0) */
-				RMWREG32(base + ch * 0x1000 + 0x284, 0, 0x1);
-				mdelay(1);
-
-				/* Release PLL clock divider rstn */
-				WREG32(base + ch * 0x1000 + 0x288, 0x0000001);
-				mdelay(1);
-
-				/* Release PLL stable_n (clear bit 7) */
-				RMWREG32(base + ch * 0x1000 + 0x284, 0, 0x80);
-				mdelay(1);
-			}
-
-			/* Release MLB & PHASE FIFO RSTN (set bit 7) */
-			RMWREG32(base + ch * 0x1000 + 0x174, 1, 0x80);
-			mdelay(1);
-			/* PHASE FIFO start (set bit 15) */
-			RMWREG32(base + ch * 0x1000 + 0x174, 1, 0x8000);
-
-			if (ch == 0 || ch == 4) {
-				/* Release DLL power-down */
-				WREG32(base + ch * 0x1000 + 0x28C, 0x0000000);
-				mdelay(1);
-
-				/* Drive strength */
-				WREG32(base + ch * 0x1000 + 0x2A0, 0x681F0);
-				WREG32(base + ch * 0x1000 + 0x2A4, 0x6A1F0);
-			}
-			break;
-		default:
-			if (ch == 0 || ch == 4) {
-				/* PLL settings */
-				WREG32(base + ch * 0x1000 + 0x2B8, 0x0CD80303);
-				WREG32(base + ch * 0x1000 + 0x2BC, 0x0000001E);
-
-				/* PLL and DLL power up */
-				RMWREG32(base + ch * 0x1000 + 0x288, 0x1, 0x1);
-				mdelay(1);
-				RMWREG32(base + ch * 0x1000 + 0x284, 0x0, 0x1);
-				mdelay(1);
-				RMWREG32(base + ch * 0x1000 + 0x28C, 0x0, 0x1);
-				mdelay(1);
-
-				/* Drive strength */
-				WREG32(base + ch * 0x1000 + 0x2A0, 0x681F0);
-				WREG32(base + ch * 0x1000 + 0x2A4, 0x6A1F0);
-			}
-		}
-
-		/* Reset read FIFO */
-		RMWREG32(base + ch * 0x1000 + 0x294, 0x1, 0x1);
-		RMWREG32(base + ch * 0x1000 + 0x294, 0x0, 0x1);
-
-		/* DFI setting - PHY */
-		WREG32(base + ch * 0x1000 + 0x208, 0x140106);
-
-		/* DFI setting - MC:
-		 * r_t_rddata_en=0x15, r_t_phy_wrlat=0x6, r_t_phy_wrdata=0x1,
-		 * r_rrq_switch_lvl_low=0x0. TODO: remove later
-		 */
-		WREG32(base + (ch * 0x1000) + 0x054, 0x10615);
-
-		/* trfc_sb_fix=152, r_r2w = 18 to support PL=2
-		 * TODO: remove later
-		 */
-		WREG32(base + (ch * 0x1000) + 0x04C, 0xA0030812);
-
-		/* ctrl_rddv_sel */
-		WREG32(base + ch * 0x1000 + 0x298, ctrl_rddv_sel);
-
-		/* Enable HBM CK, set PL=0, set rdatvld_dly */
-		if ((dev_id != PCI_IDS_GAUDI_HL2000M) && (dev_id != PCI_IDS_GAUDI_HL2000M_SEC))
-			rdatvld_dly = ctrl_rddv_sel + 8;
-		else
-			rdatvld_dly = ctrl_rddv_sel + 10;
-
-		if (ch == 0 || ch == 1 || ch == 4 || ch == 5)
-			WREG32(base + ch * 0x1000 + 0x204,
-					0x1 | (rdatvld_dly << 16));
-		else if (ch == 2 || ch == 3 || ch == 6 || ch == 7)
-			WREG32(base + ch * 0x1000 + 0x204,
-					0x1 | ((rdatvld_dly + 1) << 16));
-
-		/* Enable ECC. TODO: remove later */
-		WREG32(base + (ch * 0x1000) + 0x000, 0x413000);
-	}
-}
