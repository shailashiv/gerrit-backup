+
+__weak void preboot_security_sp_sram_write_key_idx(u32 *key_idx) {}
+
+static u32 preboot_key_idx;
+
+static int fit_get_pub_key(const void *fit, int noffset, int sig_sub_node,
+			   const void **pub_key_fit, enum fit_sec_failure *res)
+{
+	int node, key_len, pub_key_node;
+	const void *key_ext_data = NULL;
+	const void *key_data;
+	const char *key_name;
+	int key_ext_len = 0;
+
+	node = fit_pub_key_node_get(fit, noffset);
+	if (node < 0) {
+		preboot_puts("Wrong FIT format missing pubkey\n");
+		return 1;
+	}
+
+	key_data = fdt_getprop(fit, node, FIT_DATA_PROP, &key_len);
+	if (!key_data) {
+		preboot_puts("Wrong FIT format: missing pubkey fit\n");
+		return 1;
+	}
+
+	preboot_key_idx = fit_get_int(fit, 0, FIT_SEC_KEY_IDX, -1);
+	if (preboot_key_idx < 0) {
+		preboot_puts("Wrong FIT format: missing key idx\n");
+		return 1;
+	}
+
+	*pub_key_fit = key_data;
+	if (!preboot_security_key_montgomery_is_valid())
+		goto key_validation;
+
+	/* Get modulus from public key */
+	if (fdt_check_header(*pub_key_fit)) {
+		preboot_puts("FITkey header check failed\n");
+		return 1;
+	}
+
+	if (get_key_name(fit, sig_sub_node, &key_name))
+		return 1;
+
+	pub_key_node = get_pub_key_node(*pub_key_fit, key_name);
+	if (pub_key_node < 0) {
+		preboot_puts("Wrong FITkey format: no key node\n");
+		return 1;
+	}
+
+	/* Update key data and key length with 384 bytes modulus */
+	key_data = fdt_getprop(*pub_key_fit, pub_key_node,
+			"rsa,modulus", &key_len);
+
+	/* Get montgomery from public key extension */
+	node = fit_pub_key_ext_node_get(fit, noffset);
+	if (node < 0) {
+		preboot_puts("Wrong FIT format missing ext pubkey\n");
+		return 1;
+	}
+
+	key_ext_data = fdt_getprop(fit, node, FIT_DATA_PROP,
+			&key_ext_len);
+	if (!key_ext_data) {
+		preboot_puts("Wrong FIT format: missing ext pubkey fit\n");
+		return 1;
+	}
+
+key_validation:
+	if (preboot_security_key_is_revoked(preboot_key_idx)) {
+		preboot_puts_hex("Key revoked: ", preboot_key_idx, false);
+		*res = FIT_SEC_KEY_REVOKED;
+		return 1;
+	}
+
+	if (!preboot_security_key_is_valid(preboot_key_idx, key_data, key_len,
+				key_ext_data, key_ext_len)) {
+		preboot_puts("Key validation failed\n");
+		*res = FIT_SEC_SIGN_FAILED;
+		return 1;
+	}
+
+	return 0;
+}
+
+static bool fit_svn_is_valid(const void *fit)
+{
+	int sec_ver;
+
+	sec_ver = fit_get_int(fit, 0, FIT_SEC_VERSION, -1);
+	if (sec_ver < 0) {
+		preboot_puts("Wrong FIT format: missing security version\n");
+		return false;
+	}
+
+	return preboot_security_svn_is_valid(sec_ver);
+}
+
+static int fit_verify_config_regions(const void *fit,
+				     struct fdt_region *fdt_regions,
+				     int count, int sig_sub_node,
+				     const void *pub_key_fit)
+{
+	fit_region_make_list(fit, fdt_regions, count, region);
+
+	return fit_config_check_sig(fit, sig_sub_node, region, count,
+				    pub_key_fit);
+}
+
+/* Checks the signed FIT and validate it againts the public key */
+static int fit_verify_config(const void *fit, int noffset,
+			     enum fit_sec_failure *res)
+{
+	int sig_sub_node;
+	const char *hashed_node_prop;
+	int count, err;
+	char *node_inc[IMAGE_MAX_HASHED_NODES];
+	char * const exc_prop[] = { FIT_DATA_PROP };
+	char path[FIT_MAX_PATH];
+	const uint32_t *strings;
+	const void *pub_key_fit;
+
+	sig_sub_node = fdt_subnode_offset(fit, noffset, FIT_SIG_NODENAME);
+	if (sig_sub_node < 0) {
+		preboot_puts("Wrong FIT format: missing signature\n");
+		return 1;
+	}
+
+	if (fit_get_pub_key(fit, noffset, sig_sub_node, &pub_key_fit, res))
+		return 1;
+
+	hashed_node_prop = fit_get_hashed_nodes(fit, sig_sub_node, &count,
+						node_inc);
+	if (!hashed_node_prop)
+		return 1;
+
+	/* Get a list of regions to hash */
+	count = fdt_find_regions(fit, node_inc, count, exc_prop,
+				 ARRAY_SIZE(exc_prop), fdt_regions,
+				 MAX_FDT_REGIONS - 1, path, sizeof(path), 0);
+
+	if ((count <= 0) || (count >= MAX_FDT_REGIONS - 1)) {
+		preboot_puts_hex("FIT: bad regions count: ", count, 0);
+		return 1;
+	}
+
+	/* Add the strings */
+	strings = fdt_getprop(fit, sig_sub_node, "hashed-strings", NULL);
+	if (strings) {
+		fdt_regions[count].offset = fdt_off_dt_strings(fit);
+		fdt_regions[count].size = fdt32_to_cpu(strings[1]);
+		count++;
+	}
+
+	err = fit_verify_config_regions(fit, fdt_regions, count, sig_sub_node,
+					pub_key_fit);
+	if (err) {
+		*res = FIT_SEC_SIGN_FAILED;
+		return err;
+	}
+
+	return 0;
+}
+
+static int fit_verify_security(const void *fit, int noffset,
+			       enum fit_sec_failure *res)
+{
+	if (!preboot_security_is_enabled())
+		return 0;
+
+	if (!fit_svn_is_valid(fit)) {
+		*res = FIT_SEC_SVN_INVALID;
+		return 1;
+	}
+
+	/* Security in enabled and SV is valid all thats left is to check the
+	 * signature on the FIT.
+	 */
+	return fit_verify_config(fit, noffset, res);
+}
+
+static int fit_getprop_u64(const void *fit, int node, const char *name,
+			   u64 *val64)
+{
+	const u32 *val32;
+	int len;
+
+	val32 = fdt_getprop(fit, node, name, &len);
+	if (!val32 || len != sizeof(u64))
+		return 1;
+
+	*val64 = ((u64)fdt32_to_cpu(val32[0])) << 32;
+	*val64 |= fdt32_to_cpu(val32[1]);
+	return 0;
+}
+
+int fit_init_resp(void *fit, size_t sz)
+{
+	int err;
+
+	err = fdt_create(fit, sz);
+	if (err)
+		return err;
+
+	err = fdt_finish_reservemap(fit);
+	if (err)
+		return err;
+
+	err = fdt_begin_node(fit, "");
+	if (err)
+		return err;
+
+	return 0;
+}
+
+int fit_fin_resp(void *fit, unsigned int *res_size)
+{
+	int err;
+
+	if (!fdt_size_dt_strings(fit)) {
+		*res_size = 0;
+		return 0; /* Empty response */
+	}
+
+	err = fdt_end_node(fit);
+	if (err)
+		return err;
+
+	err = fdt_finish(fit);
+	if (err)
+		return err;
+
+	*res_size = fdt_totalsize(fit);
+
+	return err;
+}
+
+static int fit_copy_image(u64 dst, const void *buf, int len, const char *arch,
+			  const char *cmpr)
+{
+	preboot_puts_raw("FIT loadaddr: 0x");
+	if (sizeof(void *) > sizeof(u32))
+		preboot_puth_raw((u32)(dst >> 32), false);
+	preboot_puth((u32)dst, false);
+
+	if (!strcmp(cmpr, "none")) {
+		preboot_copy_image(dst, buf, len, arch);
+		return 0;
+	}
+
+	return preboot_decompress_image(dst, buf, len, arch, cmpr);
+}
+
+static bool fit_load_is_runnable(const void *fit, int conf)
+{
+	const u32 *cell;
+	u32 type;
+	int len;
+
+	cell = fdt_getprop(fit, conf, FIT_LOAD_TYPE_PROP, &len);
+
+	/* If load type does not exists, assume it's u-boot */
+	if (!cell)
+		return true;
+
+	if (len != sizeof(*cell)) {
+		preboot_puts("Currupted load type\n");
+		return false;
+	}
+
+	type = fdt32_to_cpu(*cell);
+	if (type >= FIT_LOAD_TYPE_COUNT) {
+		preboot_puts_hex("Unsupported load type ", type, false);
+		return false;
+	}
+
+	return type == FIT_LOAD_TYPE_RUN;
+}
+
+static const u8 *fit_node_get_hash(const void *fit, int node)
+{
+	int hash;
+	const char *prop;
+
+	hash = fdt_subnode_offset(fit, node, FIT_HASH_PROP);
+	prop = (const char *)fdt_getprop(fit, hash, FIT_ALGO_PROP, NULL);
+	if (strcmp(prop, FIT_SHA256))
+		return NULL;
+
+	return (const u8 *)fdt_getprop(fit, hash, FIT_VALUE_PROP, NULL);
+}
+
+static int fit_node_check_hash(const void *fit, int node, const u8 *buf,
+			       int len)
+{
+	const u8 *node_hash = fit_node_get_hash(fit, node);
+	u8 calc_hash[SHA256_SUM_LEN];
+
+	if (!node_hash) {
+		preboot_puts("Missing hash for loadable\n");
+		return 1;
+	}
+
+	sha256_csum(buf, len, calc_hash);
+	if (memcmp(node_hash, calc_hash, SHA256_SUM_LEN))
+		return 1;
+
+	return 0;
+}
+
+__weak bool preboot_is_image_sig_supported(void)
+{
+	return false;
+}
+
+__weak int preboot_verify_img_sig(const void *fit, size_t img_size,
+				  enum fit_sec_failure *res, u32 *key_idx)
+{
+	return 1;
+}
+
+static int fit_verify_image(const void *fit, size_t fit_size, int conf,
+			    enum fit_sec_failure *res)
+{
+	/*
+	 * for platforms with image security descriptor support, the signature
+	 * of the descriptor is validated. otherwise the fit internal signature
+	 * is validated.
+	 */
+	if (!preboot_is_image_sig_supported())
+		return fit_verify_security(fit, conf, res);
+
+	return preboot_verify_img_sig(fit, fit_size, res, &preboot_key_idx);
+}
+
+static enum fit_load_result fit_copy_images(const void *fit,
+					    enum fit_sec_failure *res)
+{
+	int node, len, image_len;
+	int conf, num_images, i;
+	const u8 *buf;
+	u64 load, start;
+	const char *cmpr;
+	size_t fit_size = fdt_totalsize(fit);
+
+	/* Check if image supports a minimum FDT version or newer */
+	if (fdt_version(fit) < FDT_MIN_SUPPORTED_VERSION)
+		return FIT_LOAD_SEC_FAILED;
+
+	/* check that the calculated memory range are legal */
+	if (!preboot_sram_is_valid_address_range((uintptr_t)fit, fit_size))
+		return FIT_LOAD_SEC_FAILED;
+
+	/* Get number of images in preboot configuration */
+	conf = fit_find_config_node(fit);
+	if (conf < 0)
+		return FIT_LOAD_CORRUPTED;
+
+	if (!fit_load_is_runnable(fit, conf))
+		return FIT_LOAD_CORRUPTED;
+
+	if (fit_verify_image(fit, fit_size, conf, res))
+		return FIT_LOAD_SEC_FAILED;
+
+	if (fit_pub_key_value_node_get(fit))
+		return FIT_LOAD_SEC_FAILED;
+
+	num_images = fdt_stringlist_count(fit, conf, FIT_LOADABLE_PROP);
+	if (num_images > FIT_MAX_IMAGES) {
+		preboot_puts_hex("Images in fit exceeds max limit: ",
+					FIT_MAX_IMAGES, false);
+		return FIT_LOAD_CORRUPTED;
+	} else if (num_images < 0) {
+		preboot_puts_hex("Cant read images from fit: ",
+					-num_images, false);
+		return FIT_LOAD_CORRUPTED;
+	}
+
+	for (i = 0; i < num_images; i++) {
+		node = fit_loadables_node_get(fit, i);
+		if (node < 0) {
+			preboot_puts_hex("Wrong FIT format: loadable image not found: ", i, false);
+			return FIT_LOAD_NOT_RUNNABLE;
+		}
+
+		if (fit_getprop_u64(fit, node, FIT_LOADADDR_PROP, &load)) {
+			preboot_puts_hex("Wrong FIT format: loadaddr not found for image: ", i, false);
+			return FIT_LOAD_BAD_LOAD_ADDR;
+		}
+		if (fit_getprop_u64(fit, node, FIT_STARTADDR_PROP, &start))
+			start = load;
+
+		buf = fdt_getprop(fit, node, FIT_DATA_PROP, &len);
+		if (!buf) {
+			preboot_puts_hex("Wrong FIT format: data empty for image: ", i, false);
+			return FIT_LOAD_CORRUPTED;
+		}
+
+		if (fit_node_check_hash(fit, node, buf, len)) {
+			preboot_puts_hex("FIT loadable currupted: bad hash for image: ", i, false);
+			return FIT_LOAD_CORRUPTED;
+		}
+
+		cmpr = (const char *)fdt_getprop(fit, node,
+						 FIT_COMPRESSION_PROP,
+						 NULL);
+		if (!cmpr) {
+			/*
+			 * mkimage is adding compression, if it's missing then
+			 * something is wrong.
+			 */
+			preboot_puts_hex("Wrong FIT format: missing compression: ", i, false);
+			return FIT_LOAD_CORRUPTED;
+		}
+
+		if (!strcmp(cmpr, "none"))
+			image_len = len;
+		else
+			image_len = len * COMPRESSION_FACTOR;
+
+		if (!preboot_is_valid_address_range(load, image_len)) {
+			preboot_puts_hex("FIT: invalid load address for image: ", i, false);
+			return FIT_LOAD_BAD_LOAD_ADDR;
+		}
+
+		images[i].arch = (const char *)fdt_getprop(fit, node,
+							FIT_ARCH_PROP, NULL);
+		if (!images[i].arch) {
+			preboot_puts_hex("Wrong FIT format: arch empty for image: ", i, false);
+			return FIT_LOAD_CORRUPTED;
+		}
+
+		images[i].loadaddr = load;
+		images[i].startaddr = start;
+
+		if (fit_copy_image(load, buf, len, images[i].arch, cmpr))
+			return FIT_LOAD_CORRUPTED;
+	}
+
+	preboot_security_sp_sram_write_key_idx(&preboot_key_idx);
+
+	return FIT_LOAD_SUCCESS;
+}
+
+static void fit_report_err(enum fit_load_result err,
+			   enum fit_sec_failure sec_res)
+{
+	enum hl_fw_fit_boot_error boot_err = HL_FW_FIT_BOOT_ERR_NONE;
+
+	switch (err) {
+	case FIT_LOAD_BAD_LOAD_ADDR:
+		boot_err = HL_FW_FIT_BOOT_ERR_ADDRESS_VIOLATION;
+		break;
+	case FIT_LOAD_NOT_RUNNABLE:
+		boot_err = HL_FW_FIT_BOOT_ERR_NOT_RUNNABLE;
+		break;
+	case FIT_LOAD_CORRUPTED:
+		boot_err = HL_FW_FIT_BOOT_ERR_CORRUPTED;
+		break;
+	case FIT_LOAD_SEC_FAILED:
+
+		switch (sec_res) {
+		case FIT_SEC_SVN_INVALID:
+			boot_err = HL_FW_FIT_BOOT_ERR_SVN;
+			break;
+		case FIT_SEC_KEY_REVOKED:
+			boot_err = HL_FW_FIT_BOOT_ERR_REVOKED_KEY;
+			break;
+		case FIT_SEC_SIGN_FAILED:
+			boot_err = HL_FW_FIT_BOOT_ERR_SIGNATURE;
+			break;
+		default:
+			break;
+		}
+
+		break;
+	default:
+		break;
+	};
+
+	i2csi_set_boot_err(boot_err, false);
+}
+
+static int fwupd_sec_convert_min_error(enum fit_sec_failure err)
+{
+	int serr;
+
+	switch (err) {
+	case FIT_SEC_KEY_REVOKED:
+		serr = HL_SEC_ERR_KEY_REVOKED;
+		break;
+	case FIT_SEC_SVN_INVALID:
+		serr = HL_SEC_ERR_SVN_INVALID;
+		break;
+	case FIT_SEC_SIGN_FAILED:
+		serr = HL_SEC_ERR_SIGN_FAILED;
+		break;
+	default:
+		serr = FIT_SEC_NONE;
+	};
+
+	return serr;
+}
+
+int fit_load_images(void *fit)
+{
+	enum fit_sec_failure sec_res = FIT_SEC_NONE;
+	int err;
+
+	memset(&images, 0x0, sizeof(images));
+
+	err = !fit_check_format(fit);
+	if (!err)
+		err = fit_copy_images(fit, &sec_res);
+
+	cpu_boot_err_clrset(CPU_BOOT_ERR0_FIT_CORRUPTED |
+			    CPU_BOOT_ERR0_SECURITY_FAIL, false);
+	switch (err) {
+	case FIT_LOAD_SUCCESS:
+		return 0;
+
+	case FIT_LOAD_BAD_LOAD_ADDR:
+	case FIT_LOAD_NOT_RUNNABLE:
+	case FIT_LOAD_CORRUPTED:
+		cpu_boot_err_clrset(CPU_BOOT_ERR0_FIT_CORRUPTED, true);
+		preboot_error_inform(HL_FW_ERR_FIT, err);
+		preboot_puts("FIT loading failed, Retrying...\n");
+		break;
+	case FIT_LOAD_SEC_FAILED:
+		cpu_boot_err_clrset(CPU_BOOT_ERR0_SECURITY_FAIL, true);
+		preboot_error_inform(HL_FW_ERR_SECURITY,
+				     fwupd_sec_convert_min_error(sec_res));
+		preboot_puts("FIT security validation failed, Retrying...\n");
+		break;
+	}
+
+	fit_report_err(err, sec_res);
+
+	return 1;
+}
+
+__weak void preboot_finalize_fw_info(void) {}
+__weak void preboot_finalize_rma_tables(void) {}
+__weak void preboot_finalize_fw_upd_closure(void) {}
+__weak void preboot_secondary_cpu_stop(void) {}
+
+void fit_run_image(void)
+{
+	u64 startaddr = 0;
+	u32 i;
+
+	for (i = 0; i < FIT_MAX_IMAGES; i++) {
+		if (strcmp(images[i].arch, "arm64"))
+			continue;
+
+		startaddr = images[i].startaddr;
+		break;
+	}
+
+	preboot_finalize_nic_en();
+	preboot_finalize_fw_info();
+	preboot_finalize_rma_tables();
+	preboot_finalize_fw_upd_closure();
+	preboot_finalize_enabled_caps();
+	preboot_secondary_cpu_stop();
+	boot_info_finalize();
+	preboot_start_image(startaddr);
+}
+
+__weak size_t preboot_get_img_sec_desc_size(void)
+{
+	return 0;
+}
+
+int fit_validate_size(const void *fit, int len)
+{
+	size_t img_size = ROUND_UP4(fdt_totalsize(fit));
+
+	if (fdt_check_header(fit)) {
+		preboot_puts("Bad FIT header\n");
+		return 1;
+	}
+
+	/* taking the security footer into account */
+	img_size += preboot_get_img_sec_desc_size();
+
+	return img_size != len;
+}
+
+int fit_get_load_type(const void *fit, u32 *load_type)
+{
+	const u32 *cell;
+	u32 type = FIT_LOAD_TYPE_RUN;
+	int ret, len, conf;
+
+	ret = fit_check_format(fit);
+	if (!ret)
+		return 1;
+
+	conf = fit_find_config_node(fit);
+	if (conf >= 0) {
+		cell = fdt_getprop(fit, conf, FIT_LOAD_TYPE_PROP, &len);
+		if (!cell) {
+			preboot_puts("load type does not exist!");
+			*load_type = type;
+			return 0;
+		}
+		if (len != sizeof(*cell)) {
+			preboot_puts("Currupted load type\n");
+			return 1;
+		}
+
+		type = fdt32_to_cpu(*cell);
+		if (type >= FIT_LOAD_TYPE_COUNT) {
+			preboot_puts_hex("Unsupported load type ", type, false);
+			return 1;
+		}
+	}
+
+	*load_type = type;
+
+	return 0;
+}
+
+static int fit_image_get_data(const void *fit, int noffset,
+		       const void **data, size_t *size)
+{
+	int len;
+
+	*data = fdt_getprop(fit, noffset, FIT_DATA_PROP, &len);
+	if (*data == NULL) {
+		*size = 0;
+		return -1;
+	}
+
+	*size = len;
+	return 0;
+}
+
+static int fit_image_get_node(const void *fit, const char *image_uname)
+{
+	int noffset, images_noffset;
+
+	images_noffset = fdt_path_offset(fit, FIT_IMAGES_PATH);
+	if (images_noffset < 0) {
+		preboot_puts("Can't find images parent node");
+		return images_noffset;
+	}
+
+	noffset = fdt_subnode_offset(fit, images_noffset, image_uname);
+	if (noffset < 0)
+		preboot_puts("Can't get node offset for image unit name");
+
+	return noffset;
+}
+
+static int fit_conf_get_prop_node_index(const void *fit, int noffset,
+				 const char *prop_name, int index)
+{
+	const char *uname;
+	int len;
+
+	/* get image unit name from configuration property */
+	uname = fdt_stringlist_get(fit, noffset, prop_name, index, &len);
+	if (uname == NULL)
+		return len;
+
+	return fit_image_get_node(fit, uname);
+}
+
+int fit_image_get_loadable_data(const void *fit, const void **data,
+				size_t size)
+{
+	size_t actual_size;
+	int err, node, conf;
+
+	conf = fit_find_config_node(fit);
+	if (conf < 0)
+		return 1;
+
+	node = fit_conf_get_prop_node_index(fit, conf, FIT_LOADABLE_PROP, 0);
+	if (node < 0)
+		return 1;
+
+	err = fit_image_get_data(fit, node, data, &actual_size);
+	if (err)
+		return err;
+
+	if (actual_size != size)
+		return 1;
+
+	return 0;
+}
+
+#define HL_SEC_REGIONS_CNT	2
+#define HL_SEC_KEY_NAME		"hl_rsa3072"
+
+int fit_verify_img_sig(const void *img, size_t img_size, const void *sec_desc,
+		       size_t sec_desc_size, const void *pub_key_fit,
+		       const u8 *sig, size_t sig_len)
+{
+	const char *key_name = HL_SEC_KEY_NAME;
+	struct rsa_key_prop prop;
+	struct image_region region[HL_SEC_REGIONS_CNT];
+
+	if (fit_get_key_prop(pub_key_fit, key_name, &prop))
+		return 1;
+
+	/*
+	 * region 0 holds the fit image as a whole,
+	 * region 1 holds the hl security descriptor
+	 */
+	region[0].data = img;
+	region[0].size = img_size;
+	region[1].data = sec_desc;
+	region[1].size = sec_desc_size;
+
+	return rsa_verify_regions(region, HL_SEC_REGIONS_CNT, sig, sig_len,
+				  &prop);
+}
