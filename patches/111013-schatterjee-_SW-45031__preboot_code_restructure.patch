diff --git a/arch/greco/arc/reset.c b/arch/greco/arc/reset.c
new file mode 100644
index 0000000..70a8aa8
--- /dev/null
+++ b/arch/greco/arc/reset.c
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright 2021 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <psoc_global_conf_regs.h>
+#include <psoc_global_conf_masks.h>
+
+#include <bitops.h>
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+
+#include "common.h"
+
+#define SW_ALL_RST_L_MSK		0xC00FF8FF
+#define SW_ALL_RST_M_MSK		0xFFFFFFFF
+#define SW_ALL_RST_H_MSK		0x7FFFFF
+
+static void greco_hw_fini(void)
+{
+	/* Restart BTL/BLR upon hard-reset */
+	regmap_writel(0x770, mmPSOC_GLOBAL_CONF_BOOT_SEQ_RE_START);
+
+	udelay(1000);
+
+	regmap_writel(SW_ALL_RST_L_MSK, mmPSOC_GLOBAL_CONF_SW_ALL_RST_CFG_L);
+	regmap_writel(SW_ALL_RST_M_MSK, mmPSOC_GLOBAL_CONF_SW_ALL_RST_CFG_M);
+	regmap_writel(SW_ALL_RST_H_MSK, mmPSOC_GLOBAL_CONF_SW_ALL_RST_CFG_H);
+
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_SW_ALL_RST);
+}
+
+void hl_dev_reset(void)
+{
+	hl_pcie_disable_access();
+
+	greco_hw_fini();
+	wfe();
+}
diff --git a/arch/greco/arc/security.c b/arch/greco/arc/security.c
new file mode 100644
index 0000000..4413e4b
--- /dev/null
+++ b/arch/greco/arc/security.c
@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2020 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <bitops.h>
+#include <preboot.h>
+#include <string.h>
+#include <uart.h>
+#include <sha256.h>
+#include <greco/greco_security.h>
+
+#include <psoc_arc0_mstr_if_core_hbw_regs.h>
+#include <psoc_arc0_mstr_if_core_lbw_regs.h>
+#include <psoc_arc1_mstr_if_core_hbw_regs.h>
+#include <psoc_arc1_mstr_if_core_lbw_regs.h>
+
+#define EN_ARC_SEC_PRIV				0x3
+#define EFUSE_SYSCFG_ENABLE_VALIDATION_MASK	BIT(10)
+
+void preboot_secure_arc(void)
+{
+	/* enable security and privilege mode for arc0 and arc1 */
+	regmap_writel(EN_ARC_SEC_PRIV,
+		mmPSOC_ARC0_MSTR_IF_CORE_HBW_AXPROT_OVRD);
+	regmap_writel(EN_ARC_SEC_PRIV,
+		 mmPSOC_ARC0_MSTR_IF_CORE_LBW_AXPROT_OVRD);
+	regmap_writel(EN_ARC_SEC_PRIV,
+		 mmPSOC_ARC1_MSTR_IF_CORE_HBW_AXPROT_OVRD);
+	regmap_writel(EN_ARC_SEC_PRIV,
+		 mmPSOC_ARC1_MSTR_IF_CORE_LBW_AXPROT_OVRD);
+}
+
+void preboot_security_init(void)
+{
+	/* TODO add check for security strap ON */
+	preboot_secure_arc();
+}
+
+static u32 sp_sram_readl(u32 offset)
+{
+	u32 reg = *((volatile u32 *) (HL_SCRATCHPAD_SRAM_BASE + offset));
+	return reg;
+}
+
+bool preboot_security_is_enabled(void)
+{
+	u32 config_efuse;
+
+	config_efuse = sp_sram_readl(SECURITY_EFUSE_SYS_CFG_OFFSET);
+	return (config_efuse & EFUSE_SYSCFG_ENABLE_VALIDATION_MASK);
+}
+
+bool preboot_security_key_is_revoked(int key_idx)
+{
+	u32 key_revoke;
+
+	if (key_idx < 0 || key_idx >= SECURITY_KEY_HASH_COUNT)
+		return true;
+
+	key_revoke = sp_sram_readl(SECURITY_EFUSE_KEYS_REVOKE_OFFSET);
+	return !!(key_revoke & BIT(key_idx));
+}
+
+bool preboot_security_key_is_valid(int key_idx, const void *pub_key,
+			 int pub_key_len, const void *pub_key_ext,
+			 int pub_key_ext_len)
+{
+	u32 key_base, hash_calculated, hash_stored;
+	u8 bytes_per_dword = sizeof(u32);
+	u8 value[SHA256_SUM_LEN];
+	u8 key[KEY_SIZE];
+	u8 i;
+
+	if (key_idx < 0 || key_idx >= SECURITY_KEY_HASH_COUNT)
+		return false;
+
+	if (pub_key_len != (KEY_SIZE - KEY_EXT_SIZE)) {
+		preboot_puts_hex("Invalid pub key length: ", pub_key_len, 0);
+		return false;
+	}
+
+	if (pub_key_ext_len != KEY_EXT_SIZE) {
+		preboot_puts_hex("Invalid pub key ext length: ",
+				pub_key_ext_len, 0);
+		return false;
+	}
+
+	/* Concanate public key and public key extension */
+	memcpy(key, pub_key, pub_key_len);
+	memcpy((key + pub_key_len), pub_key_ext, pub_key_ext_len);
+
+	sha256_csum(key, pub_key_len + pub_key_ext_len, value);
+
+	key_base = (key_idx * bytes_per_dword * SECURITY_DWORD_PER_KEY)
+			+ SECURITY_EFUSE_KEYS_OFFSET;
+
+	for (i = 0; i < SECURITY_DWORD_PER_KEY; i++) {
+		memcpy(&hash_calculated, value + (i * bytes_per_dword),
+			bytes_per_dword);
+		hash_stored = sp_sram_readl(key_base + (i * bytes_per_dword));
+		if (hash_calculated != hash_stored)
+			return false;
+	}
+
+	return true;
+}
+
+bool preboot_security_svn_is_valid(int sec_ver)
+{
+	u8 sec_fw_ver, sec_valid_fw_ver;
+	u32 valid_fw_ver;
+
+	sec_fw_ver = SECURITY_FW_VERSION_TO_SECURITY_BYTE(sec_ver);
+	valid_fw_ver = sp_sram_readl(SECURITY_EFUSE_FW_VERSION_OFFSET);
+	sec_valid_fw_ver = SECURITY_FW_VERSION_TO_SECURITY_BYTE(valid_fw_ver);
+
+	if (sec_fw_ver < sec_valid_fw_ver)
+		preboot_puts_hex("Security version too low: ", sec_ver, 0);
+
+	return sec_fw_ver >= sec_valid_fw_ver;
+}
+
+bool preboot_security_key_montgomery_is_valid(void)
+{
+	return true;
+}
