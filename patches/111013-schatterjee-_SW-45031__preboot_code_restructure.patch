diff --git a/arch/goya/arm/asic.c b/arch/goya/arm/asic.c
new file mode 100644
index 0000000..04b5dfc
--- /dev/null
+++ b/arch/goya/arm/asic.c
@@ -0,0 +1,88 @@
+/*
+ * (C) Copyright 2019 HabanaLabs, Ltd.
+ * Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#include <goya_blocks.h>
+#include <psoc_global_conf_regs.h>
+#include <cpu_if_regs.h>
+
+#include <bitops.h>
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+#include <hl_boot_if.h>
+
+#include "common.h"
+
+u32 hl_skip_pcie_init(void)
+{
+	/* Use DumpSel[8] to skip PCIe initialization */
+	return regmap_readl(mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS) & BIT(21);
+}
+
+u64 hl_pll_timestamp_freq_get(void)
+{
+	return hl_pll_get_freq(mmCPU_PLL_BASE & ~HL_CFG_BASE, HL_PLL_DIV1);
+}
+
+void hl_uart_init(void)
+{
+	u32 uart_clk_freq, pll_base = mmPSOC_PCI_PLL_BASE & ~HL_CFG_BASE;
+
+	uart_clk_freq = hl_pll_get_freq(pll_base, HL_PLL_DIV1);
+
+	preboot_uart_init(uart_clk_freq / HL_UART_BAUDRATE);
+}
+
+u32 hl_spi_baudr_get(void)
+{
+	u32 factor, spi_clk_freq;
+	u32 pll_base = mmPSOC_PCI_PLL_BASE & ~HL_CFG_BASE;
+
+	spi_clk_freq = hl_pll_get_freq(pll_base, HL_PLL_DIV1);
+	factor = spi_clk_freq / HL_SPI_FLASH_MAX_FREQ;
+
+	return factor > 2 ? factor : 2;
+}
+
+void lkd_dev_spec_regs(struct cpu_dyn_regs *regs)
+{
+	regs->cpu_pq_base_addr_low = mmCPU_PQ_BASE_ADDR_LOW;
+	regs->cpu_pq_base_addr_high = mmCPU_PQ_BASE_ADDR_HIGH;
+	regs->cpu_pq_length = mmCPU_PQ_LENGTH;
+	regs->cpu_pq_init_status = mmCPU_PQ_INIT_STATUS;
+	regs->cpu_eq_base_addr_low = mmCPU_EQ_BASE_ADDR_LOW;
+	regs->cpu_eq_base_addr_high = mmCPU_EQ_BASE_ADDR_HIGH;
+	regs->cpu_eq_length = mmCPU_EQ_LENGTH;
+	regs->cpu_eq_ci = mmCPU_EQ_CI;
+	regs->cpu_cq_base_addr_low = mmCPU_CQ_BASE_ADDR_LOW;
+	regs->cpu_cq_base_addr_high = mmCPU_CQ_BASE_ADDR_HIGH;
+	regs->cpu_cq_length = mmCPU_CQ_LENGTH;
+	regs->cpu_pf_pq_pi = mmCPU_IF_PF_PQ_PI;
+	regs->cpu_boot_dev_sts0 = mmCPU_BOOT_DEV_STS0;
+	regs->cpu_boot_dev_sts1 = mmCPU_BOOT_DEV_STS1;
+	regs->cpu_boot_err0 = mmCPU_BOOT_ERR0;
+	regs->cpu_boot_err1 = mmCPU_BOOT_ERR1;
+	regs->cpu_boot_status = mmPSOC_GLOBAL_CONF_CPU_BOOT_STATUS;
+	regs->fw_upd_sts = mmUPD_STS;
+	regs->fw_upd_cmd = mmUPD_CMD;
+	regs->fw_upd_pending_sts = mmUPD_PENDING_STS;
+	regs->fuse_ver_offset = mmFUSE_VER_OFFSET;
+	regs->preboot_ver_offset = mmPREBOOT_VER_OFFSET;
+	regs->uboot_ver_offset = mmUBOOT_VER_OFFSET;
+	regs->hw_state = mmHW_STATE;
+	regs->kmd_msg_to_cpu = mmPSOC_GLOBAL_CONF_KMD_MSG_TO_CPU;
+	regs->cpu_cmd_status_to_host = mmCPU_CMD_STATUS_TO_HOST;
+}
+
+bool hl_pci_is_mem_enabled(void)
+{
+	/*
+	 * mem enable flag is not used for goya, returning false to preserve
+	 * logic in pci module
+	 */
+	return false;
+}
