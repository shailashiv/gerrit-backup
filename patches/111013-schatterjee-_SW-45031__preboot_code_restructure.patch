+#define GAUDI_IRQ_SIZE	512
+void preboot_ack_razwi_irq(void)
+{
+	u32 i;
+
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_RAZWI);
+	for (i = 0; i < GAUDI_IRQ_SIZE; i++)
+		regmap_writel(i, mmGIC_DISTRIBUTOR__6_GICD_CLRSPI_NSR);
+}
+
+u32 dev_pci_dbi_cfg_offset_get(void)
+{
+	return (u32)mmPCIE_DBI_BASE & 0xFFFFFF;
+}
+
+static struct hl_nic_en nic_en;
+static bool hbm_is_init;
+
+#define NIC_PHY_RX_CFG_OFFSET	0x10
+#define NIC_PORT_EN		0
+#define NIC_PORT_DIS		2
+
+void enable_nic_regs(u32 nic_en)
+{
+	u32 port, val, idx, block_of;
+
+	for (port = 0; port < GAUDI_NIC_ENGS_NUM; port++) {
+		val = (nic_en & (1 << port)) ? NIC_PORT_EN : NIC_PORT_DIS;
+		idx = port >> 1;
+		block_of = idx * GAUDI_NICS_DIST;
+
+		if (port & 1) {
+			regmap_writel(val, mmNIC0_PHY_PHY_RX_CFG_2 + block_of);
+			regmap_writel(val, mmNIC0_PHY_PHY_RX_CFG_3 + block_of);
+		} else {
+			regmap_writel(val, mmNIC0_PHY_PHY_RX_CFG_0 + block_of);
+			regmap_writel(val, mmNIC0_PHY_PHY_RX_CFG_1 + block_of);
+		}
+	}
+}
+
+void preboot_nic_en(u32 nic_en_)
+{
+	nic_en.is_valid = true;
+	nic_en.bitmask = nic_en_;
+	enable_nic_regs(nic_en_);
+	preboot_puts_hex("nic_en ", nic_en_, true);
+}
+
+void preboot_finalize_nic_en(void)
+{
+	if (nic_en.is_valid)
+		boot_info_set(HL_BOOT_INFO_NIC_EN, &nic_en.bitmask, sizeof(u32));
+}
+
+void preboot_set_hbm_init(bool is_init)
+{
+	hbm_is_init = is_init;
+}
+
+int preboot_set_sram_sf_access(bool is_enable)
+{
+	if (is_enable && !hbm_is_init) {
+		preboot_puts("SRAM and SF access is disabled while HBM is not initialized\n");
+		return 1;
+	}
+
+	spi_lock_access(is_enable);
+	preboot_security_sram_pci_set_ro(is_enable);
+	preboot_security_sf_pci_set_ro(is_enable);
+
+	return 0;
+}
+
+bool is_pcie_initialized(void)
+{
+	u32 rst_ctrl, wfe_stat;
+
+	rst_ctrl = regmap_readl(mmCPU_CA53_CFG_ARM_RST_CONTROL);
+	rst_ctrl &= CPU1_RST_CTRL; /* reset signals are active low */
+
+	wfe_stat = regmap_readl(mmCPU_CA53_CFG_ARM_PWR_STAT_0);
+	wfe_stat &= CPU1_WFE_STAT;
+
+	/*
+	 * if CPU1 finished running (wfe) of didn't run at all (reset state)
+	 * pcie should be in operational state.
+	 */
+	return (!rst_ctrl || wfe_stat);
+}
