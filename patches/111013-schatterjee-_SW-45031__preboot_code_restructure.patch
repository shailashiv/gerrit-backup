-	},
-	[IMAGE] = {
-		.rr = PCIE_DYN_RR_SRAM_R3,
-		.min = 0,
-		.max = 0,
-	},
-	[IMG_END_TO_SRAM_END] = {
-		.rr = PCIE_DYN_RR_SRAM_END,
-		.min = 0,
-		.max = SRAM_END,
-	},
-	[STM_SF_MEMMAP] = {
