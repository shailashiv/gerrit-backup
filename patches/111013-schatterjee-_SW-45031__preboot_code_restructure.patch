+++ b/lib/preboot/i2cslave_indirect.c
@@ -0,0 +1,1177 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2017-2020 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include <bitops.h>
+#include <preboot.h>
+#include <uart.h>
+#include <common/module_i2c_slave.h>
+#include <common/cmd_module.h>
+#include <hl_i2c_indirect.h>
+#include <hl_i2c_slave_events.h>
+#include <crc32.h>
+#include <hl_fw_if.h>
+#include <boot_desc.h>
+#include <spi.h>
+#include <memory.h>
+
+#include "fit.h"
+#include "i2cslave_indirect.h"
+#include <rma_if.h>
+#include "rma_info.h"
+
+#define SUPPORTED_OPCODES_MASK	( \
+				BIT(HL_I2CI_REQ_OP_DEVICE_INFO) | \
+				BIT(HL_I2CI_REQ_OP_DEVICE_STATUS) | \
+				BIT(HL_I2CI_REQ_OP_CONFIG_ACCESS) | \
+				BIT(HL_I2CI_REQ_OP_SMBUS_ALERT) | \
+				BIT(HL_I2CI_REQ_OP_FW_LOADER) | \
+				BIT(HL_I2CI_REQ_OP_MEMCPY_CTRL) | \
+				BIT(HL_I2CI_REQ_OP_MEMCPY_DATA) | \
+				BIT(HL_I2CI_REQ_OP_ERROR_STATUS) \
+				)
+
+struct i2csi_wdata_chunk_context {
+	u16 offset; /* Chunk offset within the request */
+	struct hl_i2ci_wdata_chunk_hdr hdr;
+};
+
+struct i2csi_wdata_read_context {
+	u8 *data; /* Pointer to data to be read */
+	u16 length;
+	union {
+		u32 crc;
+		u8 req_crc_data[4];
+	};
+	struct hl_i2ci_rdata_hdr hdr;
+};
+
+struct i2csi_wdata_write_context {
+	u8 *data;	/* Pointer to written data */
+	u16 offset;	/* Offset of overall written data */
+	u16 length;	/* Length of bytes to write in a single iteration */
+	u32 crc;	/* Calculated CRC */
+	union {
+		u32 req_crc;		/* Request CRC from master */
+		u8 req_crc_data[4];
+		u8 unused[4];		/* For unused data needed for CRC */
+	};
+	struct hl_i2ci_wdata_hdr hdr;
+};
+
+struct i2csi_block_write {
+	u8 length;
+	union {
+		struct hl_i2ci_wdata_hdr wdata;
+
+		struct {
+			struct hl_i2ci_req_cfg req_cfg;
+			u8 req_cfg_pec;
+		} __packed;
+
+		struct {
+			struct hl_i2ci_ctrl_cmd ctrl_cmd;
+			u8 ctrl_cmd_pec;
+		} __packed;
+	};
+} __packed;
+
+struct i2csi_block_write_context {
+	bool is_full_block;
+	struct i2csi_block_write data;
+};
+
+struct i2csi_read_clear {
+	u8 offset;
+	u8 size;
+};
+
+struct i2csi_block_write_context block_write;
+
+static struct hl_i2ci_req_cfg req_cfg;
+static struct hl_i2ci_req_sts req_sts;
+static struct i2csi_wdata_chunk_context req_chunk;
+static struct i2csi_wdata_read_context req_rd;
+static struct i2csi_wdata_write_context req_wd;
+
+static struct hl_i2ci_device_status op_status = {
+	.device_status = HL_I2CI_REQ_DEV_STS_PREBOOT,
+	.valid_opcode_map = SUPPORTED_OPCODES_MASK,
+};
+
+static struct hl_i2ci_device_info op_info = {
+	.device_id = 0,
+	.asic_sn = 0,
+};
+
+static struct hl_i2ci_config_access op_config;
+
+static u32 op_memcpy_offset;
+static struct hl_i2ci_memcpy_ctrl op_memcpy __aligned(8);
+
+static struct hl_i2ci_smbus_alert smbus_alert;
+struct hl_i2ci_error_status op_err_status;
+struct hl_i2ci_dram op_dram;
+
+static struct hl_i2ci_ctrl_cmd ctrl_cmd;
+static struct hl_i2ci_ctrl_sts ctrl_sts;
+struct rma_failure i2c_rma_failure;
+
+static bool err_chksum_avail;
+
+const static struct i2csi_read_clear op_err_status_rc[] = {
+	{
+		.offset = offsetof(struct hl_i2ci_error_status, security),
+		.size = sizeof(struct hl_i2ci_error_status_security),
+	},
+	{
+		.offset = offsetof(struct hl_i2ci_error_status, checksum),
+		.size = sizeof(struct hl_i2ci_error_status_checksum),
+	},
+	{
+		.offset = offsetof(struct hl_i2ci_error_status, wd),
+		.size = sizeof(struct hl_i2ci_error_status_wd),
+	},
+};
+
+static u32 i2csi_block_wait_for(u8 block_cmd, u8 cmd, u8 len, u8 **data)
+{
+	u8 offset = cmd - block_cmd;
+	bool is_virt = I2CSLAVE_IS_VIRTUAL_CMD(cmd);
+	u8 overhead;
+
+	*data = ((u8 *)&block_write.data) + offset;
+	if (is_virt || offset) {
+		block_write.is_full_block = false;
+		overhead = 1; /* Adding 1 for len byte itself */
+	} else {
+		block_write.is_full_block = true;
+		overhead = 2; /* Adding 2 for len and pec */
+	}
+
+	return len + overhead - offset;
+}
+
+static void i2csi_req_config_access(void)
+{
+	switch (op_config.command) {
+	case HL_I2CI_CONFIG_CMD_READ:
+		if (i2c_fwupd_owned(op_config.address))
+			op_config.data = i2c_fwupd_readl(op_config.address);
+		else
+			op_config.data = regmap_readl(op_config.address);
+
+		break;
+	case HL_I2CI_CONFIG_CMD_WRITE:
+		if (i2c_fwupd_owned(op_config.address))
+			i2c_fwupd_writel(op_config.address, op_config.data);
+		else
+			regmap_writel(op_config.data, op_config.address);
+
+		break;
+	}
+
+	op_config.status = HL_I2CI_CONFIG_STS_SUCCESS;
+}
+
+static void i2csi_req_load_fw(void)
+{
+	struct mem_desc desc;
+	/*
+	 * Received firmware length is the last requset RDQL + previous
+	 * requests length which is calculate by the header offset.
+	 * Integrity check is not supported for opcode 12 (load fw)
+	 */
+	unsigned int fw_len = req_wd.hdr.rqdl +
+		(req_wd.hdr.offset * HL_I2CI_REQ_MAX_RQDL);
+
+	preboot_get_mem_region(MEM_I2C, &desc);
+
+	if (fit_validate_size((void *)desc.base, fw_len))
+		return; /* More data is needed */
+
+	if (fit_load_images((void *)desc.base))
+		req_sts.err = HL_I2CI_REQ_ERR_PROCESS;
+	else
+		i2cslave_fit_set_checked();
+
+}
+
+static void i2csi_req_memcpy_ctrl(void)
+{
+	if (op_memcpy.address < SDRAM_BASE)
+		goto memcpy_ctrl_fail;
+
+	if (op_memcpy.address > SDRAM_BASE + SRAM_SIZE)
+		goto memcpy_ctrl_fail;
+
+	if (op_memcpy.size > SRAM_SIZE)
+		goto memcpy_ctrl_fail;
+
+	op_memcpy.status = HL_I2CI_MEMCPY_STS_PASS;
+	return;
+
+memcpy_ctrl_fail:
+	op_memcpy.status = HL_I2CI_MEMCPY_STS_FAIL;
+	preboot_puts("I2C indirect memcpy failed\n");
+}
+
+static void i2csi_req_memcpy_iterate(void)
+{
+	u32 bytes_left;
+
+	switch (op_memcpy.status) {
+	case HL_I2CI_MEMCPY_STS_FAIL:
+	case HL_I2CI_MEMCPY_STS_PASS:
+		op_memcpy_offset = 0;
+		break;
+	case HL_I2CI_MEMCPY_STS_IN_PROGRESS:
+		bytes_left = op_memcpy.size - op_memcpy_offset;
+
+		if (bytes_left > HL_I2CI_MEMCPY_REQ_MAX) {
+			op_memcpy_offset += HL_I2CI_MEMCPY_REQ_MAX;
+		} else {
+			op_memcpy.status = HL_I2CI_MEMCPY_STS_PASS;
+			op_memcpy_offset = 0;
+		}
+
+		break;
+	}
+}
+
+static u8 *i2csi_req_memcpy_rw(u16 *length)
+{
+	u32 bytes_left;
+
+	bytes_left = op_memcpy.size - op_memcpy_offset;
+	if (bytes_left > HL_I2CI_MEMCPY_REQ_MAX)
+		*length = HL_I2CI_MEMCPY_REQ_MAX;
+	else
+		*length = bytes_left;
+
+	if (op_memcpy.status == HL_I2CI_MEMCPY_STS_FAIL) {
+		req_sts.err = HL_I2CI_REQ_ERR_PROCESS;
+		return NULL;
+	}
+
+	op_memcpy.status = HL_I2CI_MEMCPY_STS_IN_PROGRESS;
+	return (u8 *)(uintptr_t)(op_memcpy.address + op_memcpy_offset);
+}
+
+static inline void i2csi_req_wdata_wait_for(u8 *data, u16 length)
+{
+	if (req_wd.hdr.ic && !data && req_wd.offset < req_wd.hdr.rqdl) {
+		/* Data is coming but its unused, we still need to calc CRC */
+		req_wd.data = req_wd.unused;
+		if (length > sizeof(req_wd.unused))
+			length = sizeof(req_wd.unused);
+
+		req_wd.length = length;
+	} else {
+		req_wd.data = data;
+		req_wd.length = length;
+	}
+}
+
+static inline void i2csi_req_wdata_done(void)
+{
+	i2csi_req_wdata_wait_for(NULL, 0);
+}
+
+static void i2csi_req_buffer_get_writable(u16 rsize, u8 *data, int dlow,
+					  int dhigh)
+{
+	int rlow = req_wd.hdr.offset + req_wd.offset;
+	int rhigh = req_wd.hdr.offset + rsize;
+
+	/* Check out of bound */
+	if (rlow >= dhigh || rhigh <= dlow) {
+		/* If that is not a partial request, produce an error */
+		if (!req_wd.offset)
+			req_sts.err = HL_I2CI_REQ_ERR_P_WRITE_PERM;
+
+		i2csi_req_wdata_wait_for(NULL, rhigh - rlow);
+		return;
+	}
+
+	/*
+	 * Check if the lower part of the request tries to write before the
+	 * writable area. Ignore these bytes but don't produce an error since
+	 * the next iteration is valid.
+	 */
+	if (rlow < dlow) {
+		i2csi_req_wdata_wait_for(NULL, dlow - rlow);
+		return;
+	}
+
+	/*
+	 * Check if the write request overshoots the upper writable limit and
+	 * make adjusments accordingly.
+	 */
+	if (rhigh > dhigh)
+		rhigh = dhigh;
+
+	i2csi_req_wdata_wait_for(&data[rlow], rhigh - rlow);
+}
+
+static void i2csi_req_err_sts_check(u16 size)
+{
+
+	switch (req_wd.hdr.offset) {
+	/* Opcode has write permission only for the entry index */
+	case offsetof(struct hl_i2ci_error_status, fatal_sram_ecc.entry_index):
+	case offsetof(struct hl_i2ci_error_status, fatal_hbm_ecc.entry_index):
+	case offsetof(struct hl_i2ci_error_status, fatal_hbm_parity.entry_index):
+		/* Lower and upper bounds make sure only entry index is being written */
+		i2csi_req_buffer_get_writable(size, (u8 *)&op_err_status, req_wd.hdr.offset,
+			req_wd.hdr.offset + sizeof(op_err_status.fatal_sram_ecc.entry_index));
+		break;
+	default:
+		/* Attempting to write a read-only parameter */
+		req_sts.err = HL_I2CI_REQ_ERR_P_WRITE_PERM;
+		break;
+	}
+}
+
+/* rma_info API's are device specific */
+__weak void rma_info_hbm_par_err_sts(struct hl_i2ci_error_status_hbm_parity *op) {}
+__weak void rma_info_hbm_ecc_err_sts(struct hl_i2ci_error_status_hbm_ecc *op) {}
+__weak void rma_info_sram_ecc_err_sts(struct hl_i2ci_error_status_sram_ecc *op) {}
+__weak void rma_info_hbm_init_err_sts(struct hl_i2ci_error_status_hbm_init *op) {}
+__weak void rma_info_hbm_row_replacement(struct hl_i2ci_dram *op) {}
+
+static void i2csi_update_rma_entry(void)
+{
+	if (i2c_rma_failure.data) {
+		if (i2c_rma_failure.sram_ecc)
+			rma_info_sram_ecc_err_sts(&op_err_status.fatal_sram_ecc);
+
+		if (i2c_rma_failure.hbm_ecc)
+			rma_info_hbm_ecc_err_sts(&op_err_status.fatal_hbm_ecc);
+
+		if (i2c_rma_failure.hbm_parity)
+			rma_info_hbm_par_err_sts(&op_err_status.fatal_hbm_parity);
+
+		if (i2c_rma_failure.hbm_init)
+			rma_info_hbm_init_err_sts(&op_err_status.fatal_hbm_init);
+	}
+}
+
+static void i2csi_update_dram_rma_entry(void)
+{
+	if (i2c_rma_failure.data) {
+		if (i2c_rma_failure.row_replacement)
+			rma_info_hbm_row_replacement(&op_dram);
+	}
+}
+
+static void i2csi_req_opcode_get_buffer(u16 size)
+{
+	int upper_bound, lower_bound;
+	u8 *data;
+	struct mem_desc mdesc;
+
+	switch (req_wd.hdr.opcode) {
+	case HL_I2CI_REQ_OP_CONFIG_ACCESS:
+		upper_bound = offsetof(struct hl_i2ci_config_access, status);
+
+		i2csi_req_buffer_get_writable(size, (u8 *)&op_config, 0,
+					      upper_bound);
+		break;
+
+	case HL_I2CI_REQ_OP_FW_LOADER:
+		/*
+		 * The firmware data is being placed directly to FIT base
+		 * buffer, it may be assembled by multiple requests so we used
+		 * the offset int the header an index.
+		 * Integrity check is not supported for opcode 12 (fw load)
+		 */
+		preboot_get_mem_region(MEM_I2C, &mdesc);
+		data = (u8 *)mdesc.base +
+			(req_wd.hdr.offset * HL_I2CI_REQ_MAX_RQDL);
+		i2csi_req_wdata_wait_for(data, size);
+		break;
+
+	case HL_I2CI_REQ_OP_MEMCPY_CTRL:
+		upper_bound = offsetof(struct hl_i2ci_memcpy_ctrl, status);
+
+		i2csi_req_buffer_get_writable(size, (u8 *)&op_memcpy, 0,
+					      upper_bound);
+		break;
+
+	case HL_I2CI_REQ_OP_MEMCPY_DATA:
+		i2csi_req_memcpy_iterate();
+
+		if (op_memcpy.command != HL_I2CI_MEMCPY_CMD_WRITE)
+			op_memcpy.status = HL_I2CI_MEMCPY_STS_FAIL;
+
+		data = i2csi_req_memcpy_rw(&size);
+		i2csi_req_wdata_wait_for(data, size);
+		break;
+	case HL_I2CI_REQ_OP_ERROR_STATUS:
+		i2csi_req_err_sts_check(size);
+		break;
+	case HL_I2CI_REQ_OP_DRAM:
+		lower_bound = offsetof(struct hl_i2ci_dram, index_replaced_row_selection);
+		upper_bound = offsetof(struct hl_i2ci_dram, replaced_row_hbm_index);
+
+		i2csi_req_buffer_get_writable(size, (u8 *)&op_dram, lower_bound,
+						  upper_bound);
+		break;
+	default:
+		/* Data will be consumed from HW but not stored anywhere */
+		i2csi_req_wdata_wait_for(NULL, size);
+	}
+}
+
+static void i2csi_err_status_set_wd(void)
+{
+	switch (fw_info.reset_cause) {
+	case HL_FW_RESET_CAUSE_HEARTBEAT:
+		op_err_status.wd.heartbeat = 1;
+		break;
+	case HL_FW_RESET_CAUSE_TDR:
+		op_err_status.wd.tdr = 1;
+		break;
+	case HL_FW_RESET_CAUSE_WATCHDOG:
+		op_err_status.wd.hw = 1;
+		break;
+	case HL_FW_RESET_CAUSE_UNKNOWN:
+	default:
+		op_err_status.wd.heartbeat = 0;
+		op_err_status.wd.tdr = 0;
+		op_err_status.wd.hw = 0;
+	}
+
+	/* Clear for next read */
+	fw_info.reset_cause = HL_FW_RESET_CAUSE_UNKNOWN;
+}
+
+__weak bool hl_ppboot_is_valid(bool is_prime)
+{
+	return true;
+}
+
+static void i2csi_err_chksum_validate(void)
+{
+	struct boot_desc desc;
+	struct mem_desc mdesc;
+	struct hl_i2ci_error_status_checksum_spi *spi;
+	enum fw_post_reset_cmd role[] = {
+		FLOPS_UPD_NOOP,		/* Primary */
+		FLOPS_UPD_PENDING,	/* Secondary */
+	};
+	u8 hash[SHA256_SUM_LEN];
+	bool is_valid, is_prime;
+	u32 idx;
+	int i;
+
+	spi = &op_err_status.checksum.spi;
+
+	spi->ppboot_primary = !hl_ppboot_is_valid(true);
+	spi->ppboot_secondary = !hl_ppboot_is_valid(false);
+
+	if (!boot_desc_init()) {
+		preboot_puts_raw("Not a valid boot desc.");
+		return;
+	}
+
+	preboot_get_mem_region(MEM_I2C, &mdesc);
+
+	for (i = 0; i < 2; i++) {
+		idx = boot_desc_get_img_desc(role[i], HL_FW_IMG_PREBOOT, &desc);
+		if (idx == HL_FW_IMG_NOT_FOUND)
+			continue;
+
+		is_prime = !i;
+		/* Using fit image base as playground */
+		spi_copy((void *)mdesc.base, desc.spi_offset, desc.img_size,
+			 NULL);
+		sha256_csum((void *)mdesc.base, desc.img_size, hash);
+		is_valid = !memcmp(hash, desc.chksum, ARRAY_SIZE(hash));
+
+		if (is_prime)
+			spi->preboot_primary = !is_valid;
+		else
+			spi->preboot_secondary = !is_valid;
+	}
+
+	err_chksum_avail = true;
+}
+
+__weak u32 hl_get_btl_index(void)
+{
+	return 0;
+}
+
+static void i2csi_alert_set_pcie(void)
+{
+	if (!hl_pci_link_is_up())
+		smbus_alert.pcie_error = HL_I2CI_SMBUS_PCIE_UNCORR_ERROR;
+	else
+		smbus_alert.pcie_error = 0;
+}
+
+static inline void i2csi_req_process_read_opcode(void)
+{
+	switch (req_wd.hdr.opcode) {
+	case HL_I2CI_REQ_OP_DEVICE_INFO:
+		if (!op_info.device_id)
+			op_info.device_id = (u16)preboot_device_id_get();
+
+		if (!op_info.asic_sn)
+			memcpy((u8 *)&op_info.asic_sn, hl_asic_sn, sizeof(op_info.asic_sn));
+
+		req_rd.data = (u8 *)&op_info;
+		req_rd.length = sizeof(op_info);
+		break;
+	case HL_I2CI_REQ_OP_DEVICE_STATUS:
+		op_status.used_btl_image_index = hl_get_btl_index();
+		req_rd.data = (u8 *)&op_status;
+		req_rd.length = sizeof(op_status);
+		break;
+	case HL_I2CI_REQ_OP_CONFIG_ACCESS:
+		req_rd.data = (u8 *)&op_config;
+		req_rd.length = sizeof(op_config);
+		break;
+	case HL_I2CI_REQ_OP_SMBUS_ALERT:
+		i2csi_alert_set_pcie();
+
+		req_rd.data = (u8 *)&smbus_alert;
+		req_rd.length = sizeof(smbus_alert);
+		break;
+	case HL_I2CI_REQ_OP_MEMCPY_CTRL:
+		req_rd.data = (u8 *)&op_memcpy;
+		req_rd.length = sizeof(op_memcpy);
+		break;
+	case HL_I2CI_REQ_OP_MEMCPY_DATA:
+		i2csi_req_memcpy_iterate();
+
+		if (op_memcpy.command != HL_I2CI_MEMCPY_CMD_READ)
+			op_memcpy.status = HL_I2CI_MEMCPY_STS_FAIL;
+
+		req_rd.data = i2csi_req_memcpy_rw(&req_rd.length);
+		break;
+	case HL_I2CI_REQ_OP_ERROR_STATUS:
+		i2csi_update_rma_entry();
+		i2csi_err_status_set_wd();
+		if (!err_chksum_avail)
+			i2csi_err_chksum_validate();
+
+		req_rd.data = (u8 *)&op_err_status;
+		req_rd.length = sizeof(op_err_status);
+		break;
+	case HL_I2CI_REQ_OP_DRAM:
+		i2csi_update_dram_rma_entry();
+
+		req_rd.data = (u8 *)&op_dram;
+		req_rd.length = sizeof(op_dram);
+		break;
+	default:
+		if ((BIT(req_wd.hdr.opcode) & SUPPORTED_OPCODES_MASK))
+			req_sts.err = HL_I2CI_REQ_ERR_P_WRITE_PERM;
+		else
+			req_sts.err = HL_I2CI_REQ_ERR_P_OPCODE;
+		break;
+	}
+}
+
+__weak bool i2c_config_is_address_valid(u32 addr)
+{
+	return true;
+}
+
+static inline void i2csi_req_process_write_opcode(void)
+{
+	switch (req_wd.hdr.opcode) {
+	case HL_I2CI_REQ_OP_CONFIG_ACCESS:
+		if (i2c_config_is_address_valid(op_config.address))
+			i2csi_req_config_access();
+		else
+			req_sts.err = HL_I2CI_REQ_ERR_P_WRITE_PERM;
+		break;
+	case HL_I2CI_REQ_OP_FW_LOADER:
+		i2csi_req_load_fw();
+		break;
+	case HL_I2CI_REQ_OP_MEMCPY_CTRL:
+		i2csi_req_memcpy_ctrl();
+		break;
+	case HL_I2CI_REQ_OP_MEMCPY_DATA:
+		/* Do nothing */
+		break;
+	case HL_I2CI_REQ_OP_ERROR_STATUS:
+		/* Do nothing */
+		break;
+	case HL_I2CI_REQ_OP_DRAM:
+		/* Do nothing */
+		break;
+	default:
+		if ((BIT(req_wd.hdr.opcode) & SUPPORTED_OPCODES_MASK))
+			req_sts.err = HL_I2CI_REQ_ERR_P_WRITE_PERM;
+		else
+			req_sts.err = HL_I2CI_REQ_ERR_P_OPCODE;
+		break;
+	}
+}
+
+static void i2csi_req_wdata_handle_chunk(u8 cnt)
+{
+	if (cnt == 2) { /* Chunk (partial payload) is expected */
+		i2csi_req_opcode_get_buffer(req_chunk.hdr.rqcl);
+		if (req_wd.data)
+			req_wd.data += req_chunk.offset;
+
+		return;
+	}
+
+	/* Chuck received */
+	req_chunk.offset += req_chunk.hdr.rqcl;
+
+	/* Payload fully received */
+	if (req_chunk.offset == req_wd.hdr.rqdl) {
+		req_chunk.offset = 0;
+		req_sts.sm_sts = HL_I2CI_REQ_ST_PROCESS;
+	}
+
+	i2csi_req_wdata_done();
+}
+
+static void i2csi_req_wdata_handle_payload(void)
+{
+	/* Payload is expected */
+	if (req_wd.offset < req_wd.hdr.rqdl) {
+		i2csi_req_opcode_get_buffer(req_wd.hdr.rqdl);
+		return;
+	}
+
+	/* The payload has arrived, wait for CRC */
+	if (req_wd.hdr.ic) {
+		if (req_wd.offset < req_wd.hdr.rqdl + 4) {
+			i2csi_req_wdata_wait_for(req_wd.req_crc_data, 4);
+			return;
+		} else if (req_wd.req_crc != req_wd.crc) {
+			req_sts.sm_sts = HL_I2CI_REQ_ST_IDLE;
+			req_sts.err = HL_I2CI_REQ_ERR_INTEGRITY;
+			i2csi_req_wdata_done();
+			return;
+		}
+	}
+
+	/* Payload received */
+	req_sts.sm_sts = HL_I2CI_REQ_ST_PROCESS;
+	i2csi_req_wdata_done();
+}
+
+static inline void i2csi_req_reset(void)
+{
+	req_sts.err = HL_I2CI_REQ_ERR_NONE;
+	req_sts.rsdl = 0;
+	req_chunk.hdr.rqcl = 0;
+	req_rd.data = NULL;
+	req_rd.length = 0;
+	req_wd.length = 0;
+	req_wd.offset = 0;
+	req_wd.crc = 0;
+	req_wd.hdr.ic = 0;
+}
+
+void i2csi_req_wdata_handle_write(u8 cnt)
+{
+	if (cnt > 1) /* Skip the header */
+		req_wd.offset += req_wd.length;
+
+	if (req_chunk.hdr.rqcl) {
+		i2csi_req_wdata_handle_chunk(cnt);
+		return;
+	}
+
+	if (req_wd.hdr.ic && req_wd.length && req_wd.offset <= req_wd.hdr.rqdl)
+		req_wd.crc = crc32(req_wd.crc, req_wd.data, req_wd.length);
+
+	i2csi_req_wdata_handle_payload();
+}
+
+void i2csi_req_wdata_handle_read(u8 cnt)
+{
+	if (req_wd.hdr.ic) {
+		switch (cnt) {
+		case 1: /* Header received, wait for CRC */
+			i2csi_req_wdata_wait_for(req_wd.req_crc_data, 4);
+			return;
+
+		case 2: /* CRC received, validate it */
+			if (req_wd.req_crc != req_wd.crc) {
+				req_sts.sm_sts = HL_I2CI_REQ_ST_IDLE;
+				req_sts.err = HL_I2CI_REQ_ERR_INTEGRITY;
+				i2csi_req_wdata_done();
+				return;
+			}
+			/* Fall through */
+		}
+	}
+
+	req_sts.sm_sts = HL_I2CI_REQ_ST_PROCESS;
+
+	/* Data read with chunks is not supported */
+	if (req_chunk.hdr.rqcl)
+		req_sts.err = HL_I2CI_REQ_ERR_P_DATA_SIZE;
+	else
+		i2csi_req_process_read_opcode();
+
+	if (req_rd.data) {
+		if (req_wd.hdr.offset < req_rd.length) {
+			/* Adjust the read offset */
+			req_rd.data += req_wd.hdr.offset;
+			req_rd.length -= req_wd.hdr.offset;
+		} else {
+			/* Offset overshoots the read data */
+			req_rd.data = NULL;
+			req_rd.length = 0;
+		}
+
+		/* In case master requested partial data */
+		if (req_wd.hdr.rqdl < req_rd.length)
+			req_rd.length = req_wd.hdr.rqdl;
+
+		req_rd.hdr.rsdl = req_wd.hdr.rqdl;
+		req_sts.rsdl = req_wd.hdr.rqdl;
+		req_sts.sm_sts = HL_I2CI_REQ_ST_TRANSMIT;
+	} else {
+		req_sts.sm_sts = HL_I2CI_REQ_ST_IDLE;
+	}
+
+	i2csi_req_wdata_done();
+}
+
+/*
+ * Handle request port WDATA command. This command holds a data buffer which
+ * is being transferred by the master. The request may be divided into chunks
+ * and this function also handles this possibility.
+ *
+ * This function is being called 3-4 time per WDATA command. Depends whether
+ * the request is divided into chunks or not.
+ * - 1. [cnt=0] WDATA was recorded, wait for header.
+ * - 2. [cnt=1] Header arrived, wait for chunk header or payload
+ * - 3. [cnt=2,no chunks] - payload was written, done this WDATA command
+ *      [cnt=2,chunks]    - chunk header was written, wait for payload
+ * - 4. [cnt=3,chunks]    - payload was written, done this WDATA command
+ *
+ * Arguments:
+ * - cnt:  the number of time this function is called per current command
+ *         context.
+  */
+static void i2csi_req_wdata_process_data(u8 cnt)
+{
+	if (cnt == 1) { /* Chunk header or payload are expected */
+		req_wd.hdr = block_write.data.wdata;
+		if (HL_I2CI_REQ_RQCL_IS_EXISTS(req_wd.hdr)) {
+			i2csi_req_wdata_wait_for(req_chunk.hdr.data,
+						 HL_I2CI_REQ_CHUNK_LEN);
+			return;
+		}
+
+		if (req_wd.hdr.ic)
+			req_wd.crc = crc32(0, req_wd.hdr.data,
+					   sizeof(req_wd.hdr));
+	}
+
+	if (req_wd.hdr.write)
+		i2csi_req_wdata_handle_write(cnt);
+	else
+		i2csi_req_wdata_handle_read(cnt);
+}
+
+u32 i2csi_req_handle_wdata(u8 cmd, u8 **data, u8 cnt)
+{
+	if (!cnt) { /* Header is expected */
+		req_sts.sm_sts = HL_I2CI_REQ_ST_RECEIVE;
+		i2csi_req_reset();
+		block_write.data.wdata = req_wd.hdr;
+		return i2csi_block_wait_for(HL_INDIRECT_REQ_WDATA_CODE, cmd,
+					    HL_I2CI_REQ_WDATA_LEN, data);
+	}
+
+	i2csi_req_wdata_process_data(cnt);
+	*data = req_wd.data;
+
+	return req_wd.length;
+}
+
+/*
+ * Handle request port status reading by the master. Update the request status
+ * header with the latest WDATA opcode data and send it on its way.
+ */
+u8 i2csi_req_handle_sts(u8 cmd)
+{
+	int idx = cmd - HL_INDIRECT_REQ_STS_DATA;
+
+	if (idx >= HL_I2CI_REQ_STS_LEN)
+		return 0;
+
+	req_sts.opcode = req_wd.hdr.opcode;
+	req_sts.write = req_wd.hdr.write;
+	req_sts.ic = req_wd.hdr.ic;
+
+	return req_sts.data[idx];
+}
+
+static void i2csi_req_handle_read_clear(void)
+{
+	const struct i2csi_read_clear *rc = NULL;
+	int i, sz;
+	int rel_off, rel_size;
+
+	if (!req_rd.data)
+		return;
+
+	switch (req_wd.hdr.opcode) {
+	case HL_I2CI_REQ_OP_ERROR_STATUS:
+		rc = op_err_status_rc;
+		sz = ARRAY_SIZE(op_err_status_rc);
+		break;
+	default:
+		return;
+	}
+
+	for (i = 0; i < sz; i++) {
+		if (req_wd.hdr.offset > rc[i].offset + rc[i].size)
+			continue;
+
+		if (req_wd.hdr.offset + req_wd.hdr.rqdl < rc[i].offset)
+			continue;
+
+		if (req_wd.hdr.offset > rc[i].offset) {
+			/* Reading started after the beginning of the field */
+			rel_off = req_wd.hdr.offset - rc[i].offset;
+			if (rc[i].size - rel_off < req_wd.hdr.rqdl)
+				rel_size = rc[i].size - rel_off;
+			else
+				rel_size = req_wd.hdr.rqdl;
+
+			memset(req_rd.data, 0, rel_size);
+		} else {
+			/* Reading started before the beginning of the field */
+			rel_off = rc[i].offset - req_wd.hdr.offset;
+			if (req_wd.hdr.rqdl - rel_off < rc[i].size)
+				rel_size = req_wd.hdr.rqdl - rel_off;
+			else
+				rel_size = rc[i].size;
+
+			memset(&req_rd.data[rel_off], 0, rel_size);
+		}
+	}
+}
+
+/*
+ * Handle request port read request. Return the RDATA header, followed by the
+ * payload.
+ */
+u8 i2csi_req_handle_rdata(u8 cmd, u32 read_seq)
+{
+	register int idx = cmd + read_seq - HL_INDIRECT_REQ_RDATA_DATA;
+	u8 zero = 0, rd_data;
+
+	/* Header */
+	if (idx < HL_I2CI_REQ_RDATA_LEN)
+		return req_rd.hdr.data[idx];
+
+	if (req_wd.hdr.ic && idx == HL_I2CI_REQ_RDATA_LEN)
+		req_rd.crc = crc32(0, req_rd.hdr.data, HL_I2CI_REQ_RDATA_LEN);
+
+	/* Payload */
+	idx -= HL_I2CI_REQ_RDATA_LEN;
+	if (idx < req_rd.length) {
+		rd_data = req_rd.data[idx];
+
+		/*
+		 * Last byte, clear RC fields, unless CRC is needed. In that
+		 * case we should clear only after CRC is Calculated
+		 */
+		if (!req_wd.hdr.ic && idx + 1 == req_rd.length)
+			i2csi_req_handle_read_clear();
+
+		return rd_data;
+	}
+
+	if (req_wd.hdr.ic && idx < req_rd.hdr.rsdl + 4) {
+		if (idx == req_rd.length) {
+			req_rd.crc = crc32(req_rd.crc, req_rd.data,
+					   req_rd.length);
+			/*
+			 * Now that CRC is calculated, we can clear the read
+			 * data.
+			 */
+			i2csi_req_handle_read_clear();
+		}
+
+		/* CRC trivial read 0 for reading of out bound */
+		if (idx < req_rd.hdr.rsdl)
+			req_rd.crc = crc32(req_rd.crc, &zero, 1);
+
+		/* CRC */
+		if (idx >= req_rd.hdr.rsdl && idx < req_rd.hdr.rsdl + 4) {
+			idx -= req_rd.hdr.rsdl;
+			if (idx < sizeof(req_rd.req_crc_data))
+				return req_rd.req_crc_data[idx];
+		}
+	}
+
+	return 0;
+}
+
+/*
+ * Lower layer reports sync error. This means it expected the master to write
+ * bytes but instead is got a read request.
+ * In this case we zero out the state machine and buffer offsets.
+ */
+void i2csi_req_handle_sync_error(void)
+{
+	if (req_sts.sm_sts == HL_I2CI_REQ_ST_IDLE)
+		return;
+
+	req_chunk.offset = 0;
+	req_sts.sm_sts = HL_I2CI_REQ_ST_IDLE;
+	req_sts.rsdl = 0;
+	req_sts.err = HL_I2CI_REQ_ERR_P_DATA_SIZE;
+}
+
+/*
+ * Handle request port configuration register. Set the init bit in request
+ * status reply.
+ * This function is called when the lower layer needs a buffer to write the
+ * data to and the number of bytes it whould write before calling this function
+ * again.
+ *
+ * Arguments:
+ * - data: needs to be set to a designated buffer on which a new data will be
+ *         written into.
+ * - cnt:  the number of time this function is called per current command
+ *         context.
+ *
+ * Returns:
+ *   The number of bytes the lower layer should write into supplied buffer
+ *   before calling this function again. Returning 0 means the command handling
+ *   was finished.
+ */
+u32 i2csi_req_handle_cfg(u8 cmd, u8 **data, u8 cnt)
+{
+	if (!cnt) {/* Header is expected */
+		block_write.data.req_cfg = req_cfg;
+		return i2csi_block_wait_for(HL_INDIRECT_REQ_CFG_CODE, cmd,
+					    HL_I2CI_REQ_CFG_LEN, data);
+	}
+
+	if (block_write.is_full_block) {
+		i2cslave_valid_pec = i2cslave_pec;
+		if (i2cslave_pec != block_write.data.req_cfg_pec)
+			return 0;
+	}
+
+	req_cfg = block_write.data.req_cfg;
+
+	/* Request config received */
+	req_sts.init = req_cfg.init;
+	req_sts.sm_sts = HL_I2CI_REQ_ST_IDLE;
+	req_sts.err = HL_I2CI_REQ_ERR_NONE;
+
+	return 0;
+}
+
+void i2csi_req_set_idle(void)
+{
+	req_sts.sm_sts = HL_I2CI_REQ_ST_IDLE;
+	req_sts.rsdl = 0;
+	req_sts.err = HL_I2CI_REQ_ERR_NONE;
+}
+
+void i2csi_req_handle_process_op(void)
+{
+	i2csi_req_process_write_opcode();
+	req_sts.sm_sts = HL_I2CI_REQ_ST_IDLE;
+}
+
+bool i2csi_req_is_process_op(void)
+{
+	return req_sts.sm_sts == HL_I2CI_REQ_ST_PROCESS;
+}
+
+bool i2csi_req_op_is_fast(void)
+{
+	switch (req_wd.hdr.opcode) {
+	case HL_I2CI_REQ_OP_CONFIG_ACCESS:
+	case HL_I2CI_REQ_OP_MEMCPY_CTRL:
+	case HL_I2CI_REQ_OP_MEMCPY_DATA:
+		return true;
+	case HL_I2CI_REQ_OP_FW_LOADER:
+		/* Fall through */
+	default:
+		return false;
+	}
+}
+
+u32 i2csi_ctrl_handle_command(u8 cmd, u8 **data, u8 cnt)
+{
+	struct hl_i2ci_ctrl_cpsr *cpsr;
+
+	/* Command is expected */
+	if (!cnt) {
+		block_write.data.ctrl_cmd = ctrl_cmd;
+		return i2csi_block_wait_for(HL_INDIRECT_CTRL_CMD_CODE, cmd,
+					    HL_I2CI_CTRL_CMD_LEN, data);
+	}
+
+	if (block_write.is_full_block) {
+		i2cslave_valid_pec = i2cslave_pec;
+		if (i2cslave_pec != block_write.data.ctrl_cmd_pec)
+			return 0;
+	}
+
+	ctrl_cmd = block_write.data.ctrl_cmd;
+
+	ctrl_sts.tag = ctrl_cmd.tag;
+	ctrl_sts.status = HL_I2CI_CTRL_STS_BUSY;
+	ctrl_sts.error = HL_I2CI_CTRL_ERR_NONE;
+	cpsr = &ctrl_sts.cpsr;
+
+	switch (ctrl_cmd.opcode) {
+	case HL_I2CI_CTRL_OP_ABORT:
+		i2csi_req_set_idle();
+		cpsr->abort.status = HL_I2CI_CTRL_ABORT_NONE;
+		break;
+	case HL_I2CI_CTRL_OP_GET_API_VER:
+		cpsr->version.major = HL_I2CI_API_VERSION_MAJOR;
+		cpsr->version.minor = HL_I2CI_API_VERSION_MINOR;
+		cpsr->version.patch = HL_I2CI_API_VERSION_PATCH;
+		break;
+	case HL_I2CI_CTRL_OP_GET_OS_STATE:
+		cpsr->os_state.pcie_access = HL_I2CI_CTRL_ACCESS_FULL;
+		cpsr->os_state.mgmt_access = HL_I2CI_CTRL_ACCESS_FULL;
+		cpsr->os_state.os_state = HL_I2CI_CTRL_OS_PREBOOT;
+		break;
+	case HL_I2CI_CTRL_OP_RESET_DEVICE:
+		/* Remain busy - action will take place from I2C SM */
+		return 0;
+	default:
+		ctrl_sts.error = HL_I2CI_CTRL_ERR_INVALID_OPCODE;
+	}
+
+	ctrl_sts.status = HL_I2CI_CTRL_STS_RESP_RDY;
+
+	return 0;
+}
+
+u8 i2csi_ctrl_handle_status(u8 cmd)
+{
+	register int idx = cmd - HL_INDIRECT_CTRL_STS_DATA;
+	u8 ret;
+
+	if (idx >= HL_I2CI_CTRL_STS_LEN)
+		return 0;
+
+	ret = ctrl_sts.data[idx];
+
+	/* Read till the end - return to idle */
+	if (idx == HL_I2CI_CTRL_STS_LEN - 1)
+		memset(ctrl_sts.data, 0, HL_I2CI_CTRL_STS_LEN);
+
+	return ret;
+}
+
+bool i2csi_ctrl_is_rst_dev(void)
+{
+	return ctrl_sts.status == HL_I2CI_CTRL_STS_BUSY &&
+		ctrl_cmd.opcode == HL_I2CI_CTRL_OP_RESET_DEVICE;
+}
+
+void i2csi_update_smbus_alert(struct rma_entry *rma_header)
+{
+	if (rma_header->rma_failure.sram_ecc)
+		smbus_alert.fatal_error |= HL_I2CI_SMBUS_FATAL_ERROR_SRAM_ECC;
+	if (rma_header->rma_failure.hbm_ecc)
+		smbus_alert.fatal_error |= HL_I2CI_SMBUS_FATAL_ERROR_HBM_ECC;
+	if (rma_header->rma_failure.hbm_parity)
+		smbus_alert.fatal_error |=
+				HL_I2CI_SMBUS_FATAL_ERROR_HBM_PARITY;
+	if (rma_header->rma_failure.row_replacement)
+		smbus_alert.fatal_error |=
+				HL_I2CI_SMBUS_FATAL_ERROR_ROW_REPLACEMENT;
+	if (rma_header->rma_failure.hbm_init)
+		smbus_alert.fatal_error |= HL_I2CI_SMBUS_FATAL_ERROR_HBM_INIT;
+}
+
+void i2csi_set_boot_err(enum hl_fw_fit_boot_error err, bool is_linux_boot_fail)
+{
+	struct hl_i2ci_error_status_fit_failure *fit_fail;
+	struct hl_i2ci_agent_signature_failure *sig_fail;
+	bool is_update_sig_os = false;
+	u32 err_sts_fit_err = HL_ERROR_STATUS_OTHER |
+				       (HL_ERROR_STATUS_OTHER_FIT << 8);
+
+	fit_fail = &op_err_status.fit_failure;
+	sig_fail = &op_err_status.security.agent_failure;
+
+	switch (err) {
+	case HL_FW_FIT_BOOT_ERR_NONE:
+		break;
+	case HL_FW_FIT_BOOT_ERR_CORRUPTED:
+		fit_fail->invalid_image_format = 1;
+		/* set FIT error bit of ERR_STS cmd */
+		err_sts_reg_val |= err_sts_fit_err;
+		break;
+	case HL_FW_FIT_BOOT_ERR_ADDRESS_VIOLATION:
+		fit_fail->fw_upgrade_target_address_violation = 1;
+		/* set FIT error bit of ERR_STS cmd */
+		err_sts_reg_val |= err_sts_fit_err;
+		break;
+	case HL_FW_FIT_BOOT_ERR_NOT_RUNNABLE:
+		fit_fail->fit_not_runable = 1;
+		/* set FIT error bit of ERR_STS cmd */
+		err_sts_reg_val |= err_sts_fit_err;
+		break;
+	case HL_FW_FIT_BOOT_ERR_REVOKED_KEY:
+		sig_fail->revoked_pub_key = 1;
+		is_update_sig_os = true;
+		/* set Security error bit of ERR_STS cmd */
+		err_sts_reg_val |= HL_ERROR_STATUS_SECURITY;
+		break;
+	case HL_FW_FIT_BOOT_ERR_SVN:
+		sig_fail->svn_failure = 1;
+		is_update_sig_os = true;
+		/* set Security error bit of ERR_STS cmd */
+		err_sts_reg_val |= HL_ERROR_STATUS_SECURITY;
+		break;
+	case HL_FW_FIT_BOOT_ERR_SIGNATURE:
+		sig_fail->signature_failure = 1;
+		is_update_sig_os = true;
+		/* set Security error bit of ERR_STS cmd */
+		err_sts_reg_val |= HL_ERROR_STATUS_SECURITY;
+		break;
+	}
+
+	if (is_update_sig_os) {
+		if (is_linux_boot_fail)
+			sig_fail->linux_failure = 1;
+		else
+			sig_fail->uboot_failure = 1;
+	}
+}
+
+/* running from module_lkd fast context - please consider when changing */
+int i2csi_set_wd_err(enum hl_fw_reset_cause err)
+{
+	u32 err_sts_wd_err = HL_ERROR_STATUS_OTHER |
+					(HL_ERROR_STATUS_OTHER_WATCHDOG << 8);
+
+	if (err != HL_FW_RESET_CAUSE_UNKNOWN) {
+		fw_info.reset_cause = err;
+		err_sts_reg_val |= err_sts_wd_err;
+		return 0;
+	}
+
+	return 1;
+}
diff --git a/lib/preboot/memory.c b/lib/preboot/memory.c
new file mode 100644
index 0000000..2caa977
--- /dev/null
+++ b/lib/preboot/memory.c
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2021 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <preboot.h>
+#include <memory.h>
+
+static struct mem_desc mem_desc[MEM_NOENT] = {
+	[MEM_GP] = {
+		.base = MEM_GP_BASE,
+		.size = MEM_GP_SZ,
+	},
+	[MEM_LKD_PCI] = {
+		.base = MEM_LKD_PCI_BASE,
+		.size = MEM_LKD_PCI_SZ,
+	},
+	[MEM_FWUPD_PCI] = {
+		.base = MEM_FWUPD_PCI_BASE,
+		.size = MEM_FWUPD_PCI_SZ,
+	},
+	[MEM_I2C] = {
+		.base = MEM_I2C_BASE,
+		.size = MEM_I2C_SZ,
+	},
+};
+
+__weak int preboot_get_dev_spec_mem_region(enum mem_region region,
+					   struct mem_desc *desc)
+{
+	return 1; /* not dev spec */
+}
+
+int preboot_get_mem_region(enum mem_region region, struct mem_desc *desc)
+{
+	int err;
+
+	switch (region) {
+	case MEM_GP:
+	case MEM_LKD_PCI:
+	case MEM_FWUPD_PCI:
+	case MEM_I2C:
+		break;
+	default:
+		return 1;
+	}
+
+	if (!desc)
+		return 1;
+
+	/* device defined memory regions */
+	err = preboot_get_dev_spec_mem_region(region, desc);
+	if (!err)
+		return err;
+
+	desc->base = mem_desc[region].base;
+	desc->size = mem_desc[region].size;
+
+	return 0;
+}
diff --git a/lib/preboot/module_fwupd.c b/lib/preboot/module_fwupd.c
new file mode 100644
index 0000000..2559af6
--- /dev/null
+++ b/lib/preboot/module_fwupd.c
@@ -0,0 +1,734 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2016-2020 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <libfdt.h>
+#include <stdint.h>
+#include <inttypes.h>
+#include <string.h>
+
+#include <psoc_global_conf_regs.h>
+#include <boot_if.h>
+#include <hl_fw_if.h>
+#include <preboot.h>
+#include <fit_load_type.h>
+#include <security.h>
+#include <memory.h>
+
+#include "cmd_module.h"
+#include "uart.h"
+#include "pll.h"
+#include "fit.h"
+
+#define FIT_RSP_MARGIN_SIZE_IN_KB	0x400	/* 1KB */
+#define FIT_DFL_RSP_SIZE_IN_KB		0x1000	/* 4KB */
+
+#define WFC_TIMEOUT_MS			500
+#define TIMEOUT_US			1000
+
+#define HL_FIT_LOAD_TYPE_PROP		"load-type"
+#define HL_FIT_PROTO_STATUS_PROP	"protocol-status"
+
+struct fwupd_state {
+	bool sending_error_flag;
+	unsigned int map_size;
+	void *map_offset;
+	struct hl_upd_command cmd;
+	struct hl_upd_command wfc_cmd;
+	enum cmd_check_res exec_res;
+	enum cmd_check_res sync_exec_res;
+	u32 cmd_reg;
+	u32 sts_reg;
+	u64 noret_delay;
+	void (*sts_writel)(u32 val);
+	u32 (*cmd_readl)(void);
+	bool is_disabled;
+	bool use_security;
+	bool synced_no_return;
+	enum mem_region mregion;
+};
+
+static struct fwupd_state state;
+static struct fwupd_state i2c_state;
+
+u32 fwupd_cmd_readl(void)
+{
+	return regmap_readl(mmUPD_CMD);
+}
+
+void fwupd_sts_writel(u32 val)
+{
+	regmap_writel(val, mmUPD_STS);
+}
+
+u32 i2c_fwupd_cmd_readl(void)
+{
+	return i2c_state.cmd_reg;
+}
+
+void i2c_fwupd_sts_writel(u32 val)
+{
+	i2c_state.sts_reg = val;
+}
+
+bool i2c_fwupd_owned(u32 offset)
+{
+	return offset == mmUPD_CMD || offset == mmUPD_STS;
+}
+
+#define FWUPD_NORET_DELAY_US	200000
+
+static void fwupd_sync_exec(struct fwupd_state *state)
+{
+	if (state->sync_exec_res == NOT_FOUND || !state->noret_delay)
+		return;
+
+	if (timeout_expired(state->noret_delay, FWUPD_NORET_DELAY_US)) {
+		preboot_puts("firing no ret now!\n");
+		state->exec_res = state->sync_exec_res;
+		state->sync_exec_res = NOT_FOUND;
+	}
+}
+
+/* This function is for reading status by other modules */
+u32 i2c_fwupd_readl(u32 offset)
+{
+	return i2c_state.sts_reg;
+}
+
+/* This function is for writing cmd by other modules */
+void i2c_fwupd_writel(u32 offset, u32 val)
+{
+	i2c_state.cmd_reg = val;
+}
+
+static void fwupd_get_proto_status(struct hl_upd_proto_status *status,
+				   int err, int serr)
+{
+	status->version = HL_UPD_PROTO_VERSION;
+	status->compat_mask = cpu_boot_dev_sts_get_all();
+	status->fw_comp = HL_FW_COMP_PREBOOT;
+	status->err = err;
+	status->sub_err = serr;
+}
+
+static int fwupd_create_resp(void *res_fit, const int load_type,
+		const char *prop_name, const void *prop_data,
+		int *prop_data_sz)
+{
+	int err;
+	unsigned int sz;
+
+	sz = ((*prop_data_sz + FIT_RSP_MARGIN_SIZE_IN_KB) > FIT_DFL_RSP_SIZE_IN_KB) ?
+		(*prop_data_sz + FIT_RSP_MARGIN_SIZE_IN_KB) : FIT_DFL_RSP_SIZE_IN_KB;
+
+	err = fit_init_resp(res_fit, sz);
+	if (err)
+		goto fit_init_err;
+
+	err = fdt_property_u32(res_fit, HL_FIT_LOAD_TYPE_PROP, load_type);
+	if (err)
+		goto fit_init_err;
+
+	err = fdt_property(res_fit, prop_name, prop_data, *prop_data_sz);
+	if (err)
+		goto fit_init_err;
+
+	err = fit_fin_resp(res_fit, &sz);
+	if (err)
+		goto fit_init_err;
+
+	*prop_data_sz = sz;
+
+fit_init_err:
+	return err;
+}
+
+static void module_fwupd_send_status_fast(struct fwupd_state *state,
+					  enum hl_upd_sts sts, void *offset)
+{
+	struct hl_upd_status status;
+	uintptr_t off = (uintptr_t)offset;
+
+	if (state->use_security && offset)
+		preboot_security_dynamic_img_sram_open(state->mregion,
+						       ACCESS_RO);
+
+	status.val = 0;
+	status.status = sts;
+	status.offset = (u32)(off & ~HL_UPD_STS_OFFSET_MASK);
+	state->sts_writel(status.val);
+}
+
+static int module_fwupd_proto_status(struct fwupd_state *state,
+				     struct hl_upd_proto_status *ret_status)
+{
+	struct hl_upd_proto_status status;
+	struct mem_desc mdesc;
+	u32 sts_err, sts_serr;
+	int size = sizeof(status);
+	int err;
+
+	err = preboot_get_mem_region(state->mregion, &mdesc);
+	if (err) {
+		preboot_puts("Failed requesting region for status FIT image\n");
+		return err;
+	}
+
+	state->map_offset = (void *)mdesc.base;
+
+	/*
+	 * Here we assume that the error is reported only once and
+	 * regardless of the interface
+	 */
+	preboot_error_read_and_clr(&sts_err, &sts_serr);
+	fwupd_get_proto_status(&status, sts_err, sts_serr);
+
+	err = fwupd_create_resp(state->map_offset, FIT_LOAD_TYPE_PROTO_STATUS,
+				HL_FIT_PROTO_STATUS_PROP, &status, &size);
+	state->map_size = size;
+
+	if (err)
+		preboot_puts("Failed to create status FIT image\n");
+
+	if (ret_status)
+		*ret_status = status;
+
+	return err;
+}
+
+static void module_fwupd_send_status(struct fwupd_state *state,
+				     enum hl_upd_sts sts, void *offset)
+{
+	int err;
+	void *tmp_offset = offset;
+
+	/*
+	 * can send fast if not error
+	 * if it is error - must be slow
+	 */
+	switch (sts) {
+	case HL_UPD_STS_MAP_ERR:
+	case HL_UPD_STS_ERR:
+	case HL_UPD_STS_RST_ERR:
+	case HL_UPD_STS_VALID_ERR:
+	case HL_UPD_STS_TIMEOUT_ERR:
+		/*
+		 * The error inform function, work in such a way
+		 * that the error will be set only once (assuming no
+		 * concurrency) so if the error inform function is called before
+		 * entering the current function, module_fwupd_send_status,
+		 * the second call will not overrun its values.
+		 * it allows support legacy code by setting the sent error
+		 * status as protocol error and set it's minor value.
+		 */
+		preboot_error_inform(HL_FW_ERR_PROTO, sts);
+		if (state->exec_res != FOUND_SLOW_RETURN) {
+			/*
+			 * error status response requires FIT creation, that
+			 * implies - SLOW MODE
+			 * if an error status request has been done from within
+			 * a slow mode invocation. The request can be served
+			 * and skip this conditional block.
+			 * otherwise, the control should be returned to the main
+			 * event loop,with request for change into SLOW MODE and
+			 * execute a command state to send the error status.
+			 * There is not enough commands bits to add this
+			 * command state, so the alternative for that, is using
+			 * a flag to ask for running the state. That condition
+			 * is not enough; an error should be inform in order to
+			 * trigger the response.
+			 * Both of those condition should be checked in the
+			 * module's check and run functions.
+			 * The error was set previously (2 lines above), and
+			 * the request to change the state is done by this flag.
+			 *
+			 * WARNING:	don't change state->exec_res it is the
+			 *		check function responsibility
+			 */
+			state->sending_error_flag = true;
+			break;
+		}
+
+		/* if an explicit FIT was attached - use it */
+		if (!offset) {
+			tmp_offset = state->map_offset;
+			err = module_fwupd_proto_status(state, NULL);
+
+			/* if prepare fails - just don't include it*/
+			if (err)
+				tmp_offset = 0;
+		}
+		/* no break */
+	default:
+		/* on STS_OK / STS_ACK etc,  the original offset is set */
+		module_fwupd_send_status_fast(state, sts, tmp_offset);
+	}
+
+}
+
+void module_fwupd_setup(void)
+{
+	state.cmd_readl = fwupd_cmd_readl;
+	state.sts_writel = fwupd_sts_writel;
+	state.use_security = true;
+	state.mregion = MEM_FWUPD_PCI;
+	module_fwupd_send_status(&state, HL_UPD_STS_RST_OK, NULL);
+}
+
+void module_i2c_fwupd_setup(void)
+{
+	i2c_state.cmd_readl = i2c_fwupd_cmd_readl;
+	i2c_state.sts_writel = i2c_fwupd_sts_writel;
+	i2c_state.use_security = false;
+	i2c_state.synced_no_return = true;
+	i2c_state.mregion = MEM_I2C;
+	module_fwupd_send_status(&i2c_state, HL_UPD_STS_RST_OK, NULL);
+}
+
+/* NOOP is a sync command, so here we decide what execution type is needed */
+static enum cmd_check_res module_fwupd_check_noop(struct fwupd_state *state)
+{
+	enum cmd_check_res res = NOT_FOUND;
+
+	/* check the command we got before waiting for sync */
+	switch (state->wfc_cmd.cmd) {
+	case HL_UPD_NOOP:
+		break;
+	case HL_UPD_RUN_SRAM:
+	case HL_UPD_RUN_SPSRAM:
+	case HL_UPD_GET_PROTO_STATUS:
+		res = FOUND_SLOW_RETURN;
+		break;
+	case HL_UPD_RST_STATE:
+	case HL_UPD_MAP_SRAM:
+	case HL_UPD_MAP_SPSRAM:
+	default:
+		res = FOUND_FAST_RETURN;
+		break;
+	}
+
+	return res;
+}
+
+static enum cmd_check_res __module_fwupd_check(struct fwupd_state *state)
+{
+	enum cmd_check_res res = NOT_FOUND;
+
+	if (state->is_disabled)
+		return res;
+
+	/*
+	 * the error status response, involved
+	 * the creation of a FIT file.
+	 * this implies a slow return
+	 * Due to the lack of commands numbers the cmd state (4 bits)
+	 * can't be change to a specific state therefore a flag was added
+	 * other option is to add an internal cmd level.
+	 */
+	if (state->sending_error_flag && preboot_error_is_pending())
+		return FOUND_SLOW_RETURN;
+
+	fwupd_sync_exec(state);
+	if (state->exec_res != NOT_FOUND)
+		return state->exec_res;
+
+	state->cmd.val = state->cmd_readl();
+
+	if (state->cmd.cmd == state->wfc_cmd.cmd)
+		return NOT_FOUND;
+
+	switch (state->cmd.cmd) {
+	case HL_UPD_NOOP:	/* NOOP is a special command */
+		res = module_fwupd_check_noop(state);
+		break;
+	case HL_UPD_CLR_STS:
+	case HL_UPD_RST_STATE:
+	case HL_UPD_MAP_SRAM:
+	case HL_UPD_MAP_SPSRAM:
+	case HL_UPD_RUN_SRAM:
+	case HL_UPD_RUN_SPSRAM:
+	case HL_UPD_GET_PROTO_STATUS:
+		res = FOUND_FAST_RETURN;
+		break;
+	default:
+		break;
+	}
+
+	return res;
+}
+
+enum cmd_check_res module_fwupd_check(void)
+{
+	return __module_fwupd_check(&state);
+}
+
+enum cmd_check_res module_i2c_fwupd_check(void)
+{
+	return __module_fwupd_check(&i2c_state);
+}
+
+static void module_fwupd_state_shift(struct fwupd_state *state)
+{
+	/* do not shift if got CLR_STS several times */
+	if (state->cmd.cmd == HL_UPD_CLR_STS)
+		return;
+
+	/* save current command waiting for clear, until handled */
+	state->wfc_cmd = state->cmd;
+}
+
+static void module_fwupd_reset_state(struct fwupd_state *state)
+{
+	state->cmd.val = 0;	/* NOOP */
+	state->wfc_cmd.val = 0;	/* NOOP */
+	state->exec_res = NOT_FOUND;
+	state->sync_exec_res = NOT_FOUND;
+	state->map_size = 0;
+	state->map_offset = NULL;
+	state->sending_error_flag = false;
+	state->noret_delay = 0;
+}
+
+static void module_fwupd_reset_state_secure(struct fwupd_state *state)
+{
+	module_fwupd_reset_state(state);
+	preboot_set_sram_sf_access(false);
+	preboot_security_dynamic_img_sram_close();
+	preboot_security_dynamic_img_spsram_close();
+}
+
+void module_fwupd_pcie_disable(bool is_pcie_disabled)
+{
+	state.is_disabled = is_pcie_disabled;
+}
+
+bool module_fwupd_is_disabled(void)
+{
+	return state.is_disabled;
+}
+
+static enum hl_upd_sts module_fwupd_map(struct fwupd_state *state,
+					unsigned int size, enum hl_upd_cmd cmd)
+{
+	int err;
+	struct mem_desc mdesc;
+	enum hl_upd_sts sts = HL_UPD_STS_MAP_OK;
+	uintptr_t base_offset;
+
+	err = preboot_get_mem_region(state->mregion, &mdesc);
+	if (err) {
+		preboot_puts("Failed requesting memory region for map\n");
+		return HL_UPD_STS_MAP_ERR;
+	}
+
+	base_offset = cmd == HL_UPD_MAP_SRAM ? mdesc.base : FIT_IMG_SPSRAM_BASE;
+
+	err = !preboot_is_valid_address_range(base_offset, size);
+	if (err || size > mdesc.size) {
+		preboot_puts("Map address range is invalid\n");
+		return HL_UPD_STS_VALID_ERR;
+	}
+
+	state->map_offset = (void *)base_offset;
+	state->map_size = size;
+
+	if (state->use_security) {
+		if (cmd == HL_UPD_MAP_SRAM)
+			preboot_security_dynamic_img_sram_open(state->mregion,
+							       ACCESS_RW);
+		else
+			preboot_security_dynamic_img_spsram_open();
+	}
+
+	return sts;
+}
+
+static void module_fwupd_run_fast_noop(struct fwupd_state *state)
+{
+	enum hl_upd_sts sts = HL_UPD_STS_NOOP;
+
+	/* depending on the current state machine, perform action */
+	switch (state->wfc_cmd.cmd) {
+	case HL_UPD_NOOP:
+	case HL_UPD_CLR_STS:
+		break;
+	case HL_UPD_RST_STATE:
+		module_fwupd_reset_state_secure(state);
+		module_fwupd_send_status(state, HL_UPD_STS_RST_OK, NULL);
+		break;
+	case HL_UPD_MAP_SRAM:
+	case HL_UPD_MAP_SPSRAM:
+		sts = module_fwupd_map(state,
+				       state->wfc_cmd.size, state->wfc_cmd.cmd);
+		module_fwupd_send_status(state, sts, state->map_offset);
+		break;
+	case HL_UPD_RUN_SRAM:
+	case HL_UPD_RUN_SPSRAM:
+	case HL_UPD_GET_PROTO_STATUS:
+	default:	/* should never get here */
+		preboot_puts_raw(__func__);
+		preboot_puts(": default case - err\n");
+	}
+}
+
+static void __module_fwupd_run_fast(struct fwupd_state *state)
+{
+	const char *cmd_str = NULL;
+	const char *err_str = NULL;
+	enum hl_upd_sts sts = HL_UPD_STS_NOOP;
+	int err = 0;
+
+	switch (state->cmd.cmd) {
+	case HL_UPD_NOOP:	/* NOOP is a special command */
+		cmd_str = "noop";
+		module_fwupd_run_fast_noop(state);
+		break;
+	case HL_UPD_CLR_STS:
+		cmd_str = "clr_sts";
+		/* Clear the status */
+		module_fwupd_send_status(state, HL_UPD_STS_NOOP, NULL);
+		break;
+	case HL_UPD_RST_STATE:
+		cmd_str = "rst_state";
+		module_fwupd_send_status(state, HL_UPD_STS_RST_ACK, NULL);
+		break;
+	case HL_UPD_MAP_SRAM:
+		cmd_str = "map_sram";
+		/* no break */
+	case HL_UPD_MAP_SPSRAM:
+		cmd_str = cmd_str ?: "map_spsram";
+		/* Protect from multi-MAP */
+		if (state->map_offset || state->map_size) {
+			sts = HL_UPD_STS_VALID_ERR;
+			err_str = "MAP is already in progress...";
+			err = 1;
+		} else {
+			sts = HL_UPD_STS_MAP_ACK;
+		}
+
+		module_fwupd_send_status(state, sts, NULL);
+		break;
+	case HL_UPD_RUN_SRAM:
+		cmd_str = "run_sram";
+		/* no break */
+	case HL_UPD_RUN_SPSRAM:
+		cmd_str = cmd_str ?: "run_spsram";
+		/* Protect from RUN before MAP */
+		if (state->map_offset && state->map_size) {
+			sts = HL_UPD_STS_ACK;
+		} else {
+			sts = HL_UPD_STS_VALID_ERR;
+			err_str = "RUN is not allowed before MAP...";
+			err = 1;
+		}
+
+		module_fwupd_send_status(state, sts, NULL);
+		break;
+	case HL_UPD_GET_PROTO_STATUS:
+		cmd_str = "proto_status";
+		module_fwupd_send_status(state, HL_UPD_STS_ACK, NULL);
+		/* We ACK the command, but handle only on CLR, so save cmd */
+		break;
+	default:
+		cmd_str = "unknown";
+		module_fwupd_send_status(state, HL_UPD_STS_VALID_ERR, NULL);
+		err = 1;
+		break;
+	}
+
+	if (!err)
+		module_fwupd_state_shift(state);
+
+	if (state->cmd.cmd != HL_UPD_CLR_STS) {
+		preboot_puts_raw("FW UPD ");
+		preboot_puts_raw(cmd_str);
+		preboot_puts(" received\n");
+	}
+
+	if (err_str) {
+		preboot_puts_raw(err_str);
+		preboot_puts("\n");
+	}
+}
+
+void module_fwupd_run_fast(void)
+{
+	__module_fwupd_run_fast(&state);
+}
+
+void module_i2c_fwupd_run_fast(void)
+{
+	__module_fwupd_run_fast(&i2c_state);
+}
+
+__weak void preboot_nic_en(u32 nic_en) {}
+
+static int module_fwupd_load_type_nic_en(void *fit)
+{
+	int err;
+	const void *data = 0;
+
+	err = fit_image_get_loadable_data(fit, &data, sizeof(u32));
+	if (!err)
+		preboot_nic_en(*(u32 *)data);
+
+	return err;
+}
+
+__weak int rma_erase(void)
+{
+	return 1;
+}
+
+static int module_fwupd_load_type_run(struct fwupd_state *state, void *fit)
+{
+	int err;
+
+	state->exec_res = NOT_FOUND;
+
+	err = fit_load_images(fit);
+	if (err)
+		return err;
+
+	if (state->synced_no_return) {
+		state->sync_exec_res = FOUND_NO_RETURN;
+		state->noret_delay = timestamp_get_us();
+	} else {
+		state->exec_res = FOUND_NO_RETURN;
+	}
+
+	return err;
+}
+
+static int module_fwupd_load_type(struct fwupd_state *state)
+{
+	u32 load_type;
+	int ret;
+
+	ret = fit_get_load_type(state->map_offset, &load_type);
+	if (ret)
+		return 1;
+
+	switch (load_type) {
+	case FIT_LOAD_TYPE_NIC_EN_MASK:
+		return module_fwupd_load_type_nic_en(state->map_offset);
+	case FIT_LOAD_TYPE_RMA_ERASE:
+		return rma_erase();
+	case FIT_LOAD_TYPE_FW_UPD_CLOSURE:
+		module_fwupd_pcie_disable(true);
+		break;
+	case FIT_LOAD_TYPE_RUN:
+		return module_fwupd_load_type_run(state, state->map_offset);
+	default:
+		preboot_puts("Unknown FIT load type\n");
+		return 1;
+	}
+
+	return 0;
+}
+
+static enum hl_upd_sts module_fwupd_run_cmd(struct fwupd_state *state,
+					    enum hl_upd_cmd cmd,
+					    enum hl_upd_sts *status)
+{
+	int err;
+	enum hl_upd_sts sts = HL_UPD_STS_OK;
+
+	/*
+	 * we do not allow mapping of SRAM and SPSRAM at the same time -
+	 * close both.
+	 */
+	preboot_set_sram_sf_access(false);
+	preboot_security_dynamic_img_sram_close();
+	preboot_security_dynamic_img_spsram_close();
+
+	err = module_fwupd_load_type(state);
+
+	if (cmd == HL_UPD_RUN_SPSRAM)
+		memset(state->map_offset, 0, ROUND_UP4(state->map_size));
+
+	if (err) {
+		sts = HL_UPD_STS_ERR;
+		preboot_puts("Failed to load FIT image\n");
+	}
+
+	*status = sts;
+
+	return err;
+}
+
+static void module_fwupd_push_error_status(struct fwupd_state *state)
+{
+	int err;
+	void *offset = state->map_offset;
+	struct hl_upd_proto_status status;
+
+	err = module_fwupd_proto_status(state, &status);
+	if (err)
+		offset = 0;
+
+	module_fwupd_send_status(state, status.err, offset);
+}
+
+void __module_fwupd_run(struct fwupd_state *state)
+{
+	enum hl_upd_sts sts = HL_UPD_STS_NOOP;
+	int err = 0;
+
+	if (state->sending_error_flag && preboot_error_is_pending()) {
+		preboot_puts("FW UPD prepare ERROR_STATUS\n");
+		module_fwupd_push_error_status(state);
+		state->sending_error_flag = false;
+	}
+
+	switch (state->wfc_cmd.cmd) {
+	case HL_UPD_RUN_SRAM:
+	case HL_UPD_RUN_SPSRAM:
+		err = module_fwupd_run_cmd(state, state->wfc_cmd.cmd, &sts);
+		module_fwupd_send_status(state, sts, NULL);
+		break;
+	case HL_UPD_GET_PROTO_STATUS:
+		err = module_fwupd_proto_status(state, NULL);
+		if (err)
+			module_fwupd_send_status(state, HL_UPD_STS_ERR, NULL);
+		else
+			module_fwupd_send_status(state, HL_UPD_STS_OK,
+						 state->map_offset);
+		break;
+	default:	/* should never get here */
+		preboot_puts_raw(__func__);
+		preboot_puts(": default case - err\n");
+	}
+
+	/* NOTE: at this point we have code that reset the protocol FSM state,
+	 *       on error, and only registers on NOT_FOUND result.
+	 *       Do not run the secured version here. The response memory must
+	 *       be kept open until an explicit request for RST_STATE invoked
+	 *       by the host arrives.
+	 */
+	if (err) {
+		module_fwupd_reset_state(state);
+	} else if (state->exec_res == NOT_FOUND) {
+		state->wfc_cmd.val = 0;	/* NOOP - clear cmds state machine */
+		state->cmd.val = 0;	/* NOOP */
+	}
+}
+
+void module_fwupd_run(void)
+{
+	__module_fwupd_run(&state);
+}
+
+void module_i2c_fwupd_run(void)
+{
+	__module_fwupd_run(&i2c_state);
+}
+
+void module_fwupd_run_noret(void)
+{
+	hl_ts_shutdown();
+	fit_run_image();
+}
diff --git a/lib/preboot/module_i2c_slave.c b/lib/preboot/module_i2c_slave.c
new file mode 100644
index 0000000..ef1f03c
--- /dev/null
+++ b/lib/preboot/module_i2c_slave.c
@@ -0,0 +1,247 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2020 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <stdint.h>
+#include <preboot.h>
+#include <hl_i2c_slave_events.h>
+#include <hl_i2c_indirect.h>
+#include <boot_if.h>
+#include <crc8.h>
+
+#include "thermal.h"
+#include "module_i2c_slave.h"
+#include "i2cslave_indirect.h"
+#include "fit.h"
+
+u8 i2cslave_pec;
+u8 i2cslave_valid_pec;
+
+static u8 pec_table[CRC8_TABLE_SIZE];
+
+static bool is_fit_checked;
+
+__weak int hl_dram_get_adjusted_max_temp(void)
+{
+	return 0;
+}
+
+int get_composite_temp(void)
+{
+	int max_dram_adjusted_temp = hl_dram_get_adjusted_max_temp();
+	int max_onchip_temp = hl_ts_get_max_temp();
+
+	/* Convert from mC to C */
+	max_onchip_temp /= 1000;
+
+	return (max_dram_adjusted_temp > max_onchip_temp) ? max_dram_adjusted_temp :
+							max_onchip_temp;
+}
+
+static u8 i2cslave_core_voltage_cmd(u8 cmd)
+{
+	switch (cmd) {
+	case HL_VOLTAGES_ASIC_CORE_LOW:
+		return (u8)HL_ASIC_CORE_VOLTAGE;
+	case HL_VOLTAGES_ASIC_CORE_HIGH:
+		return (u8)(HL_ASIC_CORE_VOLTAGE >> 8);
+	default:
+		return 0;
+	}
+}
+
+__weak bool is_nvme_mi_compatible(void)
+{
+	return true;
+}
+
+u8 i2cslave_handle_read_req(u8 cmd, u32 read_seq)
+{
+	u8 ret;
+
+	switch (cmd) {
+	case HL_ASIC_TEMP_CMD_CODE:
+		if (is_nvme_mi_compatible())
+			ret = HL_ASIC_TEMP_CMD_CODE_LEN;
+		else
+			ret = get_composite_temp();
+		break;
+	case HL_ASIC_TEMP_MAX_VAL:
+		ret = get_composite_temp();
+		break;
+	case HL_DEVICE_STATUS_CMD_CODE:
+		ret = HL_DEVICE_STATUS_CMD_CODE_LEN;
+		break;
+	case HL_DEVICE_STATUS:
+		ret = HL_DEVICE_STATUS_PREBOOT;
+		break;
+	case HL_PCIE_VENDOR_ID_VAL_LOW:
+	case HL_PCIE_VENDOR_ID_VAL_HIGH:
+	case HL_PCIE_DEVICE_ID_VAL_LOW:
+	case HL_PCIE_DEVICE_ID_VAL_HIGH:
+		ret = i2cslave_pcie_vendor_id_cmd(cmd);
+		break;
+	case HL_ASIC_SERIAL_NUMBER_0 ... HL_ASIC_SERIAL_NUMBER_17:
+		ret = i2cslave_asic_sn_cmd(cmd);
+		break;
+	case HL_VERSIONS_CMD_CODE:
+	case HL_VERSIONS_FW_MAJOR_VER_VAL:
+	case HL_VERSIONS_FW_MINOR_VER_VAL:
+	case HL_VERSIONS_FW_ADDITIONAL_VER_VAL:
+		ret = i2cslave_version_cmd(cmd);
+		break;
+	case HL_ERROR_STATUS_CODE:
+		ret = HL_ERROR_STATUS_CMD_LEN;
+		break;
+	case HL_ERROR_STATUS_ALERT_CAUSE_1:
+	case HL_ERROR_STATUS_ALERT_CAUSE_2:
+		ret = i2cslave_error_status_cmd(cmd);
+		break;
+	case HL_INDIRECT_REQ_STS_CODE:
+		ret = HL_I2CI_REQ_STS_LEN;
+		break;
+		/* Fall through */
+	case HL_INDIRECT_REQ_STS_DATA:
+	case HL_INDIRECT_REQ_STS_DATA_1:
+	case HL_INDIRECT_REQ_STS_DATA_2:
+	case HL_INDIRECT_REQ_STS_DATA_3:
+	case HL_INDIRECT_REQ_STS_DATA_4:
+		ret = i2csi_req_handle_sts(cmd);
+		break;
+	case HL_INDIRECT_REQ_WDATA_CODE:
+		ret = HL_I2CI_REQ_WDATA_LEN;
+		break;
+	case HL_INDIRECT_REQ_CFG_CODE:
+		ret = HL_I2CI_REQ_CFG_LEN;
+		break;
+	case HL_INDIRECT_REQ_RDATA_CODE:
+		if (!read_seq) {
+			ret = HL_I2CI_REQ_RDATA_LEN;
+			break;
+		}
+	case HL_INDIRECT_REQ_RDATA_DATA:
+	case HL_INDIRECT_REQ_RDATA_DATA_1:
+	case HL_INDIRECT_REQ_RDATA_DATA_2:
+	case HL_INDIRECT_REQ_RDATA_DATA_3:
+		ret = i2csi_req_handle_rdata(cmd, read_seq);
+		break;
+	case HL_INDIRECT_CTRL_CMD_CODE:
+		ret = HL_I2CI_CTRL_CMD_LEN;
+		break;
+	case HL_INDIRECT_CTRL_STS_CODE:
+		ret = HL_I2CI_CTRL_STS_LEN;
+		break;
+	case HL_INDIRECT_CTRL_STS_DATA:
+	case HL_INDIRECT_CTRL_STS_DATA_1:
+	case HL_INDIRECT_CTRL_STS_DATA_2:
+	case HL_INDIRECT_CTRL_STS_DATA_3:
+		ret = i2csi_ctrl_handle_status(cmd);
+		break;
+	case HL_MODULE_POWER_STATE:
+		ret = HL_MODULE_POWER_FULL;
+		break;
+	case HL_MODULE_I2C_FREQ:
+		ret = HL_SLAVE_FREQ_400KHZ;
+		break;
+	case HL_MODULE_TDP_LEVEL:
+		ret = HL_MODULE_TDP_LEVEL_1;
+		break;
+	case HL_VOLTAGES_ASIC_CORE_LOW:
+	case HL_VOLTAGES_ASIC_CORE_HIGH:
+		ret = i2cslave_core_voltage_cmd(cmd);
+		break;
+	default:
+		if (HL_I2C_EVENT_IS_PEC(cmd))
+			ret = i2cslave_pec;
+		else
+			ret = 0;
+		break;
+	}
+
+	return ret;
+}
+
+u32 i2cslave_handle_write_req(u8 cmd, u8 **data, u8 cnt)
+{
+	switch (cmd) {
+	case HL_INDIRECT_REQ_WDATA_CODE:
+	case HL_INDIRECT_REQ_WDATA_DATA:
+		return i2csi_req_handle_wdata(cmd, data, cnt);
+	case HL_INDIRECT_REQ_CFG_CODE:
+	case HL_INDIRECT_REQ_CFG_DATA:
+	case HL_INDIRECT_REQ_CFG_PEC:
+		return i2csi_req_handle_cfg(cmd, data, cnt);
+	case HL_INDIRECT_CTRL_CMD_CODE:
+	case HL_INDIRECT_CTRL_CMD_DATA:
+	case HL_INDIRECT_CTRL_CMD_DATA_1:
+	case HL_INDIRECT_CTRL_CMD_DATA_2:
+	case HL_INDIRECT_CTRL_CMD_DATA_3:
+	case HL_INDIRECT_CTRL_CMD_PEC:
+		return i2csi_ctrl_handle_command(cmd, data, cnt);
+	case HL_INDIRECT_REQ_RDATA_CODE:
+	case HL_INDIRECT_REQ_RDATA_DATA:
+		i2csi_req_set_idle();
+		/* Fall Though */
+	default:
+		return 0;
+	}
+}
+
+void i2cslave_handle_sync_error(void)
+{
+	i2csi_req_handle_sync_error();
+}
+
+void i2cslave_fit_set_checked(void)
+{
+	is_fit_checked = true;
+}
+
+bool i2cslave_fit_is_checked(void)
+{
+	return is_fit_checked;
+}
+
+void i2cslave_fit_run_image(void)
+{
+	fit_run_image();
+}
+
+bool i2cslave_indirect_is_process_op(void)
+{
+	return i2csi_req_is_process_op();
+}
+
+void i2cslave_indirect_process_op(void)
+{
+	i2csi_req_handle_process_op();
+}
+
+bool i2cslave_indirect_op_is_fast(void)
+{
+	return i2csi_req_op_is_fast();
+}
+
+bool i2cslave_is_reset_dev(void)
+{
+	return i2csi_ctrl_is_rst_dev();
+}
+
+void i2cslave_reset_dev(void)
+{
+	cpu_boot_sts_set(CPU_BOOT_STATUS_IN_WFE);
+	hl_dev_reset();	/* should not return */
+}
+
+void i2cslave_pec_init(void)
+{
+	crc8_populate_msb(pec_table, HL_I2C_CRC8_POLYNOMIAL);
+}
+
+void i2cslave_pec_digest(u8 val)
+{
+	i2cslave_pec = crc8(pec_table, &val, 1, i2cslave_pec);
+}
diff --git a/lib/preboot/module_lkd.c b/lib/preboot/module_lkd.c
new file mode 100644
index 0000000..7946254
--- /dev/null
+++ b/lib/preboot/module_lkd.c
@@ -0,0 +1,603 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2016-2020 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <string.h>
+#include <hl_boot_if.h>
+#include <hl_fw_if.h>
+#include <preboot.h>
+#include <boot_if.h>
+#include <boot_info.h>
+#include <security.h>
+#include <crc32.h>
+#include <memory.h>
+#include <fit_load_type.h>
+
+#include "cmd_module.h"
+#include "i2cslave_indirect.h"
+#include "uart.h"
+#include "fit.h"
+
+struct lkd_status {
+	struct comms_command cmd;
+	struct comms_command wfc_cmd;
+	struct comms_command do_cmd;
+	enum cmd_check_res exec_res;
+	unsigned int next_size;
+	bool is_elbi_desc;
+	bool is_load_fit;
+	u32 fit_load_type;
+};
+
+static struct lkd_status sts;
+
+void module_lkd_enable(void)
+{
+	cpu_boot_dev_sts_clrset(CPU_BOOT_DEV_STS0_FW_LD_COM_EN, true);
+	cpu_boot_sts_set(CPU_BOOT_STATUS_WAITING_FOR_BOOT_FIT);
+}
+
+__weak void lkd_dev_specific_setup(void) {}
+
+void module_lkd_setup(void)
+{
+	lkd_dev_specific_setup();
+	module_lkd_enable();
+}
+
+static void module_lkd_send_status(enum comms_sts sts,
+				   enum comms_ram_types ram_type,
+				   unsigned int offset)
+{
+	struct comms_status status;
+	u32 off = offset >> COMMS_STATUS_OFFSET_ALIGN_SHIFT;
+
+	status.val = 0;
+	status.status = sts;
+	status.ram_type = ram_type;
+	status.offset = off & COMMS_STATUS_OFFSET_MASK;
+	cpu_comms_sts_set(&status);
+}
+
+static bool is_legacy_comms(u32 msg)
+{
+	return msg > 0 && msg < KMD_MSG_LAST;
+}
+
+static enum cmd_check_res module_lkd_check_legacy(void)
+{
+	preboot_puts("legacy LKD not supported.\n");
+
+	/* clear command register */
+	cpu_boot_cmd_clr_before_wfe();
+	sts.cmd.val = 0;
+
+	return NOT_FOUND;
+}
+
+static int module_lkd_msg_reset_cause(struct lkd_fw_comms_msg *mcomms)
+{
+	int err = 1;
+
+	switch (mcomms->reset_cause) {
+	case HL_RESET_CAUSE_HEARTBEAT:
+		err = i2csi_set_wd_err(HL_FW_RESET_CAUSE_HEARTBEAT);
+		break;
+	case HL_RESET_CAUSE_TDR:
+		err = i2csi_set_wd_err(HL_FW_RESET_CAUSE_TDR);
+		/* no break */
+	default:
+		break;
+	}
+
+	return err;
+}
+
+static int module_lkd_msg_process(struct lkd_fw_comms_msg *mcomms)
+{
+	int err = 1;
+
+	switch (mcomms->header.type) {
+	case HL_COMMS_RESET_CAUSE_TYPE:
+		err = module_lkd_msg_reset_cause(mcomms);
+		/* no break */
+	default:
+		break;
+	}
+
+	return err;
+}
+
+static int module_lkd_sram_sf_access(void *fit)
+{
+	int err;
+	const void *data = 0;
+
+	err = fit_image_get_loadable_data(fit, &data, sizeof(u32));
+	if (!err)
+		err = preboot_set_sram_sf_access(*(u32 *)data);
+
+	return err;
+}
+
+static int lkd_get_image_addr(struct mem_desc *desc)
+{
+	int err = 0;
+
+	if (sts.is_elbi_desc) {
+		desc->base = (uintptr_t)FIT_IMG_SPSRAM_BASE;
+		desc->size = FIT_IMG_SPSRAM_MAX_SIZE;
+	} else {
+		/*
+		 * For non-ELBI descriptor, the same SRAM addr is used for both
+		 * the descriptor and the image.
+		 */
+		err = preboot_get_mem_region(MEM_LKD_PCI, desc);
+	}
+
+	return err;
+}
+
+static int module_lkd_run_fast_exec(void)
+{
+	struct lkd_fw_comms_msg *mcomms;
+	struct mem_desc desc;
+	int err;
+
+	err = lkd_get_image_addr(&desc);
+	if (err)
+		return err;
+
+	if (!sts.is_load_fit) {
+		mcomms = (struct lkd_fw_comms_msg *)desc.base;
+
+		return module_lkd_msg_process(mcomms);
+	}
+
+	switch (sts.fit_load_type) {
+	case FIT_LOAD_TYPE_SRAM_SF_ACCESS:
+		err = module_lkd_sram_sf_access((void *)desc.base);
+		break;
+	default:
+		err = 1;
+	}
+
+	return err;
+}
+
+static void module_lkd_reset_state(void)
+{
+	sts.exec_res = NOT_FOUND;
+	sts.next_size = 0;
+	sts.cmd.val = 0;
+	sts.wfc_cmd.val = 0;
+	sts.do_cmd.val = 0;
+	sts.is_elbi_desc = false;
+	sts.is_load_fit = false;
+	sts.fit_load_type = 0;
+}
+
+static void module_lkd_run_fast_noop(void)
+{
+	int err;
+
+	/* depending on the current state machine, perform action */
+	switch (sts.do_cmd.cmd) {
+	case COMMS_NOOP:
+	case COMMS_CLR_STS:
+	case COMMS_GOTO_WFE:
+	case COMMS_SKIP_BMC:
+	case COMMS_LOW_PLL_OPP:
+		module_lkd_send_status(COMMS_STS_NOOP, COMMS_SRAM, 0);
+		break;
+	case COMMS_RST_STATE:
+		module_lkd_reset_state();
+		module_lkd_send_status(COMMS_STS_OK, COMMS_SRAM, 0);
+		break;
+	case COMMS_EXEC:
+		err = module_lkd_run_fast_exec();
+		if (err)
+			module_lkd_send_status(COMMS_STS_ERR, COMMS_SRAM, 0);
+		else
+			module_lkd_send_status(COMMS_STS_OK, COMMS_SRAM, 0);
+
+		break;
+	default:	/* should never get here */
+		preboot_puts_raw(__func__);
+		preboot_puts(": default case - err\n");
+	}
+}
+
+/* NOOP is a sync command, so here we decide what execution type is needed */
+static enum cmd_check_res module_lkd_check_noop(void)
+{
+	enum cmd_check_res res = NOT_FOUND;
+
+	/* check the command we got before waiting for sync */
+	switch (sts.do_cmd.cmd) {
+	case COMMS_PREP_DESC:
+	case COMMS_PREP_DESC_ELBI:
+	case COMMS_DATA_RDY:
+		res = FOUND_SLOW_RETURN;
+		break;
+	case COMMS_EXEC:
+		res = sts.exec_res;
+		break;
+	case COMMS_RST_DEV:
+		res = FOUND_NO_RETURN;
+		break;
+	case COMMS_GOTO_WFE:
+		if (!preboot_security_is_enabled()) {
+			res = FOUND_NO_RETURN;
+			break;
+		}
+		/* no break */
+	case COMMS_NOOP:
+	case COMMS_CLR_STS:
+	case COMMS_RST_STATE:
+	case COMMS_SKIP_BMC:
+	case COMMS_LOW_PLL_OPP:
+	default:
+		res = FOUND_FAST_RETURN;
+		break;
+	}
+
+	return res;
+}
+
+enum cmd_check_res module_lkd_check(void)
+{
+	enum cmd_check_res res = NOT_FOUND;
+
+	sts.cmd.val = cpu_boot_cmd_get();
+	if (is_legacy_comms(sts.cmd.val))
+		return module_lkd_check_legacy();
+
+	if (sts.cmd.cmd == sts.wfc_cmd.cmd)
+		return NOT_FOUND;
+
+	switch (sts.cmd.cmd) {
+	case COMMS_NOOP:	/* NOOP is a special command */
+		res = module_lkd_check_noop();
+		break;
+	case COMMS_PREP_DESC:
+	case COMMS_PREP_DESC_ELBI:
+		sts.exec_res = NOT_FOUND;
+		sts.next_size = sts.cmd.size;
+		/* no break */
+	case COMMS_CLR_STS:
+	case COMMS_RST_STATE:
+	case COMMS_DATA_RDY:
+	case COMMS_EXEC:
+	case COMMS_RST_DEV:
+	case COMMS_GOTO_WFE:
+	case COMMS_SKIP_BMC:
+	case COMMS_LOW_PLL_OPP:
+		res = FOUND_FAST_RETURN;
+		break;
+	default:
+		break;
+	}
+
+	return res;
+}
+
+void module_lkd_disable(void)
+{
+	cpu_boot_sts_set(CPU_BOOT_STATUS_IN_PREBOOT);
+}
+
+static void module_lkd_state_shift(void)
+{
+	/* do not shift if got CLR_STS several times */
+	if (sts.cmd.cmd == COMMS_CLR_STS && sts.wfc_cmd.cmd == COMMS_CLR_STS)
+		return;
+
+	/* CLR_STS should not propagate to do_cmd */
+	sts.do_cmd.cmd = sts.wfc_cmd.cmd == COMMS_CLR_STS ? COMMS_NOOP : sts.wfc_cmd.cmd;
+	/* save current command waiting for clear, until handled */
+	sts.wfc_cmd = sts.cmd;
+}
+
+void module_lkd_run_fast(void)
+{
+	const char *cmd_str = NULL;
+	const char *err_str = NULL;
+
+	switch (sts.cmd.cmd) {
+	case COMMS_NOOP:
+		cmd_str = "noop";
+		module_lkd_run_fast_noop();
+		break;
+	case COMMS_CLR_STS:
+		cmd_str = "clr_sts";
+		/* Clear the status */
+		module_lkd_send_status(COMMS_STS_NOOP, COMMS_SRAM, 0);
+		break;
+	case COMMS_RST_STATE:
+		cmd_str = "rst_state";
+		/* no break */
+	case COMMS_PREP_DESC:
+		cmd_str = cmd_str ?: "prep_desc";
+		/* no break */
+	case COMMS_PREP_DESC_ELBI:
+		cmd_str = cmd_str ?: "prep_desc_elbi";
+		/* no break */
+	case COMMS_DATA_RDY:
+		cmd_str = cmd_str ?: "data_rdy";
+		/* no break */
+	case COMMS_EXEC:
+		cmd_str = cmd_str ?: "exec";
+		/* no break */
+	case COMMS_RST_DEV:
+		cmd_str = cmd_str ?: "rst_dev";
+		module_lkd_send_status(COMMS_STS_ACK, COMMS_SRAM, 0);
+		/* We ACK the command, but handle only on CLR, so save cmd */
+		break;
+	case COMMS_GOTO_WFE:
+		cmd_str = "wfe";
+		if (preboot_security_is_enabled()) {
+			module_lkd_send_status(COMMS_STS_ERR, COMMS_SRAM, 0);
+			err_str = "WFE denied - security is enabled...";
+		} else {
+			module_lkd_send_status(COMMS_STS_ACK, COMMS_SRAM, 0);
+		}
+
+		break;
+	case COMMS_SKIP_BMC:
+		cmd_str = "skip_bmc";
+		/* no break */
+	case COMMS_LOW_PLL_OPP:
+		cmd_str = cmd_str ?: "low_pll_opp";
+		/* no break */
+	default:
+		cmd_str = cmd_str ?: "unknown";
+		module_lkd_send_status(COMMS_STS_ERR, COMMS_SRAM, 0);
+	}
+
+	/* no problem to shift on error, as later we check the validity */
+	module_lkd_state_shift();
+
+	preboot_puts_raw("Got host ");
+	preboot_puts_raw(cmd_str);
+	preboot_puts(" command\n");
+
+	if (err_str) {
+		preboot_puts_raw(err_str);
+		preboot_puts("\n");
+	}
+}
+
+static int module_lkd_msg_validate(uintptr_t offset)
+{
+	struct lkd_fw_comms_msg *mcomms = (struct lkd_fw_comms_msg *)offset;
+	int err = 1;
+
+	if (HL_COMMS_MSG_MAGIC_VALIDATE(mcomms->header.magic,
+					HL_COMMS_MSG_MAGIC_V1)) {
+		sts.exec_res = FOUND_FAST_RETURN;
+		err = 0;
+	}
+
+	return err;
+}
+
+static int module_lkd_validate(void)
+{
+	int err;
+	struct mem_desc desc;
+
+	preboot_set_sram_sf_access(false);
+	preboot_security_dynamic_img_sram_close();
+	preboot_security_dynamic_img_spsram_close();
+
+	err = lkd_get_image_addr(&desc);
+	if (err) {
+		preboot_puts("LKD: failed requesting memory\n");
+		return err;
+	}
+
+	err = fit_get_load_type((void *)desc.base, &sts.fit_load_type);
+	sts.is_load_fit = !err;
+
+	if (!sts.is_load_fit) {
+		/* shared mem doesn't contain fit image. */
+		err = module_lkd_msg_validate(desc.base);
+		if (err)
+			sts.exec_res = NOT_FOUND;
+
+		return err;
+	}
+
+	switch (sts.fit_load_type) {
+	case FIT_LOAD_TYPE_SRAM_SF_ACCESS:
+		sts.exec_res = FOUND_FAST_RETURN;
+		break;
+	case FIT_LOAD_TYPE_RUN:
+		/* validate if shared memory has fit image */
+		err = fit_load_images((void *)desc.base);
+		if (!err)
+			sts.exec_res = FOUND_NO_RETURN;
+
+		break;
+	default:
+		preboot_puts("LKD: Unknown FIT load type\n");
+		err = 1;
+	}
+
+	return err;
+}
+
+static int module_lkd_run_exec(void)
+{
+	/* Placeholder - empty for now */
+
+	return 1;
+}
+
+__weak void lkd_dev_spec_regs(struct cpu_dyn_regs *regs);
+
+__weak u64 lkd_dev_spec_get_img_addr(uintptr_t base)
+{
+	return base;
+}
+
+static int module_lkd_prep_desc(int size, u32 *offset)
+{
+	struct mem_desc mdesc, img_desc;
+	struct lkd_fw_comms_desc *cdesc;
+	int err;
+	const char *preboot_ver, *fuse_data;
+	u8 *cdesc_data_off;
+
+	preboot_get_mem_region(MEM_LKD_PCI, &mdesc);
+
+	err = !preboot_is_valid_address_range(mdesc.base, size);
+	if (!err && size > mdesc.size)
+		err = 1;
+
+	if (err) {
+		preboot_puts("Requested size is not supported!\n");
+		return err;
+	}
+
+	cdesc = (struct lkd_fw_comms_desc *)mdesc.base;
+	memset(cdesc, 0, sizeof(*cdesc));
+
+	lkd_dev_spec_regs(&cdesc->cpu_dyn_regs);
+	fuse_data = preboot_get_version(PREBOOT_EFUSE_VER);
+	memcpy(cdesc->fuse_ver, fuse_data, VERSION_MAX_LEN);
+	preboot_ver = preboot_get_version(PREBOOT_BTL_VER);
+	memcpy(cdesc->cur_fw_ver, preboot_ver, VERSION_MAX_LEN);
+
+	err = lkd_get_image_addr(&img_desc);
+	if (err)
+		return err;
+
+	cdesc->img_addr = lkd_dev_spec_get_img_addr(img_desc.base);
+
+	/* Header */
+	cdesc->header.magic = HL_COMMS_DESC_MAGIC;
+	cdesc->header.size = sizeof(*cdesc) - sizeof(cdesc->header);
+	cdesc->header.version = HL_COMMS_DESC_VER;
+	cdesc_data_off = (u8 *)cdesc + sizeof(cdesc->header);
+	cdesc->header.crc32 = crc32(0, cdesc_data_off, cdesc->header.size);
+
+	*offset = (u32)mdesc.base;
+
+	preboot_security_dynamic_img_sram_open(MEM_LKD_PCI, ACCESS_RW);
+	if (sts.is_elbi_desc)
+		preboot_security_dynamic_img_spsram_open();
+
+	return err;
+}
+
+void module_lkd_run(void)
+{
+	int err = 0;
+	u32 offset = 0;
+
+	/* depending on the current state machine, perform action */
+	switch (sts.do_cmd.cmd) {
+	case COMMS_PREP_DESC:
+	case COMMS_PREP_DESC_ELBI:
+		sts.is_elbi_desc = sts.do_cmd.cmd == COMMS_PREP_DESC_ELBI;
+		err = module_lkd_prep_desc(sts.next_size, &offset);
+		if (err)
+			module_lkd_send_status(COMMS_STS_ERR, COMMS_SRAM, 0);
+		else
+			module_lkd_send_status(COMMS_STS_OK,
+					       COMMS_SRAM, offset);
+		break;
+	case COMMS_DATA_RDY:
+		err = module_lkd_validate();
+		if (err)
+			module_lkd_send_status(COMMS_STS_VALID_ERR,
+					       COMMS_SRAM, 0);
+		else
+			module_lkd_send_status(COMMS_STS_OK, COMMS_SRAM, 0);
+
+		break;
+	case COMMS_EXEC:
+		err = module_lkd_run_exec();
+		if (err)
+			module_lkd_send_status(COMMS_STS_ERR, COMMS_SRAM, 0);
+		else
+			module_lkd_send_status(COMMS_STS_OK, COMMS_SRAM, 0);
+
+		break;
+	default:	/* should never get here */
+		preboot_puts_raw(__func__);
+		preboot_puts(": default case - err\n");
+	}
+
+	/* no problem to shift here on error as it will only clear the do_cmd */
+	module_lkd_state_shift();
+}
+
+/* For devices that do not implement RST_DEV command, mimic WFE */
+__weak void hl_dev_reset(void) { wfe(); }
+
+static void module_lkd_run_noret_exec(void)
+{
+	/*
+	 * List of status bits we clear because we do not know if the FW we are
+	 * loading supports these functionalities
+	 */
+	u32 sts_msk = CPU_BOOT_DEV_STS0_FW_HARD_RST_EN |
+		CPU_BOOT_DEV_STS0_FW_LD_COM_EN;
+
+	preboot_security_cleanup_before_run();
+	hl_ts_shutdown();
+	cpu_boot_dev_sts_clrset(sts_msk, false);
+
+	fit_run_image();
+}
+
+__weak void preboot_finalize_nic_en(void) {}
+
+static void module_lkd_preserve_sp_info(void)
+{
+	preboot_finalize_fw_info();
+	preboot_finalize_nic_en();
+	preboot_finalize_fw_upd_closure();
+	boot_info_finalize();
+}
+
+static void module_lkd_run_noret_reset(void)
+{
+	module_lkd_preserve_sp_info();
+	cpu_boot_sts_set(CPU_BOOT_STATUS_IN_WFE);
+	hl_dev_reset();	/* should not return */
+}
+
+static void module_lkd_run_noret_wfe(void)
+{
+	module_lkd_preserve_sp_info();
+	cpu_boot_sts_set(CPU_BOOT_STATUS_IN_WFE);
+	wfe();
+}
+
+void module_lkd_run_noret(void)
+{
+	/* we are not returning - clear comms status */
+	module_lkd_send_status(COMMS_STS_NOOP, COMMS_SRAM, 0);
+
+	/* depending on the current state machine, perform action */
+	switch (sts.do_cmd.cmd) {
+	case COMMS_EXEC:
+		module_lkd_run_noret_exec();
+		break;
+	case COMMS_RST_DEV:
+		module_lkd_run_noret_reset();
+		break;
+	case COMMS_GOTO_WFE:
+		module_lkd_run_noret_wfe();
+		break;
+	default:	/* should never get here */
+		preboot_puts_raw(__func__);
+		preboot_puts(": default case - err\n");
+	}
+}
diff --git a/lib/preboot/module_pci.c b/lib/preboot/module_pci.c
new file mode 100644
index 0000000..86159bb
--- /dev/null
+++ b/lib/preboot/module_pci.c
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2016-2020 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <pcie_aux_regs.h>
+#include <pcie_aux_masks.h>
+#include <pcie_core_regs.h>
+#include <psoc_global_conf_regs.h>
+
+#include <bitops.h>
+#include <preboot.h>
+
+#include "cmd_module.h"
+#include "uart.h"
+#include "pci.h"
+#include "pll.h"
+
+struct pci_status {
+	u32 flr_reg_val;
+	u32 hot_rst_reg_val;
+	u32 smlh_link_reg_val;
+	u32 rdlh_link_reg_val;
+	bool link_is_up;
+	bool mem_enabled;
+	bool mem_enabled_prev;
+	bool pci_pll_initialized;
+};
+
+static struct pci_status pci_sts = {
+	.flr_reg_val = ~1,
+	.hot_rst_reg_val = ~1,
+	.smlh_link_reg_val = 1,
+	.rdlh_link_reg_val = 1,
+	.link_is_up = false,
+	.mem_enabled_prev = false,
+	.pci_pll_initialized = false,
+};
+
+__weak void pci_dev_specific_setup(void) {}
+__weak void pci_dev_specific_teardown(void) {}
+__weak void pci_dev_specific_disable(void) {}
+__weak void pci_dev_specific_enable(void) {}
+
+__weak void pci_dev_flr_enable(bool enable)
+{
+	u32 val = enable ? 0 : PCIE_AUX_FLR_CTRL_HW_CTRL_MASK |
+				PCIE_AUX_FLR_CTRL_INT_MASK_MASK;
+
+	regmap_writel(val, mmPCIE_AUX_FLR_CTRL);
+}
+
+__weak void pci_dev_specific_hot_rst(void)
+{
+	regmap_writel(0x10, mmPCIE_CORE_HOT_RST);
+	regmap_writel(1, mmPCIE_AUX_LTSSM_EN);
+}
+
+__weak void pci_dev_specific_flr(void)
+{
+	regmap_writel(1, mmPCIE_AUX_PF_FLR_ACTIVE);
+	regmap_writel(1, mmPCIE_AUX_FLR_INT);
+	regmap_writel(1, mmPCIE_AUX_PF_FLR_DONE);
+}
+
+__weak void hl_pci_iatu_init(void) {}
+__weak bool is_pcie_initialized(void) {return true; }
+__weak void hl_dev_pci_pll_wa(void) {}
+
+void module_pci_setup(void)
+{
+	if (!hl_is_debug_mode(HL_DEBUG_HW_PCIE)) {
+		pci_dev_specific_setup();
+		pci_dev_flr_enable(true);
+	}
+}
+
+__weak enum cmd_check_res dev_specific_module_pci_check(void)
+{
+	/*
+	 * don't read pci status regs until PRSTn is deasserted and pci blocks
+	 * are functional
+	 */
+	if (!is_pcie_initialized())
+		return NOT_FOUND;
+
+	pci_sts.flr_reg_val = regmap_readl(mmPCIE_AUX_FLR_INT);
+	pci_sts.hot_rst_reg_val = regmap_readl(mmPCIE_CORE_HOT_RST) & BIT(0);
+	pci_sts.rdlh_link_reg_val = regmap_readl(mmPCIE_AUX_RDLH_LINK_UP);
+	pci_sts.smlh_link_reg_val = regmap_readl(mmPCIE_AUX_SMLH_LINK_UP);
+
+	if (!pci_sts.pci_pll_initialized)
+		return FOUND_FAST_RETURN;
+
+	if (pci_sts.flr_reg_val == 1 || pci_sts.hot_rst_reg_val == 1)
+		return FOUND_FAST_RETURN;
+
+	if ((pci_sts.rdlh_link_reg_val && pci_sts.smlh_link_reg_val) !=
+	    pci_sts.link_is_up)
+		return FOUND_FAST_RETURN;
+
+	if (pci_sts.link_is_up)
+		pci_sts.mem_enabled = hl_pci_is_mem_enabled();
+
+	if (pci_sts.mem_enabled != pci_sts.mem_enabled_prev)
+		return FOUND_FAST_RETURN;
+
+	return NOT_FOUND;
+}
+
+enum cmd_check_res module_pci_check(void)
+{
+	if (hl_is_debug_mode(HL_DEBUG_HW_PCIE))
+		return NOT_FOUND;
+
+	return dev_specific_module_pci_check();
+}
+
+void module_pci_disable(void)
+{
+	if (!hl_is_debug_mode(HL_DEBUG_HW_PCIE)) {
+		pci_dev_specific_disable();
+		pci_dev_flr_enable(false);
+	}
+}
+
+void module_pci_run(void)
+{
+	unsigned int rst_src;
+
+	if (!pci_sts.pci_pll_initialized) {
+		hl_dev_pci_pll_wa();
+		pci_sts.pci_pll_initialized = true;
+	}
+
+	if (pci_sts.flr_reg_val == 1) {
+		pci_dev_specific_flr();
+		preboot_puts("FLR received\n");
+	}
+
+	if (pci_sts.hot_rst_reg_val == 1) {
+		pci_dev_specific_hot_rst();
+		preboot_puts("HOT RST received\n");
+	}
+
+	if ((pci_sts.rdlh_link_reg_val && pci_sts.smlh_link_reg_val) !=
+	    pci_sts.link_is_up) {
+		pci_sts.link_is_up = !pci_sts.link_is_up;
+		preboot_puts_raw("PCIe link is ");
+		if (pci_sts.link_is_up) {
+			preboot_puts("up\n");
+		} else {
+			preboot_puts("down\n");
+			pci_sts.mem_enabled = false;
+		}
+	}
+
+	if (pci_sts.mem_enabled_prev != pci_sts.mem_enabled) {
+		pci_sts.mem_enabled_prev = pci_sts.mem_enabled;
+		rst_src = regmap_readl(mmPSOC_GLOBAL_CONF_RST_SRC);
+		if (pci_sts.mem_enabled && (rst_src < HL_WD_RST))
+			hl_pci_iatu_init();
+
+		preboot_puts_raw("PCIe mem_en changed to: ");
+		preboot_puts_raw(pci_sts.mem_enabled ? "true" : "false");
+		preboot_puts("\n");
+	}
+}
+
+void module_pci_enable(void)
+{
+	if (!hl_is_debug_mode(HL_DEBUG_HW_PCIE)) {
+		pci_dev_specific_enable();
+		pci_dev_flr_enable(true);
+	}
+}
+
+void module_pci_teardown(void)
+{
+	if (!hl_is_debug_mode(HL_DEBUG_HW_PCIE)) {
+		pci_dev_specific_teardown();
+		pci_dev_flr_enable(false);
+	}
+}
+
+bool hl_pci_link_is_up(void)
+{
+	return pci_sts.link_is_up;
+}
diff --git a/lib/preboot/module_uart.c b/lib/preboot/module_uart.c
new file mode 100644
index 0000000..271f5f8
--- /dev/null
+++ b/lib/preboot/module_uart.c
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2016-2020 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <preboot.h>
+
+#include "cmd_module.h"
+#include "uart.h"
+
+enum cmd_check_res module_uart_check(void)
+{
+	if (!preboot_uart_tstc() &&
+	    (preboot_uart_tx_full() || preboot_uart_rbuf_empty()))
+		return NOT_FOUND;
+
+	return FOUND_FAST_RETURN;
+}
+
+__weak void hl_esc_key_handle(void) {}
+
+#define ESC_KEY			0x1b
+
+void hl_parse_uart(int val)
+{
+	static u8 dbg_count;
+	bool dbg_ena;
+
+	switch (val) {
+	case ESC_KEY:
+		hl_esc_key_handle();
+		dbg_count = 0;
+		break;
+	case 'd':
+		dbg_count = 1;
+		break;
+	case 'b':
+		if (dbg_count == 1)
+			dbg_count = 2;
+		else
+			dbg_count = 0;
+
+		break;
+	case 'g':
+		/* typing "dbg" will enable/disable debug prints
+		 * to the console
+		 */
+		if (dbg_count == 2) {
+			dbg_ena = preboot_get_dbg_prints_ena();
+			preboot_set_dbg_prints_ena(!dbg_ena);
+		}
+
+		dbg_count = 0;
+		break;
+	default:
+		dbg_count = 0;
+		break;
+	}
+}
+
+void module_uart_run(void)
+{
+	int val = preboot_uart_getc();
+
+	if (!preboot_uart_tx_full())
+		preboot_uart_rbuf_pop();
+
+	if (val < 0)
+		return;
+
+	preboot_puts("Keyboard press received\n");
+	hl_parse_uart(val);
+}
+
+void module_uart_setup(void)
+{
+	preboot_uart_rbuf_init();
+}
+
+__weak void preboot_ack_razwi_irq(void) {}
+
+void module_uart_teardown(void)
+{
+	preboot_uart_rbuf_flush();
+
+	/*
+	 * RAZWI event might appear during boot due to async access
+	 * from host side to locked range registers (PCI) (i.e. during
+	 * iatu initlization or reset flow, PCI access is disabled).
+	 * Therefore this ack is needed.
+	 */
+	preboot_ack_razwi_irq();
+}
diff --git a/lib/preboot/thermal.c b/lib/preboot/thermal.c
new file mode 100644
index 0000000..296f8ed
--- /dev/null
+++ b/lib/preboot/thermal.c
@@ -0,0 +1,286 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2017-2020 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+#include <stdbool.h>
+#include <preboot.h>
+#include <pll.h>
+#include <efuse.h>
+#include <string.h>
+#include <uart.h>
+
+#include "thermal.h"
+
+#define HL_TS_SDIF_DATA_OFFSET	0x44
+#define HL_TS_CLK_SYNTH		0x010
+#define HL_TS_SDIF		0x020
+#define HL_TS0_ALARMA_CFG	0x144
+#define HL_TS0_ALARMB_CFG	0x164
+#define C_TO_MC			1000
+
+#define TS_CALIB_A_G_COEFF      4805
+#define TS_CALIB_B_H_COEFF      21980
+#define TS_CALIB_J_COEFF        1
+#define TS_CALIB_DIV_COEFF      4094
+#define TS_CALIB_FCLK_COEFF     106
+#define TS_CALIB_OPMODE_COEFF   0x0
+
+#define TS_UNCALIB_A_G_COEFF    6500
+#define TS_UNCALIB_B_H_COEFF    20710
+#define TS_UNCALIB_J_COEFF      16
+#define TS_UNCALIB_DIV_COEFF    4094
+#define TS_UNCALIB_FCLK_COEFF   5
+#define TS_UNCALIB_OPMODE_COEFF 0x1
+
+struct hl_ts_cfg hl_ts_data[HL_ASIC_TS_MAX_COUNT];
+
+__weak void hl_ts_clk_set(u32 addr, unsigned int clk)
+{
+	unsigned int synth_clk;
+	unsigned int val;
+
+	synth_clk = ((clk / 6000000) / 2) - 1;
+
+	val = synth_clk;
+	val |= synth_clk << 8;
+	val |= 0x101 << 16;
+	regmap_writel(val, addr + HL_TS_CLK_SYNTH);
+
+}
+
+__weak void hl_ts_sdif_set(u32 addr, bool use_calib)
+{
+	udelay(100);
+	/* program sensor power up delay */
+	regmap_writel(0x8d0000ff, addr + HL_TS_SDIF);
+	udelay(100);
+	/* configure sensor mode */
+	regmap_writel(0x89000000, addr + HL_TS_SDIF);
+	udelay(100);
+	/* power up sensor in continuous mode*/
+	regmap_writel(0x88000108, addr + HL_TS_SDIF);
+}
+
+/* convert 12-bit HL_TMP register value to milliCelsius */
+__weak long hl_tmp_temp_reg_to_mC(int val, int ts)
+{
+	long tmp = (val & 0xfff);
+	u32 coef_a_g, coef_b_h, coef_j, coef_div, fclk;
+
+	coef_a_g = hl_ts_data[ts].hl_tmp_data.coef_a_g;
+	coef_b_h = hl_ts_data[ts].hl_tmp_data.coef_b_h;
+	coef_div = hl_ts_data[ts].hl_tmp_data.coef_div;
+	coef_j = hl_ts_data[ts].hl_tmp_data.coef_j;
+	fclk = hl_ts_data[ts].hl_tmp_data.fclk;
+
+	tmp = coef_a_g + ((coef_b_h * (((tmp * 1000) / coef_div) -
+					500)) / 1000) - coef_j * fclk;
+
+	/*
+	 * result of equation has to be multiplied
+	 * by 1000, since coefficients are multiplied by 100 an extra
+	 * multiplication of 10 is required.
+	 */
+	tmp *= 10;
+
+	return tmp;
+}
+
+/* convert milliCelsius to 12-bit HL_TMP register value */
+__weak u32 hl_tmp_mC_to_temp_reg(long val, int ts)
+{
+	u32 reg_val;
+	u32 coef_a_g, coef_b_h, coef_j, coef_div, fclk;
+
+	coef_a_g = hl_ts_data[ts].hl_tmp_data.coef_a_g;
+	coef_b_h = hl_ts_data[ts].hl_tmp_data.coef_b_h;
+	coef_div = hl_ts_data[ts].hl_tmp_data.coef_div;
+	coef_j = hl_ts_data[ts].hl_tmp_data.coef_j;
+	fclk = hl_ts_data[ts].hl_tmp_data.fclk;
+
+	reg_val = ((coef_div * ((val / 10) -
+			coef_a_g + (coef_j * fclk) +
+			(coef_b_h / 2))) / coef_b_h);
+
+	return reg_val & 0xfff;
+}
+
+/* twos complement to u32 without changing result sign
+ * since the temperature formula uses the positive value of
+ * the conversion.
+ */
+static inline s32 twos_complement_to_s32(u32 val)
+{
+	return  val & 0x8000 ? ((~val & 0xFFFF) + 1) * (-1) : val;
+}
+
+/* Extract A and B coefficients from efuse
+ *
+ * A:
+ * N_bin_twos_comp = efuse_read & 0x0000FFFF
+ * N_bin = twos_comp(N_bin_twos_comp, 16) #twos complement to int
+ * A_North = (N_bin * (-1)) / 1000.0
+ * A = A + A_North
+ *
+ * B:
+ * N_bin_twos_comp = (efuse_read >> (2) * 8) & 0x0000FFFF
+ * N_bin = twos_comp(N_bin_twos_comp, 16) #twos complement to int
+ * B_North = (N_bin * (-1)) / 1000.0
+ * B = B + B_North
+ */
+static inline void hl_tmp_extract_A_B(u32 calib_data, int ts)
+{
+	s32 efuse_a_coeff = calib_data & 0xFFFF;
+	s32 efuse_b_coeff = (calib_data >> 16) & 0xFFFF;
+
+	/* convert from two's complement to int */
+	efuse_a_coeff = twos_complement_to_s32(efuse_a_coeff);
+	efuse_b_coeff = twos_complement_to_s32(efuse_b_coeff);
+
+	/* A and B extracted has to be divided by 1000,
+	 * but since defined coefficients are multiplied by 100
+	 * for accuracy purposes, the coeff extracted are divided
+	 * only by 10 to match defined coefficients resolution.
+	 */
+	hl_ts_data[ts].hl_tmp_data.coef_a_g += efuse_a_coeff / 10;
+	hl_ts_data[ts].hl_tmp_data.coef_b_h += efuse_b_coeff / 10;
+}
+
+__weak int get_alarma_offset(void)
+{
+	return HL_TS0_ALARMA_CFG;
+}
+
+__weak int get_alarmb_offset(void)
+{
+	return HL_TS0_ALARMB_CFG;
+}
+
+static inline void hl_ts_alarm_set(u32 ts_num)
+{
+	long reg;
+	int alarm_mc;
+
+	alarm_mc = hl_ts_data[ts_num].alarm_a * C_TO_MC;
+	reg = hl_tmp_mC_to_temp_reg(alarm_mc, ts_num);
+	regmap_writel(reg, hl_ts_data[ts_num].base + get_alarma_offset());
+
+	alarm_mc = hl_ts_data[ts_num].alarm_b * C_TO_MC;
+	reg = hl_tmp_mC_to_temp_reg(alarm_mc, ts_num);
+	regmap_writel(reg, hl_ts_data[ts_num].base + get_alarmb_offset());
+}
+
+__weak void hl_set_calib_coeff(int ts, bool calib_enabled,
+		struct hl_tmp_opmode_info *calib_data)
+{
+	if (calib_enabled) {
+		calib_data->coef_a_g = TS_CALIB_A_G_COEFF;
+		calib_data->coef_b_h = TS_CALIB_B_H_COEFF;
+		calib_data->coef_j = TS_CALIB_J_COEFF;
+		calib_data->coef_div = TS_CALIB_DIV_COEFF;
+		calib_data->fclk = TS_CALIB_FCLK_COEFF;
+		calib_data->opmode = TS_CALIB_OPMODE_COEFF;
+	} else {
+		calib_data->coef_a_g = TS_UNCALIB_A_G_COEFF;
+		calib_data->coef_b_h = TS_UNCALIB_B_H_COEFF;
+		calib_data->coef_j = TS_UNCALIB_J_COEFF;
+		calib_data->coef_div = TS_UNCALIB_DIV_COEFF;
+		calib_data->fclk = TS_UNCALIB_FCLK_COEFF;
+		calib_data->opmode = TS_UNCALIB_OPMODE_COEFF;
+	}
+
+}
+
+__weak int hl_ts_get_count(void)
+{
+	return HL_ASIC_TS_MAX_COUNT;
+}
+
+__weak int get_sdif_offset(void)
+{
+	return HL_TS_SDIF;
+}
+
+__weak int hl_ts_pvt_init(int ts)
+{
+	return 0;
+}
+
+__weak void hl_ts_data_init(void)
+{
+	memset(hl_ts_data, 0, sizeof(struct hl_ts_cfg) * HL_ASIC_TS_MAX_COUNT);
+}
+
+__weak void hl_dev_ts_init(void)
+{
+	u32 efuse_word, ts;
+
+	hl_ts_data_init();
+
+	for (ts = 0; ts < hl_ts_get_count(); ts++) {
+
+		if (hl_ts_pvt_init(ts))
+			continue;
+
+		if (!hl_ts_data[ts].use_calib)
+			hl_set_calib_coeff(ts, false,
+						&hl_ts_data[ts].hl_tmp_data);
+
+		else {
+			preboot_fuse_read(hl_ts_data[ts].calib_offset,
+						&efuse_word);
+
+			hl_set_calib_coeff(ts, true,
+						&hl_ts_data[ts].hl_tmp_data);
+			/* Calculate new A and B coeff using efuse offsets */
+			hl_tmp_extract_A_B(efuse_word, ts);
+		}
+
+		hl_ts_alarm_set(ts);
+		hl_ts_clk_set(hl_ts_data[ts].base, hl_ts_data[ts].freq);
+		hl_ts_sdif_set(hl_ts_data[ts].base, hl_ts_data[ts].use_calib);
+
+	}
+}
+
+void hl_ts_init(void)
+{
+	hl_dev_ts_init();
+}
+
+__weak void hl_ts_pvt_shutdown(int ts) {}
+__weak void hl_ts_reset(void) {}
+
+void hl_ts_shutdown(void)
+{
+	u32 ts;
+
+	for (ts = 0; ts < hl_ts_get_count(); ts++)
+		hl_ts_pvt_shutdown(ts);
+
+	hl_ts_reset();
+}
+
+__weak int get_sdif_data_offset(void)
+{
+	return HL_TS_SDIF_DATA_OFFSET;
+}
+
+int hl_ts_get_max_temp(void)
+{
+	int tmp, max_tmp = 0;
+	int ts_num, ts;
+
+	ts_num = hl_ts_get_count();
+	for (ts = 0; ts < ts_num; ts++) {
+		tmp = regmap_readl(hl_ts_data[ts].base +
+					get_sdif_data_offset());
+		tmp = hl_tmp_temp_reg_to_mC(tmp, ts);
+		if (max_tmp < tmp)
+			max_tmp = tmp;
+	}
+
+	return max_tmp;
+}
