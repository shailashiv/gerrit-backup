--- /dev/null
+++ b/app/recovery/crt0_recovery.S
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright 2020 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+/*
+ * This is recovery entry point
+ * Setting sp/fp/lr and jumping to C code
+ */
+.globl	_start
+_start:
+
+
+/* lf2flt: to avoid compiler (buildroot wrapper) warning during linkage */
+.global	lf2flt
+lf2flt:
+
+	mov	sp, __stack_top
+	mov	fp, sp
+
+	/* Clear BSS */
+	mov	r5, __bss_start
+	sub	r6, __bss_end, r5
+	lsr.f	lp_count, r6, 2
+	lpnz	1f
+	st.ab   0, [r5, 4]
+1:
+	bl	recovery_main	/* Set LR (x30) */
