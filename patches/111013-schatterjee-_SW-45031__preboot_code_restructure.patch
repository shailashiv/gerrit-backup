-static void i2cslave_reset_buffer(struct i2cslave_buf *buf)
-{
-	buf->data = &i2cs_data.buf.cmd;
-	buf->cnt = 0;
-	buf->is_sync_error = false;
-	i2cslave_pec = 0;
-	i2cslave_pec_digest(I2C_SLAVE_ADDRESS << 1);
-}
-
-static void i2cslave_init(bool debug_mode)
-{
-	/* Check if already enabled */
-	if (regmap_readl(mmPSOC_I2C_S_IC_ENABLE)) {
-		preboot_puts("I2C SLAVE already initialized\n");
-		return;
-	}
-
-	if (debug_mode) {
-		regmap_writel(I2C_SLAVE_ADDRESS_DBG, mmPSOC_I2C_S_IC_SAR);
-	} else {
-		/* Program IC_SAR with address to which slave responds */
-		regmap_writel(I2C_SLAVE_ADDRESS, mmPSOC_I2C_S_IC_SAR);
-
-		/* Enable I2C Slave */
-		regmap_writel(0x1, mmPSOC_GLOBAL_CONF_I2C_SLV);
-
-		/* Enable I2C Slave interrupts */
-		regmap_writel(0x0, mmPSOC_GLOBAL_CONF_I2C_SLV_INTR_MASK);
-	}
-
-	/* Program IC_CON */
-	regmap_writel(0x22, mmPSOC_I2C_S_IC_CON);
-
-	/* Set INTR mask to default */
-	regmap_writel(I2C_SLAVE_DEFAULT_INTR_MASK, mmPSOC_I2C_S_IC_INTR_MASK);
-
-	/* Write to IC_RX_TL to set Rx FIFO threshold level */
-	regmap_writel(0x0, mmPSOC_I2C_S_IC_RX_TL);
-
-	/* Write to IC_TX_TL to set Tx FIFO threshold level */
-	regmap_writel(0x7, mmPSOC_I2C_S_IC_TX_TL);
-
-	/* Write 1 to IC_ENABLE to enable DW_apb_i2c */
-	regmap_writel(0x1, mmPSOC_I2C_S_IC_ENABLE);
-}
-
-static u32 i2cslave_dw_read_clear_intrbits_slave(void)
-{
-	register u32 stat;
-
-	/*
-	 * The IC_INTR_STAT register just indicates "enabled" interrupts.
-	 * Ths unmasked raw version of interrupt status bits are available
-	 * in the IC_RAW_INTR_STAT register.
-	 *
-	 * That is,
-	 *   stat = regmap_readl(IC_INTR_STAT);
-	 * equals to,
-	 *   stat = regmap_readl(IC_RAW_INTR_STAT) & regmap_readl(IC_INTR_MASK);
-	 *
-	 * The raw version might be useful for debugging purposes.
-	 */
-	stat = regmap_readl(mmPSOC_I2C_S_IC_INTR_STAT);
-
-	/*
-	 * Do not use the IC_CLR_INTR register to clear interrupts, or
-	 * you'll miss some interrupts, triggered during the period from
-	 * regmap_readl(IC_INTR_STAT) to regmap_readl(IC_CLR_INTR).
-	 *
-	 * Instead, use the separately-prepared IC_CLR_* registers.
-	 */
-	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_TX_ABRT_MASK)
-		regmap_readl(mmPSOC_I2C_S_IC_CLR_TX_ABRT);
-	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_RX_UNDER_MASK)
-		regmap_readl(mmPSOC_I2C_S_IC_CLR_RX_UNDER);
-	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_RX_OVER_MASK)
-		regmap_readl(mmPSOC_I2C_S_IC_CLR_RX_OVER);
-	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_TX_OVER_MASK)
-		regmap_readl(mmPSOC_I2C_S_IC_CLR_TX_OVER);
-	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_RX_DONE_MASK)
-		regmap_readl(mmPSOC_I2C_S_IC_CLR_RX_DONE);
-	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_ACTIVITY_MASK)
-		regmap_readl(mmPSOC_I2C_S_IC_CLR_ACTIVITY);
-	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_STOP_DET_MASK)
-		regmap_readl(mmPSOC_I2C_S_IC_CLR_STOP_DET);
-	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_START_DET_MASK)
-		regmap_readl(mmPSOC_I2C_S_IC_CLR_START_DET);
-	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_GEN_CALL_MASK)
-		regmap_readl(mmPSOC_I2C_S_IC_CLR_GEN_CALL);
-
-	return stat;
-}
-
-static void i2cslave_flush(void)
-{
-	u32 stat = regmap_readl(mmPSOC_I2C_S_IC_INTR_STAT);
-
-	if (stat & (PSOC_I2C_S_IC_INTR_STAT_R_RX_FULL_MASK |
-		    PSOC_I2C_S_IC_INTR_STAT_R_RD_REQ_MASK))
-		module_i2c_s_run();
-}
-
-void module_i2c_s_enable(void)
-{
-	bool debug_mode;
-
-	debug_mode = hl_is_debug_mode(HL_DEBUG_HW_I2C);
-
-	i2cslave_init(debug_mode);
-
-	if (!debug_mode) {
-		i2cslave_flush();
-		regmap_writel(0x1, mmPSOC_I2C_S_IC_ENABLE);
-		i2cslave_flush();
-	}
-
-	preboot_puts_dbg("I2C SLAVE initialized\n");
-}
-
-void module_i2c_s_setup(void)
-{
-	i2cslave_pec_init();
-	module_i2c_s_enable();
-}
-
-enum cmd_check_res module_i2c_s_check(void)
-{
-	u32 stat;
-
-	if (hl_is_debug_mode(HL_DEBUG_HW_I2C))
-		return NOT_FOUND;
-
-	if (i2cslave_fit_is_checked() || i2cslave_is_reset_dev())
-		return FOUND_NO_RETURN;
-
-	stat = i2cslave_dw_read_clear_intrbits_slave();
-
-	if ((stat & PSOC_I2C_S_IC_INTR_STAT_R_RD_REQ_MASK) ||
-	    (stat & PSOC_I2C_S_IC_INTR_STAT_R_RX_FULL_MASK)) {
-		preboot_puts_dbg("I2C SLAVE: read request received\n");
-		return FOUND_SLOW_RETURN;
-	}
-
-	if (i2cslave_indirect_is_process_op()) {
-		if (i2cslave_indirect_op_is_fast())
-			return FOUND_FAST_RETURN;
-		else
-			return FOUND_SLOW_RETURN;
-	}
-
-	return NOT_FOUND;
-}
-
-void module_i2c_s_disable(void)
-{
-	u32 val;
-	bool debug_mode;
-
-	debug_mode = hl_is_debug_mode(HL_DEBUG_HW_I2C);
-	if (debug_mode)
-		return;
-
-	i2cslave_flush();
-	regmap_writel(0x0, mmPSOC_I2C_S_IC_ENABLE);
-	udelay(100);
-
-	/* Write IC_SLAVE_DISABLE to IC_CON */
-	val = regmap_readl(mmPSOC_I2C_S_IC_CON);
-	val |= PSOC_I2C_S_IC_CON_IC_SLAVE_DISABLE_MASK;
-	regmap_writel(val, mmPSOC_I2C_S_IC_CON);
-
-	udelay(1000);
-
-	i2cslave_flush();
-	preboot_puts_dbg("I2C SLAVE: disabled\n");
-}
-
-u8 i2cslave_pcie_vendor_id_cmd(u8 cmd)
-{
-	u8 ret;
-	u32 dev_id = preboot_device_id_get();
-
-	switch (cmd) {
-	case HL_PCIE_VENDOR_ID_VAL_LOW:
-		ret = PCI_VENDOR_ID_HABANALABS >> 8;
-		break;
-	case HL_PCIE_VENDOR_ID_VAL_HIGH:
-		ret = PCI_VENDOR_ID_HABANALABS & 0xFF;
-		break;
-	case HL_PCIE_DEVICE_ID_VAL_LOW:
-		ret = (u8)(dev_id >> 8);
-		break;
-	case HL_PCIE_DEVICE_ID_VAL_HIGH:
-		ret = (u8)dev_id;
-		break;
-	default:
-		ret = 0;
-		break;
-	}
-
-	return ret;
-}
-
-u8 i2cslave_asic_sn_cmd(u8 cmd)
-{
-	u8 ret;
-
-	switch (cmd) {
-	case HL_ASIC_SERIAL_NUMBER_0 ... HL_ASIC_SERIAL_NUMBER_7:
-		ret = hl_asic_sn[cmd - HL_ASIC_SERIAL_NUMBER_0];
-		break;
-	default:
-		/* HL_ASIC_SERIAL_NUMBER_8 .. HL_ASIC_SERIAL_NUMBER_17 are reserved */
-		ret = 0;
-		break;
-	}
-
-	return ret;
-}
-
-u8 i2cslave_version_cmd(u8 cmd)
-{
-	u8 ret;
-
-	switch (cmd) {
-	case HL_VERSIONS_CMD_CODE:
-		ret = HL_VERSIONS_CMD_LEN;
-		break;
-	case HL_VERSIONS_FW_MAJOR_VER_VAL:
-		ret = PREBOOT_MAJOR_VER;
-		break;
-	case HL_VERSIONS_FW_MINOR_VER_VAL:
-		ret = PREBOOT_MINOR_VER;
-		break;
-	case HL_VERSIONS_FW_ADDITIONAL_VER_VAL:
-		ret = PREBOOT_PATCH_VER;
-		break;
-	default:
-		ret = 0;
-		break;
-	}
-
-	return ret;
-}
-
-#define ERR_STS_REG_MASK_LOW	0xFF
-#define ERR_STS_REG_MASK_HI	0xFF00
-u8 i2cslave_error_status_cmd(u8 cmd)
-{
-	u8 val = 0;
-
-	switch (cmd) {
-	case HL_ERROR_STATUS_ALERT_CAUSE_1:
-		/* return the stored low byte */
-		val = err_sts_reg_val & ERR_STS_REG_MASK_LOW;
-		/* clear the low byte as reg is RC(read and clear) */
-		err_sts_reg_val &= ERR_STS_REG_MASK_HI;
-		break;
-	case HL_ERROR_STATUS_ALERT_CAUSE_2:
-		/* return the stored high byte */
-		val = (err_sts_reg_val & ERR_STS_REG_MASK_HI) >> 8;
-		/* clear the high byte as reg is RC(read and clear) */
-		err_sts_reg_val &= ERR_STS_REG_MASK_LOW;
-		break;
-	default:
-		break;
-	}
-
-	return val;
-}
-
-static inline u8 *i2cslave_consume_hw(u8 *data, u8 cnt)
-{
-	register u8 val = (u8)regmap_readl(mmPSOC_I2C_S_IC_DATA_CMD);
-	register u8 cmd;
-	bool is_virt;
-	bool is_pec;
-
-	if (data) {
-		*data = (u8)val;
-		data++;
-	}
-
-	/* New command code, save it for sequential increase */
-	if (!cnt)
-		i2cs_data.buf.seq_cmd = i2cs_data.buf.cmd;
-
-	cmd = i2cs_data.buf.seq_cmd;
-	is_virt = I2CSLAVE_IS_VIRTUAL_CMD(cmd);
-	if (!is_virt) {
-		is_pec = HL_I2C_EVENT_IS_PEC(cmd);
-		if (!is_pec)
-			i2cslave_pec_digest(val);
-
-		/* Increase command sequence for data bytes */
-		if (cnt)
-			i2cs_data.buf.seq_cmd = cmd + 1;
-	}
-
-	return data;
-}
-
-static inline u32 i2cslave_produce_handler(struct i2cslave_buf *buf)
-{
-	register u32 seq_wr = 0;
-	register u8 cmd = buf->cmd;
-
-	/* Just started to process and PEC cmd called directly */
-	buf->is_direct_pec = !buf->cnt && HL_I2C_EVENT_IS_PEC(cmd);
-
-	/* Notify upper layer */
-	if (!buf->is_direct_pec)
-		seq_wr = i2cslave_handle_write_req(cmd, &buf->data, buf->cnt);
-
-	if (seq_wr)
-		buf->cnt++;
-
-	return seq_wr;
-}
-
-static void module_i2c_s_do_write(void)
-{
-	register struct i2cslave_seq seq = i2cs_data.seq;
-	register u8 *data = i2cs_data.buf.data;
-	register u8 cnt = i2cs_data.buf.cnt;
-
-	/* Next read will start from offset 0 */
-	seq.rd = 0;
-
-	do {
-		/* Upper layer finished it's process, reset buffer */
-		if (!seq.wr) {
-			i2cslave_reset_buffer(&i2cs_data.buf);
-			seq.wr = 1;
-			data = i2cs_data.buf.data;
-			cnt = i2cs_data.buf.cnt;
-		}
-		/* Consume data as long as we expect it */
-		if (seq.wr) {
-			seq.wr--;
-			data = i2cslave_consume_hw(data, cnt);
-		}
-		/* Additional data is not expected, produce data */
-		if (!seq.wr) {
-			seq.wr = i2cslave_produce_handler(&i2cs_data.buf);
-			data = i2cs_data.buf.data;
-			cnt = i2cs_data.buf.cnt;
-		}
-	} while (regmap_readl(mmPSOC_I2C_S_IC_RXFLR));
-
-	i2cs_data.seq = seq;
-	i2cs_data.buf.data = data;
-	preboot_puts_dbg("I2C SLAVE: write request processed\n");
-}
-
-static inline u8 i2cslave_consume_handler(void)
-{
-	struct i2cslave_buf *buf = &i2cs_data.buf;
-	u8 seq_cmd = buf->seq_cmd;
-	u8 ret;
-
-	if (i2cs_data.buf.is_direct_pec)
-		return i2cslave_valid_pec;
-
-	/* Check if we are in the middle of write request processing */
-	if (i2cs_data.seq.wr) {
-		preboot_puts("I2C SLAVE: sync error\n");
-		i2cslave_handle_sync_error();
-		i2cs_data.seq.wr = 0;
-		buf->is_sync_error = true;
-	}
-
-	if (buf->is_sync_error)
-		return 0;
-
-	ret = i2cslave_handle_read_req(seq_cmd, i2cs_data.seq.rd);
-
-	if (!i2cs_data.seq.rd)
-		i2cslave_pec_digest((I2C_SLAVE_ADDRESS << 1) | 1);
-
-	/* For next sequential read */
-	i2cs_data.seq.rd++;
-	if (!I2CSLAVE_IS_VIRTUAL_CMD(seq_cmd)) {
-		i2cs_data.buf.seq_cmd = seq_cmd + 1;
-		i2cslave_pec_digest(ret);
-	}
-
-	return ret;
-}
-
-static inline void i2cslave_produce_hw(u8 data)
-{
-	regmap_readl(mmPSOC_I2C_S_IC_CLR_RD_REQ);
-	regmap_readl(mmPSOC_I2C_S_IC_CLR_RX_UNDER);
-	regmap_writel(data, mmPSOC_I2C_S_IC_DATA_CMD);
-}
-
-static void module_i2c_s_do_read(void)
-{
-	u8 data = i2cslave_consume_handler();
-
-	i2cslave_produce_hw(data);
-	preboot_puts_dbg("I2C SLAVE: read request processed\n");
-}
-
-void module_i2c_s_run(void)
-{
-	u32 stat = regmap_readl(mmPSOC_I2C_S_IC_INTR_STAT);
-
-	/*
-	 * Process the read request only after all the written data is
-	 * consumed.
-	 */
-	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_RX_FULL_MASK)
-		module_i2c_s_do_write();
-	else if (stat & PSOC_I2C_S_IC_INTR_STAT_R_RD_REQ_MASK)
-		module_i2c_s_do_read();
-	else
-		i2cslave_indirect_process_op();
-}
-
-void module_i2c_s_run_fast(void)
-{
-	i2cslave_indirect_process_op();
-}
-
-void module_i2c_s_teardown(void)
-{
-	u32 val;
-	bool debug_mode;
-
-	debug_mode = hl_is_debug_mode(HL_DEBUG_HW_I2C);
-	if (debug_mode)
-		return;
-
-	/* Write 0 to IC_ENABLE to disable DW_apb_i2c */
-	regmap_writel(0, mmPSOC_I2C_S_IC_ENABLE);
-
-	/* wait for disable to impact */
-	udelay(100);
-
-	/* Disable all interrupts */
-	regmap_writel(0x0, mmPSOC_I2C_S_IC_INTR_MASK);
-	regmap_readl(mmPSOC_I2C_S_IC_CLR_INTR);
-
-	/* Write IC_SLAVE_DISABLE to IC_CON */
-	val = regmap_readl(mmPSOC_I2C_S_IC_CON);
-	val |= PSOC_I2C_S_IC_CON_IC_SLAVE_DISABLE_MASK;
-	regmap_writel(val, mmPSOC_I2C_S_IC_CON);
-
-	/* Make sure all transactions arrived */
-	udelay(1000);
-
-	i2cslave_flush();
-
-	preboot_puts("I2C SLAVE: tear down done\n");
-}
-
-void module_i2c_s_run_noret(void)
-{
-	module_i2c_s_teardown();
-	if (i2cslave_is_reset_dev())
-		i2cslave_reset_dev();
-	else
-		i2cslave_fit_run_image();
-}
