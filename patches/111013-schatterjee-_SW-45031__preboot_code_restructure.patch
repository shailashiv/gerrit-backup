diff --git a/app/ppboot/crt0_ppboot.S b/app/ppboot/crt0_ppboot.S
new file mode 100644
index 0000000..66f144b
--- /dev/null
+++ b/app/ppboot/crt0_ppboot.S
@@ -0,0 +1,63 @@
+/*
+ * (C) Copyright 2017 HabanaLabs, Ltd.
+ * Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+/*
+ * This is preboot entry point
+ * Setting sp/fp/lr and jumping to C code
+ */
+.globl	_start
+_start:
+
+#ifdef __arc__
+/* lf2flt: to avoid compiler (buildroot wrapper) warning during linkage */
+.global	lf2flt
+lf2flt:
+
+	/* Clear BSS */
+	mov     r5, __bss_start
+	sub     r6, __bss_end, r5
+	lsr.f   lp_count, r6, 2
+	lpnz    1f
+	st.ab   0, [r5, 4]
+1:
+	/* copy data and sdata sections */
+	mov_s	r1, @_erodata		; r1 = end of the text/ro section
+	mov_s	r2, @_data
+	sub	r3, @_esdata, r2	; r3 = size of total data in bytes
+
+	asr_s	r13, r3
+	asr.f	lp_count, r13
+
+	lpnz	2f
+	ld.ab	r5,[r1,4]
+	st.ab	r5,[r2,4]
+2:
+
+#endif
+
+#ifdef __aarch64__
+	ldr	x0, =__stack_top
+	bic	sp, x0, #0xf	/* 16-byte alignment for ABI compliance */
+	mov	x29, sp		/* Set FP (x29) */
+
+	/* Clear BSS */
+	ldr	x0, =__bss_start
+	ldr	x1, =__bss_end
+clear_loop:
+	str	xzr, [x0], #8
+	cmp	x0, x1
+	b.lo	clear_loop
+#endif
+
+#ifdef __arc__
+	push_s	blink
+#endif
+	bl	ppboot_main	/* Set LR (x30) */
+#ifdef __arc__
+	pop_s	blink
+	j_s	[blink]
+#endif
diff --git a/app/ppboot/ppboot.c b/app/ppboot/ppboot.c
new file mode 100644
index 0000000..3edaf07
--- /dev/null
+++ b/app/ppboot/ppboot.c
@@ -0,0 +1,267 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2017-2020 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <string.h>
+#include <psoc_global_conf_regs.h>
+#include <pcie_aux_regs.h>
+#include <cpu_ca53_cfg_regs.h>
+#include <hl_fw_if.h>
+#include <hl_boot_if.h>
+#include <bitops.h>
+#include <preboot.h>
+
+#include "common.h"
+#include "uart.h"
+#include <spi.h>
+#include "boot_desc.h"
+#include "pll.h"
+#include <boot_if.h>
+
+__weak bool ppboot_is_valid_img_desc(struct boot_desc *desc)
+{
+	return true;
+}
+
+static bool ppboot_try_candidate_img(enum fw_post_reset_cmd image_pending,
+				     struct boot_desc *desc, bool is_prime)
+{
+	bool is_valid = true;
+	u32 idx, bit;
+	char *msg;
+
+	idx = boot_desc_get_img_desc(image_pending, HL_FW_IMG_PREBOOT, desc);
+	if (idx == HL_FW_IMG_NOT_FOUND)
+		return false;
+
+	preboot_puts_raw("Preparing to run Preboot ");
+	if (image_pending != FLOPS_UPD_PENDING)
+		preboot_puts_raw("stable");
+	else
+		preboot_puts_raw("candidate");
+
+	preboot_puts_hex_raw(" (offset: ", desc->spi_offset, false);
+	preboot_puts_hex_raw(", size: ", desc->img_size, false);
+	preboot_puts(")\n");
+
+	ppboot_cp_preboot(desc->loadaddr, desc->spi_offset,
+			  desc->img_size, "PREBOOT");
+	if (desc->desc_ver > 1) {
+		is_valid = ppboot_is_valid_img_desc(desc);
+		if (!is_valid)
+			preboot_puts("Checksum is not valid.\n");
+	}
+	if (!is_valid) {
+		if (is_prime) {
+			bit = CPU_BOOT_ERR0_PRI_IMG_VER_FAIL;
+			msg = "Primary";
+		} else {
+			bit = CPU_BOOT_ERR0_SEC_IMG_VER_FAIL;
+			msg = "Secondary";
+		}
+		cpu_boot_err_clrset(bit, true);
+		preboot_puts_raw(msg);
+		preboot_puts(" is not a valid image.\n");
+	}
+
+	return is_valid;
+}
+
+__weak bool ppboot_load_preboot_img(u64 *loadaddr)
+{
+	struct boot_desc desc;
+	bool ret;
+	enum fw_post_reset_cmd image_pending = regmap_readl(mmUPD_PENDING_STS);
+
+	/* Initialize load address with illegal value */
+	if (!boot_desc_init()) {
+		preboot_puts_raw("Not a valid boot desc.");
+		return false;
+	}
+
+	ret = ppboot_try_candidate_img(image_pending, &desc, true);
+	if (ret) {
+		*loadaddr = desc.loadaddr;
+		return true;
+	}
+
+	/* Try the secondary image by toggling image_pending argument */
+	image_pending = (image_pending == FLOPS_UPD_PENDING) ? FLOPS_UPD_NOOP :
+			 FLOPS_UPD_PENDING;
+	ret = ppboot_try_candidate_img(image_pending, &desc, false);
+	if (ret) {
+		*loadaddr = desc.loadaddr;
+		return true;
+	}
+
+	return false;
+}
+
+__weak void preboot_init_pcie(void) {}
+__weak void preboot_device_id_init(void) {}
+
+void preboot_pcie_enable(void)
+{
+	u32 rst_src;
+
+	rst_src = regmap_readl(mmPSOC_GLOBAL_CONF_RST_SRC);
+	switch (rst_src) {
+	case HL_COLD_RST:
+	case HL_PRSTN_RST:
+		/* PCIe is reset, so must initialize PCIe */
+		break;
+	case HL_MANUAL_RST:
+	case HL_WD_RST:
+	case HL_SW_ALL_RST:
+		/*
+		 * Currently, keep using the same flow as done before,
+		 * i.e. PCIe should already be initialized by default.
+		 * During hard reset triggered by LKD keep PCIe intact.
+		 */
+		return;
+	default:
+		break;
+	}
+
+	preboot_init_pcie();
+}
+
+static void rst_src_dump(void)
+{
+	unsigned int rst_src = regmap_readl(mmPSOC_GLOBAL_CONF_RST_SRC);
+	char *cause;
+
+	switch (rst_src) {
+	case HL_COLD_RST:
+		cause = "cold";
+		break;
+	case HL_MANUAL_RST:
+		cause = "manual";
+		break;
+	case HL_PRSTN_RST:
+		cause = "prstn";
+		break;
+	case HL_WD_RST:
+		cause = "watch dog";
+		break;
+	case HL_SW_ALL_RST:
+		cause = "software all";
+		break;
+	default:
+		cause = "unknown";
+		break;
+	}
+	preboot_puts_raw("Last reset cause is: ");
+	preboot_puts_raw(cause);
+	preboot_puts(" reset\n");
+}
+
+static bool hl_pcie_link_up(void)
+{
+	unsigned int prstn, smlh, rdlh, rst_src;
+
+	/* check source of reset */
+	rst_src = regmap_readl(mmPSOC_GLOBAL_CONF_RST_SRC);
+	if (rst_src < HL_WD_RST)
+		return false;
+
+	prstn = regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN);
+	smlh = regmap_readl(mmPCIE_AUX_SMLH_LINK_UP);
+	rdlh = regmap_readl(mmPCIE_AUX_RDLH_LINK_UP);
+
+	if (prstn && smlh && rdlh)
+		return true;
+
+	return false;
+}
+
+__weak void ppboot_log_waiting_for_pcie(void) {}
+
+static void ppboot_pcie_init(void)
+{
+	if (hl_pcie_link_up()) {
+		hl_pcie_enable_access();
+		preboot_puts("PCIe link is already UP!\n");
+		return;
+	}
+
+	if (hl_skip_pcie_init()) {
+		preboot_puts("PCIe initialization is skipped!\n");
+		return;
+	}
+
+	/* let the log be device specific according to its restrictions */
+	ppboot_log_waiting_for_pcie();
+	preboot_pcie_wait_for_link();
+}
+
+__weak bool hl_is_jtag_enabled(void)
+{
+	return true;
+}
+
+void hl_jtag_init(void)
+{
+	u32 reg;
+	bool is_debug_en;
+
+	is_debug_en = hl_is_jtag_enabled();
+	cpu_boot_dev_sts_clrset(CPU_BOOT_DEV_STS0_DEBUG_EN, is_debug_en);
+	reg = regmap_readl(mmCPU_CA53_CFG_ARM_RST_CONTROL);
+	if (is_debug_en)
+		reg |= BIT(12);
+	else
+		reg &= ~BIT(12);
+	regmap_writel(reg, mmCPU_CA53_CFG_ARM_RST_CONTROL);
+}
+
+__weak void hl_init_pcie_phy_fw(void) {}
+
+__weak void ppboot_pcie_drain_init(void) {}
+
+__weak void hl_plat_init(void) {}
+
+static inline void ppboot_version(void)
+{
+	preboot_puts("Ppboot " VERSION_STR "\n");
+}
+
+__weak void hl_enter_recovery(void)
+{
+	preboot_puts("No valid images found, so WFE\n");
+	wfe();
+}
+
+void ppboot_main(void)
+{
+	u64 loadaddr;
+	bool ret;
+
+	hl_plat_early_init();
+	hl_init_pcie_phy_fw();
+	hl_jtag_init();
+	/*
+	 * Note: we assume CPU frequency is not changed while CPU is running,
+	 * so the udelay init is done once before we start.
+	 */
+	udelay_init();
+
+	preboot_sync_btl();
+	hl_uart_init();
+	spi_prot_early();
+	ppboot_pcie_init();
+	ppboot_pcie_drain_init();
+	ppboot_version();
+	rst_src_dump();
+
+	hl_plat_init();
+
+	preboot_delay();
+	ret = ppboot_load_preboot_img(&loadaddr);
+	if (ret)
+		image_start(loadaddr);
+	hl_enter_recovery();
+}
diff --git a/app/preboot/crt0_preboot.S b/app/preboot/crt0_preboot.S
new file mode 100644
index 0000000..b329174
--- /dev/null
+++ b/app/preboot/crt0_preboot.S
@@ -0,0 +1,46 @@
+/*
+ * (C) Copyright 2017 HabanaLabs, Ltd.
+ * Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+/*
+ * This is preboot entry point
+ * Setting sp/fp/lr and jumping to C code
+ */
+.globl	_start
+_start:
+
+#ifdef __arc__
+/* lf2flt: to avoid compiler (buildroot wrapper) warning during linkage */
+.global	lf2flt
+lf2flt:
+
+	mov	sp, __stack_top
+	mov	fp, sp
+
+	/* Clear BSS and stack areas */
+	mov	r5, __bss_start
+	sub	r6, __stack_top, r5
+	lsr.f	lp_count, r6, 2
+	lpnz	1f
+	st.ab   0, [r5, 4]
+1:
+#endif
+
+#ifdef __aarch64__
+	ldr	x0, =__stack_top
+	bic	sp, x0, #0xf	/* 16-byte alignment for ABI compliance */
+	mov	x29, sp		/* Set FP (x29) */
+
+	/* Clear BSS and stack areas */
+	ldr	x0, =__bss_start
+	ldr	x1, =__stack_top
+clear_loop:
+	str	xzr, [x0], #8
+	cmp	x0, x1
+	b.lo	clear_loop
+#endif
+
+	bl	preboot_main	/* Set LR (x30) */
