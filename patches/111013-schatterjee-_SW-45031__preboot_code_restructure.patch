-	[SRAM_BGN_TO_VERS] = {
-		.rr = PCIE_DYN_RR_SRAM_BGN,
-		.min = SDRAM_BASE - 1,
-		.max = 0,	/* version start */
-	},
-	[VERSION] = {
-		.rr = PCIE_DYN_RR_SRAM_R1,
