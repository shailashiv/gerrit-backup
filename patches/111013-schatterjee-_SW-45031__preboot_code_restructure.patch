@@ -0,0 +1,107 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ *
+ * (C) Copyright 2021 HabanaLabs, Ltd.
+ *
+ */
+
+#include <psoc_global_conf_regs.h>
+#include <psoc_gpio0_regs.h>
+
+
+#include <bitops.h>
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+
+#include "common.h"
+
+u32 hl_skip_pcie_init(void)
+{
+	/* TODO: Use DumpSel[*] to skip PCIe initialization */
+	return 1;
+}
+
+u64 hl_pll_timestamp_freq_get(void)
+{
+	/* As per Gaudi2 PLL cfg.xslx, CPU PLL Div[3] drives CPU timestamp */
+	return hl_pll_get_freq(mmPSOC_CPU_PLL_CTRL_BASE, HL_PLL_DIV3);
+}
+
+void hl_uart_init(void)
+{
+	/* As per Gaudi2 PLL cfg.xlsx, CPU PLL Div[3] drives uart */
+	u32 uart_clk_freq = hl_pll_get_freq(mmPSOC_CPU_PLL_CTRL_BASE,
+					    HL_PLL_DIV3);
+
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_8);	/* UART0 RXD */
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_9);	/* UART0 TXD */
+	preboot_uart_init(uart_clk_freq / HL_UART_BAUDRATE);
+}
+
+/* TODO:configure yellow LED(GPIO2) in output mode and turn on(active low) */
+void preboot_led_on(void)
+{
+	/* TODO: Check this */
+	u32 val = BIT(2);
+
+	/* configure GPIO in output mode */
+	regmap_writel(val, mmPSOC_GPIO0_OUTENSET);
+
+	/* Turn ON LED (pin is active low) */
+	val = regmap_readl(mmPSOC_GPIO0_DATAOUT);
+	val &= ~BIT(2);
+	regmap_writel(val, mmPSOC_GPIO0_DATAOUT);
+}
+
+/* initialize sram scrambling before u-boot is downloaded */
+void sram_scrambling_init(void)
+{
+	/* TODO */
+}
+u32 hl_spi_baudr_get(void)
+{
+	/* As per Gaudi2 PLL cfg.xlsx, PCI PLL Div[3] drives SPI */
+	u32 spi_clk_freq = hl_pll_get_freq(mmPSOC_CPU_PLL_CTRL_BASE,
+					   HL_PLL_DIV3);
+
+	u32 factor = spi_clk_freq / HL_SPI_FLASH_MAX_FREQ;
+
+	return factor > 2 ? factor : 2;
+}
+
+void hl_ram_init(void)
+{
+	sram_scrambling_init();
+}
+/*
+ * FW_SRAM layout:
+ * ---------------
+ * CRC32 [4B]
+ * Signature [384B]
+ * Public Key [792B]
+ * PCIe PHY FW
+ * PPboot
+ * PPboot size [4B]
+ * FW Version [4B]
+ * Layout Size [4B]
+ */
+#define FW_SRAM_META_SIZE	(4 + 4 + 4 + 792 + 384 + 4)
+void hl_init_pcie_phy_fw(void)
+{
+	int i;
+	u32 *fw_sram_base = (u32 *)FW_SRAM_BASE;
+	u32 image_size = *fw_sram_base;
+	u32 ppboot_size = *(fw_sram_base + 2);
+	u32 size = image_size - ppboot_size - FW_SRAM_META_SIZE;
+	u32 *src = (u32 *)((char *)(fw_sram_base + 3) + ppboot_size);
+	u32 *dst = (u32 *)PCIE_FW_SRAM_BASE;
+	unsigned int rst_src = regmap_readl(mmPSOC_GLOBAL_CONF_RST_SRC);
+
+	/* If not cold reset, dont download PHY FW */
+	if (!(rst_src & BIT(HL_COLD_RST)))
+		return;
+
+	for (i = 0; i < (size / 4); i++)
+		*(dst + i) = *(src + i);
+}
