new file mode 100644
index 0000000..41c5890
--- /dev/null
+++ b/arch/gaudi2/arm/asic.c
@@ -0,0 +1,119 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2020 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <psoc_global_conf_regs.h>
+#include <psoc_gpio0_regs.h>
+
+#include <string.h>
+#include <bitops.h>
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+#include <sha256.h>
+#include <boot_desc.h>
+#include <pci.h>
+
+#include "common.h"
+
+u32 hl_skip_pcie_init(void)
+{
+	/* TODO: Use DumpSel[*] to skip PCIe initialization */
+	return 0;
+}
+
+u64 hl_pll_timestamp_freq_get(void)
+{
+	/* As per Gaudi2 PLL cfg.xslx, CPU PLL Div[3] drives CPU timestamp */
+	return hl_pll_get_freq(mmPSOC_CPU_PLL_CTRL_BASE, HL_PLL_DIV3);
+}
+
+void hl_uart_init(void)
+{
+	/* As per Gaudi2 PLL cfg.xlsx, CPU PLL Div[3] drives uart */
+	u32 uart_clk_freq = hl_pll_get_freq(mmPSOC_CPU_PLL_CTRL_BASE,
+					    HL_PLL_DIV3);
+
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_8);	/* UART0 RXD */
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_9);	/* UART0 TXD */
+	preboot_uart_init(uart_clk_freq / HL_UART_BAUDRATE);
+}
+
+u32 hl_spi_baudr_get(void)
+{
+	u32 factor;
+	/* As per Gaudi2 PLL cfg.xlsx, PCI PLL Div[3] drives SPI */
+	u32 spi_clk_freq = hl_pll_get_freq(mmPSOC_CPU_PLL_CTRL_BASE,
+					   HL_PLL_DIV3);
+
+	factor = spi_clk_freq / HL_SPI_FLASH_MAX_FREQ;
+
+	return factor > 2 ? factor : 2;
+}
+
+/* configure yellow LED(GPIO2) in output mode and turn on(active low) */
+void preboot_led_on(void)
+{
+	u32 val = BIT(2);
+
+	/* configure GPIO in output mode */
+	regmap_writel(val, mmPSOC_GPIO0_OUTENSET);
+
+	/* Turn ON LED (pin is active low) */
+	val = regmap_readl(mmPSOC_GPIO0_DATAOUT);
+	val &= ~BIT(2);
+	regmap_writel(val, mmPSOC_GPIO0_DATAOUT);
+}
+
+bool ppboot_is_valid_img_desc(struct boot_desc *desc)
+{
+	u8 hash[SHA256_SUM_LEN];
+
+	sha256_csum((void *)(uintptr_t)desc->loadaddr, desc->img_size, hash);
+
+	return !memcmp(hash, desc->chksum, ARRAY_SIZE(hash));
+}
+
+void hl_pci_iatu_init(void)
+{
+	struct hl_pci_inbound_region inbound_region;
+	struct hl_pci_outbound_region outbound_region;
+
+	/* TODO: implement hl_pcie_disable_access() for gaudi2 */
+	hl_pcie_disable_access();
+
+	hl_pci_get_bar_phys_addr(PCI_BAR_ID_0, &inbound_region.pcie_bar_phys);
+
+	/* Inbound Region 0 - Bar 0 - Point to CFG */
+	inbound_region.mode = PCI_ADDRESS_MATCH_MODE;
+	inbound_region.bar = PCI_BAR_ID_0;
+	inbound_region.offset_in_bar = 0;
+	inbound_region.addr = STM_FLASH_BASE;
+	inbound_region.size = CFG_REGION_SIZE;
+	hl_pci_set_inbound_region(0, &inbound_region);
+
+	/* Inbound Region 1 - Bar 0 - Point to BAR0_RESERVED + SRAM */
+	inbound_region.mode = PCI_ADDRESS_MATCH_MODE;
+	inbound_region.bar = PCI_BAR_ID_0;
+	inbound_region.offset_in_bar = CFG_REGION_SIZE;
+	inbound_region.addr = BAR0_RSRVD_BASE;
+	inbound_region.size = BAR0_RSRVD_SIZE + SRAM_SIZE;
+	hl_pci_set_inbound_region(1, &inbound_region);
+
+	/* Inbound Region 2 - Bar 4 - Point to DRAM */
+	inbound_region.mode = PCI_BAR_MATCH_MODE;
+	inbound_region.bar = PCI_BAR_ID_4;
+	inbound_region.addr = DRAM_BASE;
+	hl_pci_set_inbound_region(2, &inbound_region);
+
+	/* Outbound Region 0 - Point to Host */
+	outbound_region.addr = HOST_PHYS_BASE_0;
+	outbound_region.size = HOST_PHYS_SIZE_0;
+	hl_pci_set_outbound_region(&outbound_region);
+
+	/* TODO: implement hl_pcie_enable_access() for gaudi2 */
+	hl_pcie_enable_access();
+}
diff --git a/arch/gaudi2/arm/common.c b/arch/gaudi2/arm/common.c
