-enum cmd_check_res module_uart_check(void)
-{
-	if (!preboot_uart_tstc() &&
-	    (preboot_uart_tx_full() || preboot_uart_rbuf_empty()))
-		return NOT_FOUND;
-
-	return FOUND_FAST_RETURN;
-}
-
-__weak void hl_esc_key_handle(void) {}
-
-#define ESC_KEY			0x1b
-
-void hl_parse_uart(int val)
-{
-	static u8 dbg_count;
-	bool dbg_ena;
-
-	switch (val) {
-	case ESC_KEY:
-		hl_esc_key_handle();
-		dbg_count = 0;
-		break;
-	case 'd':
-		dbg_count = 1;
-		break;
-	case 'b':
-		if (dbg_count == 1)
-			dbg_count = 2;
-		else
-			dbg_count = 0;
-
-		break;
-	case 'g':
-		/* typing "dbg" will enable/disable debug prints
-		 * to the console
-		 */
-		if (dbg_count == 2) {
-			dbg_ena = preboot_get_dbg_prints_ena();
-			preboot_set_dbg_prints_ena(!dbg_ena);
-		}
-
-		dbg_count = 0;
-		break;
-	default:
-		dbg_count = 0;
-		break;
-	}
-}
-
-void module_uart_run(void)
-{
-	int val = preboot_uart_getc();
-
-	if (!preboot_uart_tx_full())
-		preboot_uart_rbuf_pop();
-
-	if (val < 0)
-		return;
-
-	preboot_puts("Keyboard press received\n");
-	hl_parse_uart(val);
-}
-
-void module_uart_setup(void)
-{
-	preboot_uart_rbuf_init();
-}
-
-__weak void preboot_ack_razwi_irq(void) {}
