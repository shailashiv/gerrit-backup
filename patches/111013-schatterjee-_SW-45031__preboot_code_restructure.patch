new file mode 100644
index 0000000..b5d84b2
--- /dev/null
+++ b/lib/common/cmd_module.c
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * (C) Copyright 2020 HabanaLabs, Ltd.
+ * All rights reserved.
+ *
+ */
+
+#include <preboot.h>
+
+#include "uart.h"
+#include "cmd_module.h"
+
+__weak bool preboot_host_gpio_asserted(void) { return true; }
+
+static void i2c_debug_mode_handling(void)
+{
+	bool debug_mode;
+
+	debug_mode = hl_is_debug_mode(HL_DEBUG_HW_I2C);
+
+	/* i2c debug mode is true and gpio is deasserted */
+	if ((debug_mode == true) &&
+		 (preboot_host_gpio_asserted() == false)) {
+
+		/*
+		 * Wait till gpio is asserted. When gpio is de-asserted
+		 * its in debug mode. when gpio is asserted fw will
+		 * read write to modules.
+		 */
+		while (!preboot_host_gpio_asserted())
+			;
+	}
+}
+
+void module_handle_cmds(struct cmd_module_ops cmd_ops[], int size)
+{
+	int i = 0, j = 0;
+	enum cmd_check_res res = NOT_FOUND;
+
+	for (j = 0; j < size; j++)
+		cmd_ops[j].setup();
+
+	preboot_puts("Waiting for commands...\n");
+	preboot_uart_rbuf_flush();
+
+	i = 0;
+	while (1) {
+
+		i2c_debug_mode_handling();
+
+		res = cmd_ops[i].check();
+		switch (res) {
+		case NOT_FOUND:
+			break;
+		case FOUND_FAST_RETURN:
+			cmd_ops[i].run_fast();
+			break;
+		case FOUND_SLOW_RETURN:
+			for (j = 0; j < size; j++)
+				if (i != j)
+					cmd_ops[j].disable();
+
+			cmd_ops[i].run();
+			for (j = 0; j < size; j++)
+				if (i != j)
+					cmd_ops[j].enable();
+
+			break;
+		case FOUND_NO_RETURN:
+			for (j = 0; j < size; j++)
+				if (i != j)
+					cmd_ops[j].teardown();
+
+			cmd_ops[i].run_noreturn();
+			break;
+		default:
+			break;
+		}
+
+		if (++i == size)
+			i = 0;
+	}
+}
diff --git a/lib/common/cmd_module.h b/lib/common/cmd_module.h
new file mode 100644
index 0000000..a76a9ac
--- /dev/null
+++ b/lib/common/cmd_module.h
@@ -0,0 +1,128 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright 2016-2020 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#ifndef _HL_CMD_MODULE_H_
+#define _HL_CMD_MODULE_H_
+
+#include <stdbool.h>
+#include <hl_boot_if.h>
+/*
+ * enum cmd_check_res	- used to specify various results that check() routine
+ *			  can return following its check.
+ *
+ * NOT_FOUND		- check() routine has not discovered any request which
+ *			  is related to its module.
+ * FOUND_FAST_RETURN	- check() routine has discovered a request that is very
+ *			  fast to handle.
+ * FOUND_SLOW_RETURN	- check() routine has discovered a request that will
+ *			  take relatively large amount time to handle and after
+ *			  it has been handled, the execution will return back
+ * FOUND_NO_RETURN	- check() routine has discovered a request and its
+ *			  handling will never return back.
+ */
+enum cmd_check_res {
+	NOT_FOUND,
+	FOUND_FAST_RETURN,
+	FOUND_SLOW_RETURN,
+	FOUND_NO_RETURN,
+};
+
+/*
+ * struct cmd_module_ops	- operations defined for all registered modules
+ *
+ * setup()		- setup the module and prepare checking for
+ *			  commands/requests and handling them
+ * check()		- check if there is a command/request pending and return
+ *			  the appropriate result
+ * disable()		- temporarily disable the module to enable another
+ *			  module execution of run() routine
+ * run()		- run the handling of the command/request discovered by
+ *			  the check() routine - can be slow since other modules
+ *			  have been disabled by disable() routine
+ * enable()		- enable the module after it was disabled by disable()
+ *			  callback
+ * run_fast()		- run the handling of the command/request discovered by
+ *			  the check() routine - must take low amount of time
+ *			  since other modules have not been disabled
+ * teardown()		- the opposite from setup(), the module will no longer
+ *			  be checked or handled - stop the module
+ * run_noreturn()	- all modules have been teared down, so run the handling
+ *			  w/o returning
+ */
+struct cmd_module_ops {
+	void (*setup)(void);
+	enum cmd_check_res (*check)(void);
+	void (*disable)(void);
+	void (*run)(void);
+	void (*enable)(void);
+	void (*run_fast)(void);
+	void (*teardown)(void);
+	void (*run_noreturn)(void);
+};
+
+/* a dummy to fill in irrelevant entries */
+static inline void noop(void) {}
+
+/* PCI */
+void module_pci_setup(void);
+enum cmd_check_res module_pci_check(void);
+void module_pci_disable(void);
+void module_pci_run(void);
+void module_pci_enable(void);
+void module_pci_teardown(void);
+void pci_dev_specific_setup(void);
+void pci_dev_specific_disable(void);
+void pci_dev_specific_enable(void);
+void pci_dev_specific_teardown(void);
+void pci_dev_specific_hot_rst(void);
+
+/* FWUPD */
+void module_fwupd_setup(void);
+enum cmd_check_res module_fwupd_check(void);
+void module_fwupd_run_fast(void);
+void module_fwupd_run(void);
+void module_fwupd_run_noret(void);
+void module_fwupd_pcie_disable(bool is_pcie_disabled);
+bool module_fwupd_is_disabled(void);
+
+/* I2C FWUPD */
+void module_i2c_fwupd_setup(void);
+enum cmd_check_res module_i2c_fwupd_check(void);
+void module_i2c_fwupd_run_fast(void);
+void module_i2c_fwupd_run(void);
+bool i2c_fwupd_owned(u32 offset);
+u32 i2c_fwupd_readl(u32 offset);
+void i2c_fwupd_writel(u32 offset, u32 val);
+
+/* LKD */
+void module_lkd_setup(void);
+enum cmd_check_res module_lkd_check(void);
+void module_lkd_enable(void);
+void module_lkd_disable(void);
+void module_lkd_run(void);
+void module_lkd_run_fast(void);
+void module_lkd_run_noret(void);
+void lkd_dev_specific_setup(void);
+void lkd_dev_spec_regs(struct cpu_dyn_regs *regs);
+
+/* UART */
+void module_uart_setup(void);
+enum cmd_check_res module_uart_check(void);
+void module_uart_run(void);
+void module_uart_teardown(void);
+
+/* I2C SLAVE */
+void module_i2c_s_setup(void);
+enum cmd_check_res module_i2c_s_check(void);
+void module_i2c_s_disable(void);
+void module_i2c_s_enable(void);
+void module_i2c_s_run(void);
+void module_i2c_s_run_fast(void);
+void module_i2c_s_teardown(void);
+void module_i2c_s_run_noret(void);
+
+void module_handle_cmds(struct cmd_module_ops cmd_ops[], int size);
+#endif /* _HL_CMD_MODULE_H_ */
diff --git a/lib/common/efuse.c b/lib/common/efuse.c
new file mode 100644
index 0000000..f3552b7
--- /dev/null
+++ b/lib/common/efuse.c
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2017-2020 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <unistd.h>
+#include <psoc_efuse_regs.h>
+#include <psoc_dft_efuse_regs.h>
+#include <preboot.h>
+#include <boot_if.h>
+#include "efuse.h"
+#include "common.h"
+#include "preboot.h"
+#include "uart.h"
+#include <spi.h>
+#include "pll.h"
+
+/*
+ * fuse box is divided into half for redundancy
+ * each half is bank of FUSE_WORDS_PER_BANK words
+ * NOTE: bank1 is a complete duplication of bank0
+ */
+#define FUSE_TIMEOUT_US		100000
+#define FUSE_DELAY_US		20
+#define FUSE_RETRIES		(FUSE_TIMEOUT_US / FUSE_DELAY_US)
+
+static int efuse_init;
+
+__weak void preboot_efuse_read_range_set(void) {}
+
+int preboot_fuse_init(void)
+{
+	int i;
+	u32 read_reg;
+
+	if (efuse_init == 1)
+		return -1;
+
+	read_reg = get_efuse_read_reg();
+
+	preboot_efuse_read_range_set();
+
+	regmap_writel(1, read_reg);
+
+	for (i = 0; i < FUSE_RETRIES; i++)
+		if (regmap_readl(read_reg))
+			udelay(FUSE_DELAY_US);
+		else
+			break;
+
+	if (i == FUSE_RETRIES)
+		return -2;
+
+	efuse_init = 1;
+	return 0;
+}
+
+__weak int preboot_fuse_read(u32 word, u32 *val)
+{
+	int offset, ret;
+	u32 read_val;
+
+	if (word >= FUSE_WORDS_PER_BANK) {
+		cpu_boot_err_clrset(CPU_BOOT_ERR0_EFUSE_FAIL, true);
+		preboot_puts("Invalid efuse word offset\n");
+		return -1;
+	}
+
+	ret = preboot_fuse_init();
+	if (ret == -2) {
+		cpu_boot_err_clrset(CPU_BOOT_ERR0_EFUSE_FAIL, true);
+		preboot_puts("Efuse not initialized\n");
+		return ret;
+	}
+
+	/* read value from bank0 */
+	offset = (word * sizeof(u32));
+	read_val = regmap_readl(mmPSOC_EFUSE_DATA_0 + offset);
+
+	/* read value from bank1 and OR with value from bank0 */
+	offset = ((FUSE_WORDS_PER_BANK + word) * sizeof(u32));
+	read_val |= regmap_readl(mmPSOC_EFUSE_DATA_0 + offset);
+
+	*val = read_val;
+
+	return 0;
+}
