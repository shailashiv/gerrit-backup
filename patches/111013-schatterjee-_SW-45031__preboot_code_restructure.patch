+	regmap_writel(BIT(0), mmNIF_RTR_CTRL_7_E2E_HBM_EN);
+	regmap_writel(BIT(0), mmNIF_RTR_CTRL_7_E2E_PCI_EN);
+	regmap_writel(BIT(0), mmDMA_IF_E_N_DOWN_CH0_E2E_HBM_EN);
+	regmap_writel(BIT(0), mmDMA_IF_E_N_DOWN_CH0_E2E_PCI_EN);
+	regmap_writel(BIT(0), mmDMA_IF_E_N_DOWN_CH1_E2E_HBM_EN);
+	regmap_writel(BIT(0), mmDMA_IF_E_N_DOWN_CH1_E2E_PCI_EN);
+	regmap_writel(BIT(0), mmDMA_IF_E_S_DOWN_CH0_E2E_HBM_EN);
+	regmap_writel(BIT(0), mmDMA_IF_E_S_DOWN_CH0_E2E_PCI_EN);
+	regmap_writel(BIT(0), mmDMA_IF_E_S_DOWN_CH1_E2E_HBM_EN);
+	regmap_writel(BIT(0), mmDMA_IF_E_S_DOWN_CH1_E2E_PCI_EN);
+	regmap_writel(BIT(0), mmDMA_IF_W_N_DOWN_CH0_E2E_HBM_EN);
+	regmap_writel(BIT(0), mmDMA_IF_W_N_DOWN_CH0_E2E_PCI_EN);
+	regmap_writel(BIT(0), mmDMA_IF_W_N_DOWN_CH1_E2E_HBM_EN);
+	regmap_writel(BIT(0), mmDMA_IF_W_N_DOWN_CH1_E2E_PCI_EN);
+	regmap_writel(BIT(0), mmDMA_IF_W_S_DOWN_CH0_E2E_HBM_EN);
+	regmap_writel(BIT(0), mmDMA_IF_W_S_DOWN_CH0_E2E_PCI_EN);
+	regmap_writel(BIT(0), mmDMA_IF_W_S_DOWN_CH1_E2E_HBM_EN);
+	regmap_writel(BIT(0), mmDMA_IF_W_S_DOWN_CH1_E2E_PCI_EN);
+
+	cpu_boot_dev_sts_clrset(CPU_BOOT_DEV_STS0_E2E_CRED_EN, true);
+}
