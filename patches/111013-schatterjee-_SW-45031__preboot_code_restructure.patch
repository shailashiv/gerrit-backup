+		.setup = module_i2c_fwupd_setup,
+		.check = module_i2c_fwupd_check,
+		.disable = noop,
+		.run = module_i2c_fwupd_run,
+		.enable = noop,
+		.run_fast = module_i2c_fwupd_run_fast,
+		.teardown = noop,
+		.run_noreturn = module_fwupd_run_noret, /* same as FW_UPD */
+	},
+	{	/* LKD module */
+		.setup = module_lkd_setup,
+		.check = module_lkd_check,
+		.disable = module_lkd_disable,
+		.run = module_lkd_run,
+		.enable = module_lkd_enable,
+		.run_fast = module_lkd_run_fast,
+		.teardown = module_lkd_disable,
+		.run_noreturn = module_lkd_run_noret,
+	},
+	{	/* UART module */
+		.setup = module_uart_setup,
+		.check = module_uart_check,
+		.disable = noop,
+		.run = noop,
+		.enable = noop,
+		.run_fast = module_uart_run,
+		.teardown = module_uart_teardown,
+		.run_noreturn = noop,
+	},
