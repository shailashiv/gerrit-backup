+
+static void preboot_secure_update_rr_reg(int rr_idx, u32 inst_offset, u32 min_reg, u32 max_reg,
+		u32 min, u32 max)
+{
+	u32 rr_base, rr_dest;
+
+	rr_base = rr_idx * sizeof(u32) + inst_offset;
+	rr_dest = rr_base + min_reg;
+	regmap_writel(min, rr_dest);
+	rr_dest = rr_base + max_reg;
+	regmap_writel(max, rr_dest);
+}
+
+static void preboot_secure_update_hit_reg(int rr_idx, struct preboot_sec_rrs_cfg *cfg, int inst_num,
+		bool write_only)
+{
+	u32 rr_base, rr_dest, hit;
+	/* Enable (hit) RR */
+	rr_base = cfg->instances_dist * inst_num;
+	rr_dest = rr_base + cfg->hit_wr_breg;
+	hit = regmap_readl(rr_dest);
+	regmap_writel(hit | BIT(rr_idx), rr_dest);
+
+	if (write_only)
+		return;
+
+	rr_dest = rr_base + cfg->hit_rd_breg;
+	hit = regmap_readl(rr_dest);
+	regmap_writel(hit | BIT(rr_idx), rr_dest);
+}
+
+#define MAX_LBW_SHORT_RR 14
+
+static void preboot_secure_lbw_rr_gen(int rr_idx, u32 min, u32 max,
+		enum preboot_sec_engine_type type, bool is_short)
+{
+	int i;
+	u32 min_breg, max_breg, rr_calc;
+	struct preboot_sec_rrs_cfg *cfg = &preboot_sec_lbw_rrs_tbl[type];
+
+	if (is_short) {
+		rr_calc = rr_idx;
+		min_breg = cfg->min_short_breg;
+		max_breg = cfg->max_short_breg;
+	} else {
+		rr_calc = rr_idx - MAX_LBW_SHORT_RR;
+		min_breg = cfg->min_full_breg;
+		max_breg = cfg->max_full_breg;
+	}
+
+	for (i = 0; i < cfg->instances_num; i++) {
+		preboot_secure_update_rr_reg(rr_calc, cfg->instances_dist * i,
+				min_breg, max_breg, min, max);
+
+		preboot_secure_update_hit_reg(rr_idx, cfg, i, false);
+	}
+}
+
+static void preboot_secure_lbw_rr_wrap(int rr_idx, u32 min, u32 max, bool is_short)
+{
+	int i;
+
+	for (i = TPC_MME_IF; i <= ELBI_OR_COMMON_IF2; i++)
+		preboot_secure_lbw_rr_gen(rr_idx, min, max, (enum preboot_sec_engine_type)i,
+				is_short);
+}
+
+__unused static void preboot_secure_lbw_rr_full(int rr_idx, u64 min64, u64 max64)
+{
+	u32 min = min64 & ~HL_CFG_BASE;
+	u32 max = max64 & ~HL_CFG_BASE;
+
+	preboot_secure_lbw_rr_wrap(rr_idx, min, max, false);
+}
+
+static void preboot_secure_lbw_rr_short(int rr_idx, u64 min64, u64 max64)
+{
+	u32 min = (min64 & ~HL_CFG_BASE) >> SHIFT_4K_POS;
+	u32 max = (max64 & ~HL_CFG_BASE) >> SHIFT_4K_POS;
+
+	preboot_secure_lbw_rr_wrap(rr_idx, min, max, true);
+}
+
+#define MAX_HBW_SHORT_RR	6
+#define MAX_HBW_READ_RRS	7
+#define BITS_IN_REG		32
+
+static void preboot_secure_hbw_rr_full_if(int rr_idx, u64 min64, u64 max64,
+		enum preboot_sec_engine_type type)
+{
+	u32 min_l = (u32)(min64);
+	u32 min_h = (u32)(min64 >> BITS_IN_REG);
+	u32 max_l = (u32)(max64);
+	u32 max_h = (u32)(max64 >> BITS_IN_REG);
+	u32 rr_base, rr_dest, rr_calc;
+	int i;
+	struct preboot_sec_rrs_cfg *cfg = &preboot_sec_hbw_rrs_tbl[type];
+
+	rr_calc = rr_idx - MAX_HBW_SHORT_RR;
+	for (i = 0; i < cfg->instances_num; i++) {
+		rr_base = rr_calc * sizeof(u32) + cfg->instances_dist * i;
+		rr_dest = rr_base + cfg->min_full_breg;
+		regmap_writel(min_l, rr_dest);
+		rr_dest = rr_base + cfg->min_full_breg_hi;
+		regmap_writel(min_h, rr_dest);
+		rr_dest = rr_base + cfg->max_full_breg;
+		regmap_writel(max_l, rr_dest);
+		rr_dest = rr_base + cfg->max_full_breg_hi;
+		regmap_writel(max_h, rr_dest);
+
+		/*
+		 * RRs 8..9 only blocks write operations
+		 */
+		if (rr_idx > MAX_HBW_READ_RRS)
+			preboot_secure_update_hit_reg(rr_idx, cfg, i, true);
+		else
+			preboot_secure_update_hit_reg(rr_idx, cfg, i, false);
+	}
+}
+
+static void preboot_secure_hbw_rr_short_if(int rr_idx, u32 min, u32 max,
+		enum preboot_sec_engine_type type)
+{
+	int i;
+	struct preboot_sec_rrs_cfg *cfg = &preboot_sec_hbw_rrs_tbl[type];
+
+	for (i = 0; i < cfg->instances_num; i++) {
+		preboot_secure_update_rr_reg(rr_idx, cfg->instances_dist * i, cfg->min_short_breg,
+				cfg->max_short_breg, min, max);
+
+		preboot_secure_update_hit_reg(rr_idx, cfg, i, false);
+	}
+}
+
+__unused static void preboot_secure_hbw_rr_full(int rr, u64 min64, u64 max64)
+{
+	u64 min = min64 >> SHIFT_4K_POS;
+	u64 max = max64 >> SHIFT_4K_POS;
+	int i;
+
+	for (i = TPC_MME_IF; i < COMMON_IF_SHRD2; i++)
+		preboot_secure_hbw_rr_full_if(rr, min, max, (enum preboot_sec_engine_type)i);
+}
+
+static void preboot_secure_hbw_rr_short(int rr, u64 min64, u64 max64)
+{
+	u32 min = (min64 & ~SDRAM_BASE) >> SHIFT_4K_POS;
+	u32 max = (max64 & ~SDRAM_BASE) >> SHIFT_4K_POS;
+	int i;
+
+	for (i = TPC_MME_IF; i < COMMON_IF_SHRD2; i++)
+		preboot_secure_hbw_rr_short_if(rr, min, max, (enum preboot_sec_engine_type)i);
+}
+
+static void preboot_secure_lbw(void)
+{
+	u64 min, max;
+	/*
+	 * There are 18(0..17 rr idx) RRs for LBW.
+	 * The classification and apis are as listed below:
+	 *
+	 * 1) 14(0..13 rr idx) Regions with 4KB granularity
+	 * API: preboot_secure_lbw_rr_short(rr idx, min addr, max addr)
+	 *
+	 * 2) 4(14..17 rr idx) Regions with full address range.
+	 * API: preboot_secure_lbw_rr_full(rr idx, min addr, max addr)
+	 *
+	 * rr idx type : greco_sec_if_lbw_rrs
+	 * NOTE: The apis listed above will block all read and write
+	 * transactions for the input address range.
+	 */
+
+	/*
+	 * Workaround for H5 Errata: GOYA2_0100
+	 * Block PCIE_MSI : RR(LBW_RR_PCIE_MSI)
+	 */
+	min = mmPCIE_MSI_BASE;
+	max = mmPCIE_MSI_BASE + PCIE_MSI_SECTION;
+	preboot_secure_lbw_rr_short(LBW_RR_PCIE_MSI, min, max);
+}
+
+static void preboot_secure_hbw(void)
+{
+	u64 min, max;
+	/*
+	 * There are 10(0..9 rr idx) RRs for HBW
+	 * NOTE: All the RRs for HBW are of 4KB granularity
+	 *
+	 * 1) 6(0..5 rr idx) Regions with 39 bit addressing (0x7F_Fx_xxxx)
+	 * API: preboot_secure_hbw_rr_short(rr idx, min addr, max addr)
+	 *
+	 * 2) 2(6..7 rr idx) Regions with 50 bit addressing.
+	 * API: preboot_secure_hbw_rr_full(rr idx, min addr, max addr)
+	 *
+	 * 3) 2(8..9 rr idx) Regions with 50 bit addressing, to block only write.
+	 * API: preboot_secure_hbw_rr_full(rr idx, min addr, max addr)
+	 *
+	 * rr idx type : greco_sec_if_hbw_rrs
+	 */
+
+	/*
+	 * Workaround for H5 Errata: GOYA2_0303
+	 * Block Boot ROM and FW SRAM : RR(HBW_RR_BOOTROM)
+	 */
+	min = BOOT_ROM_BASE;
+	max = BOOT_ROM_BASE + BOOT_ROM_SIZE + FW_SRAM_SIZE;
+	preboot_secure_hbw_rr_short(HBW_RR_BOOTROM, min, max);
+}
+
+void preboot_security_init(void)
+{
+	/* TODO add check for security strap ON */
+	preboot_secure_arc();
+	preboot_secure_lbw();
+	preboot_secure_hbw();
+}
