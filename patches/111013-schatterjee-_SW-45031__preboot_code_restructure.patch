+		.setup = module_i2c_s_setup,
+		.check = module_i2c_s_check,
+		.disable = module_i2c_s_disable,
+		.run = module_i2c_s_run,
+		.enable = module_i2c_s_enable,
+		.run_fast = module_i2c_s_run_fast,
+		.teardown = module_i2c_s_teardown,
+		.run_noreturn = module_i2c_s_run_noret,
+	},
+};
+
+static const char *preboot_ver_str = "Preboot " VERSION_STR;
+
+#define BTL_VER_PREFIX	"BTL version "
+#define FUSE_VER_PREFIX	"Fuse version "
+
+static char preboot_vers[][VERSION_MAX_LEN] = {
+	[PREBOOT_BTL_VER] = { BTL_VER_PREFIX },
+	[PREBOOT_EFUSE_VER] = { FUSE_VER_PREFIX },
+};
+
+const char *preboot_get_version(enum preboot_vers ver)
+{
+	return preboot_vers[ver];
+}
+
+static void preboot_version(void)
+{
+	unsigned long offset = (unsigned long) preboot_vers[PREBOOT_BTL_VER];
+	u32 btlver = regmap_readl(mmPREBOOT_VER_OFFSET);
+	int i, btl_ver_sz;
+
+	preboot_puts("\n");
+	preboot_puts_raw(preboot_vers[PREBOOT_BTL_VER]);
+	preboot_puth(btlver, true);
+	preboot_puts_raw(preboot_ver_str);
+	preboot_puts("\n");
+
+	/* get to the end of the predefined btl string */
+	for (i = 0; i < VERSION_MAX_LEN; i++)
+		if (preboot_vers[PREBOOT_BTL_VER][i] == '\0')
+			break;
+
+	/* convert and copy the btl version */
+	i += preboot_uint2hexstring(&preboot_vers[PREBOOT_BTL_VER][i],
+				    btlver, true);
+
+	/* separate the btl from preboot */
+	preboot_vers[PREBOOT_BTL_VER][i++] = '\n';
+	btl_ver_sz = i;
+
+	/* copy the preboot version */
+	for (int j = 0; j < VERSION_MAX_LEN - btl_ver_sz - 1; j++) {
+		preboot_vers[PREBOOT_BTL_VER][i++] = preboot_ver_str[j];
+		if (preboot_ver_str[j] == '\0')
+			break;
+	}
+
+	regmap_writel((u32)(offset & ~SDRAM_BASE), mmPREBOOT_VER_OFFSET);
+}
+
+#define FUSE_VER_NOT_IMPLEMENT	"not implemented"
+__weak int hl_fuse_get_version(char *version, size_t size)
+{
+	int i, max_sz = sizeof(FUSE_VER_NOT_IMPLEMENT);
+	const char *not_impl = FUSE_VER_NOT_IMPLEMENT;
+
+	max_sz = size < max_sz ? size : max_sz;
+
+	for (i = 0; i < max_sz; i++)
+		version[i] = not_impl[i];
+
+	version[max_sz] = '\0';
+
+	return 0;
+}
+
+struct preboot_str_size {
+	char *str;
+	size_t size;
+};
+
+void preboot_fuse_version_serialize(char *ver, size_t size,
+				    struct preboot_fuse_ver_data *ver_data)
+{
+	struct preboot_str_size ver_str[] = {
+		{ ver_data->table_ver, ver_data->table_ver_sz },
+		{ ver_data->dev_id, ver_data->dev_id_sz },
+		{ ver_data->fab, ver_data->fab_sz },
+		{ ver_data->lot, ver_data->lot_sz },
+		{ ver_data->wafer, ver_data->wafer_sz },
+		{ ver_data->xaddr, ver_data->xaddr_sz },
+		{ ver_data->yaddr, ver_data->yaddr_sz },
+	};
+	int i, j;
+
+	for (i = 0; i < ARRAY_SIZE(ver_str); i++) {
+		for (j = 0; j < ver_str[i].size; j++) {
+			if (!size)
+				break;
+			*ver++ = ver_str[i].str[j];
+			size--;
+		}
+		if (!size)
+			break;
+		*ver++ = '-';
+		size--;
+	}
+	/* Replace the last '-' with NULL terminator */
+	ver[-1] = '\0';
+}
+
+#define FUSE_VER_UNKNOWN	"unknown"
+static void fuse_version(void)
+{
+	unsigned long offset = (unsigned long)preboot_vers[PREBOOT_EFUSE_VER];
+	size_t ver_prefix_len = sizeof(FUSE_VER_PREFIX) - 1;
+	char *version = preboot_vers[PREBOOT_EFUSE_VER] + ver_prefix_len;
+	const char *unknown = FUSE_VER_UNKNOWN;
+	int err, i;
+
+	err = hl_fuse_get_version(version, VERSION_MAX_LEN - ver_prefix_len);
+	if (err)
+		for (i = 0; i < sizeof(FUSE_VER_UNKNOWN); i++)
+			version[i] = unknown[i];
+
+	preboot_puts_raw(preboot_vers[PREBOOT_EFUSE_VER]);
+	preboot_puts("\n");
+
+	regmap_writel((u32)(offset & ~SDRAM_BASE), mmFUSE_VER_OFFSET);
+}
+
+__weak void preboot_security_init(void) {}
+__weak void preboot_security_dynamic_init(void) {}
+__weak void preboot_security_dynamic_vers_init(u64 ver_off, u32 size) {}
+__weak void preboot_security_dynamic_img_sram_open(
+		enum mem_region img_reg,
+		enum preboot_mem_access_mode mode)
+{}
+__weak void preboot_security_dynamic_img_sram_close(void) {}
+__weak void preboot_security_dynamic_img_spsram_open(void) {}
+__weak void preboot_security_dynamic_img_spsram_close(void) {}
+__weak void preboot_security_cleanup_before_run(void) {}
+__weak void preboot_led_on(void) {}
+__weak void preboot_sp_sram_init(void) {}
+__weak void hl_ram_init(void) {}
+
+bool preboot_is_overlap_address_range(u64 addr, int len)
+{
+	if (addr + len <= (uintptr_t)&_start || addr >= (uintptr_t)&__stack_top)
+		return false;
+
+	return true;
+}
+
+__weak bool preboot_sram_is_valid_address_range(u64 addr, int len)
+{
+	if (addr >= SDRAM_BASE && addr + len <= SDRAM_BASE + SRAM_SIZE)
+		return !preboot_is_overlap_address_range(addr, len);
+
+	if (addr >= FIT_IMG_SPSRAM_BASE && addr + len <= FIT_IMG_SPSRAM_END)
+		return true;
+
+	return false;
+}
+
+__weak bool preboot_is_valid_address_range(u64 addr, int len)
+{
+	return preboot_sram_is_valid_address_range(addr, len);
+}
+
+__weak void preboot_dev_enable_caps(void) {}
+
+void preboot_set_enabled_cap(enum hl_fw_en_caps en_cap)
+{
+	preboot_en_caps |= BIT(en_cap);
+}
+
+void preboot_finalize_enabled_caps(void)
+{
+	if (!preboot_en_caps)
+		return;
+
+	boot_info_set(HL_BOOT_INFO_EN_CAPS, &preboot_en_caps,
+		      sizeof(preboot_en_caps));
+}
+
+__weak bool hl_is_watchdog_reset(void)
+{
+	return false;
+}
+
+void preboot_boot_info_set_fw_info(void)
+{
+	fw_info.version = HL_FW_INFO_VERSION;
+	boot_info_set(HL_BOOT_INFO_FW_INFO, &fw_info, sizeof(fw_info));
+}
+
+u32 err_sts_reg_val;
+
+static void preboot_process_last_boot_info(void)
+{
+	struct hl_fw_info_compat fw_info_local = {};
+	u32 boot_err = HL_FW_FIT_BOOT_ERR_NONE;
+	u32 data_size, rst_src;
+	u32 nic_en_local;
+	u32 fw_upd_is_dis = 0;
+
+	if (!boot_info_get(HL_BOOT_INFO_FIT_BOOT_ERROR, &boot_err,
+			   sizeof(boot_err), &data_size)) {
+		switch (boot_err) {
+		case HL_FW_FIT_BOOT_ERR_NONE:
+			break;
+		case HL_FW_FIT_BOOT_ERR_CORRUPTED:
+		case HL_FW_FIT_BOOT_ERR_ADDRESS_VIOLATION:
+		case HL_FW_FIT_BOOT_ERR_NOT_RUNNABLE:
+			cpu_boot_err_clrset(CPU_BOOT_ERR0_FIT_CORRUPTED, true);
+			break;
+		case HL_FW_FIT_BOOT_ERR_REVOKED_KEY:
+		case HL_FW_FIT_BOOT_ERR_SVN:
+		case HL_FW_FIT_BOOT_ERR_SIGNATURE:
+			cpu_boot_err_clrset(CPU_BOOT_ERR0_SECURITY_FAIL, true);
+			break;
+		}
+
+		i2csi_set_boot_err(boot_err, true);
+	}
+
+	if (!boot_info_get(HL_BOOT_INFO_NIC_EN, &nic_en_local,
+			   sizeof(nic_en_local), &data_size))
+		preboot_nic_en(nic_en_local);
+
+	/*
+	 * Preserve pci disable if exist, except for PRSTN, in which it is
+	 * required to clear previous indication.
+	 */
+	rst_src = regmap_readl(mmPSOC_GLOBAL_CONF_RST_SRC);
+	if (rst_src != HL_PRSTN_RST)
+		boot_info_get(HL_BOOT_INFO_FW_UPD_CLOSURE, &fw_upd_is_dis,
+			      sizeof(fw_upd_is_dis), &data_size);
+
+	module_fwupd_pcie_disable(fw_upd_is_dis);
+
+	if (!boot_info_get(HL_BOOT_INFO_FW_INFO, &fw_info_local,
+			   sizeof(fw_info_local), &data_size)) {
+		if (fw_info_local.version == HL_FW_INFO_VERSION)
+			fw_info = fw_info_local;
+		else
+			preboot_puts_hex("Ignoring fw info with version: ",
+					 fw_info_local.version, false);
+	}
+}
+
+__weak void hl_dev_pll_init(void) {}
+__weak void hl_clock_gating_init(void) {}
+__weak void preboot_process_last_rma_info(void) {}
+__weak void preboot_rate_limiter_init(void) {}
+__weak void preboot_hbm_credits_init(void) {}
+__weak void preboot_e2e_credits_init(void) {}
+__weak void preboot_device_id_init(void) {}
+__weak u32 preboot_device_id_get(void) { return 0; }
+
+void preboot_main(void)
+{
+	u64 ver_off = (uintptr_t)preboot_vers;
+	bool is_sec_en;
+
+	cpu_boot_sts_set(CPU_BOOT_STATUS_IN_PREBOOT);
+	/* Enable the errors communication */
+	cpu_boot_err_clrset(CPU_BOOT_ERR0_ENABLED, true);
+	/* Enable the device status communication */
+	cpu_boot_dev_sts_clrset(CPU_BOOT_DEV_STS0_ENABLED, true);
+
+	/*
+	 * Note: we assume CPU frequency is not changed while CPU is running,
+	 * so the udelay init is done once before we start.
+	 */
+	udelay_init();
+
+	hl_dev_pll_init();
+
+	hl_uart_init();
+
+	spi_init();
+	spi_prot_late();
+	spi_prot_status();
+
+	preboot_sp_sram_init();
+
+	preboot_device_id_init();
+
+	preboot_e2e_credits_init();
+	preboot_hbm_credits_init();
+	preboot_rate_limiter_init();
+
+	preboot_security_init();
+	preboot_security_dynamic_init();
+	cpu_boot_sts_set(CPU_BOOT_STATUS_SECURITY_READY);
+
+	hl_ts_init();
+
+	/* Prepare boot FW versions and eFuse data for host */
+	preboot_version();
+	fuse_version();
+	preboot_security_dynamic_vers_init(ver_off, sizeof(preboot_vers));
+
+	preboot_led_on();
+	is_sec_en = preboot_security_is_enabled();
+	if (!is_sec_en)
+		hl_clock_gating_init();
+
+	hl_ram_init();
+	preboot_dev_enable_caps();
+	crc32_init_lookup();
+	preboot_process_last_boot_info();
+	preboot_process_last_rma_info();
+
+	if (hl_is_watchdog_reset())
+		i2csi_set_wd_err(HL_FW_RESET_CAUSE_WATCHDOG);
+
+	module_handle_cmds(cmd_ops, ARRAY_SIZE(cmd_ops));
+}
+
+bool preboot_error_inform(u32 major, u32 minor)
+{
+	/*
+	 * ensuring sending the first error occurrence
+	 * to reset the error just use the clr_on_read
+	 */
+	if (!pending_error.error) {
+		pending_error.major = major;
+		pending_error.minor = minor;
+		return true;
+	}
+
+	return false;
+}
+
+bool preboot_error_is_pending(void)
+{
+	return !!pending_error.error;
+}
+
+u32 preboot_error_read_and_clr(u32 *major, u32 *minor)
+{
+	*major = pending_error.major;
+	*minor = pending_error.minor;
+
+	pending_error.error = 0;
+	return *major;
+}
+
+__weak int preboot_set_sram_sf_access(bool is_enable)
+{
+	return 1;
+}
+
diff --git a/app/recovery/Makefile b/app/recovery/Makefile
new file mode 100644
index 0000000..d30c09d
--- /dev/null
+++ b/app/recovery/Makefile
@@ -0,0 +1,55 @@
+CC = $(CROSS_COMPILE)gcc
+OBJCOPY = $(CROSS_COMPILE)objcopy
+BASE_DEV_NAME := $(shell echo $(HL_DEV) | cut -d'_' -f1)
+HL_DEV_SUBTYPE := $(shell echo $(HL_DEV) | cut -d'_' -s -f2,3)
+HL_DEV_ARCH := arch/$(BASE_DEV_NAME)/$(HL_DEV_SUBTYPE)
+ifeq ($(BASE_DEV_NAME),greco)
+	BASE_DEV_NAME := goya2
+endif
+
+CFLAGS += -I$(SPECS_EMBEDDED_DIR)
+CFLAGS += -I$(SPECS_DIR)/$(BASE_DEV_NAME)/asic_reg
+CFLAGS += -Wall -Werror
+CFLAGS += -g -c
+CFLAGS += -I ./../../include/ -I ./../../ -I ./../../lib/common/ -I ./../../$(HL_DEV_ARCH)/
+
+CFLAGS += -Os -fdata-sections -ffunction-sections
+SFLAGS := $(CFLAGS) -D__ASSEMBLY__
+
+RECOVERY_LD_SCRIPT := ./../../$(HL_DEV_ARCH)/recovery.lds
+LDFLAGS := -g -nostdlib -static
+LDFLAGS += -Wl,--gc-sections
+LDLIBS := -lgcc
+
+RECOVERY_SRCS_C := $(shell ls *.c)
+RECOVERY_SRCS_C += $(shell ls ../../lib/common/*.c)
+RECOVERY_SRCS_C += $(shell ls ../../$(HL_DEV_ARCH)/common.c)
+RECOVERY_SRCS_C += $(shell ls ../../$(HL_DEV_ARCH)/$(HL_TARGET).c)
+RECOVERY_APP_S := $(shell ls crt0_recovery.S)
+
+RECOVERY_OBJECTS := $(RECOVERY_SRCS_C:.c=.o)
+RECOVERY_OBJECTS += $(RECOVERY_APP_S:.S=.o)
+
+# TODO: add version info
+
+all: recovery.bin
+
+%.bin: %
+	$(OBJCOPY) -O binary -R .note.gnu.build-id $< $@
+
+recovery: $(RECOVERY_OBJECTS) $(RECOVERY_LD_SCRIPT)
+	@$(CC) $(LDFLAGS) -T $(RECOVERY_LD_SCRIPT) -o $@ -Wl,--start-group $(RECOVERY_OBJECTS) $(LDLIBS) -Wl,--end-group
+
+%.lds: %.lds.S
+	@$(CC) $(SFLAGS) -E -P -nostdinc -o $@ $<
+
+%.o: %.c
+	@$(CC) $(CFLAGS) -o $@ $<
+
+%.o: %.S
