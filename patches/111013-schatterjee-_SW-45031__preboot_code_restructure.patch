diff --git a/app/ext_rom/common_erom.lds.S b/app/ext_rom/common_erom.lds.S
new file mode 100644
index 0000000..d053882
--- /dev/null
+++ b/app/ext_rom/common_erom.lds.S
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright 2021 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include "common.h"
+
+MEMORY { .sram : ORIGIN = EXT_ROM_TEXT_BASE, LENGTH = EXT_ROM_TEXT_LENGTH }
+OUTPUT_FORMAT("elf32-littlearc", "elf32-bigarc", "elf32-littlearc")
+OUTPUT_ARCH(arc)
+
+ENTRY(_start)
+SECTIONS
+{
+	.text : ALIGN(4) {
+		crt0_common_erom.o (.text*)
+		* (.text*)
+	} > .sram
+
+	.bss : {
+		. = ALIGN(8);
+		__bss_start = . ;
+		*(.bss*)
+		__bss_end = . ;
+	} > .sram
+
+	.stack : {
+		. = ALIGN(8);
+		__stack = . ;
+		. = . + 512 ;
+		__stack_top = . ;
+	} > .sram
+
+	.note.gnu.build-id : { *(.note.gnu.build-id) } > .sram
+}
diff --git a/app/ext_rom/crt0_common_erom.S b/app/ext_rom/crt0_common_erom.S
new file mode 100644
index 0000000..ed589c7
--- /dev/null
+++ b/app/ext_rom/crt0_common_erom.S
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright 2021 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+/*
+ * This is ext_rom pcie code entry point
+ * Clearing bss,setting lr and jumping to C code
+ */
+.globl  _start
+_start:
+
+/* lf2flt: to avoid compiler (buildroot wrapper) warning during linkage */
+.global lf2flt
+lf2flt:
+
+	/*
+	 * Arcboot ROM stack is utilized as the context
+	 * needs to switch back to ROM code
+	 */
+
+	/* Clear BSS */
+	mov     r5, __bss_start
+	sub     r6, __bss_end, r5
+	lsr.f   lp_count, r6, 2
+	lpnz    1f
+	st.ab   0, [r5, 4]
+1:
+	push_s  blink
+	bl      erom_main_function
+	pop_s   blink
+	j_s     [blink]
