index 0000000..ba95279
--- /dev/null
+++ b/arch/gaudi/arm/pll.c
@@ -0,0 +1,158 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2016-2021 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <stddef.h>
+
+#include <gaudi_blocks.h>
+#include <psoc_pci_pll_regs.h>
+#include <preboot.h>
+#include <pll.h>
+
+#include "common.h"
+
+#define PCI_TMP_DIV	3	/* temporary divider setting for pci pll */
+#define PCI_DIV2_FACTOR	7
+
+static struct hl_pll_cfg gaudi_pll_cfg[] = {
+	{
+		.name = "IF_W", .base = mmIF_W_PLL_BASE & ~HL_CFG_BASE,
+		.nr = 0, .nf = 63, .od = 1, .nb = 31, /* 1600 */
+		.div_factor = { 0, 1, 2, 7 },
+		.div_sel = { HL_PLL_PLL_CLK,
+			     HL_PLL_DIV_PLL,
+			     HL_PLL_DIV_PLL,
+			     HL_PLL_DIV_PLL
+		},
+	}, {
+		.name = "IF_E", .base = mmIF_E_PLL_BASE & ~HL_CFG_BASE,
+		.nr = 0, .nf = 63, .od = 1, .nb = 31, /* 1600 */
+		.div_factor = { 0, 1, 2, 7 },
+		.div_sel = { HL_PLL_PLL_CLK,
+			     HL_PLL_DIV_PLL,
+			     HL_PLL_DIV_PLL,
+			     HL_PLL_DIV_PLL
+		},
+	}, {
+		.name = "MESH_W", .base = mmMESH_W_PLL_BASE & ~HL_CFG_BASE,
+		.nr = 0, .nf = 59, .od = 1, .nb = 29, /* 1500 */
+		.div_factor = { 0, 1, 2, 7 },
+		.div_sel = { HL_PLL_PLL_CLK,
+			     HL_PLL_DIV_PLL,
+			     HL_PLL_DIV_PLL,
+			     HL_PLL_DIV_PLL
+		},
+	}, {
+		.name = "SRAM_W", .base = mmSRAM_W_PLL_BASE & ~HL_CFG_BASE,
+		.nr = 4, .nf = 331, .od = 3, .nb = 165, /* 830 */
+		.div_factor = { 0, -1, -1, -1 },
+		.div_sel = { HL_PLL_PLL_CLK,
+			     HL_PLL_REF_CLK,
+			     HL_PLL_REF_CLK,
+			     HL_PLL_REF_CLK
+		},
+	}, {
+		.name = "MESH_E", .base = mmMESH_E_PLL_BASE & ~HL_CFG_BASE,
+		.nr = 0, .nf = 59, .od = 1, .nb = 29, /* 1500 */
+		.div_factor = { 0, 1, 2, 7 },
+		.div_sel = { HL_PLL_PLL_CLK,
+			     HL_PLL_DIV_PLL,
+			     HL_PLL_DIV_PLL,
+			     HL_PLL_DIV_PLL
+		},
+	}, {
+		.name = "SRAM_E", .base = mmSRAM_E_PLL_BASE & ~HL_CFG_BASE,
+		.nr = 4, .nf = 331, .od = 3, .nb = 165, /* 830 */
+		.div_factor = { 0, -1, -1, -1 },
+		.div_sel = { HL_PLL_PLL_CLK,
+			     HL_PLL_REF_CLK,
+			     HL_PLL_REF_CLK,
+			     HL_PLL_REF_CLK
+		},
+	}, {
+		.name = "PCI", .base = mmPSOC_PCI_PLL_BASE & ~HL_CFG_BASE,
+		.nr = 4, .nf = 331, .od = 3, .nb = 165, /* 830 */
+		.div_factor = { PCI_TMP_DIV, 0, PCI_TMP_DIV, 9 },
+		.div_sel = { HL_PLL_DIV_PLL,	/* temporary setting */
+			     HL_PLL_PLL_CLK,
+			     HL_PLL_DIV_PLL,
+			     HL_PLL_DIV_PLL
+		},
+	}, {
+		.name = "NIC0", .base = mmNIC0_PLL_BASE & ~HL_CFG_BASE,
+		.nr = 24, .nf = 1665, .od = 3, .nb = 832, /* 833 MHz */
+		.div_factor = { 0, 4, 8, -1 },
+		.div_sel = { HL_PLL_PLL_CLK,
+			     HL_PLL_DIV_PLL,
+			     HL_PLL_DIV_PLL,
+			     HL_PLL_REF_CLK
+		},
+	}, {
+		.name = "NIC1", .base = mmNIC1_PLL_BASE & ~HL_CFG_BASE,
+		.nr = 24, .nf = 1665, .od = 3, .nb = 832, /* 833 MHz */
+		.div_factor = { 0, 4, 8, -1 },
+		.div_sel = { HL_PLL_PLL_CLK,
+			     HL_PLL_DIV_PLL,
+			     HL_PLL_DIV_PLL,
+			     HL_PLL_REF_CLK
+		},
+	}, {
+		.name = "HBM", .base = mmPSOC_HBM_PLL_BASE & ~HL_CFG_BASE,
+		.nr = 0, .nf = 63, .od = 3, .nb = 31, /* 800 MHz */
+		.div_factor = { 0, 1, -1, -1 },
+		.div_sel = { HL_PLL_PLL_CLK,
+			     HL_PLL_DIV_PLL,
+			     HL_PLL_REF_CLK,
+			     HL_PLL_REF_CLK
+		},
+	}, {
+		.name = "NIC2_HBM", .base = mmNIC2_HBM_PLL_BASE & ~HL_CFG_BASE,
+		.nr = 0, .nf = 63, .od = 3, .nb = 31, /* 800 MHz */
+		.div_factor = { 0, 1, -1, -1 },
+		.div_sel = { HL_PLL_PLL_CLK,
+			     HL_PLL_DIV_PLL,
+			     HL_PLL_REF_CLK,
+			     HL_PLL_REF_CLK
+		},
+	},
+};
+
+void hl_dev_pll_init(void)
+{
+	int i;
+
+	/* PLLs list to be set back to ref clock */
+	struct hl_pll_cfg gaudi_pll_ref_cfg[] =  {
+		{ .base = mmPSOC_MME_PLL_BASE & ~HL_CFG_BASE },
+		{ .base = mmPSOC_TPC_PLL_BASE & ~HL_CFG_BASE },
+		{ .base = mmNIC2_MME_PLL_BASE & ~HL_CFG_BASE },
+		{ .base = mmNIC2_TPC_PLL_BASE & ~HL_CFG_BASE },
+	};
+
+	hl_pll_init(gaudi_pll_cfg, ARRAY_SIZE(gaudi_pll_cfg));
+
+	for (i = 0; i < ARRAY_SIZE(gaudi_pll_ref_cfg); i++)
+		hl_pll_switch_to_ref(&gaudi_pll_ref_cfg[i]);
+}
+
+#define PCI_PLL_BASE	(mmPSOC_PCI_PLL_BASE & ~HL_CFG_BASE)
+
+void hl_dev_pci_pll_wa(void)
+{
+	/*
+	 * pci pll div0 frequency must be equal or lower than div2 for pci phy
+	 * fw upgrade.
+	 * after phy fw upgrade is complete and pci link is up we move div0
+	 * and div2 to their nominal clock frequencies.
+	 */
+	hl_pll_clk_switch_to_ref(PCI_PLL_BASE, HL_PLL_DIV0);
+	hl_pll_clk_switch_to_pll(PCI_PLL_BASE, HL_PLL_DIV0, HL_PLL_PLL_CLK);
+
+	hl_pll_clk_switch_to_ref(PCI_PLL_BASE, HL_PLL_DIV2);
+	regmap_writel(PCI_DIV2_FACTOR, mmPSOC_PCI_PLL_DIV_FACTOR_2);
+	regmap_writel(1, mmPSOC_PCI_PLL_DIV_FACTOR_CMD_2);
+	hl_pll_clk_switch_to_pll(PCI_PLL_BASE, HL_PLL_DIV2, HL_PLL_DIV_PLL);
+	hl_uart_init();
+}
diff --git a/arch/gaudi/arm/ppboot.lds.S b/arch/gaudi/arm/ppboot.lds.S
new file mode 100644
index 0000000..8109952
--- /dev/null
+++ b/arch/gaudi/arm/ppboot.lds.S
@@ -0,0 +1,45 @@
+/*
+ * (C) Copyright 2017 HabanaLabs, Ltd.
+ * Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#include "common.h"
+
+MEMORY { .sram : ORIGIN = PPBOOT_TEXT_BASE, LENGTH = PPBOOT_SIZE }
+
+OUTPUT_FORMAT("elf64-littleaarch64", "elf64-littleaarch64", "elf64-littleaarch64")
+OUTPUT_ARCH(aarch64)
+ENTRY(_start)
+SECTIONS
+{
+	.text : {
+		. = ALIGN(8);
+		app/ppboot/crt0_ppboot.o (.text*)
+		* (.text*)
+	} >.sram
+
+	.bss : {
+		. = ALIGN(8);
+		__bss_start = . ;
+		*(.bss*)
+		__bss_end = . ;
+	} > .sram
+
+	.stack : {
+		. = ALIGN(8);
+		__stack = . ;
+		. = . + 1024 ;
+		__stack_top = . ;
+	} > .sram
+
+	.stack2 : {
+		. = ALIGN(8);
+		__stack2 = . ;
+		. = . + 512 ;
+		__stack_top2 = . ;
+	} > .sram
+
+	.note.gnu.build-id : { *(.note.gnu.build-id) } > .sram
+}
