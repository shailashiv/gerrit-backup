diff --git a/arch/gaudi2/arm/pldm.c b/arch/gaudi2/arm/pldm.c
new file mode 100644
index 0000000..dc27f54
--- /dev/null
+++ b/arch/gaudi2/arm/pldm.c
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2020 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <stdbool.h>
+
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+#include <psoc_global_conf_regs.h>
+
+#define SYS_CLOCK_FREQUENCY	155000ULL
+#define UART_CLOCK_FREQUENCY	11900ULL
+#define PLDM_UART_BAUDRATE	300
+
+u32 hl_skip_pcie_init(void)
+{
+	return 1;
+}
+
+u64 hl_pll_timestamp_freq_get(void)
+{
+	return SYS_CLOCK_FREQUENCY;
+}
+
+void hl_uart_init(void)
+{
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_8);	/* UART0 RXD */
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_9);	/* UART0 TXD */
+	preboot_uart_init(UART_CLOCK_FREQUENCY / PLDM_UART_BAUDRATE);
+}
+
+u32 hl_spi_baudr_get(void)
+{
+	u32 factor = 2; /* Min Divider */
+
+	/* baud rate doesn't support odd number */
+	return (factor + 1) & 0xFFFE;
+}
+
+void preboot_sync_btl(void) {}
+void preboot_init_pcie_phy(void) {}
+
diff --git a/arch/gaudi2/arm/ppboot.lds.S b/arch/gaudi2/arm/ppboot.lds.S
new file mode 100644
index 0000000..662f0f5
--- /dev/null
+++ b/arch/gaudi2/arm/ppboot.lds.S
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Copyright (C) 2020 HabanaLabs Ltd.
+ */
+
+#include "common.h"
+
+MEMORY { .sram : ORIGIN = PPBOOT_TEXT_BASE, LENGTH = PPBOOT_SIZE }
+
+OUTPUT_FORMAT("elf64-littleaarch64", "elf64-littleaarch64", "elf64-littleaarch64")
+OUTPUT_ARCH(aarch64)
+ENTRY(_start)
+SECTIONS
+{
+	.text : {
+		. = ALIGN(8);
+		app/ppboot/crt0_ppboot.o (.text*)
+		* (.text*)
+	} >.sram
+
+	.bss : {
+		. = ALIGN(8);
+		__bss_start = . ;
+		*(.bss*)
+		__bss_end = . ;
+	} > .sram
+
+	.stack : {
+		. = ALIGN(8);
+		__stack = . ;
+		. = . + 512 ;
+		__stack_top = . ;
+	} > .sram
+
+	.note.gnu.build-id : { *(.note.gnu.build-id) } > .sram
+}
