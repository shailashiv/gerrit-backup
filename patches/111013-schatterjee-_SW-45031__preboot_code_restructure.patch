- * All Rights Reserved.
- *
- */
-
-#include <preboot.h>
-#include <uart.h>
-
-/*
- * Compute CRC32 using 256 deep lookup table.
- * Taken from Linux implementation of Sarwate algorithm with additional bit
- * flip for pre and post CRC.
- * This implementation is only good for little endian processor.
- */
-
-#define CRC32_POLY	0xedb88320
-#define CRC_BITS	8
-#define TABLE_SIZE	256
-
-static u32 crc32table[256];
-
-void crc32_init_lookup(void)
-{
-	unsigned int i, j;
-	u32 crc = 1;
-
-	crc32table[0] = 0;
-
-	for (i = TABLE_SIZE >> 1; i; i >>= 1) {
-		crc = (crc >> 1) ^ ((crc & 1) ? CRC32_POLY : 0);
-		for (j = 0; j < TABLE_SIZE; j += 2 * i)
-			crc32table[i + j] = crc ^ crc32table[j];
-	}
-	for (i = 0; i < TABLE_SIZE; i++) {
-		crc = crc32table[i];
-		crc = crc32table[crc & 0xff] ^ (crc >> 8);
-	}
-}
-
-u32 crc32(u32 crc, unsigned char const *p, size_t len)
-{
-	crc = ~crc;
-
-	while (len--) {
-		crc ^= *p++;
-		crc = (crc >> 8) ^ crc32table[crc & 255];
-	}
-
-	return ~crc;
-}
diff --git a/preboot/crc8.c b/preboot/crc8.c
deleted file mode 100644
index ffcab61..0000000
--- a/preboot/crc8.c
+++ /dev/null
@@ -1,49 +0,0 @@
-// SPDX-License-Identifier:     GPL-2.0+
-/*
- * Copyright (C) 2017-2020 HabanaLabs Ltd.
- * All Rights Reserved.
- *
- */
-
-#include <preboot.h>
-#include <crc8.h>
-
-/* This code was copied from from linux/lib/crc8.c */
-
-/**
- * crc8_populate_msb - fill crc table for given polynomial in reverse bit order.
- *
- * @table:	table to be filled.
- * @polynomial:	polynomial for which table is to be filled.
- */
-void crc8_populate_msb(u8 table[CRC8_TABLE_SIZE], u8 polynomial)
-{
-	int i, j;
-	const u8 msbit = 0x80;
-	u8 t = msbit;
-
-	table[0] = 0;
-
-	for (i = 1; i < CRC8_TABLE_SIZE; i *= 2) {
-		t = (t << 1) ^ (t & msbit ? polynomial : 0);
-		for (j = 0; j < i; j++)
-			table[i+j] = table[j] ^ t;
-	}
-}
-
-/**
- * crc8 - calculate a crc8 over the given input data.
- *
- * @table: crc table used for calculation.
- * @pdata: pointer to data buffer.
- * @nbytes: number of bytes in data buffer.
- * @crc: previous returned crc8 value.
- */
-u8 crc8(const u8 table[CRC8_TABLE_SIZE], u8 *pdata, size_t nbytes, u8 crc)
-{
-	/* loop over the buffer data */
-	while (nbytes-- > 0)
-		crc = table[(crc ^ *pdata++) & 0xff];
-
-	return crc;
-}
