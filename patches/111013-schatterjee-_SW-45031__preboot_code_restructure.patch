+
+#include <common.h>
+#include <sha256.h>
+#include <hl_boot_desc.h>
+#include <string.h>
+#include "uart.h"
+#include "boot_if.h"
+#include "rma_info.h"
+#include "boot_info.h"
+#include "module_i2c_slave.h"
+#include "hl_i2c_slave_events.h"
+#include "i2cslave_indirect.h"
+
+#define ROUND_UP4(n)	(((n) + sizeof(u32) - 1) & ~(sizeof(u32) - 1))
+#define RMA_HEADER_ENTRY_SIZE		sizeof(struct rma_entry)
+#define RMA_SRAM_ECC_ENTRY_SIZE		sizeof(struct rma_sram_ecc_entry)
+#define MAX_SIZE_ONE_RMA_TABLE		RMA_SRAM_ECC_ENTRY_SIZE
+#define RMA_TABLE_HEADER_SIZE		sizeof(struct table_header)
+
+#define MAX_INFO_DESC_DATA	\
+	((MAX_SRAM_ECC_ENTRIES * MAX_SIZE_ONE_RMA_TABLE) + RMA_TABLE_HEADER_SIZE)
+
+#define FLASH_STORAGE_BLOCK0	0x100000
+#define FLASH_STORAGE_BLOCK1	(FLASH_STORAGE_BLOCK0 + 0x10000)
+#define FLASH_SECTOR_SIZE	0x10000
+#define FLASH_NUM_FLASH_INFO	2
+#define FLASH_SECTOR_MAGIC	0xAA55AA55
+
+static struct hbm_init_err rma_hbm_init_err;
+
+struct flash_header {
+	union {
+		struct {
+			u32 magic;
+			u32 stamp;
+			u32 reserved[6];
+		} __packed;
+		u32 data[8];
+	};
+} __packed;
+
+struct flash_mem_context {
+	u32 base[FLASH_NUM_FLASH_INFO];
+	u32 flash_size[FLASH_NUM_FLASH_INFO];
+};
+
+struct flash_mem_context flash_mem_context = {
+	.base = { FLASH_STORAGE_BLOCK0, FLASH_STORAGE_BLOCK1 },
+	.flash_size = { FLASH_SECTOR_SIZE, FLASH_SECTOR_SIZE },
+};
+
+int rma_erase(void)
+{
+	int ret, i;
+
+	for (i = 0; i < ARRAY_SIZE(flash_mem_context.base); i++) {
+		ret = spi_erase(flash_mem_context.base[i],
+				flash_mem_context.flash_size[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int flash_read(size_t offset, void *data, size_t size)
+{
+	int flash_select = -1;
+	u32 flash_offset;
+	struct flash_header header0, header1;
+
+	/* on every read we first choose a valid sector to read from */
+	spi_copy(&header0, flash_mem_context.base[0],
+				sizeof(struct flash_header), NULL);
+
+	spi_copy(&header1, flash_mem_context.base[1],
+				sizeof(struct flash_header), NULL);
+
+	if (header0.magic == FLASH_SECTOR_MAGIC &&
+	    header1.magic == FLASH_SECTOR_MAGIC) {
+		if (header1.stamp > header0.stamp)
+			flash_select = 1;
+		else
+			flash_select = 0;
+	} else if (header0.magic == FLASH_SECTOR_MAGIC) {
+		flash_select = 0;
+	} else if (header1.magic == FLASH_SECTOR_MAGIC) {
+		flash_select = 1;
+	}
+
+	if (flash_select < 0) {
+		/*
+		 * if no magic found returns a dummy zero, because framework requires
+		 * a success return. In this case framework will than try to search
+		 * for the boot-pointer validity, and return failure if not valid.
+		 */
+		memset(data, 0, size);
+		return 0;
+	}
+
+	if (size + offset > flash_mem_context.flash_size[flash_select])
+		return 1;
+
+	flash_offset = flash_mem_context.base[flash_select] + offset
+						+ sizeof(struct flash_header);
+	spi_copy(data, flash_offset, size, NULL);
+
+	return 0;
+}
+
+static int rma_info_get(u32 type, void *data, u32 *size)
+{
+	struct hl_boot_info_ptrs ptrs;
+	struct hl_boot_info_desc desc;
+	u32 i;
+	u8 chksum[HL_CHKSUM_SIZE];
+	int err;
+	u32 desc_offset, desc_start = sizeof(struct hl_boot_info_ptrs);
+
+	err = flash_read(0, &ptrs, sizeof(struct hl_boot_info_ptrs));
+	if (err)
+		return err;
+
+	if (ptrs.magic != HL_BOOT_INFO_MAGIC)
+		return 1;
+
+	for (i = 0; i < ptrs.count; i++) {
+		err = flash_read(desc_start + i * sizeof(u32),
+					&desc_offset, sizeof(desc_offset));
+		if (err)
+			return err;
+
+		err = flash_read(desc_offset,
+				    &desc, sizeof(struct hl_boot_info_desc));
+		if (err)
+			return err;
+
+		if (type != desc.type)
+			continue;
+
+		if (desc.magic != (HL_BOOT_INFO_DESC_MAGIC | type))
+			return 1;
+
+		if (desc.size > *size)
+			return 1;
+
+		err = flash_read(desc.offset, data, ROUND_UP4(desc.size));
+		if (err)
+			return err;
+
+		sha256_csum((u8 *)data, desc.size, chksum);
+		if (memcmp(chksum, desc.chksum, HL_CHKSUM_SIZE))
+			return 1;
+
+		*size = desc.size;
+
+		return 0;
+	}
+
+	return 1;
+}
+
+static void preboot_rma_type_print(struct rma_failure rma_failure)
+{
+	if (rma_failure.sram_ecc)
+		preboot_puts_raw("SRAM ECC ");
+
+	if (rma_failure.hbm_ecc)
+		preboot_puts_raw("HBM ECC ");
+
+	if (rma_failure.hbm_parity)
+		preboot_puts_raw("HBM Parity ");
+
+	if (rma_failure.row_replacement)
+		preboot_puts_raw("Row Replacement ");
+
+	if (rma_failure.hbm_init)
+		preboot_puts_raw("HBM Init ");
+
+	preboot_puts("\n");
+}
+
+/* Read RMA header table */
+static void preboot_process_rma_header(void)
+{
+	int err;
+	struct rma_table *table = NULL;
+	size_t size;
+	struct rma_entry *rma_header;
+
+	err = rma_table_read(RMA_HEADER_TABLE, &table, &size);
+	if (err || (size == 0))
+		return;
+
+	rma_header = (struct rma_entry *)table->data;
+	/* Update ERR_STS if any error */
+	if (rma_header->rma_failure.sram_ecc ||
+		rma_header->rma_failure.hbm_ecc ||
+		rma_header->rma_failure.hbm_parity ||
+		rma_header->rma_failure.row_replacement ||
+		rma_header->rma_failure.hbm_init) {
+		err_sts_reg_val |= HL_ERROR_STATUS_FATAL_ERROR;
+		i2csi_update_smbus_alert(rma_header);
+		/* set boot error bit for RMA */
+		cpu_boot_err_clrset(CPU_BOOT_ERR0_DEVICE_UNUSABLE_FAIL, true);
+		preboot_puts_raw("RMA Fatal error(s): ");
+		preboot_rma_type_print(rma_header->rma_failure);
+		i2c_rma_failure = rma_header->rma_failure;
+		if (rma_header->rma_failure.hbm_init)
+			rma_hbm_init_err = rma_header->hbm_init_err;
+	}
+
+	rma_table_free(table, size);
+}
+
+void preboot_process_last_rma_info(void)
+{
+	preboot_process_rma_header();
+}
+
+void rma_info_sram_ecc_err_sts(struct hl_i2ci_error_status_sram_ecc *op)
+{
+	int err;
+	struct rma_table *table = NULL;
+	size_t size;
+	struct rma_sram_ecc_entry *sram_ecc_entry, *entry_select;
+
+	err = rma_table_read(RMA_SRAM_ECC_TABLE, &table, &size);
+	if (err || (size == 0))
+		return;
+
+	op->total_err =  size / table->header.entry_size;
+
+	/*
+	 * Opcode's query of error status must
+	 * be an index within the total errors
+	 * that are currently active.
+	 */
+	if (op->entry_index < op->total_err) {
+		sram_ecc_entry = (struct rma_sram_ecc_entry *)table->data;
+		entry_select = &sram_ecc_entry[op->entry_index];
+		op->sram_index = entry_select->sram_index;
+		op->sram_address = entry_select->address;
+		op->cause.multiple_serr = entry_select->header.serr_cause;
+		op->cause.derr = entry_select->header.derr_cause;
+	}
+
+	rma_table_free(table, size);
+}
+
+void rma_info_hbm_ecc_err_sts(struct hl_i2ci_error_status_hbm_ecc *op)
+{
+	int err;
+	struct rma_table *table = NULL;
+	size_t size;
+	struct rma_hbm_ecc_entry *hbm_ecc_entry, *entry_select;
+
+	err = rma_table_read(RMA_HBM_ECC_TABLE, &table, &size);
+	if (err || (size == 0))
+		return;
+
+	op->total_err =  size / table->header.entry_size;
+
+	/*
+	 * Opcode's query of error status must
+	 * be an index within the total errors
+	 * that are currently active.
+	 */
+	if (op->entry_index < op->total_err) {
+		hbm_ecc_entry = (struct rma_hbm_ecc_entry *)table->data;
+		entry_select = &hbm_ecc_entry[op->entry_index];
+		op->device = entry_select->device;
+		op->pc = entry_select->pc;
+		op->sid = entry_select->sid;
+		op->bank = entry_select->bank;
+		op->cause.multiple_serr = entry_select->header.serr_cause;
+		op->cause.derr = entry_select->header.derr_cause;
+	}
+
+	rma_table_free(table, size);
+}
+
+void rma_info_hbm_par_err_sts(struct hl_i2ci_error_status_hbm_parity *op)
+{
+	int err;
+	struct rma_table *table = NULL;
+	size_t size;
+	struct rma_hbm_parity_entry *hbm_par_entry, *entry_select;
+
+	err = rma_table_read(RMA_HBM_PARITY_TABLE, &table, &size);
+	if (err || (size == 0))
+		return;
+
+	op->total_err =  size / table->header.entry_size;
+
+	/*
+	 * Opcode's query of error status must
+	 * be an index within the total errors
+	 * that are currently active.
+	 */
+	if (op->entry_index < op->total_err) {
+		hbm_par_entry = (struct rma_hbm_parity_entry *)table->data;
+		entry_select = &hbm_par_entry[op->entry_index];
+		op->device = entry_select->device;
+		op->pc = entry_select->pc;
+		op->cause.ca = entry_select->header.ca_cause;
+		op->cause.data_rd = entry_select->header.rd_cause;
+		op->cause.data_wr = entry_select->header.wr_cause;
+	}
+
+	rma_table_free(table, size);
+}
+
+void rma_info_hbm_init_err_sts(struct hl_i2ci_error_status_hbm_init *op)
+{
+	op->internal_loopback_error = rma_hbm_init_err.internal_loopback;
+	op->lane_detection_error = rma_hbm_init_err.lane_detection;
+	op->no_interrupts_error = rma_hbm_init_err.no_interrupts;
+	op->ecc_initialization_error = rma_hbm_init_err.ecc_init_err;
+	op->mcbist_error = rma_hbm_init_err.mc_bist;
+	op->training_error = rma_hbm_init_err.training_error;
+}
+
+void rma_info_hbm_row_replacement(struct hl_i2ci_dram *op)
+{
+	int err;
+	struct rma_table *table = NULL;
+	size_t size;
+	struct rma_hbm_row_replacement_entry *hbm_row_replacement, *entry_select;
+
+	err = rma_table_read(RMA_HBM_ROW_REPLACEMENT_TABLE, &table, &size);
+	if (err || (size == 0))
+		return;
+
+	op->number_of_replaced_rows = size / table->header.entry_size;
+
+	/*
+	 * Opcode's query of row index must
+	 * be an index within the replaced rows
+	 */
+	if (op->index_replaced_row_selection < op->number_of_replaced_rows) {
+		hbm_row_replacement = (struct rma_hbm_row_replacement_entry *)table->data;
+		entry_select = &hbm_row_replacement[op->index_replaced_row_selection];
+		op->replaced_row_hbm_index = entry_select->device;
+		op->replaced_row_pc_index = entry_select->pc;
+		op->replaced_row_bank_index = entry_select->bank;
+		op->replaced_row_cause.data = entry_select->header.data_cause;
+		op->replaced_row_address = entry_select->row;
+	}
+
+	rma_table_free(table, size);
+}
+
+#define RMA_HDR_TBL_SIZE (RMA_HEADER_ENTRY_SIZE + RMA_TABLE_HEADER_SIZE)
+
+u8 hbm_hdr_table[RMA_HDR_TBL_SIZE]__aligned(4);
+u8 hbm_ecc_table[MAX_INFO_DESC_DATA]__aligned(4);
+u8 row_rep_table[MAX_INFO_DESC_DATA]__aligned(4);
+
+void preboot_finalize_rma_tables(void)
+{
+	int ret;
+	u32 size = MAX_INFO_DESC_DATA;
+
+	ret = rma_info_get(RMA_HBM_ROW_REPLACEMENT_TABLE, row_rep_table, &size);
+	if (!ret)
+		boot_info_set(HL_BOOT_INFO_RMA_ROW_REP_TABLE, row_rep_table, size);
+
+	size = MAX_INFO_DESC_DATA;
+	ret = rma_info_get(RMA_HBM_ECC_TABLE, hbm_ecc_table, &size);
+	if (!ret)
+		boot_info_set(HL_BOOT_INFO_RMA_HBM_ECC_TABLE, hbm_ecc_table, size);
+
+	size = MAX_INFO_DESC_DATA;
+	ret = rma_info_get(RMA_HEADER_TABLE, hbm_hdr_table, &size);
+	if (!ret)
+		boot_info_set(HL_BOOT_INFO_RMA_HDR_TABLE, hbm_hdr_table, size);
+}
+
+int rma_table_read(enum rma_tables_type type, struct rma_table **table, size_t *data_len)
+{
+	int ret;
+	u32 size = MAX_INFO_DESC_DATA;
+
+	ret = rma_info_get(type, row_rep_table, &size);
+	if (ret)
+		return ret;
+
+	*table = (struct rma_table *)row_rep_table;
+	*data_len = size - RMA_TABLE_HEADER_SIZE;
+
+	return 0;
+}
+
+void rma_table_free(struct rma_table *table, size_t data_len)
+{
+	memset(table, 0, data_len + RMA_TABLE_HEADER_SIZE);
+}
