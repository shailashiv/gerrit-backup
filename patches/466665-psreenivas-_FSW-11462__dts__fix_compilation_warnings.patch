From f3d547bf728e221c7501c9a061c1b729a47c5bec Mon Sep 17 00:00:00 2001
From: Pavan S <psreenivas@habana.ai>
Date: Tue, 13 May 2025 11:14:54 +0300
Subject: [PATCH] [FSW-11462] dts: fix compilation warnings

This patch fixes compilation warnings related
to dtsi entries.

Signed-off-by: Pavan S <psreenivas@habana.ai>
Change-Id: I52495d868ef7710993e8bafa7a8dfbad99575c29
---

diff --git a/dts/arc/fs1.dtsi b/dts/arc/fs1.dtsi
index 4d90403..10f7d10 100644
--- a/dts/arc/fs1.dtsi
+++ b/dts/arc/fs1.dtsi
@@ -23,6 +23,7 @@
 		compatible = "snps,arcv2-intc";
 		interrupt-controller;
 		#interrupt-cells = <2>;
+		#address-cells = <0>;
 	};
 
 	timer0: timer0 {
@@ -41,6 +42,7 @@
 		compatible = "snps,archs-idu-intc";
 		interrupt-controller;
 		#interrupt-cells = <2>;
+		#address-cells = <0>;
 		interrupt-parent = <&intc>;
 	};
 
diff --git a/dts/arc/fs1_emb.dtsi b/dts/arc/fs1_emb.dtsi
index 0036b96..2c2ad88 100644
--- a/dts/arc/fs1_emb.dtsi
+++ b/dts/arc/fs1_emb.dtsi
@@ -326,7 +326,7 @@
 		node_label = "DMA_COMPUTE_PLL";
 	};
 
-	clk_hbm_compute: clk-hbm-compute@f8681000 {
+	clk_hbm_compute: clk-hbm-compute@f0449000 {
 		status = "disabled";
 		compatible = "hl,pll";
 		reg = <0xf0449000 0x1000>,
@@ -444,6 +444,18 @@
 		node_label = "INTEL_FS_HBM_2";
 	};
 
+	isolation: intel_fs_isolation {
+		status = "disabled";
+		compatible = "intel,fs_isolation";
+		node_label = "INTEL_FS_ISOLATION";
+	};
+
+	binning: intel_fs_binning {
+		status = "disabled";
+		compatible = "intel,fs_binning";
+		node_label = "INTEL_FS_BINNING";
+	};
+
 	soc {
 		#address-cells = <1>;
 		#size-cells = <1>;
@@ -508,22 +520,11 @@
 			interrupt-names = "aes", "glbl";
 		};
 
-		isolation: intel_fs_isolation {
-			status = "disabled";
-			compatible = "intel,fs_isolation";
-			node_label = "INTEL_FS_ISOLATION";
-		};
-
-		binning: intel_fs_binning {
-			status = "disabled";
-			compatible = "intel,fs_binning";
-			node_label = "INTEL_FS_BINNING";
-		};
-
 		m2w_io_d0: intel_fs_m2w_io_d0@f9cd2600 {
 			compatible = "intel,fs_m2w";
 			reg = <0xf9cd2600 0x30>;
 			#address-cells = <1>;
+			#size-cells = <1>;
 			w2m_int_cfg = <0xf9cd1000>;
 
 			/*
