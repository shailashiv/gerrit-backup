From 6856bedef9040c335f72c34e4b33b662326a0b4e Mon Sep 17 00:00:00 2001
From: Karthikeyan K <karthikk@habana.ai>
Date: Tue, 25 Jan 2022 05:56:20 +0200
Subject: [PATCH] [SW-69190] gaudi3: soc: update sram base macro

Fix sram base address macro name.

Change-Id: I5c7757464f39f77633a5783de0479ec9dc66ca23
---

diff --git a/arch/gaudi3/arc/soc.h b/arch/gaudi3/arc/soc.h
index 5c8c17e..0148a8a 100644
--- a/arch/gaudi3/arc/soc.h
+++ b/arch/gaudi3/arc/soc.h
@@ -51,8 +51,8 @@
 #define HL_CFG_BASE			REGION_BASE_ADDR(REGION_LBW_CFG_IDX)
 #define HL_CFG_SIZE			SZ_256MB   /* 256MB */
 
-#define HL_GLOB_SRAM_BASE		REGION_BASE_ADDR(REGION_SRAM_IDX)
-#define HL_GLOB_SRAM_SIZE		SZ_256MB   /* 256MB */
+#define HL_SRAM_BASE			REGION_BASE_ADDR(REGION_SRAM_IDX)
+#define HL_SRAM_SIZE			SZ_256MB   /* 256MB */
 
 #define HL_ICCM_BASE			REGION_BASE_ADDR(REGION_ICCM_IDX)
 #define HL_ICCM_SIZE			0x40000   /* 256KB */
