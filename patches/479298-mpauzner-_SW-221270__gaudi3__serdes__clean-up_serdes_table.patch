-#ifdef SERDES_TABLE_SUPPORT
-static void hl_serdes_init_link_config(void)
-{
-	int err;
-	uint8_t alert_status8;
-
-	if (!hl_is_card_type_pcie())
-		return;
-
-	err = cpld_get_register(CPLD_ALERT_STATUS8, &alert_status8);
-	if (err)
-		alert_status8 = HL338_BRIDGE_NOT_CONNECTED;
-	else
-		alert_status8 &= HL338_BRIDGE_PRESENT_MASK;
-
-	if (alert_status8 == HL338_BRIDGE_PRESENT) {
-		err = cpld_get_link_config_may_fail(&(cfg_pcie.link_config));
-		if (err)
-			cfg_pcie.link_config = HL338_BRIDGE_NOT_CONNECTED;
-		else
-			cfg_pcie.link_config &= HL338_BRIDGE_LINK_CONFIG_MASK;
-	} else
-		cfg_pcie.link_config = HL338_BRIDGE_NOT_CONNECTED;
-}
-#else /* SERDES_TABLE_SUPPORT */
 static int hl_serdes_pci_get_link_config(void)
 {
 	uint8_t link_config;
@@ -628,41 +287,7 @@
 
 	return link_config;
 }
-#endif /* SERDES_TABLE_SUPPORT */
 
-#ifdef SERDES_TABLE_SUPPORT
-static void hl_serdes_init_external_mask(void)
-{
-	const struct device *qsfp1_dev = QSFP1_DEV_INST;
-	const struct device *qsfp2_dev = QSFP2_DEV_INST;
-
-	if (!hl_is_card_type_pcie())
-		return;
-
-	cfg_pcie.link_ext_mask = 0;
-
-	if (!qsfp1_dev) {
-		LOG_ERR("QSFP1 device is missing\n");
-		return;
-	}
-	if (!qsfp2_dev) {
-		LOG_ERR("QSFP2 device is missing\n");
-		return;
-	}
-
-	/*
-	 * In case of Loopback (standalone)
-	 * all the ports are external and enabled.
-	 * QSFP conditioned by detection.
-	 */
-	cfg_pcie.link_ext_mask =
-		(cfg_pcie.link_config != HL338_BRIDGE_LPBK) ? 0 : HL338_MASK_SA_EXT_LPBK;
-	if (hl_sfp_dev_is_enabled(qsfp1_dev))
-		cfg_pcie.link_ext_mask |= QSFP1_ENABLE_MASK;
-	if (hl_sfp_dev_is_enabled(qsfp2_dev))
-		cfg_pcie.link_ext_mask |= QSFP2_ENABLE_MASK;
-}
-#else /* SERDES_TABLE_SUPPORT */
 static void hl_serdes_pci_init_external_mask(int link_config)
