-
-int hl_serdes_get_serdes_info_core_pcie(const struct device *dev, struct cpucp_nic_info *nic_info,
-	uint16_t serdes_type)
-{
-	int i;
-
-	/* serdes type */
-	nic_info->serdes_type = cfg_pcie.serdes_type;
-
-	/* port enable mask */
-	nic_info->link_mask[0] = cfg_pcie.link_mask;
-
-	/* external ports mask */
-	nic_info->link_ext_mask[0] = cfg_pcie.link_ext_mask;
-
-	/* serdes lane polarity inversion mask */
-	nic_info->pol_tx_mask[0] = cfg_pcie.pol_tx_mask;
-	nic_info->pol_rx_mask[0] = cfg_pcie.pol_rx_mask;
-
-	/* port auto-negotiation enable mask */
-	nic_info->auto_neg_mask[0] = cfg_pcie.auto_neg_mask;
-
-	/* serdes lane swapping map */
-	for (i = 0; i < SERDES_NUM_OF_PHYS; i++)
-		nic_info->tx_swap_map[i] = 0;
-
-	return 0;
-}
-
-int hl_serdes_get_serdes_table(struct hl_serdes_config **tbl, int *len)
-{
-	*tbl = serdes_table;
-	*len = ARRAY_SIZE(serdes_table);
-
-	return 0;
-}
-
-int hl_serdes_get_serdes_info(const struct device *dev, struct cpucp_nic_info *nic_info)
-{
-	return hl_serdes_get_serdes_info_core(dev, nic_info, serdes_type);
-}
-
-static void hl_serdes_init_serdes_type(void)
-{
-	if (hl_is_card_type_pcie())
-		serdes_type = HL338_SERDES_TYPE;
-	else
-		serdes_type = hl_serdes_get_serdes_type();
-
-	cfg_pcie.serdes_type = serdes_type;
-}
-
-uint32_t hl_serdes_get_link_mask(void)
-{
-	struct hl_serdes_config *serdes_table;
-	uint32_t tbl_len;
-	uint16_t serdes;
-	uint8_t module_id;
-
-	if (hl_is_card_type_pcie())
-		return cfg_pcie.link_mask;
-
-	module_id = get_module_id();
-	serdes = hl_serdes_get_serdes_type();
-	hl_serdes_get_serdes_table(&serdes_table, &tbl_len);
-
-	return serdes_table[serdes].enable_mask[module_id];
-}
-
-#if defined(TARGET_IS_PALAD)
-uint16_t hl_serdes_get_serdes_type(void)
-{
-	return GAUDI3_FULLOAM_3PORTS_SCALE_OUT;
-}
-#else
-uint16_t hl_serdes_get_serdes_type(void)
-{
-	uint8_t cpld_link_conf;
-	uint32_t serdes_type;
-	struct hl_serdes_config *table = NULL;
-	int serdes_tbl_len, ret;
-
-	if (dev_serdes_type != HL_SERDES_UNINITIALIZED_TYPE)
-		return dev_serdes_type;
-
-	cpld_link_conf = cpld_get_link_config();
-
-	ret = hl_serdes_get_serdes_table(&table, &serdes_tbl_len);
-	for (serdes_type = 0; serdes_type < serdes_tbl_len; serdes_type++) {
-		if (cpld_link_conf == table[serdes_type].link_id)
-			goto serdes_config;
-	}
-
-	serdes_type = HL_UNKNOWN_SERDES_TYPE;
-	LOG_ERR("Read an unknown serdes type from CPLD 0x%x", cpld_link_conf);
-
-serdes_config:
-	dev_serdes_type = serdes_type;
-
-	return dev_serdes_type;
-}
-#endif
-
-int hl_serdes_get_serdes_info_from_table(const struct device *dev, struct cpucp_nic_info *nic_info,
-	int serdes_type, uint8_t module_id)
-{
-	int ret;
-	unsigned int i, serdes_tbl_len;
-	uint64_t tx_mask, rx_mask;
-	struct hl_serdes_config *serdes_table = NULL;
-
-	hl_serdes_get_serdes_table(&serdes_table, &serdes_tbl_len);
-
-	nic_info->serdes_type = serdes_table[serdes_type].type;
-
-	/* port enable mask */
-	nic_info->link_mask[0] = serdes_table[serdes_type].enable_mask[module_id];
-
-	/* external ports mask */
-	nic_info->link_ext_mask[0] = serdes_table[serdes_type].external_mask[module_id];
-
-	/* serdes lane polarity inversion mask */
-	ret = hl_serdes_get_polarity_mask(&tx_mask, &rx_mask);
-	if (ret) {
-		LOG_ERR("Missing polarity mask");
-		return 1;
-	}
-
-	nic_info->pol_tx_mask[0] = tx_mask ^
-				serdes_table[serdes_type].tx_pol[module_id];
-	nic_info->pol_rx_mask[0] = rx_mask ^
-				serdes_table[serdes_type].rx_pol[module_id];
-
-	/* port autonegotiation enable mask */
-	nic_info->auto_neg_mask[0] = serdes_table[serdes_type].autoneg_mask[module_id];
-
-	/* serdes lane swapping map */
-	for (i = 0; i < SERDES_NUM_OF_PHYS; i++)
-		nic_info->tx_swap_map[i] = serdes_table[serdes_type].tx_lane_swap[i];
-
-	return 0;
-}
-
-int hl_serdes_get_serdes_info_core_mezz(const struct device *dev, struct cpucp_nic_info *nic_info,
-				   int serdes_type)
-{
-	int ret;
-	uint8_t module_id = get_module_id();
-
-	ret = hl_serdes_get_serdes_info_from_table(dev, nic_info, serdes_type, module_id);
-	if (ret)
-		return ret;
-
-	LOG_INF("serdes_type: %d", nic_info->serdes_type);
-	LOG_INF("nic_link_mask: 0x%llx", nic_info->link_mask[0]);
-	LOG_INF("nic_link_ext_mask:0x%llx", nic_info->link_ext_mask[0]);
-	LOG_INF("nic_pol_tx_mask:0x%llx", nic_info->pol_tx_mask[0]);
-	LOG_INF("nic_pol_rx_mask:0x%llx", nic_info->pol_rx_mask[0]);
-	LOG_INF("nic_auto_neg_mask:0x%llx", nic_info->auto_neg_mask[0]);
-
-	return 0;
-}
-
-int hl_serdes_get_serdes_info_core(const struct device *dev, struct cpucp_nic_info *nic_info,
-					uint16_t serdes_type)
-{
-	int ret;
-
-	if (hl_is_card_type_pcie())
-		ret = hl_serdes_get_serdes_info_core_pcie(dev, nic_info, serdes_type);
-	else
-		ret = hl_serdes_get_serdes_info_core_mezz(dev, nic_info, serdes_type);
-
-	if (!ret)
-		/* apply optional boot mask */
-		nic_info->link_mask[0] &= get_boot_nic_mask();
-
-	return ret;
-}
-
