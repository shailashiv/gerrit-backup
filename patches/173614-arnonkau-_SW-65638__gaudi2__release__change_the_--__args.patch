From dd2fdf35bed733fd6c8ce16e5d3fdd198c344221 Mon Sep 17 00:00:00 2001
From: Arnon Kaufman <akaufman@habana.ai>
Date: Sat, 29 Jan 2022 16:00:36 +0200
Subject: [PATCH] [SW-65638] gaudi2: release: change the --* args

Change the auto evaluate variable that holds the command line
related arguments. It uses the original variable name wit the addition
of a suffix.

Two variables are created. ${var}_args and ${var}_f.
The ${var}_f set to 1, when the parser handles it. The second arguments
holds the arguments supplied with the command.

Change-Id: I572074a53588dc3b2371ce313d77a3aecb6fd346
Signed-off-by: Arnon Kaufman <akaufman@habana.ai>
---

diff --git a/scripts/fwi/fw_installer.sh b/scripts/fwi/fw_installer.sh
index 317bb89..00fe0e6 100755
--- a/scripts/fwi/fw_installer.sh
+++ b/scripts/fwi/fw_installer.sh
@@ -429,20 +429,20 @@
 
 function create_config_file_op()
 {
+	[ ${create_cfg_f:-0} -eq 0 ] && return 0
+	[ ${#create_cfg_args[@]} -eq 0 ] && return 1
 
-	[ "${create_cfg}" == "" ] && return 0
-
-	[ -f ${create_cfg:-""} ] && {
+	[ -f ${create_cfg_args:-" "} ] && {
 		hlp_answer_yn "File exist. Is it ok to overrun it?"
 		[ $? -ne 0 ] && return 1
-		touch $create_cfg
+		touch $create_cfg_args
 		[ $? -ne 0 ] && {
 			perr "Can't create file $1, assuming permission issue"
 			return 1
 		}
 	}
 
-	dump_env 0 $create_cfg
+	dump_env 0 $create_cfg_args
 
 	exit 0
 }
@@ -1364,7 +1364,7 @@
 				exit 1
 			}
 			pinfo -l 3 CMD="$cmd ($manip_cmd)=${args[@]}"
-			eval "${manip_cmd}=(${args[@]})"
+			eval "${manip_cmd}_args=(${args[@]})"
 			eval ${manip_cmd}_f=1
 			auto_created_vars_list+=($cmd)
 			;;
@@ -1546,7 +1546,7 @@
 {
 	[[ ${config_link_f:-0} -ne 1 ]] && return 0
 
-	case ${config_link[0]:-"NONE"} in
+	case ${config_link_args[0]:-"NONE"} in
 	1|on|enb|enable)
 		config_set_link ${cfg_file}
 		;;
@@ -1568,7 +1568,7 @@
 {
 	[[ ${snapshot_f:-0} -ne 1 ]] && return 0
 
-	case ${snapshot[0]:-"NONE"} in
+	case ${snapshot_args[0]:-"NONE"} in
 	1|on|enb|enable|update)
 		[ -f ~/.hl_fwi.cfg.snapshot.sus ] && {
 			mv ~/.hl_fwi.cfg.snapshot{.sus,}
