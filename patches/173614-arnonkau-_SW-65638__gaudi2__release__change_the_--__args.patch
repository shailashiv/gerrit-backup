 function oam_i2c_scan_op()
 {
 	local ret err
+
+	[ ${i2c_scan_f:-0} -eq 0 ] && return 0
+	[ ${#i2c_scan_args[@]} -lt 1 ] && return 1
+
 	pinfo -l 3 "oam_i2c_scan_op"
 	[ "$i2c_scan" == "all" ] && {
 		run_per_all_devs oam_i2c_scan >& 3
 	} || {
 		# TODO: check range 0-7 [num of OAMs]
-		ret=($(oam_i2c_scan ${i2c_scan}))
+		ret=($(oam_i2c_scan ${i2c_scan_args[@]}))
 		pinfo "I2C Scan[${i2c_scan}]: ${ret[@]}"
 	}
 }
 
-function set_pci_sw()
+function set_pci_sw_op()
