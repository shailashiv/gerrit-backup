 function bmc_raw_op()
 {
 	local ret err
-	pinfo -l 2 "bmc_raw ${bmc_raw}"
-	ret=($(bmc_raw_cmd $(delimited_to_array ',' ${bmc_raw})))
+
+	[ ${bmc_raw_f:-0} -eq 0 ] && return 0
+	[ ${#bmc_raw_args[@]} -lt 1 ] && return 1
+	pinfo -l 2 "bmc_raw ${bmc_raw_args[@]}"
+	ret=($(bmc_raw_cmd $(delimited_to_array ',' ${bmc_raw_args[@]})))
 	err=$?
-	pinfo "Res: ${ret[@]}"
+	pinfo "Res[${#ret[@]}]: ${ret[@]}"
