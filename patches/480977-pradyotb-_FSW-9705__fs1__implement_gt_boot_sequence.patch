+static void send_tsc_sync(void)
+{
+	CFG_WREG32((mem_addr_t)(mmCOMPUTE_0_CFG_NOC_XBAR_S_XBAR_CFG_BASE +
+			mmXBAR_S_CFG_GT_TS_CFG), 0xE2);
+}
+
+static int gt_infra_domain_reset(struct mgmt_compute_config *config)
+{
+	int ret = 0;
+
+	/* Sending fuse data */
+	ret = wait_for_boot_state(config, FUSE_PULL_REQ_RECVD);
+	if (ret != GT_BOOT_SUCCESS) {
+		LOG_ERR("Timeout waiting for fuse completion");
+		return ret;
+	}
+
+	LOG_DBG("Fuse completion done");
+
+	/* Wait for IP Ready */
+	ret = wait_for_boot_state(config, IP_READY_RECVD);
+	if (ret != GT_BOOT_SUCCESS) {
+		LOG_ERR("Timeout waiting for IP ready");
+		return ret;
+	}
+
+	/* GT addresses are mapped to 0x8xxxx */
+	CFG_WREG32((mem_addr_t)(mmCOMPUTE_0_CFG_PSOC_ARC_MNG_ARC_BASE + mmARC_LBW_ADDR_REGION_10),
+		GT_BASE_CONFIG);
+	unlock_iosf_pmsb();
+
+	send_tsc_sync();
+
+	return ret;
+}
+
+static void configure_init_regs(struct mgmt_compute_config *config)
+{
+	configure_gt_misc_tmp_config();
+
+	configure_i2a_wrap_tmp_config();
+}
+
+static void do_gt_boot(struct mgmt_compute_config *config)
+{
+	int ret = 0;
+
+	LOG_INF("Starting GT_INIT....");
+
+	ret = gt_infra_domain_reset(config);
+	if (ret != GT_BOOT_SUCCESS) {
+		LOG_ERR("Not getting GT_BOOT_SUCCESS for infra reset, aborting boot");
+		return;
+	}
+
+	LOG_INF("gt_infra_domain_reset done");
+
+	ret = gt_c6_exit(config);
+	if (ret != GT_BOOT_SUCCESS) {
+		LOG_ERR("Not getting GT_BOOT_SUCCESS for c6 exit, aborting boot");
+		return;
+	}
+
+	LOG_INF("c6 exit done");
+
+	ret = gt_render_powerup(config);
+
+	if (ret != GT_BOOT_SUCCESS) {
+		LOG_ERR("Not getting GT_BOOT_SUCCESS for render powerup, aborting boot");
+		return;
+	}
+
+	LOG_INF("***GT BOOT IS DONE***");
+}
+
+static void gt_poll_thread(struct mgmt_compute_config *config, void *p2, void *p3)
+{
+	LOG_INF("Starting poll thread");
+
+	while (get_boot_state(config) != RENDER_IS_UP) {
+		LOG_INF("GT POLL...boot_state = %d (%s)", get_boot_state(config),
+			boot_state_to_string(get_boot_state(config)));
+		ipm_max_id_val_get(config->bridge_dev);
+		k_msleep(GT_POLL_INTERVAL_MS);
+	}
+	LOG_INF("Exiting poll thread...");
+}
+
+static int init_gt(void)
+{
+	struct mgmt_compute_config *config = mgmt_get_compute_cfg();
+
+	config->bridge_wq_data.res_ack_int = 0;
+	config->bridge_wq_data.c6_exit_done = 0;
+	config->bridge_wq_data.boot_state = STATE_INIT;
+
+	/*
+	 * TODO: This needs to happen in bootrom, before GT is brought out of reset
+	 * which happens in preboot
+	 */
+	configure_init_regs(config);
+
+	/* TODO: May have to modify mgmt SAI values */
+	CFG_WREG32((mem_addr_t)MGMT_SAI_REG, INITIATOR_SAI_REG_FORMAT(MGMT_SAI_VAL));
+	CFG_WREG32((mem_addr_t)MGMT_SAI_OVRD_REG, INITIATOR_SAI_REG_FORMAT(MGMT_SAI_VAL));
+
+	/* TODO: In jgs, there needs to be an interrupt mechanism */
+	gt_poll_thread_id = k_thread_create(&gt_thread_poll, gt_stack_poll, GT_STACKSIZE,
+		(k_thread_entry_t)gt_poll_thread, config, NULL, NULL,
+		0, K_INHERIT_PERMS, K_NO_WAIT);
+
+	k_thread_name_set(&gt_thread_poll, "GT-POLL-THREAD");
+
+	do_gt_boot(config);
+
+	return 0;
+}
 
 int mgmt_dev_prepare(void)
 {
 	struct mgmt_compute_config *config = mgmt_get_compute_cfg();
 
-	config->init_bridge = fs_init_bridge;
+	config->init_bridge = init_bridge;
+	config->init_gt = init_gt;
 	return 0;
 }
