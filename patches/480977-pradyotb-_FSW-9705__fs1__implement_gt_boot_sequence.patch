+
+static int get_boot_state(struct mgmt_compute_config *config)
+{
+	int boot_state;
+
+	if (k_mutex_lock(&config->bridge_wq_data.config_data_lock, K_MSEC(MUTEX_TIMEOUT_MS))) {
+		LOG_ERR("Failed to lock mutex for bridge_wq_data");
+		return -EBUSY;
+	}
+	boot_state = config->bridge_wq_data.boot_state;
+	k_mutex_unlock(&config->bridge_wq_data.config_data_lock);
+
+	return boot_state;
+}
+
+/* This should not be invoked from isr */
+static void i2a_bridge_process_ack(struct mgmt_compute_config *config)
+{
+	uint32_t interrupt_out = 0;
+	struct bridge_simple_msg msg;
+
+	/* decode header */
+	msg.hdr = *(uint64_t *)config->bridge_wq_data.ptr;
+	interrupt_out = (uint32_t)(msg.hdr & LSB_32BIT_MASK);
+
+	if (k_mutex_lock(&config->bridge_wq_data.config_data_lock, K_MSEC(MUTEX_TIMEOUT_MS))) {
+		LOG_ERR("Failed to lock mutex for bridge_wq_data");
+		ipm_clear(config->bridge_dev, 0);
+		return;
+	}
+	config->bridge_wq_data.boot_state++;
+	k_mutex_unlock(&config->bridge_wq_data.config_data_lock);
+
+	ipm_clear(config->bridge_dev, 0);
+}
