+static int gt_render_powerup(struct mgmt_compute_config *config)
+{
+	int ret = 0;
+
+	send_ramp_type();
+
+	target_gt1();
+
+	target_gt2();
+
+	render_go_block(config);
+
+	ret = wait_for_boot_state(config, RENDER_GO_BLOCK_ACK);
+	if (ret != GT_BOOT_SUCCESS) {
+		LOG_ERR("Timeout waiting for render go block ack");
+		return ret;
+	}
+
+	render_go_inc(config);
+
+	ret = wait_for_boot_state(config, RENDER_GO_INC_ACK);
+	if (ret != GT_BOOT_SUCCESS) {
+		LOG_ERR("Timeout waiting for render go inc ack");
+		return ret;
+	}
+
+	render_go_dec(config);
+	ret = wait_for_boot_state(config, RENDER_GO_DEC_ACK);
+	if (ret != GT_BOOT_SUCCESS) {
+		LOG_ERR("Timeout waiting for render go dec ack");
+		return ret;
+	}
+
+	render_go_resume(config);
+
+	ret = wait_for_boot_state(config, RENDER_IS_UP);
+	if (ret != GT_BOOT_SUCCESS) {
+		LOG_ERR("Timeout waiting for render is up");
+		return ret;
+	}
+
+	LOG_DBG("Render is up");
+	return ret;
+}
