+static int wait_for_boot_state(struct mgmt_compute_config *config, int target_state)
+{
+	int timeout = 0;
+
+	while (get_boot_state(config) != target_state) {
+		k_msleep(MSLEEP_TIME);
+		if (timeout++ > TIMEOUT_VAL)
+			return GT_BOOT_TIMEOUT;
+	}
+	return GT_BOOT_SUCCESS;
+}
