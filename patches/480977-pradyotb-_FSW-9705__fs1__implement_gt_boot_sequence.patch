+static int gt_c6_exit(struct mgmt_compute_config *config)
+{
+	int ret = 0;
+
+	write_to_sg_ctx_reg();
+
+	write_to_msgr_shadow();
+
+	enable_bisr_bypass();
+
+	write_to_workpoints();
+
+	ret = wait_for_boot_state(config, WAKE2_RECVD);
+	if (ret != GT_BOOT_SUCCESS) {
+		LOG_ERR("Timeout waiting for wake2 message");
+		return ret;
+	}
+
+	ret = wait_for_boot_state(config, DEC_GB_ELEC_DONE_2);
+	if (ret != GT_BOOT_SUCCESS) {
+		LOG_ERR("Timeout waiting for dec_gb_elec_done");
+		return ret;
+	}
+
+	send_go_res_intf(config);
+
+	ret = wait_for_boot_state(config, RES_ACK_RECVD);
+	if (ret != GT_BOOT_SUCCESS) {
+		LOG_ERR("Timeout waiting for res_ack");
+		return ret;
+	}
+
+	ret = wait_for_boot_state(config, C6_EXIT_DONE);
+	if (ret != GT_BOOT_SUCCESS) {
+		LOG_ERR("Timeout waiting for c6_fsm_idle");
+		return ret;
+	}
+
+	LOG_DBG("C6 exit done");
+	return ret;
+}
