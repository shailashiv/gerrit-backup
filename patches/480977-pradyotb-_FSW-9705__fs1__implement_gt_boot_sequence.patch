 static void i2a_bridge_process_fuse_pull(struct mgmt_compute_config *config)
 {
-	/* TODO: fuse read and delivery */
+	uint32_t mbx_data[IPM_DATA_SZ] = {0};
+	int flitnum;
+	int i;
 
-	/* clear interrupt */
-	ipm_clear(config->bridge_wq_data.dev, 0);
+	ipm_clear(config->bridge_dev, 0);
+
+	/* Send fuse data sets one by one */
+	for (i = 0; i < NUM_FUSE_DATA_SETS; i++) {
+		flitnum = (i == IPM_DATA_SZ) ? FINAL_FLIT_NUM : 0;
+		populate_mbx_data(mbx_data, sizeof(mbx_data), flitnum, i);
+		ipm_send(config->bridge_dev, 1, 0, mbx_data, sizeof(mbx_data));
+		memset(mbx_data, 0, sizeof(mbx_data));
+	}
+
+	if (k_mutex_lock(&config->bridge_wq_data.config_data_lock, K_MSEC(MUTEX_TIMEOUT_MS))) {
+		LOG_ERR("Failed to lock mutex for bridge_wq_data");
+		return;
+	}
+	config->bridge_wq_data.boot_state = FUSE_PULL_REQ_RECVD;
+	k_mutex_unlock(&config->bridge_wq_data.config_data_lock);
 }
 
