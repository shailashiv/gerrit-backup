+const char *boot_state_to_string(int state)
+{
+	switch (state) {
+	case STATE_INIT:
+		return "STATE_INIT";
+	case FUSE_PULL_REQ_RECVD:
+		return "FUSE_PULL_REQ_RECVD";
+	case IP_READY_RECVD:
+		return "IP_READY_RECVD";
+	case WAKE2_RECVD:
+		return "WAKE2_RECVD";
+	case DEC_GB_ELEC_DONE_1:
+		return "DEC_GB_ELEC_DONE_1";
+	case DEC_GB_ELEC_DONE_2:
+		return "DEC_GB_ELEC_DONE_2";
+	case RES_ACK_RECVD:
+		return "RES_ACK_RECVD";
+	case C6_EXIT_DONE:
+		return "C6_EXIT_DONE";
+	case RENDER_GO_BLOCK_ACK:
+		return "RENDER_GO_BLOCK_ACK";
+	case RENDER_GO_INC_ACK:
+		return "RENDER_GO_INC_ACK";
+	case RENDER_GO_DEC_ACK:
+		return "RENDER_GO_DEC_ACK";
+	case RENDER_IS_UP:
+		return "RENDER_IS_UP";
+	default:
+		return "UNKNOWN_BOOT_STATE";
+	}
