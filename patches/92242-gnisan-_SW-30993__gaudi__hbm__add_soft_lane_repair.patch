+static int hbm_channel_dc_test_repair(int device, int ch)
+{
+	struct ch_lane_repair_info *hlr = &hlr_info[device][ch];
+	struct dev_fail_info *dev_fail = &dev_fail_info[device];
+	u32 extest_fails[EXTEST_WDR_REG_NUM];
+	int i, r, bit, byte, pc, extest_idx, dq, col, row;
+
+	/* Gather extest fails */
+	for (r = 0; r < EXTEST_WDR_REG_NUM; r++)
+		extest_fails[r] = hlr->extest_rx_fails[r] |
+			hlr->extest_tx_fails[r];
+
+	for (pc = 0; pc < PC_PER_CH; pc++) {
+		for (byte = 0; byte < BYTES_PER_PC; byte++) {
+			/* DM (ECC) */
+			extest_idx = pc * EXTEST_PC_SIZE + byte * EXTEST_BYTE_SIZE + 0;
+			r = extest_idx / 32;
+			i = extest_idx % 32;
+			if (!!(extest_fails[r] & BIT(i)))
+				hlr->failed_dm[pc] |= BIT(byte);
+
+			/* DBI (bit inversion) */
+			extest_idx = pc * EXTEST_PC_SIZE + byte * EXTEST_BYTE_SIZE + 11;
+			r = extest_idx / 32;
+			i = extest_idx % 32;
+			if (!!(extest_fails[r] & BIT(i)))
