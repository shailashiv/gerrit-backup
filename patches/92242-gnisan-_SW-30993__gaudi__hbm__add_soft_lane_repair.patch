+static void lane_update_hbm(int device, int mc_ch)
+{
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+	struct ch_lane_repair_info *hlr = &hlr_info[device][mc_ch];
+
+	/* Check if we need to update HBM */
+	if (!hlr->is_repair_code_valid ||
+	    (hlr->dw01_code == 0xFFFFFFFF && hlr->dw23_code == 0xFFFFFFFF &&
+	     hlr->aw_code == 0xFF))
+		return;
+
+	/* HBM device configuration */
+	WREG32(base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) + 0x100,
+	       hlr->dw01_code);
+	WREG32(base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) + 0x104,
+	       (hlr->dw23_code << 8) | (hlr->aw_code & 0xff));
+	WREG32(base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) + 0x108,
+	       hlr->dw23_code >> 24);
+
+	ieee1500_inst(device, hbm_ch_mapping[mc_ch], ieee1500_soft_lane_repair,
+		      EXTEST_WRITE_INST);
+}
+
+static void hlr_reset_failures(struct ch_lane_repair_info *hlr,
+			       bool is_reset_count)
+{
+	memset(hlr->extest_rx_fails, 0, sizeof(hlr->extest_rx_fails));
+	memset(hlr->extest_tx_fails, 0, sizeof(hlr->extest_tx_fails));
+	memset(hlr->failed_dq, 0, sizeof(hlr->failed_dq));
+	memset(hlr->failed_dm, 0, sizeof(hlr->failed_dm));
+	memset(hlr->failed_dbi, 0, sizeof(hlr->failed_dbi));
+	hlr->failed_r = 0;
+	hlr->failed_c = 0;
+
+	if (is_reset_count)
+		memset(hlr->fails_in_byte, 0, sizeof(hlr->fails_in_byte));
+}
+
+static void hbm_reset_failures(void)
+{
+	int device, ch;
+
+	for (device = 0; device < GAUDI_HBM_DEVICES; device++)
+		for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
+			hlr_reset_failures(&hlr_info[device][ch], true);
+}
+
+/*
+ * Return 0 if HBM was repaired or does not need repair.
+ */
+static int hbm_channel_lane_repair(int device, int ch)
+{
+	struct hbm *hbm = &hbm_data;
+	struct ch_lane_repair_info *hlr = &hlr_info[device][ch];
+	struct dev_fail_info *dev_fail = &dev_fail_info[device];
+	int fails_in_cbus = 0, fails_in_rbus = 0;
+	u8 repair_code[PC_PER_CH][8], repair_code_c, repair_code_r;
+	u32 *dw_code;
+	int pc, byte, bit;
+
+	if (dev_fail->unrep_dw)  /* Failures in unrepairable pins */
+		return 1;
+
+	/* Create repair vector */
+	for (pc = 0; pc < PC_PER_CH; pc++) {
+		dw_code = pc ? &hlr->dw23_code : &hlr->dw01_code;
+
+		/* Convert dw codes nibbles to repair_code array */
+		for (byte = 0; byte < BYTES_PER_PC; byte++)
+			repair_code[pc][byte] = (*dw_code >> (4 * byte)) & 0xf;
+
+		for (byte = 0; byte < BYTES_PER_PC; byte++) {
+			/* repair_code should contains the repair codes that we
+			 * introduce during ATE (hard repair)
+			 */
+			if (repair_code[pc][byte] < REPAIR_CODE_ADJ)
+				hlr->fails_in_byte[pc][byte] = 1;
+			else
+				hlr->fails_in_byte[pc][byte] = 0;
+
+			/* Check result of current byte */
+			for (bit = 0; bit < BITS_PER_BYTE; bit++) {
+				if (!!(hlr->failed_dq[pc] &
+				       BIT(byte * 8 + bit))) {
+					hlr->fails_in_byte[pc][byte]++;
+					repair_code[pc][byte] = bit + REPAIR_CODE_DQ0;
+				}
+			}
+
+			/* In case that DBI (data bit inversion) is enabled and
+			 * we got more than 8 flipped bits, than probably dbi
+			 * lane is failing
+			 */
+			if (hbm->dbi_enable &&
+			    hlr->fails_in_byte[pc][byte] >= 8 &&
+			    !(hlr->failed_dm[pc] & BIT(byte))) {
+				/* DBI fault - detect for AC test */
+				hlr->failed_dbi[pc] |= BIT(byte);
+				hlr->fails_in_byte[pc][byte] -= 8;
+			}
+
+			/* ECC */
+			if (!!(hlr->failed_dm[pc] & BIT(byte))) {
+				hlr->fails_in_byte[pc][byte]++;
+				repair_code[pc][byte] = REPAIR_CODE_DM;
+			}
+
+			/* Data bit inversion */
+			if (!!(hlr->failed_dbi[pc] & BIT(byte))) {
+				hlr->fails_in_byte[pc][byte]++;
+				repair_code[pc][byte] = REPAIR_CODE_DBI;
+			}
+
+			/* more than one lane per byte, cannot repair */
+			if (hlr->fails_in_byte[pc][byte] > REDUNDENT_BYTE_PAIR_LANES)
+				return 1;
+		}
+
+		/* Check result of byte pair */
+		for (byte = 0; byte < BYTES_PER_PC; byte += 2) {
+			/* more than one lane per byte pair */
+			if (hlr->fails_in_byte[pc][byte] +
+			    hlr->fails_in_byte[pc][byte + 1] > REDUNDENT_BYTE_PAIR_LANES)
+				return 1;
+
+			/* mark repair in adjacent byte */
+			if (hlr->fails_in_byte[pc][byte])
+				repair_code[pc][byte + 1] = REPAIR_CODE_ADJ;
+
+			if (hlr->fails_in_byte[pc][byte + 1])
+				repair_code[pc][byte] = REPAIR_CODE_ADJ;
+		}
+	}
+
+	/* AWORD: Check whether repairable and create repair vector */
+	if (dev_fail->unrep_aw)  /* Failures in unrepairable pins */
+		return 1;
+
+	repair_code_c = hlr->aw_code & 0xf;
+	repair_code_r = (hlr->aw_code >> 4) & 0xf;
+
+	/* Check if we already fixed this bus */
+	if (repair_code_c < REPAIR_CODE_NONE)
+		fails_in_cbus = 1;
+
+	/* Check result of current C bus */
+	for (bit = 0; bit < CBUS_LANES_NUM; bit++) {
+		if (!(hlr->failed_c & BIT(bit)))
+			continue;
+
+		fails_in_cbus++;
+		repair_code_c = bit;
+	}
+
+	if (fails_in_cbus > REDUNDENT_CBUS_LANES)
+		return 1;
+
+	/* Check if we already fixed this bus */
+	if (repair_code_r < REPAIR_CODE_NONE)
+		fails_in_rbus = 1;
+
+	/* Check result of current R bus */
+	for (bit = 0; bit < RBUS_LANES_NUM; bit++) {
+		if (!(hlr->failed_r & BIT(bit)))
+			continue;
+
+		fails_in_rbus++;
+		repair_code_r = bit;
+	}
+
+	if (fails_in_rbus > REDUNDENT_RBUS_LANES)
+		return 1;
+
+	/* Convert back the repair code arrays */
+	for (pc = 0; pc < PC_PER_CH; pc++) {
+		dw_code = pc ? &hlr->dw23_code : &hlr->dw01_code;
+
+		*dw_code = 0;
+		for (byte = 0; byte < BYTES_PER_PC; byte++)
+			*dw_code |= repair_code[pc][byte] << (byte * 4);
+	}
+
+	hlr->aw_code = repair_code_c | (repair_code_r << 4);
+
+	lane_update_hbm(device, ch);
+	lane_update_phy(device, ch);
+
+	/* Since soft repair is an iterative process, reset handled failures to
+	 * prevent redudant repair attempts.
+	 */
+	hlr_reset_failures(hlr, false);
+
+	return 0;
+}
+
+#define DM_MISMATCH_REG		0x12c
+#define DM_EXPECTED_REG		0x128
+#define DM_BIT_GROUP_SIZE	4
+#define DM_BIT_GROUP_COUNT	2
+
+const static int dm_bit[DM_BIT_GROUP_COUNT][DM_BIT_GROUP_SIZE] = {
+	{ 0, 4, 16, 20 },
+	{ 8, 12, 24, 28 }
+};
+
+static u8 calc_dm_bit(u32 flipped, int dm_idx)
+{
+	int bit, nibble;
+	u8 res = 0;
+
+	for (bit = 0; bit < DM_BIT_GROUP_SIZE; bit++)
+		for (nibble = 0; nibble < DM_BIT_GROUP_COUNT; nibble++)
+			if (!!(flipped & BIT(dm_bit[nibble][bit] + dm_idx)))
+				res |= BIT(dm_idx + nibble * BITS_PER_NIBBLE);
+
+	return res;
+}
+
+struct failed_dq_reg {
+	u32 mismatch_reg;
+	u32 expected_reg;
+	int shift_res;
+};
+
+const static struct failed_dq_reg failed_dq_reg[] = {
+	{ 0x16c, 0x14c, 0 },  /*   0 ..  31 */
+	{ 0x168, 0x148, 0 },  /*  32 ..  63 */
+	{ 0x15c, 0x13c, 0 },  /* 128 .. 159 */
+	{ 0x158, 0x138, 0 },  /* 160 .. 191 */
+	{ 0x164, 0x144, 32 }, /*  64 ..  95 */
+	{ 0x160, 0x140, 32 }, /*  96 .. 128 */
+	{ 0x154, 0x134, 32 }, /* 192 .. 223 */
+	{ 0x150, 0x130, 32 }, /* 224 .. 255 */
+};
+
+static int hbm_channel_ac_test_repair(int device, int ch)
+{
+	struct ch_lane_repair_info *hlr = &hlr_info[device][ch];
+	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
+	u32 status = RREG32(base + ch * 0x1000 + 0x11C);
+	u32 mismatch, expected, flipped;
+	int pc, i;
+
+	for (pc = 0; pc < PC_PER_CH; pc++) {
+		if (!!(status & BIT(24 + pc))) /* No failures */
+			continue;
+
+		/* Select pseudo channel */
+		RMWREG32(base + ch * 0x1000 + 0x100, pc, BIT(5));
+
+		/* Gather mismatched bits */
+		for (i = 0; i < ARRAY_SIZE(failed_dq_reg); i++) {
+			mismatch = RREG32(base + ch * 0x1000 +
+					  failed_dq_reg[i].mismatch_reg);
+			expected = RREG32(base + ch * 0x1000 +
+					  failed_dq_reg[i].expected_reg);
+			flipped = mismatch ^ expected;
+			hlr->failed_dq[pc] |= ((u64)flipped) <<
+				failed_dq_reg[i].shift_res;
+		}
+
+		mismatch = RREG32(base + ch * 0x1000 + DM_MISMATCH_REG);
+		expected = RREG32(base + ch * 0x1000 + DM_EXPECTED_REG);
+		flipped = mismatch ^ expected;
+		for (i = 0; i < BITS_PER_NIBBLE; i++)
+			hlr->failed_dm[pc] |= calc_dm_bit(flipped, i);
+	}
+
+	return hbm_channel_lane_repair(device, ch);
+}
+
+static int mcbist_poll_completion(int sid, int dev, bool is_repair)
 {
 	int err, ch, rc = 0;
 	u32 base, status;
@@ -940,13 +1315,20 @@
