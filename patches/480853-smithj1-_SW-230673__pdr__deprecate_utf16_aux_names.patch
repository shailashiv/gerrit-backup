 	uint8_t min_value;
 	uint8_t max_value;
-#if CONFIG_LIBPLDM_PDR_ASCII_AUX_NAMES
 	const char *name;
-#else
-	uint8_t name_string_count; /* limited to at most 1 */
-	/* simplification => only permit at most 1 string */
-	const char *name_language_tag; /* ISO646 (ASCII) */
