-			utf_name = utf_name.split()[1:] + ['0000']   # split by spaces, drop the 'byte order mark', add NULL
-			utf_name = map(lambda x: "0x" + x, utf_name) # Prefix with '0x'
-			u16_chars = list(utf_name)
-
-			variable = variable_from_name(name)
-			if variable in OLD_USED_NAMES:
-				output.write(f"/* already defined: {variable} */\n")
-			else:
-				OLD_USED_NAMES.add(variable)
-				formatted = ',\n'.join(['\t' + ', '.join(chunk) for chunk in gen_chunks(u16_chars)])
-				output.write(f'''\
-const uint16_t {variable}[] OFFLOAD_AUX_NAMES_ATTR = {{
-{formatted}
-}};
-''')
-	output.write("\n#endif /* CONFIG_LIBPLDM_PDR_ASCII_AUX_NAMES */\n\n")
 
