 def command_pdrs(args):
diff --git a/src/encode.c b/src/encode.c
index 87ad315..86d1783 100644
--- a/src/encode.c
+++ b/src/encode.c
@@ -126,8 +126,6 @@
 	return encode_buffer_append_ascii_str(buffer, str, max_count);
 }
 
-#if CONFIG_LIBPLDM_PDR_ASCII_AUX_NAMES
-
 static bool generate_utf_string(
 	struct encode_buffer *buffer,
 	const char *value,
@@ -227,185 +225,6 @@
 
 	return true;
 }
-
-#else /* ! CONFIG_LIBPLDM_PDR_ASCII_AUX_NAMES */
-
-/* Append UTF16 string to the buffer, including the null character (0x0000).
- * 'max_count' is the array size (not byte size) indicating max possible length
- * of the string.  It is used to verify 'str' is null terminated.
- */
-static bool encode_buffer_append_utf16_str(
-	struct encode_buffer *buffer,
-	const uint16_t *str,
-	size_t max_count)
-{
-	size_t count = 0;
-
-	/* count number of non-null characters */
-	while (count < max_count && str[count])
-		++count;
-
-	if (count >= max_count) {
-		LOG_ERR("%s: string too long: len=%u max=%u",
-			__func__, count, max_count);
-		return false;
-	}
-
-	count += 1; /* include the null byte */
-	return encode_buffer_append(buffer, str, count * sizeof(str[0]));
-}
-
-/* Append a language tag and unicode string. */
-static bool encode_unicode_str(
-	struct encode_buffer *buffer,
-	const char *lang_tag,
-	const uint16_t *str,
-	const char *suffix)
-{
-	if (!encode_buffer_append_ascii_str(buffer, lang_tag, PLDM_PDR_LANGUAGE_TAG_LEN + 1))
-		return false;
-
-	if (!encode_buffer_append_utf16_str(buffer, str, PLDM_PDR_SENSOR_NAME_LEN + 1))
-		return false;
-
-	if (suffix) {
-		/* Concatenate the suffix by first erasing existing NULL */
-		if (buffer->consumed >= sizeof(uint16_t))
-			buffer->consumed -= sizeof(uint16_t);
-
-		/* Convert the suffix string to UTF16 and append to current buffer */
-		for (size_t i = 0; suffix[i]; ++i) {
-			if (!encode_buffer_append_uint16(buffer, ((uint16_t)suffix[i]) << 8))
-				return false;
-		}
-
-		/* Must be null terminated */
-		if (!encode_buffer_append_uint16(buffer, 0x0000))
-			return false;
-	}
-
-	return true;
-}
-
-/* Append a list of language tags and unicode strings.  */
-static bool encode_unicode_strings(
-	struct encode_buffer *buffer,
-	const char * const *lang_tags,
-	const uint16_t * const *strings,
-	uint8_t count,
-	const char *suffix)
-{
-	/* Current implementation only supports one string per element.
-	 * To support multiple strings, element definition would need
-	 * to include an array of pointers to strings for language
-	 * and name.
-	 */
-	if (count != 1) {
-		LOG_ERR("%s: invalid string count: %u", __func__, count);
-		return false;
-	}
-
-	/* always need to write count (even if 0) */
-	if (!encode_buffer_append_uint8(buffer, count))
-		return false;
-
-	for (size_t i = 0; i < count; i++) {
-		if (!encode_unicode_str(buffer, lang_tags[i], strings[i], suffix))
-			return false;
-	}
-
-	return true;
-}
-
-static bool encode_utf_strings(
-	struct encode_buffer *buffer,
-	const struct pldm_pdr_utf_strings *string,
-	const char *suffix)
-{
-	if (!encode_unicode_strings(buffer, &string->name_language_tag, &string->name,
-	    string->name_string_count, suffix))
-		return false;
-
-	return true;
-}
-
-static bool encode_utf_strings_array(
-	struct encode_buffer *buffer,
-	const struct pldm_pdr_utf_strings *strings,
-	uint8_t num_strings,
-	const char *suffix)
-{
-	for (uint8_t i = 0; i < num_strings; ++i) {
-		if (!encode_utf_strings(buffer, &strings[i], suffix))
-			return false;
-	}
-
-	return true;
-}
-
-static bool encode_entity_aux_names(
-	struct encode_buffer *buffer,
-	const struct pldm_pdr_entity_aux_names_simple *pdr)
-{
-	size_t offset = offsetof(struct pldm_pdr_entity_aux_names_simple, name);
-
-	/* encode const-sized data, followed by variable-sized data */
-	return encode_buffer_append(buffer, pdr, offset) &&
-		encode_utf_strings(buffer, &pdr->name, NULL);
-}
-
-static bool encode_oem_unit(
-	struct encode_buffer *buffer,
-	const struct pldm_pdr_oem_unit *pdr)
-{
-	size_t offset = offsetof(struct pldm_pdr_oem_unit, name);
-
-	/* encode const-sized data, followed by variable-sized data */
-	return encode_buffer_append(buffer, pdr, offset) &&
-		encode_utf_strings(buffer, &pdr->name, NULL);
-}
-
-static bool encode_oem_state_set_records(
-	struct encode_buffer *buffer,
-	const struct pldm_pdr_oem_state_set_simple_element *elements,
-	uint8_t num_states)
-{
-	for (uint8_t i = 0; i < num_states; ++i) {
-		const struct pldm_pdr_oem_state_set_simple_element *element = elements + i;
-
-		/* This implementation uses "simple" oem state set elements, where:
-		 *  - For each value, the number of tag+name pairs is limited to at most 1.
-		 *  - All values with names are grouped contiguously, starting at index 0.
-		 *
-		 * Hence, any count other than 1 indicates a bug in the static PDR definition.
-		 */
-		if (element->name_string_count != 1) {
-			LOG_ERR("%s: invalid oem state set value count: %u",
-				__func__, element->name_string_count);
-			return false;
-		}
-
-		if (element->min_value > element->max_value) {
-			LOG_ERR("%s: invalid oem state set min/max value: %u, %u",
-				__func__, element->min_value, element->max_value);
-			return false;
-		}
-
-		if (!encode_buffer_append_uint8(buffer, element->min_value))
-			return false;
-
-		if (!encode_buffer_append_uint8(buffer, element->max_value))
-			return false;
-
-		if (!encode_unicode_strings(buffer, &element->name_language_tag, &element->name,
-			element->name_string_count, NULL))
-			return false;
-	}
-
-	return true;
-}
-
-#endif /* CONFIG_LIBPLDM_PDR_ASCII_AUX_NAMES */
 
 static bool encode_aux_names(
 	struct encode_buffer *buffer,
