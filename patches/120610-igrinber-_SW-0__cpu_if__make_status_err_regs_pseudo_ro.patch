index 8e5e2a5..f3eb75a 100644
--- a/common/cmd_module.c
+++ b/common/cmd_module.c
@@ -6,6 +6,7 @@
  */
 
 #include <preboot.h>
+#include <boot_if.h>
 
 #include "uart.h"
 #include "cmd_module.h"
@@ -21,6 +22,8 @@
 	preboot_puts("Waiting for commands...\n");
 	i = 0;
 	while (1) {
+		cpu_boot_if_fix_ro_regs();
+
 		res = cmd_ops[i].check();
 		switch (res) {
 		case NOT_FOUND:
diff --git a/include/boot_if.h b/include/boot_if.h
index c709295..5b973ad 100644
--- a/include/boot_if.h
+++ b/include/boot_if.h
@@ -10,6 +10,7 @@
 #include <hl_boot_if.h>
 #include <preboot.h>
 
+void cpu_boot_if_init(void);
 u32 cpu_boot_cmd_get(void);
 void cpu_boot_cmd_clr_before_wfe(void);
 void cpu_boot_sts_set(u32 val);
@@ -17,6 +18,7 @@
 void cpu_boot_dev_sts_clrset(u32 mask, bool set);
 void cpu_boot_rsp_set(enum cpu_msg_status sts);
 u64 cpu_boot_dev_sts_get_all(void);
+void cpu_boot_if_fix_ro_regs(void);
 
 /* COMMS APIs */
 void cpu_comms_sts_set(struct comms_status *sts);
diff --git a/ppboot/ppboot.c b/ppboot/ppboot.c
index 90c7746..e63e9a9 100644
--- a/ppboot/ppboot.c
+++ b/ppboot/ppboot.c
@@ -240,6 +240,8 @@
 	u64 loadaddr;
 	bool ret;
 
+	/* Initialize internal if variables */
+	cpu_boot_if_init();
 	hl_plat_early_init();
 	hl_init_pcie_phy_fw();
