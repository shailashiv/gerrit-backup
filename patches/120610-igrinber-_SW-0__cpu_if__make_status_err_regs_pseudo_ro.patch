diff --git a/preboot/preboot.c b/preboot/preboot.c
index 6730cbe..7d82e4f 100644
--- a/preboot/preboot.c
+++ b/preboot/preboot.c
@@ -376,6 +376,8 @@
 	u64 ver_off = (uintptr_t)preboot_vers;
 	bool is_sec_en;
 
+	/* Initialize internal if variables */
