From 01596ed75b30cfc4e19ce22ff4f37153b62922d4 Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Fri, 13 Aug 2021 14:32:08 +0300
Subject: [PATCH] [SW-0] cpu_if: make status/err regs pseudo ro

Since the status and error registers are not protected from host attacks
and LKD relies on the them, we need to make them read-only.
Unfortunately, we do not have a h/w mechanism available to protect these
registers.
Instead, implement a pseudo read-only mechanism which will write these
registers each main loop iteration.

Change-Id: I046893266c0aad75f4fa145d7dbd32838c352fe8
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/common/boot_if.c b/common/boot_if.c
index 00134d0..619c647 100644
--- a/common/boot_if.c
+++ b/common/boot_if.c
@@ -12,6 +12,11 @@
 #include <preboot.h>
 #include <hl_boot_if.h>			/* requires stdint.h */
 
+/* Shadow the status and error registers */
+static u32 cpu_boot_dev_sts;
+static u32 cpu_boot_err;
+static u32 cpu_boot_progress;
+
 /*
  * The cpu_boot_cmd_clr_before_wfe() function should NOT be used in general as
  * the LKD message register should be written by LKD solely.
@@ -34,17 +39,43 @@
 
 void cpu_boot_sts_set(u32 val)
 {
+	cpu_boot_progress = val;
 	regmap_writel(val, mmPSOC_GLOBAL_CONF_CPU_BOOT_STATUS);
+}
+
+void cpu_boot_if_init(void)
+{
+	cpu_boot_dev_sts = regmap_readl(mmCPU_BOOT_DEV_STS0);
+	cpu_boot_err = regmap_readl(mmCPU_BOOT_ERR0);
+}
+
+void cpu_boot_if_fix_ro_regs(void)
+{
+	regmap_writel(cpu_boot_dev_sts, mmCPU_BOOT_DEV_STS0);
+	regmap_writel(cpu_boot_err, mmCPU_BOOT_ERR0);
+	regmap_writel(cpu_boot_progress, mmPSOC_GLOBAL_CONF_CPU_BOOT_STATUS);
 }
 
 static void cpu_boot_reg_clrset(u32 reg, u32 mask, bool set)
 {
-	u32 val = regmap_readl(reg) & ~mask;
+	u32 *shadow;
 
+	switch (reg) {
+	case mmCPU_BOOT_DEV_STS0:
+		shadow = &cpu_boot_dev_sts;
+		break;
+	case mmCPU_BOOT_ERR0:
+		shadow = &cpu_boot_err;
+		break;
+	default:
+		return;
+	}
+
+	*shadow &= ~mask;
 	if (set)
-		val |= mask;
+		*shadow |= mask;
 
-	regmap_writel(val, reg);
+	regmap_writel(*shadow, reg);
 }
 
 /* We support only ERR0 for now */
@@ -71,9 +102,5 @@
 
 u64 cpu_boot_dev_sts_get_all(void)
 {
-	u64 ret;
-
-	ret = ((u64)regmap_readl(mmCPU_BOOT_DEV_STS1) << 32);
-	ret |= (u64)regmap_readl(mmCPU_BOOT_DEV_STS0);
-	return ret;
+	return cpu_boot_dev_sts;
 }
