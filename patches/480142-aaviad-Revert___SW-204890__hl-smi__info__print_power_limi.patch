From f8f8d1f4ece41f27bca864b6a80f7407200c1459 Mon Sep 17 00:00:00 2001
From: Ariel Aviad <aaviad@habana.ai>
Date: Tue, 20 May 2025 13:43:34 +0000
Subject: [PATCH] Revert "[SW-204890] hl-smi: info: print power limit constraints"

This reverts commit d25aca44fcc377b7d370603197d87c2faab4df26.

Change-Id: I65802b63c1749922162424b1bc7c49df7e5f5577
---

diff --git a/app/hl-smi/info.cpp b/app/hl-smi/info.cpp
index a6206d8..2db4901 100644
--- a/app/hl-smi/info.cpp
+++ b/app/hl-smi/info.cpp
@@ -559,6 +559,7 @@
 static void hl_smi_aip_log_power(struct hl_smi_aip_info *aip)
 {
 	hlml_return_t ret;
+	char info_field[VERSION_MAX_LEN] = {0};
 	char const *pm_mng_mode_state[] = {
 		[HLML_FEATURE_DISABLED] = "N/A",
 		[HLML_FEATURE_ENABLED] = "Supported",
@@ -586,18 +587,12 @@
 		HL_SMI_LOG_INFO("\t\tPower Max\t\t: {} W",
 			(unsigned int)MW_TO_WATT(aip->psu_main_info.psu_main_power_limit));
 
-	ret = hlml_device_get_power_management_limit_constraints(aip,
-							&aip->psu_main_info.psu_main_power_min,
-							&aip->psu_main_info.psu_main_power_max);
-	if (ret != HLML_SUCCESS) {
-		HL_SMI_LOG_INFO("\t\tPower Limit Min\t\t: {}", HL_NA_STR);
-		HL_SMI_LOG_INFO("\t\tPower Limit Max\t\t: {}", HL_NA_STR);
-	} else {
-		HL_SMI_LOG_INFO("\t\tPower Limit Min\t\t: {} W",
-			(unsigned int)MW_TO_WATT(aip->psu_main_info.psu_main_power_min));
-		HL_SMI_LOG_INFO("\t\tPower Limit Max\t\t: {} W",
-			(unsigned int)MW_TO_WATT(aip->psu_main_info.psu_main_power_max));
-	}
+	if (aip->power_limit[0])
+		snprintf(info_field, VERSION_MAX_LEN, "%s W", aip->power_limit);
+	else
+		snprintf(info_field, VERSION_MAX_LEN, "%s", HL_NA_STR);
+
+	HL_SMI_LOG_INFO("\t\tPower Limit\t\t: {}", info_field);
 
 	if (aip->psu_sec_info) {
 		HL_SMI_LOG_INFO("\tPower Readings {}", aip->psu_sec_info->psu_sec_name);
