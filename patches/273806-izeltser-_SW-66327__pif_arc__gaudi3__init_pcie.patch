+#define PHY_FW_FSM_ENA_MASK	(D0_PCIE_WRAP_PHY_FW_FSM_EN_M | \
+				 D0_PCIE_WRAP_PHY_FW_FSM_DIRECT_WRITE_EN_M)
+#define FW_WORD_NUM		(PHY_FW_SIZE / 2)
+
+static void pif_arc_init_pcie_phy_fw_update(void)
+{
+	/*
+	 * Configure FW update size.
+	 * PHY_FW_FSM_SIZE takes few clocks to propagate. It is being sampled by HW few
+	 * clock cycles after the rising edge of PCIE_WRAP ➔ PHY_FW_FSM ➔ DIRECT_WRITE_EN bit.
+	 */
+	regmap_writel(0, mmD0_PCIE_WRAP_PHY_FW_FSM);
+	regmap_writel(FW_WORD_NUM, mmD0_PCIE_WRAP_PHY_FW_FSM_SIZE);
+
+	/* let PHY_FW_FSM_SIZE propagate */
+	pif_ts_delay(1);
+
+	/*
+	 * PHY FW FSM EN and Direct FW write mechanism enable
+	 * FW FSM assumes that the data is present in the SRAM
+	 * The FSM will wait for SRAM init done before updating
+	 * the SRAM contents
+	 */
+	regmap_writel(PHY_FW_FSM_ENA_MASK, mmD0_PCIE_WRAP_PHY_FW_FSM);
+
+	/* Take the PHY out of reset */
+	regmap_writel(1, mmD0_PSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
+}
+
+static void pcie_ref_clk_mode_init(void)
+{
+	u32 strap_h = regmap_readl(mmD0_PSOC_BOOT_CONF_BOOT_STRAP_PINS_H);
+	bool srns, sris;
+
+	srns = strap_h & D0_PSOC_BOOT_CONF_BOOT_STRAP_PINS_H_SRNS_M;
+	sris = strap_h & D0_PSOC_BOOT_CONF_BOOT_STRAP_PINS_H_SRIS_M;
+
+	/* if common clk mode, no configs are required */
+	if (!srns && !sris)
+		return;
+
+	/* common configs for both srns and sris clk */
+	regmap_writel(0, mmD0_PCIE_PHY_PIPE_LANE_CMN_REFCLK_MODE);
+	regmap_writel(0, mmD0_PCIE_PHY_PHYX_MPLL_SHORT_LOCK_EN_0);
+	regmap_writel(0, mmD0_PCIE_PHY_PHYX_MPLL_SHORT_LOCK_EN_1);
+	regmap_writel(0, mmD0_PCIE_PHY_PHYX_MPLL_SHORT_LOCK_EN_2);
+	regmap_writel(0, mmD0_PCIE_PHY_PHYX_MPLL_SHORT_LOCK_EN_3);
+
+	if (sris) {
+		regmap_writel(1, mmD0_PCIE_AUX_APP_SRIS_MODE);
+		regmap_writel(1, mmD0_PCIE_PHY_PIPE_RX_SRIS_MODE_EN);
+	}
+}
+
+static void pif_arc_init_pcie_phy(void)
+{
+	/* Reset PCIe PHY */
+	regmap_writel(0, mmD0_PSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
+
+	/*
+	 * Set PCIe PHY CR Para I/F to CFG.
+	 * Select CR PARA I/F instead of JTAG
+	 */
+	regmap_writel(1, mmD0_PCIE_PHY_CR_PARA_SEL_0);
+	regmap_writel(1, mmD0_PCIE_PHY_CR_PARA_SEL_1);
+	regmap_writel(1, mmD0_PCIE_PHY_CR_PARA_SEL_2);
+	regmap_writel(1, mmD0_PCIE_PHY_CR_PARA_SEL_3);
+
+	/* Select indirect access to CR PARA I/F instead of PRBI */
+	regmap_writel(1, mmD0_PCIE_PHY_CR_PARA_CFG);
+
+	pcie_ref_clk_mode_init();
+
+	pif_arc_init_pcie_phy_fw_update();
+}
+
+static void pif_arc_pcie_device_id_vendor_id_set(void)
+{
+	u32 device_id_vendor_id = hl_pci_get_ven_id_dev_id();
+
+	/* Update Vendor ID */
+	regmap_writel(device_id_vendor_id, mmD0_PCIE_DBI_SIG_DEVICE_ID_VENDOR_ID_REG);
+
+	/* Update subsystem Vendor ID */
+	regmap_writel(device_id_vendor_id, mmD0_PCIE_DBI_SIG_SUBSYSTEM_ID_SUBSYSTEM_VENDOR_ID_REG);
+}
+
+static void pif_arc_config_dbi_params(void)
+{
+	regmap_writel(0x02402801, mmD0_PCIE_DBI_SIG_GEN3_RELATED_OFF);
+	regmap_writel(0x04020031, mmD0_PCIE_DBI_SIG_GEN3_EQ_CONTROL_OFF);
+}
+
+__weak void preboot_update_bar_sizes(void) {}
+__weak void pcie_wait_for_sram_ext_ld_done(void) {}
+
+#define LTTSM_ENA_MASK	(D0_PCIE_AUX_LTSSM_EN_IND_M | D0_PCIE_AUX_LTSSM_EN_MASK_M)
+
+static void pif_arc_init_pcie(void)
+{
+	/* arm timer for delays and timeouts in the pcie init sequence */
+	pif_ts_counter_arm();
+
+	pif_arc_init_pcie_phy();
+
+	pif_arc_pcie_device_id_vendor_id_set();
+
+	pif_arc_config_dbi_params();
+
+	/* Set HBM BAR size */
+	preboot_update_bar_sizes();
+
+	/* Mask Completer Abort AER */
+	hl_pcie_mask_ca_aer();
+
+	/* Wait for phy fw upgrade completion */
+	pcie_wait_for_sram_ext_ld_done();
+
+	/* Enable and Mask LTSSM */
+	regmap_writel(LTTSM_ENA_MASK, mmD0_PCIE_AUX_LTSSM_EN);
+}
+
+
+void pif_arc_pcie_monitoring(void)
+{
+	/* Wait for PRSTn */
+	while (!regmap_readl(mmD0_PSOC_GLOBAL_CONF_PRSTN))
+		;
+
+	/* Only after PRSTn is de-asserted */
+	pif_arc_init_pcie();
+
+	hl_pif_report_sts(PIF_STAT_WAITING_FOR_LINK);
+	while (1) {
+		unsigned int prstn, ltssm, smlh, rdlh;
+
+		prstn = regmap_readl(mmD0_PSOC_GLOBAL_CONF_PRSTN);
+		ltssm = regmap_readl(mmD0_PSOC_GLOBAL_CONF_PRSTN);
+		smlh = regmap_readl(mmD0_PCIE_AUX_SMLH_LINK_UP);
+		rdlh = regmap_readl(mmD0_PCIE_AUX_RDLH_LINK_UP);
+
+		if (prstn && smlh && rdlh)
+			break;
+
+		/*
+		 * Some host assert prstn during link up while moving to GEN3
+		 * This cause BAR size to be reset
+		 * We stop link up process by disabling ltssm
+		 * till BAR is reconfigured
+		 */
+		if (!prstn && ltssm) {
+			regmap_writel(0, mmD0_PCIE_AUX_LTSSM_EN);
+			continue;
+		}
+
+		if (prstn && !ltssm) {
+			regmap_writel(LTTSM_ENA_MASK, mmD0_PCIE_AUX_LTSSM_EN);
+			continue;
+		}
+	}
+
+	hl_pif_clear_sts(PIF_STAT_WAITING_FOR_LINK);
+	hl_pif_report_sts(PIF_STAT_PCIE_INIT_DONE);
+}
+
 void preboot_pcie_wait_for_link(void)
 {
 	struct cpu_load_data load_data = {
