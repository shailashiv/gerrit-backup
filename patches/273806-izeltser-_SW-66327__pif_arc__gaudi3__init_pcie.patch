+#define HBM_BAR_PF_NUM	BIT(4)
+
+void preboot_update_bar_sizes(void)
+{
+	/* Set HBM BAR size to 128GB */
+	regmap_writel(HBM_BAR_PF_NUM << D0_PCIE_AUX_DBI_PF_NUM_S, mmD0_PCIE_AUX_DBI);
+	regmap_writel(0xFFFFFFFF, mmD0_PCIE_DBI_SIG_BAR4_REG);
+	regmap_writel(0x0000001F, mmD0_PCIE_DBI_SIG_BAR5_REG);
+	regmap_writel(0x00000000, mmD0_PCIE_AUX_DBI);
+}
+
+u32 preboot_device_id_get(void)
+{
+	u32 dev_id = PCI_IDS_GAUDI3;
+
+	if (!hl_is_dual_die_sku())
+		dev_id = PCI_IDS_GAUDI3_SINGLE_DIE;
+
+	return dev_id;
+}
+
+#define PCIE_EXT_LD_TIMEOUT_US	10000
+
+void pcie_wait_for_sram_ext_ld_done(void)
+{
+	u64 start = pif_ts_get_us();
+
+	if (!pif_ts_is_timeout_possible(start, PCIE_EXT_LD_TIMEOUT_US))
+		pif_ts_counter_arm();
+
+	hl_pif_report_sts(PIF_STAT_POLL_PCIE_PHY_LOAD);
+
+	while (!(regmap_readl(mmD0_PCIE_PHY_PHYX_SRAM_EXT_LD_DONE_0) &&
+	       regmap_readl(mmD0_PCIE_PHY_PHYX_SRAM_EXT_LD_DONE_1) &&
+	       regmap_readl(mmD0_PCIE_PHY_PHYX_SRAM_EXT_LD_DONE_2) &&
+	       regmap_readl(mmD0_PCIE_PHY_PHYX_SRAM_EXT_LD_DONE_3))) {
+
+		if (pif_ts_timeout_expired(start, PCIE_EXT_LD_TIMEOUT_US)) {
+			hl_pif_report_err(PIF_ERR_PHY_FW_LOAD_TIMEOUT);
+			break;
+		}
+	}
+
+	hl_pif_clear_sts(PIF_STAT_POLL_PCIE_PHY_LOAD);
+}
