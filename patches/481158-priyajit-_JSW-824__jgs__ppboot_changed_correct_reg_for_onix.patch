From 99c4e099d687241cad2f5ad669e7762f3761773e Mon Sep 17 00:00:00 2001
From: Priyajit Ghosh <prghosh@habana.ai>
Date: Thu, 05 Jun 2025 05:00:06 +0300
Subject: [PATCH] [JSW-824] jgs: ppboot changed correct reg for onix

Changed psoc register for JGS onix build.

Change-Id: I0826ec3967237d563563b9a2852f68578bdb6c2c
---

diff --git a/arch/jgs/arc/onix.c b/arch/jgs/arc/onix.c
index e8fc14a..a3cef81 100644
--- a/arch/jgs/arc/onix.c
+++ b/arch/jgs/arc/onix.c
@@ -4,7 +4,7 @@
  */
 
 #include <psoc_pad_conf_regs.h>
-#include <fs1_blocks_linux_driver.h>
+#include <jgs_blocks_linux_driver.h>
 
 #include <baremetal.h>
 #include <pll.h>
@@ -34,9 +34,9 @@
 
 void hl_uart_init(void)
 {
-	regmap_writel(1, mmIO_0_CFG_HALF_0_PSOC_PSOC_CFG_PAD_CONF_BASE +
+	regmap_writel(1, mmIO_0_CFG_PSOC_PSOC_CFG_PAD_CONF_BASE +
 			 mmPSOC_PAD_CONF_PAD_SEL_49);				/* UART0 RXD */
-	regmap_writel(1, mmIO_0_CFG_HALF_0_PSOC_PSOC_CFG_PAD_CONF_BASE +
+	regmap_writel(1, mmIO_0_CFG_PSOC_PSOC_CFG_PAD_CONF_BASE +
 			 mmPSOC_PAD_CONF_PAD_SEL_50);				/* UART0 TXD */
 	preboot_uart_init(SYS_CLOCK_FREQUENCY / (HL_UART_BAUDRATE / 2));
 }
