From f6c298f2611d07c05f33cc0634363df31555887b Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Mon, 04 Oct 2021 17:14:29 +0300
Subject: [PATCH] [SW-52828] boot_if: make some order in the header

Just move some functions' declarations around.
No functional changes.

Change-Id: Iaf8a73cc6b34173d24b3f1401b88a373dec5fcfb
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/include/boot_if.h b/include/boot_if.h
index 5003ad9..b3b821f 100644
--- a/include/boot_if.h
+++ b/include/boot_if.h
@@ -12,16 +12,19 @@
 #include <types.h>
 #include <hl_boot_if.h>		/* requires stdint.h */
 
+/* err/dev status high level functions */
 void cpu_boot_if_init(void);
 u32 cpu_boot_cmd_get(void);
 void cpu_boot_cmd_clr_before_wfe(void);
-void cpu_boot_sts_set(u32 val);
+void cpu_boot_rsp_set(enum cpu_msg_status sts);
+void cpu_boot_if_fix_ro_regs(void);
+void cpu_boot_sts_set(u32 val);	/* boot progress status */
+
+/* err/dev status low level functions */
 void cpu_boot_err_clrset(u64 mask, bool set);
 bool cpu_boot_err_get(u64 mask);
 void cpu_boot_dev_sts_clrset(u64 mask, bool set);
-void cpu_boot_rsp_set(enum cpu_msg_status sts);
 u64 cpu_boot_dev_sts_get_all(void);
-void cpu_boot_if_fix_ro_regs(void);
 
 /* COMMS APIs */
 void cpu_comms_sts_set(struct comms_status *sts);
