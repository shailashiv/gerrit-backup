From dc6403e9b7d742eccda5236529578824d46b17cb Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Mon, 11 Jan 2021 23:05:09 +0200
Subject: [PATCH] [SW-20719] gaudi: introduce hbm init code

Add HBM initialization code as a part of requirement for cleaning the
HBM memory after FLR/reset/on power up.
The code is mainly copied from U-Boot, but multiple adjustments were
made to lower the compiled binary size.
The HBM frequency is set to a safe default of 800MHz.
All the debug abilities were stripped.
Error messages shortened or removed - depending on case.

Change-Id: I195f382a83f2bcd08fbd5d1c3a2348046ec0543e
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/gaudi/Makefile b/gaudi/Makefile
index b2e96ac..b06b553 100644
--- a/gaudi/Makefile
+++ b/gaudi/Makefile
@@ -3,6 +3,7 @@
 
 PREBOOT_SRCS_C += $(shell ls $(HL_DEV)/pll.c)
 PREBOOT_SRCS_C += $(shell ls $(HL_DEV)/security.c)
+PREBOOT_SRCS_C += $(shell ls $(HL_DEV)/hbm.c)
 PREBOOT_SRCS_C += $(shell ls $(HL_DEV)/reset.c)
 
 image_validation: image_validation_common
diff --git a/gaudi/asic.c b/gaudi/asic.c
index 2c77591..978dc06 100644
--- a/gaudi/asic.c
+++ b/gaudi/asic.c
@@ -221,3 +221,12 @@
 
 	cpu_boot_dev_sts_clrset(CPU_BOOT_DEV_STS0_CLK_GATE_EN, true);
