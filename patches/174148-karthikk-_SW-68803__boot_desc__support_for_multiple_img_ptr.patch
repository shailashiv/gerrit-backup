+					HL_SPI_BOOT_PTR_SP_SRAM_OFF)
+#define HL_BOOT_PTS_COUNT_FLASH_OFFSET	(BOOT_PTRS_SZ - sizeof(uint32_t))
 
 struct boot_desc {
 	uint32_t desc_ver;
@@ -35,21 +45,24 @@
