diff --git a/common/boot_desc.c b/common/boot_desc.c
index a97cfee..15aa11b 100644
--- a/common/boot_desc.c
+++ b/common/boot_desc.c
@@ -17,14 +17,17 @@
 
 #define BOOT_PTRS_SZ		sizeof(struct hl_fw_boot_ptrs)
 #define IMG_DESC_SZ		sizeof(struct hl_fw_img_desc)
-#define CRC32_PADD		sizeof(uint32_t)
 #define DESC_MAGIC_MASK		0xFFFFFF00
 #define INV_VER1		((uint32_t)0)
 #define INV_VER2		((uint32_t) -1)
 #define INVALID_DESC_ID		2
+#define ALIGN_SUB(val, byte)	(((val) + (byte)) & ~(byte))
+#define ALIGN_VAL(val, byte)	ALIGN_SUB(val, (byte - 1))
 
-static struct hl_fw_boot_ptrs *p_boot_ptrs;
-static struct hl_fw_img_desc *p_img_desc[HL_FW_MAX_EROM_BOOT_PTRS - 1];
+static struct hl_fw_boot_ptrs_ctx *p_img_ptr_ctx;
+static struct hl_fw_boot_ptrs *p_boot_ptr = (struct hl_fw_boot_ptrs *)(HL_SPI_BOOT_PTR_SP_SRAM_ADDR);
+static struct hl_fw_img_desc *p_img_desc = (struct hl_fw_img_desc *)(HL_SPI_BOOT_PTR_SP_SRAM_ADDR +\
+					BOOT_PTRS_SZ);
 
 static bool boot_desc_img_desc_is_valid(struct hl_fw_img_desc *img_desc)
 {
@@ -41,70 +44,116 @@
 	return true;
 }
 
-int boot_desc_init(void)
+static void boot_desc_update_ptrs(enum hl_fw_boot_ptr_imgs img)
+{
+	p_img_ptr_ctx = &arcboot_rom_global.boot_ptr_ctx[img];
+
+	if (img == HL_FW_BOOT_PTR_EROM) {
+		p_boot_ptr = &arcboot_rom_global.img_ptrs_erom.boot_ptr;
+		p_img_desc = arcboot_rom_global.img_ptrs_erom.img_desc;
+	}
+}
+
+int boot_desc_init(enum hl_fw_boot_ptr_imgs img)
 {
 	uint32_t i, boot_ptrs_count, img_ptrs_size;
-	uint32_t *p_count = NULL;
+	uint32_t *p_offset = NULL;
+	enum arcboot_rom_progress dma_sts_start = PROGRESS_INIT_SPI_BOOT_DESC_DMA_START;
+	enum arcboot_rom_progress dma_sts_end = PROGRESS_INIT_SPI_BOOT_DESC_DMA_FINISH;
 
-	boot_ptrs_count = spi_flash_readl(HL_BOOT_PTS_COUNT_FLASH_OFFSET);
+	if (img >= HL_FW_BOOT_PTR_MAX_IMG)
+		return 0;
 
-	if (boot_ptrs_count >= HL_FW_MAX_EROM_BOOT_PTRS)
+	boot_desc_update_ptrs(img);
+
+	/* Initialize boot descriptor once */
+	if (p_img_ptr_ctx->boot_desc_flag)
+		return p_boot_ptr->count;
+
+	boot_ptrs_count = spi_flash_readl(p_img_ptr_ctx->img_ptr_spi_offset
+			+ HL_BOOT_PTS_COUNT_FLASH_OFFSET);
+
+	if (boot_ptrs_count >= p_img_ptr_ctx->max_imgs)
 		return 0;
 
 	img_ptrs_size = BOOT_PTRS_SZ + ((sizeof(uint32_t) +
-			IMG_DESC_SZ) * boot_ptrs_count) + CRC32_PADD;
+			IMG_DESC_SZ) * boot_ptrs_count);
 
-	arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_BOOT_DESC_DMA_START);
+	/* Align image size to 16 bytes */
+	img_ptrs_size = ALIGN_VAL(img_ptrs_size, 16);
+	/* Add 4 byte CRC to aligned image size for DMA */
+	img_ptrs_size += CRC32_SIZE;
 
-	/* Fetch boot desc using DMA into SP SRAM offset of 4KB */
-	dma_copy_image(img_ptrs_size, HL_EROM_IMG_PTRS_BASE,
-		       HL_SP_SRAM_BASE + (HL_BOOT_DESC_SP_SRAM_OFFSET >> 2),
-		       SPI_DMA_DST_HBW);
+	if (img == HL_FW_BOOT_PTR_EROM) {
+		dma_sts_start = PROGRESS_ARCBOOT_EROM_BOOT_DESC_DMA_START;
+		dma_sts_end = PROGRESS_ARCBOOT_EROM_BOOT_DESC_DMA_FINISH;
+	}
+
+	arcboot_rom_status_update(dma_sts_start);
+
+	/* Fetch boot desc using DMA into dest offset */
+	dma_copy_image(img_ptrs_size, p_img_ptr_ctx->img_ptr_spi_offset,
+			HL_BOOT_PTR_DMA_DEST, SPI_DMA_DST_HBW);
 	if (dma_wait_finish() == DMA_CRC_ERROR)
 		return 0;
 
-	arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_BOOT_DESC_DMA_FINISH);
+	arcboot_rom_status_update(dma_sts_end);
 
-	p_count = (uint32_t *) HL_BOOT_PTS_COUNT_SRAM_OFFSET;
-	p_boot_ptrs = (struct hl_fw_boot_ptrs *)(HL_BOOT_PTS_SP_SRAM_START);
+	p_offset = (uint32_t *)(HL_BOOT_PTR_DEST_ARC + BOOT_PTRS_SZ);
+	memcpy(p_boot_ptr,
+		(uint8_t *)(HL_BOOT_PTR_DEST_ARC), BOOT_PTRS_SZ);
 
-	if (p_boot_ptrs->magic.val != HL_FW_BOOT_MAGIC)
+	if (p_boot_ptr->magic.val != HL_FW_BOOT_MAGIC)
 		return 0;
 
 	/* Read all descriptors */
-	for (i = 0; i < p_boot_ptrs->count; i++) {
-		p_img_desc[i] = (struct hl_fw_img_desc *)
-				(HL_BOOT_PTS_SP_SRAM_START + p_count[i]);
-		if (!boot_desc_img_desc_is_valid(p_img_desc[i]))
+	for (i = 0; i < p_boot_ptr->count; i++) {
+		memcpy(&p_img_desc[i],
+			(uint8_t *)(HL_BOOT_PTR_DEST_ARC + p_offset[i]), IMG_DESC_SZ);
+
+		if (!boot_desc_img_desc_is_valid(&p_img_desc[i]))
 			return 0;
 	}
-	arcboot_rom_global.rom_boot_desc_flag = 1;
-	return p_boot_ptrs->count;
+	p_img_ptr_ctx->boot_desc_flag = 1;
+
+	return p_boot_ptr->count;
 }
 
-uint32_t boot_desc_get_img_desc(enum hl_fw_img_type type,
-				struct boot_desc *desc)
+uint32_t boot_desc_get_img_desc(enum hl_fw_boot_ptr_imgs img, int type,
+				struct boot_desc *desc, enum fw_post_reset_cmd upd_status)
 {
-	uint32_t i;
+	uint32_t i, idx;
 
-	/* boot descriptors not initialized */
-	if ((p_boot_ptrs == NULL) || (p_img_desc == NULL))
+	if (img >= HL_FW_BOOT_PTR_MAX_IMG)
 		return HL_FW_IMG_NOT_FOUND;
 
-	for (i = 0; i < p_boot_ptrs->count; i++) {
-		if (p_img_desc[i]->magic.type != type)
+	/* Image descriptor pointers validity check */
+	if (!p_img_ptr_ctx || !p_boot_ptr || !p_img_desc)
+		return HL_FW_IMG_NOT_FOUND;
+
+	if (p_img_ptr_ctx->boot_desc_flag != 1)
+		return HL_FW_IMG_NOT_FOUND;
+
+	for (i = 0; i < p_boot_ptr->count; i++) {
+		if (p_img_desc[i].magic.type != type)
 			continue;
 
-		desc->spi_offset = p_img_desc[i]->offset[p_img_desc[i]->idx];
-		desc->img_size = p_img_desc[i]->size[p_img_desc[i]->idx];
-		desc->loadaddr = ((uint64_t)
-			p_img_desc[i]->load_high[p_img_desc[i]->idx] << 32) |
-			p_img_desc[i]->load_low[p_img_desc[i]->idx];
-		desc->desc_ver = p_img_desc[i]->desc_ver;
-		memcpy(desc->chksum, p_img_desc[i]->chksum[p_img_desc[i]->idx],
-		       ARRAY_SIZE(desc->chksum));
+		idx = p_img_desc[i].idx;
+		if (upd_status == FLOPS_UPD_PENDING)
+			idx = (idx + 1) % 2;
 
-		return p_img_desc[i]->idx;
+		desc->spi_offset = p_img_desc[i].offset[idx];
+		desc->img_size = p_img_desc[i].size[idx];
+		desc->loadaddr = ((uint64_t)
+			p_img_desc[i].load_high[idx] << 32) |
+			p_img_desc[i].load_low[idx];
+		desc->desc_ver = p_img_desc[i].desc_ver;
+
+		if (img != HL_FW_BOOT_PTR_SPI)
+			memcpy(desc->chksum, p_img_desc[i].chksum2[idx],
+				   ARRAY_SIZE(desc->chksum));
+
+		return idx;
 	}
 	return HL_FW_IMG_NOT_FOUND;
 }
