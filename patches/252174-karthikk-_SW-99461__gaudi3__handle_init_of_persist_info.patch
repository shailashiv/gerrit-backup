@@ -47,7 +48,9 @@
 	} > REGION_TEXT
 
 	.data : AT ( LOADADDR(.text) + SIZEOF(.text) ) {
+		_data_after_persist_sec = _etext + _persistent_sec_size;
 		_data = .;
+		_rom_non_persistent_dccm_start = _data;
 		 KEEP(*(.rom_persistent_section))
 		*(.data)
 	} > REGION_DATA
