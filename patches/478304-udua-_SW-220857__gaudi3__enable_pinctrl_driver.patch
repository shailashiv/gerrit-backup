From 22607c3bea6af006e1e414c970d22afced05402b Mon Sep 17 00:00:00 2001
From: Udita <udidua@habana.ai>
Date: Tue, 06 May 2025 11:09:02 +0300
Subject: [PATCH] [SW-220857] gaudi3: enable pinctrl driver

The patch enables the pinctrl driver.
changes are made in the device tree, Cmake,
Kconfigs and defconfig files for management,
agent, event and pid to support the pinctrl
driver changes in spi and i2c.

Change-Id: Icc2a506267cfc5059047b6c378b218df78640ced
Signed-off-by: Udita <udidua@habana.ai>
---

diff --git a/boards/hl/gaudi3/hl_gaudi3_agent_asic_defconfig b/boards/hl/gaudi3/hl_gaudi3_agent_asic_defconfig
index a1225ec..ffc5c8d 100644
--- a/boards/hl/gaudi3/hl_gaudi3_agent_asic_defconfig
+++ b/boards/hl/gaudi3/hl_gaudi3_agent_asic_defconfig
@@ -50,6 +50,8 @@
 CONFIG_SPI_NOR_SFDP_RUNTIME=y
 CONFIG_FLASH_JESD216_API=y
 CONFIG_SPI_NOR_FLASH_HW_WO_PROTECTION=y
+CONFIG_PINCTRL=y
+CONFIG_PINCTRL_HL_GAUDI3=y
 
 CONFIG_HL_EFUSE=y
 CONFIG_HL_FAKE_EFUSE=y
