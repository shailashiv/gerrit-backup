From 089666b33aa6debe1ba9baf8a38750d3a78883a1 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Mon, 27 Nov 2023 07:42:45 +0200
Subject: [PATCH] [FSW-334] header: rename preboot.h

As preboot has been removed from this project, the preboot.h header
that is widely used by all components of the project is renamed to
baremetal.h

Change-Id: I0be6d68b8229bb6ecb5cae2bc81739520674e33f
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/Makefile b/Makefile
index a1ea621..29ef5bc 100644
--- a/Makefile
+++ b/Makefile
@@ -84,7 +84,7 @@
 	@LANG=en_us date +'#define PREBOOT_DATE "%b %d %Y"' >> $@
 	@date +'#define PREBOOT_TIME "%T"' >> $@
 
-buildversion-habanalabs: include/preboot.h $(AUTO_GENERATED_FILE)
+buildversion-habanalabs: include/baremetal.h $(AUTO_GENERATED_FILE)
 	echo "VERSION_STR" | gcc -include $< -I./ -I ./lib/common/ -I ./$(HL_DEV_ARCH)/ -I$(SPECS_EMBEDDED_DIR)/$(SPECS_EMB_DEV) -I$(SPECS_DIR)/$(BASE_DEV_NAME)/asic_reg -I$(SPECS_DIR)/ -I ./include/ -P -E -o - - | tail -1 | sed 's/\" \+\"//g;s/["\n]//g' | cut -d' ' -f2- | tr -d '\n' > $@
 
 $(PCI_PHY_FW_TARGET): $(HL_DEV_ARCH)/pcie_phy_fw.i
