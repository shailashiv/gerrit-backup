diff --git a/include/baremetal.h b/include/baremetal.h
new file mode 100644
index 0000000..741ee11
--- /dev/null
+++ b/include/baremetal.h
@@ -0,0 +1,288 @@
+/*
+ * Copyright (C) 2017 HabanaLabs Ltd.
+ *   Author: Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#ifndef COMMON_PREBOOT_H_
+#define COMMON_PREBOOT_H_
+
+#include <common.h>
+#include <sizes.h>
+
+#define ARRAY_SIZE(x)		(sizeof(x) / sizeof((x)[0]))
+#define ROUND_UP4(n)		(((n) + sizeof(u32) - 1) & ~(sizeof(u32) - 1))
+
+#ifdef __arc__
+#define wfe()	__asm__ __volatile__("wevt\n\t" : : )
+
+#define ARC_V2_IDENTITY_REG	0x004
+
+/*
+ * ARC1 released from reset first, so its ID in HW is always default 0.
+ * other ARCs ID is set relatively to ARC1.
+ * return normalized cpu id: arc0 = 0, arc1 = 1, arc2 = 2
+ */
+#define HL_ARC_V2_CORE_ID()					\
+({								\
+	s8 __ret;						\
+	__asm__ __volatile__("lr %0, [%1]\n"			\
+			     "xbfu %0, %0, 0xe8\n"		\
+			     : "=r"(__ret)			\
+			     : "i"(ARC_V2_IDENTITY_REG));	\
+	++__ret;						\
+})
+#endif
+
+#ifdef __aarch64__
+#define wfe()	__asm__ __volatile__ ("wfe\n\t" : : )
+#endif
+
+#define HL_UART_BAUDRATE	115200
+#define HL_SPI_FLASH_MAX_FREQ	25000000
+
+#define FIT_IMG_SPSRAM_MAX_SIZE		SZ_8K
+#define FIT_IMG_SPSRAM_END		(HL_SP_SRAM_BASE + HL_SP_SRAM_SIZE)
+#define FIT_IMG_SPSRAM_BASE		(FIT_IMG_SPSRAM_END - \
+					 FIT_IMG_SPSRAM_MAX_SIZE)
+
+
+#ifndef __ASSEMBLY__
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <types.h>
+#include "auto_generated.h"
+
+#define VERSION_MAX_LEN		128
+
+#define VERSION_STR	"version " PREBOOT_VER \
+	" (" PREBOOT_DATE " - " PREBOOT_TIME ")"
+
+#ifndef __packed
+#define __packed	__attribute__((packed))
+#endif
+#ifndef __weak
+#define __weak		__attribute__((weak))
+#endif
+#ifndef __aligned
+#define __aligned(x)	__attribute__((aligned(x)))
+#endif
+#ifndef __unused
+#define __unused	__attribute__((__unused__))
+#endif
+
+enum hl_debug_hw_func {
+	HL_DEBUG_HW_PCIE,
+	HL_DEBUG_HW_DRAM,
+	HL_DEBUG_HW_I2C,
+	HL_DEBUG_HW_DBG_CARD,
+};
+
+enum preboot_vers {
+	PREBOOT_BTL_VER,
+	PREBOOT_EFUSE_VER,
+};
+
+enum fit_sec_failure {
+	FIT_SEC_NONE = 0,
+	FIT_SEC_SVN_INVALID,
+	FIT_SEC_KEY_REVOKED,
+	FIT_SEC_SIGN_FAILED,
+};
+
+struct hl_nic_en {
+	bool is_valid;
+	uint32_t bitmask;
+};
+
+extern uintptr_t _start;	/* Start of ppboot/preboot region */
+extern uintptr_t __stack_top;	/* End of ppboot/preboot region */
+extern u32 __stack;		/* stack last cell value */
+extern struct hl_i2ci_device_status op_status; /* Contains OAM status info */
+
+#define STACK_CANARY_MAGIC_WORD	0x8BADF00D
+
+extern struct hl_fw_info_compat fw_info;
+/*
+ * TODO: Move to platform specific file once
+ * device id size is defined for other platforms
+ */
+#define FUSE_DEVID_SIZE	8
+
+extern u8 hl_asic_sn[FUSE_DEVID_SIZE];
+
+static inline u8 regmap_readb(u32 offset)
+{
+	u32 reg = *((volatile u32 *)(HL_CFG_BASE + offset));
+
+	return (u8)(reg & 0xFF);
+}
+
+static inline void regmap_writeb(u8 val, u32 offset)
+{
+	*((volatile u32 *)(HL_CFG_BASE + offset)) = (u32)val;
+}
+
+static inline u32 regmap_readl(u32 offset)
+{
+	u32 reg = *((volatile u32 *)(HL_CFG_BASE + offset));
+
+	return reg;
+}
+
+static inline void regmap_writel(u32 val, u32 offset)
+{
+	*((volatile u32 *)(HL_CFG_BASE + offset)) = val;
+}
+
+static inline void regmap_rmwritel(u32 addr, u32 data, u32 mask)
+{
+	u32 val;
+
+	val = regmap_readl(addr);
+	val &= ~mask;
+	val |= (data << (__builtin_ffsll(mask) - 1));
