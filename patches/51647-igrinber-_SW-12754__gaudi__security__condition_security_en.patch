From c6b1ba2aa2174922645b35f163ac03b555d6e9bc Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Tue, 15 Sep 2020 20:31:46 +0300
Subject: [PATCH] [SW-12754] gaudi: security: condition security en

Move the security initializations to run only if security is enabled.

Change-Id: I77d94fc1d96b548afe686d9840023a4eeb115845
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/gaudi/security.c b/gaudi/security.c
index 7d87a63..77ac7f2 100644
--- a/gaudi/security.c
+++ b/gaudi/security.c
@@ -536,6 +536,14 @@
 
 	if (preboot_security_is_enabled()) {
 		preboot_puts("Security is enabled\n");
+
+		preboot_secure_cpu();
+		preboot_secure_psoc();
+		preboot_secure_pci();
+		preboot_secure_mme();
+		preboot_secure_tpc();
+
+		/* TODO: implement the rest of security enablement */
 	} else {
 		preboot_puts("Security is disabled\n");
 		/* TODO: add preboot_security_pci_disable(); */
@@ -550,14 +558,6 @@
 	 */
 	preboot_puts("Disabling security temporarily till all implemented\n");
 	preboot_security_pci_disable();
-
-	preboot_secure_cpu();
-	preboot_secure_psoc();
-	preboot_secure_pci();
-	preboot_secure_mme();
-	preboot_secure_tpc();
-
-	/* TODO: implement the rest of security enablement */
 
 	cpu_boot_err_clrset(CPU_BOOT_ERR0_SECURITY_NOT_RDY, false);
 	preboot_puts("Security init finished.\n");
