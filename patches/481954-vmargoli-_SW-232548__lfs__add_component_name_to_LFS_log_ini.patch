From 1d67fa5637cea6d1b3ca07614ec2dcfb7c4f99bb Mon Sep 17 00:00:00 2001
From: Vitaly Margolin <vmargolin@habana.ai>
Date: Tue, 17 Jun 2025 16:13:25 +0300
Subject: [PATCH] [SW-232548] lfs: add component name to LFS log init

Add componont name to LFS logger initialization
This is done to simplify robot testing of LFS logger
feature

Change-Id: I193300eab8a8c21a0a210cbc614f0212604733b1
Signed-off-by: Vitaly Margolin <vmargolin@habana.ai>
---

diff --git a/app/io/preboot.c b/app/io/preboot.c
index acfbf42..dd1bd65 100644
--- a/app/io/preboot.c
+++ b/app/io/preboot.c
@@ -652,7 +652,7 @@
 #ifdef CONFIG_LFS_ENABLED
 static void start_lfs_logger(void)
 {
-	lfs_console_init();
+	lfs_console_init_by_component("Preboot");
 }
 #else
 static void start_lfs_logger(void) {}
