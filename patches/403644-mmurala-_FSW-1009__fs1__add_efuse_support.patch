+++ b/common/spi_flash.c
@@ -4,8 +4,10 @@
  * All Rights Reserved.
  */
 
+#include <fs1_efuse.h>
 #include <boot_rom.h>
 #include <spi_flash.h>
+#include "dev_spi_flash.h"
 
 void spi_flash_init(void)
 {
@@ -17,3 +19,17 @@
 	spi_flash_set_write_limit(write_en_2MB);
 }
 
+uint32_t spi_flash_fuse_read(uint32_t word, uint32_t *val)
+{
+	uint32_t offset;
+
+	/* read value from bank0 */
+	offset = (word * sizeof(uint32_t));
+	*val = spi_flash_readl(boot_rom_global.fake_fuse_spi_offset + offset);
+
+	/* read value from bank1 and OR with value from bank0 */
+	offset = ((EFUSE_WORDS_PER_BANK + word) * sizeof(uint32_t));
+	*val |= spi_flash_readl(boot_rom_global.fake_fuse_spi_offset + offset);
+
+	return BOOT_ROM_SUCCESS;
+}
