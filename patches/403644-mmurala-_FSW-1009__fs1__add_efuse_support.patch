From 93c76e75c9fb45e48a5e233e5fbd74dead6ff6b9 Mon Sep 17 00:00:00 2001
From: Murala S Swamy <ssmurala@habana.ai>
Date: Thu, 14 Mar 2024 18:00:24 +0200
Subject: [PATCH] [FSW-1009] fs1: add efuse support

This patch added efuse support, bootrom will
trigger fsm to start efuse data of size 256dwords
(bank0 and bank1) copy from efuse device to psoc
config space efuse data registers. if any failure
in efuse read, system will goto halt.

Change-Id: Ia9766ea1b24726a0b6d8cc9f194bfe1539a1f772
---

diff --git a/app/boot_rom.c b/app/boot_rom.c
index a4f4eaa..31e6add 100644
--- a/app/boot_rom.c
+++ b/app/boot_rom.c
@@ -16,6 +16,7 @@
 	.curr_img = 0,
 	.die_id = 0,
 	.die_type = INVALID_DIE_TYPE,
+	.fake_fuse_en = false,
 };
 
 struct boot_rom_manifest_s __attribute__((section (".rom_manifest_section")))boot_rom_manifest;
@@ -24,6 +25,8 @@
 {
 	boot_rom_init();
 
+	boot_rom_fuse();
+
 	boot_rom_security_init();
 
 	return 0;
diff --git a/arch/fs1/arc/Makefile b/arch/fs1/arc/Makefile
index b3e84cc..14b4125 100644
--- a/arch/fs1/arc/Makefile
+++ b/arch/fs1/arc/Makefile
@@ -6,4 +6,4 @@
 
 BOOT_ROM_COMMON_SRCS_C += $(shell ls $(HL_DEV_ARCH)/dev_delay.c)
 BOOT_ROM_COMMON_SRCS_C += $(shell ls $(HL_DEV_ARCH)/dev_spi_flash.c)
-
+BOOT_ROM_COMMON_SRCS_C += $(shell ls $(HL_DEV_ARCH)/dev_efuse.c)
diff --git a/arch/fs1/arc/common.c b/arch/fs1/arc/common.c
index a65fc4d..91af5c7 100644
--- a/arch/fs1/arc/common.c
+++ b/arch/fs1/arc/common.c
@@ -16,6 +16,7 @@
 #include <fs1_reg_mask.h>
 #include <fs1_fw_if.h>
 #include <status.h>
+#include <efuse.h>
 
 uint8_t boot_rom_get_die_id(void)
 {
@@ -136,3 +137,44 @@
 	cold_rst_data.arc1_iccm_init_done = 1;
 	regmap_writel(cold_rst_data.data, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
 }
+
+void boot_rom_halt(void)
+{
+	while (1) {
+		/* TODO: uart print character 'h' */
+		wfe();
+	}
+}
+
+static void boot_rom_set_efuse_read(void)
+{
+	struct fs1_cold_rst_data cold_rst_data;
+
+	cold_rst_data.data = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+	if (cold_rst_data.efuse_read_flag)
+		return;
+
+	/* efuse init successful, set cold flops */
+	cold_rst_data.efuse_read_flag = 1;
+	regmap_writel(cold_rst_data.data, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+}
+
+void boot_rom_fuse(void)
+{
+	if (boot_rom_fuse_init() == BOOT_ROM_SUCCESS) {
+		boot_rom_set_efuse_read();
+	} else {
+		boot_rom_status_update(PROGRESS_INIT_EFUSE_INIT_FAIL);
+		boot_rom_halt();
+	}
+
+	if (boot_rom_fuse_read(IO_EFUSE_SYSCFG_OFFSET, &boot_rom_global.config_fuse) != BOOT_ROM_SUCCESS)
+		boot_rom_halt();
+
+	if(boot_rom_fuse_read(IO_EFUSE_SYSCFG2_OFFSET, &boot_rom_global.config2_fuse) != BOOT_ROM_SUCCESS)
+		boot_rom_halt();
+
+	/* TODO: FS1 SKU decession pending */
+
+	/* TODO: Enable FAKE FUSE & RMA support */
+}
diff --git a/arch/fs1/arc/dev_efuse.c b/arch/fs1/arc/dev_efuse.c
new file mode 100644
index 0000000..4d6cbff
--- /dev/null
+++ b/arch/fs1/arc/dev_efuse.c
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2024 HabanaLabs Ltd.
+ * All Rights Reserved.
+ */
+
+#include "boot_rom.h"
+#include "mem_io.h"
+#include <fs1_blocks_linux_driver.h>
+#include <efuse_masks.h>
+#include <fs1_reg_map.h>
+#include <efuse_regs.h>
+#include <dev_efuse.h>
+#include "delay.h"
+
+void fuse_prog_range_config(void)
+{
+	regmap_writel(EFUSE_PROG_ADDRESS_LAST_M, IO0_H0_PSOC_EFUSE(mmEFUSE_PROG_ADDRESS));
+}
+
+void fuse_prog_read_address(void)
+{
+	regmap_writel(EFUSE_READ_ADDRESS_LAST_M, IO0_H0_PSOC_EFUSE(mmEFUSE_READ_ADDRESS));
+}
+
+uint32_t fuse_read_data(uint32_t offset)
+{
+	return regmap_readl(IO0_H0_PSOC_EFUSE(mmEFUSE_DATA_0) + offset);
+}
+
+uint32_t fuse_get_read_ctrl_reg_val(void)
+{
+	return regmap_readl(IO0_H0_PSOC_EFUSE(mmEFUSE_RD));
+}
+
+void fuse_set_read_ctrl_reg_val(uint32_t fsm_trigger)
+{
+	regmap_writel(fsm_trigger, IO0_H0_PSOC_EFUSE(mmEFUSE_RD));
+}
diff --git a/arch/fs1/arc/dev_efuse.h b/arch/fs1/arc/dev_efuse.h
new file mode 100644
index 0000000..eae068b
--- /dev/null
+++ b/arch/fs1/arc/dev_efuse.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Copyright (C) 2024 HabanaLabs Ltd.
+ */
+
+#ifndef _DEV_EFUSE_H_
+#define _DEV_EFUSE_H_
+
+#define FLASH_VALID_MASK			0x1FFFFF
+
+#define FUSE_READ_FSM_TRIGGER		0x1
+#define FUSE_DELAY_US				5
+#define FUSE_TIMEOUT_US				500
+#define FUSE_RETRIES				(FUSE_TIMEOUT_US / FUSE_DELAY_US)
+
+void fuse_prog_range_config(void);
+void fuse_prog_read_address(void);
+uint32_t fuse_get_read_ctrl_reg_val(void);
+void fuse_set_read_ctrl_reg_val(uint32_t fsm_trigger);
+uint32_t fuse_read_data(uint32_t offset);
+
+#endif /* _DEV_EFUSE_H_ */
diff --git a/arch/fs1/arc/dev_spi_flash.c b/arch/fs1/arc/dev_spi_flash.c
index f56be1e..efb317a 100644
--- a/arch/fs1/arc/dev_spi_flash.c
+++ b/arch/fs1/arc/dev_spi_flash.c
@@ -40,3 +40,12 @@
 {
 	regmap_writel(write_limit, IO0_H0_PSOC_GLOBAL_CONF(mmGLOBAL_CONF_SPI_WRITE_LIMIT));
 }
+
+uint32_t spi_flash_readl(uint32_t offset)
+{
+	/* mask offset to valid range of flash */
+	offset &= FLASH_VALID_MASK;
+	uint32_t val = base_readl(HL_FLASH_BASE + offset);
+
+	return val;
+}
