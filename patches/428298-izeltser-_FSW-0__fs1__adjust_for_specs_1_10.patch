From a15bb9d3e2d58b39f21c62689594650ec2dd4268 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Thu, 27 Jun 2024 18:40:06 +0300
Subject: [PATCH] [FSW-0] fs1: adjust for specs 1.10

Adjust reg for VLSI tag 1.10

Change-Id: I2c32c23e8258bfbfa666c3837a1e06fba26c7ccb
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/arch/fs1/arc/common.c b/arch/fs1/arc/common.c
index 0f1079b..729ef0f 100644
--- a/arch/fs1/arc/common.c
+++ b/arch/fs1/arc/common.c
@@ -116,7 +116,8 @@
 				  mmPCIE_FLR_APP_FLR_PF_DONE;
 	pci.aux_rdlh_link_up_reg = mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_RDLH_LINK_UP;
 	pci.aux_smlh_link_up_reg = mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_SMLH_LINK_UP;
-	pci.core_hot_rst_reg = mmIO_0_CFG_HALF_0_CXL_EP_PCIE_CORE_BASE + mmPCIE_CORE_HOT_RST;
+	pci.core_hot_rst_reg = mmIO_0_CFG_HALF_0_CXL_EP_PCIE_CORE_BASE +
+			       mmPCIE_CORE_INTR_SPI_CAUSE_HOT_RESET;
 }
 
 void device_init_global_conf(void)
