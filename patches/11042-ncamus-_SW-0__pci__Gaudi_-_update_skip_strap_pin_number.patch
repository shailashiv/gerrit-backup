From fd486b2ae3e4a711042605adcf0f5ec87715bcd5 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Tue, 09 Apr 2019 01:39:31 +0300
Subject: [PATCH] [SW-0] pci: Gaudi - update skip strap pin number

This is strap_19 (GPIO_31) as defined by system team

Change-Id: Id8c6a2e979cf728e447d9a4d53b6d4685e30ae67
---

diff --git a/gaudi/gaudi.h b/gaudi/gaudi.h
index 4f7ca9e..9863004 100644
--- a/gaudi/gaudi.h
+++ b/gaudi/gaudi.h
@@ -5,8 +5,8 @@
  * SPDX-License-Identifier:     GPL-2.0+
  */
 
-/* Use DumpSel[8] to skip PCIe initialization */
-#define SKIP_PCIE_INIT BIT(16)
+/* Use DumpSel[11] to skip PCIe initialization */
+#define SKIP_PCIE_INIT BIT(19)
 
 void preboot_pcie_wait_for_link(void);
 static inline void preboot_delay(void) {}
