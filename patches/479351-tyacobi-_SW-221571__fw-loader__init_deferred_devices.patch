From 1605643b87f7ca007144046fe55194035d4d3086 Mon Sep 17 00:00:00 2001
From: Tal Yacobi <tyacobi@habana.ai>
Date: Thu, 08 May 2025 14:44:05 +0300
Subject: [PATCH] [SW-221571] fw-loader: init deferred devices

Some devices are not supported in pcie card type
(e.g., in HL-338)

Check which of these devices are supported
and init them on runtime.

Change-Id: Ib2034f26ad380cd2c90baf88f37bf1c2a57d2edc
Signed-off-by: Tal Yacobi <tyacobi@habana.ai>
---

diff --git a/fw-loader/src/main.c b/fw-loader/src/main.c
index ea45152..ed1a31c 100644
--- a/fw-loader/src/main.c
+++ b/fw-loader/src/main.c
@@ -212,6 +212,15 @@
 static void start_lfs_logger(void) {}
 #endif
 
+void hl_device_drivers_deferred_init(void)
+{
+	DEVICE_INIT_IF_EXIST(xdpe, XDPE132G5H_DEV);
+	DEVICE_INIT_IF_EXIST(xdpe, XDPE132G5H_0_DEV);
+	DEVICE_INIT_IF_EXIST(xdpe, XDPE132G5H_1_DEV);
+	DEVICE_INIT_IF_EXIST(xdpe, XDPE132G5H_2_DEV);
+	DEVICE_INIT_IF_EXIST(xdpp1100, XDPP1100_DEV);
+}
+
 void main(void)
 {
 	int ret;
@@ -224,6 +233,7 @@
 	print_btl_image();
 	cpu_boot_if_init();
 	LOG_INF("Initialized fw-loader: %s\n", CONFIG_BOARD);
+	hl_device_drivers_deferred_init();
 	hl_sec_dynamic_init();
 	hl_version();
 	watchdog_disable();
