From 0af15e1805d14dabc70dc5e9b568559fc36597b5 Mon Sep 17 00:00:00 2001
From: Abhishek <apatgaonkar@habana.ai>
Date: Fri, 19 Jul 2024 07:33:59 +0300
Subject: [PATCH] [FSW-2704] fs1: validate and boot primary ppboot

This patch validates and boots primary ppboot
image.

Change-Id: Ia00781c0161e85bd5fdd5a32c8b542aeda22be88
---

diff --git a/app/boot_rom.c b/app/boot_rom.c
index 3c39aac..cca969f 100644
--- a/app/boot_rom.c
+++ b/app/boot_rom.c
@@ -8,6 +8,7 @@
 #include <security.h>
 #include <boot_flow.h>
 #include <recovery.h>
+#include <common.h>
 
 const int fs1_die_type = DIE_TYPE;
 
@@ -74,7 +75,10 @@
 	if (boot_rom_boot_flow_is_secondary_manifest_valid())
 		boot_rom_boot_flow_prefetch_img(HL_FW_IMG_PPBOOT);
 
-	boot_rom_init_boot_info();
+	if (boot_rom_boot_flow_is_ppboot_valid(BOOT_ROM_PRIMARY)) {
+		boot_rom_boot_flow_boot_ppboot_sub(BOOT_ROM_PRIMARY);
+		boot_rom_halt();
+	}
 
 	return 0;
 }
diff --git a/common/boot_flow.c b/common/boot_flow.c
index 97cc8af..2e8a2cb 100644
--- a/common/boot_flow.c
+++ b/common/boot_flow.c
@@ -11,6 +11,7 @@
 #include <dma.h>
 #include <common.h>
 #include <recovery.h>
+#include <boot_flow.h>
 
 /* These fields will be added to proper structure later */
 static enum hl_fw_manifest_type primary_manifest_idx = HL_FW_SPI_MANIFEST_0;
@@ -115,6 +116,42 @@
 	boot_rom_halt();
 }
 
+void boot_rom_boot_flow_boot_ppboot_sub(enum boot_rom_manifests man_type)
+{
+	void (*ppboot)();
+	struct boot_desc desc = {0};
+	enum hl_fw_manifest_type man_idx = primary_manifest_idx;
+
+	if (man_type == BOOT_ROM_SECONDARY) {
+		man_idx = (primary_manifest_idx + 1) % HL_FW_SPI_MANIFEST_MAX_NUM;
+	}
+
+	if (!boot_rom_boot_flow_is_manifest_valid(man_type))
+		return;
+
+	if (boot_desc_get_img_desc(man_idx, HL_FW_IMG_PPBOOT, &desc) != BOOT_ROM_SUCCESS)
+		return;
+
+	/* TODO: MemCopy to PSOC FW SRAM if required */
+
+	/* TODO: Set validation pass and set manifest idx in global */
+
+	/* TODO: Set other manifest as invalid */
+
+	boot_rom_init_boot_info();
+
+	/* TODO: TPM PCR extend */
+
+	/* TODO: Clear recovery status */
+
+	if (desc.start_addr) {
+		/* TODO: Start CPLD watchdog timer */
+		/* TODO: Report security image fw version */
+		ppboot = (void *)((uint32_t)boot_rom_get_arc_addr(desc.start_addr));
+		ppboot();
+	}
+}
+
 static uint32_t boot_rom_verify_manifest(__unused enum hl_fw_manifest_type manifest_idx)
 { return BOOT_ROM_SUCCESS; }
 void boot_rom_boot_flow_validate_manifests(void)
@@ -159,3 +196,9 @@
 	 */
 
 }
+
+bool boot_rom_boot_flow_is_ppboot_valid(__unused enum boot_rom_manifests rom_manifest_type)
+{
+	/* Validate ppboot sha */
+	return true;
+}
diff --git a/common/boot_flow.h b/common/boot_flow.h
index 338f502..da5de0c 100644
--- a/common/boot_flow.h
+++ b/common/boot_flow.h
@@ -8,8 +8,10 @@
 
 uint32_t boot_rom_boot_flow_prefetch_img(enum hl_fw_img_type img_type);
 void boot_rom_boot_flow_boot_ppboot(enum hl_fw_manifest_type man_idx);
+void boot_rom_boot_flow_boot_ppboot_sub(enum boot_rom_manifests man_type);
 void boot_rom_boot_flow_validate_manifests(void);
 bool boot_rom_boot_flow_is_manifest_valid(enum boot_rom_manifests rom_manifest_type);
+bool boot_rom_boot_flow_is_ppboot_valid(enum boot_rom_manifests rom_manifest_type);
 bool boot_rom_boot_flow_is_secondary_manifest_valid(void);
 void boot_rom_boot_flow_wait_for_dma_finish(void);
 
