+ */
+
+#ifndef COMMON_FIT_RSA_H_
+#define COMMON_FIT_RSA_H_
+
+struct rsa_key_prop {
+	const void *rr;			/* R^2 can be treated as byte array */
+	const void *modulus;		/* modulus as byte array */
+	const u64 *public_exponent;	/* public exponent as byte array */
+	u32 n0inv;			/* -1 / modulus[0] mod 2^32 */
+	int num_bits;			/* Key length in bits */
+};
+
+
+int rsa_verify(const u8 *data, int data_len,
+	       const u8 *sig, u32 sig_len, struct rsa_key_prop *prop);
+
+#endif /* COMMON_FIT_RSA_H_ */
diff --git a/preboot/module_fwupd.c b/preboot/module_fwupd.c
new file mode 100644
index 0000000..9506d8f
--- /dev/null
+++ b/preboot/module_fwupd.c
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2016-2020 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <psoc_global_conf_regs.h>
+#include <hl_fw_if.h>
+#include <preboot.h>
+
+#include "cmd_module.h"
+#include "uart.h"
+
+void module_fwupd_setup(void)
+{
+	struct hl_upd_status status  = { .val = 0 };
+
+	status.status = HL_UPD_STS_RST_OK;
+	regmap_writel(status.val, mmUPD_STS);
+}
+
+enum cmd_check_res module_fwupd_check(void)
+{
+	if (regmap_readl(mmUPD_CMD) != HL_UPD_NOOP)
+		return FOUND_FAST_RETURN;
+
+	return NOT_FOUND;
+}
+
+void module_fwupd_run(void)
+{
+	struct hl_upd_command cmd;
+
+	cmd.val = regmap_readl(mmUPD_CMD);
+	switch (cmd.cmd) {
+	case HL_UPD_CLR_STS:
+		regmap_writel(HL_UPD_STS_NOOP, mmUPD_STS);
+		preboot_puts("FW UPD CLR STS received\n");
+		break;
+	default:
+		break;
+	}
+}
diff --git a/preboot/module_i2c_slave.c b/preboot/module_i2c_slave.c
new file mode 100644
index 0000000..19ad37c
--- /dev/null
+++ b/preboot/module_i2c_slave.c
@@ -0,0 +1,245 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2017-2020 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <stddef.h>
+#include <psoc_global_conf_regs.h>
+#include <psoc_i2c_s_regs.h>
+#include <psoc_i2c_s_masks.h>
+#include <hl_fw_if.h>
+#include <pcie_dbi_regs.h>
+#include <preboot.h>
+#include <thermal.h>
+
+#include "cmd_module.h"
+#include "uart.h"
+#include "common.h"
+
+#define HL_DEVICE_STATUS_LINUX		0x0
+#define HL_DEVICE_STATUS_PREBOOT	0x1
+
+#define HL_DEVICE_STATUS_CMD_CODE_LEN		0x1
+#define HL_PCIE_VENDOR_ID_CMD_CODE_LEN		0x16
+
+static unsigned int cmd;
+static unsigned int read_bytes_count;
+
+enum preboot_i2c_slave_event_id {
+	HL_ASIC_TEMP_CMD_CODE = 0,
+	HL_ASIC_TEMP_MAX_VAL = 3,
+	HL_PCIE_VENDOR_ID_VAL_LOW = 9,
+	HL_PCIE_VENDOR_ID_VAL_HIGH = 10,
+	HL_DEVICE_STATUS_CMD_CODE = 165,
+	HL_DEVICE_STATUS = 166,
+};
+
+static void hl_i2c_slave_init(void)
+{
+	/* Check if already enabled */
+	if (regmap_readl(mmPSOC_I2C_S_IC_ENABLE)) {
+		preboot_puts("I2C SLAVE already initialized\n");
+		return;
+	}
+
+	/* Program IC_SAR with address to which slave responds */
+	regmap_writel(I2C_SLAVE_ADDRESS, mmPSOC_I2C_S_IC_SAR);
+
+	/* Enable I2C Slave */
+	regmap_writel(0x1, mmPSOC_GLOBAL_CONF_I2C_SLV);
+
+	/* Enable I2C Slave interrupts */
+	regmap_writel(0x0, mmPSOC_GLOBAL_CONF_I2C_SLV_INTR_MASK);
+
+	/* Program IC_CON */
+	regmap_writel(0x22, mmPSOC_I2C_S_IC_CON);
+
+	/* Write to IC_INTR_MASK to enable all interrupts */
+	regmap_writel(0x7FFF, mmPSOC_I2C_S_IC_INTR_MASK);
+
+	/* Write to IC_RX_TL to set Rx FIFO threshold level */
+	regmap_writel(0x0, mmPSOC_I2C_S_IC_RX_TL);
+
+	/* Write to IC_TX_TL to set Tx FIFO threshold level */
+	regmap_writel(0x7, mmPSOC_I2C_S_IC_TX_TL);
+
+	/* Write 1 to IC_ENABLE to enable DW_apb_i2c */
+	regmap_writel(0x1, mmPSOC_I2C_S_IC_ENABLE);
+
+	preboot_puts("I2C SLAVE initialized\n");
+}
+
+static u32 i2c_dw_read_clear_intrbits_slave(void)
+{
+	u32 stat;
+
+	/*
+	 * The IC_INTR_STAT register just indicates "enabled" interrupts.
+	 * Ths unmasked raw version of interrupt status bits are available
+	 * in the IC_RAW_INTR_STAT register.
+	 *
+	 * That is,
+	 *   stat = regmap_readl(IC_INTR_STAT);
+	 * equals to,
+	 *   stat = regmap_readl(IC_RAW_INTR_STAT) & regmap_readl(IC_INTR_MASK);
+	 *
+	 * The raw version might be useful for debugging purposes.
+	 */
+	stat = regmap_readl(mmPSOC_I2C_S_IC_INTR_STAT);
+
+	/*
+	 * Do not use the IC_CLR_INTR register to clear interrupts, or
+	 * you'll miss some interrupts, triggered during the period from
+	 * regmap_readl(IC_INTR_STAT) to regmap_readl(IC_CLR_INTR).
+	 *
+	 * Instead, use the separately-prepared IC_CLR_* registers.
+	 */
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_TX_ABRT_MASK)
+		regmap_readl(mmPSOC_I2C_S_IC_CLR_TX_ABRT);
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_RX_UNDER_MASK)
+		regmap_readl(mmPSOC_I2C_S_IC_CLR_RX_UNDER);
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_RX_OVER_MASK)
+		regmap_readl(mmPSOC_I2C_S_IC_CLR_RX_OVER);
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_TX_OVER_MASK)
+		regmap_readl(mmPSOC_I2C_S_IC_CLR_TX_OVER);
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_RX_DONE_MASK)
+		regmap_readl(mmPSOC_I2C_S_IC_CLR_RX_DONE);
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_ACTIVITY_MASK)
+		regmap_readl(mmPSOC_I2C_S_IC_CLR_ACTIVITY);
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_STOP_DET_MASK)
+		regmap_readl(mmPSOC_I2C_S_IC_CLR_STOP_DET);
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_START_DET_MASK)
+		regmap_readl(mmPSOC_I2C_S_IC_CLR_START_DET);
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_GEN_CALL_MASK)
+		regmap_readl(mmPSOC_I2C_S_IC_CLR_GEN_CALL);
+
+	return stat;
+}
+
+void module_i2c_s_setup(void)
+{
+	hl_i2c_slave_init();
+}
+
+enum cmd_check_res module_i2c_s_check(void)
+{
+	enum cmd_check_res res = NOT_FOUND;
+	unsigned int stat;
+
+	i2c_dw_read_clear_intrbits_slave();
+	stat = regmap_readl(mmPSOC_I2C_S_IC_INTR_STAT);
+
+	if ((stat & PSOC_I2C_S_IC_INTR_STAT_R_RD_REQ_MASK) ||
+	    (stat & PSOC_I2C_S_IC_INTR_STAT_R_RX_FULL_MASK)) {
+		preboot_puts("I2C SLAVE: read request received\n");
+		res = FOUND_FAST_RETURN;
+	}
+
+	return res;
+}
+
+void module_i2c_s_disable(void)
+{
+	unsigned int stat;
+
+	stat = regmap_readl(mmPSOC_I2C_S_IC_INTR_STAT);
+
+	/* Clear requests before disabling */
+	if (stat & (PSOC_I2C_S_IC_INTR_STAT_R_RD_REQ_MASK |
+		    PSOC_I2C_S_IC_INTR_STAT_R_RX_FULL_MASK))
+		module_i2c_s_run_fast();
+
+	regmap_writel(0x0, mmPSOC_I2C_S_IC_ENABLE);
+
+	stat = regmap_readl(mmPSOC_I2C_S_IC_INTR_STAT);
+
+	/* Make sure all requests are handled after disable */
+	if (stat & (PSOC_I2C_S_IC_INTR_STAT_R_RD_REQ_MASK |
+		    PSOC_I2C_S_IC_INTR_STAT_R_RX_FULL_MASK))
+		module_i2c_s_run_fast();
+
+	preboot_puts("I2C SLAVE: disabled\n");
+}
+
+static char i2cslave_pcie_vendor_id_cmd(int command_idx, int bytes_count)
+{
+	char ret;
+	unsigned int data = regmap_readl(mmPCIE_DBI_DEVICE_ID_VENDOR_ID_REG);
+
+	switch (command_idx + bytes_count) {
+	case HL_PCIE_VENDOR_ID_VAL_LOW:
+		data &= 0xFFFF;
+		ret = (data & 0xFF00) >> 8;
+		break;
+	case HL_PCIE_VENDOR_ID_VAL_HIGH:
+		data &= 0xFFFF;
+		ret = data & 0xFF;
+		break;
+	default:
+		ret = 0;
+		break;
+	}
+
+	return ret;
+}
+
+static int i2cslave_handle_read_req(void)
+{
+	int max_tmp, ret;
+
+	switch (cmd) {
+	case HL_ASIC_TEMP_CMD_CODE:
+	case HL_ASIC_TEMP_MAX_VAL:
+		max_tmp = hl_ts_get_max_temp();
+		/* Convert from mC to C */
+		ret = max_tmp / 1000;
+		break;
+	case HL_DEVICE_STATUS_CMD_CODE:
+		ret = HL_DEVICE_STATUS_CMD_CODE_LEN;
+		break;
+	case HL_DEVICE_STATUS:
+		ret = HL_DEVICE_STATUS_PREBOOT;
+		break;
+	case HL_PCIE_VENDOR_ID_VAL_LOW:
+	case HL_PCIE_VENDOR_ID_VAL_HIGH:
+		ret = i2cslave_pcie_vendor_id_cmd(cmd, read_bytes_count);
+		break;
+	default:
+		/* NA */
+		ret = 0;
+		break;
+	}
+
+	return ret;
+}
+
+void module_i2c_s_run_fast(void)
+{
+	unsigned int stat;
+	int ret;
+
+	stat = regmap_readl(mmPSOC_I2C_S_IC_INTR_STAT);
+
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_RD_REQ_MASK) {
+		if (stat & PSOC_I2C_S_IC_INTR_STAT_R_RX_FULL_MASK) {
+			read_bytes_count = 0;
+
+			cmd = regmap_readl(mmPSOC_I2C_S_IC_DATA_CMD);
+
+			/* clear read request */
+			regmap_readl(mmPSOC_I2C_S_IC_CLR_RD_REQ);
+			stat = i2c_dw_read_clear_intrbits_slave();
+		} else {
+			regmap_readl(mmPSOC_I2C_S_IC_CLR_RD_REQ);
+			regmap_readl(mmPSOC_I2C_S_IC_CLR_RX_UNDER);
+			stat = i2c_dw_read_clear_intrbits_slave();
+		}
+
+		ret = i2cslave_handle_read_req();
+		read_bytes_count++;
+		regmap_writel(ret, mmPSOC_I2C_S_IC_DATA_CMD);
+		preboot_puts("I2C SLAVE: read request processed");
+	}
+}
diff --git a/preboot/module_lkd.c b/preboot/module_lkd.c
new file mode 100644
index 0000000..f067ad0
--- /dev/null
+++ b/preboot/module_lkd.c
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2016-2020 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <hl_boot_if.h>
+#include <preboot.h>
+
+#include "cmd_module.h"
+#include "uart.h"
+#include "boot_if.h"
+#include "fit.h"
+
+struct lkd_status {
+	int fit_not_checked;	/* negative logic */
+	u32 msg_reg_val;
+	u64 loadaddr;
+};
+
+static struct lkd_status sts = {
+	.fit_not_checked = 1,
+};
+
+void module_lkd_setup(void)
+{
+	cpu_boot_sts_set(CPU_BOOT_STATUS_WAITING_FOR_BOOT_FIT);
+}
+
+enum cmd_check_res module_lkd_check(void)
+{
+	enum cmd_check_res res;
+
+	/* we already have the FIT and it is good */
+	if (sts.fit_not_checked != 1)
+		return FOUND_NO_RETURN;
+
+	sts.msg_reg_val = cpu_boot_cmd_get();
+	switch (sts.msg_reg_val) {
+	case KMD_MSG_GOTO_WFE:
+		res = FOUND_NO_RETURN;
+		/* WFE - we should clear the message/cmd register */
+		cpu_boot_cmd_clr_before_wfe();
+		cpu_boot_rsp_set(CPU_MSG_OK);
+		preboot_puts("LKD WFE received\n");
+		break;
+	case KMD_MSG_FIT_RDY:
+		res = FOUND_SLOW_RETURN;
+		/* Tell LKD we got the message */
+		cpu_boot_rsp_set(CPU_MSG_OK);
+		preboot_puts("LKD FIT RDY received\n");
+		break;
+	case KMD_MSG_SKIP_BMC:
+		cpu_boot_rsp_set(CPU_MSG_ERR);
+		preboot_puts("LKD SKIP BMC received\n");
+		/* no break */
+	default:
+		res = NOT_FOUND;
+	}
+
+	return res;
+}
+
+void module_lkd_disable(void)
+{
+	cpu_boot_sts_set(CPU_BOOT_STATUS_IN_PREBOOT);
+}
+
+void module_lkd_run(void)
+{
+	int err;
+	void *fit = (void *)FIT_IMG_BASE;
+
+	err = !fit_check_format(fit);
+	if (!err)
+		err = fit_load_image(fit, &sts.loadaddr);
+
+	if (err) {/* Report the FIT is bad */
+		cpu_boot_err_clrset(CPU_BOOT_ERR0_FIT_CORRUPTED, true);
+		preboot_puts("FIT loading failed, Retrying...\n");
+		return;
+	}
+
+	sts.fit_not_checked = 0;
+	/* Report the FIT is good */
+	cpu_boot_err_clrset(CPU_BOOT_ERR0_FIT_CORRUPTED, false);
+}
+
+void module_lkd_run_noret(void)
+{
+	switch (sts.msg_reg_val) {
+	case KMD_MSG_GOTO_WFE:
+		cpu_boot_sts_set(CPU_BOOT_STATUS_IN_WFE);
+		wfe();
+		break;
+	case KMD_MSG_FIT_RDY:
+		image_start(sts.loadaddr);
+		/* no break */
+	default:
+		break;
+	}
+}
diff --git a/preboot/module_pci.c b/preboot/module_pci.c
new file mode 100644
index 0000000..688bbc2
--- /dev/null
+++ b/preboot/module_pci.c
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2016-2020 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <pcie_aux_regs.h>
+#include <pcie_core_regs.h>
+
+#include <preboot.h>
+
+#include "cmd_module.h"
+#include "uart.h"
+
+struct pci_status {
+	u32 flr_reg_val;
+	u32 hot_rst_reg_val;
+};
+
+static struct pci_status pci_sts = {
+	.flr_reg_val = ~1,
+	.hot_rst_reg_val = ~1,
+};
+
+__attribute__((weak)) void pci_dev_specific_setup(void) {}
+
+void module_pci_setup(void)
+{
+	pci_dev_specific_setup();
+}
+
+__attribute__((weak)) enum cmd_check_res dev_specific_module_pci_check(void)
+{
+	pci_sts.flr_reg_val = regmap_readl(mmPCIE_AUX_FLR_INT);
+	pci_sts.hot_rst_reg_val = regmap_readl(mmPCIE_CORE_HOT_RST) & BIT(0);
+
+	if (pci_sts.flr_reg_val == 1 || pci_sts.hot_rst_reg_val == 1)
+		return FOUND_FAST_RETURN;
+
+	return NOT_FOUND;
+}
+
+enum cmd_check_res module_pci_check(void)
+{
+	return dev_specific_module_pci_check();
+}
+
+void module_pci_run(void)
+{
+	if (pci_sts.flr_reg_val == 1) {
+		regmap_writel(1, mmPCIE_AUX_PF_FLR_ACTIVE);
+		regmap_writel(1, mmPCIE_AUX_FLR_INT);
+		regmap_writel(1, mmPCIE_AUX_PF_FLR_DONE);
+		preboot_puts("FLR received\n");
+	}
+
+	if (pci_sts.hot_rst_reg_val == 1) {
+		regmap_writel(0x10, mmPCIE_CORE_HOT_RST);
+		regmap_writel(1, mmPCIE_AUX_LTSSM_EN);
+		preboot_puts("HOT RST received\n");
+	}
+}
