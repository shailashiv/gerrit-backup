-
-static struct cmd_module_ops cmd_ops[] = {
-	{	/* PCI module */
-		.setup = module_pci_setup,
-		.check = module_pci_check,
-		.disable = noop,
-		.run = noop,
-		.enable = noop,
-		.run_fast = module_pci_run,
-		.teardown = noop,
-		.run_noreturn = noop,
-	},
-	{	/* FW UPD module */
-		.setup = module_fwupd_setup,
-		.check = module_fwupd_check,
-		.disable = noop,
-		.run = noop,
-		.enable = noop,
-		.run_fast = module_fwupd_run,
-		.teardown = noop,
-		.run_noreturn = noop,
-	},
-	{	/* LKD module */
-		.setup = module_lkd_setup,
-		.check = module_lkd_check,
-		.disable = module_lkd_disable,
-		.run = module_lkd_run,
-		.enable = module_lkd_setup,
-		.run_fast = noop,
-		.teardown = module_lkd_disable,
-		.run_noreturn = module_lkd_run_noret,
-	},
-	{	/* UART module */
-		.setup = noop,
-		.check = module_uart_check,
-		.disable = noop,
-		.run = noop,
-		.enable = noop,
-		.run_fast = module_uart_run,
-		.teardown = noop,
-		.run_noreturn = noop,
-	},
-	{	/* I2C SLAVE module */
-		.setup = module_i2c_s_setup,
-		.check = module_i2c_s_check,
-		.disable = module_i2c_s_disable,
-		.run = noop,
-		.enable = module_i2c_s_setup,
-		.run_fast = module_i2c_s_run_fast,
-		.teardown = module_i2c_s_disable,
-		.run_noreturn = noop,
-	},
-};
-
-static void preboot_handle_cmds(void)
-{
-	int i = 0, j = 0, size = ARRAY_SIZE(cmd_ops);
-	enum cmd_check_res res = NOT_FOUND;
-
-	for (j = 0; j < size; j++)
-		cmd_ops[j].setup();
-
-	preboot_puts("Waiting for commands...\n");
-	i = 0;
-	while (1) {
-		res = cmd_ops[i].check();
-		switch (res) {
-		case NOT_FOUND:
-			break;
-		case FOUND_FAST_RETURN:
-			cmd_ops[i].run_fast();
-			break;
-		case FOUND_SLOW_RETURN:
-			for (j = 0; j < size; j++)
-				if (i != j)
-					cmd_ops[j].disable();
-
-			cmd_ops[i].run();
-			for (j = 0; j < size; j++)
-				if (i != j)
-					cmd_ops[j].enable();
-
-			break;
-		case FOUND_NO_RETURN:
-			for (j = 0; j < size; j++)
-				if (i != j)
-					cmd_ops[j].teardown();
-
-			cmd_ops[i].run_noreturn();
-			break;
-		default:
-			break;
-		}
-
-		if (++i == size)
-			i = 0;
-	}
-}
-
-static const char *preboot_ver_str = "Preboot " VERSION_STR;
-static char preboot_btl_ver_str[VERSION_MAX_LEN] = "BTL version ";
-
-static void preboot_version(void)
-{
-	unsigned long offset = (unsigned long) preboot_btl_ver_str;
-	u32 btlver = regmap_readl(mmPREBOOT_VER_OFFSET);
-	int i, btl_ver_sz;
-
-	preboot_puts("\n");
-	preboot_puts_raw(preboot_btl_ver_str);
-	preboot_puth(btlver, true);
-	preboot_puts_raw(preboot_ver_str);
-	preboot_puts("\n");
-
-	/* get to the end of the predefined btl string */
-	for (i = 0; i < VERSION_MAX_LEN; i++)
-		if (preboot_btl_ver_str[i] == '\0')
-			break;
-
-	/* convert and copy the btl version */
-	i += preboot_uint2hexstring(&preboot_btl_ver_str[i], btlver, true);
-
-	/* separate the btl from preboot */
-	preboot_btl_ver_str[i++] = '\n';
-	btl_ver_sz = i;
-
-	/* copy the preboot version */
-	for (int j = 0; j < VERSION_MAX_LEN - btl_ver_sz - 1; j++) {
-		preboot_btl_ver_str[i++] = preboot_ver_str[j];
-		if (preboot_ver_str[j] == '\0')
-			break;
-	}
-
-	regmap_writel((u32)(offset & ~SDRAM_BASE), mmPREBOOT_VER_OFFSET);
-}
-
-void preboot_main(void)
-{
-	cpu_boot_sts_set(CPU_BOOT_STATUS_IN_PREBOOT);
-	/* Enable the errors communication */
-	cpu_boot_err_clrset(CPU_BOOT_ERR0_ENABLED, true);
-
-	/*
-	 * Note: we assume CPU frequency is not changed while CPU is running,
-	 * so the udelay init is done once before we start.
-	 */
-	udelay_init();
-
-	hl_uart_init();
-	hl_ts_init();
-	preboot_version();
-	preboot_handle_cmds();
-}
diff --git a/common/boot_if.c b/common/boot_if.c
deleted file mode 100644
index 6d848ace..0000000
--- a/common/boot_if.c
+++ /dev/null
@@ -1,52 +0,0 @@
-// SPDX-License-Identifier: GPL-2.0+
-/*
- * Copyright 2016-2020 HabanaLabs, Ltd.
- * All Rights Reserved.
- */
-
-#include <stdbool.h>
-
-#include <psoc_global_conf_regs.h>
-
-#include <hl_boot_if.h>
-#include <preboot.h>
-
-/*
- * The cpu_boot_cmd_clr_before_wfe() function should NOT be used in general as
- * the LKD message register should be written by LKD solely.
- *
- * There is only one special case when this function can be used is only when
- * the LKD performs hard reset, which may mean the H/W is not reliable and
- * writing to PCI might not complete and result in the register not cleared.
- * So to be on the safe side, when receiving the WFE, clear the message register
- */
-void cpu_boot_cmd_clr_before_wfe(void)
-{
-	regmap_writel(KMD_MSG_NA, mmPSOC_GLOBAL_CONF_KMD_MSG_TO_CPU);
-}
-
-enum kmd_msg cpu_boot_cmd_get(void)
-{
-	return regmap_readl(mmPSOC_GLOBAL_CONF_KMD_MSG_TO_CPU);
-}
-
-void cpu_boot_sts_set(u32 val)
-{
-	regmap_writel(val, mmPSOC_GLOBAL_CONF_CPU_BOOT_STATUS);
-}
-
-/* We support only ERR0 for now */
-void cpu_boot_err_clrset(u32 mask, bool set)
-{
-	u32 val = regmap_readl(mmCPU_BOOT_ERR0) & ~mask;
-
-	if (set)
-		val |= mask;
-
-	regmap_writel(val, mmCPU_BOOT_ERR0);
-}
-
-void cpu_boot_rsp_set(enum cpu_msg_status sts)
-{
-	regmap_writel(sts, mmCPU_CMD_STATUS_TO_HOST);
-}
