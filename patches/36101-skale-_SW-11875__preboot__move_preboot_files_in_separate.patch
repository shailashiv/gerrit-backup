From 71bc43410663d3c25376d6c017cea48c7ba0d945 Mon Sep 17 00:00:00 2001
From: Sanyog Kale <skale@habana.ai>
Date: Sun, 31 May 2020 10:53:00 +0300
Subject: [PATCH] [SW-11875] preboot: move preboot files in separate directory

This patch adds changes to move files used only by preboot to preboot
directory.

The idea here to compile preboot only with the files preboot binary
uses. In order to achieve that, files in common folders are segregated
where files used by preboot only are moved to preboot folder and files
used by both preboot and ppboot are kept in common folder. This helps
to add single entries in Makefile instead of individual files. Along
with this, preboot files under app folder are also moved in preboot
directory.

Makefile changes are done to accommodate above changes. Also
change is made to copy all binaries in bin directory.

Change-Id: I30238c13ea9e5b525aa5faae0e4a890d24fa909c
---

diff --git a/Makefile b/Makefile
index e8678fa..e83054e 100644
--- a/Makefile
+++ b/Makefile
@@ -28,31 +28,35 @@
 
 include $(HL_DEV)/Makefile
 
+PREBOOT_SRCS_C += $(shell ls preboot/*.c)
 PREBOOT_SRCS_C += $(shell ls $(HL_DEV)/common.c)
 PREBOOT_SRCS_C += $(shell ls $(HL_DEV)/$(HL_TARGET).c)
-PREBOOT_APP_S := $(shell ls app/crt0_preboot.S)
-PREBOOT_APP_C := $(shell ls app/preboot.c)
+PREBOOT_APP_S := $(shell ls preboot/crt0_preboot.S)
 PPBOOT_APP_S := $(shell ls app/crt0_ppboot.S)
 PPBOOT_APP_C := $(shell ls app/ppboot.c)
 
 PREBOOT_OBJECTS := $(PREBOOT_SRCS_C:.c=.o)
 PREBOOT_OBJECTS += $(PREBOOT_APP_S:.S=.o)
-PREBOOT_OBJECTS += $(PREBOOT_APP_C:.c=.o)
 PPBOOT_OBJECTS := $(PREBOOT_SRCS_C:.c=.o)
 PPBOOT_OBJECTS += $(PPBOOT_APP_S:.S=.o)
 PPBOOT_OBJECTS += $(PPBOOT_APP_C:.c=.o)
 AUTO_GENERATED_FILE := auto_generated.h
 
-all: ppboot.bin preboot.bin pcie_phy_fw.bin buildversion-habanalabs
+BINDIR = bin
+PPBOOT_TARGET = $(BINDIR)/ppboot.bin
+PREBOOT_TARGET = $(BINDIR)/preboot.bin
+PCI_PHY_FW_TARGET = $(BINDIR)/pcie_phy_fw.bin
 
-%.bin: %
-	$(OBJCOPY) -O binary -R .note.gnu.build-id $< $@
+all: bin $(PPBOOT_TARGET) $(PREBOOT_TARGET) $(PCI_PHY_FW_TARGET) buildversion-habanalabs
+
+$(BINDIR)/%.bin: %
+	$(OBJCOPY) -O binary -R .note.gnu.build-id $(BINDIR)/$< $@
 
 preboot: $(PREBOOT_OBJECTS) $(PREBOOT_LD_SCRIPT)
-	@$(CC) $(LDFLAGS) -T $(PREBOOT_LD_SCRIPT) -o $@ -Wl,--start-group $(PREBOOT_OBJECTS) $(PREBOOT_LDLIBS) -Wl,--end-group
+	@$(CC) $(LDFLAGS) -T $(PREBOOT_LD_SCRIPT) -o $(BINDIR)/$@ -Wl,--start-group $(PREBOOT_OBJECTS) $(PREBOOT_LDLIBS) -Wl,--end-group
 
 ppboot: $(PPBOOT_OBJECTS) $(PPBOOT_LD_SCRIPT)
-	@$(CC) $(LDFLAGS) -T $(PPBOOT_LD_SCRIPT) -o $@ -Wl,--start-group $(PPBOOT_OBJECTS) $(LDLIBS) -Wl,--end-group
+	@$(CC) $(LDFLAGS) -T $(PPBOOT_LD_SCRIPT) -o $(BINDIR)/$@ -Wl,--start-group $(PPBOOT_OBJECTS) $(LDLIBS) -Wl,--end-group
 
 $(AUTO_GENERATED_FILE): localversion-habanalabs $(PREBOOT_SRCS_C) $(PREBOOT_SRCS_S)
 	@( printf '#define PREBOOT_VER "%s"\n' '$(shell cut -d- -f2- localversion-habanalabs)' ) > $@
@@ -62,12 +66,15 @@
 buildversion-habanalabs: include/preboot.h $(AUTO_GENERATED_FILE)
 	echo "VERSION_STR" | gcc -include $< $(CFLAGS) -P -E -o - - | tail -1 | sed 's/\" \+\"//g;s/["\n]//g' | cut -d' ' -f2- | tr -d '\n' > $@
 
-pcie_phy_fw.bin: $(HL_DEV)/pcie_phy_fw.i
+$(PCI_PHY_FW_TARGET): $(HL_DEV)/pcie_phy_fw.i
 	@cut -d' ' -f2- $< | xxd -r -p | dd status=none bs=16 count=$$(($(FW_SIZE) / 16)) conv=sync,swab of=$@
 
 $(HL_DEV)/pcie_phy_fw.i: $(HL_DEV)/pcie_phy_fw.hex
 	@$(CC) -x c -E -P -nostdinc -o $@ $<
 
+bin:
+	@mkdir -p $@
+
 %.lds: %.lds.S
 	@$(CC) $(SFLAGS) -E -P -nostdinc -o $@ $<
 
