deleted file mode 100644
index f2608b1..0000000
--- a/app/crt0_preboot.S
+++ /dev/null
@@ -1,46 +0,0 @@
-/*
- * (C) Copyright 2017 HabanaLabs, Ltd.
- * Noam Camus <noamikong@gmail.com>
- *
- * SPDX-License-Identifier:     GPL-2.0+
- */
-
-/*
- * This is preboot entry point
- * Setting sp/fp/lr and jumping to C code
- */
-.globl	_start
-_start:
-
-#ifdef __arc__
-/* lf2flt: to avoid compiler (buildroot wrapper) warning during linkage */
-.global	lf2flt
-lf2flt:
-
-	mov	sp, __stack_top
-	mov	fp, sp
-
-/* Clear BSS */
-	mov	r5, __bss_start
-	sub	r6, __bss_end, r5
-	lsr.f	lp_count, r6, 2
-	lpnz	1f
-	st.ab   0, [r5, 4]
-1:
-#endif
-
-#ifdef __aarch64__
-	ldr	x0, =__stack_top
-	bic	sp, x0, #0xf	/* 16-byte alignment for ABI compliance */
-	mov	x29, sp		/* Set FP (x29) */
-
-/* Clear BSS */
-	ldr	x0, =__bss_start
-	ldr	x1, =__bss_end
-clear_loop:
-	str	xzr, [x0], #8
-	cmp	x0, x1
-	b.lo	clear_loop
-#endif
-
-	bl	preboot_main	/* Set LR (x30) */
