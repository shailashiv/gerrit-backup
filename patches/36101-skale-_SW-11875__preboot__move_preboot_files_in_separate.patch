deleted file mode 100644
index ff9b443..0000000
--- a/app/preboot.c
+++ /dev/null
@@ -1,173 +0,0 @@
-// SPDX-License-Identifier: GPL-2.0+
-/*
- * (C) Copyright 2017-2020 HabanaLabs, Ltd.
- * All rights reserved.
- *
- */
-
-#include <stddef.h>
