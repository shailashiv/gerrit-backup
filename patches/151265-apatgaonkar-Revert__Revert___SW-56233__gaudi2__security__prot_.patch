From 6b2bfbcfa428a01347220475edb536af051c69f1 Mon Sep 17 00:00:00 2001
From: Abhishek <apatgaonkar@habana.ai>
Date: Mon, 29 Nov 2021 06:23:14 +0200
Subject: [PATCH] Revert "Revert "[SW-56233] gaudi2: security: prot bits init update""

This reverts commit b3e8b86a3c463753ca38e6bcc98a6083f9bdfca6.

Change-Id: I6077f1985c3ae4eed86d6d58fb4a390f476521ef
---

diff --git a/arch/gaudi2/common/security.c b/arch/gaudi2/common/security.c
index 6dfa14f..5dd97c9 100644
--- a/arch/gaudi2/common/security.c
+++ b/arch/gaudi2/common/security.c
@@ -383,9 +383,9 @@
 		 mmPSOC_ARC1_MSTR_IF_CORE_LBW_AXPROT_OVRD);
 }
 
-static int init_prot_bits_block(u8 major, u8 minor, u8 sub_minor)
+static int init_prot_bits_block(u32 index, u8 major, u8 minor, u8 sub_minor)
 {
-	struct hl_prot_bits_cfg *cfg = &gaudi2_prot_bits_cfg[0];
+	struct hl_prot_bits_cfg *cfg = &gaudi2_prot_bits_cfg[index];
 	u8 b_idx = 0, d_idx = 0;
 	u32 val;
 	u32 addr, reg_addr;
@@ -419,19 +419,23 @@
 
 static void hl_dev_prot_bits_init(void)
 {
-	u8 major_idx, minor_idx, sub_minor_idx;
+	u8 major_idx, minor_idx, sub_minor_idx, cfg_idx;
 	struct hl_prot_bits_addr block_addr;
+	u32 conf_sz = ARRAY_SIZE(gaudi2_prot_bits_cfg);
 
-	block_addr = gaudi2_prot_bits_cfg[0].addr;
-	for (major_idx = 0; major_idx < block_addr.major; major_idx++) {
-		minor_idx = 0;
-		do {
-			sub_minor_idx = 0;
+	for (cfg_idx = 0; cfg_idx < conf_sz; cfg_idx++) {
+		block_addr = gaudi2_prot_bits_cfg[cfg_idx].addr;
+		for (major_idx = 0; major_idx < block_addr.major; major_idx++) {
+			minor_idx = 0;
 			do {
-				init_prot_bits_block(major_idx, minor_idx, sub_minor_idx);
-			} while (sub_minor_idx < block_addr.sub_minor);
-			minor_idx++;
-		} while (minor_idx < block_addr.minor);
+				sub_minor_idx = 0;
+				do {
+					init_prot_bits_block(cfg_idx, major_idx, minor_idx,
+							     sub_minor_idx);
+				} while (sub_minor_idx < block_addr.sub_minor);
+				minor_idx++;
+			} while (minor_idx < block_addr.minor);
+		}
 	}
 
 	preboot_puts("gaudi2 protection bits configured\n");
