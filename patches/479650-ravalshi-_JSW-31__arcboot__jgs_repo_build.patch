@@ -0,0 +1,48 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2024 HabanaLabs Ltd.
+ * All Rights Reserved.
+ */
+
+#include <boot_rom.h>
+#include <jgs_efuse.h>
+#include "dev_uart.h"
+#include <common.h>
+#include <tpm.h>
+
+#define ONIX_REF_CLK		35000000ULL
+#define ONIX_UART_BAUDRATE	57600
+
+uint32_t boot_rom_get_baudrate()
+{
+	return ONIX_UART_BAUDRATE;
+}
+
+uint32_t boot_rom_pll_get_freq(__unused enum boot_rom_pll_div div)
+{
+	return ONIX_REF_CLK;
+}
+
+bool fuse_valid_volt_prot_pattern(__unused uint32_t config_fuse)
+{
+	return true;
+}
+
+uint32_t boot_rom_tpm_spi_baudr_get(void)
+{
+	enum boot_rom_tpm_spi_freq_config freq_config;
+	uint32_t baudr;
+
+	freq_config = boot_rom_get_tpm_spi_freq_config();
+
+	if (freq_config == FREQ_CFG_12_5MHZ)
+		baudr = (ONIX_REF_CLK / SPI_TPM_FREQ_12_5M);
+	else
+		baudr = (ONIX_REF_CLK / SPI_TPM_FREQ_6_25M);
+
+	/* baud rate doesn't support odd number and must not be 0 */
+	baudr = (baudr < 2) ? 2 : baudr;
+	baudr = (baudr + 1) & 0xFFFE;
+
+	return baudr;
+}
