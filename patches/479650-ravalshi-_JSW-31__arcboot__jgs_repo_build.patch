+		security_rr_lbw_config_en(initiator_data[SECURITY_INITIATOR_JTAG_MSTR],
+			&lbw_rr_jtag_ctx);
+	} else {
+		for (rr_idx = LBW_RR_IDX_0; rr_idx <= LBW_RR_IDX_15; rr_idx++)
+			security_rr_lbw_config_dis(initiator_data[SECURITY_INITIATOR_JTAG_MSTR],
+				rr_idx);
+	}
+}
+
+void security_handle_jtag_if(void)
+{
+	uint32_t val = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_JTAG_DISABLE_CTRL));
+
+	if ((boot_rom_global.config_fuse & EFUSE_SYSCFG_DIS_JTAG) == 0) {
+		/* Enable JTAG */
+		val &= ~(PSOC_BOOT_CONF_JTAG_DISABLE_CTRL_DISABLE_M);
+
+		security_rr_jtag_config(true);
+
+		/*
+		 * Protection Bits:
+		 * Already all PBs are opened for RW in all pages for all SAI levels.
+		 */
+	} else {
+		val |= (PSOC_BOOT_CONF_JTAG_DISABLE_CTRL_DISABLE_M);
+
+		security_rr_jtag_config(false);
+
+		/*
+		 * Protection Bits:
+		 * Blocked from RR level, so no need to change PB.
+		 */
+	}
+
+	/* Clear FSM timer */
+	val &= ~(PSOC_BOOT_CONF_JTAG_DISABLE_CTRL_COUNTER_EN_M);
+
+	regmap_writel(val, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_JTAG_DISABLE_CTRL));
+}
+
+static uint32_t prepare_mask(uint8_t min, uint8_t max)
+{
+	uint32_t mask = PB_CONF_ALL_PROTECTED;
+
+	mask = mask >> min << min;
+	mask = mask << (31 - max) >> (31 - max);
+
+	return mask;
+}
+
+static void prepare_pb_mask_array(uint32_t min_bit, uint32_t max_bit, uint32_t mask_array[], uint8_t length)
+{
+	uint32_t array_index, cur_min, msb, i;
+
+	cur_min = min_bit;
+	for (i = 0; i < length; i++) {
+		array_index = cur_min / 32;
+		msb = (32 * (array_index + 1)) - 1;
+
+		if (max_bit <= msb) {
+			mask_array[array_index] = prepare_mask(cur_min, max_bit);
+			return;
+		} else {
+			mask_array[array_index] = prepare_mask(cur_min, msb);
+		}
+		cur_min = msb + 1;
+	}
+}
+
+static uint32_t set_bit_index(uint32_t filter)
+{
+	uint32_t i, count = 0;
+
+	for (i = 0; i < (sizeof(uint32_t) * CHAR_BIT); i++) {
+		if ((filter >> i) & 1)
+			count += 1;
+	}
+
+	return count;
+}
+
+static void program_prot_bit_reg(uint32_t spl_base, uint32_t grp, struct pb_grp_ctx grp_cfg)
+{
+	regmap_writel(grp_cfg.access_type, spl_base + pb_access_reg[grp]);
+	regmap_writel(grp_cfg.sai_mask, spl_base + pb_sai_reg[grp]);
+}
+
+static void write_protection_bits(uint32_t spl_base, uint32_t grp, uint32_t set_idx, uint32_t data)
+{
+	regmap_writel(data, spl_base + pb_reg[grp] + (set_idx * sizeof(uint32_t)));
+}
+
+static void boot_rom_program_prot_bits(struct pb_page_ctx *pb_cfg_data, uint32_t pb_cfg_size)
+{
+	uint32_t mask_array[PB_MAX_REG_COPY_PER_GROUP];
+	struct pb_grp_ctx grp_cfg;
+	uint8_t i, group, set_idx;
+	uint32_t page, spl_base, filter_bit_ind;
+	uint32_t pb_mask_len, pb_mask_filter;
+
+	for (page = 0; page < pb_cfg_size; page++) {
+		spl_base = pb_cfg_data[page].spl_base;
+
+		for(group = 0; group < PB_GROUP_MAX; group++) {
+			grp_cfg = pb_cfg_data[page].pb_grp_cfg[group];
+
+			if (grp_cfg.close_all != 0) {
+				program_prot_bit_reg(spl_base, group, grp_cfg);
+
+			} else if (grp_cfg.win_len == 0) {
+				program_prot_bit_reg(spl_base, group, grp_cfg);
+
+				pb_mask_filter = grp_cfg.pb_mask_filter;
+				pb_mask_len = grp_cfg.pb_mask_len;
+
+				if (pb_mask_filter == 0) {
+					/* Write pb_mask as it is, no bit sequence filter */
+					for (set_idx = 0; set_idx < pb_mask_len; set_idx++) {
+						write_protection_bits(spl_base, group, set_idx, grp_cfg.pb_mask[set_idx]);
+					}
+				} else {
+					/* Use pb_mask_filter bit sequence filter */
+					if (grp_cfg.pb_mask_set == 0) {
+						/* Write data from pb_mask based on pb_mask_filter bit sequence */
+						if (set_bit_index(pb_mask_filter) == pb_mask_len) {
+							filter_bit_ind = 0;
+							for (set_idx = 0; (set_idx < PB_MAX_REG_COPY_PER_GROUP) && (pb_mask_filter >> set_idx); set_idx++) {
+								if ((pb_mask_filter >> set_idx) & 1) {
+									write_protection_bits(spl_base, group, set_idx, grp_cfg.pb_mask[filter_bit_ind]);
+									filter_bit_ind += 1;
+								}
+							}
+						} else {
+							/* TODO: report if mask len not equal to bit set count in filter */
+						}
+					} else {
+						/* Write 32bit mask based on pb_mask_filter bit sequence */
+						for (set_idx = 0; (set_idx < PB_MAX_REG_COPY_PER_GROUP) && (pb_mask_filter >> set_idx); set_idx++) {
+							if ((pb_mask_filter >> set_idx) & 1) {
+								write_protection_bits(spl_base, group, set_idx, PB_CONF_ALL_PROTECTED);
+							}
+						}
+					}
+				}
+			} else if (grp_cfg.win_len != 0) {
+				for (i = 0; i < PB_MAX_REG_COPY_PER_GROUP; i++)
+					mask_array[i] = 0;
+
+				program_prot_bit_reg(spl_base, group, grp_cfg);
+
+				for (i = 0; i < grp_cfg.win_len; i++)
+					prepare_pb_mask_array(grp_cfg.win_strt[i], grp_cfg.win_stop[i], mask_array, PB_MAX_REG_COPY_PER_GROUP);
+
+				for (set_idx = 0; set_idx < PB_MAX_REG_COPY_PER_GROUP; set_idx++)
+					write_protection_bits(spl_base, group, set_idx, mask_array[set_idx]);
+			}
+		} /* group for loop */
+	} /* page for loop */
+}
+
+void security_pb_recovery_config(void)
+{
+	struct pb_page_ctx pb_rec_cfg[] = PROT_BITS_RECOVERY_CFG;
+
+	boot_rom_program_prot_bits(pb_rec_cfg, ARRAY_SIZE(pb_rec_cfg));
+}
+
+void security_program_pci_i2c_sai()
+{
+	security_program_sai_levels(initiator_data[SECURITY_INITIATOR_PCIE],
+		SECURITY_PCI_LBW_SAI_VALUE);
+	security_program_sai_levels(initiator_data[SECURITY_INITIATOR_I2C_S_MSTR],
+		SECURITY_I2C_LBW_SAI_VALUE);
+}
diff --git a/arch/jgs/arc/dev_security.h b/arch/jgs/arc/dev_security.h
new file mode 100644
index 0000000..01a3cdf
--- /dev/null
+++ b/arch/jgs/arc/dev_security.h
@@ -0,0 +1,216 @@
+/* SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Copyright (C) 2024 HabanaLabs Ltd.
+ */
+
+#ifndef _DEV_SECURITY_H_
+#define _DEV_SECURITY_H_
+
+#define NUM_KEYS_IN_ROM					5
+#define SIG_SIZE					384
+
+/* size of key properties in bytes */
+#define KEY_PROP_RR_SZ					384
+#define KEY_PROP_MOD_SZ					384
+#define KEY_PROP_EXP_SZ					8
+#define KEY_PROP_INV_SZ					4
+#define KEY_PROP_NB_SZ					4
+#define KEY_PROP_HDR_SZ					8
+
+/* 384 + 384 + 8 + 4 + 4 = 784 bytes */
+#define PUB_KEY_SZ		(KEY_PROP_RR_SZ + KEY_PROP_MOD_SZ + \
+				KEY_PROP_EXP_SZ + KEY_PROP_INV_SZ + \
+				KEY_PROP_NB_SZ)
+
+/* 784 + 8 = 792 */
+#define TOTAL_PUB_KEY_PROPS_SZ		(PUB_KEY_SZ + KEY_PROP_HDR_SZ)
+
+enum security_img_sts {
+    FW_VER_LOWER,
+    AUTHENTICATE_FAIL,
+    CRC_FAIL,
+};
+
+enum security_status {
+	STATUS_IMG_VALIDATED,
+	STATUS_FW_UPGRADE,
+	STATUS_KEY_REVOKED,
+	STATUS_KEY_REVOKED_IND,
+	STATUS_MIN_FW_MODIFIED,
+	STATUS_FW_VER_INC,
+	STATUS_SPI_IMG_MODIFIES,
+	STATUS_FW_AUTH_FAIL,
+};
+
+/* RECOVERY QSPI */
+#define BOOT_ROM_REC_RR_QSPI_MIN		(mmIO_0_CFG_PSOC_PSOC_CFG_QSPI_BASE)
+#define BOOT_ROM_REC_RR_QSPI_MAX		(mmIO_0_CFG_PSOC_PSOC_CFG_QSPI_BASE) + \
+							(IO_0_CFG_PSOC_PSOC_CFG_QSPI_SECTION - 1)
+
+/* RECOVERY PAD_SEL */
+#define BOOT_ROM_REC_RR_PSOC_PAD_SEL_MIN	(mmIO_0_CFG_PSOC_PSOC_CFG_PAD_CONF_BASE) + \
+							(mmPSOC_PAD_CONF_PAD_SEL_8)
+#define BOOT_ROM_REC_RR_PSOC_PAD_SEL_MAX	(mmIO_0_CFG_PSOC_PSOC_CFG_PAD_CONF_BASE) + \
+							(mmPSOC_PAD_CONF_PAD_SEL_9 - 1)
+
+/* RECOVERY PSOC SECURITY */
+#define BOOT_ROM_REC_RR_PSOC_SECURITY_MIN	(mmIO_0_CFG_PSOC_BOOT_SECURITY_BASE) + \
+							(mmPSOC_SECURITY_FW_RST)
+#define BOOT_ROM_REC_RR_PSOC_SECURITY_MAX	(mmIO_0_CFG_PSOC_BOOT_SECURITY_BASE) + \
+							(mmPSOC_SECURITY_MIN_FW_VERSION - 1)
+
+/* RECOVERY GEN_MEM */
+#define BOOT_ROM_REC_RR_GEN_MEM_MIN		(HL_FLASH_BASE)
+#define BOOT_ROM_REC_RR_GEN_MEM_MAX		(HL_FLASH_BASE) + (HL_FLASH_SIZE - 1)
+
+/* SAI Table start */
+#define SECURITY_PCI_LBW_SAI_VALUE		2
+#define SECURITY_I2C_LBW_SAI_VALUE		11
+#define SECURITY_JTAG_LBW_SAI_VALUE		9 /* TODO: Consider JTAG Green from SAI Assignment Doc */
+/* SAI Table end */
+
+#define RECOVERY_INITIATORS_SAI	(BIT(SECURITY_PCI_LBW_SAI_VALUE) | BIT(SECURITY_I2C_LBW_SAI_VALUE))
+
+#define INITIATOR_SAI_REG_FORMAT(SAI_VAL)	(SAI_VAL & AXUSER_LBW_LB_SAI_RD_M) | \
+								((SAI_VAL << AXUSER_LBW_LB_SAI_WR_S) & AXUSER_LBW_LB_SAI_WR_M)
+
+enum security_pb_pages {
+	PB_PAGE_PSOC_BOOT_SECURITY,
+	PB_PAGE_PSOC_CFG_PAD_CONF,
+};
+
+#define PB_MAX_REG_COPY_PER_GROUP		29
+#define PB_CONF_ALL_PROTECTED			0xFFFFFFFF
+
+/* Various blocks to be configured during boot rom in recovery */
+enum security_access_ctrl_zones {
+	SEC_ACCESS_CTRL_QSPI,
+	SEC_ACCESS_CTRL_PAD_SEL,
+	SEC_ACCESS_CTRL_PSOC_SEC,
+	SEC_ACCESS_CTRL_GEN_MEM,
+	SEC_ACCESS_CTRL_MAX,
+};
+
+/* In FS1 total 16 sets of LBW RR's are there */
+enum security_lbw_rr_sets {
+	LBW_RR_IDX_0 = 0,
+	LBW_RR_IDX_1 = 1,
+	LBW_RR_IDX_2 = 2,
+	LBW_RR_IDX_3 = 3,
+	LBW_RR_IDX_15 = 15,
+	LBW_RR_INVALID_IDX = 16,
+};
+
+enum security_access {
+	SEC_ACCESS_RD_ONLY,
+	SEC_ACCESS_WR_ONLY,
+	SEC_ACCESS_RD_WR,
+	SEC_ACCESS_INVALID,
+};
+
+struct security_rr_ctx {
+	uint8_t rr_idx;
+	uint8_t acc_type;
+	uint32_t data_min;
+	uint32_t data_max;
+};
+
+/* List of transaction initiators */
+enum security_initiators {
+	SECURITY_INITIATOR_PCIE,
+	SECURITY_INITIATOR_I2C_S_MSTR,
+	SECURITY_INITIATOR_JTAG_MSTR,
+	SECURITY_INITIATOR_MAX,
+};
+
+struct security_initiator_ctx {
+	uint32_t base_addr;
+	uint32_t sai_base;
+};
+
+enum prot_bits_groups {
+	PB_GROUP_0,
+	PB_GROUP_1,
+	PB_GROUP_2,
+	PB_GROUP_MAX,
+};
+
+enum prot_bits_access_type {
+	PB_ACCESS_TYPE_RW,
+	PB_ACCESS_TYPE_RO,
+	PB_ACCESS_INVALID,
+};
+
+/* Group level configuration flags */
+struct pb_grp_ctx {
+	uint32_t sai_mask;
+	uint8_t access_type;
+	/*
+	 * Clear/close all PB regs and SAI reg
+	 */
+	uint8_t close_all;
+	/*
+	 * This filter used if 0's are in between data sets in pb_mask - {0x12, 0, 0x23, }
+	 * To save pb_mask length data set indexes are stored in filter - 0b'101
+	 * After filter is applied, pb_mask will become - {0x12, 0x23, }
+	 */
+	uint8_t pb_mask_filter;
+	/*
+	 * Length of pb_mask data set array.
+	 */
+	uint8_t pb_mask_len;
+	/*
+	 * Applicable when win_strt and win_stop is configured.
+	 * Indicates array length of win_strt/win_stop.
+	 * Make sure length(win_strt) == length(win_stop).
+	 */
+	uint8_t win_len;
+	/*
+	 * If this flag set, pb_mask array is not considered.
+	 * Set all bits in pb reg set based on pb_mask_filter
+	 * If pb_mask_filter = 0b'101
+	 * Equivalent pb reg set data = {0xFFFFFFFF, 0, 0xFFFFFFFF }
+	 */
+	uint8_t pb_mask_set;
+	uint16_t rsvd;
+	/* array of window start bit index */
+	const uint32_t *win_strt;
+	/* array of window stop bit index */
+	const uint32_t *win_stop;
+	/*
+	 * It has required data sets to written into pb reg sets.
+	 * If pb_mask_filter == 0, pb_mask array has valid data sets.
+	 * If pb_mask_filter != 0, data set access based on filter bit indexing.
+	 */
+	const uint32_t *pb_mask;
+};
+
+/* Page level configurationb */
+struct pb_page_ctx {
+	uint32_t spl_base;
+	struct pb_grp_ctx pb_grp_cfg[PB_GROUP_MAX];
+};
+
+/* Define your PB_REG_BITS here */
+#define RECOVERY_PB_CFG_PSOC_BOOT_SECURITY	{0x1, }
+#define RECOVERY_PB_CFG_PSOC_CFG_PAD_CONF	{0x100, }
+
+void security_load_revoke_bits(void);
+int security_efuse_image_validation_en(void);
+void boot_rom_eom_overrides(void);
+void security_load_fw_version(void);
+void security_load_rom_key_hash(void);
+void security_report_fw_version(enum hl_fw_manifest_type manifest_idx);
+void boot_rom_report_image_status(enum hl_fw_manifest_type man_type,
+		enum security_img_sts error);
+void boot_rom_report_security_status(enum security_status status_bit, uint8_t index);
+void security_rr_lbw_config_en(struct security_initiator_ctx initr_data,
+	const struct security_rr_ctx *rr_ip_ctx);
+void security_rr_recovery_config(bool enable);
+void security_handle_jtag_if(void);
+void security_pb_recovery_config(void);
+void security_program_pci_i2c_sai(void);
+
+extern const uint8_t rom_key_hashes[NUM_KEYS_IN_ROM][SHA384_SUM_LEN];
+
+#endif /* _DEV_SECURITY_H_ */
