+void security_load_revoke_bits(void)
+{
+	uint32_t key_revoke = boot_rom_global.config_fuse & EFUSE_SYSCFG_KEY_REVOCATION_BITS;
+
+	if (boot_rom_global.fake_fuse_en)
+		boot_rom_status_update(PROGRESS_REVOKE_LOC_FAKE_FUSE);
+	else
+		boot_rom_status_update(PROGRESS_REVOKE_LOC_ASIC_EFUSE);
+
+	/* store key_revoke map in PSOC */
+	regmap_writel(key_revoke, IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_KEY_REVOKE));
+
+	boot_rom_global.sec_data.key_revoke = key_revoke;
+}
+
+void security_load_fw_version()
+{
+	uint8_t fw_version_sec = security_get_fw_version();
+
+	if (boot_rom_global.fake_fuse_en)
+		boot_rom_status_update(PROGRESS_VER_LOC_FAKE_FUSE);
+	else
+		boot_rom_status_update(PROGRESS_VER_LOC_ASIC_EFUSE);
+
+	/* store minimum allowed security version in PSOC */
+	regmap_writel(fw_version_sec,
+		IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_MIN_FW_VERSION));
+
+	/* store minimum allowed security version in persistent DCCM */
+	boot_rom_global.sec_data.sec_ver = fw_version_sec;
+
+	boot_info_write_svn_data(fw_version_sec);
+}
+
+void security_report_fw_version(enum hl_fw_manifest_type manifest_idx)
+{
+	struct hl_fw_boot_ptrs *boot_ptr = NULL;
+	uint32_t boot_ptr_addr = 0;
+
+	boot_ptr_addr = boot_desc_get_boot_pointer(manifest_idx);
+
+	if (boot_ptr_addr == 0)
+		return;
+
+	boot_ptr = (struct hl_fw_boot_ptrs *)boot_ptr_addr;
+
+	regmap_writel(boot_ptr->sec_ver,
+		IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_CURRENT_FW_VERSION));
+}
+
+void security_load_rom_key_hash()
+{
+	uint8_t key_idx, dword;
+	uint32_t key_reg;
+	uint32_t *hash = (uint32_t *)rom_key_hashes;
+	uint32_t key_reg_base_array[] = {
+		IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_PUBLIC_KEY_0_0),
+		IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_PUBLIC_KEY_1_0),
+		IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_PUBLIC_KEY_2_0),
+		IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_PUBLIC_KEY_3_0),
+		IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_PUBLIC_KEY_4_0)
+	};
+
+	/* KEY LOCATION: ROM */
+	boot_rom_status_update(PROGRESS_KEY_LOC_ROM);
+
+	/* TODO: Store keys in boot_info if required */
+
+	for (key_idx = 0; key_idx < NUM_KEYS_IN_ROM; key_idx++) {
+		key_reg = key_reg_base_array[key_idx];
+		for (dword = 0; dword < SECURITY_DWORD_PER_KEY; dword++) {
+			regmap_writel(hash[(key_idx * SECURITY_DWORD_PER_KEY) + dword],
+					key_reg);
+
+			key_reg += sizeof(uint32_t);
+		}
+	}
+}
