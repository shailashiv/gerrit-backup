+#include <psoc_boot_conf_masks.h>
+#include <gpio_regs.h>
+#include <jgs_efuse.h>
+#include <mem_io.h>
+#include <jgs_fw_if.h>
+//TODO: remove
+//#include<dummy.h>
+
+/* TODO: we need to verify flow and params on test chip to finalize D2D link init */
+
+#define D2D_LINK_STATUS_UDELAY	10000 /* 10 ms */
+#define FORCE_REC_GPIO_MASK		BIT(1)
+
+#define FS1_REC_STS_GPIO		77
+#define GPIOS_PER_BANK			16
+void boot_rom_set_recovery_status(void)
+{
+	uint32_t index = FS1_REC_STS_GPIO % GPIOS_PER_BANK;
+	uint32_t val, mask = BIT(index);
+
+	if (boot_rom_global.die_type != FS1_IO_DIE_MASTER)
+		return;
+
+	/* TODO: check if PAD_SEL for specific GPIO needs to be set */
+
+	/* configure GPIO in output mode */
+	val = regmap_readl(I0_H0_PSOC_GPIO4(mmGPIO_OUTENSET));
+	val = val | mask;
+	regmap_writel(val, I0_H0_PSOC_GPIO4(mmGPIO_OUTENSET));
+
+	/* TODO: Confirm gpio is active low/high */
+	val = regmap_readl(I0_H0_PSOC_GPIO4(mmGPIO_DATAOUT));
+	val |= mask;
+	regmap_writel(val, I0_H0_PSOC_GPIO4(mmGPIO_DATAOUT));
+}
+
+/*
+ * TODO: waiting for recovery flow sequence from verification team.
+ */
+void boot_rom_notify_slave(void)
+{
+	uint32_t def_ovrd_en, def_ovrd_val, val;
+
+	/* Set Override en for recovery mode */
+	def_ovrd_en = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_D2D_GPIO_UP_OVRD_EN));
+	val = def_ovrd_en | PSOC_BOOT_CONF_D2D_GPIO_UP_OVRD_EN_RECOVERY_MODE_M;
+	regmap_writel(val, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_D2D_GPIO_UP_OVRD_EN));
+
+	/* Set recovery mode value */
+	def_ovrd_val = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_D2D_GPIO_UP_OVRD_VAL));
+	val = def_ovrd_val | PSOC_BOOT_CONF_D2D_GPIO_UP_OVRD_VAL_RECOVERY_MODE_M;
+	regmap_writel(val, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_D2D_GPIO_UP_OVRD_VAL));
+
+	udelay(RECOVERY_PULSE_DURATION);
+
+	/* Clear recovery mode value */
+	def_ovrd_val &= ~(PSOC_BOOT_CONF_D2D_GPIO_UP_OVRD_VAL_RECOVERY_MODE_M);
+	regmap_writel(def_ovrd_val, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_D2D_GPIO_UP_OVRD_VAL));
+
+	/* Clear Override en for recovery mode */
+	def_ovrd_en &= ~(PSOC_BOOT_CONF_D2D_GPIO_UP_OVRD_EN_RECOVERY_MODE_M);
+	regmap_writel(def_ovrd_en, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_D2D_GPIO_UP_OVRD_EN ));
+}
+
+void boot_rom_d2d_link_init(void)
+{
+	if (boot_rom_global.sku == FS1_IO_DIE_SA)
+		return;
+
+	if (boot_rom_global.config2_fuse & EFUSE_SYSCFG2_D2D_DISABLE)
+		return; /* skip d2d init */
+
+	boot_rom_status_update(PROGRESS_BOOT_ROM_D2D_LINK_START);
+
+	/* TODO: check IO HALF0 FSM_STS and HALF1 FSM_STS are in sync */
+
+	/* Master Die and Slave Die's sync for d2d rec init */
+	if (boot_rom_global.die_type == FS1_IO_DIE_MASTER) {
+		/* Indicate slave die's that d2d init has started */
+		boot_rom_notify_slave();
+	} else {
+		boot_rom_wait_for_recovery_in();
+	}
+
+	/* Inter die indication for d2d link init handshaking */
+	boot_rom_status_update(PROGRESS_BOOT_ROM_D2D_LINK_INTER_DIE_SYNC);
+
+	/* TODO: IO HALF0 FSM_CTL and HALF1 FSM_CTL are in sync, and set start bit of D2D init */
+
+	/* TODO: wait for DPYH FSM busy status */
+
+	boot_rom_status_update(PROGRESS_BOOT_ROM_D2D_LINK_INIT_SUCCESS);
+
+	/*
+	 * TODO: D2D link init success acknowledgement to initiator
+	 * If no ack back, initiator has to blindly proceed that all Die's init success.
+	*/
+}
+
+bool boot_rom_efuse_force_recovery_en(void)
+{
+	return ((boot_rom_global.config_fuse & EFUSE_SYSCFG_GPIO01_RECOVERY_CONTROL) == 0);
+}
+
+bool boot_rom_read_force_recovery_gpio(void)
+{
+	return ((regmap_readl(I0_H0_PSOC_GPIO0(mmGPIO_DATA)) & FORCE_REC_GPIO_MASK) > 0);
+}
