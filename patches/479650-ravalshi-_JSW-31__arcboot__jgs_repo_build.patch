diff --git a/arch/jgs/arc/common.c b/arch/jgs/arc/common.c
new file mode 100644
index 0000000..2643e80
--- /dev/null
+++ b/arch/jgs/arc/common.c
@@ -0,0 +1,488 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2024 HabanaLabs Ltd.
+ * All Rights Reserved.
+ */
+
+#include <boot_rom.h>
+#include <mem_io.h>
+#include <jgs_blocks_linux_driver.h>
+#include <jgs_reg_map.h>
+#include <arc_local_conf_regs.h>
+#include <arc_local_conf_masks.h>
+#include <psoc_boot_conf_regs.h>
+#include <psoc_security_regs.h>
+#include <global_conf_regs.h>
+#include <jgs_reg_mask.h>
+#include <jgs_fw_if.h>
+#include <jgs_security.h>
+#include <hl_fw_upd_if.h>
+#include <status.h>
+#include <efuse.h>
+#include <hl_fw_upd_if.h>
+#include <string.h>
+#include "dev_uart.h"
+#include "progress_bits.h"
+#include <dev_mem_copy.h>
+#include <lfs_wrapper.h>
+#include <psoc_pad_conf_regs.h>
+#include <gpio_regs.h>
+#include <psoc_boot_conf_masks.h>
+#include <arc_regs.h>
+#include <boot_desc.h>
+#include <dev_spi_flash.h>
+#include <dev_boot_info.h>
+
+extern const int fs1_die_type;
+
+uint8_t boot_rom_get_die_id(void)
+{
+	uint32_t die_cpu_id = regmap_readl(IO0_H0_PSOC_ARC_MNG_LOCAL(mmARC_LOCAL_CONF_DIE_CPU_ID));
+
+	return ((die_cpu_id & ARC_LOCAL_CONF_DIE_CPU_ID_DIE_ID_M)
+		>> ARC_LOCAL_CONF_DIE_CPU_ID_DIE_ID_S);
+}
+
+uint8_t boot_rom_get_die_type(void)
+{
+	if (fs1_die_type == STATIC_DIE_TYPE_COMP) {
+		if (boot_rom_global.die_id <= FS1_COMPUTE_DIE_3)
+			return FS1_COMPUTE_DIE;
+	} else if (fs1_die_type == STATIC_DIE_TYPE_IO) {
+		if (boot_rom_global.die_id == FS1_IO_DIE_0)
+			return FS1_IO_DIE_MASTER;
+		else if (boot_rom_global.die_id == FS1_IO_DIE_1)
+			return FS1_IO_DIE_SLAVE;
+	}
+
+	/* TODO: Assert? */
+	return FS1_INVALID_DIE_TYPE;
+}
+
+void boot_rom_init_sku(void)
+{
+	boot_rom_global.sku = (boot_rom_global.config_fuse & EFUSE_SYSCFG_SKU)
+		>> EFUSE_SYSCFG_SKU_SHIFT;
+
+	if (boot_rom_global.sku >= FS1_INVALID_SKU) {
+		boot_rom_global.sku = FS1_FULL_PACKAGE;
+	}
+}
+
+bool boot_rom_in_multi_die_mode(void)
+{
+	return (boot_rom_global.sku != FS1_IO_DIE_SA);
+}
+
+bool boot_rom_in_master_die()
+{
+	return (boot_rom_global.die_type == FS1_IO_DIE_MASTER);
+}
+
+static void boot_rom_global_pre_init_values(void)
+{
+	/*
+	 * rom_persistent_section pre-init values.
+	 * Only assign during cold reset.
+	 * Below values modified during run time and used in next non-cold reset cases.
+	*/
+	boot_rom_global.die_id = FS1_INVALID_DIE_ID;
+	boot_rom_global.die_type = FS1_INVALID_DIE_TYPE;
+	boot_rom_global.sku = FS1_INVALID_SKU;
+	boot_rom_global.valid_manifest_idx = HL_FW_SPI_MANIFEST_MAX_NUM;
+}
+
+#define HL_ARC1_DCCM_PERSIST_SECTION_SIZE		(3 * 1024) /* 3KB */
+void boot_rom_persistent_dccm_init(uint8_t die_id)
+{
+	volatile uint32_t *dccm_addr = (uint32_t *) HL_DCCM_BASE;
+	uint32_t dccm_dwords = HL_ARC1_DCCM_PERSIST_SECTION_SIZE >> 2;
+	struct fs1_cold_rst_data cold_rst_data;
+	uint32_t i;
+
+	cold_rst_data.data = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+
+	if (cold_rst_data.arc1_persist_dccm_init_done)
+		goto non_zero_init;
+
+	for (i = 0; i < dccm_dwords; i++)
+		*dccm_addr++ = 0;
+
+	cold_rst_data.arc1_persist_dccm_init_done = 1;
+	regmap_writel(cold_rst_data.data, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+
+	boot_rom_global_pre_init_values();
+
+non_zero_init:
+	/* Non zero initializers only required for master(die 0) */
+	if (die_id == FS1_IO_DIE_0) {
+		/*
+		 * Assign pre-init constants which never modified during run time.
+		 * So, upon any reset safe to re-init them.
+		 * For example, manifest constants.
+		 */
+		lfs_globals_pre_init();
+	}
+}
+
+void boot_rom_clear_status(void)
+{
+	/* As per Architecture recommendation, clear status reg */
+	regmap_writel(0, IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_STATUS));
+
+	regmap_writel(0, IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_SW_STATUS_0));
+	regmap_writel(0, IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_SW_STATUS_1));
+	regmap_writel(0, IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_SW_STATUS_2));
+	regmap_writel(0, IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_SW_STATUS_3));
+	regmap_writel(0, IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_SW_STATUS_4));
+	regmap_writel(0, IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_SW_STATUS_5));
+	regmap_writel(0, IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_SW_STATUS_6));
+	regmap_writel(0, IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_SW_STATUS_7));
+
+	/* Die indication register is on io die slave and compute */
+	if (boot_rom_global.die_type != FS1_IO_DIE_MASTER)
+		regmap_writel(0, IO0_H0_PSOC_GLOBAL_CONF(mmGLOBAL_CONF_SCRATCHPAD_2));
+}
+
+uint32_t boot_rom_get_status_base(void)
+{
+	return IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_SW_STATUS_0);
+}
+
+void boot_rom_read_cold_flops(void)
+{
+	struct fs1_cold_rst_data cold_rst_data;
+	enum fw_post_reset_cmd fw_upd_status =
+		regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_3));
+
+	cold_rst_data.data = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+
+	boot_rom_global.recovery_flag = cold_rst_data.recovery_flag;
+	boot_rom_global.validation_pass = cold_rst_data.validation_flag;
+	boot_rom_global.valid_manifest_idx = cold_rst_data.valid_manifest_idx;
+	boot_rom_global.efuse_read = cold_rst_data.efuse_read_flag;
+	boot_rom_global.boot_info_set_done = cold_rst_data.boot_info_set_done;
+	boot_rom_global.tpm_extend_done = cold_rst_data.tpm_validation_flag;
+	boot_rom_global.fuse_emulation_init_done = cold_rst_data.fuse_emulation_init_done;
+
+	if (fw_upd_status == FLOPS_UPD_PENDING)
+		boot_rom_global.fw_upd_switch_manifest = 1;
+	else
+		boot_rom_global.fw_upd_switch_manifest = 0;
+}
+
+int boot_rom_mem_init(uint64_t addr, uint32_t size)
+{
+	struct mem_copy_flag flag;
+
+	flag.mem_type = MEM_COPY_MEM_TYPE_LBW;
+	flag.copy_type = MEM_COPY_TYPE_CONSTANT;
+
+	return boot_rom_mem_copy(flag, MEM_COPY_CONSTANT_CLEAR, addr, size);
+}
+
+void boot_rom_iccm_init(void)
+{
+	struct fs1_cold_rst_data cold_rst_data;
+	int ret;
+
+	if (boot_rom_global.die_type != FS1_IO_DIE_MASTER)
+		return;
+
+	/* Perform arc1 iccm init only on cold reset */
+	cold_rst_data.data = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+	if (cold_rst_data.arc1_iccm_init_done)
+		return;
+
+	ret = boot_rom_mem_init(MNG_ARC_ICCM_FULL_BASE, MNG_ARC_ICCM_SIZE);
+	if (ret) {
+		boot_rom_status_update(PROGRESS_INIT_ARC1_ICCM_INIT_FAILED);
+		return;
+	}
+
+	cold_rst_data.arc1_iccm_init_done = 1;
+	regmap_writel(cold_rst_data.data, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+}
+
+void boot_rom_halt(void)
+{
+	boot_rom_putc('h');
+	while (1) {
+		wfe();
+	}
+}
+
+enum boot_rom_status boot_rom_read_config_fuse(void)
+{
+	if ((boot_rom_fuse_read(IO_EFUSE_SYSCFG_OFFSET, &boot_rom_global.config_fuse)
+	    != BOOT_ROM_SUCCESS) ||
+	    (boot_rom_fuse_read(IO_EFUSE_SYSCFG2_OFFSET, &boot_rom_global.config2_fuse)
+	    != BOOT_ROM_SUCCESS))
+		return BOOT_ROM_FAIL;
+
+	return BOOT_ROM_SUCCESS;
+}
+
+void boot_rom_set_efuse_read(void)
+{
+	struct fs1_cold_rst_data cold_rst_data;
+
+	cold_rst_data.data = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+	if (cold_rst_data.efuse_read_flag)
+		return;
+
+	/* efuse init successful, set cold flops */
+	cold_rst_data.efuse_read_flag = 1;
+	regmap_writel(cold_rst_data.data, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+}
+
+void boot_rom_set_spi_efuse_read(void)
+{
+	struct fs1_cold_rst_data cold_rst_data;
+
+	cold_rst_data.data = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+	if (cold_rst_data.fuse_emulation_init_done)
+		return;
+
+	/* fake/spi efuse init successful, set cold flops */
+	cold_rst_data.fuse_emulation_init_done = 1;
+	regmap_writel(cold_rst_data.data, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+}
+
+void boot_rom_set_tpm_extend_done(void)
+{
+	struct fs1_cold_rst_data cold_rst_data;
+
+	boot_rom_global.tpm_extend_done = 1;
+
+	cold_rst_data.data = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+	if (cold_rst_data.tpm_validation_flag)
+		return;
+
+	/* tpm pcr extend successful, set cold flops */
+	cold_rst_data.tpm_validation_flag = 1;
+	regmap_writel(cold_rst_data.data, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+}
+
+enum boot_rom_tpm_exec_stage boot_rom_get_tpm_exec_stage(void)
+{
+	return boot_rom_global.tpm_exec_stage;
+}
+
+uint8_t boot_rom_get_tpm_next_pcr_index(void)
+{
+	return boot_rom_global.tpm_next_pcr_index;
+}
+
+void boot_rom_set_tpm_next_pcr_index(uint8_t tpm_pcr_index)
+{
+	boot_rom_global.tpm_next_pcr_index = tpm_pcr_index;
+}
+
+void boot_rom_tpm_next_pcr_index_init(void)
+{
+	boot_rom_set_tpm_next_pcr_index(TPM2_SVN_PCR_IDX);
+}
+
+bool boot_rom_is_manifest_valid(void)
+{
+	return (bool)boot_rom_global.validation_pass;
+}
+
+static bool boot_rom_get_svn(uint8_t *svn)
+{
+	uint8_t fw_version_sec = boot_info_read_svn_data();
+
+	/*
+	 * If failed to get svn from boot info or boot info disabled,
+	 * Get svn from persistent dccm.
+	 */
+	if (fw_version_sec == 0)
+		fw_version_sec = boot_rom_global.sec_data.sec_ver;
+
+	if (fw_version_sec == 0)
+		return false;
+
+	memcpy(svn, &fw_version_sec, sizeof(fw_version_sec));
+
+	return true;
+}
+
+static bool boot_rom_get_manifest_hash(__unused uint8_t *hash)
+{
+	/*
+	 * TODO add code to fetch manifest hash from littlefs
+	 * This code will be added once the capability to compute
+	 * manifest hash and store it in littlefs is integrated
+	 */
+	return false;
+}
+
+bool boot_rom_get_hash_for_tpm_pcr(uint8_t tpm_pcr_index, uint8_t *hash)
+{
+	bool is_valid = false;
+
+	switch (tpm_pcr_index) {
+	case TPM2_SVN_PCR_IDX:
+		is_valid = boot_rom_get_svn(hash);
+		break;
+	case TPM2_MANIFEST_PCR_IDX:
+		is_valid = boot_rom_get_manifest_hash(hash);
+		break;
+	default:
+		is_valid = false;
+		break;
+	}
+
+	return is_valid;
+}
+
+enum boot_rom_progress boot_rom_get_tpm_extend_fail_prog_bit(uint8_t tpm_pcr_index)
+{
+	return (tpm_pcr_index == TPM2_SVN_PCR_IDX) ?
+		PROGRESS_BOOT_ROM_SVN_TPM_PCR_EXTEND_FAIL :
+		PROGRESS_BOOT_ROM_MANIFEST_TPM_PCR_EXTEND_FAIL;
+}
+
+enum boot_rom_tpm_spi_freq_config boot_rom_get_tpm_spi_freq_config(void)
+{
+	enum boot_rom_tpm_spi_freq_config freq_config;
+
+	freq_config = ((boot_rom_global.config_fuse & EFUSE_SYSCFG_SPI_TPM_BAUDR) == 0) ?
+		FREQ_CFG_12_5MHZ : FREQ_CFG_6_25MHZ;
+
+	return freq_config;
+}
+
+bool dev_spec_img_desc_is_valid(__unused struct hl_fw_img_desc *img_desc)
+{
+	/* TODO: implement for FS1 if required */
+
+	return true;
+}
+
+/* This function is only applicable for io die master */
+bool boot_rom_is_valid_address_range(uint64_t addr, uint32_t len)
+{
+	if (addr >= (uint64_t)SCRATCHPAD_SRAM_BASE &&
+	    addr + len <= (uint64_t)(SCRATCHPAD_SRAM_BASE + SCRATCHPAD_SRAM_SIZE))
+		return true;
+
+	if (addr >= SCRATCHPAD_SRAM_BASE_FULL &&
+	    addr + len <= SCRATCHPAD_SRAM_BASE_FULL + SCRATCHPAD_SRAM_SIZE)
+		return true;
+
+	if (addr >= RST_ARC_ICCM_FULL_BASE &&
+	    addr + len <= RST_ARC_ICCM_FULL_BASE + RST_ARC_MEM_SIZE)
+		return true;
+
+	if (addr >= MNG_ARC_ICCM_FULL_BASE &&
+	    addr + len <= MNG_ARC_ICCM_FULL_BASE + MNG_ARC_MEM_SIZE)
+		return true;
+
+	if (addr >= PID_ARC_ICCM_FULL_BASE &&
+	    addr + len <= PID_ARC_ICCM_FULL_BASE + PID_ARC_MEM_SIZE)
+		return true;
+
+	if (addr >= (uint64_t)(HL_FW_MEM_BASE + PSOC_FWSRAM_OFFSET) &&
+	    addr + len <= (uint64_t)(HL_FW_MEM_BASE + PSOC_FWSRAM_OFFSET + PSOC_FWSRAM_SIZE))
+		return true;
+
+	if (addr >= PSOC_FW_SRAM_FULL_BASE &&
+	    addr + len <= PSOC_FW_SRAM_FULL_BASE + PSOC_FWSRAM_SIZE)
+		return true;
+
+	return false;
+}
+
+uint32_t boot_rom_fw_mem_arc_addr(uint64_t addr)
+{
+	if (addr >= MNG_ARC_ICCM_FULL_BASE && addr <= MNG_ARC_ICCM_FULL_BASE + MNG_ARC_MEM_SIZE)
+		return CONV_64B_TO_ARC_FW_MEM(addr) - (HL_FW_MEM_BASE + MNG_ARC_ICCM_OFFSET);
+	else
+		return CONV_64B_TO_ARC_FW_MEM(addr);
+}
+
+uint32_t boot_rom_get_arc_addr(uint64_t addr)
+{
+	if (addr >= FW_MEM_BASE_FULL && addr <= FW_MEM_BASE_FULL + HL_FW_MEM_SIZE)
+		return boot_rom_fw_mem_arc_addr(addr);
+
+	return 0;
+}
+
+void boot_rom_check_rma_enabled(void)
+{
+	boot_rom_global.sec_data.rma_enabled = 0;
+
+	/* TODO: Check if TPM owner is removed */
+
+	if (boot_rom_global.config2_fuse & EFUSE_SYSCFG2_RMA_MODE)
+		boot_rom_global.sec_data.rma_enabled = 1;
+}
+
+void boot_rom_validation_status(bool validation_pass)
+{
+	struct fs1_cold_rst_data cold_rst_data;
+
+	/* validation pass, set validation flag and clear recovery or viceversa */
+	cold_rst_data.data = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+	cold_rst_data.recovery_flag = (validation_pass ? 0 : 1);
+	cold_rst_data.validation_flag = (validation_pass ? 1 : 0);
+	regmap_writel(cold_rst_data.data, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+}
+
+void boot_rom_set_manifest_index(enum hl_fw_manifest_type man_idx)
+{
+	struct fs1_cold_rst_data cold_rst_data;
+
+	boot_rom_global.valid_manifest_idx = man_idx;
+	cold_rst_data.data = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+	if (cold_rst_data.valid_manifest_idx == man_idx)
+		return;
+
+	cold_rst_data.valid_manifest_idx = man_idx;
+	regmap_writel(cold_rst_data.data, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+}
+
+
+/*
+ * Request CPLD to start the watchdog, by asserting
+ * a GPIO_66 (Boot_WD).
+ */
+#define GPIOS_PER_BANK			16
+#define FS1_CPLD_WDOG_GPIO		66
+void boot_rom_start_cpld_wdtimer(void)
+{
+	uint32_t index = FS1_CPLD_WDOG_GPIO % GPIOS_PER_BANK;
+	uint32_t val, mask = BIT(index);
+
+	regmap_writel(GPIO_FUNC_1, IO0_H0_PSOC_CFG_PAD_CONF_PAD_SEL(mmPSOC_PAD_CONF_PAD_SEL_66));
+
+	/* configure GPIO in output mode */
+	val = regmap_readl(I0_H0_PSOC_GPIO4(mmGPIO_OUTENSET));
+	val = val | mask;
+	regmap_writel(val, I0_H0_PSOC_GPIO4(mmGPIO_OUTENSET));
+
+	/* gpio is active high */
+	val = regmap_readl(I0_H0_PSOC_GPIO4(mmGPIO_DATAOUT));
+	val = val | mask;
+	regmap_writel(val, I0_H0_PSOC_GPIO4(mmGPIO_DATAOUT));
+}
+
+bool boot_rom_spi_efuse_enabled()
+{
+	return (((boot_rom_global.config_fuse & EFUSE_SYSCFG_DIS_EFUSE_OVERRIDE) == 0) &&
+		(regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_BOOT_STRAP_PINS_H)) &
+			PSOC_BOOT_CONF_BOOT_STRAP_PINS_H_EFUSE_OVERRIDE_M));
+}
+
+void boot_rom_config_arc_regions(void)
+{
+	regmap_writel(FULL_ADDR_MSB, IO0_H0_MNG_ARC(mmARC_GP_MSB_ADDR_0));
+}
+
+bool boot_rom_second_image_enabled(void)
+{
+	return ((boot_rom_global.config_fuse & EFUSE_SYSCFG_DIS_SECONDARY_IMG) == 0);
+}
