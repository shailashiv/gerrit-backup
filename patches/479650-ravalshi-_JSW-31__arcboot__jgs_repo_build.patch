+#include <dev_boot_info.h>
+
+bool boot_rom_skip_boot_info(void)
+{
+	return !!(boot_rom_global.config2_fuse && EFUSE_SYSCFG2_DISABLE_BOOT_INFO);
+}
+
+void boot_rom_set_boot_info(void)
+{
+	struct fs1_cold_rst_data cold_rst_data;
+
+	if (!boot_rom_in_master_die())
+		return;
+
+	if(boot_rom_skip_boot_info())
+		return;
+
+	if (!boot_rom_global.boot_info_set_done || !boot_rom_global.validation_pass) {
+		boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_SET_START);
+
+		boot_desc_save_manifest_boot_info_data();
+
+		cold_rst_data.data = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+		cold_rst_data.boot_info_set_done = 1;
+		regmap_writel(cold_rst_data.data, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+		boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_SET_FINISH);
+	}
+
+	/* Flag which is indication for other modules to know Boot ROM done with LFS */
+	boot_rom_status_update(PROGRESS_BOOT_INFO_LFS_FINISHED);
+
+	return;
+}
+
+void boot_rom_get_boot_info(void)
+{
+	if (!boot_rom_in_master_die())
+		return;
+
+	if(boot_rom_skip_boot_info())
+		return;
+
+	if (boot_rom_global.boot_info_set_done) {
+		/* Read and make sure proper data after any reset */
+		boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_GET_START);
+
+		boot_desc_get_manifest_boot_info_data();
+
+		boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_GET_FINISH);
+	}
+
+	/* Flag which is indication for other modules to know Boot ROM done with LFS */
+	boot_rom_status_update(PROGRESS_BOOT_INFO_LFS_FINISHED);
+}
+
+void boot_info_write_svn_data(uint8_t fw_version_sec)
+{
+	if (boot_rom_skip_boot_info())
+		return;
+
+	if (lfs_file_set(LFS_TAG_BOOT_INFO, HL_BOOT_INFO_SECURE_VERSION_NUMBER,
+		&fw_version_sec, sizeof(fw_version_sec))) {
+		boot_rom_status_update(PROGRESS_BOOT_INFO_SVN_SET_FAIL);
+		return;
+	}
+}
+
+uint8_t boot_info_read_svn_data(void)
+{
+	uint8_t fw_version_sec = 0;
+
+	if (boot_rom_skip_boot_info())
+		return 0;
+
+	if (lfs_file_copy(LFS_TAG_BOOT_INFO, HL_BOOT_INFO_SECURE_VERSION_NUMBER,
+		&fw_version_sec, sizeof(fw_version_sec))) {
+		boot_rom_status_update(PROGRESS_BOOT_INFO_SVN_GET_FAIL);
+		return 0;
+	}
+
+	return fw_version_sec;
+}
