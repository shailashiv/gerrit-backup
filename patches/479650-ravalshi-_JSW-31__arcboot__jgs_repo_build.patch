+
+#ifndef _SOC_H_
+#define _SOC_H_
+
+enum region_idx {
+	REGION_ICCM_IDX = 0,
+	REGION_HBW_0_IDX = 1,
+	REGION_HBW_1_IDX = 2,
+	REGION_HBW_2_IDX = 3,
+	REGION_HBW_3_IDX = 4,
+	REGION_HBW_4_IDX = 5,
+	REGION_HBW_5_IDX = 6,
+	REGION_FW_MEM_IDX = 7,
+	REGION_DCCM_IDX = 8,
+	REGION_GEN_MEM_IDX = 9,
+	REGION_GT_TILE_0_IDX = 10,
+	REGION_GT_TILE_1_IDX = 11,
+	REGION_GT_TILE_2_IDX = 12,
+	REGION_GT_TILE_3_IDX = 13,
+	REGION_LBW_DBG_IDX = 14,
+	REGION_LBW_CFG_IDX = 15,
+};
+
+enum gpio_func {
+	GPIO_FUNC_0,
+	GPIO_FUNC_1,
+	GPIO_FUNC_2,
+	GPIO_FUNC_3,
+};
+
+#define REGION_BASE_ADDR(REG_IDX)	(REG_IDX << 28)
+#define SZ_16				0x00000010
+#define SZ_32K				0x00008000
+#define SZ_64K				0x00010000
+#define SZ_128K				0x00020000
+#define SZ_256K				0x00040000
+#define SZ_1MB				0x00100000
+#define SZ_4MB				0x00400000
+#define SZ_256MB			0x10000000
+#define SZ_1G				0x40000000
+
+#define FLASH_VALID_MASK		0x1FFFFF
+
+#define ARC_REG_BASE_MASK	REGION_BASE_ADDR(0xF)
+#define HL_CFG_BASE			REGION_BASE_ADDR(REGION_LBW_CFG_IDX)
+#define HL_CFG_SIZE			SZ_256MB   /* 256MB */
+
+#define HL_ICCM_BASE			REGION_BASE_ADDR(REGION_ICCM_IDX)
+#define HL_ICCM_SIZE			0x40000   /* 256KB */
+
+#define HL_DCCM_BASE			REGION_BASE_ADDR(REGION_DCCM_IDX)
+#define HL_DCCM_SIZE			0x20000   /* 128KB */
+
+#define HL_FW_MEM_REGION_BASE		REGION_BASE_ADDR(REGION_FW_MEM_IDX)
+#define HL_FW_MEM_OFFSET		0x8800000
+#define HL_FW_MEM_BASE			(HL_FW_MEM_REGION_BASE + HL_FW_MEM_OFFSET)
+#define HL_FW_MEM_SIZE			SZ_4MB
+
+#define HL_GEN_MEM_BASE			REGION_BASE_ADDR(REGION_GEN_MEM_IDX)
+#define HL_FLASH_OFFSET			0xF000000
+#define HL_FLASH_SIZE			(16 * SIZE_MB)
+
+/* Below definitions are applicable to IO Die 0 only */
+#define RST_ARC_ICCM_OFFSET		0x0000000
+#define RST_ARC_ICCM_SIZE		SZ_64K
+#define RST_ARC_DCCM_OFFSET		0x0010000
+#define RST_ARC_DCCM_SIZE		SZ_32K
+#define MNG_ARC_ICCM_OFFSET		0x0040000
+#define MNG_ARC_ICCM_SIZE		SZ_256K
+#define MNG_ARC_DCCM_OFFSET		0x0080000
+#define MNG_ARC_DCCM_SIZE		SZ_128K
+#define PID_ARC_ICCM_OFFSET		0x00C0000
+#define PID_ARC_ICCM_SIZE		SZ_128K
+#define PID_ARC_DCCM_OFFSET		0x00E0000
+#define PID_ARC_DCCM_SIZE		SZ_64K
+#define MISC_ARC_ICCM_OFFSET		0x0100000
+#define MISC_ARC_ICCM_SIZE		SZ_256K
+#define MISC_ARC_DCCM_OFFSET		0x0140000
+#define MISC_ARC_DCCM_SIZE		SZ_64K
+#define SBROM_OFFSET			0x0180000
+#define SBROM_SIZE			SZ_128K
+#define PSOC_FWSRAM_OFFSET		0x01A0000
+#define PSOC_FWSRAM_SIZE		SZ_128K
+#define SCRATCHPAD_SRAM_OFFSET		0x0200000
+#define SCRATCHPAD_SRAM_SIZE		SZ_1MB
+#define CXL_ARC_ICCM_OFFSET		0x0300000
+#define CXL_ARC_ICCM_SIZE		SZ_256K
+#define CXL_ARC_DCCM_OFFSET		0x0340000
+#define CXL_ARC_DCCM_SIZE		SZ_256K
+#define PCIE_FWSRAM_OFFSET		0x0380000
+#define PCIE_FWSRAM_SIZE		SZ_64K
+
+#define GEN_MEM_FULL_BASE		0x300007f00000000ull
+#define CFG_MEM_FULL_BASE		0x300007ff0000000ull
+#define FULL_ADDR_MSB			0x300007F
+#define FW_MEM_BASE_FULL		0x300007FF8800000ull
+#define SCRATCHPAD_SRAM_BASE		(HL_FW_MEM_BASE + SCRATCHPAD_SRAM_OFFSET)
+#define SCRATCHPAD_SRAM_BASE_FULL	(FW_MEM_BASE_FULL + SCRATCHPAD_SRAM_OFFSET)
+#define RST_ARC_ICCM_FULL_BASE		(FW_MEM_BASE_FULL + RST_ARC_ICCM_OFFSET)
+#define MNG_ARC_ICCM_FULL_BASE		(FW_MEM_BASE_FULL + MNG_ARC_ICCM_OFFSET)
+#define PID_ARC_ICCM_FULL_BASE		(FW_MEM_BASE_FULL + PID_ARC_ICCM_OFFSET)
+#define MISC_ARC_ICCM_FULL_BASE		(FW_MEM_BASE_FULL + MISC_ARC_ICCM_OFFSET)
+#define CXL_ARC_ICCM_FULL_BASE		(FW_MEM_BASE_FULL + CXL_ARC_ICCM_OFFSET)
+#define PSOC_FW_SRAM_FULL_BASE		(FW_MEM_BASE_FULL + PSOC_FWSRAM_OFFSET)
+
+#define RST_ARC_MEM_SIZE		(RST_ARC_ICCM_SIZE + RST_ARC_DCCM_SIZE)
+#define MNG_ARC_MEM_SIZE		(MNG_ARC_ICCM_SIZE + MNG_ARC_DCCM_SIZE)
+#define PID_ARC_MEM_SIZE		(PID_ARC_ICCM_SIZE + PID_ARC_DCCM_SIZE)
+#define MISC_ARC_MEM_SIZE		(MISC_ARC_ICCM_SIZE + MISC_ARC_DCCM_SIZE)
+#define CXL_ARC_MEM_SIZE		(CXL_ARC_ICCM_SIZE + CXL_ARC_DCCM_SIZE)
+
+#define CONV_64B_TO_ARC_FW_MEM(addr)	((addr & 0x3FFFFF) + HL_FW_MEM_BASE)
+
+/* This 2 macro's to convert ARC based 32B address to LBW MEM map address of 32B */
+#define CONV_ARC_REG_TO_GEN_MEM(addr)	(((addr) & 0xFFFFFFF) + ((GEN_MEM_FULL_BASE) & 0xFFFFFFFF))
+#define CONV_ARC_REG_TO_CFG_MEM(addr)	(((addr) & 0xFFFFFFF) + ((CFG_MEM_FULL_BASE) & 0xFFFFFFFF))
+
+#define SPI_MANIFEST_IMG_0_FLASH_OFFSET		(0x0)
+/* manifest 0 boot pointers are DMA trans to MNG ARC ICCM at offset 0 */
+#define SPI_MANIFEST_IMG_0_ICCM_OFFSET		(0)
+#define SPI_MANIFEST_IMG_0_OFFSET		(MNG_ARC_ICCM_OFFSET + SPI_MANIFEST_IMG_0_ICCM_OFFSET)
+#define SPI_MANIFEST_IMG_0_DMA_DEST		(FW_MEM_BASE_FULL + SPI_MANIFEST_IMG_0_OFFSET)
+/* 32Bit arc viewpoint address of manifest 0 stored in ICCM */
+#define SPI_MANIFEST_IMG_0_DMA_DEST_ARC		(HL_FW_MEM_BASE + SPI_MANIFEST_IMG_0_OFFSET)
+
+#define SPI_MANIFEST_IMG_1_FLASH_OFFSET		(0x200000)
+/* manifest 1 boot pointers are DMA trans to MNG ARC ICCM at offset 64K */
+#define SPI_MANIFEST_IMG_1_ICCM_OFFSET		SZ_64K
+#define SPI_MANIFEST_IMG_1_OFFSET		(MNG_ARC_ICCM_OFFSET + SPI_MANIFEST_IMG_1_ICCM_OFFSET)
+#define SPI_MANIFEST_IMG_1_DMA_DEST		(FW_MEM_BASE_FULL + SPI_MANIFEST_IMG_1_OFFSET)
+/* 32Bit arc viewpoint address of manifest 1 stored in ICCM */
+#define SPI_MANIFEST_IMG_1_DMA_DEST_ARC		(HL_FW_MEM_BASE + SPI_MANIFEST_IMG_1_OFFSET)
+
+/* For Fake fuse manifest */
+#define SPI_MANIFEST_IMG_2_ICCM_OFFSET	SZ_128K
+#define SPI_MANIFEST_IMG_2_OFFSET		(MNG_ARC_ICCM_OFFSET + SPI_MANIFEST_IMG_2_ICCM_OFFSET)
+#define SPI_MANIFEST_IMG_2_DMA_DEST		(FW_MEM_BASE_FULL + SPI_MANIFEST_IMG_2_OFFSET)
+/* 32Bit arc viewpoint address of manifest 2 stored in ICCM */
+#define SPI_MANIFEST_IMG_2_DMA_DEST_ARC		(HL_FW_MEM_BASE + SPI_MANIFEST_IMG_2_OFFSET)
+
+#endif /* _SOC_H_ */
