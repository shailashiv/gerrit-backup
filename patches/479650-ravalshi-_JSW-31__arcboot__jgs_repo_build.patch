diff --git a/arch/jgs/arc/slave.c b/arch/jgs/arc/slave.c
new file mode 100644
index 0000000..70dc582
--- /dev/null
+++ b/arch/jgs/arc/slave.c
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2024 HabanaLabs Ltd.
+ * All Rights Reserved.
+ */
+
+#include <boot_rom.h>
+#include <status.h>
+#include <delay.h>
+#include <mem_io.h>
+#include <recovery.h>
+#include <global_conf_regs.h>
+#include <global_conf_masks.h>
+#include <jgs_blocks_linux_driver.h>
+#include <psoc_boot_conf_regs.h>
+#include <psoc_boot_conf_masks.h>
+#include <jgs_reg_map.h>
+#include <dev_uart.h>
+#include <spi_flash.h>
+#include <jgs_fw_if.h>
+
+#define SPI_FUSE_EMULATION_DATA_UDELAY	5000 /* 5ms */
+
+void boot_rom_wait_for_recovery_in(void)
+{
+	uint32_t val;
+
+	boot_rom_putc('r');
+
+	/*
+	 * TODO: IO Die0 RECOVERY_MODE is connected to it's 2 nighbour Compute Die's?
+	 * or, IO Die0 to all slave Die's?
+	 */
+
+	/* Unmask the MASK_0 RECOVERY_MODE bit, if masked */
+	val = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_D2D_GPIO_UP_MASK_0));
+	if ((val & PSOC_BOOT_CONF_D2D_GPIO_UP_MASK_0_RECOVERY_MODE_M) != 0) {
+		val &= ~(PSOC_BOOT_CONF_D2D_GPIO_UP_MASK_0_RECOVERY_MODE_M);
+		regmap_writel(val, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_D2D_GPIO_UP_MASK_0));
+	}
+
+	/* Unmask the MASK_1 RECOVERY_MODE bit, if masked */
+	val = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_D2D_GPIO_UP_MASK_1));
+	if ((val & PSOC_BOOT_CONF_D2D_GPIO_UP_MASK_1_RECOVERY_MODE_M) != 0) {
+		val &= ~(PSOC_BOOT_CONF_D2D_GPIO_UP_MASK_1_RECOVERY_MODE_M);
+		regmap_writel(val, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_D2D_GPIO_UP_MASK_1));
+	}
+
+	while(1) {
+		val = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_D2D_GPIO_UP));
+		if ((val & PSOC_BOOT_CONF_D2D_GPIO_UP_MASK_0_RECOVERY_MODE_M) != 0) {
+			udelay(RECOVERY_PULSE_DURATION);
+			break;
+		}
+	}
+}
+
+void boot_rom_wait_for_signal(void)
+{
+	if (boot_rom_global.die_type == FS1_IO_DIE_MASTER)
+		return;
+
+	boot_rom_status_update(PROGRESS_SLV_DIE_WAITING_ON_RECOVERY_IND);
+
+	boot_rom_wait_for_recovery_in();
+
+	execute_recovery();
+}
+
+void boot_rom_wait_for_spi_fuse_data(void)
+{
+	uint64_t start;
+	uint32_t val;
+
+	start = boot_rom_get_ts_us();
+	while (1) {
+		val = regmap_readl(IO0_H0_PSOC_GLOBAL_CONF(mmGLOBAL_CONF_SCRATCHPAD_2));
+		if (val == FFUSE_WRITE_IND_MAGIC)
+			break;
+
+		if (boot_rom_timeout_expired(start, SPI_FUSE_EMULATION_DATA_UDELAY)) {
+			boot_rom_status_update(PROGRESS_INIT_EFUSE_SPI_SLV_TIMEDOUT);
+			return;
+		}
+	}
+
+	boot_rom_global.config_fuse = regmap_readl(IO0_H0_PSOC_GLOBAL_CONF(mmGLOBAL_CONF_SCRATCHPAD_0));
+	boot_rom_global.config2_fuse = regmap_readl(IO0_H0_PSOC_GLOBAL_CONF(mmGLOBAL_CONF_SCRATCHPAD_1));
+}
