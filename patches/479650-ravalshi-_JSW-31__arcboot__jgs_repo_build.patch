new file mode 100644
index 0000000..72c5787
--- /dev/null
+++ b/arch/jgs/arc/dev_recovery.c
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2024 HabanaLabs Ltd.
+ * All Rights Reserved.
+ */
+
+#include <boot_rom.h>
+#include <recovery.h>
+#include <jgs_reg_map.h>
+#include <jgs_blocks_linux_driver.h>
+#include <global_conf_masks.h>
+#include <d2d_ctl_regs.h>
+#include <global_conf_regs.h>
