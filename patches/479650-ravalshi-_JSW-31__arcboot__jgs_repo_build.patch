+static void security_rr_jtag_config(bool enable)
+{
+	uint32_t rr_idx;
+
+	security_program_sai_levels(initiator_data[SECURITY_INITIATOR_JTAG_MSTR],
+			SECURITY_JTAG_LBW_SAI_VALUE);
