From 2c128207b332128da50deabd5a2cd09494ce44e3 Mon Sep 17 00:00:00 2001
From: Abhishek <apatgaonkar@habana.ai>
Date: Thu, 25 Nov 2021 09:48:50 +0200
Subject: [PATCH] Revert "[SW-60588] gaudi2: add pcie lbw/hbw err indication"

This reverts commit 13dc485ebb7501bb5edb921f1d8599694a51ad98.

Change-Id: I52a9e0b712de21e975a87cc16d4856cd4e0a0fce
---

diff --git a/arch/gaudi2/common/common.c b/arch/gaudi2/common/common.c
index 465d1ed..7029512 100644
--- a/arch/gaudi2/common/common.c
+++ b/arch/gaudi2/common/common.c
@@ -1030,14 +1030,11 @@
  */
 void check_razwi_intr(void)
 {
-	u32 reg = regmap_readl(mmPCIE_WRAP_PCIE_IC_SEI_INTR_IND);
-	u32 bitmask = reg & PCIE_AXI_ERR_INTR_BIT;
+	u32 reg = 0;
 
-	if (bitmask) {
+	reg = regmap_readl(mmPCIE_WRAP_PCIE_IC_SEI_INTR_IND);
+	if (reg & PCIE_AXI_ERR_INTR_BIT)
 		regmap_writel(RAZWI_INTR_STATUS_PATTERN, mmGIC_RAZWI_STATUS_REG);
-		/* Reset the indication */
-		regmap_writel(reg & ~bitmask, mmPCIE_WRAP_PCIE_IC_SEI_INTR_IND);
-	}
 }
 
 u32 dev_pci_dbi_cfg_offset_get(void)
