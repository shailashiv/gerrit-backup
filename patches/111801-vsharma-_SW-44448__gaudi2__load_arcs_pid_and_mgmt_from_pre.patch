-	RUN_ARC(1);
 }
 
-static void fit_copy_arc_image(u64 dst, const void *buf, int len)
+static void sp_sram_to_arc_mem_cpy(u64 dst, u32 len)
 {
-	/* TODO: copy images once zephyr support is added */
-	return;
+	u32 mem_cfg, cpy_sts;
+	u64 start;
+
+	/* Set source and destination address in memcopy block */
+	regmap_writel((u32)dst, mmPSOC_GLOBAL_CONF_MEM_CPY_DEST_ADDR_L);
+	regmap_writel((u32)(dst >> 32), mmPSOC_GLOBAL_CONF_MEM_CPY_DEST_ADDR_H);
+	regmap_writel((u32)HL_SP_SRAM_BASE_FULL,
+			mmPSOC_GLOBAL_CONF_MEM_CPY_START_ADDR_L);
+	regmap_writel((u32)(HL_SP_SRAM_BASE_FULL >> 32),
+			mmPSOC_GLOBAL_CONF_MEM_CPY_START_ADDR_H);
+
+
+	/* Align length to 16 bytes */
+	if (len % 16)
+		len += (16 - (len % 16));
+
+	/* Set length in memcopy register in granuality of 16 bytes */
+	len = len >> 4;
+	mem_cfg = regmap_readl(mmPSOC_GLOBAL_CONF_MEM_CPY_CTRL2);
+	mem_cfg &= ~(PSOC_GLOBAL_CONF_MEM_CPY_CTRL2_USE_CONST_MASK);
+	mem_cfg &= ~(PSOC_GLOBAL_CONF_MEM_CPY_CTRL2_MEM_SIZE_MASK);
+	mem_cfg |= (len & PSOC_GLOBAL_CONF_MEM_CPY_CTRL2_MEM_SIZE_MASK);
+	regmap_writel(mem_cfg, mmPSOC_GLOBAL_CONF_MEM_CPY_CTRL2);
+
+	/* Enable copy and wait for completion */
+	regmap_writel(0x1, mmPSOC_GLOBAL_CONF_MEM_CPY_CTRL);
+	start = timestamp_get_us();
+	while (1) {
+		cpy_sts = regmap_readl(mmPSOC_GLOBAL_CONF_MEM_CPY_STATUS);
+		if (cpy_sts)
+			break;
+		/* If copy does not happen in 5 seconds
+		 * timeout and return
+		 */
+		if (timeout_expired(start, MEM_CPY_TIMEOUT_US)) {
+			preboot_puts("Timed-out waiting for mem_cpy\n");
+			break;
+		}
+	}
+}
+
+static void fit_copy_arc_image(u64 dst, const void *buf, int length)
+{
+	u32 len;
+	u8 j = 0;
+	const void *copy_loc;
 
 	/*
-	 * initialize scratch SRAM to avoid ECC exceptions
-	 * ECC errors are observed due to byte copy to SP
-	 * memory which turns to be read-modify-write transaction
+	 * Since in gaudi2 iccm size is 128K and SP sram is 64K, if image len
+	 * is more than HL_SP_SRAM_SIZE then split and copy
 	 */
-	init_sp_sram();
+	do {
+		len = (length / HL_SP_SRAM_SIZE) ?
+			HL_SP_SRAM_SIZE : (length % HL_SP_SRAM_SIZE);
+		copy_loc = (void *)((u8 *)(buf) + (j * HL_SP_SRAM_SIZE));
+		dst += (j * HL_SP_SRAM_SIZE);
 
-	/* TODO: Add later */
+		/*
+		 * Copy FIT arc image to scratchpad SRAM base. This is required
+		 * for using memcopy block as memcopy requires source and
+		 * destination addressess to be 16 bytes aligned.
+		 */
+		memcpy((void *)HL_SP_SRAM_BASE, copy_loc, len);
+
+		/*
+		 * Copy from scratchpad SRAM to ICCM/DCCM using memcopy block.
+		 */
+		sp_sram_to_arc_mem_cpy(dst, len);
+
+		length -= len;
+		j++;
+	} while (length > 0);
 }
 
 void preboot_copy_image(u64 dst, const void *buf, int len, const char *arch)
