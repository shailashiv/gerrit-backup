diff --git a/common/preboot.h b/common/preboot.h
deleted file mode 100644
index cfef8ed..0000000
--- a/common/preboot.h
+++ /dev/null
@@ -1,79 +0,0 @@
-/*
- * Copyright (C) 2017 HabanaLabs Ltd.
- *   Author: Noam Camus <noamikong@gmail.com>
- *
- * SPDX-License-Identifier:     GPL-2.0+
- */
-
-#ifndef COMMON_PREBOOT_H_
-#define COMMON_PREBOOT_H_
-
-#define BIT(nr)					(1 << (nr))
-#define ARRAY_SIZE(x)				(sizeof(x) / sizeof((x)[0]))
-
-#ifdef __arc__
-#define HL_SPI_BASE				0x1A000000
-#define HL_CFG_BASE				0x1C000000
-#define SDRAM_BASE				0x10000000
-#define SPL_TEXT_BASE				0x10080000
-#endif
-
-#ifdef __aarch64__
-#define HL_SPI_BASE				0x7FF8000000ull
-#define HL_CFG_BASE				0x7FFC000000ull
-#define SDRAM_BASE				0x7FF0000000ull
-#define SPL_TEXT_BASE				0x7FF0080000ull
-#endif
-
-#define PREBOOT_VER_BASE			(SPL_TEXT_BASE - 0x1000)
-
-#define SPL_SIZE		0x10000		/* 64KB */
-#define HL_UART_BAUDRATE	115200
-#define HL_SPI_FLASH_MAX_FREQ	25000000
-#define HL_SPI_NEXT_IMAGE_OFF	0x60000
-#define HL_SPI_MODIFI_IMAGE_OFF	0x60004
-#define HL_SPI_SPL_OFF		0xA0000
-#define HL_SPI_UBOOT_OFF	0xB0000
-#define HL_SPI_PRIMARY_BASE	0
-#define HL_SPI_SECONDARY_BASE	0x800000
-
-typedef unsigned char u8;
-typedef unsigned int u32;
-typedef unsigned long long u64;
-
-static inline u8 regmap_readb(u32 offset)
-{
-	u32 reg = *((volatile u32 *)(HL_CFG_BASE + offset));
-
-	return (u8)(reg & 0xFF);
-}
-
-static inline void regmap_writeb(u8 val, u32 offset)
-{
-	*((volatile u32 *)(HL_CFG_BASE + offset)) = (u32)val;
-}
-
-static inline u32 regmap_readl(u32 offset)
-{
-	u32 reg = *((volatile u32 *)(HL_CFG_BASE + offset));
-
-	return reg;
-}
-
-static inline void regmap_writel(u32 val, u32 offset)
-{
-	*((volatile u32 *)(HL_CFG_BASE + offset)) = val;
-}
-
-u32 get_cpu_boot_status_reg(void);
-u32 get_upd_pending_sts_reg(void);
-u32 hl_skip_pcie_init(void);
-void hl_uart_init(void);
-u32 hl_spi_baudr_get(void);
-
-void preboot_pcie_wait_for_link(void);
-void preboot_delay(void);
-void preboot_putc_virt_uart(const char c);
-void preboot_sync_btl(void);
-
-#endif /* COMMON_PREBOOT_H_ */
