From a3b4c1c9363a1f29bf74fba993043ff0201369a5 Mon Sep 17 00:00:00 2001
From: Varun Sharma <vsharma@habana.ai>
Date: Thu, 09 Nov 2023 10:32:19 +0200
Subject: [PATCH] [SW-156330] gaudi2: move tpm code to common

This patch moves tpm code to common so that it can be used
for future platforms like gaudi3 also.

Change-Id: I948bfd7676e9c4e7a7710a0fc613280512023f36
Signed-off-by: Varun Sharma <vsharma@habana.ai>
---

diff --git a/arch/fs1/arc/common.c b/arch/fs1/arc/common.c
index 5e3849a..58ea82f 100644
--- a/arch/fs1/arc/common.c
+++ b/arch/fs1/arc/common.c
@@ -27,6 +27,7 @@
 #include <parc_global_conf_regs.h>
 #include <parc_global_conf_masks.h>
 #include <fs1_blocks_linux_driver.h>
+#include <fs1_security.h>
 
 #include <baremetal.h>
 #include <bitops.h>
@@ -390,3 +391,8 @@
 {
 	preboot_pcie_wait_for_link();
 }
+
+uint8_t get_ppboot_pcr_index(void)
+{
+	return TPM2_PPBOOT_PCR_IDX;
+}
diff --git a/arch/gaudi2/arc/common.c b/arch/gaudi2/arc/common.c
index 628bcb3..ffc622e 100644
--- a/arch/gaudi2/arc/common.c
+++ b/arch/gaudi2/arc/common.c
@@ -315,16 +315,6 @@
 		return spi_flash_readl(FLASH_PREBOOT_PRIMARY_OFFSET);
 }
 
-__weak int tpm_pcr_extend(uint32_t image_index, uint8_t *hash)
-{
-	return -1;
-}
-
-__weak int tpm_init(bool print)
-{
-	return -1;
-}
-
 /* SPI DMA can transfer max of data (64KB-8) = 0xFFF8 + (additional CRC)
  * But destination is 16 byte aligned. So, setting max as (64K-16) (excluding CRC)
  */
@@ -944,22 +934,7 @@
 	security_enable_jtag_if();
 }
 
-static void gaudi2_get_ppboot_data(uint8_t **offset)
-{
-	uint32_t ppboot_pcie_size;
-
-	ppboot_pcie_size = *(uint32_t *)(HL_FWSRAM_BASE);
-
-	ppboot_pcie_size -= SIG_SIZE;
-	ppboot_pcie_size -= CRC32_SIZE;
-	ppboot_pcie_size -= TOTAL_PUB_KEY_PROPS_SZ;
-	ppboot_pcie_size -= PPBOOT_SHA384_FOOTER;
-	ppboot_pcie_size -= PPBOOT_HASH_MAGIC_SIZE;
-
-	*offset = (uint8_t *)(HL_FWSRAM_BASE + ppboot_pcie_size);
-}
-
-static bool is_ppboot_tpm_extend_done(void)
+bool is_ppboot_tpm_extend_done(void)
 {
 	uint32_t reg = regmap_readl(mmPSOC_SECURITY_SW_STATUS_1);
 	uint32_t mask = (PROGRESS_ARCBOOT_EROM_TPM_FINISH & 0x1F);
@@ -967,34 +942,9 @@
 	return !!(reg & BIT(mask));
 }
 
-void ppboot_tpm_extend(void)
+uint8_t get_ppboot_pcr_index(void)
 {
-	uint8_t *data;
-	uint32_t magic;
-	uint8_t hash[SHA384_SUM_LEN] = { 0 };
-
-	/* return if erom has already done ppboot tpm extend */
-	if (is_ppboot_tpm_extend_done())
-		return;
-
-	if (tpm_init(true))
-		return;
-
-	if (tpm_startup())
-		return;
-
-	gaudi2_get_ppboot_data(&data);
-
-	memcpy(&magic, data, PPBOOT_HASH_MAGIC_SIZE);
-
-	if (magic != PPBOOT_SHA_MAGIC) {
-		preboot_puts("no ppboot sha magic found\n");
-		return;
-	}
-
-	memcpy(hash, data + PPBOOT_HASH_MAGIC_SIZE, SHA384_SUM_LEN);
-
-	tpm_pcr_extend(TPM2_PPBOOT_PCR_IDX, hash);
+	return TPM2_PPBOOT_PCR_IDX;
 }
 
 struct hl_boot_info_desc *hl_boot_info_get_desc(u32 idx)
