From 384f35df3610ee7566e738605693377a7641297a Mon Sep 17 00:00:00 2001
From: Abhishek <apatgaonkar@habana.ai>
Date: Wed, 13 Mar 2024 05:12:37 +0200
Subject: [PATCH] [FSW-402] fs1: bootrom_init: add timestamp logic

This patch adds timestamp init and measurement logic.
All functions which are doing register operations are
moved to dev specific files.

Change-Id: I80e53cbed58d5777fbf327c48e144e681b53f817
---

diff --git a/arch/fs1/arc/Makefile b/arch/fs1/arc/Makefile
index b1560aa..1fb9400 100644
--- a/arch/fs1/arc/Makefile
+++ b/arch/fs1/arc/Makefile
@@ -2,4 +2,7 @@
 BOOT_ROM_CFLAGS += -I$(SPECS_H15_DIR)
 BOOT_ROM_CFLAGS += -I$(SPECS_H15_DIR)/$(SPECS_DEV)/asic_reg
 
-BINARIES = boot_rom.bin
\ No newline at end of file
+BINARIES = boot_rom.bin
+
+BOOT_ROM_COMMON_SRCS_C += $(shell ls $(HL_DEV_ARCH)/dev_delay.c)
+
diff --git a/arch/fs1/arc/dev_delay.c b/arch/fs1/arc/dev_delay.c
new file mode 100644
index 0000000..b265f6e
--- /dev/null
+++ b/arch/fs1/arc/dev_delay.c
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2023 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <boot_rom.h>
+#include <mem_io.h>
+#include <fs1_blocks_linux_driver.h>
+#include <fs1_reg_map.h>
+#include <timestamp_regs.h>
+#include <timestamp_masks.h>
+
+void boot_rom_clear_ts_counter(void)
+{
+	regmap_writel(0x0, IO0_HALF0_PSOC_TIMESTAMP(mmTIMESTAMP_CNTCR));
+}
+
+void boot_rom_start_timer(uint32_t timestamp_freq)
+{
+	regmap_writel(timestamp_freq, IO0_HALF0_PSOC_TIMESTAMP(mmTIMESTAMP_CNTFID0));
+	regmap_writel((TIMESTAMP_CNTCR_CNTCR_EN_M | TIMESTAMP_CNTCR_CNTCR_HDBG_M),
+		      IO0_HALF0_PSOC_TIMESTAMP(mmTIMESTAMP_CNTCR)); /* EN | HDBG */
+}
+
+uint64_t boot_rom_get_timestamp_freq(void)
+{
+	/* TODO: Confirm timestamp frequency is always constant */
+	return SYS_REF_CLOCK / 2;
+}
+
+uint64_t boot_rom_udelay_get_ts(void)
+{
+	uint32_t low, up1, up2;
+
+	up1 = regmap_readl(IO0_HALF0_PSOC_TIMESTAMP(mmTIMESTAMP_CNTCVU));
+	low = regmap_readl(IO0_HALF0_PSOC_TIMESTAMP(mmTIMESTAMP_CNTCVL));
+	up2 = regmap_readl(IO0_HALF0_PSOC_TIMESTAMP(mmTIMESTAMP_CNTCVU));
+	/* In case of overlap read low part again */
+	if (up1 != up2)
+		low = regmap_readl(IO0_HALF0_PSOC_TIMESTAMP(mmTIMESTAMP_CNTCVL));
+
+	return ((uint64_t)up2 << 32) + low;
+}
