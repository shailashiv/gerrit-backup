From 4fd42be1b0f17051e5e32198d164c70d7308530b Mon Sep 17 00:00:00 2001
From: Vitaly Margolin <vmargolin@habana.ai>
Date: Sat, 17 May 2025 13:22:52 +0300
Subject: [PATCH] [SW-228057] g3: serdes: return error if no hbm heap

Return error if HBM heap is not initialized.

Change-Id: I67999d683236101d3f69337bd28fabe62f3b0271
Signed-off-by: Vitaly Margolin <vmargolin@habana.ai>
---

diff --git a/src/hl_serdes/gaudi3/serdes.c b/src/hl_serdes/gaudi3/serdes.c
index 86712af..3922959 100644
--- a/src/hl_serdes/gaudi3/serdes.c
+++ b/src/hl_serdes/gaudi3/serdes.c
@@ -140,8 +140,8 @@
 
 	rc = -ENOMEM;
 	if (!sys_heap_hbm) {
-		LOG_INF("Serdes: HBM heap not available");
-		return 0;
+		LOG_ERR("Serdes: HBM heap not available");
+		goto val_error;
 	}
 
 	buf = sys_heap_alloc(sys_heap_hbm, size);
