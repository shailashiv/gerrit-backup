From 197843e0519672564d3ccf7ea7db451bb90ee36d Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Thu, 30 Apr 2020 22:32:05 +0300
Subject: [PATCH] [SW-0] goya2_arc: fix comment

uboot_start() function loads U-Boot, not Preboot - fix the comment.

Change-Id: I6181210517f9966d3666a08266ca45565328b95f
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/goya2_arc/common.c b/goya2_arc/common.c
index 454451e..333d12e 100644
--- a/goya2_arc/common.c
+++ b/goya2_arc/common.c
@@ -236,7 +236,7 @@
 void uboot_start(void)
 {
 	unsigned int lsb = 0xf0000000 | UBOOT_TEXT_BASE, msb = 0x7f;
-	/* Set CPU0 Reset address to PREBOOT */
+	/* Set CPU0 Reset address to U-Boot */
 	regmap_writel(lsb, mmCPU_CA53_CFG_RST_ADDR_LSB_0);
 	regmap_writel(msb, mmCPU_CA53_CFG_RST_ADDR_MSB_0);
 
