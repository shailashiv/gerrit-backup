From 36b9d32fd0fc9abc7e004bb0b3a6c8e844d5bdef Mon Sep 17 00:00:00 2001
From: Josh Fazekas <Josh.Fazekas@Intel.com>
Date: Fri, 23 May 2025 03:08:00 +0300
Subject: [PATCH] [SW-184431] g3: allocate real size for rma table

Change memory allocation for rma table to use actual rma table size
instead of fixed 25KB size

Change-Id: If00d281e453e58dbe5ae6dda06aadfd3a9970e83
Signed-off-by: Josh Fazekas <Josh.Fazekas@Intel.com>
---

diff --git a/fw-loader/src/main.c b/fw-loader/src/main.c
index e94212c..85cfd58 100644
--- a/fw-loader/src/main.c
+++ b/fw-loader/src/main.c
@@ -95,8 +95,7 @@
 }
 
 #if defined(CONFIG_HL_SHELL_RMA)
-#define RMA_TABLE_SIZE	(25 * 1024)
-static uint8_t rma_table[RMA_TABLE_SIZE];
+static uint8_t rma_table[RMA_MAX_TOTAL_SZ];
 
 static int rma_shadow_init(void)
 {
