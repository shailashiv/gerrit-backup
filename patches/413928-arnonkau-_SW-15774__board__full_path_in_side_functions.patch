-	sed ${ITS_SED_PARAMS} ${EROM_ITS_TEMPLATE} > ${DEV_PREFIX}-erom.its
-	$MKIMAGE_FILE -f ${DEV_PREFIX}-erom.its ${ITB_FILE}
