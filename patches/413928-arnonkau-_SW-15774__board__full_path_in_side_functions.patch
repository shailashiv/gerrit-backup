 function hl_objcopy_sections() {
-	local PREFIX=$1
+	local FILEFULLPATH=$1
+	local FILENAME=$(basename ${FILEFULLPATH})
+	local FILEPATH=$(dirname ${FILEFULLPATH})
+	#local EXT=${FILENAME##*.}
+	local PREFIX=${FILENAME%.*}
 	local ALIGN=$2
 	local MEM=$3
 	local SECTIONS=${*:4}
 
 	${OBJCOPY} -S --gap-fill 0xff --output-target=binary --remove-section=.comment\
-	$(echo -n $SECTIONS | sed 's/[^ ]* */ --only-section=&/g') ${STAGE_DIR}/${PREFIX}.elf \
+	$(echo -n $SECTIONS | sed 's/[^ ]* */ --only-section=&/g') ${FILEPATH}/${PREFIX}.elf \
 	--set-section-flags=bss=alloc,load,contents --set-section-flags=.stack=alloc,load,contents\
 	${STAGE_DIR}/${PREFIX}-${MEM}.bin.int
 
 	dd status=none conv=sync bs=${ALIGN} if=${STAGE_DIR}/${PREFIX}-${MEM}.bin.int > \
-	${STAGE_DIR}/${PREFIX}-${MEM}.bin
+	${BINS_DIR}/${PREFIX}-${MEM}.bin
 
 	rm -f ${STAGE_DIR}/${PREFIX}-${MEM}.bin.int
 }
 
 function prep_image_pcie_pif {
-	local PIF_FILENAME=$1
-	local PREFIX=$(echo "$1" | cut -f 1 -d '.')
+	local FILEFULLPATH=$1
+	local FILENAME=$(basename ${FILEFULLPATH})
+	local FILEPATH=$(dirname ${FILEFULLPATH})
+	local PREFIX=${FILENAME%.*}
+	#local EXT=${FILENAME##*.}
+	local PREFIX=${FILENAME%.*}
 	local ICCM_SECTIONS=(.ivt .text)
 	local DCCM_SECTIONS=(.data .sdata .bss .stack)
 
 	# Align ICCM and DCCM binary to 16 bytes to comply with CCM ECC data bank size
-	hl_objcopy_sections ${PREFIX} 16 "iccm" ${ICCM_SECTIONS[@]}
-	hl_objcopy_sections ${PREFIX} 16 "dccm" ${DCCM_SECTIONS[@]}
+	hl_objcopy_sections ${FILEFULLPATH} 16 "iccm" ${ICCM_SECTIONS[@]}
+	hl_objcopy_sections ${FILEFULLPATH} 16 "dccm" ${DCCM_SECTIONS[@]}
 
-	hl_pack_bin ${PREFIX}-iccm.bin 4k 0 0 0
-	hl_pack_bin ${PREFIX}-dccm.bin 4k 0 0 0
-
-	swap_file ${DEV_PREFIX}-${PIF_ICCM_BINFILE}.le ${DEV_PREFIX}-${PIF_ICCM_BINFILE}.be
-	swap_file ${DEV_PREFIX}-${PIF_DCCM_BINFILE}.le ${DEV_PREFIX}-${PIF_DCCM_BINFILE}.be
+	hl_pack_bin ${BINS_DIR}/${PREFIX}-iccm.bin 4k 0 0 0
+	hl_pack_bin ${BINS_DIR}/${PREFIX}-dccm.bin 4k 0 0 0
+	swap_file ${BINS_DIR}/${DEV_PREFIX}-${PIF_ICCM_BINFILE}.le ${BINS_DIR}/${DEV_PREFIX}-${PIF_ICCM_BINFILE}.be
+	swap_file ${BINS_DIR}/${DEV_PREFIX}-${PIF_DCCM_BINFILE}.le ${BINS_DIR}/${DEV_PREFIX}-${PIF_DCCM_BINFILE}.be
 }
 
 function hl_pad_arcboot_rom {
-	mv ${ARCBOOT_BINFILE} ${ARCBOOT_BINFILE_ORIG}
+	mv ${BINS_DIR}/${ARCBOOT_BINFILE} ${BINS_DIR}/${ARCBOOT_BINFILE_ORIG}
 
 	# pad arcboot rom binary to size of ROM memory
-	dd status=none conv=sync bs=128K if=${ARCBOOT_BINFILE_ORIG} > ${ARCBOOT_BINFILE}
+	dd status=none conv=sync bs=128K if=${BINS_DIR}/${ARCBOOT_BINFILE_ORIG} > ${BINS_DIR}/${ARCBOOT_BINFILE}
 }
