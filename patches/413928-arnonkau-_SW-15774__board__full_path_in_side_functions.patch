diff --git a/board/habanalabs/gaudi2_arc/post-image-spi.sh b/board/habanalabs/gaudi2_arc/post-image-spi.sh
index c580f09..9cdae33 100755
--- a/board/habanalabs/gaudi2_arc/post-image-spi.sh
+++ b/board/habanalabs/gaudi2_arc/post-image-spi.sh
@@ -83,11 +83,11 @@
 	OUT_NAME=$3
 
 	TMPNAME=${KEY_NAME}-${PROP_NAME}.txt
-	fdtget ${KEY_NAME}.dtb /signature/key-${KEY_NAME} rsa,${PROP_NAME} -t bx > ${TMPNAME}
-	sed 's/\s\+/\n/g' ${TMPNAME} > ${TMPNAME}.tmp
-	sed -e 's/\b[0-9]\b/0&/' -e 's/\b[a-f]\b/0&/' ${TMPNAME}.tmp  > ${TMPNAME}.tmp.le
-	xxd -r -p ${TMPNAME}.tmp.le > ${OUT_NAME}
-	rm -f ${TMPNAME}.*
+	fdtget ${KEY_NAME}.dtb /signature/key-${KEY_NAME} rsa,${PROP_NAME} -t bx > ${STAGE_DIR}/${TMPNAME}
+	sed 's/\s\+/\n/g' ${STAGE_DIR}/${TMPNAME} > ${STAGE_DIR}/${TMPNAME}.tmp
+	sed -e 's/\b[0-9]\b/0&/' -e 's/\b[a-f]\b/0&/' ${STAGE_DIR}/${TMPNAME}.tmp > ${STAGE_DIR}/${TMPNAME}.tmp.le
+	xxd -r -p ${STAGE_DIR}/${TMPNAME}.tmp.le > ${OUT_NAME}
+	rm -f ${STAGE_DIR}/${TMPNAME}.*
 }
 
 function hl_get_key_props {
@@ -385,11 +385,13 @@
 
 function prep_erom_with_crc {
 	BINFILE=$1
-	cat ${BINFILE}>${BINFILE}.tmp.pad
-	dd status=none conv=sync bs=16 if=${BINFILE}.tmp.pad of=${BINFILE}.tmp.algn
-	hl_calc_crc32 ${BINFILE}.tmp.algn
-	cat ${BINFILE}.tmp.algn ${BINFILE}.tmp.algn.crc32 > ${DEV_PREFIX}-${BINFILE}
-	rm -rf ${BINFILE}.tmp*
+	local BINFILE_BASE=$(basename ${BINFILE})
+
+	cat ${BINFILE}>${STAGE_DIR}/${BINFILE_BASE}.tmp.pad
+	dd status=none conv=sync bs=16 if=${STAGE_DIR}/${BINFILE_BASE}.tmp.pad of=${STAGE_DIR}/${BINFILE_BASE}.tmp.algn
+	hl_calc_crc32 ${STAGE_DIR}/${BINFILE_BASE}.tmp.algn
+	cat ${STAGE_DIR}/${BINFILE_BASE}.tmp.algn ${STAGE_DIR}/${BINFILE_BASE}.tmp.algn.crc32 > ${BINS_DIR}/${DEV_PREFIX}-${BINFILE_BASE}
+	rm -rf ${STAGE_DIR}/${BINFILE_BASE}.tmp*
 }
 
