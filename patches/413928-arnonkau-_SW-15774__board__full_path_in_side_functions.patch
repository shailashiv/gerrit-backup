 function prep_image_erom {
 	local OUTF=$1
 	local HI_OFFSET=""
 
-	prep_erom_with_crc ${EROM_PCIE_BINFILE}
-	prep_erom_with_crc ${EROM_RECOVERY_BINFILE}
+	prep_erom_with_crc ${STAGE_DIR}/${EROM_PCIE_BINFILE}
+	prep_erom_with_crc ${STAGE_DIR}/${EROM_RECOVERY_BINFILE}
 
 	# create fit file with erom additional data
-	prep_erom_fit ${EROM_FIT_BINFILE}
-	prep_erom_with_crc ${EROM_FIT_BINFILE}
+	prep_erom_fit ${ITBS_DIR}/${EROM_FIT_BINFILE}
+	prep_erom_with_crc ${ITBS_DIR}/${EROM_FIT_BINFILE}
 
 	# Create erom image pointers binary
 	prep_image_ptrs_erom ${EROM_IMAGES_POINTERS_BINFILE}
@@ -418,27 +420,27 @@
 
 	if [ ${HL_TARGET} == "pldm" ]; then
 		#Create erom hex files for paladium
-		hl_pldm_flash_hex erom-binary-pcie ${DEV_PREFIX}-${EROM_PCIE_BINFILE}
-		hl_pldm_flash_hex erom-binary-recovery ${DEV_PREFIX}-${EROM_RECOVERY_BINFILE}
+		hl_pldm_flash_hex erom-binary-pcie ${BINS_DIR}/${DEV_PREFIX}-${EROM_PCIE_BINFILE} ${HEXS_DIR}
+		hl_pldm_flash_hex erom-binary-recovery ${BINS_DIR}/${DEV_PREFIX}-${EROM_RECOVERY_BINFILE} ${HEXS_DIR}
 
 		#Create erom image pointers hex files for paladium
-		hl_pldm_flash_hex erom-binary-img-ptr ${DEV_PREFIX}-${EROM_IMAGES_POINTERS_BINFILE}
+		hl_pldm_flash_hex erom-binary-img-ptr ${BINS_DIR}/${DEV_PREFIX}-${EROM_IMAGES_POINTERS_BINFILE} ${HEXS_DIR}
 	fi
 
 	# create little-endian binaries for ASIC / ONIX
-	cp -f ${DEV_PREFIX}-${EROM_PCIE_BINFILE} ${DEV_PREFIX}-${EROM_PCIE_BINFILE}.le
-	cp -f ${DEV_PREFIX}-${EROM_RECOVERY_BINFILE} ${DEV_PREFIX}-${EROM_RECOVERY_BINFILE}.le
-	cp -f ${DEV_PREFIX}-${EROM_FIT_BINFILE} ${DEV_PREFIX}-${EROM_FIT_BINFILE}.le
-	cp -f ${DEV_PREFIX}-${EROM_IMAGES_POINTERS_BINFILE} ${DEV_PREFIX}-${EROM_IMAGES_POINTERS_BINFILE}.le
+	cp -f ${BINS_DIR}/${DEV_PREFIX}-${EROM_PCIE_BINFILE} ${BINS_DIR}/${DEV_PREFIX}-${EROM_PCIE_BINFILE}.le
+	cp -f ${BINS_DIR}/${DEV_PREFIX}-${EROM_RECOVERY_BINFILE} ${BINS_DIR}/${DEV_PREFIX}-${EROM_RECOVERY_BINFILE}.le
+	cp -f ${BINS_DIR}/${DEV_PREFIX}-${EROM_FIT_BINFILE} ${BINS_DIR}/${DEV_PREFIX}-${EROM_FIT_BINFILE}.le
+	cp -f ${BINS_DIR}/${DEV_PREFIX}-${EROM_IMAGES_POINTERS_BINFILE} ${BINS_DIR}/${DEV_PREFIX}-${EROM_IMAGES_POINTERS_BINFILE}.le
 
 	# Reserved space (80820 bytes) filled by 0xFF
 	HI_OFFSET=$(printf %d ${EROM_TPM_OFFSET})
 	dd status=none conv=sync bs=${HI_OFFSET} count=1 if=/dev/zero |  tr "\000" "\377" > ${OUTF}
 
-	dd status=none seek=$(printf %d ${EROM_START_OFFSET})		if=${DEV_PREFIX}-${EROM_IMAGES_POINTERS_BINFILE}.le	bs=1 of=${OUTF}
-	dd status=none seek=$(printf %d ${EROM_PCIE_OFFSET})		if=${DEV_PREFIX}-${EROM_PCIE_BINFILE}.le		bs=1 of=${OUTF}
-	dd status=none seek=$(printf %d ${EROM_RECOVERY_OFFSET})	if=${DEV_PREFIX}-${EROM_RECOVERY_BINFILE}.le		bs=1 of=${OUTF}
-	dd status=none seek=$(printf %d ${EROM_FIT_OFFSET})		if=${DEV_PREFIX}-${EROM_FIT_BINFILE}.le			bs=1 of=${OUTF}
+	dd status=none seek=$(printf %d ${EROM_START_OFFSET})		if=${BINS_DIR}/${DEV_PREFIX}-${EROM_IMAGES_POINTERS_BINFILE}.le	bs=1 of=${OUTF}
+	dd status=none seek=$(printf %d ${EROM_PCIE_OFFSET})		if=${BINS_DIR}/${DEV_PREFIX}-${EROM_PCIE_BINFILE}.le		bs=1 of=${OUTF}
+	dd status=none seek=$(printf %d ${EROM_RECOVERY_OFFSET})	if=${BINS_DIR}/${DEV_PREFIX}-${EROM_RECOVERY_BINFILE}.le	bs=1 of=${OUTF}
+	dd status=none seek=$(printf %d ${EROM_FIT_OFFSET})		if=${BINS_DIR}/${DEV_PREFIX}-${EROM_FIT_BINFILE}.le		bs=1 of=${OUTF}
 
 }
 
@@ -498,15 +500,15 @@
 	local PRIME_IMAGE_RAM_CRC_ERROR=$3
 	local PRIME_IMAGE_RAM_SIGN_ERROR=$4
 
-	dd if=/dev/zero bs=1 status=none count=1016 	> preboot-pad.bin
-	cat ${PREBOOT_BINFILE} 				>> preboot-pad.bin
-	mv ${PREBOOT_BINFILE} preboot-orig.bin
-	mv preboot-pad.bin ${PREBOOT_BINFILE}
+	dd if=/dev/zero bs=1 status=none count=1016 	> ${STAGE_DIR}/preboot-pad.bin
+	cat ${PREBOOT_BINFILE} 				>> ${STAGE_DIR}/preboot-pad.bin
+	mv ${PREBOOT_BINFILE} ${STAGE_DIR}/preboot-orig.bin
+	mv ${STAGE_DIR}/preboot-pad.bin ${PREBOOT_BINFILE}
 
 	hl_pack_bin ${PREBOOT_BINFILE} 64K ${PRIME_IMAGE_RAM_KEY} ${PRIME_IMAGE_RAM_CRC_ERROR} ${PRIME_IMAGE_RAM_SIGN_ERROR}
 
 	rm -rf ${PREBOOT_BINFILE}
-	mv preboot-orig.bin ${PREBOOT_BINFILE}
+	mv ${STAGE_DIR}/preboot-orig.bin ${PREBOOT_BINFILE}
 }
 
 function zephyr_preboot_d1_pack {
diff --git a/board/habanalabs/gaudi3_arc/post-image-spi.sh b/board/habanalabs/gaudi3_arc/post-image-spi.sh
index e4eda58..dcace22 100755
--- a/board/habanalabs/gaudi3_arc/post-image-spi.sh
+++ b/board/habanalabs/gaudi3_arc/post-image-spi.sh
@@ -198,13 +198,13 @@
 		fi
 		flash_offset=$((SPI_DMA_DEST_64KB_OFFS/4))
 		flash_offset=$((flash_offset*slice_cnt))
-		dd status=none conv=sync if=${BIN_FILE} bs=4 seek=$flash_offset of=${DEV_PREFIX}-${FILEPATH}.le.int
