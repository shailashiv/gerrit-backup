diff --git a/include/device.h b/include/device.h
index 9cf3b6c..d410703 100644
--- a/include/device.h
+++ b/include/device.h
@@ -20,8 +20,27 @@
 	u32 uart_bauddiv_reg;
 };
 
+struct device_pci {
+	u32 dbi_bar0_reg;
+	u32 dbi_bar2_reg;
+	u32 dbi_bar4_reg;
+	u32 dbi_status_command_reg;
+	u32 aux_dbi_reg;
+	u32 aux_mem_space_en_reg;
+	u32 aux_flr_ctrl_reg;
+	u32 aux_ltssm_en_reg;
+	u32 aux_pf_flr_active_reg;
+	u32 aux_flr_int_reg;
+	u32 aux_pf_flr_done_reg;
+	u32 aux_rdlh_link_up_reg;
+	u32 aux_smlh_link_up_reg;
+	u32 core_hot_rst_reg;
+};
+
 extern struct device_efuse efuse;
 extern struct device_uart uart;
+extern struct device_pci pci;
 
 void device_init_efuse(void);
 void device_init_uart(void);
+void device_init_pci(void);
diff --git a/lib/common/pci.c b/lib/common/pci.c
index bad97cc..a821987 100644
--- a/lib/common/pci.c
+++ b/lib/common/pci.c
@@ -5,12 +5,10 @@
  *
  */
 
-#include <pcie_dbi_regs.h>
-#include <pcie_aux_regs.h>
 #include <common/pci_ids.h>
-#include <pcie_dbi_masks.h>
 #include <bitops.h>
 #include <preboot.h>
+#include <device.h>
 #include <sizes.h>
 #include "pci.h"
 
@@ -37,6 +35,8 @@
 #define IATU_OUTBOUND_REGION_SIZE	SZ_8K
 #define IATU_OUTBOUND_UPPER_ADDR_VAL	0x08000000
 
+struct device_pci pci;
+
 __weak u32 dev_pci_dbi_cfg_offset_get(void)
 {
 	return 0;
@@ -59,25 +59,25 @@
 
 	switch (bar_id) {
 	case PCI_BAR_ID_0:
-		bar_reg = mmPCIE_DBI_BAR0_REG;
+		bar_reg = pci.dbi_bar0_reg;
 		break;
 	case PCI_BAR_ID_2:
-		bar_reg = mmPCIE_DBI_BAR2_REG;
+		bar_reg = pci.dbi_bar2_reg;
 		break;
 	case PCI_BAR_ID_4:
-		bar_reg = mmPCIE_DBI_BAR4_REG;
+		bar_reg = pci.dbi_bar4_reg;
 		break;
 	default:
 		return -1;
 	}
 
-	aux_dbi_reg = regmap_readl(mmPCIE_AUX_DBI);
-	regmap_writel(IATU_ACCESS_DISABLE_VAL, mmPCIE_AUX_DBI);
+	aux_dbi_reg = regmap_readl(pci.aux_dbi_reg);
+	regmap_writel(IATU_ACCESS_DISABLE_VAL, pci.aux_dbi_reg);
 
 	bar_addr_low = regmap_readl(bar_reg) & ~0xF;
 	bar_addr_high = regmap_readl(bar_reg + sizeof(u32));
 
-	regmap_writel(aux_dbi_reg, mmPCIE_AUX_DBI);
+	regmap_writel(aux_dbi_reg, pci.aux_dbi_reg);
 
 	*bar_phys_addr = (u64)bar_addr_high << 32 | bar_addr_low;
 
@@ -97,9 +97,9 @@
 	u64 bar_phys_base = 0, region_base, region_end_address;
 	u32 offset = dev_pci_dbi_cfg_offset_get();
 	u32 ctrl_reg_val;
-	u32 aux_dbi_reg = regmap_readl(mmPCIE_AUX_DBI);
+	u32 aux_dbi_reg = regmap_readl(pci.aux_dbi_reg);
 
-	regmap_writel(IATU_ACCESS_ENABLE_VAL, mmPCIE_AUX_DBI);
+	regmap_writel(IATU_ACCESS_ENABLE_VAL, pci.aux_dbi_reg);
 
 	/* region offset */
 	offset += (IATU_REGION_SIZE * region) + IATU_REGION_INBOUND_OFF;
@@ -143,7 +143,7 @@
 	regmap_writel(ctrl_reg_val, offset + IATU_REGION_CTRL_2_OFF);
 
 	/* restore iATU access state */
-	regmap_writel(aux_dbi_reg, mmPCIE_AUX_DBI);
+	regmap_writel(aux_dbi_reg, pci.aux_dbi_reg);
 }
 
 /*
@@ -156,9 +156,9 @@
 {
 	u64 outbound_region_end_address;
 	u32 offset = dev_pci_dbi_cfg_offset_get();
-	u32 aux_dbi_reg = regmap_readl(mmPCIE_AUX_DBI);
+	u32 aux_dbi_reg = regmap_readl(pci.aux_dbi_reg);
 
-	regmap_writel(IATU_ACCESS_ENABLE_VAL, mmPCIE_AUX_DBI);
+	regmap_writel(IATU_ACCESS_ENABLE_VAL, pci.aux_dbi_reg);
 
 	/* disable region before configuring */
 	regmap_writel(0, offset + IATU_REGION_CTRL_2_OFF);
@@ -183,7 +183,7 @@
 	regmap_writel(IATU_REGION_EN_MASK, offset + IATU_REGION_CTRL_2_OFF);
 
 	/* restore iATU access state */
-	regmap_writel(aux_dbi_reg, mmPCIE_AUX_DBI);
+	regmap_writel(aux_dbi_reg, pci.aux_dbi_reg);
 }
 
 /*
@@ -191,7 +191,7 @@
  */
 __weak bool hl_pci_is_mem_enabled(void)
 {
-	u32 mem_space_ena_reg = regmap_readl(mmPCIE_AUX_MEM_SPACE_EN);
+	u32 mem_space_ena_reg = regmap_readl(pci.aux_mem_space_en_reg);
 
 	return !!mem_space_ena_reg;
 }
@@ -203,14 +203,16 @@
 	return (dev_id << 16) | PCI_VENDOR_ID_HABANALABS;
 }
 
+#define PCIE_DBI_STATUS_COMMAND_REG_PCI_TYPE0_MEM_SPACE_EN_SHIFT	1
+
 void hl_pcie_disable_mem_access(void)
 {
 	u32 reg;
 
 	/* Disable the PCIe inbound memory requests */
-	reg = regmap_readl(mmPCIE_DBI_STATUS_COMMAND_REG);
+	reg = regmap_readl(pci.dbi_status_command_reg);
 	reg &= ~BIT(PCIE_DBI_STATUS_COMMAND_REG_PCI_TYPE0_MEM_SPACE_EN_SHIFT);
-	regmap_writel(reg, mmPCIE_DBI_STATUS_COMMAND_REG);
+	regmap_writel(reg, pci.dbi_status_command_reg);
 }
 
 void hl_pcie_enable_mem_access(void)
@@ -218,7 +220,7 @@
 	u32 reg;
 
 	/* Enable the PCIe inbound memory requests */
-	reg = regmap_readl(mmPCIE_DBI_STATUS_COMMAND_REG);
+	reg = regmap_readl(pci.dbi_status_command_reg);
 	reg |= BIT(PCIE_DBI_STATUS_COMMAND_REG_PCI_TYPE0_MEM_SPACE_EN_SHIFT);
-	regmap_writel(reg, mmPCIE_DBI_STATUS_COMMAND_REG);
+	regmap_writel(reg, pci.dbi_status_command_reg);
 }
diff --git a/lib/preboot/module_pci.c b/lib/preboot/module_pci.c
index 1e5b3c2..450653f 100644
--- a/lib/preboot/module_pci.c
+++ b/lib/preboot/module_pci.c
@@ -4,12 +4,10 @@
  * All Rights Reserved.
  */
 
-#include <pcie_aux_regs.h>
-#include <pcie_aux_masks.h>
-#include <pcie_core_regs.h>
 
 #include <bitops.h>
 #include <preboot.h>
