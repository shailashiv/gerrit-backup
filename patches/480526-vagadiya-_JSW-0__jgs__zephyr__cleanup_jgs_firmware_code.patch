+static void gpu_d2h_handler_host(const struct device *dev,
+				struct gpu_queue_callback *cb)
+{
+	struct cpucp_d2h_resp_packet resp_packet;
+	uint32_t addr_lo, hdr_size = sizeof(struct cpucp_d2h_resp_packet);
+	uint32_t total_sz = 0, cons_sz = 0;
+	uint32_t data = 0, offset = 0;
+	uint32_t pi_read, ci_read;
+
+	LOG_INF("Received data from d2h queue at host num_entries:%d hi0: 0x%x lo0: 0x%x sz0: %d hi1: 0x%x lo1: 0x%x sz1: %d",
+		cb->buffer_data.valid_entries,
+		cb->buffer_data.buffer_info[0].addr_hi,
+		cb->buffer_data.buffer_info[0].addr_lo,
+		cb->buffer_data.buffer_info[0].size,
+		cb->buffer_data.buffer_info[1].addr_hi,
+		cb->buffer_data.buffer_info[1].addr_lo,
+		cb->buffer_data.buffer_info[1].size);
+
+	total_sz = cb->buffer_data.buffer_info[0].size;
+	if (cb->buffer_data.valid_entries == 2)
+		total_sz += cb->buffer_data.buffer_info[1].size;
+
+	while (total_sz >= hdr_size) {
+		/* read header first */
+		addr_lo = (cb->buffer_data.buffer_info[0].addr_lo & 0xFFFFFFF) | 0x20000000;
+		if (cb->buffer_data.valid_entries == 2) {
+			if (cons_sz < cb->buffer_data.buffer_info[0].size) {
+				if (cb->buffer_data.buffer_info[0].size >= (hdr_size + cons_sz)) {
+					memcpy(&resp_packet, (void *) (addr_lo + cons_sz),
+						hdr_size);
+					if (resp_packet.size > hdr_size) {
+						if ((cb->buffer_data.buffer_info[0].size -
+								(cons_sz + hdr_size)) >= 4) {
+							memcpy(&data, (void *) (addr_lo + cons_sz +
+								hdr_size), 4);
+						} else {
+							addr_lo =
+							(cb->buffer_data.buffer_info[1].addr_lo &
+							0xFFFFFFF) | 0x20000000;
+							memcpy(&data, (void *) addr_lo, 4);
+						}
+					}
+				} else {
+					memcpy(&resp_packet, (void *) (addr_lo + cons_sz),
+						(cons_sz - cb->buffer_data.buffer_info[0].size));
+					addr_lo = (cb->buffer_data.buffer_info[1].addr_lo &
+							0xFFFFFFF) | 0x20000000;
+					memcpy(&resp_packet + cb->buffer_data.buffer_info[0].size,
+						(void *) addr_lo,
+						(hdr_size - cb->buffer_data.buffer_info[0].size));
+					if (resp_packet.size > hdr_size) {
+						offset = (hdr_size -
+							cb->buffer_data.buffer_info[0].size);
+						memcpy(&data, (void *) (addr_lo + offset), 4);
+					}
+				}
+			} else {
+				addr_lo = (cb->buffer_data.buffer_info[1].addr_lo &
+					  0xFFFFFFF) | 0x20000000;
+				offset = (cons_sz -  cb->buffer_data.buffer_info[0].size);
+				memcpy(&resp_packet, (void *) (addr_lo + offset), hdr_size);
+				if (resp_packet.size > hdr_size)
+					memcpy(&data, (void *) (addr_lo + offset + hdr_size), 4);
+			}
+		} else {
+			memcpy(&resp_packet, (void *) (addr_lo + cons_sz), hdr_size);
+			if (resp_packet.size > hdr_size)
+				memcpy(&data, (void *) (addr_lo + cons_sz + hdr_size), 4);
+		}
+
+		/* print header */
+		gpu_print_d2h_resp_hdr(&resp_packet);
+		if (resp_packet.size > hdr_size)
+			LOG_ERR("data:0x%x", data);
+
+
+		gpu_queue_relinquish_data(d2h_config.dev_host, resp_packet.size);
+		cons_sz += resp_packet.size;
+		total_sz -= resp_packet.size;
+	}
+
+	pi_read = sys_read32(0xfc48b10C);
+	ci_read = sys_read32(0xfc48b110);
+	LOG_ERR("H2D: PI: %d CI: %d", pi_read, ci_read);
+	pi_read = sys_read32(0xfc48b14C);
+	ci_read = sys_read32(0xfc48b150);
+	LOG_ERR("D2H: PI: %d CI: %d", pi_read, ci_read);
+}
+
+static void gpu_h2d_handler(const struct device *dev,
+			   struct gpu_queue_callback *cb)
+{
+	struct cpucp_h2d_req_packet req_packet;
+	uint32_t addr_lo, hdr_size = sizeof(struct cpucp_h2d_req_packet);
+	uint32_t total_sz = 0, cons_sz = 0;
+	uint32_t offset = 0, data = 0;
+
+	LOG_INF("Received data from h2d queue in FW num_entries:%d hi0: 0x%x lo0: 0x%x sz0: %d hi0: 0x%x lo0: 0x%x sz0: %d",
+		cb->buffer_data.valid_entries,
+		cb->buffer_data.buffer_info[0].addr_hi,
+		cb->buffer_data.buffer_info[0].addr_lo,
+		cb->buffer_data.buffer_info[0].size,
+		cb->buffer_data.buffer_info[1].addr_hi,
+		cb->buffer_data.buffer_info[1].addr_lo,
+		cb->buffer_data.buffer_info[1].size);
+
+	total_sz = cb->buffer_data.buffer_info[0].size;
+	if (cb->buffer_data.valid_entries == 2)
+		total_sz += cb->buffer_data.buffer_info[1].size;
+
+	while (total_sz >= hdr_size) {
+		addr_lo = (cb->buffer_data.buffer_info[0].addr_lo & 0xFFFFFFF) | 0x20000000;
+		if (cb->buffer_data.valid_entries == 2) {
+			if (cons_sz < cb->buffer_data.buffer_info[0].size) {
+				if (cb->buffer_data.buffer_info[0].size >= (hdr_size + cons_sz)) {
+					memcpy(&req_packet, (void *) (addr_lo + cons_sz), hdr_size);
+					if (req_packet.size > hdr_size) {
+						if ((cb->buffer_data.buffer_info[0].size -
+							(cons_sz + hdr_size)) >= 4) {
+							memcpy(&data,
+							(void *) (addr_lo + cons_sz + hdr_size), 4);
+						} else {
+							addr_lo =
+							(cb->buffer_data.buffer_info[1].addr_lo &
+							0xFFFFFFF) | 0x20000000;
+							memcpy(&data, (void *) addr_lo, 4);
+						}
+					}
+				} else {
+					memcpy(&req_packet, (void *) (addr_lo + cons_sz),
+						(cons_sz - cb->buffer_data.buffer_info[0].size));
+					addr_lo = (cb->buffer_data.buffer_info[1].addr_lo &
+						   0xFFFFFFF) | 0x20000000;
+					memcpy(&req_packet + cb->buffer_data.buffer_info[0].size,
+						(void *) addr_lo,
+						(hdr_size - cb->buffer_data.buffer_info[0].size));
+					if (req_packet.size > hdr_size) {
+						offset = (hdr_size -
+							 cb->buffer_data.buffer_info[0].size);
+						memcpy(&data, (void *) (addr_lo + offset), 4);
+					}
+				}
+			} else {
+				addr_lo = (cb->buffer_data.buffer_info[1].addr_lo & 0xFFFFFFF) |
+						0x20000000;
+				offset = (cons_sz -  cb->buffer_data.buffer_info[0].size);
+				memcpy(&req_packet, (void *) (addr_lo + offset), hdr_size);
+				if (req_packet.size > hdr_size)
+					memcpy(&data, (void *) (addr_lo + offset + hdr_size), 4);
+			}
+
+		} else {
+			memcpy(&req_packet, (void *) (addr_lo + cons_sz), hdr_size);
+			if (req_packet.size > hdr_size)
+				memcpy(&data, (void *) (addr_lo + cons_sz + hdr_size), 4);
+		}
+
+		/* print header */
+		gpu_print_h2d_req_hdr(&req_packet);
+		switch (req_packet.packet_id) {
+		case CPUCP_PACKET_INFO:
+			gpu_process_info_pkt(&req_packet);
+			break;
+		case CPUCP_PACKET_SENSOR:
+			gpu_process_sensor_pkt(&req_packet, data);
+			break;
+		default:
+			break;
+		}
+
+		gpu_queue_relinquish_data(h2d_config.dev, req_packet.size);
+		cons_sz += req_packet.size;
+		total_sz -= req_packet.size;
+	}
+}
+
+struct cpucp_h2d_set_packet {
+	struct cpucp_h2d_req_packet req_packet;
+	uint32_t data;
+};
+
+uint32_t uni_id = 1024;
+void gpu_queue_test_h2d_queue(void)
+{
+	int ret;
+	uint32_t free_size, addr_lo, i, j;
+	struct cpucp_h2d_req_packet req_packet = { 0 };
+	struct gpu_queue_buffer_data data;
+	uint32_t pkt_size = sizeof(struct cpucp_h2d_req_packet);
+
+	struct cpucp_h2d_set_packet set_packet = { 0 };
+	uint32_t pkt2_size = sizeof(struct cpucp_h2d_set_packet);
+
+	LOG_ERR("cpucp_h2d_req_packet size: %d", pkt_size);
+	req_packet.packet_id = CPUCP_PACKET_INFO;
+	req_packet.packet_sub_id = CPUCP_PACKET_INFO_GENERIC;
+	req_packet.packet_type = CPUCP_PACKET_TYPE_GET;
+	req_packet.size = pkt_size;
+
+	LOG_ERR("cpucp_h2d_set_packet size: %d", pkt2_size);
+	set_packet.req_packet.packet_id = CPUCP_PACKET_SENSOR;
+	set_packet.req_packet.packet_sub_id = CPUCP_PACKET_SENSOR_POWER;
+	set_packet.req_packet.packet_type = CPUCP_PACKET_TYPE_SET;
+	set_packet.req_packet.size = pkt2_size;
+	set_packet.data = 0xCCDDEEFF;
+
+	for (i = 0; i < 25; i++) {
+		for (j = 0; j < 5; j++) {
+			req_packet.unique_id = uni_id++;
+			ret = gpu_queue_get_free_size(h2d_config.dev_host, &free_size);
+			if (ret)
+				LOG_ERR("failure in getting free size from h2d host q");
+			else
+				LOG_ERR("free_size: %d in h2d host queue", free_size);
+
+
+			ret = gpu_queue_get_buffer(h2d_config.dev_host, pkt_size, &data);
+			if (ret)
+				LOG_ERR("failure in getting buffer of pkt_size:%d from h2d host q",
+					pkt_size);
+			else
+				LOG_INF("buffer details from d2h queue entries:%d hi0: 0x%x lo0: 0x%x sz0: %d hi0: 0x%x lo0: 0x%x sz0: %d",
+						data.valid_entries,
+						data.buffer_info[0].addr_hi,
+						data.buffer_info[0].addr_lo,
+						data.buffer_info[0].size,
+						data.buffer_info[1].addr_hi,
+						data.buffer_info[1].addr_lo,
+						data.buffer_info[1].size);
+
+			addr_lo = (data.buffer_info[0].addr_lo & 0xFFFFFFF) | 0x20000000;
+			if (data.valid_entries == 2) {
+				memcpy((void *) addr_lo, &req_packet, data.buffer_info[0].size);
+				addr_lo = (data.buffer_info[1].addr_lo & 0xFFFFFFF) | 0x20000000;
+				memcpy((void *) addr_lo, (&req_packet + data.buffer_info[0].size),
+					data.buffer_info[1].size);
+			} else {
+				memcpy((void *) addr_lo, &req_packet, pkt_size);
+			}
+
+			gpu_queue_push_data_completion(h2d_config.dev_host, pkt_size);
+
+			set_packet.req_packet.unique_id = uni_id++;
+			ret = gpu_queue_get_free_size(h2d_config.dev_host, &free_size);
+			if (ret)
+				LOG_ERR("failure in getting free size from h2d host q");
+			else
+				LOG_ERR("free_size: %d in h2d host queue", free_size);
+
+
+			ret = gpu_queue_get_buffer(h2d_config.dev_host, pkt2_size, &data);
+			if (ret)
+				LOG_ERR("failure in getting buffer of pkt_size:%d from h2d host q",
+					pkt2_size);
+			else
+				LOG_INF("buffer details from d2h queue entries:%d hi0: 0x%x lo0: 0x%x sz0: %d hi0: 0x%x lo0: 0x%x sz0: %d",
+						data.valid_entries,
+						data.buffer_info[0].addr_hi,
+						data.buffer_info[0].addr_lo,
+						data.buffer_info[0].size,
+						data.buffer_info[1].addr_hi,
+						data.buffer_info[1].addr_lo,
+						data.buffer_info[1].size);
+
+			addr_lo = (data.buffer_info[0].addr_lo & 0xFFFFFFF) | 0x20000000;
+			if (data.valid_entries == 2) {
+				memcpy((void *) addr_lo, &set_packet, data.buffer_info[0].size);
+				addr_lo = (data.buffer_info[1].addr_lo & 0xFFFFFFF) | 0x20000000;
+				memcpy((void *) addr_lo, (&set_packet + data.buffer_info[0].size),
+					data.buffer_info[1].size);
+			} else {
+				memcpy((void *) addr_lo, &set_packet, pkt2_size);
+			}
+
+			gpu_queue_push_data_completion(h2d_config.dev_host, pkt2_size);
+		}
+
+		/* Raise interrupt (sw interrupt 160 1st interrupt) */
+		sys_write32(140, 0xFC4D400C);
+	}
+}
+
+void gpu_queue_test_d2h_queue(void)
+{
+
+}
+
+void gpu_init_h2d_queue(void)
+{
+	int ret;
+
+	h2d_config.dev = device_get_binding(DT_LABEL(DT_NODELABEL(h2dqueue)));
+	if (!h2d_config.dev) {
+		LOG_ERR("Failed to get pointer to %s device!",
+				DT_LABEL(DT_NODELABEL(h2dqueue)));
+		return;
+	}
+
+	h2d_config.dev_host = device_get_binding(DT_LABEL(DT_NODELABEL(h2dqueuehost)));
+	if (!h2d_config.dev_host) {
+		LOG_ERR("Failed to get pointer to %s host device!",
+				DT_LABEL(DT_NODELABEL(h2dqueuehost)));
+		return;
+	}
+
+	/* Initialize h2d queue to receive data */
+	queue_init_callback(&h2d_config.h2d_cb, gpu_h2d_handler);
+	ret = gpu_queue_register_callback(h2d_config.dev, &h2d_config.h2d_cb);
+	if (ret != 0) {
+		LOG_ERR("Failed to register callback to %s device!",
+				DT_LABEL(DT_INST(0, gpu_queue_h2d)));
+		return;
+	}
+
+	/* Fill queue registers (done by host )*/
+	/* lo */
+	sys_write32(0xD3120000, 0xfc48b100);
+	/* hi */
+	sys_write32(0x300007F, 0xfc48b104);
+	/* size */
+	sys_write32(0x1000, 0xfc48b108);
+	/* pi */
+	sys_write32(0x0, 0xfc48b10C);
+	/* ci */
+	sys_write32(0x0, 0xfc48b110);
+
+	gpu_queue_set_enabled(h2d_config.dev, true);
+	gpu_queue_set_enabled(h2d_config.dev_host, true);
+}
+
+void gpu_init_d2h_queue(void)
+{
+	int ret;
+
+	d2h_config.dev = device_get_binding(DT_LABEL(DT_NODELABEL(d2hqueue)));
+	if (!d2h_config.dev) {
+		LOG_ERR("Failed to get pointer to %s device!",
+				DT_LABEL(DT_NODELABEL(d2hqueue)));
+		return;
+	}
+
+	d2h_config.dev_host = device_get_binding(DT_LABEL(DT_NODELABEL(d2hqueuehost)));
+	if (!d2h_config.dev_host) {
+		LOG_ERR("Failed to get pointer to %s host device!",
+				DT_LABEL(DT_NODELABEL(d2hqueuehost)));
+		return;
+	}
+
+	queue_init_callback(&d2h_config.d2h_cb, gpu_d2h_handler_host);
+	ret = gpu_queue_register_callback(d2h_config.dev_host, &d2h_config.d2h_cb);
+	if (ret != 0) {
+		LOG_ERR("Failed to register callback to %s device!",
+				DT_LABEL(DT_NODELABEL(d2hqueuehost)));
+		return;
+	}
+
+	/* Fill queue registers (done by host ) */
+	/* lo */
+	sys_write32(0xD3121000, 0xfc48b140);
+	/* hi */
+	sys_write32(0x300007F, 0xfc48b144);
+	/* size */
+	sys_write32(0x1000, 0xfc48b148);
+	/* pi */
+	sys_write32(0x0, 0xfc48b14C);
+	/* ci */
+	sys_write32(0x0, 0xfc48b150);
+
+	gpu_queue_set_enabled(d2h_config.dev, true);
+	gpu_queue_set_enabled(d2h_config.dev_host, true);
+}
+#endif
+
+void main(void)
+{
+	gpu_init_h2d_queue();
+	gpu_init_d2h_queue();
+
+	gpu_queue_test_h2d_queue();
+	gpu_queue_test_d2h_queue();
+}
