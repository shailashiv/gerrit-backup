diff --git a/drivers/misc/gpu_isolation_binning/jgs/decoder_binning.c b/drivers/misc/gpu_isolation_binning/jgs/decoder_binning.c
new file mode 100644
index 0000000..d26fbf4
--- /dev/null
+++ b/drivers/misc/gpu_isolation_binning/jgs/decoder_binning.c
@@ -0,0 +1,134 @@
+/* SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2025 Intel, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <zephyr/kernel.h>
+#include <hl_platform_defs.h>
+#include <jgs_binning_defs.h>
+
+#include "engine_binning.h"
+#include <jgs_blocks_linux_driver.h>
+#include <rtr_addr_dec_lbw_regs.h>
+#include <rtr_addr_dec_lbw_masks.h>
+#include <rtr_addr_dec_dbg_regs.h>
+#include <rtr_addr_dec_dbg_masks.h>
+
+#include <zephyr/logging/log.h>
+LOG_MODULE_REGISTER(decoder_binning);
+
+/* reference: H15_NOC_MeshXY.xlsx */
+uint8_t decoder_mesh_coordinate[JGS_NUM_VDEC_PER_DIE * JGS_NUM_IO_DIES][2] = {
+	/* IO-Die0-Half0 */
+	{52, 4}, {52, 5}, {52, 6}, {52, 7}, {56, 4}, {56, 5}, {56, 6}, {56, 7}, {60, 2},
+	/* IO-Die0-Half1 */
+	{72, 4}, {72, 5}, {72, 6}, {72, 7}, {68, 4}, {68, 5}, {60, 6}, {60, 7}, {60, 5},
+	/* IO-Die1-Half0 */
+	{75, 59}, {75, 58}, {75, 57}, {75, 56}, {71, 59}, {71, 58}, {71, 57}, {71, 56}, {67, 61},
+	/* IO-Die1-Half1 */
+	{55, 59}, {55, 58}, {55, 57}, {55, 56}, {59, 59}, {59, 58}, {67, 57}, {67, 56}, {67, 58},
+};
+
+static void vdec_binning_config_lbw(uint32_t lbw_reg_val, enum jgs_die_id die_id,
+		int32_t lbw_remap_reg_idx)
+{
+	uint32_t offset;
+
+	/* next available DEC_LBW_LBW_XY_REMAP register offset */
+	offset = mmRTR_ADDR_DEC_LBW_LBW_XY_REMAP_0 +
+		(lbw_remap_reg_idx * sizeof(uint32_t));
+
+	/* Configure NOCL, NOCML, NOCMC, NOCP scope for LBW_XY_REMAP */
+	CFG_WREG32(mmIO_0_CFG_HALF_0_SOC_0_NOCL_NOC_CTRL_LBW_RTR_ADDR_DEC_LBW_BASE + offset,
+			lbw_reg_val);
+	CFG_WREG32(mmIO_0_CFG_HALF_0_SOC_0_NOCML_NOC_CTRL_LBW_RTR_ADDR_DEC_LBW_BASE + offset,
+			lbw_reg_val);
+	CFG_WREG32(mmIO_0_CFG_HALF_0_SOC_0_NOCMC_NOC_CTRL_LBW_RTR_ADDR_DEC_LBW_BASE + offset,
+			lbw_reg_val);
+	CFG_WREG32(mmIO_0_CFG_HALF_0_SOC_0_NOCP_NOC_CTRL_LBW_RTR_ADDR_DEC_LBW_BASE + offset,
+			lbw_reg_val);
+
+	LOG_DBG("%s offset = 0x%x, lbw_reg_val = 0x%x", __func__, offset, lbw_reg_val);
+}
+
+static void vdec_binning_config_dbg(uint32_t dbg_reg_val, enum jgs_die_id die_id,
+		int32_t lbw_remap_reg_idx)
+{
+	uint32_t offset;
+
+	/* next available DEC_DBG_DBG_XY_REMAP register offset */
+	offset = mmRTR_ADDR_DEC_DBG_DBG_XY_REMAP_0 +
+		(lbw_remap_reg_idx * sizeof(uint32_t));
+
+	/* Configure NOCP for DBG_XY_REMAP; NOCL, NOCML, NOCMC are not present for DBG */
+	CFG_WREG32(mmIO_0_CFG_HALF_0_SOC_0_NOCP_NOC_ADDR_DEC_DBG_BASE + offset, dbg_reg_val);
+
+	LOG_DBG("%s offset = 0x%x, dbg_reg_val = 0x%x", __func__, offset, dbg_reg_val);
+}
+
+
+/*
+ * Assumptions:
+ * 1. For each half die, up to one of the decoders can be binned out
+ * 2. Binning is performed per half die: a faulty decoder is replaced by a
+ * spare decoder on the same half die.
+ */
+void jgs_io_die_run_binning_decoder(struct jgs_engine_binning_drv_data *data)
+{
+	unsigned int i;
+	uint32_t x_src, y_src, x_dst, y_dst;
+	uint32_t io_die_id = (data->die_id - JGS_IO_DIE_0) / JGS_NUM_HALF_DIES;
+	uint32_t lbw_reg_val, dbg_reg_val;
+	int32_t lbw_remap_reg_idx;
+
+	for (i = 0; i < JGS_NUM_HALF_DIES; i++) {
+		LOG_DBG("%s: redundant_dec = %d", __func__, data->redundant_dec[i]);
+		/* If there is no faulty decoder or 8th decoder is redundant,
+		 * skip decoder binning
+		 */
+		if ((data->redundant_dec[i] == JGS_NO_FAULTY_VDEC) ||
+			(data->redundant_dec[i] == JGS_FAULTY_VDEC_8))
+			continue;
+
+		LOG_INF("%s IO Die[%u]: redundant = %u", __func__, io_die_id,
+				data->redundant_dec[i]);
+		x_src = decoder_mesh_coordinate[data->redundant_dec[i] +
+					(i * JGS_NUM_VDEC_PER_HALF_DIE) +
+					(io_die_id * JGS_NUM_VDEC_PER_DIE)][0];
+		y_src = decoder_mesh_coordinate[data->redundant_dec[i] +
+					(i * JGS_NUM_VDEC_PER_HALF_DIE) +
+					(io_die_id * JGS_NUM_VDEC_PER_DIE)][1];
+
+		x_dst = decoder_mesh_coordinate[JGS_FAULTY_VDEC_8 +
+					(i * JGS_NUM_VDEC_PER_HALF_DIE) +
+					(io_die_id * JGS_NUM_VDEC_PER_DIE)][0];
+		y_dst = decoder_mesh_coordinate[JGS_FAULTY_VDEC_8 +
+					(i * JGS_NUM_VDEC_PER_HALF_DIE) +
+					(io_die_id * JGS_NUM_VDEC_PER_DIE)][1];
+
+
+		LOG_DBG("%s x_src = %u, y_src = %u, x_dst = %u, y_dst = %u", __func__,
+				x_src, y_src, x_dst, y_dst);
+
+		/* RTR_CTRL_LBW_CFG ➔ RTR_ADDR_DEC_LBW ➔ LBW_XY_REMAP */
+		lbw_reg_val = LBW_REG_VAL(x_src, y_src, x_dst, y_dst);
+
+		/* IO_NOCP ➔ NOC_ADDR_DEC_DBG ➔ DBG_XY_REMAP */
+		dbg_reg_val = DBG_REG_VAL(x_src, y_src, x_dst, y_dst);
+
+		/* TODO: Check for number of entries, 0.5 PRM 20 entries, spec there
+		 * are 40 remap registers.
+		 */
+		lbw_remap_reg_idx = jgs_io_get_free_remap_reg_index(data);
+		if (lbw_remap_reg_idx < 0) {
+			LOG_ERR("lbw_xy_remap register not available, decoder binning failed");
+			break;
+		}
+
+		vdec_binning_config_lbw(lbw_reg_val, data->die_id,
+				lbw_remap_reg_idx);
+		vdec_binning_config_dbg(dbg_reg_val, data->die_id,
+				lbw_remap_reg_idx);
+	}
+}
diff --git a/drivers/misc/gpu_isolation_binning/jgs/engine_binning.c b/drivers/misc/gpu_isolation_binning/jgs/engine_binning.c
new file mode 100644
index 0000000..c80e256
--- /dev/null
+++ b/drivers/misc/gpu_isolation_binning/jgs/engine_binning.c
@@ -0,0 +1,160 @@
+/* SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2025 Intel, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <zephyr/device.h>
+#include <zephyr/kernel.h>
+#include <hl_platform_defs.h>
+#include <jgs_binning_defs.h>
+#include <jgs_binning_api.h>
+#include <jgs_boot_info.h>
+#include <jgs_fw_if.h>
+#include <arc_local_conf_regs.h>
+#include <arc_local_conf_masks.h>
+
+#include "engine_binning.h"
+
+#include <zephyr/logging/log.h>
+LOG_MODULE_REGISTER(jgs_engine_binning);
+
+#define DT_DRV_COMPAT  intel_gpu_binning
+
+static struct jgs_engine_binning_drv_data engine_binning_drv_data;
+
+static int jgs_engine_run_binning(const struct device *dev)
+{
+	struct jgs_engine_binning_drv_data *data = JGS_ENGINE_BINNING_DRV_DATA(dev);
+
+	if (!data->binning_data_available) {
+		LOG_ERR("%s: Binning data is not available, ENGINE binning aborted", __func__);
+		return -1;
+	}
+
+	/* TODO: update die_id check after gerrit 422407 merge */
+	if (data->die_id <= JGS_COMPUTE_DIE_3) {
+		jgs_compute_run_engine_binning(data);
+	} else if (data->die_id <= JGS_IO_DIE_1_HALF_1)
+		jgs_io_run_engine_binning(data);
+	else {
+		LOG_ERR("%s: invalid die id = %u", __func__, data->die_id);
+		return -1;
+	}
+
+	return 0;
+}
+
+static int init_dev_redundancy_data(struct jgs_engine_binning_drv_data *data)
+{
+	/* TODO: update die_id check after gerrit 422407 merge */
+	if (data->die_id <= JGS_COMPUTE_DIE_3) {
+		jgs_compute_init_dev_redundancy_data(data);
+	} else if (data->die_id <= JGS_IO_DIE_1_HALF_1)
+		jgs_io_init_dev_redundancy_data(data);
+	else {
+		LOG_ERR("%s: invalid die id = %u", __func__, data->die_id);
+		return -1;
+	}
+
+	/* TODO */
+
+	data->binning_data_available = true;
+
+	return 0;
+}
+
+static int jgs_engine_inject_binning_info(const struct device *dev,
+					  const struct jgs_binning_info *binning_info)
+{
+	struct jgs_engine_binning_drv_data *data = JGS_ENGINE_BINNING_DRV_DATA(dev);
+
+	if (!binning_info) {
+		LOG_ERR("can't init binning data from empty binning info");
+		return -1;
+	}
+
+	data->redundancy_ctx = binning_info->redundancy_ctx;
+	init_dev_redundancy_data(data);
+
+	return 0;
+}
+
+static int jgs_engine_get_binning_info(const struct device *dev,
+				       struct jgs_binning_info *binning_info)
+{
+	struct jgs_engine_binning_drv_data *data = JGS_ENGINE_BINNING_DRV_DATA(dev);
+
+	binning_info->redundancy_ctx = &data->redundancy_ctx;
+
+	return 0;
+}
+
+static const struct jgs_binning_driver_api engine_binning_drv_api = {
+	.jgs_binning_run_binning = jgs_engine_run_binning,
+	.jgs_binning_inject_binning_info = jgs_engine_inject_binning_info,
+	.jgs_binning_get_binning_info = jgs_engine_get_binning_info,
+};
+
+#ifdef CONFIG_JGS_BINNING_GET_CTX_FROM_BOOTINFO
+static int jgs_engine_binning_init(const struct device *dev)
+{
+	struct jgs_engine_binning_drv_data *data = JGS_ENGINE_BINNING_DRV_DATA(dev);
+	struct void *ctx = &data->redundancy_ctx;
+	uint32_t size;
+	int err;
+
+	enum jgs_die_id die_id = ((CFG_RREG32(mmIO_0_CFG_HALF_0_PSOC_ARC_MNG_LOCAL_BASE) &
+					ARC_LOCAL_CONF_DIE_CPU_ID_DIE_ID_M) >>
+					ARC_LOCAL_CONF_DIE_CPU_ID_DIE_ID_S);
+
+	data->die_id = die_id;
+
+	LOG_INF("JGS_ENGINE_BINNING device enumeration init bootinfo die_id = %u", data->die_id);
+
+	size = (die_id <= JGS_COMPUTE_DIE_3) ? sizeof(struct jgs_redundancy_ctx_compute) :
+			sizeof(struct jgs_redundancy_ctx_io);
+
+	err = hl_boot_info_copy_partial(HL_BOOT_INFO_BINNING_AND_ISO, ctx, 0, size);
+	if (err) {
+		LOG_ERR("%s: Binning and iso boot info copy fail ret=%d", __func__, err);
+		return -1;
+	}
+
+	init_dev_redundancy_data(data);
+
+	LOG_INF("JGS_ENGINE_BINNING device enumeration done");
+
+	return 0;
+}
+#else
+static int jgs_engine_binning_init(const struct device *dev)
+{
+	struct jgs_engine_binning_drv_data *data = JGS_ENGINE_BINNING_DRV_DATA(dev);
+
+	/* TODO: replace register read by function call */
+	enum jgs_die_id die_id = ((CFG_RREG32(mmIO_0_CFG_HALF_0_PSOC_ARC_MNG_LOCAL_BASE) &
+					ARC_LOCAL_CONF_DIE_CPU_ID_DIE_ID_M) >>
+					ARC_LOCAL_CONF_DIE_CPU_ID_DIE_ID_S);
+
+	data->die_id = die_id;
+
+	LOG_INF("JGS_ENGINE_BINNING device enumeration init die_id %u", data->die_id);
+
+	data->binning_data_available = false;
+
+	LOG_INF("JGS_ENGINE_BINNING device enumeration done");
+
+	return 0;
+}
+#endif /* CONFIG_JGS_BINNING_GET_CTX_FROM_BOOTINFO */
+
+
+DEVICE_DT_INST_DEFINE(0,
+		    jgs_engine_binning_init,
+		    NULL,
+		    &engine_binning_drv_data,
+		    NULL,	/* no static configuration */
+		    POST_KERNEL,
+		    CONFIG_KERNEL_INIT_PRIORITY_DEVICE,
+		    &engine_binning_drv_api);
