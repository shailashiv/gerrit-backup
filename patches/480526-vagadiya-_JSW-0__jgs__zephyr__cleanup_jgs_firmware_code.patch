+	const struct jgs_binning_driver_api *api =
+		(const struct jgs_binning_driver_api *)dev->api;
+
+	if (api == NULL) {
+		return -ENOTSUP;
+	}
+
+	if (api->jgs_binning_inject_binning_info == NULL)
+		return -ENODEV;
+
+	return api->jgs_binning_inject_binning_info(dev, binning_info);
