diff --git a/drivers/hbm/gpu/hbm.c b/drivers/hbm/gpu/hbm.c
new file mode 100644
index 0000000..1c7d692
--- /dev/null
+++ b/drivers/hbm/gpu/hbm.c
@@ -0,0 +1,232 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+/*
+ * Copyright 2024 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <zephyr/device.h>
+#include <zephyr/logging/log.h>
+#include <hbm_mc.h>
+#include <hbm_phy.h>
+#include <gpu_hbm.h>
+#include <hbm_common.h>
+
+LOG_MODULE_REGISTER(intel_gpu_hbm);
+
+#define DT_DRV_COMPAT  intel_gpu_hbm
+
+/* This function is raising write protect for the HBM eFuse via the ieee1500 interface */
+static void hbm_efuse_write_protect(const struct device *dev)
+{
+	LOG_INF("Calling HBM eFuse write protect function!!!");
+	(void)dev;
+}
+
+static int hbm_perform_known_lane_repair(const struct device *dev)
+{
+	LOG_INF("Calling HBM perform known lane repair function!!!");
+	(void)dev;
+
+	return HBM_NO_FAIL;
+}
+
+static void hbm_open_traffic(const struct device *dev)
+{
+	LOG_INF("Calling HBM open traffic function!!!");
+	(void)dev;
+}
+
+static int hbm_perform_known_row_repair(const struct device *dev)
+{
+	LOG_INF("Calling HBM perform Known row repair function!!!");
+	(void)dev;
+
+	return HBM_NO_FAIL;
+}
+
+static void hbm_reset(const struct device *dev)
+{
+	LOG_INF("Calling HBM reset function!!!");
+
+	hbm_mc_reset(dev);
+	hbm_phy_reset(dev);
+}
+
+static int hbm_config(const struct device *dev)
+{
+	LOG_INF("Calling HBM config function!!!");
+
+	int rc;
+
+	hbm_mc_config(dev);
+	hbm_phy_init_config(dev);
+
+	rc = hbm_phy_dfi_init(dev);
+	if (rc) {
+		LOG_ERR("HBM failure detected during PHY dfi init = %d", rc);
+		return HBM_PHY_INIT_FAIL;
+	}
+
+	hbm_mc_assert_cke(dev);
+
+	return rc;
+}
+
+static void hbm_p1500_config(const struct device *dev)
+{
+	LOG_INF("Calling HBM p1500 config function!!!");
+
+	hbm_phy_config_p1500(dev);
+	hbm_mc_p1500_init(dev);
+}
+
+static int hbm_lane_row_repair_config(const struct device *dev)
+{
+	LOG_INF("Calling HBM lane row repair config function!!!");
+
+	int rc;
+	struct fs_hbm_drv_data *hbm_data = DEV_DATA(dev);
+
+	rc = hbm_phy_pre_training_tests(dev);
+	if (rc) {
+		LOG_ERR("HBM failure detected during pre-training tests = %d", rc);
+		return HBM_PRE_TRAINING_FAIL;
+	}
+
+	if (!(hbm_data->palad)) {
+		rc = hbm_perform_known_lane_repair(dev);
+		if (rc) {
+			LOG_ERR("HBM failed to perform known lane repair = %d", rc);
+			return HBM_KNOWN_LANE_REPAIR_FAIL;
+		}
+	}
+
+	rc = hbm_phy_training(dev);
+	if (rc) {
+		LOG_ERR("HBM training failed = %d", rc);
+		return HBM_TRAINING_FAIL;
+	}
+
+	rc = hbm_perform_known_row_repair(dev);
+	if (rc) {
+		LOG_ERR("HBM failed to perform known row repair = %d", rc);
+		return HBM_KNOWN_ROW_REPAIR_FAIL;
+	}
+
+	return rc;
+}
+
+static int hbm_reset_and_mrs_config(const struct device *dev)
+{
+	LOG_INF("Calling HBM reset and MRS function!!!");
+
+	int rc;
+
+	rc = hbm_phy_hbm_reset(dev);
+	if (rc) {
+		LOG_ERR("HBM failed on reset = %d", rc);
+		return HBM_MRS_OR_RST_FAIL;
+	}
+
+	rc = hbm_phy_hbm_mrs(dev);
+	if (rc) {
+		LOG_ERR("HBM failed on MRS = %d", rc);
+		return HBM_MRS_OR_RST_FAIL;
+	}
+
+	return rc;
+}
+
+/**
+ * Return: STATUS_PASS(0) for success, STATUS_FAIL(1) for failure
+ */
+int hbm_drv_run_hbm_init(const struct device *dev)
+{
+	int rc;
+
+	struct gpu_hbm_drv_config *hbm_cfg = DEV_CFG(dev);
+	struct gpu_hbm_drv_data *hbm_data = DEV_DATA(dev);
+
+	if (hbm_data->initialized)
+		return rc;
+
+	hbm_reset(dev);
+
+	rc = hbm_config(dev);
+	if (rc) {
+		LOG_ERR("HBM failed on initial configuration = %d", rc);
+		hbm_data->hbm_sts = rc;
+		return rc;
+	}
+
+	rc = hbm_reset_and_mrs_config(dev);
+	if (rc) {
+		LOG_ERR("HBM failed on reset or MRS = %d", rc);
+		hbm_data->hbm_sts = rc;
+		return rc;
+	}
+
+	hbm_p1500_config(dev);
+
+	/* Setting HBM eFuse WP to avoid eFuse corruption as described on SIV-1361 */
+	hbm_efuse_write_protect(dev);
+
+	rc = hbm_lane_row_repair_config(dev);
+	if (rc) {
+		LOG_ERR("HBM failed on lane/row repair config = %d", rc);
+		hbm_data->hbm_sts = rc;
+		return rc;
+	}
+
+	hbm_mc_enable_compression(dev);
+
+	hbm_mc_misc_config(dev);
+
+	hbm_open_traffic(dev);
+
+	hbm_mc_patrol_scrubber_enable(dev);
+
+	hbm_data->initialized = true;
+
+	return rc;
+}
+
+static int hbm_drv_initialize(const struct device *dev)
+{
+	LOG_INF("HBM driver initialization started");
+
+	struct gpu_hbm_drv_data *hbm_data = DEV_DATA(dev);
+
+#if defined(TARGET_IS_PALAD)
+	hbm_data->pldm = true;
+#else
+	hbm_data->pldm = false;
+#endif
+
+	hbm_drv_run_hbm_init(dev);
+
+	LOG_INF("HBM driver initialization is done for dev %p", dev);
+
+	return 0;
+}
+
+static const struct gpu_hbm_driver_api gpu_hbm_drv_api = {
+	.hbm_drv_run_hbm_init = hbm_drv_run_hbm_init,
+};
+
+#define GPU_HBM_INIT(n)									\
+	static const struct gpu_hbm_drv_config gpu_config_##n = {				\
+		.mc_base = (uint32_t *) DT_INST_REG_ADDR_BY_NAME(n, mc_reg),	\
+		.phy_base = (uint32_t *) DT_INST_REG_ADDR_BY_NAME(n, phy_reg),\
+	};										\
+											\
+	static struct gpu_hbm_drv_data gpu_config_##n##_data; \
+	DEVICE_DT_INST_DEFINE(n, hbm_drv_initialize,						\
+				NULL,							\
+				&gpu_config_##n##_data,				\
+				&gpu_config_##n,						\
+				POST_KERNEL,						\
+				CONFIG_KERNEL_INIT_PRIORITY_DEFAULT, &gpu_hbm_drv_api);	\
+											\
+DT_INST_FOREACH_STATUS_OKAY(GPU_HBM_INIT)
