+void gpu_queue_test_h2d_queue(void)
+{
+	uint32_t pi = 0, pi_read, ci_read, free_size, busy_size;
+
+	/* TODO: create producer and consumer thread */
+	/* Increment PI and raise interrupt (done by host for H2D queue) */
+	LOG_ERR("host producing 2KB of data");
+	pi = (pi + 0x800) % 0x1000;
+	/*  pi */
+	sys_write32(pi, 0xfc48b10C);
+	/* Raise interrupt (sw interrupt 160 1st interrupt) */
+	sys_write32(140, 0xFC4D400C);
+
+	/* Sleep for 10ms */
+	k_msleep(10);
+	/* Increment PI and raise interrupt (done by host for H2D queue) */
+	LOG_ERR("host producing 8 bytes of data");
+	pi = (pi + 0x8) % 0x1000;
+	/*  pi */
+	sys_write32(pi, 0xfc48b10C);
+	/* Raise interrupt (sw interrupt 160 1st interrupt) */
+	sys_write32(140, 0xFC4D400C);
+
+	k_msleep(10);
+	LOG_ERR("FW consumed 8 bytes of data");
+	gpu_queue_relinquish_data(h2d_config.dev, 8);
+
+	k_msleep(10);
+	LOG_ERR("FW consumed 16 bytes of data");
+	gpu_queue_relinquish_data(h2d_config.dev, 16);
+
+	pi_read = sys_read32(0xfc48b10C);
+	ci_read = sys_read32(0xfc48b110);
+
+	if (pi_read > ci_read)
+		free_size = ((4096 - pi_read) + ci_read) - 1;
+	else
+		free_size = ci_read - pi_read - 1;
+
+	pi = (pi + free_size) % 0x1000;
+	LOG_ERR("free size: %d new pi: %d", free_size, pi);
+	/* Increment PI and raise interrupt (done by host for H2D queue) */
+	/*  pi */
+	sys_write32(pi, 0xfc48b10C);
+	/* Raise interrupt (sw interrupt 160 1st interrupt) */
+	sys_write32(140, 0xFC4D400C);
+
+	k_msleep(10);
+	LOG_ERR("FW consumed 1024 bytes of data");
+	gpu_queue_relinquish_data(h2d_config.dev, 1024);
+
+
+	pi_read = sys_read32(0xfc48b10C);
+	ci_read = sys_read32(0xfc48b110);
+
+	if (pi_read > ci_read)
+		busy_size = pi_read - ci_read;
+	else
+		busy_size = ((4096 - ci_read) + pi_read);
+	LOG_ERR("FW consumed %d bytes of data", busy_size);
+	gpu_queue_relinquish_data(h2d_config.dev, busy_size);
+
+	pi_read = sys_read32(0xfc48b10C);
+	ci_read = sys_read32(0xfc48b110);
+	LOG_ERR("pi: %d ci: %d", pi_read, ci_read);
+
+	LOG_ERR("Raising dummy isr w/o filling data");
+	/* Raise interrupt (sw interrupt 160 1st interrupt) */
+	sys_write32(140, 0xFC4D400C);
+}
