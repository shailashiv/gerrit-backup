diff --git a/drivers/ipm/ipm_gpu.c b/drivers/ipm/ipm_gpu.c
new file mode 100644
index 0000000..b1a22e6
--- /dev/null
+++ b/drivers/ipm/ipm_gpu.c
@@ -0,0 +1,511 @@
+/*
+ * Copyright (c) 2025 Intel
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/device.h>
+#include <soc/intel/gpu/jgs/soc.h>
+#include <zephyr/drivers/ipm.h>
+#include <zephyr/shared_irq.h>
+#include <gpu_utils.h>
+
+#include <zephyr/logging/log.h>
+#include "ipm_gpu.h"
+
+#define LOG_MODULE_NAME			ipm_gpu
+LOG_MODULE_REGISTER(LOG_MODULE_NAME, CONFIG_IPM_LOG_LEVEL);
+#define gpu_ipm_write32(v, c) (config->inter_die) ? CFG_ADDR_MNPL_WREG32(c, v) : sys_write32(v, c)
+#define gpu_ipm_read32(c) (config->inter_die) ? CFG_ADDR_MNPL_RREG32(c) : sys_read32(c)
+
+/*
+ * Below apis are copied from queue driver. Since the block registers
+ * of D2H/H2D are different from SW mailbox, the driver cannot be used
+ * by IPM driver.
+ * TODO: move this APIs from queue driver to common place which can be
+ * used by ipm driver as well.
+ * 1. ipm_gpu_get_avail_size
+ * 2. ipm_gpu_mbx_claim_buffer
+ * 3. ipm_gpu_mbx_manage_pi
+ * 4. gpu_queue_manage_ci
+ */
+static void ipm_gpu_get_avail_size(const struct device *dev, uint32_t *size)
+{
+	const struct ipm_gpu_config *config = DEV_CFG(dev);
+	struct ipm_gpu_mbx_regs *reg_base = (struct ipm_gpu_mbx_regs *)(config->cfg_base);
+	struct ipm_gpu_data *const data = DEV_DATA(dev);
+	uint32_t avail_len;
+
+	*size = 0;
+
+	data->mbx.pi = gpu_ipm_read32((mem_addr_t) &reg_base->pi[config->mbx_idx]);
+	data->mbx.ci = gpu_ipm_read32((mem_addr_t) &reg_base->ci[config->mbx_idx]);
+
+	if (data->mbx.pi_to_cb >= data->mbx.ci) {
+		avail_len = (data->mbx.len - (data->mbx.pi_to_cb - data->mbx.ci));
+	} else {
+		avail_len = data->mbx.ci - data->mbx.pi_to_cb;
+	}
+
+	if (avail_len)
+		*size = avail_len - 1;
+}
+
+static int ipm_gpu_mbx_claim_buffer(const struct device *dev, uint32_t size,
+				struct ipm_gpu_mbx_buffer_data *data)
+{
+	struct ipm_gpu_data *const dev_data = DEV_DATA(dev);
+	uint32_t f_size = 0, addr;
+
+	ipm_gpu_get_avail_size(dev, &f_size);
+	if (size > f_size)
+		return -ENOMEM;
+
+	addr = dev_data->mbx.base_addr + dev_data->mbx.pi_to_cb;
+	data->buffer_info[0].addr_lo = (uint32_t) (addr);
+
+	if ((dev_data->mbx.pi_to_cb + size) > dev_data->mbx.len) {
+		data->buffer_info[0].size = (dev_data->mbx.len - dev_data->mbx.pi_to_cb);
+		data->buffer_info[1].addr_lo = (uint32_t) dev_data->mbx.base_addr;
+		data->buffer_info[1].size = size - data->buffer_info[0].size;
+		data->valid_entries = 2;
+	} else {
+		data->buffer_info[0].size = size;
+		data->buffer_info[1].addr_lo = 0x0;
+		data->buffer_info[1].size = 0x0;
+		data->valid_entries = 1;
+	}
+
+	dev_data->mbx.pi_to_cb = (dev_data->mbx.pi_to_cb + size) % dev_data->mbx.len;
+	return 0;
+}
+
+static int ipm_gpu_mbx_manage_pi(const struct device *dev, uint32_t size)
+{
+	struct ipm_gpu_data *const data = DEV_DATA(dev);
+	const struct ipm_gpu_config *config = DEV_CFG(dev);
+	struct ipm_gpu_mbx_regs *reg_base = (struct ipm_gpu_mbx_regs *)(config->cfg_base);
+	uint32_t claimed_len;
+
+	if (data->mbx.pi > data->mbx.pi_to_cb) {
+		claimed_len = ((data->mbx.len - data->mbx.pi) + data->mbx.pi_to_cb);
+	} else {
+		claimed_len =  data->mbx.pi_to_cb - data->mbx.pi;
+	}
+
+	if (size > claimed_len)
+		return -EINVAL;
+
+	data->mbx.pi = (data->mbx.pi + size) % data->mbx.len;
+	gpu_ipm_write32(data->mbx.pi, (mem_addr_t) &reg_base->pi[config->mbx_idx]);
+	return 0;
+}
+
+static int gpu_queue_manage_ci(const struct device *dev, uint32_t size)
+{
+	struct ipm_gpu_data *const data = DEV_DATA(dev);
+	const struct ipm_gpu_config *config = DEV_CFG(dev);
+	struct ipm_gpu_mbx_regs *reg_base = (struct ipm_gpu_mbx_regs *)(config->cfg_base);
+	uint32_t busy_len;
+
+	/* buffer is always filled len - 1 */
+	if (size >= data->mbx.len)
+		return -EINVAL;
+
+	if (data->mbx.pi > data->mbx.ci) {
+		busy_len = data->mbx.pi - data->mbx.ci;
+	} else {
+		busy_len = ((data->mbx.len - data->mbx.ci) + data->mbx.pi);
+	}
+
+	if (size > busy_len)
+		return -EINVAL;
+
+	data->mbx.ci = (data->mbx.ci + size) % data->mbx.len;
+	gpu_ipm_write32(data->mbx.ci, (mem_addr_t) &reg_base->ci[config->mbx_idx]);
+	return 0;
+}
+
+static void ipm_gpu_mbx_process_data(const struct device *dev)
+{
+	struct ipm_gpu_data *const data = DEV_DATA(dev);
+	const struct ipm_gpu_config *config = DEV_CFG(dev);
+	struct ipm_gpu_mbx_regs *reg_base = (struct ipm_gpu_mbx_regs *)(config->cfg_base);
+	struct ipm_gpu_mbx_buffer_data mbx_data, cb_data;
+	struct ipm_gpu_msg_hdr msg_hdr;
+	uint32_t hdr_sz = sizeof(struct ipm_gpu_msg_hdr);
+	uint32_t m_size, addr;
+	int32_t t_size;
+
+	__ASSERT(data->callback != NULL,
+		 "No callback registered to ipm_gpu interrupt driver %p", dev);
+
+	data->mbx.pi = gpu_ipm_read32((mem_addr_t) &reg_base->pi[config->mbx_idx]);
+	if (data->mbx.pi == data->mbx.ci) {
+		LOG_ERR("no data received, spurious interrupt");
+		return;
+	}
+	CFG_HBW_ADDR_MNPL(0);
+
+	addr = data->mbx.base_addr + data->mbx.pi_to_cb;
+	mbx_data.buffer_info[0].addr_lo = (uint32_t) (addr);
+
+	if ((data->mbx.ci > data->mbx.pi) && (data->mbx.pi_to_cb > data->mbx.pi)) {
+		mbx_data.buffer_info[0].size =
+						(data->mbx.len - data->mbx.pi_to_cb);
+		mbx_data.buffer_info[1].addr_lo =
+						(uint32_t) (data->mbx.base_addr);
+		mbx_data.buffer_info[1].size = data->mbx.pi;
+		mbx_data.valid_entries = 2;
+		t_size = mbx_data.buffer_info[0].size +
+			 mbx_data.buffer_info[1].size;
+	} else {
+		mbx_data.buffer_info[0].size = (data->mbx.pi - data->mbx.pi_to_cb);
+		mbx_data.buffer_info[1].addr_lo = 0x0;
+		mbx_data.buffer_info[1].size = 0x0;
+		mbx_data.valid_entries = 1;
+		t_size = mbx_data.buffer_info[0].size;
+	}
+
+	while (t_size > 0) {
+
+		/*
+		 * There is possibility, the mailbox contents more than one message
+		 * In such scenarion, loop and perform callback till mailbox occupied
+		 * size is consumed.
+		 * Since the mailbox is operated as ring buffer with PI/CI, it is
+		 * important to clear the buffer in sequential order. There are two
+		 * ways to achieve this:
+		 * 1. Send all the message to application via registered callback.
+		 *    Application will work on data directly from mailbox buffer (zero copy)
+		 *    It's responsibility of application to free the buffer in sequential
+		 *    order.
+		 * 2. Send message details to application and once call is returned to ISR,
+		 *    clear the mailbox buffer. Application can process the message in callback
+		 *    itself or copy the data into buffer (1 copy) and process it later in
+		 *    workqueue.
+		 *    This way the clearing of buffer in sequential manner is handled by IPM driver
+		 *    itself.
+		 * Option 2 is implemented here.
+		 */
+		m_size = 0;
+		memset(&cb_data, 0x0, sizeof(struct ipm_gpu_mbx_buffer_data));
+		LOG_HEXDUMP_DBG_LOCAL((void *)mbx_data.buffer_info[0].addr_lo,
+					mbx_data.buffer_info[0].size, "receive");
+
+		if (mbx_data.buffer_info[0].size >= hdr_sz) {
+			memcpy(&msg_hdr, (void *)mbx_data.buffer_info[0].addr_lo, hdr_sz);
+			/* update size and addr */
+			mbx_data.buffer_info[0].size -= hdr_sz;
+			mbx_data.buffer_info[0].addr_lo += hdr_sz;
+			m_size += hdr_sz;
+
+			/* No data only msg id*/
+			if (!msg_hdr.size)
+				goto callback_ops;
+
+			if (msg_hdr.size > t_size) {
+				LOG_ERR_LOCAL("Incorrect msg size: %d send by transmitter dev:%p",
+						msg_hdr.size, dev);
+				CFG_HBW_ADDR_MNPL(1);
+				return;
+			}
+
+			if (msg_hdr.size > mbx_data.buffer_info[0].size) {
+				cb_data.valid_entries = 2;
+				cb_data.buffer_info[0].addr_lo = mbx_data.buffer_info[0].addr_lo;
+				cb_data.buffer_info[0].size = mbx_data.buffer_info[0].size;
+				cb_data.buffer_info[1].addr_lo = mbx_data.buffer_info[1].addr_lo;
+				cb_data.buffer_info[1].size = msg_hdr.size -
+							      mbx_data.buffer_info[0].size;
+
+				/* update size and addr */
+				mbx_data.buffer_info[0].size -= cb_data.buffer_info[0].size;
+				mbx_data.buffer_info[0].addr_lo += cb_data.buffer_info[0].size;
+				mbx_data.buffer_info[1].size -= cb_data.buffer_info[1].size;
+				mbx_data.buffer_info[1].addr_lo += cb_data.buffer_info[1].size;
+			} else {
+				cb_data.valid_entries = 1;
+				cb_data.buffer_info[0].addr_lo = mbx_data.buffer_info[0].addr_lo;
+				cb_data.buffer_info[0].size = msg_hdr.size;
+
+				/* update size and addr */
+				mbx_data.buffer_info[0].size -= msg_hdr.size;
+				mbx_data.buffer_info[0].addr_lo += msg_hdr.size;
+			}
+
+			m_size += msg_hdr.size;
+		} else {
+			if (mbx_data.buffer_info[0].size)
+				memcpy(&msg_hdr, (void *)mbx_data.buffer_info[0].addr_lo,
+					mbx_data.buffer_info[0].size);
+
+			memcpy(&msg_hdr, (void *)mbx_data.buffer_info[1].addr_lo,
+					(hdr_sz - mbx_data.buffer_info[0].size));
+
+			/* update size and addr */
+			mbx_data.buffer_info[1].size -= (hdr_sz - mbx_data.buffer_info[0].size);
+			mbx_data.buffer_info[1].addr_lo += (hdr_sz - mbx_data.buffer_info[0].size);
+			mbx_data.buffer_info[0].size = 0;
+			m_size += hdr_sz;
+
+			/* No data only msg id*/
+			if (!msg_hdr.size)
+				goto callback_ops;
+
+			if (msg_hdr.size > t_size) {
+				LOG_ERR_LOCAL("Incorrect msg size: %d send by transmitter dev:%p",
+						msg_hdr.size, dev);
+				return;
+			}
+
+			cb_data.valid_entries = 1;
+			cb_data.buffer_info[0].addr_lo = mbx_data.buffer_info[1].addr_lo;
+			cb_data.buffer_info[0].size = msg_hdr.size;
+
+			/* update size and addr */
+			mbx_data.buffer_info[1].size -= msg_hdr.size;
+			mbx_data.buffer_info[1].addr_lo += msg_hdr.size;
+			m_size += msg_hdr.size;
+		}
+
+callback_ops:
+		data->mbx.pi_to_cb = (data->mbx.pi_to_cb + m_size) % data->mbx.len;
+		if (data->callback)
+			data->callback(dev, data->user_data, msg_hdr.id, &cb_data);
+
+		if (gpu_queue_manage_ci(dev, m_size))
+			LOG_DBG_LOCAL("Incorrect size: %d passed to update mailbox CI dev:%p",
+					m_size, dev);
+		t_size -= m_size;
+	}
+	CFG_HBW_ADDR_MNPL(1);
+}
+
+static void ipm_gpu_init_mbx_data(const struct device *dev)
+{
+	struct ipm_gpu_data *const data = DEV_DATA(dev);
+	const struct ipm_gpu_config *config = DEV_CFG(dev);
+	struct ipm_gpu_mbx_regs *reg_base = (struct ipm_gpu_mbx_regs *)(config->cfg_base);
+
+
+	data->mbx.base_addr =
+		(uint32_t)gpu_ipm_read32((mem_addr_t) &reg_base->base_addr_lsb[config->mbx_idx]);
+	data->mbx.len = gpu_ipm_read32((mem_addr_t) &reg_base->q_size[config->mbx_idx]);
+	data->mbx.ci = 0;
+	data->mbx.pi = 0;
+	data->mbx.pi_to_cb = 0;
+}
+
+void ipm_gpu_isr(const struct device *dev)
+{
+	const struct ipm_gpu_config *config = DEV_CFG(dev);
+	struct ipm_gpu_mbx_regs *reg_base = (struct ipm_gpu_mbx_regs *)(config->cfg_base);
+	/*
+	 * RX will get 2 interrupts
+	 * 1. mbx enable
+	 * 2. pi write
+	 */
+	uint32_t en_sts = (gpu_ipm_read32((mem_addr_t)&reg_base->en_sts) & BIT(config->mbx_idx));
+	uint32_t pi_sts = (gpu_ipm_read32((mem_addr_t)&reg_base->pi_sts) & BIT(config->mbx_idx));
+
+	if (!en_sts && !pi_sts) {
+		LOG_DBG("Interrupt does not belong to dev %p", dev);
+	}
+	/* mbx enable routine */
+	if (en_sts) {
+		ipm_gpu_init_mbx_data(dev);
+		gpu_ipm_write32(BIT(config->mbx_idx), (mem_addr_t)&(reg_base->en_sts));
+		return;
+	}
+
+	/* PI write routine */
+	if (pi_sts) {
+		ipm_gpu_mbx_process_data(dev);
+		gpu_ipm_write32(BIT(config->mbx_idx), (mem_addr_t)&reg_base->pi_sts);
+	}
+}
+
+static inline int ipm_gpu_rx_is_ready(const struct device *dev)
+{
+	const struct ipm_gpu_config *config = DEV_CFG(dev);
+	struct ipm_gpu_mbx_regs *reg_base = (struct ipm_gpu_mbx_regs *)(config->cfg_base);
+
+	if ((gpu_ipm_read32((mem_addr_t)&reg_base->en_sts) & BIT(config->mbx_idx)) ||
+		!(gpu_ipm_read32((mem_addr_t)&reg_base->en[config->mbx_idx]))) {
+		return false;
+	}
+	return true;
+}
+
+int ipm_gpu_send(const struct device *dev, int wait, uint32_t id, const void *data, int size)
+{
+	struct ipm_gpu_mbx_buffer_data mbx_data;
+	struct ipm_gpu_msg_hdr msg_hdr;
+	uint32_t hdr_sz = sizeof(struct ipm_gpu_msg_hdr);
+	uint32_t req_sz = hdr_sz + size, cp_sz;
+	int ret;
+
+	if (!ipm_gpu_rx_is_ready(dev)) {
+		LOG_DBG_LOCAL("Receiver not ready to accept message, please retry later");
+		return -EAGAIN;
+	}
+
+	if ((size) && (!data)) {
+		LOG_ERR_LOCAL("Null data buffer received for non-zero size: %d dev: %p",
+				size, dev);
+		return -EINVAL;
+	}
+
+	CFG_HBW_ADDR_MNPL(0);
+	ret = ipm_gpu_mbx_claim_buffer(dev, req_sz, &mbx_data);
+	if (ret) {
+		LOG_ERR_LOCAL("mailbox buffer allocation failed ret:%d req_sz: %d",
+				ret, req_sz);
+		goto addr_mnpl;
+	}
+
+	msg_hdr.id = id;
+	msg_hdr.size = size;
+	if (mbx_data.valid_entries == IPM_GPU_MBX_NUM_DATA_ELEMENT) {
+		if (mbx_data.buffer_info[0].size > hdr_sz) {
+			memcpy((void *)mbx_data.buffer_info[0].addr_lo, &msg_hdr, hdr_sz);
+			memcpy((void *) (mbx_data.buffer_info[0].addr_lo + hdr_sz), data,
+					mbx_data.buffer_info[0].size - hdr_sz);
+			memcpy((void *) (mbx_data.buffer_info[1].addr_lo),
+					(uint32_t *)data + (mbx_data.buffer_info[0].size - hdr_sz),
+					mbx_data.buffer_info[1].size);
+		} else {
+			memcpy((void *)mbx_data.buffer_info[0].addr_lo, &msg_hdr,
+				mbx_data.buffer_info[0].size);
+			if (hdr_sz > mbx_data.buffer_info[0].size)
+				memcpy((void *)mbx_data.buffer_info[1].addr_lo,
+					&msg_hdr + mbx_data.buffer_info[0].size,
+					hdr_sz - mbx_data.buffer_info[0].size);
+
+			cp_sz = mbx_data.buffer_info[1].size -
+				(hdr_sz - mbx_data.buffer_info[0].size);
+			if (cp_sz)
+				memcpy((void *) (mbx_data.buffer_info[1].addr_lo +
+					(hdr_sz - mbx_data.buffer_info[0].size)), data,
+					cp_sz);
+		}
+	} else {
+		memcpy((void *)mbx_data.buffer_info[0].addr_lo, &msg_hdr, hdr_sz);
+		if (data)
+			memcpy((void *) (mbx_data.buffer_info[0].addr_lo + hdr_sz), data, size);
+		LOG_HEXDUMP_DBG_LOCAL((void *)mbx_data.buffer_info[0].addr_lo,
+					hdr_sz + size, "send");
+	}
+
+	ret = ipm_gpu_mbx_manage_pi(dev, req_sz);
+	if (ret)
+		LOG_ERR_LOCAL("unable to send message ret:%d for msg_id: %d", ret, id);
+addr_mnpl:
+	CFG_HBW_ADDR_MNPL(1);
+	return ret;
+}
+
+void ipm_gpu_register_callback(const struct device *dev,
+				 ipm_callback_t cb,
+				 void *user_data)
+{
+	struct ipm_gpu_data *data = dev->data;
+
+	data->callback = cb;
+}
+
+int ipm_gpu_max_data_size_get(const struct device *dev)
+{
+	return 0;
+}
+
+uint32_t ipm_gpu_max_id_val_get(const struct device *dev)
+{
+	ARG_UNUSED(dev);
+
+	return 0;
+}
+
+#ifdef CONFIG_IPM_INTEL_GPU_RX_MBX
+int ipm_gpu_irq_init(const struct device *dev)
+{
+	const struct ipm_gpu_config *config = DEV_CFG(dev);
+	struct ipm_gpu_data *const data = DEV_DATA(dev);
+	uint32_t val = sys_read32((mem_addr_t) config->intr_mask);
+
+	data->shared_irq_dev = DEVICE_DT_GET(DT_NODELABEL(sw_malibox_irq));
+	if (!data->shared_irq_dev) {
+		LOG_ERR("Failed to get sw_malibox_irq device binding");
+		return -ENODEV;
+	}
+
+	/* Register for interrupt */
+	shared_irq_isr_register(data->shared_irq_dev, (isr_t)ipm_gpu_isr, dev);
+	/* Unmask the psoc interrupt */
+	val &= ~BIT(config->mask_idx);
+	sys_write32(val, config->intr_mask);
+	/* Enable the psoc interrupt */
+	shared_irq_enable(data->shared_irq_dev, dev);
+
+	return 0;
+}
+#endif
+
+int ipm_gpu_set_enabled(const struct device *dev, int enable)
+{
+	const struct ipm_gpu_config *config = DEV_CFG(dev);
+	struct ipm_gpu_mbx_regs *reg_base = (struct ipm_gpu_mbx_regs *)(config->cfg_base);
+
+	gpu_ipm_write32((enable) ? 0x1 : 0x0, (mem_addr_t) &reg_base->en[config->mbx_idx]);
+	return 0;
+}
+
+int ipm_gpu_clear(const struct device *dev, uint32_t id)
+{
+	return 0;
+}
+
+void ipm_gpu_tx_init(const struct device *dev)
+{
+	const struct ipm_gpu_config *config = DEV_CFG(dev);
+	struct ipm_gpu_mbx_regs *reg_base = (struct ipm_gpu_mbx_regs *)(config->cfg_base);
+
+	/*
+	 * TX will fill all the buffer content lo/hi addr and size
+	 * and then set enable interrupt in ipm_gpu_set_enabled function.
+	 */
+	gpu_ipm_write32(config->data_base, (mem_addr_t) &reg_base->base_addr_lsb[config->mbx_idx]);
+	gpu_ipm_write32(0x0, (mem_addr_t) &reg_base->base_addr_msb[config->mbx_idx]);
+	gpu_ipm_write32(config->data_size, (mem_addr_t) &reg_base->q_size[config->mbx_idx]);
+	gpu_ipm_write32(0x0, (mem_addr_t) &reg_base->pi[config->mbx_idx]);
+	gpu_ipm_write32(0x0, (mem_addr_t) &reg_base->ci[config->mbx_idx]);
+
+	CFG_HBW_ADDR_MNPL(0);
+	/* Clear mailbox buffer */
+	memset((void *)config->data_base, 0x0, config->data_size);
+	CFG_HBW_ADDR_MNPL(1);
+
+	/* init mbx buffer data */
+	ipm_gpu_init_mbx_data(dev);
+}
+
+int ipm_gpu_init(const struct device *dev)
+{
+	const struct ipm_gpu_config *config = DEV_CFG(dev);
+
+	LOG_INF("IPM GPU mbx comms %s dev %p enumeration start",
+		(config->mbx_type == MBX_TX_ONLY) ? "TX" : "RX", dev);
+
+	if (config->init) {
+		config->init(dev);
+	}
+
+	if (config->irq_config_func)
+		config->irq_config_func(dev);
+
+	LOG_INF("IPM GPU mbx comms %s dev %p enumeration end",
+		(config->mbx_type == MBX_TX_ONLY) ? "TX" : "RX", dev);
+
+	return 0;
+}
diff --git a/drivers/ipm/ipm_gpu.h b/drivers/ipm/ipm_gpu.h
new file mode 100644
index 0000000..d908c31
--- /dev/null
+++ b/drivers/ipm/ipm_gpu.h
@@ -0,0 +1,133 @@
+/*
+ * Copyright (c) 2025 Intel
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_DRIVERS_IPM_GPU_COMMON_H_
+#define ZEPHYR_DRIVERS_IPM_GPU_COMMON_H_
+
+#include <zephyr/device.h>
+#include <soc/intel/gpu/jgs/soc.h>
+#include <zephyr/drivers/ipm.h>
+#include <hl_platform_defs.h>
+
+#include <zephyr/logging/log.h>
+
+#define LOG_ERR_LOCAL(...)		LOG_INST_ERR(DEV_CFG(dev)->log, __VA_ARGS__)
+#define LOG_WRN_LOCAL(...)		LOG_INST_WRN(DEV_CFG(dev)->log, __VA_ARGS__)
+#define LOG_INF_LOCAL(...)		LOG_INST_INF(DEV_CFG(dev)->log, __VA_ARGS__)
+#define LOG_DBG_LOCAL(...)		LOG_INST_DBG(DEV_CFG(dev)->log, __VA_ARGS__)
+#define LOG_HEXDUMP_ERR_LOCAL(_data, _length, _str)	\
+		LOG_INST_HEXDUMP_ERR(DEV_CFG(dev)->log, _data, _length, _str)
+#define LOG_HEXDUMP_WRN_LOCAL(_data, _length, _str)	\
+		LOG_INST_HEXDUMP_WRN(DEV_CFG(dev)->log, _data, _length, _str)
+#define LOG_HEXDUMP_INF_LOCAL(_data, _length, _str)	\
+		LOG_INST_HEXDUMP_INF(DEV_CFG(dev)->log, _data, _length, _str)
+#define LOG_HEXDUMP_DBG_LOCAL(_data, _length, _str)	\
+		LOG_INST_HEXDUMP_DBG(DEV_CFG(dev)->log, _data, _length, _str)
+
+#define IPM_GPU_MAX_DATA_SIZE		256
+#define IPM_GPU_MAX_ID_VAL		(UINT32_MAX - 1)
+
+#define IPM_GPU_MBX_MASK			0xFF
+#define IPM_GPU_NUM_SW_MBX		4
+#define IPM_GPU_SW_MBX_ADDR_MASK		0xFFFFFF00
+struct ipm_gpu_mbx_regs {
+	uint32_t base_addr_msb[4];	/* offset 0x0 */
+	uint32_t rsvd1[28];
+	uint32_t base_addr_lsb[4];	/* offset 0x80 */
+	uint32_t rsvd2[28];
+	uint32_t q_size[4];		/* offset 0x100 */
+	uint32_t rsvd3[28];
+	uint32_t pi[4];			/* offset 0x180 */
+	uint32_t rsvd4[28];
+	uint32_t ci[4];			/* offset 0x200 */
+	uint32_t rsvd5[28];
+	uint32_t en[4];			/* offset 0x280 */
+	uint32_t rsvd6[348];
+	uint32_t en_sts;		/* offset 0x800 */
+	uint32_t rsvd7[63];
+	uint32_t pi_sts;		/* offset 0x900 */
+};
+
+/*
+ * This structure represents msg header.
+ * The Fields are:
+ * id: Each msg is identified with this ID.
+ * size: Size of original msg
+ */
+struct ipm_gpu_msg_hdr {
+	uint32_t id;
+	uint32_t size;
+};
+
+
+enum ipm_gpu_mbx_type {
+	MBX_TX_ONLY = 1,
+	MBX_RX_ONLY = 2
+};
+
+struct ipm_gpu_config {
+	enum ipm_gpu_mbx_type mbx_type;
+	int (*irq_config_func)(const struct device *dev);
+	void (*init)(const struct device *dev);
+	uint32_t cfg_base;
+	uint32_t data_base;
+	uint32_t data_size;
+	uint32_t intr_mask;
+	uint8_t mbx_idx;
+	uint8_t mask_idx;
+	uint8_t inter_die;
+
+	LOG_INSTANCE_PTR_DECLARE(log);
+};
+
+struct ipm_gpu_mbx {
+	uint32_t base_addr;
+	uint32_t pi;
+	uint32_t ci;
+	uint32_t len;
+	uint32_t pi_to_cb;
+};
+
+struct ipm_gpu_data {
+	ipm_callback_t callback;
+	struct ipm_gpu_mbx mbx;
+	void *user_data;
+	const struct device *shared_irq_dev;
+};
+
+#define IPM_GPU_MBX_NUM_DATA_ELEMENT	2
+
+struct ipm_gpu_mbx_buffer_info {
+	uint32_t addr_lo;
+	uint32_t size;
+};
+
+struct ipm_gpu_mbx_buffer_data {
+	uint8_t valid_entries;
+	struct ipm_gpu_mbx_buffer_info buffer_info[IPM_GPU_MBX_NUM_DATA_ELEMENT];
+};
+
+#define DEV_CFG(dev) \
+	((struct ipm_gpu_config *)(dev->config))
+
+#define DEV_DATA(dev) \
+	((struct ipm_gpu_data * const)(dev->data))
+
+void ipm_gpu_isr(const struct device *dev);
+int ipm_gpu_send(const struct device *dev, int wait, uint32_t id,
+			 const void *data, int size);
+void ipm_gpu_register_callback(const struct device *dev,
+				       ipm_callback_t cb,
+				       void *user_data);
+int ipm_gpu_max_data_size_get(const struct device *dev);
+uint32_t ipm_gpu_max_id_val_get(const struct device *dev);
+int ipm_gpu_set_enabled(const struct device *dev, int enable);
+int ipm_gpu_clear(const struct device *dev, uint32_t id);
+int ipm_gpu_init(const struct device *dev);
+int ipm_gpu_irq_init(const struct device *dev);
+void ipm_gpu_tx_init(const struct device *dev);
+
+#endif /* ZEPHYR_DRIVERS_IPM_GPU_COMMON_H_ */
