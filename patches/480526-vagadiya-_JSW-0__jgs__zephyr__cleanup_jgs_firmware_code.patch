+ */
+
+#ifndef _JGS_ENGINE_BINNING_H_
+#define _JGS_ENGINE_BINNING_H_
+
+#include <jgs_fw_if.h>
+#include <jgs_binning_defs.h>
+
+#define JGS_ENGINE_BINNING_DRV_DATA(dev) \
+	((struct jgs_engine_binning_drv_data *)(dev)->data)
+
+#define RTR_REGION_ENABLE		1
+
+#define LBW_REG_VAL(x_src, y_src, x_dst, y_dst) \
+		((RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_X_SRC_M & \
+			(x_src << RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_X_SRC_S)) | \
+		(RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_Y_SRC_M & \
+			(y_src << RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_Y_SRC_S)) | \
+		(RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_X_DST_M & \
+			(x_dst << RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_X_DST_S)) | \
+		(RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_Y_DST_M & \
+			(y_dst << RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_Y_DST_S)) | \
+		(RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_EN_M & \
+		(RTR_REGION_ENABLE << RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_EN_S)))
+
+#define DBG_REG_VAL(x_src, y_src, x_dst, y_dst) \
+		((RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_X_SRC_M & \
+			(x_src << RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_X_SRC_S)) | \
+		(RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_Y_SRC_M & \
+			(y_src << RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_Y_SRC_S)) | \
+		(RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_X_DST_M & \
+			(x_dst << RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_X_DST_S)) | \
+		(RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_Y_DST_M & \
+			(y_dst << RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_Y_DST_S)) | \
+		(RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_EN_M & \
+		(RTR_REGION_ENABLE << RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_EN_S)))
+
+struct jgs_engine_binning_drv_data {
+	bool binning_data_available;
+	enum jgs_die_id die_id;
+	int redundant_dec[JGS_NUM_HALF_DIES];
+	int redundant_nic;
+	int redundant_pmmu;
+	uint32_t jgs_free_remap_reg_idx;
+	void *redundancy_ctx;
+};
+
+int jgs_io_get_free_remap_reg_index(struct jgs_engine_binning_drv_data *data);
+
+void jgs_io_die_run_binning_decoder(struct jgs_engine_binning_drv_data *data);
+void jgs_io_die_run_binning_nic(struct jgs_engine_binning_drv_data *data);
+void jgs_io_die_run_binning_pmmu(struct jgs_engine_binning_drv_data *data);
+
+int jgs_io_run_engine_binning(struct jgs_engine_binning_drv_data *data);
+int jgs_io_init_dev_redundancy_data(struct jgs_engine_binning_drv_data *data);
+
+int jgs_compute_run_engine_binning(struct jgs_engine_binning_drv_data *data);
+int jgs_compute_init_dev_redundancy_data(struct jgs_engine_binning_drv_data *data);
+
+#endif /* _JGS_ENGINE_BINNING_H_ */
