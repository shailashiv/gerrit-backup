diff --git a/drivers/misc/gpu_isolation_binning/jgs/nic_binning.c b/drivers/misc/gpu_isolation_binning/jgs/nic_binning.c
new file mode 100644
index 0000000..bc941b3
--- /dev/null
+++ b/drivers/misc/gpu_isolation_binning/jgs/nic_binning.c
@@ -0,0 +1,207 @@
+/* SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2025 Intel, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <zephyr/kernel.h>
+#include <hl_platform_defs.h>
+#include <jgs_binning_defs.h>
+
+#include "engine_binning.h"
+#include <jgs_blocks_linux_driver.h>
+#include <rtr_addr_dec_lbw_regs.h>
+#include <rtr_addr_dec_lbw_masks.h>
+#include <rtr_addr_dec_dbg_regs.h>
+#include <rtr_addr_dec_dbg_masks.h>
+#include <axid_masks.h>
+#include <psoc_boot_conf_regs.h>
+
+#include <zephyr/logging/log.h>
+LOG_MODULE_REGISTER(nic_binning);
+
+/* reference: H15_NOC_MeshXY.xlsx */
+uint8_t nic_mesh_coordinate[GPU_NUM_IO_DIES * GPU_NUM_NIC_PER_DIE][2] = {
+	/* IO-Die0 */
+	{52, 0}, {56, 0}, {56, 1}, {56, 2}, {60, 0}, {60, 1},
+	{60, 4}, {68, 0}, {68, 1}, {68, 2}, {72, 0}, {72, 1}, {72, 2},
+	/* IO-Die1 */
+	{75, 63}, {71, 63}, {71, 62}, {71, 61}, {67, 63}, {67, 62},
+	{67, 59}, {59, 63}, {59, 62}, {59, 61}, {55, 63}, {55, 62}, {55, 61},
+};
+
+static void nic_binning_config_lbw(uint32_t lbw_reg_val, enum jgs_die_id die_id,
+		int32_t lbw_remap_reg_idx)
+{
+	uint32_t offset;
+
+	/* next available DEC_LBW_LBW_XY_REMAP register offset */
+	offset = mmRTR_ADDR_DEC_LBW_LBW_XY_REMAP_0 +
+		(lbw_remap_reg_idx * sizeof(uint32_t));
+
+	/* Configure NOCL, NOCML, NOCMC, NOCP scope for LBW_XY_REMAP */
+	CFG_WREG32(mmIO_0_CFG_HALF_0_SOC_0_NOCL_NOC_CTRL_LBW_RTR_ADDR_DEC_LBW_BASE +
+			offset, lbw_reg_val);
+	CFG_WREG32(mmIO_0_CFG_HALF_0_SOC_0_NOCML_NOC_CTRL_LBW_RTR_ADDR_DEC_LBW_BASE +
+			offset, lbw_reg_val);
+	CFG_WREG32(mmIO_0_CFG_HALF_0_SOC_0_NOCMC_NOC_CTRL_LBW_RTR_ADDR_DEC_LBW_BASE +
+			offset, lbw_reg_val);
+	CFG_WREG32(mmIO_0_CFG_HALF_0_SOC_0_NOCP_NOC_CTRL_LBW_RTR_ADDR_DEC_LBW_BASE +
+			offset, lbw_reg_val);
+
+	LOG_DBG("%s offset = 0x%x, lbw_reg_val = 0x%x", __func__, offset, lbw_reg_val);
+}
+
+static void nic_binning_config_dbg(uint32_t dbg_reg_val, enum jgs_die_id die_id,
+		int32_t lbw_remap_reg_idx)
+{
+	uint32_t offset;
+
+	/* next available DEC_DBG_DBG_XY_REMAP register offset */
+	offset = mmRTR_ADDR_DEC_DBG_DBG_XY_REMAP_0 +
+		(lbw_remap_reg_idx * sizeof(uint32_t));
+
+	/* Configure NOCP for DBG_XY_REMAP; NOCL, NOCML, NOCMC are not present for DBG */
+	CFG_WREG32(mmIO_0_CFG_HALF_0_SOC_0_NOCP_NOC_ADDR_DEC_DBG_BASE + offset, dbg_reg_val);
+
+	LOG_DBG("%s offset = 0x%x, dbg_reg_val = 0x%x", __func__, offset, dbg_reg_val);
+}
+
+static void nic_binning_config_ax_crd(uint32_t crd_reg_val, enum jgs_die_id die_id,
+			uint32_t nic_index)
+{
+	uint32_t fc_mstr_if_reg_addr, hbw_reg_offset, hbw_ovrd_axid_reg_ofst;
+	uint32_t lbw_reg_offset, lbw_ovrd_axid_reg_ofst, half_die_offset, nic_offset;
+	uint32_t reg_addr;
+
+	/* IO Die 0 */
+	fc_mstr_if_reg_addr = mmIO_0_CFG_HALF_0_NSS_NIC_0_NIC_FC_MSTR_IF_BASE;
+
+	/* can these be coded ad MACRO to save local variables */
+	hbw_reg_offset = mmIO_0_CFG_HALF_0_NSS_NIC_0_NIC_FC_MSTR_IF_HBW_BASE -
+				mmIO_0_CFG_HALF_0_NSS_NIC_0_NIC_FC_MSTR_IF_BASE; /* = 0 */
+
+	hbw_ovrd_axid_reg_ofst = mmIO_0_CFG_HALF_0_NSS_NIC_0_NIC_FC_MSTR_IF_HBW_AXI_OVRD_AXID_BASE -
+				mmIO_0_CFG_HALF_0_NSS_NIC_0_NIC_FC_MSTR_IF_HBW_BASE; /* = 0x40 */
+
+	lbw_reg_offset = mmIO_0_CFG_HALF_0_NSS_NIC_0_NIC_FC_MSTR_IF_LBW_BASE -
+				mmIO_0_CFG_HALF_0_NSS_NIC_0_NIC_FC_MSTR_IF_BASE; /* = 0x600 */
+
+	lbw_ovrd_axid_reg_ofst = mmIO_0_CFG_HALF_0_NSS_NIC_0_NIC_FC_MSTR_IF_LBW_AXI_OVRD_AXID_BASE -
+				mmIO_0_CFG_HALF_0_NSS_NIC_0_NIC_FC_MSTR_IF_LBW_BASE; /* = 0x88 */
+
+	half_die_offset = (nic_index >= GPU_NUM_OF_NIC_PER_IO_DIE_HALF) ?
+				mmIO_0_CFG_HALF_1_NSS_NIC_0_NIC_FC_MSTR_IF_BASE -
+				mmIO_0_CFG_HALF_0_NSS_NIC_0_NIC_FC_MSTR_IF_BASE :
+				0; /* = 0x2000000 (half 1) or 0x0 (half 0)*/
+
+
+	/* each half die holds nic 0 to 5 */
+	nic_index = (nic_index >= GPU_NUM_OF_NIC_PER_IO_DIE_HALF) ?
+				nic_index - GPU_NUM_OF_NIC_PER_IO_DIE_HALF :
+				nic_index;
+
+	nic_offset = mmIO_0_CFG_HALF_0_NSS_NIC_1_NIC_FC_MSTR_IF_BASE -
+				 mmIO_0_CFG_HALF_0_NSS_NIC_0_NIC_FC_MSTR_IF_BASE; /* = 0x40000 */
+
+	/* IO_i_CFG ➔ HALF_j ➔ NSS ➔ NIC_k ➔ NIC ➔ FC_MSTR_IF ➔ HBW ➔
+	 * AXI_OVRD ➔ AXID ➔ AX_XY_CRD
+	 * i = io die id 0/1; j = half die id 0/1; k = binned nic_index to 11 excluding spare (12)
+	 */
+	reg_addr = fc_mstr_if_reg_addr + hbw_reg_offset + hbw_ovrd_axid_reg_ofst +
+				(nic_offset * nic_index) + half_die_offset;
+	CFG_WREG32(reg_addr, crd_reg_val);
+	LOG_DBG("%s: hbw_addr: 0x%x, val = 0x%x", __func__, reg_addr, crd_reg_val);
+
+	/* IO_i_CFG ➔ HALF_j ➔ NSS ➔ NIC_k ➔ NIC ➔ FC_MSTR_IF ➔ LBW ➔
+	 * AXI_OVRD ➔ AXID ➔ AX_XY_CRD
+	 */
+	reg_addr = fc_mstr_if_reg_addr + lbw_reg_offset + lbw_ovrd_axid_reg_ofst +
+				(nic_offset * nic_index) + half_die_offset;
+	CFG_WREG32(reg_addr, crd_reg_val);
+	LOG_DBG("%s: lbw_addr: 0x%x, val = 0x%x", __func__, reg_addr, crd_reg_val);
+}
+
+/*
+ * Assumptions:
+ * 1. For each IO die, up to one of the NIC can be binned out
+ * 2. Binning is performed per IO die.
+ */
+void jgs_io_die_run_binning_nic(struct jgs_engine_binning_drv_data *data)
+{
+	uint32_t  j;
+	uint32_t x_src, y_src, x_dst, y_dst;
+	uint32_t io_die_id = (data->die_id - GPU_IO_DIE_0) / GPU_NUM_HALF_DIES;
+	uint32_t  lbw_reg_val, dbg_reg_val, crd_reg_val;
+	uint32_t nic_redn_cfg_val = 0;
+	int32_t lbw_remap_reg_idx;
+
+	/* If there is no faulty nic, skip binning */
+	if (data->redundant_nic == GPU_NO_FAULTY_NIC) {
+		LOG_DBG("%s redundant_nic = %d", __func__, data->redundant_nic);
+		return;
+	}
+
+	LOG_INF("%s redundant_nic = %d", __func__, data->redundant_nic);
+	/* if NIC[j] is binned out, set all bits [0] to [j-1] to 1’b1.
+	 * Example: NIC[4] is binned out => set bits [3:0], so config value is 0xF
+	 */
+	for (j = 0; j < data->redundant_nic; j++) {
+		nic_redn_cfg_val |= (1 << j);
+	}
+
+	/* TODO: If 12th NIC is redundant, configure mmPSOC_BOOT_CONF_NIC_REDUNDANCY and
+	 * skip nic binning. skip biining will be taken care by below for loop
+	 * condition checking.
+	 */
+	CFG_WREG32(mmIO_0_CFG_HALF_0_PSOC_BOOT_BOOT_BASE + mmPSOC_BOOT_CONF_NIC_REDUNDANCY,
+				nic_redn_cfg_val);
+
+	LOG_DBG("%s: IO Die[%u] -> redundant nic = %u, nic_redn_cfg_val = %u",
+				__func__, io_die_id, data->redundant_nic, nic_redn_cfg_val);
+
+	/* if NIC[i] is binned out: For j = i to 11
+	 * X_SRC, Y_SRC= NIC[j] XY
+	 * X_DST, Y_DST = NIC[j+1] XY
+	 * EN = 1
+	 */
+
+	/* TODO: Check for number of entries, 0.5 PRM 20 entries, spec: 40 remap registers */
+
+	for (j = data->redundant_nic; j < (GPU_NUM_NIC_PER_DIE - 1) /* nic: 0 - 12 */; j++) {
+
+		x_src = nic_mesh_coordinate[j + (io_die_id * GPU_NUM_NIC_PER_DIE)][0];
+		y_src = nic_mesh_coordinate[j + (io_die_id * GPU_NUM_NIC_PER_DIE)][1];
+
+		x_dst = nic_mesh_coordinate[(j + 1) + (io_die_id * GPU_NUM_NIC_PER_DIE)][0];
+		y_dst = nic_mesh_coordinate[(j + 1) + (io_die_id * GPU_NUM_NIC_PER_DIE)][1];
+
+		LOG_DBG("%s x_src = %u, y_src = %u, x_dst = %u, y_dst = %u", __func__,
+				x_src, y_src, x_dst, y_dst);
+
+		/* RTR_CTRL_LBW_CFG ➔ RTR_ADDR_DEC_LBW ➔ LBW_XY_REMAP */
+		lbw_reg_val = LBW_REG_VAL(x_src, y_src, x_dst, y_dst);
+
+		/* IO_NOCP ➔ NOC_ADDR_DEC_DBG ➔ DBG_XY_REMAP */
+		dbg_reg_val = DBG_REG_VAL(x_src, y_src, x_dst, y_dst);
+
+		/* IO_0_CFG ➔ HALF_1 ➔ NSS ➔ NIC_0 ➔ NIC ➔ FC_MSTR_IF ➔ HBW ➔
+		 * AXI_OVRD ➔ AXID ➔ AX_XY_CRD
+		 * corresponding HBW and LBW registers fields are same.
+		 */
+		crd_reg_val = ((x_dst << AXID_AX_XY_CRD_WR_X_CRD_S) |
+					(y_dst << AXID_AX_XY_CRD_WR_Y_CRD_S) |
+					(x_dst << AXID_AX_XY_CRD_RD_X_CRD_S) |
+					(y_dst << AXID_AX_XY_CRD_RD_Y_CRD_S));
+
+		lbw_remap_reg_idx = jgs_io_get_free_remap_reg_index(data);
+		if (lbw_remap_reg_idx < 0) {
+			LOG_ERR("lbw_xy_remap register not available, nic binning failed");
+			break;
+		}
+
+		nic_binning_config_lbw(lbw_reg_val, data->die_id, lbw_remap_reg_idx);
+		nic_binning_config_dbg(dbg_reg_val, data->die_id, lbw_remap_reg_idx);
+		nic_binning_config_ax_crd(crd_reg_val, data->die_id, j);
+	}
+}
diff --git a/drivers/misc/gpu_isolation_binning/jgs/pmmu_binning.c b/drivers/misc/gpu_isolation_binning/jgs/pmmu_binning.c
new file mode 100644
index 0000000..bea7de0
--- /dev/null
+++ b/drivers/misc/gpu_isolation_binning/jgs/pmmu_binning.c
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2025 Intel, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <zephyr/kernel.h>
+#include <hl_platform_defs.h>
+#include <jgs_binning_defs.h>
+
+#include "engine_binning.h"
+#include <jgs_blocks_linux_driver.h>
+#include <rtr_addr_dec_lbw_regs.h>
+#include <rtr_addr_dec_lbw_masks.h>
+#include <rtr_addr_dec_dbg_regs.h>
+#include <rtr_addr_dec_dbg_masks.h>
+
+#include <zephyr/logging/log.h>
+LOG_MODULE_REGISTER(pmmu_binning);
+
+#define PMMU_DISABLE_VAL			0x3
+
+/* TODO: PRM 0.5 register and soc online, does not match */
+static const uint32_t lbw_pmmu_offset[] = {
+	mmRTR_ADDR_DEC_LBW_LBW_SHORT_58_REG_EN_AUTO, /* PMMU */
+};
+
+static const uint32_t dbg_pmmu_offset[] = {
+	mmRTR_ADDR_DEC_DBG_DBG_SHORT_28_REG_EN_AUTO, /* PMMU */
+};
+
+static void pmmu_binning_config_lbw(struct jgs_engine_binning_drv_data *data)
+{
+	uint32_t offset, index;
+	uint32_t limit =  ARRAY_SIZE(lbw_pmmu_offset);
+
+	for (index = 0; index < limit; index++) {
+		offset = lbw_pmmu_offset[index];
+
+		/* Configure NOCL, NOCML, NOCMC, NOCP scope */
+		CFG_WREG32(mmIO_0_CFG_HALF_0_SOC_0_NOCL_NOC_CTRL_LBW_RTR_ADDR_DEC_LBW_BASE +
+					offset, PMMU_DISABLE_VAL);
+		CFG_WREG32(mmIO_0_CFG_HALF_0_SOC_0_NOCML_NOC_CTRL_LBW_RTR_ADDR_DEC_LBW_BASE +
+					offset, PMMU_DISABLE_VAL);
+		CFG_WREG32(mmIO_0_CFG_HALF_0_SOC_0_NOCMC_NOC_CTRL_LBW_RTR_ADDR_DEC_LBW_BASE +
+					offset, PMMU_DISABLE_VAL);
+		CFG_WREG32(mmIO_0_CFG_HALF_0_SOC_0_NOCP_NOC_CTRL_LBW_RTR_ADDR_DEC_LBW_BASE +
+					offset, PMMU_DISABLE_VAL);
+		LOG_DBG("%s: offset = 0x%x", __func__, offset);
+	}
+}
+
+static void pmmu_binning_config_dbg(struct jgs_engine_binning_drv_data *data)
+{
+	uint32_t offset, index;
+	uint32_t limit = ARRAY_SIZE(dbg_pmmu_offset);
+
+	for (index = 0; index < limit; index++) {
+		offset = dbg_pmmu_offset[index];
+		CFG_WREG32(mmIO_0_CFG_HALF_0_SOC_0_NOCP_NOC_ADDR_DEC_DBG_BASE +
+					offset, PMMU_DISABLE_VAL);
+		LOG_DBG("%s: offset = 0x%x", __func__, offset);
+	}
+}
+
+/*
+ * Assumptions:
+ * PMMU is only used in IO Die 0 standalone Mode.
+ * In GPU product it is not used.
+ */
+void jgs_io_die_run_binning_pmmu(struct jgs_engine_binning_drv_data *data)
+{
+	if (data->redundant_pmmu == GPU_PMMU_IN_USE) {
+		LOG_DBG("PMMU is only used in IO Die 0 standalone Mode, skipping binning");
+		return;
+	}
+
+	pmmu_binning_config_lbw(data);
+	pmmu_binning_config_dbg(data);
+}
