-/*
- * Assumptions:
- * 1. For each half die, up to one of the decoders can be binned out
- * 2. Binning is performed per half die: a faulty decoder is replaced by a
- * spare decoder on the same half die.
- */
-void fs1_io_die_run_binning_decoder(struct fs1_engine_binning_drv_data *data)
-{
-	unsigned int i;
-	uint32_t x_src, y_src, x_dst, y_dst;
-	uint32_t io_die_id = (data->die_id - FS1_IO_DIE_0) / FS1_NUM_HALF_DIES;
-	uint32_t lbw_reg_val, dbg_reg_val;
-	int32_t lbw_remap_reg_idx;
-
-	for (i = 0; i < FS1_NUM_HALF_DIES; i++) {
-		LOG_DBG("%s: redundant_dec = %d", __func__, data->redundant_dec[i]);
-		/* If there is no faulty decoder or 8th decoder is redundant,
-		 * skip decoder binning
-		 */
-		if ((data->redundant_dec[i] == FS1_NO_FAULTY_VDEC) ||
-			(data->redundant_dec[i] == FS1_FAULTY_VDEC_8))
-			continue;
-
-		LOG_INF("%s IO Die[%u]: redundant = %u", __func__, io_die_id,
-				data->redundant_dec[i]);
-		x_src = decoder_mesh_coordinate[data->redundant_dec[i] +
-					(i * FS1_NUM_VDEC_PER_HALF_DIE) +
-					(io_die_id * FS1_NUM_VDEC_PER_DIE)][0];
-		y_src = decoder_mesh_coordinate[data->redundant_dec[i] +
-					(i * FS1_NUM_VDEC_PER_HALF_DIE) +
-					(io_die_id * FS1_NUM_VDEC_PER_DIE)][1];
-
-		x_dst = decoder_mesh_coordinate[FS1_FAULTY_VDEC_8 +
-					(i * FS1_NUM_VDEC_PER_HALF_DIE) +
-					(io_die_id * FS1_NUM_VDEC_PER_DIE)][0];
-		y_dst = decoder_mesh_coordinate[FS1_FAULTY_VDEC_8 +
-					(i * FS1_NUM_VDEC_PER_HALF_DIE) +
-					(io_die_id * FS1_NUM_VDEC_PER_DIE)][1];
-
-
-		LOG_DBG("%s x_src = %u, y_src = %u, x_dst = %u, y_dst = %u", __func__,
-				x_src, y_src, x_dst, y_dst);
-
-		/* RTR_CTRL_LBW_CFG ➔ RTR_ADDR_DEC_LBW ➔ LBW_XY_REMAP */
-		lbw_reg_val = LBW_REG_VAL(x_src, y_src, x_dst, y_dst);
-
-		/* IO_NOCP ➔ NOC_ADDR_DEC_DBG ➔ DBG_XY_REMAP */
-		dbg_reg_val = DBG_REG_VAL(x_src, y_src, x_dst, y_dst);
-
-		/* TODO: Check for number of entries, 0.5 PRM 20 entries, spec there
-		 * are 40 remap registers.
-		 */
-		lbw_remap_reg_idx = fs1_io_get_free_remap_reg_index(data);
-		if (lbw_remap_reg_idx < 0) {
-			LOG_ERR("lbw_xy_remap register not available, decoder binning failed");
-			break;
-		}
-
-		vdec_binning_config_lbw(lbw_reg_val, data->die_id,
-				lbw_remap_reg_idx);
-		vdec_binning_config_dbg(dbg_reg_val, data->die_id,
-				lbw_remap_reg_idx);
-	}
-}
