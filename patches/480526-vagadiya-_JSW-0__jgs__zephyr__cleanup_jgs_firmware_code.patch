new file mode 100644
index 0000000..692c80d
--- /dev/null
+++ b/drivers/misc/gpu_isolation_binning/fs1/engine_binning.h
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2024 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#ifndef _FS1_ENGINE_BINNING_H_
+#define _FS1_ENGINE_BINNING_H_
+
+#include <fs1_fw_if.h>
+#include <fs1_binning_defs.h>
+
+#define FS1_ENGINE_BINNING_DRV_DATA(dev) \
+	((struct fs1_engine_binning_drv_data *)(dev)->data)
+
+#define RTR_REGION_ENABLE		1
+
+#define LBW_REG_VAL(x_src, y_src, x_dst, y_dst) \
+		((RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_X_SRC_M & \
+			(x_src << RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_X_SRC_S)) | \
+		(RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_Y_SRC_M & \
+			(y_src << RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_Y_SRC_S)) | \
+		(RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_X_DST_M & \
+			(x_dst << RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_X_DST_S)) | \
+		(RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_Y_DST_M & \
+			(y_dst << RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_Y_DST_S)) | \
+		(RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_EN_M & \
+		(RTR_REGION_ENABLE << RTR_ADDR_DEC_LBW_LBW_XY_REMAP_0_EN_S)))
+
+#define DBG_REG_VAL(x_src, y_src, x_dst, y_dst) \
+		((RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_X_SRC_M & \
+			(x_src << RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_X_SRC_S)) | \
+		(RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_Y_SRC_M & \
+			(y_src << RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_Y_SRC_S)) | \
+		(RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_X_DST_M & \
+			(x_dst << RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_X_DST_S)) | \
+		(RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_Y_DST_M & \
+			(y_dst << RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_Y_DST_S)) | \
+		(RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_EN_M & \
+		(RTR_REGION_ENABLE << RTR_ADDR_DEC_DBG_DBG_XY_REMAP_0_EN_S)))
+
+struct fs1_engine_binning_drv_data {
+	bool binning_data_available;
+	enum fs1_die_id die_id;
+	int redundant_dec[FS1_NUM_HALF_DIES];
+	int redundant_nic;
+	int redundant_pmmu;
+	uint32_t fs1_free_remap_reg_idx;
+	void *redundancy_ctx;
+};
+
+int fs1_io_get_free_remap_reg_index(struct fs1_engine_binning_drv_data *data);
+
+void fs1_io_die_run_binning_decoder(struct fs1_engine_binning_drv_data *data);
+void fs1_io_die_run_binning_nic(struct fs1_engine_binning_drv_data *data);
+void fs1_io_die_run_binning_pmmu(struct fs1_engine_binning_drv_data *data);
+
+int fs1_io_run_engine_binning(struct fs1_engine_binning_drv_data *data);
+int fs1_io_init_dev_redundancy_data(struct fs1_engine_binning_drv_data *data);
+
+int fs1_compute_run_engine_binning(struct fs1_engine_binning_drv_data *data);
+int fs1_compute_init_dev_redundancy_data(struct fs1_engine_binning_drv_data *data);
+
+#endif /* _FS1_ENGINE_BINNING_H_ */
