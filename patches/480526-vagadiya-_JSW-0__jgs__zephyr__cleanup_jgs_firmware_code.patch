-static uint32_t set_edma_iso_mask(uint8_t enable_mask, unsigned int die)
-{
-	uint32_t iso_mask, edma_iso_mask;
-	unsigned int faulty_idx;
-
-	/*
-	 * for edma:0-edma:4 in all compute die - isolated as default
-	 * Assumption: only 2 edma per die can be faulty (isolated).
-	 */
-	edma_iso_mask = H15A_PSOC_RESET_CONF_EDMA_ISO_EN_M;
