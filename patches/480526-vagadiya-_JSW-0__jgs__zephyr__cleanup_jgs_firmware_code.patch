-
-	LOG_DBG("%s: enable mask: dec 0x%x, 0x%x; nic 0x%x; pmmu 0x%x;", __func__,
-			data->dec_enable_mask[0], data->dec_enable_mask[1],
-			data->nic_enable_mask,
