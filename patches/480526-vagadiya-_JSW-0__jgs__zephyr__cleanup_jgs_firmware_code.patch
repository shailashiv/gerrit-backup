-#ifdef CONFIG_IPM_INTEL_FS_RX_MBX
-int ipm_fs_irq_init(const struct device *dev)
-{
-	const struct ipm_fs_config *config = DEV_CFG(dev);
-	struct ipm_fs_data *const data = DEV_DATA(dev);
-	uint32_t val = sys_read32((mem_addr_t) config->intr_mask);
-
-	data->shared_irq_dev = DEVICE_DT_GET(DT_NODELABEL(sw_malibox_irq));
-	if (!data->shared_irq_dev) {
-		LOG_ERR("Failed to get sw_malibox_irq device binding");
-		return -ENODEV;
-	}
-
-	/* Register for interrupt */
-	shared_irq_isr_register(data->shared_irq_dev, (isr_t)ipm_fs_isr, dev);
-	/* Unmask the psoc interrupt */
-	val &= ~BIT(config->mask_idx);
-	sys_write32(val, config->intr_mask);
-	/* Enable the psoc interrupt */
-	shared_irq_enable(data->shared_irq_dev, dev);
-
-	return 0;
-}
-#endif
-
-int ipm_fs_set_enabled(const struct device *dev, int enable)
-{
-	const struct ipm_fs_config *config = DEV_CFG(dev);
-	struct ipm_fs_mbx_regs *reg_base = (struct ipm_fs_mbx_regs *)(config->cfg_base);
-
-	fs_ipm_write32((enable) ? 0x1 : 0x0, (mem_addr_t) &reg_base->en[config->mbx_idx]);
-	return 0;
-}
-
-int ipm_fs_clear(const struct device *dev, uint32_t id)
-{
-	return 0;
-}
-
-void ipm_fs_tx_init(const struct device *dev)
-{
-	const struct ipm_fs_config *config = DEV_CFG(dev);
-	struct ipm_fs_mbx_regs *reg_base = (struct ipm_fs_mbx_regs *)(config->cfg_base);
-
-	/*
-	 * TX will fill all the buffer content lo/hi addr and size
-	 * and then set enable interrupt in ipm_fs_set_enabled function.
-	 */
-	fs_ipm_write32(config->data_base, (mem_addr_t) &reg_base->base_addr_lsb[config->mbx_idx]);
-	fs_ipm_write32(0x0, (mem_addr_t) &reg_base->base_addr_msb[config->mbx_idx]);
-	fs_ipm_write32(config->data_size, (mem_addr_t) &reg_base->q_size[config->mbx_idx]);
-	fs_ipm_write32(0x0, (mem_addr_t) &reg_base->pi[config->mbx_idx]);
-	fs_ipm_write32(0x0, (mem_addr_t) &reg_base->ci[config->mbx_idx]);
-
-	CFG_HBW_ADDR_MNPL(0);
-	/* Clear mailbox buffer */
-	memset((void *)config->data_base, 0x0, config->data_size);
-	CFG_HBW_ADDR_MNPL(1);
-
-	/* init mbx buffer data */
-	ipm_fs_init_mbx_data(dev);
-}
-
-int ipm_fs_init(const struct device *dev)
-{
-	const struct ipm_fs_config *config = DEV_CFG(dev);
-
-	LOG_INF("IPM FS mbx comms %s dev %p enumeration start",
-		(config->mbx_type == MBX_TX_ONLY) ? "TX" : "RX", dev);
-
-	if (config->init) {
-		config->init(dev);
-	}
-
-	if (config->irq_config_func)
-		config->irq_config_func(dev);
-
-	LOG_INF("IPM FS mbx comms %s dev %p enumeration end",
-		(config->mbx_type == MBX_TX_ONLY) ? "TX" : "RX", dev);
-
-	return 0;
-}
