+
+#ifndef ZEPHYR_DRIVERS_HBM_COMMON_H_
+#define ZEPHYR_DRIVERS_HBM_COMMON_H_
+
+#include <rma_if.h>
+#include <stdint.h>
+#include <zephyr/types.h>
+
+#define NUM_OF_HBM_PER_COMPUTE_DIE					(0x3)
+
+#define COMPUTE_D0_HBM0_CENTRAL_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_CENTRAL_BASE + (HL_REG))
+#define COMPUTE_D0_HBM0_BCAST_MC_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_BCAST_MC_BASE + (HL_REG))
+#define COMPUTE_D0_HBM0_PHY_P0_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_PHY_P0_MASTER_BASE + (HL_REG))
+#define COMPUTE_D0_HBM0_PHY_P0_CH_BCAST_AW_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_PHY_P0_CH_BCAST_AW_BASE + (HL_REG))
+#define COMPUTE_D0_HBM0_PHY_P0_INITENG_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_PHY_P0_INITENG_BASE + (HL_REG))
+#define COMPUTE_D0_HBM0_PHY_P0_CH0_DW0_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_P0_CH0_DW0_BASE + (HL_REG))
+#define COMPUTE_D0_HBM0_PHY_P0_CH0_AW_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_CH0_AW_BASE + (HL_REG))
+#define COMPUTE_D0_HBM0_MC0_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_MC0_BASE + (HL_REG))
+#define COMPUTE_D0_HBM0_MC0BIST0_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_MC0BIST0_BASE + (HL_REG))
+#define COMPUTE_D0_HBM0_GECOE01_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_GECOE01_BASE + (HL_REG))
+#define COMPUTE_D0_HBM0_CMN01_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_CMN01_BASE + (HL_REG))
+#define COMPUTE_D0_HBM0_CMN01_INTR_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_CMN01_INTR_BASE + (HL_REG))
+#define COMPUTE_D0_HBM0_BCAST_MCBIST_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_BCAST_MCBIST_BASE + (HL_REG))
+#define COMPUTE_D0_HBM0_BCAST_GECOE_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_BCAST_GECOE_BASE + (HL_REG))
+#define COMPUTE_D0_HBM0_BCAST_CMN_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_BCAST_CMN_BASE + (HL_REG))
+#define COMPUTE_D0_HBM0_BCAST_CMN_INTR_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_BCAST_CMN_INTR_BASE + (HL_REG))
+#define COMPUTE_D0_HBM0_PHY_P0_CH0_DW_BCAST_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_PHY_P0_CH0_DW_BCAST_BASE + (HL_REG))
+#define COMPUTE_D0_HBM0_PHY_P0_CH_BCAST_DW0_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_PHY_P0_CH_BCAST_DW0_BASE + (HL_REG))
+#define COMPUTE_D0_HBM0_PHY_P0_CH_BCAST_DW_BCAST_REG(HL_REG)  \
+				(mmCOMPUTE_0_CFG_HBM_HBM_0_PHY_P0_CH_BCAST_DW_BCAST_BASE + (HL_REG))
+
+enum hbm_status {
+	STATUS_PASS,
+	STATUS_FAIL,
+	STATUS_SKIP,
+};
+
+struct gpu_hbm_drv_config {
+	uint32_t *mc_base;
+	uint32_t *phy_base;
+};
+
+struct gpu_hbm_mc_drv_data {
+	int32_t rsvd;
