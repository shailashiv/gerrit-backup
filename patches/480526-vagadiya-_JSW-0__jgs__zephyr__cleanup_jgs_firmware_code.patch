diff --git a/drivers/interrupt_controller/intc_gpu.c b/drivers/interrupt_controller/intc_gpu.c
new file mode 100644
index 0000000..4a94fe4
--- /dev/null
+++ b/drivers/interrupt_controller/intc_gpu.c
@@ -0,0 +1,418 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+/*
+ * Copyright 2025 Intel
+ * All Rights Reserved.
+ */
+
+#define DT_DRV_COMPAT intel_gpu_ictl
+
+#include <stdio.h>
+#include <zephyr/device.h>
+#include <string.h>
+#include <zephyr/kernel.h>
+#include <zephyr/init.h>
+#include <zephyr/irq.h>
+#include <zephyr/irq_nextlevel.h>
+#include <zephyr/sw_isr_table.h>
+#include <soc/intel/gpu/jgs/soc.h>
+#include "intc_gpu.h"
+
+/*
+ * isr offset needs to be global since it needs to be updated based on offset of
+ * earlier enumerated intr.
+ */
+static uint32_t offset;
+#include <zephyr/logging/log.h>
+LOG_MODULE_REGISTER(intel_gpu_ictl);
+
+#define DEV_INTR_W2M_INT_CFG_REG_STRUCT(dev)						\
+({											\
+	uint32_t addr = (uint32_t) DEV_CFG(dev)->w2m_int_cfg;				\
+	((struct gpu_intr_w2m_int_cfg_regs *)(addr | DEV_DATA(dev)->w2m_addr_mask));	\
+})
+
+#define DEV_INTR_W2M_MSG_REG_STRUCT(dev)						\
+({											\
+	uint32_t addr = (uint32_t) DEV_CFG(dev)->w2m_base;				\
+	((struct gpu_intr_w2m_msg_cfg_regs *)(addr | DEV_DATA(dev)->w2m_addr_mask));	\
+})
+
+#define DEV_M2W8_REG_STRUCT(dev) \
+	((struct gpu_m2w8_regs *)(DEV_CFG(dev))->m2w_base)
+
+#define INTC_RREG32(reg)			CFG_RREG32((reg))
+#define INTC_WREG32(reg, val)		CFG_WREG32((reg), (val))
+#define INTC_RMWREG32(reg, val, mask)	CFG_RMWREG32((reg), (val), (mask))
+
+enum req_type {
+	W2M_REQ_STATUS_INIT = 0,
+	W2M_REQ_MASK_INIT = 1,
+	W2M_REQ_LOW_ACTIVE_INIT = 2,
+	W2M_REQ_MAP_INIT = 4,
+	W2M_REQ_MASK = 5,
+	W2M_REQ_UNMASK = 6,
+	W2M_REQ_CLEAR = 7
+};
+
+static void gpu_ictl_clr_m2w_intr(mem_addr_t addr, uint32_t mask)
+{
+	INTC_WREG32((mem_addr_t)addr, mask);
+}
+
+static void gpu_ictl_invoke_child_isr(const struct device *dev, uint32_t *status,
+				      mem_addr_t clr_offset)
+{
+	const struct gpu_ictl_config *config = DEV_CFG(dev);
+	uint32_t intr_bitpos, intr_sts_idx;
+	uint32_t i;
+
+	for (i = config->int_cfg_reg_start_idx; i < config->int_cfg_reg_end_idx; i++) {
+		intr_sts_idx = status[i];
+		while (intr_sts_idx) {
+			intr_bitpos = find_lsb_set(intr_sts_idx) - 1;
+			intr_sts_idx &= ~(BIT(intr_bitpos));
+
+			/* TODO: Interrupt Processing */
+			LOG_INF("Reported IRQ Num:%d\n", config->irq_l1_num);
+
+			INTC_WREG32(clr_offset + (i * 4), BIT(intr_bitpos));
+		}
+	}
+}
+
+static void gpu_ictl_mask_m2w_intr(mem_addr_t m2w_addr, mem_addr_t arc_addr,
+				  bool mask, uint32_t m2w_mask, uint32_t arc_mask)
+{
+	INTC_RMWREG32(m2w_addr, mask, m2w_mask);
+	INTC_RMWREG32(arc_addr, mask, arc_mask);
+}
+
+static void gpu_ictl_w2m_map_config(const struct device *dev, uint32_t map[])
+{
+	const struct gpu_ictl_config *config = DEV_CFG(dev);
+	uint32_t start = config->int_cfg_reg_start_idx;
+	uint32_t intr_index;
+	uint32_t map_reg_index;
+	uint32_t map_bit_position;
+	uint32_t map_bit_mask;
+
+	for (uint32_t reg = start; reg <= config->int_cfg_reg_end_idx; reg++) {
+		uint32_t mask = config->bit_map[reg - start];
+
+		for (uint32_t bit = 0; bit < GPU_ICTL_W2M_INTR_BITS_PER_REG; bit++) {
+			if (mask & (1 << bit)) {
+				/* Calculate the interrupt index */
+				intr_index = reg * GPU_ICTL_W2M_INTR_BITS_PER_REG + bit;
+
+				/* Calculate which map register and position to configure */
+				map_reg_index = intr_index / MAX_INT_PER_MAP_REG;
+				map_bit_position = (intr_index % MAX_INT_PER_MAP_REG) *
+					W2M_MAP_BITS_PER_INTR;
+				map_bit_mask = (W2M_MAP_MASK_PER_INTR << map_bit_position);
+
+				/* Set the message ID in the respective field of the map */
+				INTC_RMWREG32((mem_addr_t) &map[map_reg_index],
+					       config->msg_id, map_bit_mask);
+			}
+		}
+	}
+}
+
+static void gpu_ictl_w2m_int_cfg(const struct device *dev, uint32_t w2m_idx, enum req_type req)
+{
+	uint32_t *int_cfg_reg = NULL;
+	struct gpu_intr_w2m_int_cfg_regs *w2m_regs = DEV_INTR_W2M_INT_CFG_REG_STRUCT(dev);
+	const struct gpu_ictl_config *config = DEV_CFG(dev);
+	int i = 0;
+	uint8_t val = 0x0;
+	uint32_t bitpos, offset;
+
+	uint8_t idx = config->int_cfg_reg_start_idx;
+
+	switch (req) {
+	case W2M_REQ_MAP_INIT:
+		gpu_ictl_w2m_map_config(dev,  &w2m_regs->map[0]);
+		return;
+	case W2M_REQ_CLEAR:
+		int_cfg_reg = &w2m_regs->status[0];
+		__fallthrough;
+	case W2M_REQ_MASK:
+		val = 0x1;
+		__fallthrough;
+	case W2M_REQ_UNMASK:
+		if (!int_cfg_reg)
+			int_cfg_reg = &w2m_regs->mask[0];
+		offset = w2m_idx / GPU_ICTL_W2M_INTR_BITS_PER_REG;
+		bitpos = w2m_idx % GPU_ICTL_W2M_INTR_BITS_PER_REG;
+		INTC_RMWREG32(((mem_addr_t) int_cfg_reg + (offset * 4)), val, BIT(bitpos));
+		return;
+	case W2M_REQ_STATUS_INIT:
+		int_cfg_reg = &w2m_regs->status[0]; /* W1C */
+		break;
+	case W2M_REQ_MASK_INIT:
+		int_cfg_reg = &w2m_regs->mask[0];
+		break;
+	case W2M_REQ_LOW_ACTIVE_INIT:
+		int_cfg_reg = &w2m_regs->low_active[0];
+		break;
+	default:
+		return;
+	}
+
+	while (idx < config->int_cfg_reg_end_idx) {
+		INTC_WREG32((mem_addr_t)&int_cfg_reg[idx++], config->bit_map[i++]);
+	}
+}
+
+static void gpu_ictl_process_irq(const struct device *dev, enum gpu_ictl_req req_type,
+				       uint32_t w2m_idx)
+{
+	const struct gpu_ictl_config *config = DEV_CFG(dev);
+	struct gpu_ictl_drv_data *data = DEV_DATA(dev);
+	struct gpu_intr_w2m_msg_cfg_regs *w2m_msg_regs = DEV_INTR_W2M_MSG_REG_STRUCT(dev);
+	struct gpu_intr_w2m_int_cfg_regs *w2m_regs = DEV_INTR_W2M_INT_CFG_REG_STRUCT(dev);
+	struct gpu_m2w8_regs *m2w8_regs = DEV_M2W8_REG_STRUCT(dev);
+	/* TODO: Optimise below to use for only relevant size */
+	uint32_t intr_status[GPU_ICTL_NUM_INTR_CFG_REG];
+	mem_addr_t msg_addr_off, msg_data_off;
+	mem_addr_t msg_cfg_off, msg_pending_off;
+	mem_addr_t mask_base_off, status_base_off;
+	uint32_t intr_bitpos, intr_offset;
+	bool w2m_msg_en = false;
+	uint32_t i;
+	uint32_t msg_data  = config->msg_data - GPU_ICTL_NUM_SW_INTR;
+
+	/* Configuration from w2m_int_cfg block */
+	mask_base_off = (mem_addr_t) &w2m_regs->mask[0];
+	status_base_off = (mem_addr_t) &w2m_regs->status[0];
+
+	/* Configuration from w2m_msg block */
+	msg_cfg_off = (mem_addr_t) &w2m_msg_regs->msg_cfg;
+	msg_pending_off = (mem_addr_t) &w2m_msg_regs->msg_pending;
+	msg_addr_off = (mem_addr_t) &w2m_msg_regs->msg_addr;
+	msg_data_off = (mem_addr_t) &w2m_msg_regs->msg_data;
+
+	switch (req_type) {
+	case GPU_ICTL_REQ_INIT:
+		/* Get bit position within m2w sts and mask registers */
+		data->m2w_bitpos = (msg_data % GPU_ICTL_INTR_BITS_PER_M2W_REG);
+		/* Set msg address and data in w2m */
+		INTC_WREG32((mem_addr_t) &w2m_msg_regs->msg_addr, config->msg_addr);
+		INTC_WREG32((mem_addr_t) &w2m_msg_regs->msg_data, config->msg_data);
+
+		/* Mask interrupts at init before configuring map */
+		gpu_ictl_w2m_int_cfg(dev, 0, W2M_REQ_MASK_INIT);
+
+		/* Configuring map */
+		gpu_ictl_w2m_int_cfg(dev, 0, W2M_REQ_MAP_INIT);
+
+	break;
+	case GPU_ICTL_REQ_ENABLE:
+		intr_offset = w2m_idx / GPU_ICTL_W2M_INTR_BITS_PER_REG;
+		intr_bitpos = w2m_idx % GPU_ICTL_W2M_INTR_BITS_PER_REG;
+		w2m_msg_en = (INTC_RREG32(msg_cfg_off) & BIT(0));
+
+		if (!w2m_msg_en) {
+			/* Clear any pending intgerrupt at w2m before enabling w2m block */
+			gpu_ictl_w2m_int_cfg(dev, 0, W2M_REQ_STATUS_INIT);
+
+			INTC_RMWREG32(msg_pending_off, 0x1, BIT(0));
+
+			/* Enable msg in w2m */
+			INTC_RMWREG32(msg_cfg_off, 0x1, BIT(0));
+		}
+		/* TODO: Unmask based on num_of_irqs */
+
+		/* Unmask interrupt at w2m */
+		INTC_RMWREG32((mem_addr_t) &w2m_regs->mask[intr_offset], 0x0, BIT(intr_bitpos));
+
+		/* Unmask interrupt at m2w */
+		gpu_ictl_mask_m2w_intr((mem_addr_t) (&m2w8_regs->mask),
+				(mem_addr_t) (&m2w8_regs->arc0_mask +
+				(config->core_id * (sizeof(m2w8_regs->arc0_mask) >> 3))),
+				0x0, BIT(data->m2w_bitpos), BIT(data->m2w_bitpos));
+
+	break;
+	case GPU_ICTL_REQ_DISABLE:
+		intr_offset = w2m_idx / GPU_ICTL_W2M_INTR_BITS_PER_REG;
+		intr_bitpos = w2m_idx % GPU_ICTL_W2M_INTR_BITS_PER_REG;
+		/* TODO: Mask based on num_of_irqs */
+
+		/* Mask interrupt at w2m */
+		INTC_RMWREG32((mem_addr_t) &w2m_regs->mask[intr_offset], 0x1, BIT(intr_bitpos));
+
+		/* Disable msg in w2m */
+		INTC_RMWREG32(msg_cfg_off, 0x0, BIT(0));
+
+		/* Mask at m2w and arc */
+		gpu_ictl_mask_m2w_intr((mem_addr_t)
+				(&m2w8_regs->mask),
+				(mem_addr_t) (&m2w8_regs->arc0_mask +
+				(config->core_id * (sizeof(m2w8_regs->arc0_mask) >> 3))),
+				0x1, BIT(data->m2w_bitpos), BIT(data->m2w_bitpos));
+	break;
+	case GPU_ICTL_REQ_ISR:
+		/* Read relevant interrupt status and process interrupts */
+		for (i = config->int_cfg_reg_start_idx; i < config->int_cfg_reg_end_idx; i++) {
+			intr_status[i] = INTC_RREG32((mem_addr_t) &w2m_regs->status[i]);
+		}
+
+		gpu_ictl_invoke_child_isr(dev, &intr_status[0],
+					 (mem_addr_t) &w2m_regs->status);
+
+		/* Clear interrupt at msg2wire */
+		gpu_ictl_clr_m2w_intr((mem_addr_t) (&m2w8_regs->intr),
+				     BIT(data->m2w_bitpos));
+
+		/* Clear msg pending at aggregator */
+		INTC_WREG32((mem_addr_t) &w2m_msg_regs->msg_pending, BIT(0));
+	break;
+	case GPU_ICTL_REQ_MASK:
+		/* Mask Interrupts */
+		gpu_ictl_w2m_int_cfg(dev, w2m_idx, W2M_REQ_MASK);
+	break;
+	case GPU_ICTL_REQ_UNMASK:
+		/* Unmask Interrupts */
+		gpu_ictl_w2m_int_cfg(dev, w2m_idx, W2M_REQ_UNMASK);
+	break;
+	case GPU_ICTL_REQ_CLEAR:
+		/* Clear Interrupts */
+		gpu_ictl_w2m_int_cfg(dev, w2m_idx, W2M_REQ_CLEAR);
+	break;
+	default:
+		return;
+	}
+}
+
+static uint32_t gpu_ictl_get_w2m_idx(const struct device *dev, uint32_t irq_l2)
+{
+	const struct gpu_ictl_config *config = DEV_CFG(dev);
+	uint32_t w2m_offset = config->int_cfg_reg_start_idx * GPU_ICTL_W2M_INTR_BITS_PER_REG;
+
+	return (w2m_offset + irq_l2);
+}
+
+static void gpu_ictl_irq_ops(const struct device *dev, enum gpu_ictl_req req_type,
+				uint32_t irq_l2)
+{
+	uint32_t irq_w2m_idx = gpu_ictl_get_w2m_idx(dev, irq_l2);
+
+	gpu_ictl_process_irq(dev, req_type, irq_w2m_idx);
+}
+
+static void gpu_ictl_isr(const struct device *dev)
+{
+	gpu_ictl_irq_ops(dev, GPU_ICTL_REQ_ISR, 0);
+}
+
+/*
+ * <irq_nextlevel.h> API
+ */
+
+static void gpu_ictl_irq_enable(const struct device *dev, uint32_t irq_l2)
+{
+	gpu_ictl_irq_ops(dev, GPU_ICTL_REQ_ENABLE, irq_l2);
+}
+
+static void gpu_ictl_irq_disable(const struct device *dev, uint32_t irq_l2)
+{
+	gpu_ictl_irq_ops(dev, GPU_ICTL_REQ_DISABLE, irq_l2);
+}
+
+static uint32_t gpu_ictl_get_state(const struct device *dev)
+{
+	ARG_UNUSED(dev);
+	return 0;
+}
+
+static int gpu_ictl_get_line_state(const struct device *dev,
+					unsigned int irq_l2)
+{
+	ARG_UNUSED(dev);
+	ARG_UNUSED(irq_l2);
+	return 0;
+}
+
+static void gpu_ictl_irq_mask(const struct device *dev, uint32_t irq_l2)
+{
+	gpu_ictl_irq_ops(dev, GPU_ICTL_REQ_MASK, irq_l2);
+}
+
+static void gpu_ictl_irq_unmask(const struct device *dev, uint32_t irq_l2)
+{
+	gpu_ictl_irq_ops(dev, GPU_ICTL_REQ_UNMASK, irq_l2);
+}
+
+static void gpu_ictl_irq_late_init(const struct device *dev, uint32_t irq_l2)
+{
+	gpu_ictl_irq_ops(dev, GPU_ICTL_REQ_INIT, irq_l2);
+}
+
+static void gpu_ictl_irq_clear(const struct device *dev, uint32_t irq_l2)
+{
+	gpu_ictl_irq_ops(dev, GPU_ICTL_REQ_CLEAR, irq_l2);
+}
+
+static const struct irq_next_level_api gpu_ictl_apis = {
+	.intr_enable = gpu_ictl_irq_enable,
+	.intr_disable = gpu_ictl_irq_disable,
+	.intr_get_state = gpu_ictl_get_state,
+	.intr_get_line_state = gpu_ictl_get_line_state,
+	.intr_mask = gpu_ictl_irq_mask,
+	.intr_unmask = gpu_ictl_irq_unmask,
+	.intr_late_init = gpu_ictl_irq_late_init,
+	.intr_clear = gpu_ictl_irq_clear,
+};
+
+int gpu_ictl_init(const struct device *dev)
+{
+	struct gpu_ictl_config *config = DEV_CFG(dev);
+
+	config->isr_table_offset = offset + CONFIG_GPU_ICTL_ISR_SW_TBL_OFFSET -
+					CONFIG_GEN_IRQ_START_VECTOR;
+
+	config->core_id = GPU_ARC_V2_CORE_ID();
+
+	offset += config->num_of_irqs;
+
+	gpu_ictl_irq_ops(dev, GPU_ICTL_REQ_INIT, 0);
+
+	return 0;
+}
+
+#define GPU_ICTL_INIT(n)									\
+	static void gpu_config_##n##_irq(const struct device *dev);				\
+												\
+	static const struct gpu_ictl_config gpu_config_##n = {					\
+		.irq_l1_num = DT_INST_IRQN(n),							\
+		.config_func = gpu_config_##n##_irq,						\
+		.w2m_base = (uint32_t *) DT_INST_REG_ADDR(n),					\
+		.m2w_base = (uint32_t *)DT_REG_ADDR(DT_PARENT(DT_DRV_INST(n))),			\
+		.w2m_int_cfg = (uint32_t *)DT_PROP(DT_PARENT(DT_DRV_INST(n)), w2m_int_cfg),	\
+		.msg_addr = DT_PROP(DT_PARENT(DT_DRV_INST(n)), msg_addr),			\
+		.msg_data = DT_INST_PROP(n, msg_data),						\
+		.msg_id = DT_INST_PROP(n, msg_id),						\
+		.num_of_irqs = DT_INST_PROP(n, num_of_irqs),					\
+		.pass_intr_info = DT_INST_PROP(n, intr_info),					\
+		.int_cfg_reg_start_idx = DT_INST_PROP(n, int_cfg_reg_start_idx),		\
+		.int_cfg_reg_end_idx = DT_INST_PROP(n, int_cfg_reg_end_idx),			\
+		.bit_map = DT_INST_PROP(n, bit_map),						\
+	};											\
+												\
+	static struct gpu_ictl_drv_data gpu_ictl_drv_##n##_data;				\
+	DEVICE_DT_INST_DEFINE(n, gpu_ictl_init,							\
+				NULL,								\
+				&gpu_ictl_drv_##n##_data,					\
+				&gpu_config_##n,						\
+				PRE_KERNEL_2,							\
+				CONFIG_KERNEL_INIT_PRIORITY_DEFAULT, &gpu_ictl_apis);		\
+												\
+	static void gpu_config_##n##_irq(const struct device *dev)				\
+	{											\
+		IRQ_CONNECT(DT_INST_IRQN(n), DT_INST_IRQ(n, priority),				\
+			    gpu_ictl_isr, DEVICE_DT_INST_GET(n),				\
+			    DT_INST_PROP(n, num_of_irqs));					\
+	}
+
+DT_INST_FOREACH_STATUS_OKAY(GPU_ICTL_INIT)
