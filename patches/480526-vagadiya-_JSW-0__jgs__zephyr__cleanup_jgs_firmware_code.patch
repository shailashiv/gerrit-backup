-			    fs_ictl_isr, DEVICE_DT_INST_GET(n),					\
-			    DT_INST_PROP(n, num_of_irqs));					\
-	}
-
-DT_INST_FOREACH_STATUS_OKAY(FS_ICTL_INIT)
