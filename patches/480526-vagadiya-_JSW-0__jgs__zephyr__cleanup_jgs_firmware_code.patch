-		if (compute_die_redundancy_ctx->redundant_xecore >= 0)
-			data->xecore_enable_mask &=
-					~(BIT(compute_die_redundancy_ctx->redundant_xecore));
-
-	} else {
-		struct fs1_redundancy_ctx_io *io_die_redundancy_ctx =
-			(struct fs1_redundancy_ctx_io *) isolation_info->redundancy_ctx;
-
-		if (!io_die_redundancy_ctx->initialized) {
-			LOG_ERR("io die redundancy_ctx is not initialized, nothing to inject");
-			return -ENODEV;
-		}
-
-		/* Decoders - half die 0 */
-		data->dec_enable_mask[0] = DEC_ENABLE_MASK;
-		if (io_die_redundancy_ctx->redundant_dec[0] >= 0)
-			data->dec_enable_mask[0] &= ~(BIT(io_die_redundancy_ctx->redundant_dec[0]));
-
-		/* Decoders - half die 1 */
-		data->dec_enable_mask[1] = DEC_ENABLE_MASK;
-		if (io_die_redundancy_ctx->redundant_dec[1] >= 0)
