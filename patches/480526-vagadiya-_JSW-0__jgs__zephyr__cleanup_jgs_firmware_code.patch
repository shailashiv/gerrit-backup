@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2024 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+
+/**
+ * @file drivers/hbm/common/gpu_hbm.h
+ *
+ * @brief Public APIs for the Intel hbm driver.
+ */
+
+#ifndef ZEPHYR_INCLUDE_DRIVERS_GPU_HBM_H_
+#define ZEPHYR_INCLUDE_DRIVERS_GPU_HBM_H_
+
+#include <zephyr/types.h>
+#include <zephyr/device.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @typedef hbm_drv_run_hbm_init_t
+ * @brief Callback API for running hbm_drv_run_hbm_init
+ */
+typedef int (*hbm_drv_run_hbm_init_t)(const struct device *dev);
+
+__subsystem struct gpu_hbm_driver_api {
+	hbm_drv_run_hbm_init_t hbm_drv_run_hbm_init;
+};
+
+__syscall int gpu_hbm_drv_run_hbm_init(const struct device *dev);
+
+static inline int z_impl_gpu_hbm_drv_run_hbm_init(const struct device *dev)
+{
+	const struct gpu_hbm_driver_api *api =
+		(const struct gpu_hbm_driver_api *)dev->api;
+
+	if (api->hbm_drv_run_hbm_init == NULL)
+		return -ENOTSUP;
+
+	return api->hbm_drv_run_hbm_init(dev);
+}
+
+
+#ifdef __cplusplus
+} /* extern "C" */
+#endif
+
+#include <syscalls/gpu_hbm.h>
+
+#endif /* ZEPHYR_INCLUDE_DRIVERS_GPU_HBM_H_ */
