-int fs1_isolation_set(const struct device *dev, enum fs1_iso_module module)
-{
-	struct fs1_isolation_drv_data *data = FS1_ISOLATION_DRV_DATA(dev);
-
-	if (!data->initialized) {
-		LOG_ERR("driver data isn't initialized, skipping isolation\n");
-		return -EINVAL;
-	}
-
-	if (data->die_id <= FS1_COMPUTE_DIE_3) {
-		/* Compute Die Engines */
-		switch (module) {
-
-		case FS1_ISO_COMPUTE_MODULE_EDMA:
-			fs1_set_edma_isolation(data->edma_enable_mask, data->die_id);
-			break;
-		case FS1_ISO_COMPUTE_MODULE_PDMA:
-			fs1_set_pdma_isolation(data->pdma_enable_mask, data->die_id);
-			break;
-		case FS1_ISO_COMPUTE_MODULE_XECORE:
-			fs1_set_xecore_isolation(data->xecore_enable_mask, data->die_id);
-			break;
-		case FS1_ISO_MODULE_DUAL_PLANE:
-			fs1_set_dual_plane_isolation(data->dual_plane_enable_mask, data->die_id);
-			break;
-		default:
-			return -EINVAL;
-		}
-	} else {
-		/* IO Die Engines */
-		switch (module) {
-
-		case FS1_ISO_IO_MODULE_DEC:
-			fs1_set_dec_isolation(&data->dec_enable_mask[0], data->die_id);
-			break;
-		case FS1_ISO_IO_MODULE_NIC:
-			fs1_set_nic_isolation(data->nic_enable_mask, data->die_id);
-			break;
-		case FS1_ISO_IO_MODULE_PMMU:
-			fs1_set_pmmu_isolation(data->pmmu_enable_mask);
-			break;
-		default:
-			return -EINVAL;
-		}
-	}
-
-	return 0;
-
-}
