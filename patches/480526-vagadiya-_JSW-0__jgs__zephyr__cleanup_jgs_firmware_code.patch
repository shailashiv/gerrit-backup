+++ b/drivers/interrupt_controller/intc_gpu.h
@@ -0,0 +1,151 @@
+/* SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Copyright (C) 2025 Intel Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#ifndef ZEPHYR_DRIVERS_INTERRUPT_CONTROLLER_INTC_GPU_H_
+#define ZEPHYR_DRIVERS_INTERRUPT_CONTROLLER_INTC_GPU_H_
+
+#include <zephyr/types.h>
+#include <hl_platform_defs.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef void (*gpu_ictl_config_irq_t)(const struct device *dev);
+
+#define GPU_ICTL_NUM_INTR_CFG_REG	18
+#define GPU_ICTL_NUM_INTR_CFG_MASK	18
+#define GPU_ICTL_NUM_INTR_MAP_REG	72
+#define GPU_ICTL_W2M_INTR_BITS_PER_REG	32
+
+#define GPU_ICTL_NUM_REG_INTR64		2
+#define GPU_ICTL_NUM_REG_INTR512		16
+
+#define GPU_ICTL_NUM_REG_MASK64		2
+#define GPU_ICTL_NUM_REG_MASK512		16
+
+#define GPU_ICTL_NUM_REG_SAI32		2
+#define GPU_ICTL_NUM_REG_SAI512		86
+
+#define GPU_ICTL_NUM_ARC_MASK64		2
+
+#define GPU_W2M_MSG_0_BASE_OFFSET	0x2C0
+#define GPU_W2M_MSG_1_BASE_OFFSET	0x2D0
+
+#define W2M_MAX_INT_MSGS		8
+#define MAX_INT_PER_MAP_REG		8
+#define W2M_MAP_MASK_PER_INTR		0x7
+#define W2M_MAP_BITS_PER_INTR		4
+
+#define GPU_W2M_MSG_OFFSET	(GPU_W2M_MSG_1_BASE_OFFSET - GPU_W2M_MSG_0_BASE_OFFSET)
+
+#define GPU_ICTL_INTR_BITS_PER_M2W_REG	8
+#define GPU_ICTL_NUM_SW_INTR		512
+
+enum gpu_ictl_req {
+	GPU_ICTL_REQ_INIT,
+	GPU_ICTL_REQ_ENABLE,
+	GPU_ICTL_REQ_DISABLE,
+	GPU_ICTL_REQ_MASK,
+	GPU_ICTL_REQ_UNMASK,
+	GPU_ICTL_REQ_ISR,
+	GPU_ICTL_REQ_CLEAR,
+	GPU_ICTL_REQ_MAX
+};
+
+struct gpu_intr_w2m_int_cfg_regs {
+	uint32_t status[GPU_ICTL_NUM_INTR_CFG_REG];
+	uint32_t rsvd1[6];
+	uint32_t mask[GPU_ICTL_NUM_INTR_CFG_REG];
+	uint32_t rsvd2[6];
+	uint32_t low_active[GPU_ICTL_NUM_INTR_CFG_REG];
+	uint32_t rsvd3[6];
+	uint32_t map[GPU_ICTL_NUM_INTR_MAP_REG];
+	uint32_t rsvd4[32];
+};
+
+struct  gpu_intr_w2m_msg_cfg_regs {
+	uint32_t msg_cfg;
+	uint32_t msg_pending;
+	uint32_t msg_addr;
+	uint32_t msg_data;
+};
+
+struct gpu_intr_w2m_regs {
+	struct gpu_intr_w2m_int_cfg_regs int_cfg;
+	struct gpu_intr_w2m_msg_cfg_regs msg_cfg[W2M_MAX_INT_MSGS];
+};
+
+struct gpu_m2w8_regs {
+	uint32_t status;
+	uint32_t intr;
+	uint32_t mask;
+	uint32_t pending;
+	uint32_t sai[GPU_ICTL_NUM_REG_SAI32];
+	uint32_t wd_timer;
+	uint32_t early_add_msg_pend_mask;
+	uint32_t arc0_mask; /* PID ARC */
+	uint32_t arc1_mask; /* MGMT ARC */
+	uint32_t arc2_mask; /* MISC ARC */
+	uint32_t arc3_mask; /* RST ARC */
+};
+
+struct gpu_m2w512_regs {
+	uint32_t status[GPU_ICTL_NUM_REG_INTR512];
+	uint32_t rsvd1[8];
+	uint32_t intr[GPU_ICTL_NUM_REG_INTR512];
+	uint32_t rsvd2[32];
+	uint32_t mask[GPU_ICTL_NUM_REG_MASK512];
+	uint32_t rsvd3[8];
+	uint32_t pending[GPU_ICTL_NUM_REG_INTR512];
+	uint32_t rsvd4[8];
+	uint32_t sai[GPU_ICTL_NUM_REG_SAI512];
+	uint32_t rsvd5[20];
+	uint32_t wd_timer;
+	uint32_t early_add_msg_pend_mask;
+	/* TODO: Update ARC mapping for compute die */
+	uint32_t arc0_mask[GPU_ICTL_NUM_ARC_MASK64]; /* PID ARC */
+	uint32_t arc1_mask[GPU_ICTL_NUM_ARC_MASK64]; /* MGMT ARC */
+	uint32_t arc2_mask[GPU_ICTL_NUM_ARC_MASK64]; /* MISC ARC */
+	uint32_t arc3_mask[GPU_ICTL_NUM_ARC_MASK64]; /* RST ARC */
+};
+
+struct gpu_ictl_config {
+	uint16_t irq_l1_num;
+	uint32_t isr_table_offset;
+	gpu_ictl_config_irq_t config_func;
+	uint32_t *w2m_base;
+	uint32_t *m2w_base;
+	uint32_t *w2m_int_cfg;
+	uint32_t msg_addr;
+	uint16_t msg_data;
+	uint32_t msg_id;
+	uint8_t core_id;
+	uint8_t num_of_irqs;
+	bool pass_intr_info;
+	uint8_t int_cfg_reg_start_idx;
+	uint8_t int_cfg_reg_end_idx;
+	const int bit_map[];
+};
+
+struct gpu_ictl_drv_data {
+	uint32_t w2m_addr_mask;
+	uint32_t w2m_mask[GPU_ICTL_NUM_INTR_CFG_REG];
+	uint32_t m2w_bitpos;
+};
+
+#define DEV_CFG(dev) \
+	((struct gpu_ictl_config *)(dev->config))
+
+#define DEV_DATA(dev) \
+	((struct gpu_ictl_drv_data * const)(dev->data))
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ZEPHYR_DRIVERS_INTERRUPT_CONTROLLER_INTC_GPU_H_ */
