+# Copyright (c) 2025, Intel
+# SPDX-License-Identifier: Apache-2.0
+
+description: |
+    This is a representation of the Habanalabs async events
+    communication driver for jgs
+
+compatible: "intel,jgs"
+
+include: base.yaml
+
+properties:
+    sw_intr_index:
+      type: array
+      required: true
+      description: Array having index of the SW INTR where the Host can interrupt ARC
+
+    sw_intr_halt_req:
+      type: array
+      required: true
+      description: Array having index of the SW INTR where host can send halt request
+
+    cfg_reg_base:
+      type: int
+      required: true
+      description: Base address of the intel configuration space registers
+
+    pci_dbi_offset:
+      type: int
+      required: true
+      description: Offset of the Pci dbi block
+
+    power_evt_start:
+      type: array
+      description: Array having index of the power event start SW INTR index where ARCPID
+                   can interrupt ARCMGMT during the start of power event.
+
+    power_evt_end:
+      type: array
+      description: Array having index of the power event end SW INTR index where ARCPID
+                   can interrupt ARCMGMT during the end of power event.
+
+    thermal_evt_start:
+      type: array
+      description: Array having index of the thermal event start SW INTR index where ARCPID
+                   can interrupt ARCMGMT during the start of thermal event.
+
+    thermal_evt_end:
+      type: array
+      description: Array having index of the thermal event end SW INTR index where ARCPID
+                   can interrupt ARCMGMT during the end of thermal event.
+
+    wdt_rst_intr:
+      type: array
+      required: true
+      description: Array having index of the watch dog interrupt.
