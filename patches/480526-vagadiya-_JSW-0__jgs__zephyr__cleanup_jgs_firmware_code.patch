-
-int fs_ictl_init(const struct device *dev)
-{
-	struct fs_ictl_config *config = DEV_CFG(dev);
-
-	config->isr_table_offset = offset + CONFIG_FS_ICTL_ISR_SW_TBL_OFFSET -
