+/**
+ * @file drivers/misc/gpu_isolation_binning/jgs/jgs_binning_api.h
+ *
+ * @brief Public APIs for the Habanalabs jgs_binning driver.
+ */
+
+#ifndef ZEPHYR_INCLUDE_DRIVERS_JGS_BINNING_API_H_
+#define ZEPHYR_INCLUDE_DRIVERS_JGS_BINNING_API_H_
+
+#include <zephyr/types.h>
+#include <zephyr/device.h>
+#include <jgs_binning_defs.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @typedef jgs_binning_run_binning_t
+ * @brief Callback API for running binning
+ *
+ */
+typedef int (*jgs_binning_run_binning_t)(const struct device *dev);
+
+
+/**
+ * @typedef jgs_binning_get_binning_info_t
+ * @brief Callback API for running jgs_binning_get_binning_info
+ *
+ */
+typedef int (*jgs_binning_get_binning_info_t)(const struct device *dev,
+					struct jgs_binning_info *output);
+
+/**
+ * @typedef jgs_binning_inject_binning_info_t
+ * @brief Callback API for running jgs_binning_inject_binning_info
+ *
+ */
+typedef int (*jgs_binning_inject_binning_info_t)(const struct device *dev,
+				const struct jgs_binning_info *binning_info);
+
+__subsystem struct jgs_binning_driver_api {
+	jgs_binning_run_binning_t jgs_binning_run_binning;
+	jgs_binning_get_binning_info_t jgs_binning_get_binning_info;
+	jgs_binning_inject_binning_info_t jgs_binning_inject_binning_info;
+};
+
+__syscall int jgs_binning_drv_run_binning(const struct device *dev);
+
+static inline int z_impl_jgs_binning_drv_run_binning(const struct device *dev)
+{
+	const struct jgs_binning_driver_api *api =
+		(const struct jgs_binning_driver_api *)dev->api;
+
+	if (api == NULL) {
+		return -ENOTSUP;
+	}
+
+	if (api->jgs_binning_run_binning == NULL)
+		return -ENODEV;
+
+	return api->jgs_binning_run_binning(dev);
+}
+
+__syscall int jgs_binning_drv_get_binning_info(const struct device *dev,
+						struct jgs_binning_info *output);
+
+static inline int z_impl_jgs_binning_drv_get_binning_info(
+						const struct device *dev,
+						struct jgs_binning_info *output)
+{
+	const struct jgs_binning_driver_api *api =
+		(const struct jgs_binning_driver_api *)dev->api;
+
+	if (api == NULL) {
+		return -ENOTSUP;
+	}
+
+	if (api->jgs_binning_get_binning_info == NULL)
+		return -ENODEV;
+
+	return api->jgs_binning_get_binning_info(dev, output);
+
+}
+
+__syscall int jgs_binning_drv_inject_binning_info(const struct device *dev,
+					const struct jgs_binning_info *binning_info);
+
+static inline int z_impl_jgs_binning_drv_inject_binning_info(
+					const struct device *dev,
+					const struct jgs_binning_info *binning_info)
