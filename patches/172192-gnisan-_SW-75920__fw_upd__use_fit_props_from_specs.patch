From 94e3540f76bae0c69770dfe4441006fdaeb16c19 Mon Sep 17 00:00:00 2001
From: Guy Nisan <gnisan@habana.ai>
Date: Wed, 26 Jan 2022 14:48:55 +0200
Subject: [PATCH] [SW-75920] fw_upd: use fit props from specs

Use FIT props from specs

Change-Id: I24eb3e6d6773ba341fab1f5a10b38a333f20b609
Signed-off-by: Guy Nisan <gnisan@habana.ai>
---

diff --git a/lib/preboot/module_fwupd.c b/lib/preboot/module_fwupd.c
index 63102a9..2ac3b8f 100644
--- a/lib/preboot/module_fwupd.c
+++ b/lib/preboot/module_fwupd.c
@@ -13,6 +13,7 @@
 #include <preboot.h>
 #include <device.h>
 #include <hl_fw_if.h>
+#include <hl_fit_if.h>
 #include <fit_load_type.h>
 #include <security.h>
 #include <memory.h>
@@ -24,10 +25,6 @@
 
 #define WFC_TIMEOUT_MS			500
 #define TIMEOUT_US			1000
-
-#define HL_FIT_LOAD_TYPE_PROP		"load-type"
-#define HL_FIT_PROTO_STATUS_PROP	"protocol-status"
-#define HL_FIT_SPI_VERSION		"spi-version"
 
 struct fwupd_state {
 	bool sending_error_flag;
@@ -205,12 +202,12 @@
 	int err;
 
 	resp_prop = &resp_props[RESP_PROP_STATUS];
-	resp_prop->name = HL_FIT_PROTO_STATUS_PROP;
+	resp_prop->name = HL_FIT_RES_PROTO_STS_PROP;
 	resp_prop->data = &status;
 	resp_prop->size = sizeof(status);
 
 	resp_prop = &resp_props[RESP_PROP_SPI_VERSION];
-	resp_prop->name = HL_FIT_SPI_VERSION;
+	resp_prop->name = HL_FIT_RES_SPI_VERSION_PROP;
 	resp_prop->data = preboot_get_version(PREBOOT_BTL_VER);
 	resp_prop->size = VERSION_MAX_LEN;
 
