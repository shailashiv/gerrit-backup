From e58a7aa06aca33650c3d7492342c938588a879d0 Mon Sep 17 00:00:00 2001
From: Arnon Kaufman <akaufman@habana.ai>
Date: Mon, 08 Jul 2024 16:44:00 +0300
Subject: [PATCH] [SW-0] convert bin dir

Locating bin files at a separate directory.

Change-Id: Id855205b20a9bae000beb0c93c5c93b177e4aa5b
Signed-off-by: Arnon Kaufman <akaufman@habana.ai>
---

diff --git a/board/habanalabs/common/dirs.sh b/board/habanalabs/common/dirs.sh
index fbd9594..bd9fffe 100644
--- a/board/habanalabs/common/dirs.sh
+++ b/board/habanalabs/common/dirs.sh
@@ -8,10 +8,10 @@
 export STAGE_DIR=${IMGS_DIR}
 export HEXS_DIR=${IMGS_PROD_DIR}/hexs/
 export ITBS_DIR=${IMGS_PROD_DIR}/itbs/
-export BINS_DIR=${IMGS_DIR}
+export BINS_DIR=${IMGS_DIR}/bins/
 export STATS_DIR=${IMGS_DIR}/stats/
 export ELFS_DIR=${IMGS_PROD_DIR}/elfs/
-export BINS_PROD_DIR=${IMGS_PROD_DIR}
+export BINS_PROD_DIR=${IMGS_PROD_DIR}/bins/
 
 # TODO: move the below to FS1 specific make file
 case ${DEV_PREFIX} in
diff --git a/scripts/make/common/hl_dirs.mk b/scripts/make/common/hl_dirs.mk
index ca6085e..4f0648b 100644
--- a/scripts/make/common/hl_dirs.mk
+++ b/scripts/make/common/hl_dirs.mk
@@ -7,7 +7,7 @@
 export IMGS_PROD_DIR=$(DEV_PREFIX_BASE_DIR)/images/
 export STAGE_DIR=$(IMGS_DIR)
 export HEXS_DIR=$(IMGS_PROD_DIR)/hexs/
-export BINS_DIR=$(IMGS_DIR)
+export BINS_DIR=$(IMGS_DIR)/bins/
 export ITBS_DIR=$(IMGS_PROD_DIR)/itbs/
 export ELFS_DIR=$(IMGS_PROD_DIR)/elfs/
 export STATS_DIR=$(IMGS_DIR)/stats/
@@ -19,4 +19,5 @@
 	$(ITBS_DIR) \
 	$(HEXS_DIR) \
 	$(STATS_DIR) \
+	$(BINS_DIR) \
 	$(BINS_PROD_DIR)
