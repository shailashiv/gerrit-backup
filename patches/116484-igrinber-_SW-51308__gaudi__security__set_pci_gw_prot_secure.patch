From 854c3fe5a4d4ef823fc292a838cd29f9462e3436 Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Sun, 01 Aug 2021 12:41:44 +0300
Subject: [PATCH] [SW-51308] gaudi: security: set pci gw prot secure

The PCIe GW initiator should have protection level set to secured.
Make sure it is so.

Change-Id: I308af844317f0e11812ea12229938978af677933
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/arch/gaudi/arm/security.c b/arch/gaudi/arm/security.c
index 2130ee8..fb5eab0 100644
--- a/arch/gaudi/arm/security.c
+++ b/arch/gaudi/arm/security.c
@@ -853,6 +853,10 @@
 		PCIE_WRAP_LBW_PROT_OVR_RD_EN_MASK;
 	regmap_writel(mask, mmPCIE_WRAP_LBW_PROT_OVR);
 
+	/* Set PCI GW level to secured */
+	mask = PROT_OVR_SECURE << PCIE_WRAP_IND_AWPROT_VAL_SHIFT;
+	regmap_writel(mask, mmPCIE_WRAP_IND_AWPROT);
+
 	prot_base = base;	/* offsets: 0 - 0x200 */
 	set_prot_bits_range_all(prot_base, SNGL_REG_PROT_SIZE * 4);
 
