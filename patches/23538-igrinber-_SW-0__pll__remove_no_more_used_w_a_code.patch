-
-static bool gaudi_hbw_init_done(u64 pll_base)
-{
-	return hl_pll_bypass_get(pll_base, HL_PLL_DIV0) == HL_PLL_PLL_CLK;
-}
-
-static bool gaudi_reset_soc_done(void)
-{
-	return regmap_readl(mmPSOC_GLOBAL_CONF_COLD_RST_FLOPS_2) == 1;
-}
 
 bool hl_pll_is_configurable(struct hl_pll_cfg *cfg)
 {
 	switch (cfg->base) {
 	case mmPSOC_CPU_PLL_BASE:
 		return false;
-	case mmPSOC_PCI_PLL_BASE:
-	case mmNIC2_HBM_PLL_BASE:
-		break;
-		if (gaudi_hbw_init_done(cfg->base) && gaudi_reset_soc_done())
-			return false;
-		break;
 	default:
 		break;
 	}
@@ -324,112 +223,4 @@
 	factor = pcie_div2_freq / HL_SPI_FLASH_MAX_FREQ;
 
 	return factor > 2 ? factor : 2;
-}
-
-static void gaudi_reset_soc(void)
-{
-	/* move the UART/SPI clock to reference clock */
-	hl_pll_udelay(10);
-	regmap_writel(HL_PLL_REF_CLK, mmPSOC_PCI_PLL_DIV_SEL_2);
-	hl_pll_udelay(1);
-	hl_uart_init();
-
-	regmap_writel(0xFFE00000, mmPSOC_GLOBAL_CONF_SW_ALL_RST_CFG_L);
-	regmap_writel(0x003FFFFF, mmPSOC_GLOBAL_CONF_SW_ALL_RST_CFG_H);
-	regmap_writel(1, mmPSOC_GLOBAL_CONF_SW_ALL_RST);
-
-	/* Wait for reset */
-	__asm__ __volatile__ ("wfe\n\t" : : );
-
-	while (1)
-		preboot_puts("Surprise! Woke up from WFE...\n");
-}
-
-static u32 hl_pll_build_gate_mask(struct hl_pll_cfg *cfg)
-{
-	int i, gmask = 0;
-
-	for (i = 0; i < HL_PLL_DIV_SIZE; i++)
-		if (cfg->div_wa[i] == HL_PLL_WA_INIT)
-			gmask |= 1 << i;
-
-	return ~gmask & 0xF;
-}
-
-static void hl_pll_wa_clk_sw(struct hl_pll_cfg *cfg)
-{
-	int i;
-	u32 gmask = hl_pll_build_gate_mask(cfg);
-	u32 reg;
-
-	if (gmask != 0xF) {
-		regmap_writel(gmask, cfg->base + HL_PLL_CLK_GATER);
-	} else {
-		preboot_puts_raw("PLL ");
-		preboot_puts_raw(cfg->name);
-		preboot_puts(" Gate mask is 0xF - skip gating...\n");
-	}
-	hl_pll_udelay(1);
-
-	for (i = 0; i < HL_PLL_DIV_SIZE; i++) {
-		if (cfg->div_wa[i] == HL_PLL_WA_NOWA)
-			continue;
-
-		reg = cfg->base + HL_PLL_DIV_SEL + (i * sizeof(u32));
-		/* if DIV_PLL - first change DIV_REF, then DIV_PLL */
-		if (cfg->div_sel[i] == HL_PLL_DIV_PLL) {
-			regmap_writel(HL_PLL_DIV_REF, reg);
-			hl_pll_udelay(1);
-		}
-
-		regmap_writel(cfg->div_sel[i], reg);
-	}
-	hl_pll_udelay(10);
-
-	if (gmask != 0xF) {
-		regmap_writel(0xF, cfg->base + HL_PLL_CLK_GATER);
-		hl_pll_udelay(10);
-	}
-}
-
-void hl_pll_wa(void)
-{
-	int i;
-	u32 boot_strap = regmap_readl(mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS);
-
-	/* H/W bug WA:
-	 * rdata[31:0] = strap_read_val;
-	 * wdata[31:0] = rdata[30:21],1'b0,rdata[20:0]
-	 */
-	boot_strap =	((boot_strap & 0x7FE00000) << 1) |
-			( boot_strap & 0x001FFFFF);
-
-	for (i = 0; i < ARRAY_SIZE(gaudi_pll_cfg); i++) {
-		switch (gaudi_pll_cfg[i].base) {
-		case mmPSOC_CPU_PLL_BASE:
-			continue;
-		case mmNIC2_HBM_PLL_BASE:
-			continue;
-			if (gaudi_reset_soc_done()) {
-				regmap_writel(0, mmPSOC_GLOBAL_CONF_COLD_RST_FLOPS_2);
-				/* reinitialize the PCIe on next reset */
-				boot_strap |= 0x2;
-				regmap_writel(boot_strap, mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS);
-			} else {
-				regmap_writel(1, mmPSOC_GLOBAL_CONF_COLD_RST_FLOPS_2);
-				/* Do not reinitialize the PCIe */
-				boot_strap &= ~0x2;
-				regmap_writel(boot_strap, mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS);
-				preboot_puts("NIC2_HBM configuration done, resetting...\n");
-				gaudi_reset_soc();
-			}
-			break;
-		case mmPSOC_PCI_PLL_BASE:
-			hl_pll_wa_clk_sw(&gaudi_pll_cfg[i]);
-			hl_uart_init();
-			break;
-		default:
-			break;
-		}
-	}
 }
