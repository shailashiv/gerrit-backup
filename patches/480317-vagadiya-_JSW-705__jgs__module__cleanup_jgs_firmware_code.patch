From 27089cb2904798e4594ad350943f3c7eae822fe7 Mon Sep 17 00:00:00 2001
From: Mitali Vagadiya <vmnagajibhai@habana.ai>
Date: Thu, 22 May 2025 12:44:46 +0300
Subject: [PATCH] [JSW-705] jgs: module: cleanup jgs firmware code

This patch removes unnecessary or additional comments,
renames fs related code to jgs and performs complete
code cleanup.

Change-Id: I52cd08e4ba26877c4315cb07afc887679b14ef31
---

diff --git a/include/jgs/hl_pcie.h b/include/jgs/hl_pcie.h
index 3c8a79e..a71d158 100644
--- a/include/jgs/hl_pcie.h
+++ b/include/jgs/hl_pcie.h
@@ -1,6 +1,6 @@
 /* SPDX-License-Identifier: Apache-2.0
  *
- * Copyright 2024 HabanaLabs, Ltd.
+ * Copyright 2025 Intel, Ltd.
  * All Rights Reserved.
  */
 
@@ -27,5 +27,6 @@
 };
 
 int fs1_bmu_init(struct bmu_configs *config);
+int jgs_bmu_init(struct bmu_configs *config);
 
 #endif /* NOC_CFG_INCLUDE_JGS_HL_PCIE_H_ */
diff --git a/src/jgs/hl_pcie.c b/src/jgs/hl_pcie.c
index f95948e..7c39221 100644
--- a/src/jgs/hl_pcie.c
+++ b/src/jgs/hl_pcie.c
@@ -1,6 +1,6 @@
 // SPDX-License-Identifier: Apache-2.0
 /*
- * Copyright 2024 HabanaLabs, Ltd.
+ * Copyright 2025 Intel, Ltd.
  * All Rights Reserved.
  */
 
@@ -14,7 +14,7 @@
 #include <pcie_wrap_regs.h>
 
 #include <zephyr/logging/log.h>
-LOG_MODULE_REGISTER(fs1_pcie);
+LOG_MODULE_REGISTER(jgs_pcie);
 
 #define BMU_CONFIGS_VERSION	"0.2"
 
@@ -458,3 +458,24 @@
 
 	return err;
 }
+
+int jgs_bmu_init(struct bmu_configs *config)
+{
+	int err;
+
+	LOG_INF("BMU configs version %s", BMU_CONFIGS_VERSION);
+
+	switch (config->phase) {
+	case BMU_DEVELOPMENT_MODE:
+		err = bmu_devel_init(config);
+		break;
+	case BMU_PRODUCTION_MODE:
+		err = bmu_prod_init(config);
+		break;
+	default:
+		LOG_ERR("unsupported BMU mode %d", config->phase);
+		err = -1;
+	}
+
+	return err;
+}
