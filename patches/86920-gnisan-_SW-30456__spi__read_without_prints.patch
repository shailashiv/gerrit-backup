From 78d5232fe8d1e99d7aea75e1e46067a32c23c644 Mon Sep 17 00:00:00 2001
From: Guy Nisan <gnisan@habana.ai>
Date: Tue, 06 Apr 2021 16:20:44 +0300
Subject: [PATCH] [SW-30456] spi: read without prints

Allow reading SPI with no prints

Change-Id: Ia29ff2c25daaadfe58c105ce5687b211c8433fcb
Signed-off-by: Guy Nisan <gnisan@habana.ai>
---

diff --git a/common/spi.c b/common/spi.c
index 54fefea..7f0ccf1 100644
--- a/common/spi.c
+++ b/common/spi.c
@@ -271,6 +271,9 @@
 {
 	spi_init();
 	spi_read(dst, offset, size);
-	preboot_puts_raw(name);
-	preboot_puts(" copying from flash is completed\n");
+
+	if (name) {
+		preboot_puts_raw(name);
+		preboot_puts(" copying from flash is completed\n");
+	}
 }
