From b67c232d138e46042811c1da464c89d13ff8710e Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Tue, 23 Oct 2018 11:48:03 +0300
Subject: [PATCH] GAUDI UBOOT PLDM: Update clocks

Refer to 950MHz clock instead of 1000MHz
---

diff --git a/board/habanalabs/gaudi/uboot_pldm.fragment b/board/habanalabs/gaudi/uboot_pldm.fragment
index 0c5974d..6d553fd 100644
--- a/board/habanalabs/gaudi/uboot_pldm.fragment
+++ b/board/habanalabs/gaudi/uboot_pldm.fragment
@@ -1,8 +1,8 @@
-CONFIG_SYS_CLK_FREQ=101000
+CONFIG_SYS_CLK_FREQ=120000
 CONFIG_CONARGS="serial0:1200n8"
 CONFIG_BAUDRATE=1200
 CONFIG_BOOTDELAY=10
-CONFIG_DEBUG_UART_CLOCK=20200
+CONFIG_DEBUG_UART_CLOCK=24000
 CONFIG_BOOTCOMMAND="while true; do waitcmd; run command; done"
 CONFIG_DEFAULT_DEVICE_TREE="gaudi_pldm"
 CONFIG_SPI_FLASH_MACRONIX=y
