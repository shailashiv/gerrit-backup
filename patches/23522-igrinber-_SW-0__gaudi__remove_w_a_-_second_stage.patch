From 64b49bdde021f9a539bc1aa5640c7566bba33bc2 Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Wed, 02 Oct 2019 11:52:38 +0300
Subject: [PATCH] [SW-0] gaudi: remove w/a - second stage

Enable the PCI PLL handling by preboot.

Change-Id: I91ccce775b07d453e52f7f85dd58d0eab7c2da58
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/gaudi/asic.c b/gaudi/asic.c
index dea8115..1ba764b 100644
--- a/gaudi/asic.c
+++ b/gaudi/asic.c
@@ -155,8 +155,8 @@
 		},
 		.div_wa = { HL_PLL_WA_NOWA,
 			    HL_PLL_WA_NOWA,
-			    HL_PLL_WA_NOGT,
-			    HL_PLL_WA_NOGT
+			    HL_PLL_WA_NOWA,
+			    HL_PLL_WA_NOWA
 		},
 	}, {
 		.name = "TPC", .base = mmPSOC_TPC_PLL_BASE,
@@ -272,9 +272,9 @@
 bool hl_pll_is_configurable(struct hl_pll_cfg *cfg)
 {
 	switch (cfg->base) {
-	case mmPSOC_PCI_PLL_BASE:
 	case mmPSOC_CPU_PLL_BASE:
 		return false;
+	case mmPSOC_PCI_PLL_BASE:
 	case mmNIC2_HBM_PLL_BASE:
 		break;
 		if (gaudi_hbw_init_done(cfg->base) && gaudi_reset_soc_done())
