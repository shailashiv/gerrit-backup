diff --git a/arch/jgs/intr/jgs_intr.c b/arch/jgs/intr/jgs_intr.c
new file mode 100644
index 0000000..5bca6d1
--- /dev/null
+++ b/arch/jgs/intr/jgs_intr.c
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: Apache-2.0
+/*
+ *
+ * Copyright 2024 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <intr.h>
+
+#include <zephyr/logging/log.h>
+LOG_MODULE_REGISTER(JGS_INTR);
+
+static struct intr_config intr;
+/*
+ * Function to get the interrupt handler for a specific group and component
+ */
+static int jgs_get_intr_type(struct intr_config *config, enum intr_agg_grp_type *grp,
+	enum intr_agg_component_type *comp_type)
+{
+	/* TODO: Read grp and comp_type from config and set them accordingly */
+	if (grp)
+		*grp = INTR_GRP_TYPE_MAX;
+	if (comp_type)
+		*comp_type = INTR_COMP_TYPE_MAX;
+	return 0;
+}
+
+static int jgs_process_sei_interrupt(struct intr_config *config)
+{
+	int ret = intr_dispatch_component_handler(config);
+	/* TODO: SEI-specific post-processing. */
+	return ret;
+}
+
+static int jgs_process_spi_interrupt(struct intr_config *config)
+{
+	int ret = intr_dispatch_component_handler(config);
+	/* TODO: SPI-specific post-processing. */
+	return ret;
+}
+
+static int jgs_process_serr_interrupt(struct intr_config *config)
+{
+	int ret = intr_dispatch_component_handler(config);
+	/*  TODO: SERR-specific post-processing. */
+	return ret;
+}
+
+static int jgs_process_derr_interrupt(struct intr_config *config)
+{
+	int ret = intr_dispatch_component_handler(config);
+	/* TODO: DERR-specific post-processing. */
+	return ret;
+}
+
+static int jgs_process_eco_interrupt(struct intr_config *config)
+{
+	int ret = intr_dispatch_component_handler(config);
+	/* TODO: ECO-specific post-processing. */
+	return ret;
+}
+
+static int jgs_process_interrupt(struct intr_config *config)
+{
+	enum intr_agg_grp_type grp;
+	enum intr_agg_component_type comp_type;
+
+	if (config->intr_type(config, &grp, &comp_type)) {
+		LOG_ERR("Failed to get interrupt group and component type");
+		return -1;
+	}
+
+	switch (grp) {
+	case INTR_GRP_TYPE_SEI:
+		return jgs_process_sei_interrupt(config);
+	case INTR_GRP_TYPE_SPI:
+		return jgs_process_spi_interrupt(config);
+	case INTR_GRP_TYPE_SERR:
+		return jgs_process_serr_interrupt(config);
+	case INTR_GRP_TYPE_DERR:
+		return jgs_process_derr_interrupt(config);
+	case INTR_GRP_TYPE_ECO:
+		return jgs_process_eco_interrupt(config);
+	default:
+		LOG_ERR("Unknown group type: %d", grp);
+		return -1;
+	}
+}
+
+int dev_intr_prepare(struct hl_dev_config *dev_cfg)
+{
+	dev_cfg->intr_config = &intr;
+	intr.intr_type = jgs_get_intr_type;
+	intr.arch_process_interrupt = jgs_process_interrupt;
+
+	return 0;
+}
diff --git a/include/intr.h b/include/intr.h
new file mode 100644
index 0000000..a0e0570
--- /dev/null
+++ b/include/intr.h
@@ -0,0 +1,82 @@
+/* SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2025 Intel, Ltd.
+ * All Rights Reserved.
+ */
+
+
+#ifndef ZEPHYR_INCLUDE_INTR_H_
+#define ZEPHYR_INCLUDE_INTR_H_
+
+#include <zephyr/kernel.h>
+#include <zephyr/types.h>
+#include <intr_comp_list.h>
+
+enum intr_agg_grp_type {
+	INTR_GRP_TYPE_SERR,
+	INTR_GRP_TYPE_DERR,
+	INTR_GRP_TYPE_SEI,
+	INTR_GRP_TYPE_SPI,
+	INTR_GRP_TYPE_ECO,
+	INTR_GRP_TYPE_MAX
+};
+
+enum intr_agg_component_type {
+#define INTR_COMP(name) INT_COMP_TYPE_##name,
+	INTR_COMPONENTS_LIST
+#undef INTR_COMP
+	INTR_COMP_TYPE_MAX
+};
+
+enum intr_action {
+	INTR_ACTION_ENABLE,
+	INTR_ACTION_DISABLE,
+	INTR_ACTION_MASK,
+	INTR_ACTION_UNMASK,
+	INTR_ACTION_PROCESS
+};
+
+struct intr_config {
+	uint32_t intr_data;
+	int (*intr_type)(struct intr_config *config, enum intr_agg_grp_type *grp,
+		enum intr_agg_component_type *comp_type);
+	int (*arch_process_interrupt)(struct intr_config *config);
+};
+
+int dev_intr_prepare(struct hl_dev_config *dev_cfg)
+int process_interrupt(struct intr_config *config, enum intr_action action);
+int intr_dispatch_component_handler(struct intr_config *config);
+
+/* Handler function declarations for each group/component type combination */
+#define DECLARE_INTR_HANDLER(GRP, COMP) \
+	int handle_##COMP##_##GRP##_interrupt(struct intr_config *intr_info);
+#define ASSIGN_INTR_HANDLER(GRP, COMP) handle_##COMP##_##GRP##_interrupt
+#define DEFINITION_INTR_HANDLER(GRP, COMP) \
+	__weak int handle_##COMP##_##GRP##_interrupt(struct intr_config *intr_info) \
+	{ \
+		LOG_WRN("%s is not implemented", __func__); \
+		return 0; \
+	}
+
+/* Macro to declare all handlers for a component if enabled */
+#define DECLARE_ALL_INTR_HANDLERS(comp) \
+	DECLARE_INTR_HANDLER(serr, comp) \
+	DECLARE_INTR_HANDLER(derr, comp) \
+	DECLARE_INTR_HANDLER(sei, comp) \
+	DECLARE_INTR_HANDLER(spi, comp) \
+	DECLARE_INTR_HANDLER(eco, comp)
+
+	/* Macro to aggregate all group handlers for a given component type */
+#define ASSIGN_ALL_INTR_HANDLER_FOR(comp) { \
+	ASSIGN_INTR_HANDLER(serr, comp), \
+	ASSIGN_INTR_HANDLER(derr, comp), \
+	ASSIGN_INTR_HANDLER(sei, comp), \
+	ASSIGN_INTR_HANDLER(spi, comp), \
+	ASSIGN_INTR_HANDLER(eco, comp) \
+}
+
+#define INTR_COMP(name) DECLARE_ALL_INTR_HANDLERS(name)
+INTR_COMPONENTS_LIST
+#undef INTR_COMP
+
+#endif /* ZEPHYR_INCLUDE_INTR_H_ */
