From d8aa7ddcdf62465d1bc27584057fba5ab22f7e39 Mon Sep 17 00:00:00 2001
From: Pavan S <psreenivas@habana.ai>
Date: Fri, 16 May 2025 16:47:11 +0300
Subject: [PATCH] [JSW-695] interrupt: initial framework support

In jgs the interrupt will be handled in arcmgmt
This patch adds the initial framework which splits
into common, dev specific and component specific files.

Signed-off-by: Pavan S <psreenivas@habana.ai>
Change-Id: Iab78bca7a2433ef8caf411a75426d031687697bb
---

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 2ca8403..824a562 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -98,6 +98,10 @@
 FILE(GLOB pldm_sources lib/ras/pldm/*.c arch/${DEVICE}/ras/pldm/*.c)
 target_sources_ifdef(CONFIG_LIBPLDM app PRIVATE ${pldm_sources})
 
+FILE(GLOB intr_sources arch/common/intr/*.c arch/${DEVICE}/intr/*.c
+arch/${DEVICE}/intr/component/*.c)
+target_sources_ifdef(CONFIG_HANDLE_INTERRUPT app PRIVATE ${intr_sources})
+
 target_sources_ifdef(CONFIG_LFS_ENABLED app PRIVATE ${ZEPHYR_MODULES_DIR}/littlefs/lfs.c
 							${ZEPHYR_MODULES_DIR}/littlefs/lfs_util.c)
 target_sources_ifdef(CONFIG_LFS_OVER_SPI app PRIVATE ${ZEPHYR_MODULES_DIR}/littlefs/zephyr/lfs_zephyrbd.c
diff --git a/app/io/mgmt.c b/app/io/mgmt.c
index 5d4ea18..e6a7123 100644
--- a/app/io/mgmt.c
+++ b/app/io/mgmt.c
@@ -12,6 +12,7 @@
 #include <stdlib.h>
 #include <hl_boot_info.h>
 #include <zephyr/drivers/watchdog.h>
+#include <intr.h>
 #ifndef CONFIG_SOC_FS1_MGMT
 #include <hl_boot_status.h>
 #endif
@@ -460,6 +461,9 @@
 #endif
 #endif
 
+#ifdef CONFIG_HANDLE_INTERRUPT
+	dev_intr_prepare(dev_config);
+#endif
 	/* must be set last, after all HW&SW inits */
 	sysmng_notify_boot_done();
 
@@ -513,6 +517,9 @@
 
 		check_ints_status();
 
+		#ifdef CONFIG_HANDLE_INTERRUPT
+		process_interrupt(dev_config->intr_config, INTR_ACTION_PROCESS);
+		#endif
 		mgmt_exit();
 		k_msleep(SYSMNGD_POLLING_DELAY);
 	}
diff --git a/arch/common/intr/intr.c b/arch/common/intr/intr.c
new file mode 100644
index 0000000..2a96945
--- /dev/null
+++ b/arch/common/intr/intr.c
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: Apache-2.0
+/*
+ *
+ * Copyright 2025 Intel, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <intr.h>
+
+#include <zephyr/logging/log.h>
+LOG_MODULE_REGISTER(INTR);
+
+__weak int process_dev_interrupt(struct intr_config *config)
+{
+	return 0;
+}
+
+int process_interrupt(struct intr_config *config, enum intr_action action)
+{
+
+	config->arch_process_interrupt(config);
+
+	return 0;
+}
diff --git a/arch/common/intr/intr_dispatch.c b/arch/common/intr/intr_dispatch.c
new file mode 100644
index 0000000..d6709c1
--- /dev/null
+++ b/arch/common/intr/intr_dispatch.c
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: Apache-2.0
+/*
+ *
+ * Copyright 2025 Intel, Ltd.
+ * All Rights Reserved.
+ */
+
+#include <intr.h>
+
+#include <zephyr/logging/log.h>
+LOG_MODULE_REGISTER(INTR_DISPATCH);
+
+typedef int (*intr_comp_handlers_t)(struct intr_config *intr_info);
+
+/* Macro to aggregate all group handlers for a given component type */
+#define ASSIGN_ALL_INTR_HANDLER_FOR(comp) { \
+	ASSIGN_INTR_HANDLER(serr, comp), \
+	ASSIGN_INTR_HANDLER(derr, comp), \
+	ASSIGN_INTR_HANDLER(sei, comp), \
+	ASSIGN_INTR_HANDLER(spi, comp), \
+	ASSIGN_INTR_HANDLER(eco, comp) \
+}
+
+/* 2D array of function pointers for each component type and each group type */
+static intr_comp_handlers_t intr_comp_handlers[INTR_COMP_TYPE_MAX][INTR_GRP_TYPE_MAX] = {
+#define INTR_COMP(name) ASSIGN_ALL_INTR_HANDLER_FOR(name),
+	INTR_COMPONENTS_LIST
+#undef INTR_COMP
+};
+
+
+int intr_dispatch_component_handler(struct intr_config *config)
+{
+	enum intr_agg_grp_type grp;
+	enum intr_agg_component_type comp_type;
+
+	if (config->intr_type(config, &grp, &comp_type)) {
+		LOG_ERR("Failed to get interrupt group and component type");
+		return -1;
+	}
+
+	if (grp < 0 || grp >= INTR_GRP_TYPE_MAX) {
+		LOG_ERR("Invalid group type: %d", grp);
+		return -1;
+	}
+
+	if (comp_type < 0 || comp_type >= INTR_COMP_TYPE_MAX) {
+		LOG_ERR("Invalid component type: %d", comp_type);
+		return -1;
+	}
+
+	if (intr_comp_handlers[comp_type][grp])
+		return intr_comp_handlers[comp_type][grp](config);
+
+	LOG_ERR("No handler found for group %d and component %d", grp, comp_type);
+	return -1;
+}
