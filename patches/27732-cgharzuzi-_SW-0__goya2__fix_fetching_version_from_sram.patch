From 955213b828c90165f11189645e22d5a5da188ac8 Mon Sep 17 00:00:00 2001
From: Christine Gharzuzi <cgharzuzi@habana.ai>
Date: Tue, 11 Feb 2020 17:53:40 +0200
Subject: [PATCH] [SW-0] goya2: fix fetching version from sram

Fix offset used for fetching FW version from SRAM

Change-Id: I9ff57caf3e6e06fb27a18434876aa511c950e47e
Signed-off-by: Christine Gharzuzi <cgharzuzi@habana.ai>
---

diff --git a/common/security.c b/common/security.c
index ba91579..5c4116e 100644
--- a/common/security.c
+++ b/common/security.c
@@ -496,7 +496,7 @@
 	uint8_t fw_version_sec, valid_fw_version_sec;
 
 	fw_version_sec = SECURITY_FW_VERSION_TO_SECURITY_BYTE(fw_version);
-	valid_fw_version = sp_sram_readl(SECURITY_EFUSE_KEYS_REVOKE_OFFSET);
+	valid_fw_version = sp_sram_readl(SECURITY_EFUSE_FW_VERSION_OFFSET);
 	valid_fw_version_sec =
 		SECURITY_FW_VERSION_TO_SECURITY_BYTE(valid_fw_version);
 
