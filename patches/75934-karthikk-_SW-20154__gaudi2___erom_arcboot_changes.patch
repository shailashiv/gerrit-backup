diff --git a/common/boot_desc.c b/common/boot_desc.c
new file mode 100644
index 0000000..359bd81
--- /dev/null
+++ b/common/boot_desc.c
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2021 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+#include <string.h>
+#include <stdbool.h>
+#include <hl_fw_if.h>
+#include "hl_boot_desc_erom.h"
+#include <common.h>
+#include <arcboot.h>
+#include "boot_desc.h"
+#include "dma.h"
+#include "spi_flash.h"
+
+#define MAX_IMGS		5
+#define BOOT_PTRS_SZ		sizeof(struct hl_fw_boot_ptrs)
+#define IMG_DESC_SZ		sizeof(struct hl_fw_img_desc)
+#define CRC32_PADD		sizeof(uint32_t)
+#define DESC_MAGIC_MASK		0xFFFFFF00
+#define INV_VER1		((uint32_t)0)
+#define INV_VER2		((uint32_t) -1)
+#define INVALID_DESC_ID		2
+static struct hl_fw_boot_ptrs *p_boot_ptrs;
+static struct hl_fw_img_desc *p_img_desc[MAX_IMGS];
+
+static bool boot_desc_img_desc_is_valid(struct hl_fw_img_desc *img_desc)
+{
+	if ((img_desc->magic.val & DESC_MAGIC_MASK) != HL_FW_IMG_DESC_MAGIC)
+		return false;
+
+	if ((img_desc->desc_ver == INV_VER1) ||
+	    (img_desc->desc_ver == INV_VER2))
+		return false;
+
+	if (img_desc->idx >= INVALID_DESC_ID)
+		return false;
+
+	return true;
+}
+
+int boot_desc_init(void)
+{
+	uint32_t i, boot_ptrs_count, img_ptrs_size;
+	uint32_t *p_count = NULL;
+
+	boot_ptrs_count = spi_flash_readl(HL_BOOT_PTS_COUNT_FLASH_OFFSET);
+
+	img_ptrs_size = BOOT_PTRS_SZ + ((sizeof(uint32_t) +
+			IMG_DESC_SZ) * boot_ptrs_count) + CRC32_PADD;
+
+	arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_BOOT_DESC_DMA_START);
+
+	/* Fetch boot desc using DMA into SP SRAM offset of 4KB */
+	dma_copy_image(img_ptrs_size, HL_EROM_IMG_PTRS_BASE,
+		       HL_SP_SRAM_BASE + (HL_BOOT_DESC_SP_SRAM_OFFSET >> 2),
+		       SPI_DMA_DST_HBW);
+	if (dma_wait_finish() == DMA_CRC_ERROR)
+		return 0;
+
+	arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_BOOT_DESC_DMA_FINISH);
+
+	p_count = (uint32_t *) HL_BOOT_PTS_COUNT_SRAM_OFFSET;
+	p_boot_ptrs = (struct hl_fw_boot_ptrs *)(HL_BOOT_PTS_SP_SRAM_START);
+
+	if (p_boot_ptrs->magic.val != HL_FW_BOOT_MAGIC)
+		return 0;
+
+	/* Read all descriptors */
+	for (i = 0; i < p_boot_ptrs->count; i++) {
+		p_img_desc[i] = (struct hl_fw_img_desc *)
+				(HL_BOOT_PTS_SP_SRAM_START + p_count[i]);
+		if (!boot_desc_img_desc_is_valid(p_img_desc[i]))
+			return 0;
+	}
+	arcboot_rom_global.erom_boot_desc_flag = 1;
+	return p_boot_ptrs->count;
+}
+
+uint32_t boot_desc_get_img_desc(enum hl_fw_img_type type,
+				struct boot_desc *desc)
+{
+	uint32_t i;
+
+	/* boot descriptors not initialized */
+	if ((p_boot_ptrs == NULL) || (p_img_desc == NULL))
+		return HL_FW_IMG_NOT_FOUND;
+
+	for (i = 0; i < p_boot_ptrs->count; i++) {
+		if (p_img_desc[i]->magic.magic_type.type != type)
+			continue;
+
+		desc->spi_offset = p_img_desc[i]->offset[p_img_desc[i]->idx];
+		desc->img_size = p_img_desc[i]->size[p_img_desc[i]->idx];
+		desc->loadaddr = ((uint64_t)
+			p_img_desc[i]->load_high[p_img_desc[i]->idx] << 32) |
+			p_img_desc[i]->load_low[p_img_desc[i]->idx];
+		desc->desc_ver = p_img_desc[i]->desc_ver;
+		memcpy(desc->chksum, p_img_desc[i]->chksum[p_img_desc[i]->idx],
+		       ARRAY_SIZE(desc->chksum));
+
+		return p_img_desc[i]->idx;
+	}
+	return HL_FW_IMG_NOT_FOUND;
+}
diff --git a/common/boot_desc.h b/common/boot_desc.h
new file mode 100644
index 0000000..dd90f19
--- /dev/null
+++ b/common/boot_desc.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Copyright (C) 2021 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+#ifndef _BOOT_DESC_H_
+#define _BOOT_DESC_H_
+
+#include <hl_fw_if.h>
+#include <hl_boot_desc_erom.h>
+#include <sha512.h>
+
+#define HL_FW_IMG_NOT_FOUND		((uint32_t) -1)
+/* erom image pointer binary placed in flash at offset 0 */
+#define HL_EROM_IMG_PTRS_BASE		(0x00000000)
+#define HL_CRC32_FOOTER			(sizeof(uint32_t))
+/* erom boot descriptors placed in SP SRAM at offset 4K */
+#define HL_BOOT_DESC_SP_SRAM_OFFSET	(4 * 1024)
+#define HL_BOOT_PTS_SP_SRAM_START	(HL_SCRATCHPAD_SRAM_BASE +\
+					HL_BOOT_DESC_SP_SRAM_OFFSET)
+#define HL_BOOT_PTS_COUNT_SRAM_OFFSET	(HL_BOOT_PTS_SP_SRAM_START +\
+					BOOT_PTRS_SZ)
+#define HL_BOOT_PTS_COUNT_FLASH_OFFSET	(HL_EROM_IMG_PTRS_BASE +\
+					(BOOT_PTRS_SZ - sizeof(uint32_t)))
+
+struct boot_desc {
+	uint32_t desc_ver;
+	uint32_t spi_offset;
+	uint32_t img_size;
+	uint64_t loadaddr;
+	uint8_t chksum[SHA384_SUM_LEN];
+};
+
+/*
+ * boot_desc_init() - read and initialize the boot image pointers structures
+ *
+ * Returns: the amount of images available, or 0 - no images available - legacy
+ */
+int boot_desc_init(void);
+
+/*
+ * boot_desc_get_img_desc() - get the struct boot_desc of the requested image
+ *
+ * @type	- the image type to look for
+ * @desc	- pointer to the struct boot_desc for placing the image data
+ *
+ * Returns:
+ * On success: the index of the image to load
+ * On failure: (u32)-1 (no image by the requested type)
+ */
+uint32_t boot_desc_get_img_desc(enum hl_fw_img_type type,
+				struct boot_desc *desc);
+
+#endif /* _BOOT_DESC_H_ */
