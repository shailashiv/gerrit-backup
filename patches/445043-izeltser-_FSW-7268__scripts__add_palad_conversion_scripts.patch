diff --git a/scripts/palad/bin2hex.sh b/scripts/palad/bin2hex.sh
new file mode 100755
index 0000000..4892890
--- /dev/null
+++ b/scripts/palad/bin2hex.sh
@@ -0,0 +1,51 @@
+#!/bin/bash
+
+function hl_pldm_hex {
+	local NAME=$(basename "$1" | cut -f 1 -d '.')
+	local FILE=$1
+	local BYTES_PER_LINE=$2
+
+	# pad file to 128bit (16Byte) as pladium emulates 128bit memory, so xxd wont trunc lines
+	dd status=none conv=sync bs=16 if=${FILE} > ${FILE}.tmp
+	xxd -e -g ${BYTES_PER_LINE} ${FILE}.tmp | xxd -r | xxd -ps -c${BYTES_PER_LINE} > ${NAME}.hex
+	rm ${FILE}.tmp
+}
+
+# Function to display help menu
+show_help() {
+    echo "Usage: $0 [options] <file-path>"
+    echo
+    echo "Options:"
+    echo "  -h          Show this help message and exit"
+    echo
+    echo "Arguments:"
+    echo "  <file-path> Path to the application binary image"
+    echo "  <bytes-per-line> data with in target hex file"
+}
+
+# Check for the -h flag
+if [[ "$1" == "-h" ]]; then
+    show_help
+    exit 0
+fi
+
+# Check if the correct number of arguments is provided
+if [[ $# -ne 2 ]]; then
+    echo "Error: Invalid number of arguments."
+    show_help
+    exit 1
+fi
+
+# File path from the first argument
+FILE_PATH="$1"
+TRGT_BYTES=$2
+#SCRIPT_DIR=$(dirname "$(realpath "$0")")
+#TOOLS_DIR="${SCRIPT_DIR}/ext_tools/"
+
+# Check if the file exists
+if [[ ! -e "$FILE_PATH" ]]; then
+    echo "File '$FILE_PATH' does not exist."
+    exit 1
+fi
+
+hl_pldm_hex ${FILE_PATH} ${TRGT_BYTES}
diff --git a/scripts/palad/convert_app_to_ccm_hex.sh b/scripts/palad/convert_app_to_ccm_hex.sh
new file mode 100755
index 0000000..faa64f5
--- /dev/null
+++ b/scripts/palad/convert_app_to_ccm_hex.sh
@@ -0,0 +1,48 @@
+#!/bin/bash
+
+# Function to display help menu
+show_help() {
+    echo "Usage: $0 [options] <file-path>"
+    echo
+    echo "Options:"
+    echo "  -h          Show this help message and exit"
+    echo
+    echo "Arguments:"
+    echo "  <file-path> Path to the application bin image"
+}
+
+# Check for the -h flag
+if [[ "$1" == "-h" ]]; then
+    show_help
+    exit 0
+fi
+
+# Check if the correct number of arguments is provided
+if [[ $# -ne 1 ]]; then
+    echo "Error: Invalid number of arguments."
+    show_help
+    exit 1
+fi
+
+# File path from the first argument
+FILE_PATH="$1"
+FILE_NAME=$(basename "${FILE_PATH}" | cut -f 1 -d '.')
+SCRIPT_DIR=$(dirname "$(realpath "$0")")
+TOOLS_DIR="${SCRIPT_DIR}/ext_tools/"
+
+# Check if the file exists
+if [[ -e "$FILE_PATH" ]]; then
+    echo "Converting '$FILE_PATH'"
+else
+    echo "File '$FILE_PATH' does not exist."
+fi
+
+# reverse endianess, as CCM converter expects big endian binary
+objcopy -Ibinary --reverse-bytes=4 ${FILE_PATH} ${FILE_NAME}_be.bin
+
+${SCRIPT_DIR}/bin2hex.sh ${FILE_NAME}_be.bin 1
+perl ${TOOLS_DIR}/convert_hex.pl ${FILE_NAME}_be.hex ccm_temp_conv.hex
+${TOOLS_DIR}/eccgen -hex ccm_temp_conv.hex -build ${TOOLS_DIR}/build_configuration.txt -a
+rm -f ccm_temp_conv.hex ${FILE_NAME}_be.hex ${FILE_NAME}_be.bin
+
+echo "Conversion done"
