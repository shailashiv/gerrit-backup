diff --git a/package/hls2-bmc/deploy-shared-sources.sh b/package/hls2-bmc/deploy-shared-sources.sh
new file mode 100755
index 0000000..9d06420
--- /dev/null
+++ b/package/hls2-bmc/deploy-shared-sources.sh
@@ -0,0 +1,188 @@
+#!/bin/bash
+
+EMBEDDED_DIR=${HABANA_SOFTWARE_STACK}/embedded
+HLS_UTILS_DIR=${EMBEDDED_DIR}/hls-utils
+
+SPECS_SEARCH_DIR=(
+	${SPECS_ROOT}
+	${SPECS_EMBEDDED_ROOT}
+)
+
+# Gaudi2 Specific
+GAUDI2_HDR_LIST=(
+	"gaudi2.h"
+	"gaudi2_reg_map.h"
+	"psoc_global_conf_masks.h"
+	"psoc_security_regs.h"
+	"cpu_if_regs.h"
+	"pcie_dbi_regs.h"
+)
+# Header list to be inlcluded in gaudi2_regs.h
+GAUDI2_REGS_HDR_LIST=(
+	"gaudi2_blocks.h"
+	"cpu_ca53_cfg_regs.h"
+	"pcie_aux_regs.h"
+	"pcie_aux_masks.h"
+	"psoc_global_conf_regs.h"
+	"psoc_global_conf_masks.h"
+	"psoc_gpio1_regs.h"
+	"psoc_i2c_m1_regs.h"
+	"psoc_i2c_m1_masks.h"
+	"psoc_qspi_regs.h"
+	"psoc_qspi_masks.h"
+	"pcie_wrap_regs.h"
+	"pcie_wrap_masks.h"
+)
+
+COMMON_HDR_LIST=(
+	"pci_ids.h"
+	"hl_boot_if.h"
+	"hl_fw_if.h"
+	"hl_pci_if.h"
+	"cpucp_if.h"
+	"entity_ids.h"
+	"hl_sec_if.h"
+	"fit_load_type.h"
+	"rma_if.h"
+	"hl_i2c_ctrl_cmd.h"
+	"hl_i2c_indirect.h"
+	"hl_i2c_indirect_protocol.h"
+	"hl_i2c_slave_events.h"
+)
+
+function create_regs_hdr_file
+{
+	local dest_dir=${1}
+	local project=${2}
+	shift 2
+	local hdr_list=("$@")
+	local regs_hdr_file="${dest_dir}/${project}_regs.h"
+
+	# print license header
+	echo "/* SPDX-License-Identifier: MIT"			> ${regs_hdr_file}
+	echo " *"						>> ${regs_hdr_file}
+	echo " * Copyright 2021 HabanaLabs, Ltd."		>> ${regs_hdr_file}
+	echo " * All Rights Reserved."				>> ${regs_hdr_file}
+	echo " *"						>> ${regs_hdr_file}
+	echo " */"						>> ${regs_hdr_file}
+	echo ""							>> ${regs_hdr_file}
+
+	echo "#ifndef ASIC_REG_${project^^}_REGS_H_"		>> ${regs_hdr_file}
+	echo "#define ASIC_REG_${project^^}_REGS_H_"		>> ${regs_hdr_file}
+	echo ""							>> ${regs_hdr_file}
+
+	for hdr in "${hdr_list[@]}"
+	do
+		echo "#include \"${hdr}\""			>> ${regs_hdr_file}
+	done
+	echo ""							>> ${regs_hdr_file}
+
+	echo "#endif /* ASIC_REG_${project^^}_REGS_H_ */" 	>> ${regs_hdr_file}
+	echo ""							>> ${regs_hdr_file}
+
+}
+
+function create_version_header
+{
+	VERSION_FILE=${SHARED_SRC}/include/version-autogenerated.h
+
+	rm -f ${VERSION_FILE}
+
+	cat >> ${VERSION_FILE} << EOF
+#define HLS_VER "$(git describe --tags --abbrev=0)"
+#define HLS_DATE "$(date +"%b %d %Y")"
+#define HLS_TIME "$(date +"%T")"
+
+#define HL_FW_LOADER_VER HLS_VER
+#define HL_FW_LOADER_DATE HLS_DATE
+#define HL_FW_LOADER_TIME HLS_TIME
+EOF
+}
+
+# arg1 : dest_dir; arg2 : search_dir; arg3 : lib_name; arg4: hdr_list
+function find_and_copy_headers_from_libs
+{
+	local dest_dir=${1}
+	local search_dir=${2}
+	local lib_name=${3}
+	shift 3
+	local hdr_list=("$@")
+	for file in "${hdr_list[@]}"
+	do
+		file_abs_path=$(find "${search_dir}/${lib_name}" -name ${file})
+		if [ ! -z "$file_abs_path" ]
+		then
+			file_rel_path=$(realpath --relative-to=${search_dir} ${file_abs_path})
+			dir_rel_path=$(dirname ${file_rel_path})
+			mkdir -p ${dest_dir}/${dir_rel_path}
+			cp ${file_abs_path} ${dest_dir}/${file_rel_path}
+		else
+			echo "ERR: Unable to find ${file} in ${search_dir} !!!"
+		fi
+	done
+}
+
+# arg1 : dest_dir; arg2 : project ; arg3 : hdr_list
+function find_and_copy_headers_from_specs
+{
+	local dest_dir=${1}
+	local project=${2}
+	shift 2
+	local hdr_list=("$@")
+	for file in "${hdr_list[@]}"
+	do
+		file_found=0
+		for specs_dir in ${SPECS_SEARCH_DIR[@]}
+		do
+		file_abs_path=$(find "${specs_dir}/${project}" \
+			-not \( -path ${specs_dir}/${project}/asic_reg_structs -prune \) -name ${file})
+		if [ ! -z "$file_abs_path" ]
+		then
+			file_found=1
+			file_rel_path=$(realpath --relative-to=${specs_dir} ${file_abs_path})
+			dir_rel_path=$(dirname ${file_rel_path})
+			mkdir -p ${dest_dir}/${dir_rel_path}
+			cp ${file_abs_path} ${dest_dir}/${file_rel_path}
+			break
+		fi
+		done
+		if [[ $file_found -eq 0 ]]
+		then
+			echo "ERR: Unable to find ${file} in ${SPECS_SEARCH_DIR[@]} /${project} !!!"
+		fi
+	done
+}
+
+function deploy_shared_source_files
+{
+	SHARED_SRC=${1}
+
+	HDR_LIST="GAUDI2_HDR_LIST[@]"
+	REGS_HDR_LIST="GAUDI2_REGS_HDR_LIST[@]"
+
+	find_and_copy_headers_from_specs "${SHARED_SRC}/include" "gaudi2" "${!HDR_LIST}"
+	find_and_copy_headers_from_specs "${SHARED_SRC}/include" "gaudi2" "${!REGS_HDR_LIST}"
+	find_and_copy_headers_from_specs "${SHARED_SRC}/include" "" "${COMMON_HDR_LIST[@]}"
+
+	create_regs_hdr_file "${SHARED_SRC}/include/gaudi2/asic_reg" "gaudi2" "${!REGS_HDR_LIST}"
+
+	mkdir -p ${SHARED_SRC}/src
+
+	cp ${HLS_UTILS_DIR}/src/hl-ver.cpp ${SHARED_SRC}/src
+	cp ${HLS_UTILS_DIR}/include/hl-ver.h ${SHARED_SRC}/include
+
+	mkdir ${SHARED_SRC}/src/fdt
+	cp -r ${ZEPHYR_MODULES_ROOT}/fdt/* ${SHARED_SRC}/src/fdt
+
+	cp  ${ZEPHYR_MODULES_ROOT}/lz4/lib/lz4.c ${SHARED_SRC}/src/
+	cp  ${ZEPHYR_MODULES_ROOT}/lz4/lib/lz4.h ${SHARED_SRC}/include/
+
+	cp ${BUILDROOT_ROOT}/package/hls2-bmc/Makefile ${SHARED_SRC}
+
+	mkdir -p ${SHARED_SRC}/include/common
+	cp ${SPECS_ROOT}/common/pci_ids.h ${SHARED_SRC}/include/common
+
+	create_version_header
+}
+
+deploy_shared_source_files ${1}
diff --git a/package/hls2-bmc/hls2-bmc.mk b/package/hls2-bmc/hls2-bmc.mk
new file mode 100644
index 0000000..29183a9
--- /dev/null
+++ b/package/hls2-bmc/hls2-bmc.mk
@@ -0,0 +1,40 @@
+HLS2_BMC_VERSION = 1.0.0
+HLS2_BMC_LICENSE = unclear
+HLS2_BMC_SITE = hls2-bmc
+DOCKER_IMAGE = docker-local/spx/v1.0-beta8.5:v1.0-beta8.5
+JFROG_SERVER = artifactory-kfs.habana-labs.com
+FULL_DOCKER_IMAGE = ${JFROG_SERVER}/${DOCKER_IMAGE}
+WORKSPACE := ${HABANA_SOFTWARE_STACK}
+HLS2_BUILD := ${WORKSPACE}/embedded/hls2-bmc
+HLS2_BMC_IMAGE = Build/output/rom.ima
+HLS2_SHARED_SOURCES_DIR=embedded/hls2-bmc/packages/hl/packages/hlshared-src/data
+
+define SKIP_RSYNC
+	(cd $(@D); touch .stamp_rsynced)
+endef
+
+HLS2_BMC_POST_CONFIGURE_HOOKS += SKIP_RSYNC
+
+define HLS2_BMC_DEPLOY_SHARED_SOURCES
+	$(BUILDROOT_ROOT)/package/hls2-bmc/deploy-shared-sources.sh \
+		$(HABANA_SOFTWARE_STACK)/$(HLS2_SHARED_SOURCES_DIR)
+endef
+
+HLS2_BMC_PRE_BUILD_HOOKS += HLS2_BMC_DEPLOY_SHARED_SOURCES
+
+define HLS2_BMC_BUILD_CMDS
+	(cd $(TOPDIR)/../hls2-bmc; docker run --rm --name spx_build -t \
+		-v ${WORKSPACE}:${WORKSPACE} \
+		-v $(@D)/workspace:$(@D)/workspace ${FULL_DOCKER_IMAGE} \
+		 buildsrc --v false ${HLS2_BUILD}/configs/ETRON.PRJ \
+		 ${HLS2_BUILD}/packages $(@D)/workspace)
+endef
+
+
+HLS2_BMC_INSTALL_IMAGES = yes
+
+define HLS2_BMC_INSTALL_IMAGES_CMDS
+	$(INSTALL) -m 0644 -D $(@D)/$(HLS2_BMC_IMAGE) $(BINARIES_DIR)
+endef
+
+$(eval $(generic-package))
