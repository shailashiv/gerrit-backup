From 21d9fa94070864f0b9059d8158fb5b125bfdd748 Mon Sep 17 00:00:00 2001
From: Arnon Kaufman <akaufman@habana.ai>
Date: Sat, 21 Oct 2023 00:35:07 +0300
Subject: [PATCH] [SW-15774] package: add agent-hbm

Add a package to build the HBM agent

Change-Id: Idf31ea0f8b9ef306d27bf4ad32b37d8346039592
Signed-off-by: Arnon Kaufman <akaufman@habana.ai>
---

diff --git a/board/habanalabs/common/local.mk b/board/habanalabs/common/local.mk
index 6eb48f5..3a21f80 100644
--- a/board/habanalabs/common/local.mk
+++ b/board/habanalabs/common/local.mk
@@ -25,3 +25,4 @@
 MGMT_OVERRIDE_SRCDIR = $(TOPDIR)/../zephyr-apps/arcmgmt
 EVENT_OVERRIDE_SRCDIR = $(TOPDIR)/../zephyr-apps/arcevent
 AGENT_FWL_OVERRIDE_SRCDIR = $(TOPDIR)/../zephyr-plugins
+AGENT_HBM_OVERRIDE_SRCDIR = $(TOPDIR)/../zephyr-plugins
diff --git a/package/agent-hbm/agent-hbm.mk b/package/agent-hbm/agent-hbm.mk
new file mode 100644
index 0000000..5e17486
--- /dev/null
+++ b/package/agent-hbm/agent-hbm.mk
@@ -0,0 +1,137 @@
+AGENT_HBM_APP_NAME = hbm
+AGENT_HBM_DEPENDENCIES = host-cmake host-lzop host-lz4
+AGENT_HBM_APP_MODULES = eeprom mbedtls boot_info i2c-indirect soc_init
+
+AGENT_SRC_DIR=$(EMBEDDED_DIR)/zephyr-plugins
+AGENT_MARGIN_TOOL_SRC_DIR=$(AGENT_SRC_DIR)/margin-tools
+AGENT_HBM_SRCDIR=$(AGENT_MARGIN_TOOL_SRC_DIR)/hbm
+AGENT_HBM_SRC_DIR=$(AGENT_MARGIN_TOOL_SRC_DIR)/hbm
+AGENT_HBM_ZEPHYR_SRCDIR=$(EMBEDDED_DIR)/zephyr
+AGENT_HBM_APP_PROD_NAME = zephyr_$(HL_TARGET)_$(AGENT_HBM_APP_NAME)
+AGENT_HBM_DEVICE_NAME = $(firstword $(subst _, ,$(HL_DEV)))
+AGENT_HBM_APP_VERSION = $(shell cut -d- -f2- $(@D)/localversion-habanalabs)
+AGENT_HBM_LOCAL_VERSION = $$(sed "s/^.*fw-\\([0-9]\\+\\.[0-9]\\+\\.[0-9]\\+\\).*$$/\\1/" $(@D)/localversion-habanalabs)
+
+AGENT_HBM_DIR = build-agent-hbm
+
+AGENT_HBM_CONF_APP_EXTRA_CFLAGS = \
+		-include $(EMBEDDED_ROOT)/specs/$(AGENT_HBM_DEVICE_NAME)/$(AGENT_HBM_DEVICE_NAME)_boot_info.h \
+		$(ZEPHYR_CONF_DEV_EXTRA_CFLAGS)
+
+AGENT_HBM_CONF_APP_CFLAGS = \
+		-I$(AGENT_MARGIN_TOOL_SRC_DIR)/common/include \
+		-I$(AGENT_MARGIN_TOOL_SRC_DIR)/common/include/$(HL_DEV) \
+		-I$(AGENT_SRC_DIR)/common/include \
+		-I$(AGENT_SRC_DIR)/common/include/$(HL_DEV)
+
+AGENT_HBM_CONF_OPTS = $(ZEPHYR_CONF_OPTS)
+
+ifdef BR2_arcle
+AGENT_HBM_CONF_OPTS += -DBOARD=hl_$(AGENT_HBM_DEVICE_NAME)_agent_$(HL_TARGET)
+endif
+ifdef BR2_aarch64
+AGENT_HBM_CONF_APP_EXTRA_CFLAGS += -mstrict-align
+AGENT_HBM_CONF_OPTS += -DBOARD=hl_$(AGENT_HBM_DEVICE_NAME)_$(HL_TARGET)
+endif
+
+ifeq ($(HL_TARGET),pldm)
+AGENT_HBM_CONF_APP_EXTRA_CFLAGS = -DTARGET_IS_PLDM
+endif
+
+ifeq ($(HL_TARGET),onix)
+AGENT_HBM_CONF_APP_EXTRA_CFLAGS = -DTARGET_IS_ONIX
+endif
+
+AGENT_HBM_BUILD_DIR = $(@D)
+AGENT_HBM_BUILDDIR = $(@D)
+AGENT_HBM_DIR = $(@D)
+AGENT_HBM_ZEPHYR_BUILD_DIR ?= $(@D)/zephyr
+
+AGENT_HBM_CONF_ENV = CROSS_COMPILE=$(TARGET_CROSS)
+AGENT_HBM_CONF_ENV += ZEPHYR_TOOLCHAIN_VARIANT=cross-compile
+AGENT_HBM_CONF_ENV += ZEPHYR_BASE=$(AGENT_HBM_ZEPHYR_BUILD_DIR)
+
+AGENT_HBM_CONF_OPTS += -UCMAKE_TOOLCHAIN_FILE
+AGENT_HBM_CONF_OPTS += -DUSER_CACHE_DIR=$(@D)/.cache
+AGENT_HBM_CONF_OPTS += -DCMAKE_EXE_LINKER_FLAGS_INIT=-Wl,-e__start
+AGENT_HBM_CONF_OPTS += -DEXTRA_CFLAGS="\
+		-Werror \
+		-Wno-misleading-indentation \
+		$(AGENT_HBM_CONF_APP_EXTRA_CFLAGS)"
+
+AGENT_HBM_CONF_OPTS += -DFAKE_SECURITY=$(FAKE_SECURITY)
+AGENT_HBM_CONF_OPTS += -DBUILD_VERSION="$(AGENT_HBM_APP_VERSION)"
+AGENT_HBM_CONF_OPTS += -DBUILD_MACHINE="$(shell hostname -s)"
+AGENT_HBM_CONF_OPTS += -DCMAKE_C_FLAGS="\
+		-I$(SPECS_EMBEDDED_DIR) \
+		-I$(SPECS_EMBEDDED_DIR)/$(DEV_PREFIX) \
+		-I$(SPECS_ROOT) \
+		-I$(SPECS_EXT_ROOT) \
+		-I$(SPECS_ROOT)/$(DEV_PREFIX)/asic_reg \
+		$(AGENT_HBM_CONF_APP_CFLAGS)"
+
+AGENT_HBM_CONF_OPTS += -DDTS_EXTRA_CPPFLAGS="-I$(SPECS_EMBEDDED_DIR)"
+AGENT_HBM_CONF_OPTS += -DDEVICE=$(AGENT_HBM_DEVICE_NAME)
+AGENT_HBM_CONF_OPTS += -DAPP_NAME=$(AGENT_HBM_APP_PROD_NAME)
+AGENT_HBM_CONF_OPTS += -DAPP_VERSION=$(AGENT_HBM_APP_VERSION)
+AGENT_HBM_WEST_SRC_DIR :=
+AGENT_HBM_WEST_DEST_DIR :=
+
+define AGENT_HBM_COPY_ZEPHYR_SRC
+	rsync -au --chmod=u=rwX,go=rX  --exclude .svn --exclude .git --exclude .hg --exclude .bzr --exclude CVS $(AGENT_HBM_ZEPHYR_SRCDIR) $(AGENT_HBM_BUILD_DIR)
+endef
+
+# Arguments:
+# - module name
+# - component dir
+# - component name
+#
+define AGENT_HBM_DEFINE_MODULE_ENVVARS
+	$(eval MODULE_NAME=$(strip $1))
+	$(eval MODULE_NAME_UPPER_CASE=$(shell echo $(MODULE_NAME) | tr a-z A-Z))
+	$(eval MODULE_NAME_UPPER_CASE=$(strip $(MODULE_NAME_UPPER_CASE)))
+	$(eval $(MODULE_NAME_UPPER_CASE)_SRCDIR=$(EMBEDDED_DIR)/zephyr-modules/$(MODULE_NAME))
+	$(eval $(MODULE_NAME_UPPER_CASE)_DIR=$(@D)/build/modules/$(MODULE_NAME))
+	$(eval $(MODULE_NAME_UPPER_CASE)_NAME=$2_$(MODULE_NAME))
+endef
+
+$(foreach module,$(AGENT_HBM_APP_MODULES),$(call AGENT_HBM_DEFINE_MODULE_ENVVARS,$(module),$(AGENT_HBM_APP_PROD_NAME)))
+
+# Arguments:
+# - module (mbedtls, eeprom, etc.)
+define AGENT_HBM_MODULE_VERSION_HOOK
+	$(eval MODULE_NAME_UPPER_CASE=$(shell echo $1 | tr a-z A-Z))
+	$(eval MODULE_NAME_UPPER_CASE=$(strip $(MODULE_NAME_UPPER_CASE)))
+	$(call HL_VERSION_GEN, ${${MODULE_NAME_UPPER_CASE}_SRCDIR}, ${${MODULE_NAME_UPPER_CASE}_DIR}, ${${MODULE_NAME_UPPER_CASE}_NAME})
+endef
+
+define AGENT_HBM_APP_VERSION_GEN
+	@$(call HL_VERSION_GEN, ${AGENT_HBM_SRCDIR},.,${AGENT_HBM_APP_PROD_NAME})
+	@$(call HL_VERSION_GEN, ${AGENT_HBM_SRCDIR},build,${AGENT_HBM_APP_PROD_NAME})
+	@$(foreach module,$(AGENT_HBM_APP_MODULES),$(call AGENT_HBM_MODULE_VERSION_HOOK,$(module)))
+endef
+
+define AGENT_HBM_CONFIGURE_CMDS
+	$(AGENT_HBM_CONF_ENV) $(HOST_DIR)/bin/cmake $(AGENT_HBM_CONF_OPTS) -S $(AGENT_HBM_BUILD_DIR)/margin-tools/hbm -B $(AGENT_HBM_BUILD_DIR)/build
+endef
+
+AGENT_HBM_POST_RSYNC_HOOKS += HL_VERSION_GEN
+AGENT_HBM_POST_RSYNC_HOOKS += AGENT_HBM_COPY_ZEPHYR_SRC
+AGENT_HBM_POST_RSYNC_HOOKS += AGENT_HBM_APP_VERSION_GEN
+
+define AGENT_HBM_BUILD_CMDS
+	$(TARGET_MAKE_ENV) $(MAKE) -C $(AGENT_HBM_BUILD_DIR)/build
+endef
+
+define AGENT_HBM_INSTALL_TARGET_CMDS
+	@$(INSTALL) -D -m 0644 $(@D)/build/zephyr/zephyr.bin $(BINARIES_DIR)/zephyr_agent_$(AGENT_HBM_APP_NAME).bin
+	@$(INSTALL) -D -m 0644 $(@D)/build/zephyr/zephyr.elf $(BINARIES_DIR)/zephyr_agent_$(AGENT_HBM_APP_NAME).elf
+	@$(INSTALL) -D -m 0644 $(@D)/build/zephyr/zephyr.stat $(BINARIES_DIR)/zephyr_agent_$(AGENT_HBM_APP_NAME).stat
+endef
+
+agent-hbm-configure: $(AGENT_HBM_DEPENDENCIES)
+agent-hbm-menuconfig agent-hbm-guiconfig: | agent-hbm-configure
+	$(TARGET_MAKE_ENV) $(MAKE) -C $(AGENT_HBM_BUILD_DIR)/build
+	rm -f $(AGENT_HBM_BUILD_DIR)/.stamp_{configured,built}
+
+$(eval $(cmake-package))
