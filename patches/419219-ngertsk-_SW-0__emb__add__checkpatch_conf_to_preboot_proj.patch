From 3cefdb5132ee40cf152d4ca9dcfd1b9e1e2c436f Mon Sep 17 00:00:00 2001
From: Nina Gertskin <ngertskin@habana.ai>
Date: Mon, 27 May 2024 14:30:35 +0300
Subject: [PATCH] [SW-0] emb: add .checkpatch.conf to preboot proj

preboot project requires .checkpatch.conf to run checkpatch

Change-Id: Iec133e1b41e84c0ba629ed0424908bdd8c9f475a
Signed-off-by: Nina Gertskin <ngertskin@habana.ai>
---

diff --git a/.checkpatch.conf b/.checkpatch.conf
new file mode 100644
index 0000000..5f7f686
--- /dev/null
+++ b/.checkpatch.conf
@@ -0,0 +1,8 @@
+--ignore GERRIT_CHANGE_ID
+--ignore FILE_PATH_CHANGES
+--ignore CAMELCASE
+--ignore TRAILING_SEMICOLON
+--ignore PREFER_KERNEL_TYPES
+--ignore PRINTK_WITHOUT_KERN_LEVEL
+--ignore LONG_LINE
+--ignore PREFER_SECTION
