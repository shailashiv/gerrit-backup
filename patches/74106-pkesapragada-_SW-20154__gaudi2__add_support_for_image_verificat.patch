diff --git a/gaudi2_arc/dev_security.h b/gaudi2_arc/dev_security.h
index ad70e78..28a618e 100644
--- a/gaudi2_arc/dev_security.h
+++ b/gaudi2_arc/dev_security.h
@@ -8,6 +8,31 @@
 #ifndef _GAUDI2_DEV_SECURITY_H_
 #define _GAUDI2_DEV_SECURITY_H_
 
+#include <sha512.h>
+
+#define NUM_KEYS_IN_ROM					5
+#define NUM_KEYS_IN_EFUSE				3
 #define SECURITY_DWORD_PER_KEY				12
+#define SECURITY_KEY_HASH_COUNT				3
+
+enum security_key_location {
+	KEY_LOCATION_EFUSE,
+	KEY_LOCATION_ROM
+};
+
+/* size of key properties in bytes */
+#define KEY_PROP_RR_SZ  				384
+#define KEY_PROP_MOD_SZ					384
+#define KEY_PROP_EXP_SZ					8
+#define KEY_PROP_INV_SZ					4
+#define KEY_PROP_NB_SZ					4
+#define KEY_PROP_HDR_SZ					8
+
+/* 384 + 384 + 8 + 4 + 4 + 8 = 792 */
+#define TOTAL_PUB_KEY_PROPS_SZ  (KEY_PROP_RR_SZ + KEY_PROP_MOD_SZ + \
+				KEY_PROP_EXP_SZ + KEY_PROP_INV_SZ + \
+				KEY_PROP_NB_SZ + KEY_PROP_HDR_SZ)
+
+extern const uint8_t rom_key_hashes[NUM_KEYS_IN_ROM][SHA384_SUM_LEN];
 
 #endif /* _GAUDI2_DEV_SECURITY_H_ */
