From 9c181c0db12a52484fb8652107960d4542200903 Mon Sep 17 00:00:00 2001
From: Yehuda Levavi <yehuda.levavi@tandemg.com>
Date: Sun, 05 Dec 2021 09:15:40 +0200
Subject: [PATCH] [SW-0] spi: clean xfer code

Clean SPI xfer code from unnecessary comments.

Change-Id: I83765d04912f6a191fe710c091d52bc210aeb8bb
Signed-off-by: Yehuda Levavi <yehuda.levavi@tandemg.com>
---

diff --git a/lib/common/spi.c b/lib/common/spi.c
index 29bdf16..d4a9dc8 100644
--- a/lib/common/spi.c
+++ b/lib/common/spi.c
@@ -343,13 +343,6 @@
 		return -1;
 	}
 
-	/* Start the transaction if necessary. */
-	/* currently we do it at init time in spi driver */
-	/*
-	 * if (flags & SPI_XFER_BEGIN)
-	 *	external_cs_manage(dev, false);
-	 */
-
 	priv.bits_per_word = 8;
 
 	if (rx && tx)
@@ -379,14 +372,6 @@
 	if (spi_readl(priv.ctx, CTRLR0) != cr0)
 		spi_writel(priv.ctx, cr0, CTRLR0);
 
-	/*
-	 * Configure the desired SS (slave select 0...3) in the controller
-	 * The DW SPI controller will activate and deactivate this CS
-	 * automatically. So no cs_activate() etc is needed in this driver.
-	 */
-	// cs = spi_chip_select(dev);
-	// spi_writel(priv.ctx, 1 << cs, DW_SPI_SER);
-
 	/* Enable controller after writing control registers */
 	spi_writel(priv.ctx, 1, SSIENR);
 
@@ -407,11 +392,6 @@
 			       RX_TIMEOUT * 1000)) {
 		ret = -1;
 	}
-
-	/* Stop the transaction if necessary */
-	/* if (flags & SPI_XFER_END)
-	 *	external_cs_manage(dev, true);
-	 */
 
 	return ret;
 }
