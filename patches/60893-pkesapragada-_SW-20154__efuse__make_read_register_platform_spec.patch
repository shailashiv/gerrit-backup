From e7d20f4de98c7c74f369a6530eee92ead1561ad5 Mon Sep 17 00:00:00 2001
From: Pardha Kesapragada <pkesapragada@habana.ai>
Date: Thu, 19 Nov 2020 09:24:41 +0200
Subject: [PATCH] [SW-20154] efuse: make read register platform specific

Efuse register's name has been modified in Gaudi2,
since the backward compatible name for this register
which is "read" has been made a reserved. Hence
it has been changed to "read_ctrl". To make such
usage possible, EFUSE_READ register offset is being
made platform specific and will be updated in the
platform specific files

Change-Id: I00e8c29232ed663157e6f40b41ff0bf7ce2d0a57
Signed-off-by: Pardha Kesapragada <pkesapragada@habana.ai>
---

diff --git a/common/efuse.c b/common/efuse.c
index 909c582..b2088ff 100644
--- a/common/efuse.c
+++ b/common/efuse.c
@@ -31,14 +31,17 @@
 int preboot_fuse_init(void)
 {
 	int i;
+	u32 read_reg;
 
 	if (efuse_init == 1)
 		return -1;
 
-	regmap_writel(1, mmPSOC_EFUSE_READ);
+	read_reg = get_efuse_read_reg();
+
+	regmap_writel(1, read_reg);
 
 	for (i = 0; i < FUSE_RETRIES; i++)
-		if (regmap_readl(mmPSOC_EFUSE_READ))
+		if (regmap_readl(read_reg))
 			udelay(FUSE_DELAY_US);
 		else
 			break;
diff --git a/common/efuse.h b/common/efuse.h
index e4eedc4..b3b1f61 100644
--- a/common/efuse.h
+++ b/common/efuse.h
@@ -16,5 +16,6 @@
 
 int preboot_fuse_init(void);
 int preboot_fuse_read(u32 word, u32 *val);
+u32 get_efuse_read_reg(void);
 
 #endif /* _EFUSE_H_ */
diff --git a/gaudi/common.c b/gaudi/common.c
index 9df3807..ec8c46b 100644
--- a/gaudi/common.c
+++ b/gaudi/common.c
@@ -7,6 +7,7 @@
 
 #include <gaudi_blocks.h>
 #include <psoc_global_conf_regs.h>
+#include <psoc_efuse_regs.h>
 #include <pcie_aux_regs.h>
 #include <pcie_core_regs.h>
 #include <pcie_wrap_regs.h>
@@ -351,3 +352,8 @@
 {
 	preboot_set_enabled_cap(HL_FW_EN_CAPS_HARD_RESET);
 }
+
+u32 get_efuse_read_reg(void)
+{
+	return mmPSOC_EFUSE_READ;
+}
