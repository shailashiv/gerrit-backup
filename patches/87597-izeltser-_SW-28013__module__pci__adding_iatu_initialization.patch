diff --git a/preboot/module_pci.c b/preboot/module_pci.c
index 3d67caa..1bba904 100644
--- a/preboot/module_pci.c
+++ b/preboot/module_pci.c
@@ -12,6 +12,7 @@
 
 #include "cmd_module.h"
 #include "uart.h"
+#include "pci.h"
 
 struct pci_status {
 	u32 flr_reg_val;
@@ -19,6 +20,7 @@
 	u32 smlh_link_reg_val;
 	u32 rdlh_link_reg_val;
 	bool link_is_up;
+	bool mem_enabled;
 };
 
 static struct pci_status pci_sts = {
@@ -27,7 +29,7 @@
 	.smlh_link_reg_val = 1,
 	.rdlh_link_reg_val = 1,
 	.link_is_up = true,
-
+	.mem_enabled = false
 };
 
 __weak void preboot_pcie_exec_hw_wa(void)
@@ -46,6 +48,8 @@
 	regmap_writel(0x10, mmPCIE_CORE_HOT_RST);
 	regmap_writel(1, mmPCIE_AUX_LTSSM_EN);
 }
+
+__weak void hl_pci_iatu_init(void) {}
 
 void module_pci_setup(void)
 {
@@ -67,6 +71,9 @@
 	    pci_sts.link_is_up)
 		return FOUND_FAST_RETURN;
 
+	if (hl_pci_is_mem_enabled() != pci_sts.mem_enabled)
+		return FOUND_FAST_RETURN;
+
 	return NOT_FOUND;
 }
 
@@ -86,6 +93,8 @@
 
 void module_pci_run(void)
 {
+	bool pci_mem_enabled;
+
 	if (pci_sts.flr_reg_val == 1) {
 		regmap_writel(1, mmPCIE_AUX_PF_FLR_ACTIVE);
 		regmap_writel(1, mmPCIE_AUX_FLR_INT);
@@ -109,6 +118,13 @@
 			preboot_puts("down\n");
 		}
 	}
+
+	pci_mem_enabled = hl_pci_is_mem_enabled();
+	if (pci_mem_enabled != pci_sts.mem_enabled) {
+		pci_sts.mem_enabled = pci_mem_enabled;
+		if (pci_mem_enabled)
+			hl_pci_iatu_init();
+	}
 }
 
 void module_pci_enable(void)
