index 1243ae8..aba8975 100644
--- a/gaudi2_arm/common.h
+++ b/gaudi2_arm/common.h
@@ -19,10 +19,19 @@
 #define PPBOOT_TEXT_BASE		0x7FFD000000
 #define PREBOOT_TEXT_BASE		(PPBOOT_TEXT_BASE + PPBOOT_SIZE)
 
+#define CFG_REGION_SIZE			0xC000000
+#define BAR0_RSRVD_SIZE			0x1000000
+
 #define HL_SPI_BASE			0x3FF6000000ull
 #define HL_CFG_BASE			0x3FF8000000ull
 #define SDRAM_BASE			0x7FFD000000ull
 #define FIT_IMG_BASE			0x7FFD200000ull
+#define STM_FLASH_BASE			0x1000007FF4000000ull
+#define BAR0_RSRVD_BASE			0x1000FFFFFC000000ull
+#define DRAM_BASE			0x1001000000000000ull
+
+#define HOST_PHYS_BASE_0		0x0000000000000000ull
+#define HOST_PHYS_SIZE_0		0x0100000000000000ull
 
 #define HL_SP_SRAM_BASE			0x7FF7FE0000ULL
 #define HL_SP_SRAM_SIZE			0x10000
