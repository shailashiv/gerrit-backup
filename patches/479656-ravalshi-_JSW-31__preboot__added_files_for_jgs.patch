+bool hl_is_debug_mode(enum hl_debug_hw_func func)
+{
+	u32 boot_strap = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_BOOT_STRAP_PINS_L));
+	u32 strap_mask;
+
+	switch (func) {
+	case HL_DEBUG_HW_PCIE:
+		strap_mask = PSOC_BOOT_CONF_BOOT_STRAP_PINS_L_BTL_DISABLE_M; /* BTL_DISABLE */
+		break;
+	case HL_DEBUG_HW_DRAM:
+		strap_mask = BIT(10); /* RSVD[1] */
+		break;
+	case HL_DEBUG_HW_I2C:
+		strap_mask = BIT(9); /* RSVD[0] */
+		break;
+	default:
+		LOG_ERR("Unknown H/W function %d", func);
+		return 0;
+	}
+
+	return boot_strap & strap_mask;
+}
