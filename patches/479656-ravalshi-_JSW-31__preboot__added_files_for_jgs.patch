+
+bool preboot_is_valid_address_range(u64 addr, int len)
+{
+	if (addr >= IO0_SP_SRAM_BASE && addr + len < IO0_SP_SRAM_BASE + IO_SP_SRAM_SIZE)
+		return true;
+
+	if (addr >= IO0_SP_SRAM_FULL_BASE && addr + len <= IO0_SP_SRAM_FULL_BASE + IO_SP_SRAM_SIZE)
+		return true;
+
+	if (addr >= IO0_PID_ICCM_FULL_BASE &&
+	    addr + len <= IO0_PID_ICCM_FULL_BASE + IO_PID_ICCM_SIZE)
+		return true;
+
+	if (addr >= IO0_PID_DCCM_FULL_BASE &&
+	    addr + len <= IO0_PID_DCCM_FULL_BASE + IO_PID_DCCM_SIZE)
+		return true;
+
+	if (addr >= IO0_MNG_ICCM_FULL_BASE &&
+	    addr + len <= IO0_MNG_ICCM_FULL_BASE + IO_MNG_ICCM_SIZE)
+		return true;
+
+	if (addr >= IO0_MNG_DCCM_FULL_BASE &&
+	    addr + len <= IO0_MNG_DCCM_FULL_BASE + IO_MNG_DCCM_SIZE)
+		return true;
+
+	if (addr >= IO0_MISC_ICCM_FULL_BASE &&
+	    addr + len <= IO0_MISC_ICCM_FULL_BASE + IO_MISC_ICCM_SIZE)
+		return true;
+
+	if (addr >= IO0_MISC_DCCM_FULL_BASE &&
+	    addr + len <= IO0_MISC_DCCM_FULL_BASE + IO_MISC_DCCM_SIZE)
+		return true;
+
+	if (addr >= IO0_RST_ICCM_FULL_BASE &&
+	    addr + len <= IO0_RST_ICCM_FULL_BASE + IO_RST_ICCM_SIZE)
+		return true;
+
+	if (addr >= IO0_RST_DCCM_FULL_BASE &&
+	    addr + len <= IO0_RST_DCCM_FULL_BASE + IO_RST_DCCM_SIZE)
+		return true;
+
+	if (addr >= IO0_MUC_ICCM_FULL_BASE &&
+	    addr + len <= IO0_MUC_ICCM_FULL_BASE + IO_MUC_ICCM_SIZE)
+		return true;
+
+	if (addr >= IO0_MUC_DCCM_FULL_BASE &&
+	    addr + len <= IO0_MUC_DCCM_FULL_BASE + IO_MUC_DCCM_SIZE)
+		return true;
+
+	LOG_ERR("ERROR: invalid address range addr = 0x%016llx", addr);
+
+	return false;
+}
