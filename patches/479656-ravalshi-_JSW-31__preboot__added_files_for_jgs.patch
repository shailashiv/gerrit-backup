+#define PCI_HBW_ADEC_EN		(BIT(12))
+
+static void init_standalone_routing(void)
+{
+	u32 rtr_b;
+	int i;
+
+	LOG_INF("IO standalone mode datapath config");
+
+	/* config PSOC to STANDALONE communication mode */
+	CFG_WREG32(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_STAND_ALONE_MODE), 1);
+	CFG_WREG32(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_PCIE_STAND_ALONE_MODE), 1);
+
+	/* in standalone IO direct all HBW traffic to PCI */
+	for (i = 0; i < ARRAY_SIZE(io0_rtr_with_sa_switch); i++) {
+		rtr_b = io0_rtr_with_sa_switch[i];
+		CFG_WREG32(rtr_b + mmNOCP_RTR_CFG_SA_HBW_ADEC_MASK_L_12, 0);
+		CFG_WREG32(rtr_b + mmNOCP_RTR_CFG_SA_HBW_ADEC_MASK_H_12, 0);
+		CFG_WREG32(rtr_b + mmNOCP_RTR_CFG_SA_HBW_ADEC_BASE_L_12, 0);
+		CFG_WREG32(rtr_b + mmNOCP_RTR_CFG_SA_HBW_ADEC_BASE_H_12, 0);
+		CFG_WREG32(rtr_b + mmNOCP_RTR_CFG_SA_HBW_ADEC_EN, PCI_HBW_ADEC_EN);
+	}
+}
