+
+__weak int get_bmu_development_phase(enum bmu_phase *dev_phase)
+{
+	*dev_phase = BMU_PRODUCTION_MODE;
+
+	return 0;
+}
+
+static int get_bmu_configs(struct bmu_configs *conf)
+{
+	int err;
+	uint32_t val;
+
+	conf->hbm_size_mb = get_hbm_size();
+	val = CFG_RREG32(IO0_H0_PCIE_DBI(mmPCIE_DBI_SRIOV_NUM_VFS)) & PCIE_DBI_SRIOV_NUM_VFS_VAL_M;
+	switch (val) {
+	case 0:
+		conf->sriov = BMU_1PF_MODE;
+		break;
+	case 1:
+		conf->sriov = BMU_1PF_1VF_MODE;
+		break;
+	case 4:
+		conf->sriov = BMU_1PF_4VF_MODE;
+		break;
+	default:
+		LOG_ERR("unsupported sriov mode num_vf=%d", val);
+		return -1;
+	}
+
+	err = get_bmu_development_phase(&conf->phase);
+
+	return err;
+}
+
+void hl_pci_bmu_init(void)
+{
+	int err;
+	struct bmu_configs conf;
+
+	err = get_bmu_configs(&conf);
+	if (err) {
+		LOG_ERR("bmu configs not valid, skipping BMU init");
+		return;
+	}
+
+	err = fs1_bmu_init(&conf);
+
+	/* if configuration is valid, enable the BMUs */
+	if (!err) {
+		CFG_RMWREG32(IO0_H0_BMU_CFG(mmBMU_CFG_BMU), 1, BMU_CFG_BMU_EN_M);
+		CFG_RMWREG32(IO0_H0_BMU_MEM(mmBMU_CFG_BMU), 1, BMU_CFG_BMU_EN_M);
+	}
+}
