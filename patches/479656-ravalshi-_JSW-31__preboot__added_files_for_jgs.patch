+u32 _dev_spec_get_img_desc(struct hl_fw_img_desc *img_desc, enum fw_post_reset_cmd upd_status,
+			  enum img_idx sel_idx_mode, struct boot_desc *desc)
+{
+	/* TODO: use stable index when bootinfo implementation is final in arcboot */
+	desc->spi_offset = img_desc->spi_offset[0];
+	desc->img_size = img_desc->size;
+	desc->loadaddr = ((u64)img_desc->load_high << 32) | img_desc->load_low;
+	desc->desc_ver = img_desc->desc_ver;
+	desc->crc32 = img_desc->crc32;
+	memcpy(desc->chksum, img_desc->chksum, ARRAY_SIZE(desc->chksum));
+
+	return 0;
+}
