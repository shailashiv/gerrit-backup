diff --git a/arch/jgs/arc/palad.c b/arch/jgs/arc/palad.c
new file mode 100644
index 0000000..02bbc18
--- /dev/null
+++ b/arch/jgs/arc/palad.c
@@ -0,0 +1,258 @@
+// SPDX-License-Identifier:     Apache-2.0
+/*
+ * (C) Copyright 2025 Intel, Ltd.
+ */
+
+#include <axi_drain_wrap_regs.h>
+#include <axi_drain_wrap_masks.h>
+#include <arc_local_conf_regs.h>
+#include <arc_local_conf_masks.h>
+#include <pcie_dbi_regs.h>
+#include <pcie_dbi_masks.h>
+#include <pcie_aux_regs.h>
+#include <pcie_aux_masks.h>
+#include <pcie_core_regs.h>
+#include <pcie_core_masks.h>
+#include <pcie_flr_regs.h>
+#include <psoc_boot_conf_regs.h>
+#include <psoc_boot_conf_masks.h>
+#include <fs1_blocks_linux_driver.h>
+
+#include <address_space.h>
+#include <preboot.h>
+#include <hl_device.h>
+#include <hl_platform_defs.h>
+#include "hl.h"
+#include <hl_boot_info.h>
+#include <fs1_reg_map.h>
+#include <fs1_efuse.h>
+#include <efuse.h>
+#include <hl_pcie.h>
+
+#define LOG_LEVEL CONFIG_LOG_DEFAULT_LEVEL
+#include <zephyr/logging/log.h>
+
+LOG_MODULE_REGISTER(hl_preboot_palad);
+
+/* timestamp fed with constand ref_clk/2 */
+#define TS_CLOCK_FREQUENCY	25000000ULL
+
+#define UART_CLOCK_FREQUENCY	SYS_CLOCK_FREQUENCY
+#define PALAD_UART_BAUDRATE	300
+
+
+u64 hl_pll_timestamp_freq_get(void)
+{
+	return TS_CLOCK_FREQUENCY;
+}
+
+void hl_dev_ts_init(void)
+{
+	/* TODO: implement ts init for JGS */
+}
+
+void hl_ts_shutdown(void)
+{
+	/* TODO: implement ts shutdown for JGS */
+}
+
+#define DRAIN_STAMP_ENA_MASK	(AXI_DRAIN_WRAP_RSP_ERR_DRAIN_STAMP_RD_EN_M | \
+				 AXI_DRAIN_WRAP_RSP_ERR_DRAIN_STAMP_WR_EN_M)
+
+static void hl_psoc_drain_init(void)
+{
+	/* psoc drain is enabled by default, enable drain address stamp logging */
+	CFG_WREG32(mmIO_0_CFG_HALF_0_PSOC_PARC_CFG_MISC_DRAIN_HBW_BASE +
+		   mmAXI_DRAIN_WRAP_RSP_ERR_DRAIN_STAMP, DRAIN_STAMP_ENA_MASK);
+	CFG_WREG32(mmIO_0_CFG_HALF_0_PSOC_PARC_CFG_MISC_DRAIN_LBW_BASE +
+		   mmAXI_DRAIN_WRAP_RSP_ERR_DRAIN_STAMP, DRAIN_STAMP_ENA_MASK);
+}
+
+
+#define EARLY_WRITE_RESP_MASK	(ARC_LOCAL_CONF_ARC_LBU_AXI_SPLIT_CTRL2_FORCE_WR_BUF_M |	\
+				 1 << ARC_LOCAL_CONF_ARC_LBU_AXI_SPLIT_CTRL2_AWCACHE_OVRD_EN_S |\
+				 1 << ARC_LOCAL_CONF_ARC_LBU_AXI_SPLIT_CTRL2_ARCACHE_OVRD_EN_S)
+
+static void hl_lbw_early_write_resp_enable(void)
+{
+	u32 val;
+
+	val = CFG_RREG32(mmIO_0_CFG_HALF_0_PSOC_ARC_MNG_LOCAL_BASE +
+			 mmARC_LOCAL_CONF_ARC_LBU_AXI_SPLIT_CTRL2);
+	val |= EARLY_WRITE_RESP_MASK;
+	CFG_WREG32(mmIO_0_CFG_HALF_0_PSOC_ARC_MNG_LOCAL_BASE +
+		   mmARC_LOCAL_CONF_ARC_LBU_AXI_SPLIT_CTRL2, val);
+}
+
+static bool is_cxl_mode(void)
+{
+	u32 val;
+
+	val = CFG_RREG32(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_BOOT_STRAP_PINS_H));
+	val &= PSOC_BOOT_CONF_BOOT_STRAP_PINS_H_CXL_MODE_M;
+
+	return !!val;
+}
+
+#define SRIOV_MAX_NUM_VFS	4
+#define SRIOV_DEFAULT_NUM_VFS	1
+
+static void palad_pcie_dynamic_init(void)
+{
+	bool cxl_mode = is_cxl_mode();
+	u32 pci_efuse_cfg;
+	u8 num_vf = 0;
+	u32 val;
+
+	preboot_fuse_read(IO_EFUSE_PALAD_CFG_0_OFFSET, &pci_efuse_cfg);
+	LOG_INF("efuse pci cfg = 0x%x", pci_efuse_cfg);
+
+	if (pci_efuse_cfg & CRS_MODE_ENABLED_M) {
+		/* Set SNNP EP into CRS mode */
+		CFG_RMWREG32(IO0_H0_PCIE_CORE(mmPCIE_CORE_RN), 0, PCIE_CORE_RN_APP_DRS_READY_M);
+		CFG_WREG32(IO0_H0_PCIE_FLR(mmPCIE_FLR_APP_REQ_RETRY_EN), BIT(0));
+		/* TODO: Need to configure APP_PF_REQ_RETRY_EN, APP_VF_REQ_RETRY_EN (SRIOV mode) */
+		LOG_INF("CRS mode enabled in SNPS EP");
+	}
+
+	if (cxl_mode) {
+		LOG_INF("cxl mode");
+		/* CXL capability is enabled as reset default */
+
+		/* disable CXL.Cache capability if required */
+		if (!(pci_efuse_cfg & CXL_CACHE_CAP_ENABLED_M)) {
+			CFG_RMWREG32(
+				IO0_H0_PCIE_DBI(mmPCIE_DBI_CXL_RCRB_DVSEC_HDR_2_FLEXBUS_CAP_OFF),
+				0, PCIE_DBI_CXL_RCRB_DVSEC_HDR_2_FLEXBUS_CAP_OFF_CACHE_CAP_M);
+			CFG_RMWREG32(
+				IO0_H0_PCIE_DBI(mmPCIE_DBI_CXL_RCIEP_DVSEC_HDR_2_FLEXBUS_CAP_OFF),
+				0, PCIE_DBI_CXL_RCIEP_DVSEC_HDR_2_FLEXBUS_CAP_OFF_CACHE_CAP_M);
+		}
+	} else { /* pci mode */
+		LOG_INF("pci mode");
+		/* switch to PCI mode by disabling Alternative Protocol Support */
+		CFG_RMWREG32(IO0_H0_PCIE_DBI(mmPCIE_DBI_PL32G_CAPABILITY_REG), 0,
+			     PCIE_DBI_PL32G_CAPABILITY_REG_MOD_TS_ALT_PROTOCOL_SUPPORT_M);
+
+		/* set number of VFs */
+		num_vf = pci_efuse_cfg & SRIOV_NUM_OF_VFS_M;
+		if (num_vf > SRIOV_MAX_NUM_VFS) {
+			num_vf = SRIOV_DEFAULT_NUM_VFS;
+			LOG_WRN("VF exceeds 4, using default of 1 VF");
+		}
+
+		val = num_vf << PCIE_DBI_TOTAL_VFS_INITIAL_VFS_REG_SRIOV_INITIAL_VFS_S |
+		      num_vf << PCIE_DBI_TOTAL_VFS_INITIAL_VFS_REG_SRIOV_TOTAL_VFS_S;
+		CFG_WREG32(IO0_H0_PCIE_DBI(mmPCIE_DBI_TOTAL_VFS_INITIAL_VFS_REG), val);
+		CFG_RMWREG32(IO0_H0_PCIE_DBI(mmPCIE_DBI_FLIT_INJECT_CAP_HDR_REG),
+			     mmPCIE_DBI_RESBAR_CAP_HDR_REG,
+			     PCIE_DBI_FLIT_INJECT_CAP_HDR_REG_FNEXT_OFFSET_M);
+	}
+
+	/* skip ATS capability */
+	if (!(pci_efuse_cfg & ATS_CAPABILITY_ENABLED_M)) {
+		val = CFG_RREG32(IO0_H0_PCIE_DBI(mmPCIE_DBI_SRIOV_BASE_REG));
+		val &= ~PCIE_DBI_SRIOV_BASE_REG_SRIOV_NEXT_OFFSET_M;
+		val |= mmPCIE_DBI_LTR_CAP_HDR_REG <<
+			PCIE_DBI_SRIOV_BASE_REG_SRIOV_NEXT_OFFSET_S;
+		CFG_WREG32(IO0_H0_PCIE_DBI(mmPCIE_DBI_SRIOV_BASE_REG), val);
+	}
+}
+
+#define BAR_SIZE_1GB		(SZ_1G - 1)
+#define VF_RES_BAR_SIZES	(PCIE_DBI_VF_RESBAR_CAP_REG_2_REG_V512GB_M | \
+				 PCIE_DBI_VF_RESBAR_CAP_REG_2_REG_V256GB_M | \
+				 PCIE_DBI_VF_RESBAR_CAP_REG_2_REG_V128GB_M | \
+				 PCIE_DBI_VF_RESBAR_CAP_REG_2_REG_V64GB_M)
+
+static void palad_pcie_params_init(void)
+{
+	/* enable writing to DBI RO regs */
+	CFG_RMWREG32(IO0_H0_PCIE_DBI(mmPCIE_DBI_MISC_CONTROL_1_OFF), 1,
+		     PCIE_DBI_MISC_CONTROL_1_OFF_DBI_RO_WR_EN_M);
+
+	/* switch to shadow registers access in order to set BAR masks */
+	CFG_WREG32(mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_DBI, PCIE_AUX_DBI_CS2_M);
+
+	/* set PF CFG BAR to 1GB */
+	CFG_WREG32(IO0_H0_PCIE_DBI(mmPCIE_DBI_BAR0_REG), BAR_SIZE_1GB);
+	CFG_WREG32(IO0_H0_PCIE_DBI(mmPCIE_DBI_BAR1_REG), 0);
+
+	/* set SRIOV CFG BAR to 1GB */
+	CFG_WREG32(IO0_H0_PCIE_DBI(mmPCIE_DBI_SRIOV_BAR0_REG), BAR_SIZE_1GB);
+	CFG_WREG32(IO0_H0_PCIE_DBI(mmPCIE_DBI_SRIOV_BAR1_REG), 0);
+
+	/* disable shadow registers access */
+	CFG_WREG32(mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_DBI, 0);
+
+	/* set VF resizable BAR #2 allowed size */
+	CFG_WREG32(IO0_H0_PCIE_DBI(mmPCIE_DBI_VF_RESBAR_CAP_REG_2_REG), VF_RES_BAR_SIZES);
+
+	palad_pcie_dynamic_init();
+
+	/* disable writing to DBI RO regs */
+	CFG_RMWREG32(IO0_H0_PCIE_DBI(mmPCIE_DBI_MISC_CONTROL_1_OFF), 0,
+		     PCIE_DBI_MISC_CONTROL_1_OFF_DBI_RO_WR_EN_M);
+}
+
+#define LTTSM_ENA_MASK	(PCIE_AUX_LTSSM_EN_IND_M | PCIE_AUX_LTSSM_EN_MASK_M)
+
+static void hl_palad_pcie_init(void)
+{
+	u32 smlh = CFG_RREG32(pci.aux_smlh_link_up_reg);
+	u32 rdlh = CFG_RREG32(pci.aux_rdlh_link_up_reg);
+
+	/* if link is up, nothing more to do */
+	if (smlh && rdlh)
+		return;
+
+	palad_pcie_params_init();
+
+	CFG_WREG32(mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_LTSSM_EN, LTTSM_ENA_MASK);
+
+	/* release request retry so the host can access pci config space */
+	CFG_WREG32(IO0_H0_PCIE_FLR(mmPCIE_FLR_APP_REQ_RETRY_EN), 0);
+	CFG_WREG32(IO0_H0_PCIE_FLR(mmPCIE_FLR_APP_PF_REQ_RETRY_EN), 0);
+	CFG_WREG32(IO0_H0_PCIE_FLR(mmPCIE_FLR_APP_VF_REQ_RETRY_EN), 0);
+}
+
+void preboot_plat_early_init(void)
+{
+	hl_psoc_drain_init();
+	hl_lbw_early_write_resp_enable();
+	hl_palad_pcie_init();
+}
+
+void module_fwupd_dev_spec_shutdown(void) {}
+void module_oob_fwupd_dev_spec_shutdown(void) {}
+
+void preboot_security_init(void)
+{
+}
+
+int get_bmu_development_phase(enum bmu_phase *dev_phase)
+{
+	uint32_t efuse_cfg;
+
+	preboot_fuse_read(IO_EFUSE_PALAD_CFG_0_OFFSET, &efuse_cfg);
+
+	if (efuse_cfg & BMU_INIT_PROD_MODE) {
+		*dev_phase = BMU_PRODUCTION_MODE;
+		LOG_INF("BMU production mode");
+	} else if (efuse_cfg & BMU_INIT_DEVEL_MODE) {
+		*dev_phase = BMU_PRODUCTION_MODE;
+		LOG_INF("BMU development mode");
+	} else {
+		LOG_INF("BMU init disabled, skipping");
+		return -1;
+	}
+
+	return 0;
+}
+
+
+/* In order to improve fit image loading time on palad, the hash calculation is skipped */
+int fit_node_check_hash(const void *fit, int node, const u8 *buf, int len, void *hash)
+{
+	return 0;
+}
