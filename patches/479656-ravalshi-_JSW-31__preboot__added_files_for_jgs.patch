diff --git a/arch/jgs/arc/memory_dev.h b/arch/jgs/arc/memory_dev.h
new file mode 100644
index 0000000..44d1ecb
--- /dev/null
+++ b/arch/jgs/arc/memory_dev.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier:     Apache-2.0
+ *
+ * Copyright (C) 2025 Intel Ltd.
+ */
+
+#ifndef ARCH_FS1_MEMORY_DEV_H_
+#define ARCH_FS1_MEMORY_DEV_H_
+
+extern int _image_ram_end; /* linker symbol, the end of the memory occupied by preboot */
+
+/*
+ * the following macro is taken from the FS1 linker file at zephyr/soc/arc/hl/fs1/linker.ld
+ * please handle changes with care and sync with the linker file.
+ */
+#if defined(CONFIG_PREBOOT_RUN_FROM_ICCM)
+	#if DT_NODE_HAS_PROP(DT_INST(0, arc_iccm), reg) && \
+		(DT_REG_SIZE(DT_INST(0, arc_iccm)) > 0)
+	#define SRAM_START		DT_REG_ADDR(DT_INST(0, arc_iccm))
+	#define SRAM_SIZE		(DT_REG_SIZE(DT_INST(0, arc_iccm)) * SZ_1K)
+	#endif
+#else
+	/* SRAM base address and size */
+	#if DT_NODE_HAS_PROP(DT_INST(0, mmio_sram), reg) && \
+		(DT_REG_SIZE(DT_INST(0, mmio_sram)) > 0)
+		#if DT_NODE_HAS_PROP(DT_NODELABEL(bootinfo_partition), reg) && \
+			(DT_REG_ADDR(DT_NODELABEL(bootinfo_partition)) == 0)
+			#define SRAM_START	(DT_REG_ADDR(DT_INST(0, mmio_sram)) + \
+				(DT_REG_SIZE(DT_NODELABEL(bootinfo_partition)) * SZ_1K))
+			#define SRAM_SIZE	((DT_REG_SIZE(DT_INST(0, mmio_sram)) - \
+				DT_REG_SIZE(DT_NODELABEL(bootinfo_partition))) * SZ_1K)
+		#else
+			#define SRAM_START	DT_REG_ADDR(DT_INST(0, mmio_sram))
+			#define SRAM_SIZE	(DT_REG_SIZE(DT_INST(0, mmio_sram)) * SZ_1K)
+		#endif
+	#endif
+#endif
+
+/* default heap is allocated right after preboot app */
+#define MEM_HEAP_BASE	((unsigned int)&_image_ram_end)
+#define MEM_HEAP_SZ	(SRAM_SIZE - ((unsigned int)&_image_ram_end - SRAM_START))
+
+#endif /* ARCH_GAUDI2_MEMORY_DEV_H_ */
