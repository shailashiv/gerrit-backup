 #define ARC_RST_VALUE			0x110
 #define ARC_RST_VEC_ADDR		0x0
+#define ARC_HALT_ACK_RETRIES		10
 #define ARC0_MEM_SIZE			(ARC0_ICCM_SIZE + ARC0_DCCM_SIZE)
 #define ARC1_MEM_SIZE			(ARC1_ICCM_SIZE + ARC1_DCCM_SIZE)
 
 #define HL_PCIE_LINK_RETRIES		50
 #define HL_INIT_SP_SRAM_RETRIES		50
 
-/*
- * Set ARCs in halt state before reset
- * 1. Set halt bit in RUN_HALT_REQ register
- * 2. Clear halt bit in RUN_HALT_REQ register
- * 3. Set Reset bit
- */
-#define HALT_N_RESET_ARC(id)						 \
-	do {								 \
-		regmap_writel(BIT(1), mmPSOC_ARC##id##_CFG_RUN_HALT_REQ);\
-		regmap_writel(0x0, mmPSOC_ARC##id##_CFG_RUN_HALT_REQ);	 \
-		regmap_writel(0x1, mmPSOC_ARC##id##_CFG_ARC_RST);	 \
-	} while (0)
 /*
  * Set ARC in running state
  * 1. Set run bit in RUN_HALT_REQ register
