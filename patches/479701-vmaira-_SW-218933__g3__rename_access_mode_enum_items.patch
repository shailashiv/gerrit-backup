From 45a8638333be3473527a2117db79fb95f21955dc Mon Sep 17 00:00:00 2001
From: Varsha Maira <vmaira@habana.ai>
Date: Tue, 13 May 2025 22:16:16 +0300
Subject: [PATCH] [SW-218933] g3: rename access mode enum items

The mem_access_mode enum is currently defined in multiple apps —
preboot_rtos, preboot, and zephyr-plugins. To eliminate code duplication,
it will be moved to the specs folder.

This patch renames the existing enum items to avoid conflicts and ensure
CI passes when the enum is added to the specs folder in a subsequent patch

Change-Id: I23892eb87e1a8e14051d99668ee2e285d46cb8f9
Signed-off-by: Varsha Maira <vmaira@habana.ai>
---

diff --git a/arch/gaudi2/common/security.c b/arch/gaudi2/common/security.c
index b45e1a1..c2f9dec 100644
--- a/arch/gaudi2/common/security.c
+++ b/arch/gaudi2/common/security.c
@@ -603,15 +603,15 @@
 	/* Finally open the image memory space */
 	cfg = &preboot_sec_dyn_cfg[IMAGE];
 	switch (mode) {
-	case ACCESS_RO:
+	case MEM_ACCESS_RO:
 		/* Open IMAGE region in read only mode */
 		hl_secure_dyn_rr_cfg(HL_SEC_HBW_SRAM_RO, cfg->min, cfg->max);
 		break;
-	case ACCESS_RW:
+	case MEM_ACCESS_RW:
 		/* Open IMAGE region read-only RR if closed already */
 		hl_secure_dyn_rr_cfg(HL_SEC_HBW_SRAM_RO, 0, 0);
 		break;
-	case ACCESS_WR: /* write-only not possible in gaudi2 */
+	case MEM_ACCESS_WR: /* write-only not possible in gaudi2 */
 	default:
 		LOG_ERR("dynamic_image_sram_open with invalid mode: %d", mode);
 		return;
diff --git a/arch/gaudi3/common/security.c b/arch/gaudi3/common/security.c
index 76d133c..da9c5b8 100644
--- a/arch/gaudi3/common/security.c
+++ b/arch/gaudi3/common/security.c
@@ -390,7 +390,7 @@
 	 * RR5 is used to enforce the write protection on the SRAM region dynamically
 	 * opened to the host, as it is exposed with read-only (RO) permissions.
 	 */
-	if (mode == ACCESS_RO) {
+	if (mode == MEM_ACCESS_RO) {
 		min = image_base_full;
 		max = img_max;
 		hl_secure_dyn_rr_cfg(HL_SEC_HBW_RR_5, image_base_full, img_max, HL_SEC_WR_PROT);
diff --git a/include/security.h b/include/security.h
index 70340e7..0db74c1 100644
--- a/include/security.h
+++ b/include/security.h
@@ -18,9 +18,9 @@
 };
 
 enum preboot_mem_access_mode {
-	ACCESS_RO,
-	ACCESS_WR,
-	ACCESS_RW,
+	MEM_ACCESS_RO,
+	MEM_ACCESS_WR,
+	MEM_ACCESS_RW,
 };
 
 bool preboot_security_is_enabled(void);
diff --git a/lib/module/module_fwupd.c b/lib/module/module_fwupd.c
index ebff4b1..f182043 100644
--- a/lib/module/module_fwupd.c
+++ b/lib/module/module_fwupd.c
@@ -282,7 +282,7 @@
 		 */
 		if (state->use_security && status.offset && state->wfc_cmd.cmd != HL_UPD_MAP_SRAM)
 			preboot_security_dynamic_img_sram_open((uintptr_t)state->map_offset,
-							       state->map_size, ACCESS_RO);
+							       state->map_size, MEM_ACCESS_RO);
 	}
 
 	state->sts_writel(status.val);
@@ -563,7 +563,7 @@
 
 	if (state->use_security) {
 		if (cmd == HL_UPD_MAP_SRAM)
-			preboot_security_dynamic_img_sram_open(base_offset, size, ACCESS_RW);
+			preboot_security_dynamic_img_sram_open(base_offset, size, MEM_ACCESS_RW);
 		else
 			preboot_security_dynamic_img_elbi_reg_open();
 	}
diff --git a/lib/module/module_lkd.c b/lib/module/module_lkd.c
index 5479d50..20d6def 100644
--- a/lib/module/module_lkd.c
+++ b/lib/module/module_lkd.c
@@ -467,7 +467,7 @@
 
 	*offset = lkd_dev_spec_get_desc_offset(sts.mem_base);
 
-	preboot_security_dynamic_img_sram_open(sts.mem_base, sts.mem_size, ACCESS_RW);
+	preboot_security_dynamic_img_sram_open(sts.mem_base, sts.mem_size, MEM_ACCESS_RW);
 
 	if (sts.is_elbi_desc) {
 		preboot_security_dynamic_img_elbi_reg_open();
