From d78ca89be74ae1e78c3cf5e0a8fc58200e35ff79 Mon Sep 17 00:00:00 2001
From: Guy Nisan <gnisan@habana.ai>
Date: Tue, 23 Jan 2024 07:58:14 +0200
Subject: [PATCH] [SW-171566] agents: set endianess to dev spec its

Device specific ITS used as template + set endianess

Change-Id: Ic922cc302b6191ed9d413a7b91c07aa3dc1c96a7
Signed-off-by: Guy Nisan <gnisan@habana.ai>
---

diff --git a/board/habanalabs/common/post-image-agents.sh b/board/habanalabs/common/post-image-agents.sh
index e861c20..9afc8bd 100755
--- a/board/habanalabs/common/post-image-agents.sh
+++ b/board/habanalabs/common/post-image-agents.sh
@@ -128,6 +128,14 @@
 		fi
 		ITS_SED_BIN_PARAMS+="s#@HL_AGENT_FW_BIN@#${AGENT_FW_NAME}#g;"
 		ITS_SED_BIN_PARAMS+="s#@HL_AGENT_ADDITIONAL_LOADABLES@#${HL_AGENT_ADDITIONAL_LOADABLES}#g"
+
+		AGENTS_ITS_SPEC_TEMPLATE=${BR2_EXTERNAL}/board/habanalabs/${HL_DEV}/agent-${AGENT_NAME}.its
+		AGENTS_ITS_SPEC_FILE=agent-${AGENT_NAME}-${HL_DEV}.its
+		if [ -f ${AGENTS_ITS_SPEC_TEMPLATE} ]; then
+			sed ${ITS_SED_PARAMS}${ITS_SED_BIN_PARAMS} ${AGENTS_ITS_SPEC_TEMPLATE} > ${AGENTS_ITS_SPEC_FILE}
+			ITS_SED_PARAMS+="s#@DEV_SPEC_ITS@#${PWD}/${AGENTS_ITS_SPEC_FILE}#g;"
+		fi
+
 		sed ${ITS_SED_PARAMS}${ITS_SED_BIN_PARAMS} ${AGENT_ITS_TEMPLATE} > ${AGENT_ITS_FILE}
 		${GCC_ARC} -nostdinc -I include -undef -x assembler-with-cpp -P -E ${AGENT_ITS_FILE} > ${AGENT_ITS_FILE}.post
 		${HOST_DIR}/usr/bin/mkimage -D "-W no-unit_address_vs_reg" -f ${AGENT_ITS_FILE}.post -k ${KEYS_DIR} ${AGENT_ITB_FILE}
diff --git a/board/habanalabs/gaudi2/post-image-agents.sh b/board/habanalabs/gaudi2/post-image-agents.sh
index 9550e67..74fb2f0 100755
--- a/board/habanalabs/gaudi2/post-image-agents.sh
+++ b/board/habanalabs/gaudi2/post-image-agents.sh
@@ -30,7 +30,6 @@
 # Set hl-*-version = "hl-<device>-<HL_VERSION>[-rc]-fw-<fw ver>[-<git data>]"; inside FIT header
 HL_UBOOT_VERSION=`cut -d- -f2- ${BASE_DIR}/build/uboot-custom/localversion-habanalabs`
 
-GAUDI2_SPEC_FW_LOADER_ITS=$(ls ${BR2_EXTERNAL}/board/habanalabs/${HL_DEV}/agent-fw_loader.its)
 ITS_SED_PARAMS+="s/@HL_PREBOOT_VERSION_SECUREBOOT@/${HL_PREBOOT_VERSION_SECUREBOOT}/g;"
 ITS_SED_PARAMS+="s/@HL_PPBOOT_VERSION_SECUREBOOT@/${HL_PPBOOT_VERSION_SECUREBOOT}/g;"
 ITS_SED_PARAMS+="s/@ENDIANNESS@/${ENDIANNESS}/g;"
@@ -46,7 +45,6 @@
 ITS_SED_PARAMS+="s/@PREBOOT_BIN@/preboot-arc/g;"
 ITS_SED_PARAMS+="s/@DEV_PREFIX@/${DEV_PREFIX}/g;"
 ITS_SED_PARAMS+="s/@FW_LOADER_CONF_LOADABLES@/${LOADABLES}/g;"
-ITS_SED_PARAMS+="s#@DEV_SPEC_ITS@#${GAUDI2_SPEC_FW_LOADER_ITS}#g;"
 
 AGENT_NIC_FW_FILE=${BR2_EXTERNAL}/board/habanalabs/${HL_DEV}/fw/condor.fw.bin
 AGENT_SERDES_FW_NAME=zephyr_agentfw_serdes.bin
diff --git a/board/habanalabs/gaudi3_arc/agent-fw_loader.its b/board/habanalabs/gaudi3_arc/agent-fw_loader.its
index 1e4c356..bab004b 100644
--- a/board/habanalabs/gaudi3_arc/agent-fw_loader.its
+++ b/board/habanalabs/gaudi3_arc/agent-fw_loader.its
@@ -7,7 +7,7 @@
 	images {
 		pif-iccm {
 			description = "Habana PIF ARC iccm fw content";
-			data = /incbin/("gaudi3-pcie_pif-iccm.bin.be");
+			data = /incbin/("gaudi3-pcie_pif-iccm.bin.@ENDIANNESS@");
 			type = "standalone";
 			arch = "arc";
 			compression = "none";
@@ -19,7 +19,7 @@
 
 		pif-dccm {
 			description = "Habana PIF ARC dccm fw content";
-			data = /incbin/("gaudi3-pcie_pif-dccm.bin.be");
+			data = /incbin/("gaudi3-pcie_pif-dccm.bin.@ENDIANNESS@");
 			type = "standalone";
 			arch = "arc";
 			compression = "none";
@@ -31,7 +31,7 @@
 
 		preboot_d1 {
 			description = "Habana die 1 Preboot";
-			data = /incbin/("gaudi3-preboot_d1.bin.be");
+			data = /incbin/("gaudi3-preboot_d1.bin.@ENDIANNESS@");
 			type = "standalone";
 			arch = "arc";
 			compression = "none";
diff --git a/board/habanalabs/gaudi3_arc/post-image-agents.sh b/board/habanalabs/gaudi3_arc/post-image-agents.sh
index c9cd657..6e09999 100644
--- a/board/habanalabs/gaudi3_arc/post-image-agents.sh
+++ b/board/habanalabs/gaudi3_arc/post-image-agents.sh
@@ -24,7 +24,6 @@
 BIN=${BR2_EXTERNAL}/output/${HL_DEV}/build/zephyr-custom/build-agent-fw-loader/zephyr/zephyr*.bin
 GAUDI3_AGENT_BIN=$(ls ${BIN} 2>/dev/null)
 GAUDI3_AGENT_STAT=$(echo $GAUDI3_AGENT_BIN | sed 's/\.bin/.stat/')
-GAUDI3_SPEC_FW_LOADER_ITS=$(ls ${BR2_EXTERNAL}/board/habanalabs/${HL_DEV}/agent-fw_loader.its)
 # Extract the load address and start address from stat file
 GAUDI3_LOADADDR=$(cat $GAUDI3_AGENT_STAT | grep LOAD | head -1 | awk '{ print $3 }')
 ENTRY_ADDRESS=$(cat $GAUDI3_AGENT_STAT | grep "Entry point address" | head -1)
@@ -48,7 +47,6 @@
 ITS_SED_PARAMS+="s/@PPBOOT_BIN@/ppboot-pcie_phy_fw/g;"
 ITS_SED_PARAMS+="s/@PREBOOT_BIN@/preboot/g;"
 ITS_SED_PARAMS+="s/@FW_LOADER_CONF_LOADABLES@/${LOADABLES}/g;"
-ITS_SED_PARAMS+="s#@DEV_SPEC_ITS@#${GAUDI3_SPEC_FW_LOADER_ITS}#g;"
 
 function handle_fw_copy {
 	return
