From a2deb71ca9d7924c0a4cbcadfab7fecb3a2847cc Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Mon, 11 Jan 2021 18:39:44 +0200
Subject: [PATCH] [SW-20719] gaudi: raise sram section size

To FIT the HBM init runtime code we are forced to raise the SRAM section
size.
Raise it to 64KB.

Change-Id: Ie665827c4a4e0040304cb0bc99727c4d92425b63
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/gaudi/common.h b/gaudi/common.h
index cc43c31..e9cfa4f 100644
--- a/gaudi/common.h
+++ b/gaudi/common.h
@@ -8,7 +8,7 @@
 #define COMMON_GAUDI_H_
 
 #define PPBOOT_SIZE			0x4000		/* 16KB */
-#define PREBOOT_SIZE			0xD000		/* 52KB */
+#define PREBOOT_SIZE			0x10000		/* 64KB */
 #define SRAM_SIZE			0x1400000	/* 20MB */
 
 #define HL_SP_SRAM_BASE			0x7FFBFE0000
