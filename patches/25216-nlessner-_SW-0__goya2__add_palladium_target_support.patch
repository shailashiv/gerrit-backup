From 4100a071fd05dd98593bef1e32bd1ca9b00d38e7 Mon Sep 17 00:00:00 2001
From: Noam Lessner <nlessner@habana.ai>
Date: Thu, 09 Jan 2020 17:00:37 +0200
Subject: [PATCH] [SW-0] goya2: add palladium target support

add support for target palladium in preboot

Change-Id: I9434242be991c4c98d86c12baf210fb139a21528
Signed-off-by: Noam Lessner <nlessner@habana.ai>
---

diff --git a/goya2_arc/pldm.c b/goya2_arc/pldm.c
new file mode 100644
index 0000000..4545cb2
--- /dev/null
+++ b/goya2_arc/pldm.c
@@ -0,0 +1,50 @@
+/*
+ * (C) Copyright 2019 HabanaLabs, Ltd.
+ * Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#include <stdbool.h>
+
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+
+#define SYS_CLOCK_FREQUENCY	155000ULL
+#define UART_CLOCK_FREQUENCY	(SYS_CLOCK_FREQUENCY / 5)
+#define PLDM_UART_BAUDRATE	1200
+
+bool hl_pll_is_configurable(struct hl_pll_cfg *cfg)
+{
+	return false;
+}
+
+int hl_pll_get_cfg(struct hl_pll_cfg **hl_pll_cfg)
+{
+	return 0;
+}
+
+u32 hl_skip_pcie_init(void)
+{
+	return 1;
+}
+
+u64 hl_pll_get_cpu_cycles_per_usec(void)
+{
+	return SYS_CLOCK_FREQUENCY / USEC_PER_SEC;
+}
+
+void hl_uart_init(void)
+{
+	preboot_uart_init(UART_CLOCK_FREQUENCY / PLDM_UART_BAUDRATE);
+}
+
+u32 hl_spi_baudr_get(void)
+{
+	u32 factor = 2; /* Min Divider */
+
+	/* baud rate doesn't support odd number */
+	return (factor + 1) & 0xFFFE;
+}
+
