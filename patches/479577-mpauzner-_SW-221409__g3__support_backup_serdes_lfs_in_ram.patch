From b62abd70e4559cb215890622a7fc4d0e12744fb5 Mon Sep 17 00:00:00 2001
From: Michael Pauzner <mpauzner@habana.ai>
Date: Mon, 12 May 2025 14:47:34 +0300
Subject: [PATCH] [SW-221409] g3: support backup serdes lfs in ram

Add support for backup serdes lfs partition in ram.

Change-Id: Ib20e580cfc090c59253a86facb844f64707c15bd
Signed-off-by: Michael Pauzner <mpauzner@habana.ai>
---

diff --git a/CMakeLists.txt b/CMakeLists.txt
index b3b0c07..2ca8403 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -105,6 +105,7 @@
               ${ZEPHYR_MODULES_DIR}/littlefs/zephyr/lfs_serdes_partition_config.c
               ${ZEPHYR_MODULES_DIR}/littlefs/zephyr/lfs_zephyr_init.c
 							${ZEPHYR_MODULES_DIR}/littlefs/zephyr/lfs_log_console_sender.c)
+target_sources_ifdef(CONFIG_LFS_IMAGE_IN_RAM app PRIVATE ${ZEPHYR_MODULES_DIR}/littlefs/bd/lfs_rambd.c)
 target_sources_ifdef(CONFIG_LFS_SHELL app PRIVATE ${ZEPHYR_MODULES_DIR}/littlefs/zephyr/lfs_zephyr_shell.c)
 
 zephyr_ld_options(-Wl,--no-warn-rwx-segments)
