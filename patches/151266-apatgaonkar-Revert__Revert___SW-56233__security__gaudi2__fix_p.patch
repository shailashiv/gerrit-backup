From 530c7d051b780f050ffba0e97c726ddb89921e37 Mon Sep 17 00:00:00 2001
From: Abhishek <apatgaonkar@habana.ai>
Date: Mon, 29 Nov 2021 06:23:34 +0200
Subject: [PATCH] Revert "Revert "[SW-56233] security: gaudi2: fix prot bits loop""

This reverts commit 187681df49ccbc2fd170654c4339bb9217a50b48.

Change-Id: Ia63e0af9ac7e82a2354ffc6df524fdbb47774c1f
---

diff --git a/arch/gaudi2/common/security.c b/arch/gaudi2/common/security.c
index 5dd97c9..7918a3f 100644
--- a/arch/gaudi2/common/security.c
+++ b/arch/gaudi2/common/security.c
@@ -432,6 +432,7 @@
 				do {
 					init_prot_bits_block(cfg_idx, major_idx, minor_idx,
 							     sub_minor_idx);
+					sub_minor_idx++;
 				} while (sub_minor_idx < block_addr.sub_minor);
 				minor_idx++;
 			} while (minor_idx < block_addr.minor);
