-int tpm_init(void)
-{
-	int ret;
-
-	ret = tpm2_init();
-	if (ret) {
-		preboot_puts("TPM: tpm2_init failed\n");
-		cpu_boot_err_set(CPU_BOOT_ERR_TPM_FAIL);
-	}
-
-	return ret;
-}
-
-int tpm_startup(void)
-{
-	int ret;
-
-	ret = tpm2_startup(TPM2_SU_CLEAR);
-	if (ret) {
-		preboot_puts("TPM: tpm2_startup failed\n");
-		cpu_boot_err_set(CPU_BOOT_ERR_TPM_FAIL);
-	}
-
-	return ret;
-}
-
-int tpm_pcr_extend(uint32_t image_index, uint8_t *hash)
-{
-	int ret;
-
-	if (hash == NULL)
-		return -1;
-
-	ret = cpu_boot_err_get(CPU_BOOT_ERR_TPM_FAIL);
-	if (ret) {
-		preboot_puts("preboot_pcr_extend: tpm isn't enabled\n");
-		return ret;
-	}
-
-	ret = tpm2_pcr_extend(image_index, TPM2_ALG_SHA384, hash, TPM2_SHA384_DIGEST_SIZE);
-	if (ret) {
-		preboot_puts("preboot_pcr_extend: pcr extend failed\n");
-		cpu_boot_err_set(CPU_BOOT_ERR_TPM_FAIL);
-	}
-
-	return ret;
-}
-
-int tpm_hash_and_pcr_extend(uint32_t image_index, uintptr_t image_ptr, uint32_t image_size)
-{
-	uint8_t hash[SHA_SUM_LEN] = { 0 };
-
-	sha_csum((void *)image_ptr, image_size, hash);
-
-	return tpm_pcr_extend(image_index, hash);
-}
-
 void preboot_tpm_auth(void)
 {
 	int ret;
@@ -102,10 +43,15 @@
 
 	efuse_dev_id.tpm_data = 0x0;
 
-	if (cpu_boot_err_get(CPU_BOOT_ERR_TPM_FAIL))
-		return;
+	ret = tpm2_init();
+	if (ret)
+		cpu_boot_err_set(CPU_BOOT_ERR_TPM_FAIL);
 
-	tpm_init();
+	ret = tpm2_startup(TPM2_SU_CLEAR);
+	if (ret) {
+		preboot_puts_hex("TPM: startup failed. ret = ", ret, true);
+		cpu_boot_err_set(CPU_BOOT_ERR_TPM_FAIL);
+	}
 
 	ret = tpm2_nv_read(TPM_NV_DEV_SN_ADDRESS, &tpm_dev_id, sizeof(tpm_dev_id));
 	if (ret) {
