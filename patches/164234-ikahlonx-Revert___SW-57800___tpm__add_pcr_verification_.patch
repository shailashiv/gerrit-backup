-
-#define HL_FWSRAM_BASE			(HL_SDRAM_BASE + \
-					 HL_FWSRAM_OFFSET)
-
-/* From arcboot */
-enum arcboot_rom_progress {
-	PROGRESS_INIT,
-	PROGRESS_INIT_SP_SRAM_NOT_COMPLETED,
-	PROGRESS_REVOKE_LOC,
-	PROGRESS_REVOKE_LOC_0,
