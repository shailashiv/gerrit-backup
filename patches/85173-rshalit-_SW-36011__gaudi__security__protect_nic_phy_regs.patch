From 28bb9393427a784ea1bed3c3e9eddc394018c146 Mon Sep 17 00:00:00 2001
From: Ran Shalit <rshalit@habana.ai>
Date: Mon, 29 Mar 2021 17:53:06 +0300
Subject: [PATCH] [SW-36011] gaudi: security: protect nic phy regs

Protect NIC phy registers, as a security against
user forcing NIC ports up or down.

Change-Id: I53a594ae37eed1789829189cedfe1a528bd5c620
Signed-off-by: Ran Shalit <rshalit@habana.ai>
---

diff --git a/gaudi/security.c b/gaudi/security.c
index 872b256..af4c63b 100644
--- a/gaudi/security.c
+++ b/gaudi/security.c
@@ -24,6 +24,7 @@
 #include <nic0_txs0_regs.h>
 #include <nic0_txe0_regs.h>
 #include <nic0_tmr_regs.h>
+#include <nic0_phy_regs.h>
 #include <sif_rtr_0_regs.h>
 #include <sif_rtr_ctrl_0_regs.h>
 #include <sif_rtr_ctrl_7_regs.h>
@@ -1019,6 +1020,26 @@
 	}
 }
 
+static void preboot_secure_nic_phy(void)
+{
+	u32 mask, port, prot_base, base = mmNIC0_PHY_BASE & ~HL_CFG_BASE;
+
+	for (port = 0; port < GAUDI_NICS_NUM; port++) {
+		/* Protect PHY_RX_CFG registers in each NIC block */
+		mask = (PROT_BIT(mmNIC0_PHY_PHY_RX_CFG_0) &
+			PROT_BIT(mmNIC0_PHY_PHY_RX_CFG_1) &
+			PROT_BIT(mmNIC0_PHY_PHY_RX_CFG_2) &
+			PROT_BIT(mmNIC0_PHY_PHY_RX_CFG_3));
+		regmap_writel(mask, PRIV_PROT_REG(base));
+
+		/* offsets: 0x80 - 0xF80 */
+		prot_base = base + SNGL_REG_PROT_SIZE;
+		set_prot_bits_range_all(prot_base,
+					PROT_SIZE_MAX - (prot_base - base));
+		base += GAUDI_NICS_DIST;
+	}
+}
+
 static void preboot_secure_nic(void)
 {
 	u32 reg, mask;
@@ -1071,6 +1092,8 @@
 	preboot_secure_set_nic_eng_role(reg, mask, 1);
 	mask = PROT_BIT(mmNIC0_TMR_TMR_LIST_AXI_PROT) & PROT_BIT(reg);
 	preboot_secure_prot_nics_engs_regs(reg, mask, 1);
+
+	preboot_secure_nic_phy();
 }
 
 #define SRAM_BANKS_NUM	32
