From 996317bc74fcbab6df1953b344bea0ae618c4ae1 Mon Sep 17 00:00:00 2001
From: Vitaly Margolin <vmargolin@habana.ai>
Date: Mon, 16 Jun 2025 14:20:35 +0300
Subject: [PATCH] [SW-232431] lfs: add clean log to api

Add log cleaning function to LFS based logger API

Change-Id: I405527c71da923d827f407a6701f7646816ec86c
Signed-off-by: Vitaly Margolin <vmargolin@habana.ai>
---

diff --git a/zephyr/lfs_log_console_sender.c b/zephyr/lfs_log_console_sender.c
index 171bb8f..9088e75 100644
--- a/zephyr/lfs_log_console_sender.c
+++ b/zephyr/lfs_log_console_sender.c
@@ -472,7 +472,7 @@
 
 	lfs_logger.is_suspended = true;
 	k_work_queue_drain(&backend.lfs_work_q, block_queue);
-	if (!backend.time_critical && is_file_opened(&lfs_logger.log_file))
+	if (is_file_opened(&lfs_logger.log_file))
 		lfs_file_close(get_lfs(), &lfs_logger.log_file);
 }
 
@@ -498,6 +498,24 @@
 		lfs_logger.is_suspended = false;
 }
 
+int module_lfs_cleanup(void)
+{
+	int rc;
+
+	if (!is_lfs_log_enabled())
+		return 0;
+
+	if (!backend.zephyrbd || !backend.zephyrbd->is_mounted) {
+		rc = lfs_zephyrbd_init(&backend.zephyrbd, DEFAULT_LOG_PARTITION);
+		if (rc)
+			return rc;
+	} else
+		module_lfs_shutdown();
+
+	rc = lfs_format(get_lfs(), backend.zephyrbd->cfg);
+	return rc;
+}
+
 #else
 #error "LittleFS not defined in device tree"
 #endif
diff --git a/zephyr/lfs_zephyr_init.h b/zephyr/lfs_zephyr_init.h
index 5f913d4..7db54fb 100644
--- a/zephyr/lfs_zephyr_init.h
+++ b/zephyr/lfs_zephyr_init.h
@@ -32,5 +32,6 @@
 void module_lfs_suspend(void);
 void module_lfs_resume(void);
 bool is_lfs_log_enabled(void);
+int module_lfs_cleanup(void);
 
 #endif
