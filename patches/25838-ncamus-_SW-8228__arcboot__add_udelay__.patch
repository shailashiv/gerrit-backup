From 66319a7be584ae6b891e1e109ba9fc588f1fe70e Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Sat, 18 Jan 2020 21:49:43 +0200
Subject: [PATCH] [SW-8228] arcboot: add udelay()

Should be used all around when needed

Change-Id: I40cbff81b29cf328a0e265b46ad379808ac7aba7
---

diff --git a/goya2_arc/soc.h b/goya2_arc/soc.h
index e58c587..b1a4946 100644
--- a/goya2_arc/soc.h
+++ b/goya2_arc/soc.h
@@ -9,4 +9,7 @@
 #define _SOC_H_
 #include <goya2_regs.h>
 
-#endif /* _SOC_H_ */
\ No newline at end of file
+#define CPU_FREQ	500000000
+#define CPU_FREQ_US	500	/* CPU_FREQ / 1000000 */
+
+#endif /* _SOC_H_ */
diff --git a/include/delay.h b/include/delay.h
new file mode 100644
index 0000000..0d5b67c
--- /dev/null
+++ b/include/delay.h
@@ -0,0 +1,27 @@
+/*
+ * Copyright (C) 2017 HabanaLabs Ltd.
+ *   Author: Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#ifndef _DELAY_H_
+#define _DELAY_H_
+
+#include "soc.h"
+
+static inline void udelay(unsigned long usec)
+{
+	unsigned long loops = CPU_FREQ_US * usec;
+
+	__asm__ __volatile__(
+	"	mov lp_count, %0	\n"
+	"	lp  1f			\n"
+	"	nop			\n"
+	"1:				\n"
+	:
+        : "r"(loops)
+        : "lp_count");
+}
+
+#endif /* _DELAY_H_ */
