From bf100767ae525d069b27231344e1335c328a6e24 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Wed, 01 Aug 2018 08:03:43 +0300
Subject: [PATCH] Dali: UBOOT ENV bootcmd update

In case that FIT is corrupted let's notify KMD
---

diff --git a/board/habanalabs/dali/uboot-env-asic.txt b/board/habanalabs/dali/uboot-env-asic.txt
index 573ebf4..d064803 100644
--- a/board/habanalabs/dali/uboot-env-asic.txt
+++ b/board/habanalabs/dali/uboot-env-asic.txt
@@ -1,4 +1,4 @@
 bootm_low=0
 ethaddr=00:33:66:99:cc:ff
 netboot=dhcp 192.168.10.109:dali-fit.itb && bootm $fileaddr#conf@1
-bootcmd=getfit && bootm $fileaddr#conf@1
+bootcmd=getfit && bootm $fileaddr#conf@1 || getfit_failure
diff --git a/board/habanalabs/dali/uboot-env-onix.txt b/board/habanalabs/dali/uboot-env-onix.txt
index c3905c0..d9a4f04 100644
--- a/board/habanalabs/dali/uboot-env-onix.txt
+++ b/board/habanalabs/dali/uboot-env-onix.txt
@@ -1,4 +1,4 @@
 bootm_low=0
 ethaddr=00:11:22:33:44:55
 netboot=dhcp 192.168.10.86:dali-fit.itb && bootm $fileaddr#conf@1
-bootcmd=getfit && bootm $fileaddr#conf@1
+bootcmd=getfit && bootm $fileaddr#conf@1 || getfit_failure
