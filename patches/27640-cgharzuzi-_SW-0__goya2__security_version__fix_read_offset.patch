From c95890fd30b65064424861ddda551b83a14d5db6 Mon Sep 17 00:00:00 2001
From: Christine Gharzuzi <cgharzuzi@habana.ai>
Date: Mon, 10 Feb 2020 17:43:43 +0200
Subject: [PATCH] [SW-0] goya2: security version: fix read offset

Fix the offset to be aligned to dword

Change-Id: I43d442497838e7ba73957318080b289ca069211c
Signed-off-by: Christine Gharzuzi <cgharzuzi@habana.ai>
---

diff --git a/common/spi_flash.c b/common/spi_flash.c
index e0b39fb..c826440 100644
--- a/common/spi_flash.c
+++ b/common/spi_flash.c
@@ -90,7 +90,8 @@
 
 	/* read min security version bit map from flash */
 	for (i = 0; i < SECURITY_DWORD_PER_FW_SEC_VERSION; i++) {
-		fw_version[i] = spi_flash_readl(flash_efuse_offset + i);
+		fw_version[i] = spi_flash_readl(flash_efuse_offset +
+				(i * SECURITY_BYTE_PER_DWORD));
 		spi_flash_invert_dword(&fw_version[i]);
 	}
 
