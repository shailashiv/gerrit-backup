-        ${AGENT_FW_LOADER_FIT} \
-        ${EEPROM_FIT} \
-        ${AGENT_FW_LOADER_FIT}
-
+        ${ITBS_DIR}${DEV_PREFIX}-agent-fw_loader-fit.itb \
+        ${ITBS_DIR}${DEV_PREFIX}-eeprom.itb \
+        ${ITBS_DIR}${DEV_PREFIX}-agent-fw_loader-fit.itb
