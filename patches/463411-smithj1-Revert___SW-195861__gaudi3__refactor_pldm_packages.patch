diff --git a/board/habanalabs/gaudi3/create-pldm-fwup-package-eeprom.sh b/board/habanalabs/gaudi3/create-pldm-fwup-package-eeprom.sh
index cf663e7..a757a18 100755
--- a/board/habanalabs/gaudi3/create-pldm-fwup-package-eeprom.sh
+++ b/board/habanalabs/gaudi3/create-pldm-fwup-package-eeprom.sh
@@ -2,16 +2,16 @@
 
 source ${BUILDROOT_ROOT}/board/habanalabs/${DEV_PREFIX}/create-pldm-fwup-package.sh
 
-if [[ ! -f ${AGENT_FW_LOADER_FIT} ]]; then
-        echo "$0: FW loader agent (${AGENT_FW_LOADER_FIT}) not found - cannot create PLDM package"
+VERSION_FILE="${BUILDROOT_ROOT}/output/${DEV_PREFIX}_arc/build/agent-fwl-custom/localversion-habanalabs"
+
+if [[ ! -f ${VERSION_FILE} ]]; then
+        echo "$0: FW loader agent not built - cannot create PLDM package"
         exit 1
 fi
 
-if [[ ! -f ${EEPROM_FIT} ]]; then
-        echo "$0: EEPORM fit (${EEPROM_FIT}) not found - cannot create PLDM package"
-        exit 1
-fi
-
+AGENT_FW_LOADER_FIT_VERSION=$(cat ${VERSION_FILE})
+AGENT_FW_LOADER_FIT_VERSION=${AGENT_FW_LOADER_FIT_VERSION:1} # remove leading '-'
+EEPROM_VERSION=$(git describe --dirty --match="hl-${DEV_PREFIX}-*" 2>/dev/null | sed 's/.*-fw-\([^-]*\).*/\1/' | awk -F. '{ printf "eeprom-%d.%d.%d", $1, $2, $3 }')
 PACKAGE_PREFIX="${ITBS_DIR}${DEV_PREFIX}-pldm-package-eeprom"
 PACKAGE_JSON="${PACKAGE_PREFIX}.json"
 PACKAGE_BIN="${PACKAGE_PREFIX}.bin"
@@ -23,7 +23,7 @@
                              --pci-device-id "${PCI_DEVICE_ID}" \
                              --pci-subsystem-id "${PCI_SUBSYSTEM_ID}" \
                              --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_FW_LOADER_1)) "${AGENT_FW_LOADER_FIT_VERSION}" \
-                             --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_EEPROM))      "${EEPROM_FIT_VERSION}"          \
+                             --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_EEPROM)) "${EEPROM_VERSION}" \
                              --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_FW_LOADER_2)) "${AGENT_FW_LOADER_FIT_VERSION}"
 rv=$?
 if [[ ${rv} -ne 0 ]]; then
@@ -32,10 +32,9 @@
 fi
 
