diff --git a/board/habanalabs/gaudi3/create-pldm-fwup-package-margin-tool.sh b/board/habanalabs/gaudi3/create-pldm-fwup-package-margin-tool.sh
index 9abe414..9ffee68 100755
--- a/board/habanalabs/gaudi3/create-pldm-fwup-package-margin-tool.sh
+++ b/board/habanalabs/gaudi3/create-pldm-fwup-package-margin-tool.sh
@@ -4,32 +4,40 @@
 
 MARGIN_TOOL="${1}"
 COMPONENT_IDENTIFIER=$(($2))
-MARGIN_TOOL_ITB_PATH=$3
-MARGIN_TOOL_FIT_VERSION=$4
 
-if [[ ! -f ${MARGIN_TOOL_ITB_PATH} ]]; then
-        echo "$0: ${MARGIN_TOOL} agent not found ($MARGIN_TOOL_ITB_PATH) - cannot create PLDM package"
+VERSION_FILE="${BUILDROOT_ROOT}/output/${DEV_PREFIX}_arc/build/agent-${MARGIN_TOOL}-custom/localversion-habanalabs"
+
+# Temporary path support, needs to be removed after all agents will be split out of zephyr package
+if [[ ! -f ${VERSION_FILE} ]]; then
+	VERSION_FILE="${BUILDROOT_ROOT}/output/${DEV_PREFIX}_arc/build/zephyr-custom/build-agent-${MARGIN_TOOL}/localversion-habanalabs"
+fi
+
+if [[ ! -f ${VERSION_FILE} ]]; then
+        echo "$0: ${MARGIN_TOOL} agent not built - cannot create PLDM package"
         exit 1
 fi
 
+AGENT_FIT_VERSION=$(cat ${VERSION_FILE})
+AGENT_FIT_VERSION=${AGENT_FIT_VERSION:1} # remove leading '-'
 PACKAGE_PREFIX="${ITBS_DIR}${DEV_PREFIX}-pldm-package-${MARGIN_TOOL}"
 PACKAGE_JSON="${PACKAGE_PREFIX}.json"
 PACKAGE_BIN="${PACKAGE_PREFIX}.bin"
 
 ${PLDM_FWUP_JSON_CTOR_SCRIPT} --output-file ${PACKAGE_JSON} \
                              --package-release-date-time "${PACKAGE_RELEASE_DATE_TIME}" \
-                             --package-version "${MARGIN_TOOL_FIT_VERSION}" \
-                             --component-image-set-version "${MARGIN_TOOL_FIT_VERSION}" \
+                             --package-version "${AGENT_FIT_VERSION}" \
+                             --component-image-set-version "${AGENT_FIT_VERSION}" \
                              --pci-device-id "${PCI_DEVICE_ID}" \
                              --pci-subsystem-id "${PCI_SUBSYSTEM_ID}" \
-                             --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) ${COMPONENT_IDENTIFIER} "${MARGIN_TOOL_FIT_VERSION}"
+                             --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) ${COMPONENT_IDENTIFIER} "${AGENT_FIT_VERSION}"
 rv=$?
 if [[ ${rv} -ne 0 ]]; then
         echo "$0: ${PLDM_FWUP_JSON_CTOR_SCRIPT} failed with ${rv}"
         exit ${rv}
 fi
 
-${PLDM_FWUP_PACKAGE_CTOR_SCRIPT} ${PACKAGE_BIN} ${PACKAGE_JSON} ${MARGIN_TOOL_ITB_PATH}
+${PLDM_FWUP_PACKAGE_CTOR_SCRIPT} ${PACKAGE_BIN} ${PACKAGE_JSON} \
+        ${ITBS_DIR}${DEV_PREFIX}-agent-${MARGIN_TOOL}-fit.itb
 rv=$?
 if [[ ${rv} -ne 0 ]]; then
         echo "$0: ${PLDM_FWUP_PACKAGE_CTOR_SCRIPT} failed with ${rv}"
