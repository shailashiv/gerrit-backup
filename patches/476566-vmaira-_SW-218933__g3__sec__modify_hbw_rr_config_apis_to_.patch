diff --git a/arch/gaudi3/common/security_defs.h b/arch/gaudi3/common/security_defs.h
index 52fb4d6..f247669 100644
--- a/arch/gaudi3/common/security_defs.h
+++ b/arch/gaudi3/common/security_defs.h
@@ -32,6 +32,13 @@
 	GAUDI3_DUAL_DIE_SKU,
 };
 
+enum hl_security_prot_type {
+	HL_SEC_RD_PROT = 0x1,
+	HL_SEC_WR_PROT = 0x2,
+};
+
+#define HL_SEC_RD_WR_PROT (HL_SEC_RD_PROT | HL_SEC_WR_PROT)
+
 struct gaudi3_redundancy_ctx {
 	uint8_t initialized;
 	uint8_t num_of_dies;
