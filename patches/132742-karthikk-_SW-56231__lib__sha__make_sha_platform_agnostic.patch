diff --git a/arch/gaudi/arm/sha.c b/arch/gaudi/arm/sha.c
new file mode 100644
index 0000000..c152e68
--- /dev/null
+++ b/arch/gaudi/arm/sha.c
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ *
+ * (C) Copyright 2021 HabanaLabs, Ltd.
+ *
+ */
+
+
+#include <preboot.h>
+#include <uart.h>
+
+#include "hl.h"
+#include <sha.h>
+
+void sha_csum(const unsigned char *input, unsigned int ilen,
+		unsigned char *output)
+{
+	sha256_csum(input, ilen, output);
+}
+
+void sha_csum_regions(const struct image_region region[], int region_count,
+			 u8 *output)
+{
+	struct sha256_context ctx;
+	int i;
+
+	sha256_starts(&ctx);
+	for (i = 0; i < region_count; i++)
+		sha256_update(&ctx, region[i].data, region[i].size);
+	sha256_finish(&ctx, output);
+}
