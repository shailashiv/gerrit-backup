From 98a8a934289fd29183bf3eee4d8a9bb94779f0cd Mon Sep 17 00:00:00 2001
From: Pardha Kesapragada <pkesapragada@habana.ai>
Date: Mon, 15 Feb 2021 17:17:08 +0200
Subject: [PATCH] [SW-20154] add range register programming

This patch adds range register programming for
I2C, SMI, JTAG and PCI interfaces such that attacks
from these interfaces is not possible.

Change-Id: I1e54b505c57bd3ad6aaf3ef4e8ac3ff565a39f03
Signed-off-by: Pardha Kesapragada <pkesapragada@habana.ai>
---

diff --git a/app/arcboot_rom.c b/app/arcboot_rom.c
index ec00cc4..0f7f1fd 100644
--- a/app/arcboot_rom.c
+++ b/app/arcboot_rom.c
@@ -109,12 +109,18 @@
 
 __attribute__((weak)) void update_warm_reset_config(void){}
 
+__attribute__((weak)) void security_disable_interfaces(void)
+{
+	/* by default disable jtag I/F as soon as possible */
+	security_disable_jtag_if();
+}
+
 static void arcboot_rom_init(void)
 {
 	uint32_t reg;
 
-	/* by default disable jtag I/F as soon as possible */
-	security_disable_jtag_if();
+	/* lock everything as soon as possible */
+	security_disable_interfaces();
 
 	arcboot_rom_status_update(PROGRESS_INIT);
 
@@ -204,8 +210,8 @@
 	     EFUSE_SYSCFG_DISABLE_JTAG_IF_MASK) == 0)
 		security_enable_jtag_if();
 
-	if (arcboot_rom_global.config_fuse & EFUSE_SYSCFG_DISABLE_TWI_IF_MASK)
-		security_disable_twi_if();
+	/* based on efuse, handle twi enable/disable */
+	security_handle_twi();
 
 	security_load_revoke_bits();
 	security_load_fw_version();
