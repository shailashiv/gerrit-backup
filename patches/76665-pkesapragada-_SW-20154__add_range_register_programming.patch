diff --git a/gaudi2_arc_gnu/security.c b/gaudi2_arc_gnu/security.c
index 671db24..d573349 100644
--- a/gaudi2_arc_gnu/security.c
+++ b/gaudi2_arc_gnu/security.c
@@ -9,21 +9,171 @@
 #include "security.h"
 #include "spi_flash.h"
 
+#define GAUDI2_SECURITY_END_HBW_LSB		0xFFFFFFFF
+#define GAUDI2_SECURITY_END_HBW_MSB		0xFFFFF
+#define GAUDI2_SECURITY_START_HBW_LSB		0x0
+#define GAUDI2_SECURITY_START_HBW_MSB		0x0
+#define GAUDI2_DISABLE_PCIE_TRAFFIC		0x0
+#define GAUDI2_ENABLE_PCIE_TRAFFIC		0x3
+#define GAUDI2_SECURITY_LBW_MASK		0x7FFFFFF
+#define GAUDI2_SECURITY_PSOC_START_LBW		0x0
+#define GAUDI2_SECURITY_PSOC_END_LBW		0x7FFFFFF
+
 static void security_disable_i2c_s_mstr_if(void)
 {
-	/* TODO */
+	/* override AXI prot bit by master IF to secure, unprivileged access */
+	/* ovrd_en = 1, and overd_value of 0 */
+	regmap_writel(MSTR_IF_CORE_HBW_AXPROT_OVRD_OVRD_EN,
+			mmI2C_S_MSTR_IF_CORE_HBW_AXPROT_OVRD);
+
+	/* disable pcie traffic by writing 0 */
+	regmap_writel(GAUDI2_DISABLE_PCIE_TRAFFIC,
+			mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_PCIE_EN);
+
+	/* Block Everything:
+	 * Set MIN = 0x0
+	 * Set Max = 0xFFFFFFFFFFFFF;	//52 bits
+	 */
+	regmap_writel(GAUDI2_SECURITY_START_HBW_LSB,
+			mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_0);
+	regmap_writel(GAUDI2_SECURITY_START_HBW_MSB,
+			mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_0);
+	regmap_writel(GAUDI2_SECURITY_END_HBW_LSB,
+			mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_0);
+	regmap_writel(GAUDI2_SECURITY_END_HBW_MSB,
+			mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_0);
+}
+
+static void security_enable_i2c_s_mstr_if(void)
+{
+	/* don't override AXI prot bit by master IF */
+	regmap_writel(0,
+		mmI2C_S_MSTR_IF_CORE_HBW_AXPROT_OVRD);
+
+	/* enable pcie traffic by writing 1 */
+	regmap_writel(GAUDI2_ENABLE_PCIE_TRAFFIC,
+		mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_PCIE_EN);
+
+	/* enable access to all:
+	 * MIN = 0xFFFFFFFFFFFFF
+	 * MAX = 0
+	 */
+	regmap_writel(GAUDI2_SECURITY_END_HBW_LSB,
+		mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_0);
+	regmap_writel(GAUDI2_SECURITY_END_HBW_MSB,
+		mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_0);
+	regmap_writel(GAUDI2_SECURITY_START_HBW_LSB,
+		mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_0);
+	regmap_writel(GAUDI2_SECURITY_START_HBW_MSB,
+		mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_0);
+}
+
+static void security_enable_smi_mstr_if(void)
+{
+	/* 0: Disable access, 1: Enable Access */
+	regmap_writel(1,
+		mmPSOC_GLOBAL_CONF_SMI_ACCESS_EN);
+
+	/* enable pcie traffic by writing 1 */
+	regmap_writel(GAUDI2_ENABLE_PCIE_TRAFFIC,
+		mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_PCIE_EN);
+
+	/* don't override AXI prot bit by master IF */
+	regmap_writel(0,
+		mmSMI_MSTR_IF_CORE_HBW_AXPROT_OVRD);
+
+	/* enable access to all:
+	 * MIN = 0xFFFFFFFFFFFFF
+	 * MAX = 0
+	 */
+	regmap_writel(GAUDI2_SECURITY_END_HBW_LSB,
+		mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_0);
+	regmap_writel(GAUDI2_SECURITY_END_HBW_MSB,
+		mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_0);
+	regmap_writel(GAUDI2_SECURITY_START_HBW_LSB,
+		mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_0);
+	regmap_writel(GAUDI2_SECURITY_START_HBW_MSB,
+		mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_0);
 }
 
 static void security_disable_smi_mstr_if(void)
 {
+	/* 0: Disable access, 1: Enable Access */
+	regmap_writel(0,
+		mmPSOC_GLOBAL_CONF_SMI_ACCESS_EN);
+
+	/* override AXI prot bit by master IF to secure, unprivileged access */
+	/* ovrd_en = 1, and overd_value of 0 */
+	regmap_writel(MSTR_IF_CORE_HBW_AXPROT_OVRD_OVRD_EN,
+		mmSMI_MSTR_IF_CORE_HBW_AXPROT_OVRD);
+
+	/* disable pcie traffic by writing 0 */
+	regmap_writel(GAUDI2_DISABLE_PCIE_TRAFFIC,
+		mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_PCIE_EN);
+
+	/* Block Everything:
+	 * Set MIN = 0x0
+	 * Set Max = 0xFFFFFFFFFFFFF;	//52 bits
+	 */
+	regmap_writel(GAUDI2_SECURITY_START_HBW_LSB,
+		mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_0);
+	regmap_writel(GAUDI2_SECURITY_START_HBW_MSB,
+		mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_0);
+	regmap_writel(GAUDI2_SECURITY_END_HBW_LSB,
+		mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_0);
+	regmap_writel(GAUDI2_SECURITY_END_HBW_MSB,
+		mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_0);
 }
 
 void security_disable_jtag_mstr_if(void)
 {
+
+	/* override AXI prot bit by master IF to secure, unprivileged access */
+	/* ovrd_en = 1, and overd_value of 0 */
+	regmap_writel(MSTR_IF_CORE_HBW_AXPROT_OVRD_OVRD_EN,
+		mmJT_MSTR_IF_CORE_HBW_AXPROT_OVRD);
+
+	/* disable pcie traffic by writing 0 */
+	regmap_writel(GAUDI2_DISABLE_PCIE_TRAFFIC,
+		mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_PCIE_EN);
+
+	/* Block Everything:
+	 * Set MIN = 0x0
+	 * Set Max = 0xFFFFFFFFFFFFF;	//52 bits
+	 */
+	regmap_writel(GAUDI2_SECURITY_START_HBW_LSB,
+		mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_0);
+	regmap_writel(GAUDI2_SECURITY_START_HBW_MSB,
+		mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_0);
+	regmap_writel(GAUDI2_SECURITY_END_HBW_LSB,
+		mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_0);
+	regmap_writel(GAUDI2_SECURITY_END_HBW_MSB,
+		mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_0);
 }
 
 void security_enable_jtag_mstr_if(void)
 {
+	/* don't override AXI prot bit by master IF */
+	regmap_writel(0, mmJT_MSTR_IF_CORE_HBW_AXPROT_OVRD);
+
+	/* enable pcie traffic by writing 1 */
+	regmap_writel(GAUDI2_ENABLE_PCIE_TRAFFIC,
+		mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_PCIE_EN);
+
+	/* enable access to all */
+	/* MIN = 0xFFFFFFFFFFFFF
+	 * MAX = 0
+	 */
+	regmap_writel(GAUDI2_SECURITY_END_HBW_LSB,
+		mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_0);
+	regmap_writel(GAUDI2_SECURITY_END_HBW_MSB,
+		mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_0);
+	regmap_writel(GAUDI2_SECURITY_START_HBW_LSB,
+		mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_0);
+	regmap_writel(GAUDI2_SECURITY_START_HBW_MSB,
+		mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_0);
+
+	/* LBW is not implemented for JT, so nothing to be done there */
 }
 
 void security_disable_twi_if(void)
@@ -32,44 +182,204 @@
 	security_disable_smi_mstr_if();
 }
 
-void security_jtag_dap(__attribute__ ((unused)) uint8_t status)
+void security_enable_twi_if(void)
 {
-	/* TODO: close dap WA jira: H5-1803 */
