From ad8c1a2ea44eab99da1227860a3a9d7f29b19bd1 Mon Sep 17 00:00:00 2001
From: Abhishek <apatgaonkar@habana.ai>
Date: Thu, 25 Nov 2021 09:48:29 +0200
Subject: [PATCH] Revert "[SW-36216] gaudi2: ppboot: configure hbw rr"

This reverts commit d5c38f7f3eafb9a6fa97a55422838a829bc65b2f.

Change-Id: Ib58613931713a1cf7a69f2bf11ccf4edba03650f
---

diff --git a/arch/gaudi2/common/security.c b/arch/gaudi2/common/security.c
index 6e48247..7cea4bf 100644
--- a/arch/gaudi2/common/security.c
+++ b/arch/gaudi2/common/security.c
@@ -150,11 +150,6 @@
  * rr idx type : gaudi2_sec_if_hbw_rrs
  */
 enum gaudi2_sec_if_hbw_rrs {
-	HL_SEC_HBW_STM = 0,
-	HL_SEC_HBW_SPI_FLASH = 1,
-	HL_SEC_HBW_ICCM0_TO_RAZWI = 2,
-	HL_SEC_HBW_SRAM = 6,
-	HL_SEC_HBW_HBM = 7,
 	HL_SEC_HBW_MAX_RR_IDX = 10,
 };
 
@@ -594,64 +589,6 @@
 		hl_secure_hbw_rr_gen(rr_idx, min, max, 0, HL_SEC_ENGINE_PSOC);
 }
 
-#define SPI_FLASH_SIZE	0x1000000ull /* 16MB */
-#define DBG_SPACE_BASE	0x1000007FF8000000ull
-#define SPI_FLASH_BASE	(STM_FLASH_BASE_ADDR + STM_FLASH_SIZE)
-#define SPI_FLASH_END	(SPI_FLASH_BASE + SPI_FLASH_SIZE)
-#define SRAM_RSVD_BASE	0x1000008000000000ull
-#define DRAM_RSVD_END	0xFF00000000000000ull
-
-static void ppboot_secure_hbw(void)
-{
-	u64 min, max;
-	struct hl_rr_eng_select rr_sel;
-
-	memset(&rr_sel, 0, sizeof(struct hl_rr_eng_select));
-
-	/* Only block pcie RR in ppboot */
-	rr_sel.pcie = true;
-
-	/*
-	 * SPI FLASH END to DBG SPACE BASE
-	 * 0x1000007FF7000000 - 0x1000007FF8000000
-	 */
-	min = SPI_FLASH_END;
-	max = CFG_BASE;
-	hl_secure_hbw_rr(HL_SEC_HBW_ICCM0_TO_RAZWI, min, max, rr_sel);
-
-	/*
-	 * Block STM memory space
-	 * 0x1000007FF4000000 - 0x1000007FF6000000
-	 */
-	min = STM_FLASH_BASE_ADDR;
-	max = STM_FLASH_BASE_ADDR + STM_FLASH_SIZE;
-	hl_secure_hbw_rr(HL_SEC_HBW_STM, min, max, rr_sel);
-
-	/*
-	 * Block Reserved space to HBM
-	 * 0x1000FFFFFD000000 - 0x1001000000000000
-	 */
-	min = SRAM_RSVD_BASE;
-	max = SRAM_BASE_ADDR + SRAM_SIZE;
-	hl_secure_hbw_rr(HL_SEC_HBW_SRAM, min, max, rr_sel);
-
-	/*
-	 * Block SPI Flash memory space
-	 * 0x1000007FF6000000 - 0x1000007FF7000000
-	 */
-	min = SPI_FLASH_BASE;
-	max = SPI_FLASH_END;
-	hl_secure_hbw_rr(HL_SEC_HBW_SPI_FLASH, min, max, rr_sel);
-
-	/*
-	 * Lock DRAM base to DRAM Reserved space end
-	 * 0x1001000000000000 - 0x1001000010000000
-	 */
-	min = DRAM_PHYS_BASE;
-	max = DRAM_RSVD_END;
-	hl_secure_hbw_rr(HL_SEC_HBW_HBM, min, max, rr_sel);
-}
-
 void ppboot_security_init(void)
 {
 	/* Initialize only if security is enabled */
@@ -659,7 +596,6 @@
 		return;
 
 	ppboot_secure_lbw();
-	ppboot_secure_hbw();
 }
 
 void preboot_security_init(void)
