 	{
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_ETHERNET_NUMBER_OF_LANES],
@@ -850,6 +855,7 @@
 	{
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_POWER_AND_PERFORMANCE_STATE],
 		.api.get = sensord_get_power_and_performance_state,
+		.api.polling_rate_ms = SENSOR_SAMPLE_RATE_HIGH,
 	},
 	{
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_SECURITY_KEY_STATE],
@@ -866,22 +872,22 @@
 	{
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_HBM_UTILIZATION],
