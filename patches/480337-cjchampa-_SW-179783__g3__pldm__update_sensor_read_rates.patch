From 923927cccd289ea1876baca4dd7b06ecfe3272f0 Mon Sep 17 00:00:00 2001
From: Christopher Champagne <cjchampagne@habana.ai>
Date: Thu, 22 May 2025 22:41:05 +0300
Subject: [PATCH] [SW-179783] g3: pldm: update sensor read rates

Update sensor polling rates to high (2.5 seconds) or very high (1 second)
based on spreadsheet changes.

Change-Id: Ib2b20be27ce95ce79c701fc3ceacde5737b70da6
Signed-off-by: Christopher Champagne <cjchampagne@habana.ai>
---

diff --git a/arch/gaudi3/ras/pldm/sensord_db.c b/arch/gaudi3/ras/pldm/sensord_db.c
index 9e20037..96b0baf 100644
--- a/arch/gaudi3/ras/pldm/sensord_db.c
+++ b/arch/gaudi3/ras/pldm/sensord_db.c
@@ -9,15 +9,12 @@
 #include "sensord_db.h"
 #include "sensord_handlers.h"
 
-/* Rate value in msec */
-#define SENSOR_SAMPLE_RATE_HIGH      2500
-#define SENSOR_SAMPLE_RATE_VERY_HIGH 1000
-
 #define SENSOR_ETHERNET_PORT_STATE(port)					\
 	{									\
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_ETHERNET_PORT_STATE],	\
 		.index = (port - 1),						\
 		.api.poll = sensord_poll_ethernet_port_state,			\
+		.api.polling_rate_ms = SENSOR_SAMPLE_RATE_HIGH,			\
 	}
 
 #define SENSOR_ETHERNET_CORRECTABLE_ERRORS_COUNTER(port)					\
@@ -25,7 +22,6 @@
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_ETHERNET_CORRECTABLE_ERRORS_COUNTER],	\
 		.index = (port - 1),								\
 		.api.poll = sensord_poll_ethernet_correctable_errors_counter,			\
-		.api.polling_rate_ms = SENSOR_SAMPLE_RATE_HIGH,					\
 	}
 
 #define SENSOR_ETHERNET_UNCORRECTABLE_ERRORS_COUNTER(port)					  \
@@ -33,6 +29,7 @@
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_ETHERNET_UNCORRECTABLE_ERRORS_COUNTER], \
 		.index = (port - 1),								  \
 		.api.poll = sensord_poll_ethernet_uncorrectable_errors_counter,			  \
+		.api.polling_rate_ms = SENSOR_SAMPLE_RATE_HIGH,					  \
 	}
 
 #define SENSOR_ETHERNET_LINK_RE_INITIALIZATION_COUNTER(port)					   \
@@ -255,10 +252,12 @@
 	{
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_CURRENT_SOC_12V_POWER],
 		.api.poll = sensord_poll_current_soc_12v_power,
+		.api.polling_rate_ms = SENSOR_SAMPLE_RATE_HIGH,
 	},
 	{
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_PEAK_SOC_12V_POWER],
 		.api.poll = sensord_poll_peak_soc_12v_power,
+		.api.polling_rate_ms = SENSOR_SAMPLE_RATE_HIGH,
 	},
 	{
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_LAST_POWER_REDUCTION_DURATION],
@@ -316,6 +315,8 @@
 	{
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_MAX_TEMPERATURE_RISE_TIME],
 		.api.poll = sensord_poll_max_temperature_rise_time,
+		.api.polling_rate_ms = SENSOR_SAMPLE_RATE_HIGH,
+
 	},
 	{
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_CHECKSUM_ERR_STORAGE_ERR_TBLS_STATE],
@@ -422,18 +423,22 @@
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_ETHERNET_ERROR_STATE],
 		.api.poll = sensord_poll_ethernet_error_state,
 		.api.get = sensord_get_ethernet_error_state,
+		.api.polling_rate_ms = SENSOR_SAMPLE_RATE_HIGH,
 	},
 	{
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_PCIE_CORRECTABLE_ERROR_STATE],
 		.api.poll = sensord_poll_pcie_correctable_error_state,
+		.api.polling_rate_ms = SENSOR_SAMPLE_RATE_HIGH,
 	},
 	{
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_PCIE_UNCORRECTABLE_ERROR_STATE],
