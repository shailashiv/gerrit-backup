 	{
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_HBM_TOTAL_MEMORY_SIZE],
 		.api.poll = sensord_poll_hbm_total_memory_size,
-		.api.polling_rate_ms = SENSOR_SAMPLE_RATE_HIGH,
+		.api.polling_rate_ms = SENSOR_SAMPLE_RATE_VERY_HIGH,
 	},
 	{
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_HBM_FREE_MEMORY_SIZE],
 		.api.poll = sensord_poll_hbm_free_memory_size,
-		.api.polling_rate_ms = SENSOR_SAMPLE_RATE_HIGH,
+		.api.polling_rate_ms = SENSOR_SAMPLE_RATE_VERY_HIGH,
 	},
 	{
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_HBM_USED_MEMORY_SIZE],
 		.api.poll = sensord_poll_hbm_used_memory_size,
-		.api.polling_rate_ms = SENSOR_SAMPLE_RATE_HIGH,
+		.api.polling_rate_ms = SENSOR_SAMPLE_RATE_VERY_HIGH,
 	},
 	{
 		.pdr = &pldm_pdr_records[PLDM_RIDX_SENSOR_SRAM_BIST_STATUS],
