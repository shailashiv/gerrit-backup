From 3bea3534b5b971482678c30cf92d3901461eaccb Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Wed, 18 Mar 2020 08:23:38 +0200
Subject: [PATCH] [SW-0] goya2: arc: update spi reg base

We use the QSPI and not SPI any more

Change-Id: I7ff9fad3cc9132d5ccff62811b9ca638c4dbaa53
---

diff --git a/goya2_arc/common.c b/goya2_arc/common.c
index 5a670d7..21db14d 100644
--- a/goya2_arc/common.c
+++ b/goya2_arc/common.c
@@ -7,6 +7,7 @@
 
 #include <pcie_phy_regs.h>
 #include <psoc_global_conf_regs.h>
+#include <psoc_qspi_regs.h>
 #include <pcie_aux_regs.h>
 #include <pcie_wrap_regs.h>
 #include <pcie_core_regs.h>
@@ -216,3 +217,8 @@
 	/* Functionality used to be done in BTL */
 	init_prstn();
 }
+
+void spi_base_get(unsigned int *regs)
+{
+	*regs = mmPSOC_QSPI_CTRLR0;
+}
