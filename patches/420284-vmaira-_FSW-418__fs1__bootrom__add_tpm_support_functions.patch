+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2024 HabanaLabs Ltd.
+ * All Rights Reserved.
+ */
+
+#include <boot_rom.h>
+#include <mem_io.h>
+#include <fs1_blocks_linux_driver.h>
+#include <fs1_reg_map.h>
+#include <spi_regs.h>
+#include <psoc_pad_conf_regs.h>
+#include <gpio_regs.h>
+#include "dev_spi_tpm.h"
+
+void spi_tpm_cs_gpio_set(bool cs_en)
+{
+	uint32_t reg = regmap_readl(I0_H0_PSOC_GPIO1(mmGPIO_DATAOUT));
+	uint32_t mask = BIT(TPM_CS_GPIO_PIN % GPIOS_PER_BANK);
+
+	/* CS is active low */
+	if (cs_en)
+		reg &= ~mask;
+	else
+		reg |= mask;
+
+	regmap_writel(reg, I0_H0_PSOC_GPIO1(mmGPIO_DATAOUT));
+}
+
+uint32_t spi_tpm_miso_pad_sel_get(void)
+{
+	return IO0_H0_PSOC_PAD_CONF(mmPSOC_PAD_CONF_PAD_SEL_15);
+}
+
+uint32_t spi_tpm_mosi_pad_sel_get(void)
+{
+	return IO0_H0_PSOC_PAD_CONF(mmPSOC_PAD_CONF_PAD_SEL_16);
+}
+
+uint32_t spi_tpm_sclk_out_pad_sel_get(void)
+{
+	return IO0_H0_PSOC_PAD_CONF(mmPSOC_PAD_CONF_PAD_SEL_17);
+}
+
+uint32_t spi_tpm_cs_pad_sel_get(void)
+{
+	return IO0_H0_PSOC_PAD_CONF(mmPSOC_PAD_CONF_PAD_SEL_18);
+}
+
+void spi_tpm_ssi_cs1_get(uint32_t *mask, uint32_t *data_offset,
+				uint32_t *out_en_offset)
+{
+	*mask = BIT(TPM_CS_GPIO_PIN % GPIOS_PER_BANK);
+	*data_offset = I0_H0_PSOC_GPIO1(mmGPIO_DATAOUT);
+	*out_en_offset = I0_H0_PSOC_GPIO1(mmGPIO_OUTENSET);
+}
+
+uint32_t spi_tpm_base_get(void)
+{
+	return IO0_H0_PSOC_SPI(mmSPI_CTRLR0);
+}
