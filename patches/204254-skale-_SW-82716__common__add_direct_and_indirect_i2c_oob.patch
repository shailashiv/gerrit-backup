diff --git a/common/module_i2c_slave.c b/common/module_i2c_slave.c
new file mode 100644
index 0000000..827065e
--- /dev/null
+++ b/common/module_i2c_slave.c
@@ -0,0 +1,585 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2022 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <stdint.h>
+#include <stddef.h>
+#include <arcboot.h>
+#include <address_space.h>
+#include <device.h>
+#include <delay.h>
+#include <fit.h>
+#include <hl_fw_if.h>
+#include <hl_i2c_slave_events.h>
+#include <hl_i2c_indirect_protocol.h>
+#include <hl_i2c_indirect.h>
+#include <i2cslave_indirect.h>
+#include <common/pci_ids.h>
+#include <crc8.h>
+#include "cmd_module.h"
+#include "common.h"
+#include "module_i2c_slave.h"
+
+#define I2C_SLAVE_ADDRESS		0x6A
+#define I2C_SLAVE_ADDRESS_DBG		I2C_SLAVE_ADDRESS
+#define I2C_SLAVE_DEFAULT_INTR_MASK	0x48FF
+
+struct i2cslave_seq {
+	uint32_t rd;
+	uint32_t wr;
+};
+
+struct i2cslave_buf {
+	uint8_t *data;
+	uint8_t cmd;
+	uint8_t seq_cmd;
+	uint8_t cnt;
+	bool is_sync_error;
+	bool is_direct_pec;
+};
+
+struct i2cslave_data {
+	struct i2cslave_seq seq;
+	struct i2cslave_buf buf;
+};
+
+struct device_i2c_s i2c_s;
+static struct i2cslave_data i2cs_data;
+static bool is_fit_checked;
+
+uint8_t i2cslave_valid_pec;
+uint8_t i2cslave_pec;
+static uint8_t pec_table[CRC8_TABLE_SIZE];
+
+void i2cslave_fit_set_checked(void)
+{
+	is_fit_checked = true;
+}
+
+bool i2cslave_fit_is_checked(void)
+{
+	return is_fit_checked;
+}
+
+void i2cslave_fit_run_image(void)
+{
+	fit_run_image();
+}
+
+bool i2cslave_is_reset_dev(void)
+{
+	return false; /* TODO: Implement reset routine */
+}
+
+void i2cslave_reset_dev(void)
+{
+	/* TODO: Implement reset routine */
+}
+
+bool i2cslave_indirect_is_process_op(void)
+{
+	return i2csi_req_is_process_op();
+}
+
+void i2cslave_indirect_process_op(void)
+{
+	i2csi_req_handle_process_op();
+}
+
+bool i2cslave_indirect_op_is_fast(void)
+{
+	return i2csi_req_op_is_fast();
+}
+
+static void i2cslave_reset_buffer(struct i2cslave_buf *buf)
+{
+	buf->data = &i2cs_data.buf.cmd;
+	buf->cnt = 0;
+	buf->is_sync_error = false;
+	i2cslave_pec = 0;
+	i2cslave_pec_digest(I2C_SLAVE_ADDRESS << 1);
+}
+
+static void i2cslave_init(void)
+{
+	/* Check if already enabled */
+	if (regmap_readl(i2c_s.enable_reg))
+		return;
+
+	/* Program IC_SAR with address to which slave responds */
+	regmap_writel(I2C_SLAVE_ADDRESS, i2c_s.sar_reg);
+
+	/* Enable I2C Slave */
+	regmap_writel(0x1, global_conf.i2c_slv_reg);
+
+	/* Enable I2C Slave interrupts */
+	regmap_writel(0x0, global_conf.i2c_slv_intr_mask_reg);
+
+	/* Program IC_CON */
+	regmap_writel(0x22, i2c_s.con_reg);
+
+	/* Set INTR mask to default */
+	regmap_writel(I2C_SLAVE_DEFAULT_INTR_MASK, i2c_s.intr_mask_reg);
+
+	/* Write to IC_RX_TL to set Rx FIFO threshold level */
+	regmap_writel(0x0, i2c_s.rx_tl_reg);
+
+	/* Write to IC_TX_TL to set Tx FIFO threshold level */
+	regmap_writel(0x7, i2c_s.tx_tl_reg);
+
+	/* Write 1 to IC_ENABLE to enable DW_apb_i2c */
+	regmap_writel(0x1, i2c_s.enable_reg);
+}
+
+#define PSOC_I2C_S_IC_INTR_STAT_R_RX_UNDER_MASK		0x1
+#define PSOC_I2C_S_IC_INTR_STAT_R_RX_OVER_MASK		0x2
+#define PSOC_I2C_S_IC_INTR_STAT_R_TX_OVER_MASK		0x8
+#define PSOC_I2C_S_IC_INTR_STAT_R_TX_ABRT_MASK		0x40
+#define PSOC_I2C_S_IC_INTR_STAT_R_RX_DONE_MASK		0x80
+#define PSOC_I2C_S_IC_INTR_STAT_R_ACTIVITY_MASK		0x100
+#define PSOC_I2C_S_IC_INTR_STAT_R_STOP_DET_MASK		0x200
+#define PSOC_I2C_S_IC_INTR_STAT_R_START_DET_MASK	0x400
+#define PSOC_I2C_S_IC_INTR_STAT_R_GEN_CALL_MASK		0x800
+
+static uint32_t i2cslave_dw_read_clear_intrbits_slave(void)
+{
+	register uint32_t stat;
+
+	/*
+	 * The IC_INTR_STAT register just indicates "enabled" interrupts.
+	 * Ths unmasked raw version of interrupt status bits are available
+	 * in the IC_RAW_INTR_STAT register.
+	 *
+	 * That is,
+	 *   stat = regmap_readl(IC_INTR_STAT);
+	 * equals to,
+	 *   stat = regmap_readl(IC_RAW_INTR_STAT) & regmap_readl(IC_INTR_MASK);
+	 *
+	 * The raw version might be useful for debugging purposes.
+	 */
+	stat = regmap_readl(i2c_s.intr_stat_reg);
+
+	/*
+	 * Do not use the IC_CLR_INTR register to clear interrupts, or
+	 * you'll miss some interrupts, triggered during the period from
+	 * regmap_readl(IC_INTR_STAT) to regmap_readl(IC_CLR_INTR).
+	 *
+	 * Instead, use the separately-prepared IC_CLR_* registers.
+	 */
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_TX_ABRT_MASK)
+		regmap_readl(i2c_s.clr_tx_abrt_reg);
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_RX_UNDER_MASK)
+		regmap_readl(i2c_s.clr_rx_under_reg);
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_RX_OVER_MASK)
+		regmap_readl(i2c_s.clr_rx_over_reg);
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_TX_OVER_MASK)
+		regmap_readl(i2c_s.clr_tx_over_reg);
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_RX_DONE_MASK)
+		regmap_readl(i2c_s.clr_rx_done_reg);
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_ACTIVITY_MASK)
+		regmap_readl(i2c_s.clr_activity_reg);
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_STOP_DET_MASK)
+		regmap_readl(i2c_s.clr_stop_det_reg);
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_START_DET_MASK)
+		regmap_readl(i2c_s.clr_start_det_reg);
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_GEN_CALL_MASK)
+		regmap_readl(i2c_s.clr_gen_call_reg);
+
+	return stat;
+}
+
+#define PSOC_I2C_S_IC_INTR_STAT_R_RX_FULL_MASK		0x4
+#define PSOC_I2C_S_IC_INTR_STAT_R_RD_REQ_MASK		0x20
+
+static void i2cslave_flush(void)
+{
+	uint32_t stat = regmap_readl(i2c_s.intr_stat_reg);
+
+	if (stat & (PSOC_I2C_S_IC_INTR_STAT_R_RX_FULL_MASK |
+		    PSOC_I2C_S_IC_INTR_STAT_R_RD_REQ_MASK))
+		module_i2c_s_run();
+}
+
+void module_i2c_s_enable(void)
+{
+	i2cslave_init();
+
+	i2cslave_flush();
+	regmap_writel(0x1, i2c_s.enable_reg);
+	i2cslave_flush();
+}
+
+void i2cslave_pec_init(void)
+{
+	crc8_populate_msb(pec_table, HL_I2C_CRC8_POLYNOMIAL);
+}
+
+void i2cslave_pec_digest(uint8_t val)
+{
+	i2cslave_pec = crc8(pec_table, &val, 1, i2cslave_pec);
+}
+
+void module_i2c_s_setup(void)
+{
+	i2cslave_pec_init();
+	module_i2c_s_enable();
+}
+
+enum cmd_check_res module_i2c_s_check(void)
+{
+	uint32_t stat;
+
+	if (i2cslave_fit_is_checked() || i2cslave_is_reset_dev())
+		return FOUND_NO_RETURN;
+
+	stat = i2cslave_dw_read_clear_intrbits_slave();
+
+	if ((stat & PSOC_I2C_S_IC_INTR_STAT_R_RD_REQ_MASK) ||
+	    (stat & PSOC_I2C_S_IC_INTR_STAT_R_RX_FULL_MASK)) {
+		return FOUND_SLOW_RETURN;
+	}
+
+	if (i2cslave_indirect_is_process_op()) {
+		if (i2cslave_indirect_op_is_fast())
+			return FOUND_FAST_RETURN;
+		else
+			return FOUND_SLOW_RETURN;
+	}
+
+	return NOT_FOUND;
+}
+
+#define PSOC_I2C_S_IC_CON_IC_SLAVE_DISABLE_MASK		0x40
+
+void module_i2c_s_disable(void)
+{
+	uint32_t val;
+
+	i2cslave_flush();
+	regmap_writel(0x0, i2c_s.enable_reg);
+	udelay(100);
+
+	/* Write IC_SLAVE_DISABLE to IC_CON */
+	val = regmap_readl(i2c_s.con_reg);
+	val |= PSOC_I2C_S_IC_CON_IC_SLAVE_DISABLE_MASK;
+	regmap_writel(val, i2c_s.con_reg);
+
+	udelay(1000);
+
+	i2cslave_flush();
+}
+
+uint8_t i2cslave_pcie_vendor_id_cmd(uint8_t cmd)
+{
+	uint8_t ret;
+	uint32_t dev_id = arcboot_rom_get_device_id();
+
+	switch (cmd) {
+	case HL_PCIE_VENDOR_ID_VAL_LOW:
+		ret = PCI_VENDOR_ID_HABANALABS >> 8;
+		break;
+	case HL_PCIE_VENDOR_ID_VAL_HIGH:
+		ret = PCI_VENDOR_ID_HABANALABS & 0xFF;
+		break;
+	case HL_PCIE_DEVICE_ID_VAL_LOW:
+		ret = (uint8_t)(dev_id >> 8);
+		break;
+	case HL_PCIE_DEVICE_ID_VAL_HIGH:
+		ret = (uint8_t)dev_id;
+		break;
+	default:
+		ret = 0;
+		break;
+	}
+
+	return ret;
+}
+
+uint8_t i2cslave_handle_read_req(uint8_t cmd, uint32_t read_seq)
+{
+	uint32_t ret = 0;
+
+	switch (cmd) {
+	case HL_DEVICE_STATUS_CMD_CODE:
+		ret = HL_DEVICE_STATUS_CMD_CODE_LEN;
+		break;
+	case HL_DEVICE_STATUS:
+		ret = HL_DEVICE_STATUS_ARCBOOT;
+		break;
+	case HL_PCIE_VENDOR_ID_VAL_LOW:
+	case HL_PCIE_VENDOR_ID_VAL_HIGH:
+	case HL_PCIE_DEVICE_ID_VAL_LOW:
+	case HL_PCIE_DEVICE_ID_VAL_HIGH:
+		ret = i2cslave_pcie_vendor_id_cmd(cmd);
+		break;
+	case HL_INDIRECT_REQ_STS_CODE:
+		ret = HL_I2CI_REQ_STS_LEN;
+		break;
+	case HL_INDIRECT_REQ_STS_DATA:
+	case HL_INDIRECT_REQ_STS_DATA_1:
+	case HL_INDIRECT_REQ_STS_DATA_2:
+	case HL_INDIRECT_REQ_STS_DATA_3:
+	case HL_INDIRECT_REQ_STS_DATA_4:
+		ret = i2csi_req_handle_sts(cmd);
+		break;
+	case HL_INDIRECT_REQ_WDATA_CODE:
+		ret = HL_I2CI_REQ_WDATA_LEN;
+		break;
+	case HL_INDIRECT_REQ_CFG_CODE:
+		ret = HL_I2CI_REQ_CFG_LEN;
+		break;
+	case HL_INDIRECT_REQ_RDATA_CODE:
+		if (!read_seq) {
+			ret = HL_I2CI_REQ_RDATA_LEN;
+			break;
+		}
+	case HL_INDIRECT_REQ_RDATA_DATA:
+	case HL_INDIRECT_REQ_RDATA_DATA_1:
+	case HL_INDIRECT_REQ_RDATA_DATA_2:
+	case HL_INDIRECT_REQ_RDATA_DATA_3:
+		ret = i2csi_req_handle_rdata(cmd, read_seq);
+		break;
+	case HL_INDIRECT_CTRL_CMD_CODE:
+		ret = HL_I2CI_CTRL_CMD_LEN;
+		break;
+	case HL_INDIRECT_CTRL_STS_CODE:
+		ret = HL_I2CI_CTRL_STS_LEN;
+		break;
+	case HL_INDIRECT_CTRL_STS_DATA:
+	case HL_INDIRECT_CTRL_STS_DATA_1:
+	case HL_INDIRECT_CTRL_STS_DATA_2:
+	case HL_INDIRECT_CTRL_STS_DATA_3:
+		ret = i2csi_ctrl_handle_status(cmd);
+		break;
+	default:
+		if (HL_I2C_EVENT_IS_PEC(cmd))
+			ret = i2cslave_pec;
+		else
+			ret = 0;
+		break;
+	}
+
+	return ret;
+}
+
+uint32_t i2cslave_handle_write_req(uint8_t cmd, uint8_t **data, uint8_t cnt)
+{
+	switch (cmd) {
+	case HL_INDIRECT_REQ_WDATA_CODE:
+	case HL_INDIRECT_REQ_WDATA_DATA:
+		return i2csi_req_handle_wdata(cmd, data, cnt);
+	case HL_INDIRECT_REQ_CFG_CODE:
+	case HL_INDIRECT_REQ_CFG_DATA:
+	case HL_INDIRECT_REQ_CFG_PEC:
+		return i2csi_req_handle_cfg(cmd, data, cnt);
+	case HL_INDIRECT_CTRL_CMD_CODE:
+	case HL_INDIRECT_CTRL_CMD_DATA:
+	case HL_INDIRECT_CTRL_CMD_DATA_1:
+	case HL_INDIRECT_CTRL_CMD_DATA_2:
+	case HL_INDIRECT_CTRL_CMD_DATA_3:
+	case HL_INDIRECT_CTRL_CMD_PEC:
+		return i2csi_ctrl_handle_command(cmd, data, cnt);
+	case HL_INDIRECT_REQ_RDATA_CODE:
+	case HL_INDIRECT_REQ_RDATA_DATA:
+		i2csi_req_set_idle();
+		break;
+	default:
+		return 0;
+	}
+
+	return 0;
+}
+
+void i2cslave_handle_sync_error(void)
+{
+	i2csi_req_handle_sync_error();
+}
+
+static inline uint8_t *i2cslave_consume_hw(uint8_t *data, uint8_t cnt)
+{
+	register uint8_t val = (uint8_t)regmap_readl(i2c_s.data_cmd_reg);
+	register uint8_t cmd;
+	bool is_virt;
+	bool is_pec;
+
+	if (data) {
+		*data = (uint8_t)val;
+		data++;
+	}
+
+	/* New command code, save it for sequential increase */
+	if (!cnt)
+		i2cs_data.buf.seq_cmd = i2cs_data.buf.cmd;
+
+	cmd = i2cs_data.buf.seq_cmd;
+	is_virt = I2CSLAVE_IS_VIRTUAL_CMD(cmd);
+	if (!is_virt) {
+		is_pec = HL_I2C_EVENT_IS_PEC(cmd);
+		if (!is_pec)
+			i2cslave_pec_digest(val);
+
+		/* Increase command sequence for data bytes */
+		if (cnt)
+			i2cs_data.buf.seq_cmd = cmd + 1;
+	}
+
+	return data;
+}
+
+static inline uint32_t i2cslave_produce_handler(struct i2cslave_buf *buf)
+{
+	register uint32_t seq_wr = 0;
+	register uint8_t cmd = buf->cmd;
+
+	/* Just started to process and PEC cmd called directly */
+	buf->is_direct_pec = !buf->cnt && HL_I2C_EVENT_IS_PEC(cmd);
+
+	/* Notify upper layer */
+	if (!buf->is_direct_pec)
+		seq_wr = i2cslave_handle_write_req(cmd, &buf->data, buf->cnt);
+
+	if (seq_wr)
+		buf->cnt++;
+
+	return seq_wr;
+}
+
+static void module_i2c_s_do_write(void)
+{
+	register struct i2cslave_seq seq = i2cs_data.seq;
+	register uint8_t *data = i2cs_data.buf.data;
+	register uint8_t cnt = i2cs_data.buf.cnt;
+
+	/* Next read will start from offset 0 */
+	seq.rd = 0;
+
+	do {
+		/* Upper layer finished it's process, reset buffer */
+		if (!seq.wr) {
+			i2cslave_reset_buffer(&i2cs_data.buf);
+			seq.wr = 1;
+			data = i2cs_data.buf.data;
+			cnt = i2cs_data.buf.cnt;
+		}
+		/* Consume data as long as we expect it */
+		if (seq.wr) {
+			seq.wr--;
+			data = i2cslave_consume_hw(data, cnt);
+		}
+		/* Additional data is not expected, produce data */
+		if (!seq.wr) {
+			seq.wr = i2cslave_produce_handler(&i2cs_data.buf);
+			data = i2cs_data.buf.data;
+			cnt = i2cs_data.buf.cnt;
+		}
+	} while (regmap_readl(i2c_s.rxflr_reg));
+
+	i2cs_data.seq = seq;
+	i2cs_data.buf.data = data;
+}
+
+static inline uint8_t i2cslave_consume_handler(void)
+{
+	struct i2cslave_buf *buf = &i2cs_data.buf;
+	uint8_t seq_cmd = buf->seq_cmd;
+	uint8_t ret;
+
+	if (i2cs_data.buf.is_direct_pec)
+		return i2cslave_valid_pec;
+
+	/* Check if we are in the middle of write request processing */
+	if (i2cs_data.seq.wr) {
+		i2cslave_handle_sync_error();
+		i2cs_data.seq.wr = 0;
+		buf->is_sync_error = true;
+	}
+
+	if (buf->is_sync_error)
+		return 0;
+
+	ret = i2cslave_handle_read_req(seq_cmd, i2cs_data.seq.rd);
+
+	if (!i2cs_data.seq.rd)
+		i2cslave_pec_digest((I2C_SLAVE_ADDRESS << 1) | 1);
+
+	/* For next sequential read */
+	i2cs_data.seq.rd++;
+	if (!I2CSLAVE_IS_VIRTUAL_CMD(seq_cmd)) {
+		i2cs_data.buf.seq_cmd = seq_cmd + 1;
+		i2cslave_pec_digest(ret);
+	}
+
+	return ret;
+}
+
+static inline void i2cslave_produce_hw(uint8_t data)
+{
+	regmap_readl(i2c_s.clr_rd_req_reg);
+	regmap_readl(i2c_s.clr_rx_under_reg);
+	regmap_writel(data, i2c_s.data_cmd_reg);
+}
+
+static void module_i2c_s_do_read(void)
+{
+	uint8_t data = i2cslave_consume_handler();
+
+	i2cslave_produce_hw(data);
+}
+
+void module_i2c_s_run(void)
+{
+	uint32_t stat = regmap_readl(i2c_s.intr_stat_reg);
+
+	/*
+	 * Process the read request only after all the written data is
+	 * consumed.
+	 */
+	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_RX_FULL_MASK)
+		module_i2c_s_do_write();
+	else if (stat & PSOC_I2C_S_IC_INTR_STAT_R_RD_REQ_MASK)
+		module_i2c_s_do_read();
+	else
+		i2cslave_indirect_process_op();
+}
+
+void module_i2c_s_run_fast(void)
+{
+	i2cslave_indirect_process_op();
+}
+
+void module_i2c_s_teardown(void)
+{
+	uint32_t val;
+
+	/* Write 0 to IC_ENABLE to disable DW_apb_i2c */
+	regmap_writel(0, i2c_s.enable_reg);
+
+	/* wait for disable to impact */
+	udelay(100);
+
+	/* Disable all interrupts */
+	regmap_writel(0x0, i2c_s.intr_mask_reg);
+	regmap_readl(i2c_s.clr_intr_reg);
+
+	/* Write IC_SLAVE_DISABLE to IC_CON */
+	val = regmap_readl(i2c_s.con_reg);
+	val |= PSOC_I2C_S_IC_CON_IC_SLAVE_DISABLE_MASK;
+	regmap_writel(val, i2c_s.con_reg);
+
+	/* Make sure all transactions arrived */
+	udelay(1000);
+
+	i2cslave_flush();
+}
+
+void module_i2c_s_run_noret(void)
+{
+	module_i2c_s_teardown();
+	if (i2cslave_is_reset_dev())
+		i2cslave_reset_dev();
+	else
+		i2cslave_fit_run_image();
+}
