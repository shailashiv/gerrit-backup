+#ifndef _MODULE_I2C_SLAVE_H_
+#define _MODULE_I2C_SLAVE_H_
+
+#define I2CSLAVE_IS_VIRTUAL_CMD(cmd) (			\
+		(cmd) >= HL_INDIRECT_REQ_WDATA_CODE &&	\
+		(cmd) <= HL_INDIRECT_REQ_RDATA_DATA_3	\
+	)
+
+extern uint32_t err_sts_reg_val;
+
+uint8_t i2cslave_pcie_vendor_id_cmd(uint8_t cmd);
+uint8_t i2cslave_handle_read_req(uint8_t cmd, uint32_t read_seq);
+uint32_t i2cslave_handle_write_req(uint8_t cmd, uint8_t **data, uint8_t cnt);
+void i2cslave_handle_sync_error(void);
+void i2cslave_fit_set_checked(void);
+bool i2cslave_fit_is_checked(void);
+void i2cslave_fit_run_image(void);
+bool i2cslave_indirect_is_process_op(void);
+bool i2cslave_indirect_op_is_fast(void);
+void i2cslave_indirect_process_op(void);
+bool i2cslave_is_reset_dev(void);
+void i2cslave_reset_dev(void);
+
+extern uint8_t i2cslave_pec;		/* Ongoing digest of CRC-8 */
+extern uint8_t i2cslave_valid_pec;	/* To validate PEC by Master */
+
+void i2cslave_pec_init(void);
+void i2cslave_pec_digest(uint8_t val);
+
+#endif /* _MODULE_I2C_SLAVE_H_ */
