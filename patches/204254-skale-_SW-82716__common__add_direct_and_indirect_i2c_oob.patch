diff --git a/common/i2cslave_indirect.c b/common/i2cslave_indirect.c
new file mode 100644
index 0000000..eba79e4
--- /dev/null
+++ b/common/i2cslave_indirect.c
@@ -0,0 +1,828 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2022 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include <bitops.h>
+#include <arcboot.h>
+#include <address_space.h>
+#include <module_i2c_slave.h>
+#include <cmd_module.h>
+#include <hl_i2c_indirect_protocol.h>
+#include <hl_i2c_indirect.h>
+#include <hl_i2c_slave_events.h>
+#include <crc32.h>
+#include <hl_fw_if.h>
+#include <boot_desc.h>
+#include <memory.h>
+#include <efuse.h>
+
+#include "fit.h"
+#include "i2cslave_indirect.h"
+#include <sha.h>
+
+#define SUPPORTED_OPCODES_MASK	( \
+				BIT(HL_I2CI_REQ_OP_DEVICE_INFO) | \
+				BIT(HL_I2CI_REQ_OP_DEVICE_STATUS) | \
+				BIT(HL_I2CI_REQ_OP_CONFIG_ACCESS) | \
+				BIT(HL_I2CI_REQ_OP_MEMCPY_CTRL) | \
+				BIT(HL_I2CI_REQ_OP_MEMCPY_DATA) \
+				)
+
+#define FUSE_DEVID_SIZE		8
+
+struct i2csi_wdata_chunk_context {
+	uint16_t offset; /* Chunk offset within the request */
+	struct hl_i2ci_wdata_chunk_hdr hdr;
+};
+
+struct i2csi_wdata_read_context {
+	uint8_t *data; /* Pointer to data to be read */
+	uint16_t length;
+	union {
+		uint32_t crc;
+		uint8_t req_crc_data[4];
+	};
+	struct hl_i2ci_rdata_hdr hdr;
+};
+
+struct i2csi_wdata_write_context {
+	uint8_t *data;	/* Pointer to written data */
+	uint16_t offset;	/* Offset of overall written data */
+	uint16_t length;	/* Length of bytes to write in a single iteration */
+	uint32_t crc;	/* Calculated CRC */
+	union {
+		uint32_t req_crc;		/* Request CRC from master */
+		uint8_t req_crc_data[4];
+		uint8_t unused[4];		/* For unused data needed for CRC */
+	};
+	struct hl_i2ci_wdata_hdr hdr;
+};
+
+struct i2csi_block_write {
+	uint8_t length;
+	union {
+		struct hl_i2ci_wdata_hdr wdata;
+
+		struct {
+			struct hl_i2ci_req_cfg req_cfg;
+			uint8_t req_cfg_pec;
+		} __packed;
+
+		struct {
+			struct hl_i2ci_ctrl_cmd ctrl_cmd;
+			uint8_t ctrl_cmd_pec;
+		} __packed;
+	};
+} __packed;
+
+struct i2csi_block_write_context {
+	bool is_full_block;
+	struct i2csi_block_write data;
+};
+
+static struct i2csi_block_write_context block_write;
+
+static struct hl_i2ci_req_cfg req_cfg;
+static struct hl_i2ci_req_sts req_sts;
+static struct i2csi_wdata_chunk_context req_chunk;
+static struct i2csi_wdata_read_context req_rd;
+static struct i2csi_wdata_write_context req_wd;
+
+static struct hl_i2ci_device_status op_status = {
+	.device_status = HL_I2CI_REQ_DEV_STS_ARCBOOT,
+	.valid_opcode_map = SUPPORTED_OPCODES_MASK,
+};
+
+static struct hl_i2ci_device_info op_info = {
+	.device_id = 0,
+	.asic_sn = 0,
+};
+
+static struct hl_i2ci_config_access op_config;
+
+static uint32_t op_memcpy_offset;
+static struct hl_i2ci_memcpy_ctrl op_memcpy __aligned(8);
+
+struct hl_i2ci_error_status op_err_status;
+struct hl_i2ci_dram op_dram;
+
+static struct hl_i2ci_ctrl_cmd ctrl_cmd;
+static struct hl_i2ci_ctrl_sts ctrl_sts;
+
+static uint32_t i2csi_block_wait_for(uint8_t block_cmd, uint8_t cmd, uint8_t len, uint8_t **data)
+{
+	uint8_t offset = cmd - block_cmd;
+	bool is_virt = I2CSLAVE_IS_VIRTUAL_CMD(cmd);
+	uint8_t overhead;
+
+	*data = ((uint8_t *)&block_write.data) + offset;
+	if (is_virt || offset) {
+		block_write.is_full_block = false;
+		overhead = 1; /* Adding 1 for len byte itself */
+	} else {
+		block_write.is_full_block = true;
+		overhead = 2; /* Adding 2 for len and pec */
+	}
+
+	return len + overhead - offset;
+}
+
+static void i2csi_req_config_access(void)
+{
+	switch (op_config.command) {
+	case HL_I2CI_CONFIG_CMD_READ:
+		if (i2c_fwupd_owned(op_config.address))
+			op_config.data = i2c_fwupd_readl(op_config.address);
+		else
+			op_config.data = regmap_readl(op_config.address);
+
+		break;
+	case HL_I2CI_CONFIG_CMD_WRITE:
+		if (i2c_fwupd_owned(op_config.address))
+			i2c_fwupd_writel(op_config.address, op_config.data);
+		else
+			regmap_writel(op_config.data, op_config.address);
+
+		break;
+	}
+
+	op_config.status = HL_I2CI_CONFIG_STS_SUCCESS;
+}
+
+static void i2csi_req_load_fw(void)
+{
+	struct mem_desc desc;
+	/*
+	 * Received firmware length is the last requset RDQL + previous
+	 * requests length which is calculate by the header offset.
+	 * Integrity check is not supported for opcode 12 (load fw)
+	 */
+	unsigned int fw_len = req_wd.hdr.rqdl +
+		(req_wd.hdr.offset * HL_I2CI_REQ_MAX_RQDL);
+
+	arcboot_get_mem_region(MEM_I2C, &desc);
+
+	if (fit_validate_size((void *)desc.base, fw_len))
+		return; /* More data is needed */
+
+	if (fit_load_images((void *)desc.base))
+		req_sts.err = HL_I2CI_REQ_ERR_PROCESS;
+	else
+		i2cslave_fit_set_checked();
+
+}
+
+static void i2csi_req_memcpy_ctrl(void)
+{
+	op_memcpy.address = arcboot_rom_get_arc_addr(op_memcpy.address);
+	if (op_memcpy.address < SDRAM_BASE)
+		goto memcpy_ctrl_fail;
+
+	if (op_memcpy.address > SDRAM_BASE + SRAM_SIZE)
+		goto memcpy_ctrl_fail;
+
+	if (op_memcpy.size > SRAM_SIZE)
+		goto memcpy_ctrl_fail;
+
+	op_memcpy.status = HL_I2CI_MEMCPY_STS_PASS;
+	return;
+
+memcpy_ctrl_fail:
+	op_memcpy.status = HL_I2CI_MEMCPY_STS_FAIL;
+}
+
+static void i2csi_req_memcpy_iterate(void)
+{
+	uint32_t bytes_left;
+
+	switch (op_memcpy.status) {
+	case HL_I2CI_MEMCPY_STS_FAIL:
+	case HL_I2CI_MEMCPY_STS_PASS:
+		op_memcpy_offset = 0;
+		break;
+	case HL_I2CI_MEMCPY_STS_IN_PROGRESS:
+		bytes_left = op_memcpy.size - op_memcpy_offset;
+
+		if (bytes_left > HL_I2CI_MEMCPY_REQ_MAX) {
+			op_memcpy_offset += HL_I2CI_MEMCPY_REQ_MAX;
+		} else {
+			op_memcpy.status = HL_I2CI_MEMCPY_STS_PASS;
+			op_memcpy_offset = 0;
+		}
+
+		break;
+	}
+}
+
+static uint8_t *i2csi_req_memcpy_rw(uint16_t *length)
+{
+	uint32_t bytes_left;
+
+	bytes_left = op_memcpy.size - op_memcpy_offset;
+	if (bytes_left > HL_I2CI_MEMCPY_REQ_MAX)
+		*length = HL_I2CI_MEMCPY_REQ_MAX;
+	else
+		*length = bytes_left;
+
+	if (op_memcpy.status == HL_I2CI_MEMCPY_STS_FAIL) {
+		req_sts.err = HL_I2CI_REQ_ERR_PROCESS;
+		return NULL;
+	}
+
+	op_memcpy.status = HL_I2CI_MEMCPY_STS_IN_PROGRESS;
+	return (uint8_t *)(uintptr_t)(op_memcpy.address + op_memcpy_offset);
+}
+
+static inline void i2csi_req_wdata_wait_for(uint8_t *data, uint16_t length)
+{
+	if (req_wd.hdr.ic && !data && req_wd.offset < req_wd.hdr.rqdl) {
+		/* Data is coming but its unused, we still need to calc CRC */
+		req_wd.data = req_wd.unused;
+		if (length > sizeof(req_wd.unused))
+			length = sizeof(req_wd.unused);
+
+		req_wd.length = length;
+	} else {
+		req_wd.data = data;
+		req_wd.length = length;
+	}
+}
+
+static inline void i2csi_req_wdata_done(void)
+{
+	i2csi_req_wdata_wait_for(NULL, 0);
+}
+
+static void i2csi_req_buffer_get_writable(uint16_t rsize, uint8_t *data, int dlow,
+					  int dhigh)
+{
+	int rlow = req_wd.hdr.offset + req_wd.offset;
+	int rhigh = req_wd.hdr.offset + rsize;
+
+	/* Check out of bound */
+	if (rlow >= dhigh || rhigh <= dlow) {
+		/* If that is not a partial request, produce an error */
+		if (!req_wd.offset)
+			req_sts.err = HL_I2CI_REQ_ERR_P_WRITE_PERM;
+
+		i2csi_req_wdata_wait_for(NULL, rhigh - rlow);
+		return;
+	}
+
+	/*
+	 * Check if the lower part of the request tries to write before the
+	 * writable area. Ignore these bytes but don't produce an error since
+	 * the next iteration is valid.
+	 */
+	if (rlow < dlow) {
+		i2csi_req_wdata_wait_for(NULL, dlow - rlow);
+		return;
+	}
+
+	/*
+	 * Check if the write request overshoots the upper writable limit and
+	 * make adjusments accordingly.
+	 */
+	if (rhigh > dhigh)
+		rhigh = dhigh;
+
+	i2csi_req_wdata_wait_for(&data[rlow], rhigh - rlow);
+}
+
+static void i2csi_req_opcode_get_buffer(uint16_t size)
+{
+	int upper_bound;
+	uint8_t *data;
+	struct mem_desc mdesc;
+
+	switch (req_wd.hdr.opcode) {
+	case HL_I2CI_REQ_OP_CONFIG_ACCESS:
+		upper_bound = offsetof(struct hl_i2ci_config_access, status);
+
+		i2csi_req_buffer_get_writable(size, (uint8_t *)&op_config, 0,
+					      upper_bound);
+		break;
+
+	case HL_I2CI_REQ_OP_FW_LOADER:
+		/*
+		 * The firmware data is being placed directly to FIT base
+		 * buffer, it may be assembled by multiple requests so we used
+		 * the offset int the header an index.
+		 * Integrity check is not supported for opcode 12 (fw load)
+		 */
+		arcboot_get_mem_region(MEM_I2C, &mdesc);
+		data = (uint8_t *)mdesc.base +
+			(req_wd.hdr.offset * HL_I2CI_REQ_MAX_RQDL);
+		i2csi_req_wdata_wait_for(data, size);
+		break;
+
+	case HL_I2CI_REQ_OP_MEMCPY_CTRL:
+		upper_bound = offsetof(struct hl_i2ci_memcpy_ctrl, status);
+
+		i2csi_req_buffer_get_writable(size, (uint8_t *)&op_memcpy, 0,
+					      upper_bound);
+		break;
+
+	case HL_I2CI_REQ_OP_MEMCPY_DATA:
+		i2csi_req_memcpy_iterate();
+
+		if (op_memcpy.command != HL_I2CI_MEMCPY_CMD_WRITE)
+			op_memcpy.status = HL_I2CI_MEMCPY_STS_FAIL;
+
+		data = i2csi_req_memcpy_rw(&size);
+		i2csi_req_wdata_wait_for(data, size);
+		break;
+	default:
+		/* Data will be consumed from HW but not stored anywhere */
+		i2csi_req_wdata_wait_for(NULL, size);
+	}
+}
+
+static inline void i2csi_req_process_read_opcode(void)
+{
+	uint32_t sn_array[FUSE_DEVID_SIZE >> 2];
+
+	switch (req_wd.hdr.opcode) {
+	case HL_I2CI_REQ_OP_DEVICE_INFO:
+		if (!op_info.device_id)
+			op_info.device_id = (uint16_t)arcboot_rom_get_device_id();
+
+		if (!op_info.asic_sn) {
+			fuse_read(EFUSE_DEVICE_ID_0_OFFSET, &sn_array[0]);
+			fuse_read(EFUSE_DEVICE_ID_1_OFFSET, &sn_array[1]);
+			memcpy((uint8_t *)&op_info.asic_sn, sn_array, sizeof(op_info.asic_sn));
+		}
+
+		req_rd.data = (uint8_t *)&op_info;
+		req_rd.length = sizeof(op_info);
+		break;
+	case HL_I2CI_REQ_OP_DEVICE_STATUS:
+		op_status.used_btl_image_index = 0; /* No BTL index so set as 0 */
+		req_rd.data = (uint8_t *)&op_status;
+		req_rd.length = sizeof(op_status);
+		break;
+	case HL_I2CI_REQ_OP_CONFIG_ACCESS:
+		req_rd.data = (uint8_t *)&op_config;
+		req_rd.length = sizeof(op_config);
+		break;
+	case HL_I2CI_REQ_OP_MEMCPY_CTRL:
+		req_rd.data = (uint8_t *)&op_memcpy;
+		req_rd.length = sizeof(op_memcpy);
+		break;
+	case HL_I2CI_REQ_OP_MEMCPY_DATA:
+		i2csi_req_memcpy_iterate();
+
+		if (op_memcpy.command != HL_I2CI_MEMCPY_CMD_READ)
+			op_memcpy.status = HL_I2CI_MEMCPY_STS_FAIL;
+
+		req_rd.data = i2csi_req_memcpy_rw(&req_rd.length);
+		break;
+	default:
+		if ((BIT(req_wd.hdr.opcode) & SUPPORTED_OPCODES_MASK))
+			req_sts.err = HL_I2CI_REQ_ERR_P_WRITE_PERM;
+		else
+			req_sts.err = HL_I2CI_REQ_ERR_P_OPCODE;
+		break;
+	}
+}
+
+__weak bool i2c_config_is_address_valid(__unused uint32_t addr)
+{
+	return true;
+}
+
+static inline void i2csi_req_process_write_opcode(void)
+{
+	switch (req_wd.hdr.opcode) {
+	case HL_I2CI_REQ_OP_CONFIG_ACCESS:
+		if (i2c_config_is_address_valid(op_config.address))
+			i2csi_req_config_access();
+		else
+			req_sts.err = HL_I2CI_REQ_ERR_P_WRITE_PERM;
+		break;
+	case HL_I2CI_REQ_OP_FW_LOADER:
+		i2csi_req_load_fw();
+		break;
+	case HL_I2CI_REQ_OP_MEMCPY_CTRL:
+		i2csi_req_memcpy_ctrl();
+		break;
+	case HL_I2CI_REQ_OP_MEMCPY_DATA:
+		/* Do nothing */
+		break;
+	case HL_I2CI_REQ_OP_ERROR_STATUS:
+		/* Do nothing */
+		break;
+	default:
+		if ((BIT(req_wd.hdr.opcode) & SUPPORTED_OPCODES_MASK))
+			req_sts.err = HL_I2CI_REQ_ERR_P_WRITE_PERM;
+		else
+			req_sts.err = HL_I2CI_REQ_ERR_P_OPCODE;
+		break;
+	}
+}
+
+static void i2csi_req_wdata_handle_chunk(uint8_t cnt)
+{
+	if (cnt == 2) { /* Chunk (partial payload) is expected */
+		i2csi_req_opcode_get_buffer(req_chunk.hdr.rqcl);
+		if (req_wd.data)
+			req_wd.data += req_chunk.offset;
+
+		return;
+	}
+
+	/* Chunk received */
+	req_chunk.offset += req_chunk.hdr.rqcl;
+
+	/* Payload fully received */
+	if (req_chunk.offset == req_wd.hdr.rqdl) {
+		req_chunk.offset = 0;
+		req_sts.sm_sts = HL_I2CI_REQ_ST_PROCESS;
+	}
+
+	i2csi_req_wdata_done();
+}
+
+static void i2csi_req_wdata_handle_payload(void)
+{
+	/* Payload is expected */
+	if (req_wd.offset < req_wd.hdr.rqdl) {
+		i2csi_req_opcode_get_buffer(req_wd.hdr.rqdl);
+		return;
+	}
+
+	/* The payload has arrived, wait for CRC */
+	if (req_wd.hdr.ic) {
+		if (req_wd.offset < req_wd.hdr.rqdl + 4) {
+			i2csi_req_wdata_wait_for(req_wd.req_crc_data, 4);
+			return;
+		} else if (req_wd.req_crc != req_wd.crc) {
+			req_sts.sm_sts = HL_I2CI_REQ_ST_IDLE;
+			req_sts.err = HL_I2CI_REQ_ERR_INTEGRITY;
+			i2csi_req_wdata_done();
+			return;
+		}
+	}
+
+	/* Payload received */
+	req_sts.sm_sts = HL_I2CI_REQ_ST_PROCESS;
+	i2csi_req_wdata_done();
+}
+
+static inline void i2csi_req_reset(void)
+{
+	req_sts.err = HL_I2CI_REQ_ERR_NONE;
+	req_sts.rsdl = 0;
+	req_chunk.hdr.rqcl = 0;
+	req_rd.data = NULL;
+	req_rd.length = 0;
+	req_wd.length = 0;
+	req_wd.offset = 0;
+	req_wd.crc = 0;
+	req_wd.hdr.ic = 0;
+}
+
+void i2csi_req_wdata_handle_write(uint8_t cnt)
+{
+	if (cnt > 1) /* Skip the header */
+		req_wd.offset += req_wd.length;
+
+	if (req_chunk.hdr.rqcl) {
+		i2csi_req_wdata_handle_chunk(cnt);
+		return;
+	}
+
+	if (req_wd.hdr.ic && req_wd.length && req_wd.offset <= req_wd.hdr.rqdl)
+		req_wd.crc = crc32(req_wd.crc, req_wd.data, req_wd.length);
+
+	i2csi_req_wdata_handle_payload();
+}
+
+void i2csi_req_wdata_handle_read(uint8_t cnt)
+{
+	if (req_wd.hdr.ic) {
+		switch (cnt) {
+		case 1: /* Header received, wait for CRC */
+			i2csi_req_wdata_wait_for(req_wd.req_crc_data, 4);
+			return;
+
+		case 2: /* CRC received, validate it */
+			if (req_wd.req_crc != req_wd.crc) {
+				req_sts.sm_sts = HL_I2CI_REQ_ST_IDLE;
+				req_sts.err = HL_I2CI_REQ_ERR_INTEGRITY;
+				i2csi_req_wdata_done();
+				return;
+			}
+		}
+	}
+
+	req_sts.sm_sts = HL_I2CI_REQ_ST_PROCESS;
+
+	/* Data read with chunks is not supported */
+	if (req_chunk.hdr.rqcl)
+		req_sts.err = HL_I2CI_REQ_ERR_P_DATA_SIZE;
+	else
+		i2csi_req_process_read_opcode();
+
+	if (req_rd.data) {
+		if (req_wd.hdr.offset < req_rd.length) {
+			/* Adjust the read offset */
+			req_rd.data += req_wd.hdr.offset;
+			req_rd.length -= req_wd.hdr.offset;
+		} else {
+			/* Offset overshoots the read data */
+			req_rd.data = NULL;
+			req_rd.length = 0;
+		}
+
+		/* In case master requested partial data */
+		if (req_wd.hdr.rqdl < req_rd.length)
+			req_rd.length = req_wd.hdr.rqdl;
+
+		req_rd.hdr.rsdl = req_wd.hdr.rqdl;
+		req_sts.rsdl = req_wd.hdr.rqdl;
+		req_sts.sm_sts = HL_I2CI_REQ_ST_TRANSMIT;
+	} else {
+		req_sts.sm_sts = HL_I2CI_REQ_ST_IDLE;
+	}
+
+	i2csi_req_wdata_done();
+}
+
+/*
+ * Handle request port WDATA command. This command holds a data buffer which
+ * is being transferred by the master. The request may be divided into chunks
+ * and this function also handles this possibility.
+ *
+ * This function is being called 3-4 time per WDATA command. Depends whether
+ * the request is divided into chunks or not.
+ * - 1. [cnt=0] WDATA was recorded, wait for header.
+ * - 2. [cnt=1] Header arrived, wait for chunk header or payload
+ * - 3. [cnt=2,no chunks] - payload was written, done this WDATA command
+ *      [cnt=2,chunks]    - chunk header was written, wait for payload
+ * - 4. [cnt=3,chunks]    - payload was written, done this WDATA command
+ *
+ * Arguments:
+ * - cnt:  the number of time this function is called per current command
+ *         context.
+ */
+static void i2csi_req_wdata_process_data(uint8_t cnt)
+{
+	if (cnt == 1) { /* Chunk header or payload are expected */
+		req_wd.hdr = block_write.data.wdata;
+		if (HL_I2CI_REQ_RQCL_IS_EXISTS(req_wd.hdr)) {
+			i2csi_req_wdata_wait_for(req_chunk.hdr.data,
+						 HL_I2CI_REQ_CHUNK_LEN);
+			return;
+		}
+
+		if (req_wd.hdr.ic)
+			req_wd.crc = crc32(0, req_wd.hdr.data,
+					   sizeof(req_wd.hdr));
+	}
+
+	if (req_wd.hdr.write)
+		i2csi_req_wdata_handle_write(cnt);
+	else
+		i2csi_req_wdata_handle_read(cnt);
+}
+
+uint32_t i2csi_req_handle_wdata(uint8_t cmd, uint8_t **data, uint8_t cnt)
+{
+	if (!cnt) { /* Header is expected */
+		req_sts.sm_sts = HL_I2CI_REQ_ST_RECEIVE;
+		i2csi_req_reset();
+		block_write.data.wdata = req_wd.hdr;
+		return i2csi_block_wait_for(HL_INDIRECT_REQ_WDATA_CODE, cmd,
+					    HL_I2CI_REQ_WDATA_LEN, data);
+	}
+
+	i2csi_req_wdata_process_data(cnt);
+	*data = req_wd.data;
+
+	return req_wd.length;
+}
+
+/*
+ * Handle request port status reading by the master. Update the request status
+ * header with the latest WDATA opcode data and send it on its way.
+ */
+uint8_t i2csi_req_handle_sts(uint8_t cmd)
+{
+	int idx = cmd - HL_INDIRECT_REQ_STS_DATA;
+
+	if (idx >= HL_I2CI_REQ_STS_LEN)
+		return 0;
+
+	req_sts.opcode = req_wd.hdr.opcode;
+	req_sts.write = req_wd.hdr.write;
+	req_sts.ic = req_wd.hdr.ic;
+
+	return req_sts.data[idx];
+}
+
+/*
+ * Handle request port read request. Return the RDATA header, followed by the
+ * payload.
+ */
+uint8_t i2csi_req_handle_rdata(uint8_t cmd, uint32_t read_seq)
+{
+	int idx = cmd + read_seq - HL_INDIRECT_REQ_RDATA_DATA;
+	uint8_t zero = 0, rd_data;
+
+	/* Header */
+	if (idx < HL_I2CI_REQ_RDATA_LEN)
+		return req_rd.hdr.data[idx];
+
+	if (req_wd.hdr.ic && (uint32_t) idx == HL_I2CI_REQ_RDATA_LEN)
+		req_rd.crc = crc32(0, req_rd.hdr.data, HL_I2CI_REQ_RDATA_LEN);
+
+	/* Payload */
+	idx -= HL_I2CI_REQ_RDATA_LEN;
+	if (idx < req_rd.length) {
+		rd_data = req_rd.data[idx];
+		return rd_data;
+	}
+
+	if (req_wd.hdr.ic && idx < req_rd.hdr.rsdl + 4) {
+		if (idx == req_rd.length) {
+			req_rd.crc = crc32(req_rd.crc, req_rd.data,
+					   req_rd.length);
+		}
+
+		/* CRC trivial read 0 for reading of out bound */
+		if (idx < req_rd.hdr.rsdl)
+			req_rd.crc = crc32(req_rd.crc, &zero, 1);
+
+		/* CRC */
+		if (idx >= req_rd.hdr.rsdl && idx < req_rd.hdr.rsdl + 4) {
+			idx -= req_rd.hdr.rsdl;
+			if (idx < (int) sizeof(req_rd.req_crc_data))
+				return req_rd.req_crc_data[idx];
+		}
+	}
+
+	return 0;
+}
+
+/*
+ * Lower layer reports sync error. This means it expected the master to write
+ * bytes but instead is got a read request.
+ * In this case we zero out the state machine and buffer offsets.
+ */
+void i2csi_req_handle_sync_error(void)
+{
+	if (req_sts.sm_sts == HL_I2CI_REQ_ST_IDLE)
+		return;
+
+	req_chunk.offset = 0;
+	req_sts.sm_sts = HL_I2CI_REQ_ST_IDLE;
+	req_sts.rsdl = 0;
+	req_sts.err = HL_I2CI_REQ_ERR_P_DATA_SIZE;
+}
+
+/*
+ * Handle request port configuration register. Set the init bit in request
+ * status reply.
+ * This function is called when the lower layer needs a buffer to write the
+ * data to and the number of bytes it whould write before calling this function
+ * again.
+ *
+ * Arguments:
+ * - data: needs to be set to a designated buffer on which a new data will be
+ *         written into.
+ * - cnt:  the number of time this function is called per current command
+ *         context.
+ *
+ * Returns:
+ *   The number of bytes the lower layer should write into supplied buffer
+ *   before calling this function again. Returning 0 means the command handling
+ *   was finished.
+ */
+uint32_t i2csi_req_handle_cfg(uint8_t cmd, uint8_t **data, uint8_t cnt)
+{
+	if (!cnt) {/* Header is expected */
+		block_write.data.req_cfg = req_cfg;
+		return i2csi_block_wait_for(HL_INDIRECT_REQ_CFG_CODE, cmd,
+					    HL_I2CI_REQ_CFG_LEN, data);
+	}
+
+	if (block_write.is_full_block) {
+		i2cslave_valid_pec = i2cslave_pec;
+		if (i2cslave_pec != block_write.data.req_cfg_pec)
+			return 0;
+	}
+
+	req_cfg = block_write.data.req_cfg;
+
+	/* Request config received */
+	req_sts.init = req_cfg.init;
+	req_sts.sm_sts = HL_I2CI_REQ_ST_IDLE;
+	req_sts.err = HL_I2CI_REQ_ERR_NONE;
+
+	return 0;
+}
+
+void i2csi_req_set_idle(void)
+{
+	req_sts.sm_sts = HL_I2CI_REQ_ST_IDLE;
+	req_sts.rsdl = 0;
+	req_sts.err = HL_I2CI_REQ_ERR_NONE;
+}
+
+void i2csi_req_handle_process_op(void)
+{
+	i2csi_req_process_write_opcode();
+	req_sts.sm_sts = HL_I2CI_REQ_ST_IDLE;
+}
+
+bool i2csi_req_is_process_op(void)
+{
+	return req_sts.sm_sts == HL_I2CI_REQ_ST_PROCESS;
+}
+
+bool i2csi_req_op_is_fast(void)
+{
+	switch (req_wd.hdr.opcode) {
+	case HL_I2CI_REQ_OP_CONFIG_ACCESS:
+	case HL_I2CI_REQ_OP_MEMCPY_CTRL:
+	case HL_I2CI_REQ_OP_MEMCPY_DATA:
+		return true;
+	case HL_I2CI_REQ_OP_FW_LOADER:
+	default:
+		return false;
+	}
+}
+
+uint32_t i2csi_ctrl_handle_command(uint8_t cmd, uint8_t **data, uint8_t cnt)
+{
+	struct hl_i2ci_ctrl_cpsr *cpsr;
+
+	/* Command is expected */
+	if (!cnt) {
+		block_write.data.ctrl_cmd = ctrl_cmd;
+		return i2csi_block_wait_for(HL_INDIRECT_CTRL_CMD_CODE, cmd,
+					    HL_I2CI_CTRL_CMD_LEN, data);
+	}
+
+	if (block_write.is_full_block) {
+		i2cslave_valid_pec = i2cslave_pec;
+		if (i2cslave_pec != block_write.data.ctrl_cmd_pec)
+			return 0;
+	}
+
+	ctrl_cmd = block_write.data.ctrl_cmd;
+
+	ctrl_sts.tag = ctrl_cmd.tag;
+	ctrl_sts.status = HL_I2CI_CTRL_STS_BUSY;
+	ctrl_sts.error = HL_I2CI_CTRL_ERR_NONE;
+	cpsr = &ctrl_sts.cpsr;
+
+	switch (ctrl_cmd.opcode) {
+	case HL_I2CI_CTRL_OP_ABORT:
+		i2csi_req_set_idle();
+		cpsr->abort.status = HL_I2CI_CTRL_ABORT_NONE;
+		break;
+	case HL_I2CI_CTRL_OP_GET_API_VER:
+		cpsr->version.major = HL_I2CI_API_VERSION_MAJOR;
+		cpsr->version.minor = HL_I2CI_API_VERSION_MINOR;
+		cpsr->version.patch = HL_I2CI_API_VERSION_PATCH;
+		break;
+	case HL_I2CI_CTRL_OP_GET_OS_STATE:
+		cpsr->os_state.pcie_access = HL_I2CI_CTRL_ACCESS_FULL;
+		cpsr->os_state.mgmt_access = HL_I2CI_CTRL_ACCESS_FULL;
+		cpsr->os_state.os_state = HL_I2CI_CTRL_OS_ARCBOOT;
+		break;
+	case HL_I2CI_CTRL_OP_RESET_DEVICE:
+		/* Remain busy - action will take place from I2C SM */
+		return 0;
+	default:
+		ctrl_sts.error = HL_I2CI_CTRL_ERR_INVALID_OPCODE;
+	}
+
+	ctrl_sts.status = HL_I2CI_CTRL_STS_RESP_RDY;
+
+	return 0;
+}
+
+uint8_t i2csi_ctrl_handle_status(uint8_t cmd)
+{
+	register int idx = cmd - HL_INDIRECT_CTRL_STS_DATA;
+	uint8_t ret;
+
+	if (idx >= HL_I2CI_CTRL_STS_LEN)
+		return 0;
+
+	ret = ctrl_sts.data[idx];
+
+	/* Read till the end - return to idle */
+	if (idx == HL_I2CI_CTRL_STS_LEN - 1)
+		memset(ctrl_sts.data, 0, HL_I2CI_CTRL_STS_LEN);
+
+	return ret;
+}
