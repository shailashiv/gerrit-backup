From e78811b44430e97ba75c367ba1c961a4d6eb2993 Mon Sep 17 00:00:00 2001
From: Ran Shalit <rshalit@habana.ai>
Date: Thu, 25 Mar 2021 22:11:38 +0200
Subject: [PATCH] [SW-36011] gaudi: add spsram cmd for passing fit

Add SPSRAM command so that a fit can be passed
from fw-loader using Scratch pad SRAM.
This is required as part of passing nic enable info
in a fit using a secured transport layer (ELBI) from
host to FW preboot.

Change-Id: I23997d9334a1a0586af7ef38d33cceae514f25e8
Signed-off-by: Ran Shalit <rshalit@habana.ai>
---

diff --git a/gaudi/security.c b/gaudi/security.c
index 33f7f0e..84f0110 100644
--- a/gaudi/security.c
+++ b/gaudi/security.c
@@ -59,6 +59,7 @@
 #include <gaudi/gaudi_security.h>
 #include <spi.h>
 #include <sha256.h>
+#include <hl_fw_if.h>
 
 #include "common.h"
 
@@ -1490,11 +1491,13 @@
 	/*
 	 * PCIe IF HBW RRs are for direct access from PCIe IF to PSOC domain:
 	 * STM, SPI Flash, Scratchpad SRAM, PCIe FW SRAM.
-	 * Assign the PCIe IF RR_16 (0-15 and 28-31 are allocated for LBW) for
-	 * this job.
+	 * SPSRAM space for fit is used in dynamic RR.
+	 * Assign the PCIe IF RR_16 , RR_17 (0-15 and 28-31 are allocated for
+	 * LBW) for this job.
 	 * NOTE: The PCIe RRs use min/max concept and HIT is: min < hit < max
 	 */
-	preboot_secure_pcie_rr(16, mmSTM_BASE - 1, mmRAZWI_BASE);
+	preboot_secure_pcie_rr(16, mmSTM_BASE - 1, FIT_IMG_SPSRAM_BASE);
+	preboot_secure_pcie_rr(17, FIT_IMG_SPSRAM_END - 1, mmRAZWI_BASE);
 }
 
 static void preboot_security_pci_rtr_disable(int rr)
@@ -1593,6 +1596,7 @@
 	VERS_END_TO_IMG,
 	IMAGE,
 	IMG_END_TO_SRAM_END,
+	SPSRAM_IMAGE,
 };
 
 struct preboot_sec_dyn_pcie_rr_cfg {
@@ -1626,10 +1630,15 @@
 		.rr = PCIE_DYN_RR_SRAM_END,
 		.min = BOOT_FIT_END - 1,
 		.max = SRAM_END,
-	}
+	},
+	[SPSRAM_IMAGE] = {
+		.rr = PCIE_DYN_RR_SPSRAM_IMG,
+		.min = FIT_IMG_SPSRAM_BASE - 1,
+		.max = FIT_IMG_SPSRAM_END,
+	},
 };
 
-void preboot_security_dynamic_img_close(void)
+void preboot_security_dynamic_img_sram_close(void)
 {
 	struct preboot_sec_dyn_pcie_rr_cfg *cfg = &preboot_sec_dyn_cfg[IMAGE];
 
@@ -1639,11 +1648,27 @@
 	preboot_secure_pcie_rr(cfg->rr, cfg->min, cfg->max);
 }
 
-void preboot_security_dynamic_img_open(void)
+void preboot_security_dynamic_img_sram_open(void)
 {
 	preboot_secure_pcie_rr(preboot_sec_dyn_cfg[IMAGE].rr, 0, 0);
 }
 
+void preboot_security_dynamic_img_spsram_close(void)
+{
+	struct preboot_sec_dyn_pcie_rr_cfg *cfg =
+					&preboot_sec_dyn_cfg[SPSRAM_IMAGE];
+
+	if (!preboot_security_is_enabled())
+		return;
+
+	preboot_secure_pcie_rr(cfg->rr, cfg->min, cfg->max);
+}
+
+void preboot_security_dynamic_img_spsram_open(enum hl_upd_cmd cmd)
+{
+	preboot_secure_pcie_rr(preboot_sec_dyn_cfg[SPSRAM_IMAGE].rr, 0, 0);
+}
+
 void preboot_security_dynamic_vers_init(u64 vers_off, u32 size)
 {
 	struct preboot_sec_dyn_pcie_rr_cfg *cfg;
diff --git a/greco_arc_gnu/common.h b/greco_arc_gnu/common.h
index f069c99..28945f6 100644
--- a/greco_arc_gnu/common.h
+++ b/greco_arc_gnu/common.h
@@ -24,6 +24,9 @@
 #define PPBOOT_TEXT_BASE	(FW_SRAM_BASE + 0xC)
 #define PREBOOT_TEXT_BASE	(SP_SRAM_BASE + SP_SRAM_PREBOOT_OFFSET + 0x8)
 
+#define HL_SP_SRAM_BASE		SP_SRAM_BASE
+#define HL_SP_SRAM_SIZE		0x10000
+
 /*
  * TODO: this address is wrong, a good address must be set in order to use
  * boot info API.
diff --git a/include/preboot.h b/include/preboot.h
index 5e7c464..5424e9f 100644
--- a/include/preboot.h
+++ b/include/preboot.h
@@ -24,6 +24,12 @@
 #define HL_UART_BAUDRATE	115200
 #define HL_SPI_FLASH_MAX_FREQ	25000000
 
+#define FIT_IMG_SPSRAM_MAX_SIZE		0x2000
+#define FIT_IMG_SPSRAM_END		(HL_SP_SRAM_BASE + HL_SP_SRAM_SIZE)
+#define FIT_IMG_SPSRAM_BASE		(FIT_IMG_SPSRAM_END - \
+					 FIT_IMG_SPSRAM_MAX_SIZE)
+
+
 #ifndef __ASSEMBLY__
 
 #include <stddef.h>
diff --git a/include/security.h b/include/security.h
index a9a8c87..ff1689e 100644
--- a/include/security.h
+++ b/include/security.h
@@ -13,8 +13,10 @@
 void preboot_security_init(void);
 void preboot_security_dynamic_init(void);
 void preboot_security_dynamic_vers_init(u64 ver_off, u32 size);
-void preboot_security_dynamic_img_close(void);
-void preboot_security_dynamic_img_open(void);
+void preboot_security_dynamic_img_sram_close(void);
+void preboot_security_dynamic_img_sram_open(void);
+void preboot_security_dynamic_img_spsram_close(void);
+void preboot_security_dynamic_img_spsram_open(void);
 void preboot_security_cleanup_before_run(void);
 void preboot_security_dbi_lock(void);
 void preboot_security_sp_sram_write_key_hash(u8 *key, size_t len);
diff --git a/preboot/fit.c b/preboot/fit.c
index 9206308..d078a8b 100644
--- a/preboot/fit.c
+++ b/preboot/fit.c
@@ -813,7 +813,7 @@
 int fit_load_images(void)
 {
 	enum fit_sec_failure sec_res = FIT_SEC_NONE;
-	void *fit = (void *)FIT_IMG_BASE;
+	void *fit = (void *)fit_base_offset;
 	int err;
 
 	memset(&images, 0x0, sizeof(images));
@@ -868,7 +868,7 @@
 
 int fit_validate_size(int len)
 {
-	const void *fit = (void *)FIT_IMG_BASE;
+	const void *fit = (void *)fit_base_offset;
 
 	if (fdt_check_header(fit)) {
 		preboot_puts("Bad FIT header\n");
@@ -877,3 +877,39 @@
 
 	return fdt_totalsize(fit) != len;
 }
+
+int fit_get_load_type(u32 *load_type)
+{
+	const void *fit = (const void *)fit_base_offset;
+	const u32 *cell;
+	u32 type = FIT_LOAD_TYPE_RUN;
+	int ret, len, conf;
+
+	ret = fit_check_format(fit);
+	if (!ret)
+		return 1;
+
+	conf = fit_find_config_node(fit);
+	if (conf >= 0) {
+		cell = fdt_getprop(fit, conf, FIT_LOAD_TYPE_PROP, &len);
+		if (!cell) {
+			preboot_puts("load type does not exist!");
+			*load_type = type;
+			return 0;
+		}
+		if (len != sizeof(*cell)) {
+			preboot_puts("Currupted load type\n");
+			return 1;
+		}
+
+		type = fdt32_to_cpu(*cell);
+		if (type >= FIT_LOAD_TYPE_COUNT) {
+			preboot_puts_hex("Unsupported load type ", type, false);
+			return 1;
+		}
+	}
+
+	*load_type = type;
+
+	return 0;
+}
