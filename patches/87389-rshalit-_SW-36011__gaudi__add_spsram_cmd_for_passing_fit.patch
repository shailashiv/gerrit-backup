diff --git a/preboot/module_fwupd.c b/preboot/module_fwupd.c
index e7c5615..e41451b 100644
--- a/preboot/module_fwupd.c
+++ b/preboot/module_fwupd.c
@@ -24,6 +24,8 @@
 
 static bool is_fit_checked;
 
+uintptr_t fit_base_offset;
+
 void module_fwupd_setup(void)
 {
 	struct hl_upd_status status  = { .val = 0 };
@@ -45,7 +47,9 @@
 		return FOUND_FAST_RETURN;
 	case HL_UPD_RST_STATE:
 	case HL_UPD_MAP_SRAM:
+	case HL_UPD_MAP_SPSRAM:
 	case HL_UPD_RUN_SRAM:
+	case HL_UPD_RUN_SPSRAM:
 		return FOUND_SLOW_RETURN;
 	default:
 		return NOT_FOUND;
@@ -81,57 +85,105 @@
 {
 	module_fwupd_send_status(HL_UPD_STS_RST_ACK, 0);
 
-	preboot_security_dynamic_img_close();
+	preboot_security_dynamic_img_sram_close();
+	preboot_security_dynamic_img_spsram_close();
 
 	/* reset state should never fail */
 	module_fwupd_wfc(WFC_TIMEOUT_MS);
 	module_fwupd_send_status(HL_UPD_STS_RST_OK, 0);
 }
 
-static void module_fwupd_sram_map(unsigned int size, enum hl_upd_cmd cmd)
+static void module_fwupd_map(unsigned int size, enum hl_upd_cmd cmd)
 {
 	int err;
 	enum hl_upd_sts sts;
 
+	fit_base_offset = (cmd == HL_UPD_MAP_SRAM) ? FIT_IMG_BASE :
+						FIT_IMG_SPSRAM_BASE;
 	module_fwupd_send_status(HL_UPD_STS_MAP_ACK, 0);
 
-	err = !preboot_is_valid_address_range(FIT_IMG_BASE, size);
+	err = !preboot_is_valid_address_range(fit_base_offset, size);
 	if (err) {
 		sts = HL_UPD_STS_VALID_ERR;
 		preboot_puts("Mapped address range is invalid\n");
 		goto fwupd_map_err;
 	}
 
-	preboot_security_dynamic_img_open();
+	if (cmd == HL_UPD_MAP_SRAM)
+		preboot_security_dynamic_img_sram_open();
+	else
+		preboot_security_dynamic_img_spsram_open();
 
 	err = module_fwupd_wfc(WFC_TIMEOUT_MS);
 	if (err)
 		goto fwupd_map_wfc_t;
 
-	module_fwupd_send_status(HL_UPD_STS_MAP_OK, (void *)FIT_IMG_BASE);
+	module_fwupd_send_status(HL_UPD_STS_MAP_OK, (void *)fit_base_offset);
 	return;
 
 fwupd_map_wfc_t:
 	sts = HL_UPD_STS_TIMEOUT_ERR;
 	preboot_puts("Timeout error\n");
 
-	preboot_security_dynamic_img_close();
+	if (cmd == HL_UPD_MAP_SRAM)
+		preboot_security_dynamic_img_sram_close();
+	else
+		preboot_security_dynamic_img_spsram_close();
 
 fwupd_map_err:
 	module_fwupd_send_status(sts, 0);
 }
 
-static void module_fwupd_sram_run(void)
+static int module_fwupd_load_type_nic_en(void *fit)
+{
+	/* TODO handle nic en here */
+	return 0;
+}
+
+static int module_fwupd_load_type_run(void)
+{
+	is_fit_checked = !fit_load_images();
+	if (!is_fit_checked)
+		return 1;
+
+	return 0;
+}
+
+static int module_fwupd_load_type(void)
+{
+	u32 load_type;
+	void *fit = (void *)fit_base_offset;
+	int ret = fit_get_load_type(&load_type);
+
+	if (ret)
+		return 1;
+
+	switch (load_type) {
+	case FIT_LOAD_TYPE_NIC_EN_MASK:
+		return module_fwupd_load_type_nic_en(fit);
+	case FIT_LOAD_TYPE_RUN:
+		return module_fwupd_load_type_run();
+	default:
+		return 1;
+	}
+
+	return 0;
+}
+
+static void module_fwupd_run_cmd(enum hl_upd_cmd cmd)
 {
 	int err;
 	enum hl_upd_sts sts;
 
 	module_fwupd_send_status(HL_UPD_STS_RUN_ACK, 0);
 
-	preboot_security_dynamic_img_close();
+	if (cmd == HL_UPD_RUN_SRAM)
+		preboot_security_dynamic_img_sram_close();
+	else
+		preboot_security_dynamic_img_spsram_close();
 
-	is_fit_checked = !fit_load_images();
-	if (!is_fit_checked) {
+	err = module_fwupd_load_type();
+	if (err) {
 		sts = HL_UPD_STS_VALID_ERR;
 		preboot_puts("Failed to load FIT image\n");
 		goto fwupd_run_err;
@@ -151,7 +203,10 @@
 fwupd_run_err:
 	module_fwupd_send_status(sts, 0);
 
-	preboot_security_dynamic_img_open();
+	if (cmd == HL_UPD_RUN_SRAM)
+		preboot_security_dynamic_img_sram_open();
+	else
+		preboot_security_dynamic_img_spsram_open();
 }
 
 void module_fwupd_run(void)
@@ -170,11 +225,19 @@
 		break;
 	case HL_UPD_MAP_SRAM:
 		preboot_puts("FW UPD MAP SRAM received\n");
-		module_fwupd_sram_map(cmd.size, cmd.cmd);
+		module_fwupd_map(cmd.size, cmd.cmd);
+		break;
+	case HL_UPD_MAP_SPSRAM:
+		preboot_puts("FW UPD MAP SPSRAM received\n");
+		module_fwupd_map(cmd.size, cmd.cmd);
 		break;
 	case HL_UPD_RUN_SRAM:
 		preboot_puts("FW UPD RUN SRAM received\n");
-		module_fwupd_sram_run();
+		module_fwupd_run_cmd(cmd.cmd);
+		break;
+	case HL_UPD_RUN_SPSRAM:
+		preboot_puts("FW UPD RUN SPSRAM received\n");
+		module_fwupd_run_cmd(cmd.cmd);
 		break;
 	default:
 		break;
diff --git a/preboot/module_lkd.c b/preboot/module_lkd.c
