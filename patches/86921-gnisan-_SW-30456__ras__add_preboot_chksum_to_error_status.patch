From 9976b4ad24fadb3b5d8a44e25e9b493adb2e8201 Mon Sep 17 00:00:00 2001
From: Guy Nisan <gnisan@habana.ai>
Date: Tue, 06 Apr 2021 16:22:31 +0300
Subject: [PATCH] [SW-30456] ras: add preboot chksum to error status

Check preboot primary and secondary checksum for error status

Change-Id: I2178ee835ef965a34ca64ef598544bef966a564f
Signed-off-by: Guy Nisan <gnisan@habana.ai>
---

diff --git a/preboot/i2cslave_indirect.c b/preboot/i2cslave_indirect.c
index f21536f..76b1128 100644
--- a/preboot/i2cslave_indirect.c
+++ b/preboot/i2cslave_indirect.c
@@ -15,6 +15,8 @@
 #include <hl_i2c_slave_events.h>
 #include <crc32.h>
 #include <hl_fw_if.h>
+#include <boot_desc.h>
+#include <spi.h>
 #include "fit.h"
 #include "i2cslave_indirect.h"
 #include <rma_if.h>
@@ -109,6 +111,8 @@
 static struct hl_i2ci_ctrl_cmd ctrl_cmd;
 static struct hl_i2ci_ctrl_sts ctrl_sts;
 struct rma_failure i2c_rma_failure;
+
+static bool err_chksum_avail;
 
 static u32 i2csi_block_wait_for(u8 block_cmd, u8 cmd, u8 len, u8 **data)
 {
@@ -394,6 +398,44 @@
 	fw_info.reset_cause = HL_FW_RESET_CAUSE_UNKNOWN;
 }
 
+static void i2csi_err_chksum_validate(void)
+{
+	struct boot_desc desc;
+	enum fw_post_reset_cmd role[] = {
+		FLOPS_UPD_NOOP,		/* Primary */
+		FLOPS_UPD_PENDING,	/* Secondary */
+	};
+	u8 hash[SHA256_SUM_LEN];
+	bool is_valid, is_prime;
+	u32 idx;
+	int i;
+
+	if (!boot_desc_init()) {
+		preboot_puts_raw("Not a valid boot desc.");
+		return;
+	}
+
+	for (i = 0; i < 2; i++) {
+		idx = boot_desc_get_img_desc(role[i], HL_FW_IMG_PREBOOT, &desc);
+		if (idx == HL_FW_IMG_NOT_FOUND)
+			continue;
+
+		is_prime = !i;
+		/* Using fit image base as playground */
+		spi_copy((void *)FIT_IMG_BASE, desc.spi_offset, desc.img_size,
+			 NULL);
+		sha256_csum((void *)FIT_IMG_BASE, desc.img_size, hash);
+		is_valid = !memcmp(hash, desc.chksum, ARRAY_SIZE(hash));
+
+		if (is_prime)
+			op_err_status.checksum.spi.preboot_primary = !is_valid;
+		else
+			op_err_status.checksum.spi.preboot_secondary = !is_valid;
+	}
+
+	err_chksum_avail = true;
+}
+
 static inline void i2csi_req_process_read_opcode(void)
 {
 	switch (req_wd.hdr.opcode) {
@@ -431,6 +473,9 @@
 	case HL_I2CI_REQ_OP_ERROR_STATUS:
 		i2csi_update_rma_entry();
 		i2csi_err_status_set_wd();
+		if (!err_chksum_avail)
+			i2csi_err_chksum_validate();
+
 		req_rd.data = (u8 *)&op_err_status;
 		req_rd.length = sizeof(op_err_status);
 		break;
