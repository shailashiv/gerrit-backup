From c896c266ce6eace4a73eee159bef939dec4e1b52 Mon Sep 17 00:00:00 2001
From: Michael Pauzner <mpauzner@habana.ai>
Date: Tue, 29 Apr 2025 14:52:42 +0300
Subject: [PATCH] [SW-221270] gaudi3: serdes: remove serdes table usage

Cleanup old, unused source code under #ifdef section.

Change-Id: Ie181148c3991fab2ad38421afb578247484f6284
Signed-off-by: Michael Pauzner <mpauzner@habana.ai>
---

diff --git a/margin-tools/serdes/src/gaudi3/gaudi3_serdes.c b/margin-tools/serdes/src/gaudi3/gaudi3_serdes.c
index 579c038..29429ae 100644
--- a/margin-tools/serdes/src/gaudi3/gaudi3_serdes.c
+++ b/margin-tools/serdes/src/gaudi3/gaudi3_serdes.c
@@ -54,96 +54,6 @@
 	return 0;
 }
 
-#ifdef SERDES_TABLE_SUPPORT
-static const struct hl_serdes_config *get_serdes_info(void)
-{
-	int rc;
-	uint8_t cpld_link_conf;
-	struct hl_serdes_config *table;
-	uint32_t tbl_len, serdes_type;
-
-	rc = hl_serdes_get_serdes_table(&table, &tbl_len);
-	if (rc) {
-		serdes_err("hl_serdes_get_serdes_table failed (%d)\n", rc);
-		return NULL;
-	}
-
-	rc = cpld_get_link_config_may_fail(&cpld_link_conf);
-	if (rc) {
-		serdes_err("cpld_get_link_config_may_fail() failed (%d)\n", rc);
-		return NULL;
-	}
-
-	for (serdes_type = 0; serdes_type < tbl_len; serdes_type++)
-		if (cpld_link_conf == table[serdes_type].link_id)
-			return &table[serdes_type];
-
-	serdes_err("Read an unknown SerDes type from CPLD: 0x%x\n", cpld_link_conf);
-
-	return NULL;
-}
-static int get_setup_type(const struct hl_serdes_config *serdes_cfg,
-	enum gaudi3_setup_type *type)
-{
-	switch (serdes_cfg->link_id) {
-	case HLS3_FULLSCALE_IN_SERDES_LINK_ID:
-	case HLS3_FULLSCALE_OUT_SERDES_LINK_ID:
-	case HLS3_FULL_OAM_3PORTS_SCALE_OUT_SERDES_LINK_ID:
-	case HLS3_FULL_OAM_6PORTS_SCALE_OUT_SERDES_LINK_ID:
-	case HLS3_SINGLEPORT_OAM_FULLSCALE_OUT_SERDES_LINK_ID:
-		serdes_info("Setup type: GAUDI3_SETUP_TYPE_HLS3\n");
-		*type = GAUDI3_SETUP_TYPE_HLS3;
-		break;
-	case HLB325_FULL_OAM_3PORTS_SCALE_OUT_SERDES_LINK_ID:
-		serdes_info("Setup type: GAUDI3_SETUP_TYPE_HLB325\n");
-		*type = GAUDI3_SETUP_TYPE_HLB325;
-		break;
-	default:
-		serdes_err("Unrecognized CPLD link config: 0x%x\n", serdes_cfg->link_id);
-		return -1;
-	}
-
-	return 0;
-}
-
-static int hl_cn_dev_preinit(struct hl_cn_device *hdev,
-			     const struct gaudi3_redundancy_ctx *ctx)
-{
-	int rc;
-	const struct hl_serdes_config *serdes_cfg;
-	enum gaudi3_setup_type setup_type;
-
-	serdes_cfg = get_serdes_info();
-	if (!serdes_cfg)
-		return -1;
-
-	serdes_info("SerDes config: cpucp_serdes_type %u link_id 0x%x\n",
-		    serdes_cfg->type, serdes_cfg->link_id);
-
-	rc = get_setup_type(serdes_cfg, &setup_type);
-	if (rc)
-		return rc;
-
-	hdev->card_location = hl_get_mezz_id();
-	hdev->gaudi3_setup_type = (u8)setup_type;
-	hdev->phys_auto_neg_mask = serdes_cfg->autoneg_mask[hdev->card_location];
-	hdev->ports_mask = serdes_cfg->enable_mask[hdev->card_location];
-	hdev->ext_ports_mask = serdes_cfg->external_mask[hdev->card_location];
-	hdev->asic_type = HL_ASIC_GAUDI3;
-	hdev->num_of_dies = ctx->num_of_dies;
-	hdev->lanes_per_port = PORT_LANES_2;
-	hdev->phy_calc_ber = true;
-	hdev->skip_phy_init = false;
-	hdev->skip_phy_default_tx_taps_cfg = false;
-	hdev->skip_phy_pol_cfg = false;
-	hdev->use_fw_serdes_info = false;
-	hdev->in_reset = false;
-	hdev->pldm = false;
-	hdev->lane_speed_50g = false;
-
-	return 0;
-}
-#else
 static int get_setup_type(uint8_t link_id, enum gaudi3_setup_type *setup_type)
 {
 	switch (link_id) {
@@ -214,7 +124,6 @@
 
 	return 0;
 }
-#endif
 
 static int nic_kmd_cn_phy_init(struct hl_cn_device *hdev,
 			       const struct gaudi3_redundancy_ctx *ctx)
