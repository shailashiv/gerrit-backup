From 1142b1690d2f14b65900547a14ccd824d52bd8e9 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Thu, 18 Oct 2018 06:29:25 +0300
Subject: [PATCH] GOYA PLDM: update clock rates

Since we go new model
---

diff --git a/board/habanalabs/goya/uboot_pldm.fragment b/board/habanalabs/goya/uboot_pldm.fragment
index 9c28c66..007cd03 100644
--- a/board/habanalabs/goya/uboot_pldm.fragment
+++ b/board/habanalabs/goya/uboot_pldm.fragment
@@ -1,8 +1,8 @@
-CONFIG_SYS_CLK_FREQ=164000
+CONFIG_SYS_CLK_FREQ=150000
 CONFIG_CONARGS="serial0:1200n8"
 CONFIG_BAUDRATE=1200
 CONFIG_BOOTDELAY=10
-CONFIG_DEBUG_UART_CLOCK=27000
+CONFIG_DEBUG_UART_CLOCK=25000
 CONFIG_BOOTCOMMAND="getfit && bootm $fileaddr#conf@1"
 CONFIG_DEFAULT_DEVICE_TREE="goya_pldm"
 CONFIG_SPI_FLASH_MACRONIX=y
