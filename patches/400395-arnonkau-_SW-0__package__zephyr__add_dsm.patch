From 723e3b4ffdec45a209530f4f9ae4d4eed3541428 Mon Sep 17 00:00:00 2001
From: Arnon Kaufman <akaufman@habana.ai>
Date: Sun, 03 Mar 2024 11:57:14 +0200
Subject: [PATCH] [SW-0] package: zephyr: add dsm

DSM should be built when creating the zephyr target

Change-Id: Ifad6bc1523ff242422302fcfc8759c7ddedd770d
Signed-off-by: Arnon Kaufman <akaufman@habana.ai>
---

diff --git a/package/zephyr/zephyr.mk b/package/zephyr/zephyr.mk
index 04c07c8..64457a7 100644
--- a/package/zephyr/zephyr.mk
+++ b/package/zephyr/zephyr.mk
@@ -81,6 +81,10 @@
 HL_ZEPHYR_PACKAGES += preboot-d1
 endif
 
+ifdef BR2_PACKAGE_ZEPHYR_DSM
+HL_ZEPHYR_PACKAGES += dsm
+endif
+
 ifdef BR2_PACKAGE_ZEPHYR_AGENT_FW_LOADER
 HL_ZEPHYR_PACKAGES += agent-fwl
 endif
