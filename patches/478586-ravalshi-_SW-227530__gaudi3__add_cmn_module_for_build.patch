diff --git a/CMakeLists.txt b/CMakeLists.txt
index 482ee5c..87266ba 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -21,7 +21,10 @@
 target_include_directories(app PRIVATE src/)
