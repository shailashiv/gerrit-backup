+#define PPBOOT_DCCM_BASE	0x2706402C
 
 #define SDRAM_BASE		0x11000000
 #define HL_SPI_BASE		0x26000000
@@ -57,4 +58,9 @@
 
 #define FW_WORD_NUM		0x2200	/* FW_SIZE / 2 */
 
+#ifndef __ASSEMBLY__
+void init_secondary(void);
+extern void secondary_entry(void);
+#endif
+
 #endif /* COMMON_GAUDI2_ARC_GNU_H_ */
diff --git a/arch/gaudi2/arc/secondary.S b/arch/gaudi2/arc/secondary.S
new file mode 100644
index 0000000..753af2c
--- /dev/null
+++ b/arch/gaudi2/arc/secondary.S
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier:     GPL-2.0+ */
+/*
+ * Copyright (C) 2021 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+.global secondary_entry
+secondary_entry:
+	mov	sp, 0x27020400	/* stack top set to secondary CPU DCCM 1k offset */
+	mov	fp, sp
+	bl	secondary_main
