@@ -0,0 +1,32 @@
+HLS3_BMC_VERSION = 1.0.0
+HLS3_BMC_SITE = openbmc
+HLS3_BMC_LICENSE = unclear
+
+HLS3_IMAGE = $(HLS3_IMAGE_DIR)/$(HLS3_IMAGE_NAME)
+HLS3_PHOSPHOR_IMAGE = $(HLS3_IMAGE_DIR)/$(HLS3_PHOSPHOR_IMAGE_NAME)
+HLS3_PHOSPHOR_FULLCHIP_IMAGE = $(HLS3_IMAGE_DIR)/$(HLS3_PHOSPHOR_FULLCHIP_IMAGE_NAME)
+VERSION_FILE := $(HLS3_DEPLOY_DIR)/localversion-habanalabs
+
+define SET_VERSION_INFO
+	export HL_VERSION=$(shell cut -c2- $(VERSION_FILE))
+endef
+
+define HLS3_BMC_BUILD_CMDS
+	(cd $(@D); 							\
+		$(SET_VERSION_INFO);					\
+		$(HLS3_ENV)						\
+		$(HLS3_BITBAKE_ENV)					\
+		bitbake obmc-phosphor-image;				\
+	)
+endef
+
+HLS3_BMC_INSTALL_IMAGES = YES
+
+define HLS3_BMC_INSTALL_IMAGES_CMDS
+	$(INSTALL) -m 0644 -D $(@D)/$(HLS3_PHOSPHOR_IMAGE) $(BINARIES_DIR)/$(HLS3_PHOSPHOR_IMAGE_NAME)
+	$(INSTALL) -m 0644 -D $(@D)/$(HLS3_PHOSPHOR_FULLCHIP_IMAGE) $(BINARIES_DIR)/$(HLS3_PHOSPHOR_FULLCHIP_IMAGE_NAME)
+	$(INSTALL) -m 0755 -D ${BR2_EXTERNAL_HABANALABS_PATH}/package/hls3-bmc/install-hls3.sh $(BINARIES_DIR)/install-hls3.sh
+	$(INSTALL) -m 0755 -D ${BR2_EXTERNAL_HABANALABS_PATH}/package/hls3-bmc/install-hls3-check-dependencies.sh $(BINARIES_DIR)/install-hls3-check-dependencies.sh
+endef
+
+$(eval $(generic-package))
