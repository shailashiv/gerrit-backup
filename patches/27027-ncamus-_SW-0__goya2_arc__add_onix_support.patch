From b735f3031633f4862806c7d1c1cc9bdb4a1a96d3 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Mon, 03 Feb 2020 07:08:41 +0200
Subject: [PATCH] [SW-0] goya2_arc: add onix support

Missing file fails compilation for FPGA platform

Change-Id: Ic5d9a11c1d3a55f5f0bc8fd0b99b3b5d997d1734
---

diff --git a/goya2_arc/onix.c b/goya2_arc/onix.c
new file mode 100644
index 0000000..e922152
--- /dev/null
+++ b/goya2_arc/onix.c
@@ -0,0 +1,52 @@
+/*
+ * (C) Copyright 2019 HabanaLabs, Ltd.
+ * Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#include <stdbool.h>
+
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+
+#define SYS_CLOCK_FREQUENCY	35000000ULL
+#define UART_CLOCK_FREQUENCY	(SYS_CLOCK_FREQUENCY / 5)
+#define PLDM_UART_BAUDRATE	57600
+
+bool hl_pll_is_configurable(struct hl_pll_cfg *cfg)
+{
+	return false;
+}
+
+int hl_pll_get_cfg(struct hl_pll_cfg **hl_pll_cfg)
+{
+	return 0;
+}
+
+u32 hl_skip_pcie_init(void)
+{
+	return 1;
+}
+
+u64 hl_pll_get_cpu_cycles_per_usec(void)
+{
+	return SYS_CLOCK_FREQUENCY / USEC_PER_SEC;
+}
+
+void hl_uart_init(void)
+{
+	preboot_uart_init(UART_CLOCK_FREQUENCY / PLDM_UART_BAUDRATE);
+}
+
+u32 hl_spi_baudr_get(void)
+{
+	u32 factor = 2; /* Min Divider */
+
+	/* baud rate doesn't support odd number */
+	return (factor + 1) & 0xFFFE;
+}
+
+void preboot_init_pcie_phy(void) {}
+
