Subject: [PATCH] [JSW-705] jgs: module: remove unwanted jgs code

This patch removes unnecessary or additional code
which was kept previously as part of cleanup,
just to pass ci.

Change-Id: I0dbd3818e3cd31a9be56963c030d8b611ef8c1d9
---

diff --git a/include/jgs/hl_pcie.h b/include/jgs/hl_pcie.h
index a71d158..e9177a1 100644
--- a/include/jgs/hl_pcie.h
+++ b/include/jgs/hl_pcie.h
@@ -26,7 +26,6 @@
 	uint32_t hbm_size_mb;	/* depends on hbm type and binning */
 };
 
-int fs1_bmu_init(struct bmu_configs *config);
 int jgs_bmu_init(struct bmu_configs *config);
 
 #endif /* NOC_CFG_INCLUDE_JGS_HL_PCIE_H_ */
diff --git a/src/jgs/hl_pcie.c b/src/jgs/hl_pcie.c
index 7c39221..bede835 100644
--- a/src/jgs/hl_pcie.c
+++ b/src/jgs/hl_pcie.c
@@ -438,27 +438,6 @@
  *   - 1PF + 1VF
  *   - 1PF + 4VF
  */
-int fs1_bmu_init(struct bmu_configs *config)
-{
-	int err;
-
-	LOG_INF("BMU configs version %s", BMU_CONFIGS_VERSION);
-
-	switch (config->phase) {
-	case BMU_DEVELOPMENT_MODE:
-		err = bmu_devel_init(config);
-		break;
-	case BMU_PRODUCTION_MODE:
-		err = bmu_prod_init(config);
-		break;
-	default:
-		LOG_ERR("unsupported BMU mode %d", config->phase);
-		err = -1;
-	}
-
-	return err;
-}
-
 int jgs_bmu_init(struct bmu_configs *config)
 {
 	int err;
