From c3f82068de0763b67cfe640ab17212ee44b60fff Mon Sep 17 00:00:00 2001
From: Arnon Kaufman <akaufman@habana.ai>
Date: Wed, 16 Jun 2021 10:19:53 +0300
Subject: [PATCH] [SW-45908] security: check fit access in range

When checking the incoming FIT validity the size of the fit should fit
into the SRAM valid address space. The same goes with the FIT's footer.
Before accessing the fit or footer the calculated intended address is
checked against the valid SRAM boundaries.

Change-Id: I5d7dbe7a46424e4574a341bfb99581df5b616b66
Signed-off-by: Arnon Kaufman <akaufman@habana.ai>
---

diff --git a/arch/gaudi/security.c b/arch/gaudi/security.c
index b2aefaf..9b33d9d 100644
--- a/arch/gaudi/security.c
+++ b/arch/gaudi/security.c
@@ -1851,6 +1851,13 @@
 	/* security descriptor is at the footer of the image */
 	fit_sec_off = (const void *)((u8 *)img + img_size);
 
+	/* check that the calculated memory range are legal */
+	if (!preboot_sram_is_valid_address_range((uintptr_t)fit_sec_off,
+						 sizeof(fit_sec))) {
+		preboot_puts("Invalid address range\n");
+		return 1;
+	}
+
 	memcpy(&fit_sec, fit_sec_off, FIT_SEC_DESC_SIZE);
 
 	if (fit_sec.magic_number != FIT_SEC_MAGIC) {
diff --git a/preboot/fit.c b/preboot/fit.c
index 417e1b7..78cac6c 100644
--- a/preboot/fit.c
+++ b/preboot/fit.c
@@ -784,6 +784,10 @@
 	if (fdt_version(fit) < FDT_MIN_SUPPORTED_VERSION)
 		return FIT_LOAD_SEC_FAILED;
 
+	/* check that the calculated memory range are legal */
+	if (!preboot_sram_is_valid_address_range((uintptr_t)fit, fit_size))
+		return FIT_LOAD_SEC_FAILED;
+
 	/* Get number of images in preboot configuration */
 	conf = fit_find_config_node(fit);
 	if (conf < 0)
