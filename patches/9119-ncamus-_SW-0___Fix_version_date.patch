From f6ed8cc7bda10dcf1ff3d514b340bc0b7db4eaee Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Tue, 19 Feb 2019 16:29:50 +0200
Subject: [PATCH] [SW-0]: Fix version date

Make sure it is in english (and not hebrew)

Change-Id: I6e71c1ee7d6ee226ffa856113cedfe34c827f454
---

diff --git a/Makefile b/Makefile
index e6410cb..7cce54f 100644
--- a/Makefile
+++ b/Makefile
@@ -41,7 +41,7 @@
 
 $(AUTO_GENERATED_FILE): localversion-habanalabs $(PREBOOT_SRCS_C) $(PREBOOT_SRCS_S)
 	@( printf '#define PREBOOT_VER "%s"\n' '$(shell cut -d- -f2- localversion-habanalabs)' ) > $@
-	@date +'#define PREBOOT_DATE "%b %d %C%y"' >> $@
+	@LANG=en_us date +'#define PREBOOT_DATE "%b %d %Y"' >> $@
 	@date +'#define PREBOOT_TIME "%T"' >> $@
 
 %.o: %.c $(AUTO_GENERATED_FILE)
