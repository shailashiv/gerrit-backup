-ARCBOOT_COMMON_SRCS_C := $(shell ls common/*.c common/rsa/*.c $(HL_DEV)/$(HL_TARGET).c)
-ARCBOOT_COMMON_SRCS_C += $(shell ls $(HL_DEV)/security.c)
