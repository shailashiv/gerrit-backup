+
+void security_enable_jtag_mstr_if(void)
+{
+	/* don't override AXI prot bit by master IF */
+	regmap_writel(0, mmJT_MSTR_IF_CORE_HBW_AXPROT_OVRD);
+
+	/* enable pcie traffic by writing 1 */
+	regmap_writel(GAUDI2_ENABLE_PCIE_TRAFFIC,
+		mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_PCIE_EN);
+
+	/* enable access to all */
+	/* MIN = 0xFFFFFFFFFFFFF
+	 * MAX = 0
+	 */
+	regmap_writel(GAUDI2_SECURITY_END_HBW_LSB,
+		mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_0);
+	regmap_writel(GAUDI2_SECURITY_END_HBW_MSB,
+		mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_0);
+	regmap_writel(GAUDI2_SECURITY_START_HBW_LSB,
+		mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_0);
+	regmap_writel(GAUDI2_SECURITY_START_HBW_MSB,
+		mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_0);
+
+	/* LBW is not implemented for JT, so nothing to be done there */
+}
+
+void security_disable_twi_if(void)
+{
+	security_disable_i2c_s_mstr_if();
+	security_disable_smi_mstr_if();
+}
+
+void security_enable_twi_if(void)
+{
+	security_enable_i2c_s_mstr_if();
+	security_enable_smi_mstr_if();
+}
+
+void security_jtag_dap(uint8_t status)
+{
+	regmap_writel(status, mmPSOC_CS_TRACE_SECURITY_CTRL);
+}
+
+void security_debug_if_shared(void)
+{
+	/* There is no concept of shared engine in Gaudi2 */
+}
+
+static void security_pcie_mstr_rr_hbw_config(uint8_t spi_controller_en)
+{
+	uint64_t flash_start = GAUDI2_SECURITY_FLASH_START_HBW >> 12;
+	uint64_t flash_end = GAUDI2_SECURITY_FLASH_END_HBW >> 12;
+
+
+	regmap_writel(GAUDI2_SECURITY_START_HBW_LSB,
+		      mmPCIE_MSTR_RR_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_0);
+	regmap_writel(GAUDI2_SECURITY_START_HBW_MSB,
+		      mmPCIE_MSTR_RR_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_0);
+
+	if (spi_controller_en) {
+		/*
+		 * No need to open any region. All access would be done
+		 * through LBW
+		 */
+	} else {
+		regmap_writel((flash_start & 0xFFFFFFFF),
+		      mmPCIE_MSTR_RR_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_0);
+		regmap_writel((flash_start >> 32),
+		      mmPCIE_MSTR_RR_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_0);
+
+		regmap_writel((flash_end & 0xFFFFFFFF),
+		      mmPCIE_MSTR_RR_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_1);
+		regmap_writel((flash_end >> 32),
+		      mmPCIE_MSTR_RR_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_1);
+	}
+		regmap_writel(GAUDI2_SECURITY_END_HBW_LSB,
+		      mmPCIE_MSTR_RR_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_1);
+		regmap_writel(GAUDI2_SECURITY_END_HBW_MSB,
+		      mmPCIE_MSTR_RR_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_1);
+}
+
+static void security_pcie_mstr_rr_lbw_config(uint8_t spi_controller_en)
+{
+	/* get lower [26:0] to program into LBW space */
+	uint32_t psoc_security_start_lbw = (mmPSOC_SECURITY_BASE & 0x7FFFFFF);
+	uint32_t psoc_security_end_lbw =
+				(mmJT_MSTR_IF_RR_SHRD_HBW_BASE & 0x7FFFFFF);
+	uint32_t psoc_qspi_base_start_lbw = (mmPSOC_QSPI_BASE & 0x7FFFFFF);
+	uint32_t psoc_qspi_base_end_lbw = (mmPSOC_UART_0_BASE & 0x7FFFFFF);
+
+	regmap_writel(SECURITY_PSOC_START_LBW,
+		mmPCIE_MSTR_RR_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MIN_0);
+
+	if (spi_controller_en) {
+		regmap_writel(psoc_qspi_base_start_lbw,
+			mmPCIE_MSTR_RR_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MAX_0);
+		regmap_writel(psoc_qspi_base_end_lbw,
+			mmPCIE_MSTR_RR_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MIN_1);
+		regmap_writel(psoc_security_start_lbw,
+			mmPCIE_MSTR_RR_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MAX_1);
+		regmap_writel(psoc_security_end_lbw,
+			mmPCIE_MSTR_RR_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MIN_2);
+		regmap_writel(SECURITY_PSOC_END_LBW,
+			mmPCIE_MSTR_RR_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MAX_2);
+	} else {
+		regmap_writel(psoc_security_start_lbw,
+			mmPCIE_MSTR_RR_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MAX_0);
+		regmap_writel(psoc_security_end_lbw,
+			mmPCIE_MSTR_RR_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MIN_1);
+		regmap_writel(SECURITY_PSOC_END_LBW,
+			mmPCIE_MSTR_RR_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MAX_1);
+	}
+}
+
+void security_i2c_s_rr_hbw_config(uint8_t spi_controller_en)
+{
+	/* This can be done by eROM, since this is called,
+	 * after the Image verification is failed for PRI/SEC
+	 */
+	uint64_t security_addr_start = mmPSOC_SECURITY_BASE >> 12;
+	uint64_t security_addr_end = mmJT_MSTR_IF_RR_SHRD_HBW_BASE >> 12;
+	uint64_t psoc_qspi_base_start = mmPSOC_QSPI_BASE >> 12;
+	uint64_t psoc_qspi_base_end = mmPSOC_UART_0_BASE >> 12;
+	uint64_t flash_start = GAUDI2_SECURITY_FLASH_START_HBW >> 12;
+	uint64_t flash_end = GAUDI2_SECURITY_FLASH_END_HBW >> 12;
+
+	regmap_writel(GAUDI2_SECURITY_START_HBW_LSB,
+		      mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_0);
+	regmap_writel(GAUDI2_SECURITY_START_HBW_MSB,
+		      mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_0);
+
+	if (spi_controller_en) {
+		regmap_writel((psoc_qspi_base_start & 0xFFFFFFFF),
+		      mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_0);
+		regmap_writel((psoc_qspi_base_start >> 32),
+		      mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_0);
+
+		regmap_writel((psoc_qspi_base_end & 0xFFFFFFFF),
+		      mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_1);
+		regmap_writel((psoc_qspi_base_end >> 32),
+		      mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_1);
+	} else {
+		regmap_writel((flash_start & 0xFFFFFFFF),
+		      mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_0);
+		regmap_writel((flash_start >> 32),
+		      mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_0);
+
+		regmap_writel((flash_end & 0xFFFFFFFF),
+		      mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_1);
+		regmap_writel((flash_end >> 32),
+		      mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_1);
+	}
+
+	regmap_writel((security_addr_start & 0xFFFFFFFF),
+		      mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_1);
+	regmap_writel((security_addr_start >> 32),
+		      mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_1);
+
+	regmap_writel((security_addr_end & 0xFFFFFFFF),
+		      mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_2);
+	regmap_writel((security_addr_end >> 32),
+		      mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_2);
+	regmap_writel(GAUDI2_SECURITY_END_HBW_LSB,
+		      mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_2);
+	regmap_writel(GAUDI2_SECURITY_END_HBW_MSB,
+		      mmI2C_S_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_2);
+}
+
+void security_smi_rr_hbw_config(uint8_t spi_controller_en)
+{
+	/* This can be done by eROM, since this is called,
+	 * after the Image verification is failed for PRI/SEC
+	 */
+	uint64_t security_addr_start = mmPSOC_SECURITY_BASE >> 12;
+	uint64_t security_addr_end = mmJT_MSTR_IF_RR_SHRD_HBW_BASE >> 12;
+	uint64_t psoc_qspi_base_start = mmPSOC_QSPI_BASE >> 12;
+	uint64_t psoc_qspi_base_end = mmPSOC_UART_0_BASE >> 12;
+	uint64_t flash_start = GAUDI2_SECURITY_FLASH_START_HBW >> 12;
+	uint64_t flash_end = GAUDI2_SECURITY_FLASH_END_HBW >> 12;
+
+	regmap_writel(GAUDI2_SECURITY_START_HBW_LSB,
+		      mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_0);
+	regmap_writel(GAUDI2_SECURITY_START_HBW_MSB,
+		      mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_0);
+
+	if (spi_controller_en) {
+		regmap_writel((psoc_qspi_base_start & 0xFFFFFFFF),
+		      mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_0);
+		regmap_writel((psoc_qspi_base_start >> 32),
+		      mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_0);
+
+		regmap_writel((psoc_qspi_base_end & 0xFFFFFFFF),
+		      mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_1);
+		regmap_writel((psoc_qspi_base_end >> 32),
+		      mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_1);
+	} else {
+		regmap_writel((flash_start & 0xFFFFFFFF),
+		      mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_0);
+		regmap_writel((flash_start >> 32),
+		      mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_0);
+
+		regmap_writel((flash_end & 0xFFFFFFFF),
+		      mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_1);
+		regmap_writel((flash_end >> 32),
+		      mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_1);
+	}
+
+	regmap_writel((security_addr_start & 0xFFFFFFFF),
+		      mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_1);
+	regmap_writel((security_addr_start >> 32),
+		      mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_1);
+
+	regmap_writel((security_addr_end & 0xFFFFFFFF),
+		      mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_2);
+	regmap_writel((security_addr_end >> 32),
+		      mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_2);
+	regmap_writel(GAUDI2_SECURITY_END_HBW_LSB,
+		      mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_2);
+	regmap_writel(GAUDI2_SECURITY_END_HBW_MSB,
+		      mmSMI_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_2);
+}
+
+void security_jtag_rr_hbw_config(uint8_t spi_controller_en)
+{
+	uint64_t security_addr_start = mmPSOC_SECURITY_BASE >> 12;
+	uint64_t security_addr_end = mmJT_MSTR_IF_RR_SHRD_HBW_BASE >> 12;
+	uint64_t psoc_qspi_base_start = mmPSOC_QSPI_BASE >> 12;
+	uint64_t psoc_qspi_base_end = mmPSOC_UART_0_BASE >> 12;
+	uint64_t flash_start = GAUDI2_SECURITY_FLASH_START_HBW >> 12;
+	uint64_t flash_end = GAUDI2_SECURITY_FLASH_END_HBW >> 12;
+
+	regmap_writel(GAUDI2_SECURITY_START_HBW_LSB,
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_0);
+	regmap_writel(GAUDI2_SECURITY_START_HBW_MSB,
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_0);
+
+	if (spi_controller_en) {
+		regmap_writel((psoc_qspi_base_start & 0xFFFFFFFF),
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_0);
+		regmap_writel((psoc_qspi_base_start >> 32),
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_0);
+
+		regmap_writel((psoc_qspi_base_end & 0xFFFFFFFF),
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_1);
+		regmap_writel((psoc_qspi_base_end >> 32),
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_1);
+	} else {
+		regmap_writel((flash_start & 0xFFFFFFFF),
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_0);
+		regmap_writel((flash_start >> 32),
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_0);
+
+		regmap_writel((flash_end & 0xFFFFFFFF),
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_1);
+		regmap_writel((flash_end >> 32),
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_1);
+	}
+
+	regmap_writel((security_addr_start & 0xFFFFFFFF),
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_1);
+	regmap_writel((security_addr_start >> 32),
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_1);
+
+	regmap_writel((security_addr_end & 0xFFFFFFFF),
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_2);
+	regmap_writel((security_addr_end >> 32),
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_2);
+	regmap_writel(GAUDI2_SECURITY_END_HBW_LSB,
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_2);
+	regmap_writel(GAUDI2_SECURITY_END_HBW_MSB,
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_2);
+}
+
+static void security_elbi_rr_lbw_config(uint8_t spi_controller_en)
+{
+	/* get lower [26:0] to program into LBW space */
+	uint32_t psoc_security_start_lbw = (mmPSOC_SECURITY_BASE & 0x7FFFFFF);
+	uint32_t psoc_security_end_lbw =
+				(mmJT_MSTR_IF_RR_SHRD_HBW_BASE & 0x7FFFFFF);
+	uint32_t psoc_qspi_base_start_lbw = (mmPSOC_QSPI_BASE & 0x7FFFFFF);
+	uint32_t psoc_qspi_base_end_lbw = (mmPSOC_UART_0_BASE & 0x7FFFFFF);
+
+	regmap_writel(SECURITY_PSOC_START_LBW,
+		mmPCIE_ELBI_RR_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MIN_0);
+
+	if (spi_controller_en) {
+		regmap_writel(psoc_qspi_base_start_lbw,
+			mmPCIE_ELBI_RR_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MAX_0);
+		regmap_writel(psoc_qspi_base_end_lbw,
+			mmPCIE_ELBI_RR_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MIN_1);
+		regmap_writel(psoc_security_start_lbw,
+			mmPCIE_ELBI_RR_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MAX_1);
+		regmap_writel(psoc_security_end_lbw,
+			mmPCIE_ELBI_RR_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MIN_2);
+		regmap_writel(SECURITY_PSOC_END_LBW,
+			mmPCIE_ELBI_RR_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MAX_2);
+	} else {
+		regmap_writel(psoc_security_start_lbw,
+			mmPCIE_ELBI_RR_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MAX_0);
+		regmap_writel(psoc_security_end_lbw,
+			mmPCIE_ELBI_RR_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MIN_1);
+		regmap_writel(SECURITY_PSOC_END_LBW,
+			mmPCIE_ELBI_RR_MSTR_IF_RR_SHRD_LBW_PRIV_RANGE_MAX_1);
+	}
+}
+
+void security_pcie_rr_config(uint8_t spi_en)
+{
+	regmap_writel(PCIE_WRAP_PCIE_PROT_OVR_WR_EN_MASK |
+		      PCIE_WRAP_PCIE_PROT_OVR_RD_EN_MASK,
+		      mmPCIE_WRAP_PCIE_PROT_OVR);
+
+	/* NO Shared Initiator bits for Gaudi2, hence no need to set the mask */
+
+	security_elbi_rr_lbw_config(spi_en);
+	security_pcie_mstr_rr_hbw_config(spi_en);
+	security_pcie_mstr_rr_lbw_config(spi_en);
+}
+
+void rom_get_hash(uint32_t *key_hash)
+{
+	uint32_t *ptr = (uint32_t *)rom_key_hashes;
+	int size = NUM_KEYS_IN_ROM * SECURITY_DWORD_PER_KEY;
+
+	for (int i = 0; i < size; i++)
+		*(key_hash + i) = *(ptr + i);
+}
+
+static void security_store_keys_in_psoc(uint8_t max_keys, uint32_t *hash)
+{
+	/*
+	 * Just store the top 256 bits of each hash, due to the
+	 * limited space available in PSOC Security
+	 */
+	uint8_t max_dwords_stored = NUM_DWORDS_AVLBL_IN_PSOC_SEC, i, j;
+	uint32_t key_soc_location_base;
+	uint32_t key_address[] = {
+		mmPSOC_SECURITY_HABANA_KEY_0,
+		mmPSOC_SECURITY_PUBLIC_KEY_0_0,
+		mmPSOC_SECURITY_PUBLIC_KEY_1_0,
+		mmPSOC_SECURITY_PUBLIC_KEY_2_0,
+		mmPSOC_SECURITY_PUBLIC_KEY_3_0
+	};
+
+	for (i = 0; i < max_keys; i++) {
+		key_soc_location_base = key_address[i];
+		for (j = 0; j < max_dwords_stored; j++) {
+			regmap_writel(hash[(i * SECURITY_DWORD_PER_KEY) + j],
+					key_soc_location_base);
+			key_soc_location_base += sizeof(uint32_t);
+		}
+	}
+}
+
+void security_load_keys(void)
+{
+	uint8_t hash_key_index, num_dwords, max_keys = NUM_KEYS_IN_ROM;
+	uint32_t key_hash[NUM_KEYS_IN_ROM * SECURITY_DWORD_PER_KEY];
+	enum security_key_location key_location;
+
+	key_location = ((arcboot_rom_global.config_fuse >>
+			EFUSE_SYSCFG_KEY_LOCATION) &
+			EFUSE_SYSCFG_KEY_LOCATION_MASK);
+
+	arcboot_rom_status_update(PROGRESS_KEY_LOC);
+	arcboot_rom_status_update_location(PROGRESS_KEY_LOC_0, key_location);
+
+	switch (key_location) {
+	case KEY_LOCATION_EFUSE:
+		max_keys = NUM_KEYS_IN_EFUSE;
+		efuse_get_hash(key_hash);
+		break;
+	case KEY_LOCATION_ROM:
+	default:
+		rom_get_hash(key_hash);
+		break;
+	}
+
+	/* store hashes in the limited space available in PSOC_SECURITY */
+	security_store_keys_in_psoc(max_keys, key_hash);
+
+	/* ROM Keys are already in ROM, no need to store them explicitly */
+	if (key_location == KEY_LOCATION_EFUSE) {
+		/* Store the efuse keys in SPSRAM */
+		num_dwords = NUM_KEYS_IN_EFUSE * SECURITY_DWORD_PER_KEY;
+		for (hash_key_index = 0; hash_key_index < num_dwords;
+						hash_key_index++)
+			sp_sram_writel(key_hash[hash_key_index],
+			       SECURITY_EFUSE_KEYS_OFFSET + (hash_key_index *
+			       SECURITY_BYTE_PER_DWORD));
+	}
+}
+
+void check_and_enable_4b_termination(void)
+{
+	/* Not needed for Gaudi2 */
+}
+
+void security_disable_interfaces(void)
+{
+	/* by default disable jtag I/F as soon as possible */
+	security_disable_jtag_if();
+
+	/* by default disable TWI I/F as soon as possible */
+	security_disable_twi_if();
+}
+
+void security_handle_twi(void)
+{
+	if ((arcboot_rom_global.config_fuse &
+			EFUSE_SYSCFG_DISABLE_TWI_IF_MASK) == 0)
+		security_enable_twi_if();
+}
+
+void security_disable_jtag_if(void)
+{
+	security_jtag_dap(SECURITY_JTAG_DAP_DISABLE);
+	security_disable_jtag_mstr_if();
+}
+
+void security_enable_jtag_if(void)
+{
+	security_jtag_dap(SECURITY_JTAG_DAP_ENABLE);
+	security_enable_jtag_mstr_if();
+}
