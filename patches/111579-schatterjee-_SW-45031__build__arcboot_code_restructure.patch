+#define FLASH_VALID_MAX_SIZE		0x200000
+
+#define HL_SRAM_BASE			0x1000007FF0000000ULL
+#define HL_SP_SRAM_BASE			0x1000007FF7FE0000ULL
+#define HL_SRAM_PHY_BASE		0x1000FFFFFD000000ULL
+
+/*
+ * This is not SDRAM Base, but the base address of General region
+ * into which the rest of the components are mapped
+ */
+#define HL_SDRAM_BASE			0x20000000
+#define HL_SRAM_LOG_BASE		0x11000000
+
+#define HL_FLASH_OFFSET			0x6000000
+#define HL_ICCM_OFFSET			0x7040000
+#define HL_SBROM_OFFSET			0x7FC0000
+#define HL_FWSRAM_OFFSET		0x7FD0000
+#define HL_SCRATCHPAD_SRAM_OFFSET	0x7FE0000
+#define HL_PCIE_FWSRAM_OFFSET		0x7FF0000
+#define HL_CFG_BASE			0xF8000000
+#define HL_ICCM_BASE			(HL_SRAM_BASE + HL_ICCM_OFFSET)
+
+#define HL_ICCM_SIZE			0x20000
+#define HL_SP_SRAM_SIZE			0x10000
+#define HL_SRAM_PHY_SIZE		0x2FFFFF
+
+#define HL_ICCM_END			(HL_ICCM_BASE + HL_ICCM_SIZE - 1)
+#define HL_SP_SRAM_END			(HL_SP_SRAM_BASE + HL_SP_SRAM_SIZE - 1)
+#define HL_SRAM_PHY_END			(HL_SRAM_PHY_BASE +\
+					HL_SRAM_PHY_SIZE - 1)
+
+#endif /* _SOC_H_ */
