diff --git a/arch/gaudi2/arc/common.c b/arch/gaudi2/arc/common.c
new file mode 100644
index 0000000..6a6e784
--- /dev/null
+++ b/arch/gaudi2/arc/common.c
@@ -0,0 +1,504 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2021 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <unistd.h>
+#include <efuse.h>
+#include <pcie.h>
+#include <arcboot.h>
+#include <psoc_efuse_regs.h>
+#include <psoc_global_conf_masks.h>
+#include <psoc_reset_conf_masks.h>
+#include <psoc_reset_conf_regs.h>
+#include <sha512.h>
+#include <string.h>
+#include "dma.h"
+#include "spi_flash.h"
+#include "boot_desc.h"
+
+#define ARCBOOT_STATUS_REG_SZ_BITS	32
+#define LOW_DWORD(x)			(x & 0xFFFFFFFF)
+#define ICCM_OFFS_MASK			0x1FFFF
+#define SP_SRAM_OFFS_MASK		0xFFFF
+#define SRAM_PHYS_OFFS_MASK		0x2FFFFFF
+
+#define IATU_REGION_CTRL_1_OFF_INBOUND_OFF	0x100
+#define IATU_REGION_CTRL_2_OFF_INBOUND_OFF	0x104
+#define IATU_LWR_TARGET_ADDR_OFF_INBOUND_OFF	0x114
+#define IATU_UPPER_TARGET_ADDR_OFF_INBOUND_OFF	0x118
+
+#define IATU_LOWER_TARGET_ADDR			0xF0000000
+#define IATU_HIGHER_TARGET_ADDR			0x1000007F
+#define IATU_INBOUND_LOW_OFFSET_ADDR		0x0
+#define IATU_INBOUND_HI_OFFSET_ADDR		0xC0080000
+#define DBI_ENABLE				0x300000
+
+void arcboot_rom_status_update(enum arcboot_rom_progress progress)
+{
+	uint32_t reg, offset;
+
+	offset = progress / ARCBOOT_STATUS_REG_SZ_BITS;
+	progress = progress % ARCBOOT_STATUS_REG_SZ_BITS;
+
+	reg = regmap_readl((mmPSOC_SECURITY_SW_STATUS_0 + offset * 4));
+	reg |= BIT(progress);
+	regmap_writel(reg, (mmPSOC_SECURITY_SW_STATUS_0 + offset  * 4));
+}
+
+uint32_t get_efuse_read_reg(void)
+{
+	return mmPSOC_EFUSE_READ_CTRL;
+}
+
+uint32_t get_mem_cfg_mask(void)
+{
+	return PSOC_GLOBAL_CONF_MEM_CPY_CTRL2_MEM_SIZE_MASK;
+}
+
+uint32_t get_fld_size_shift(void)
+{
+	return PSOC_GLOBAL_CONF_SPI_DMA_CTRL_MEM_SIZE_SHIFT;
+}
+
+void update_warm_reset_config(void)
+{
+	regmap_writel(PSOC_RESET_CONF_PSOC_PRSTN_RST_CFG_EN_MASK,
+			mmPSOC_RESET_CONF_PSOC_PRSTN_RST_CFG);
+	regmap_writel(PSOC_RESET_CONF_ARC_PRSTN_RST_CFG_EN_MASK,
+			mmPSOC_RESET_CONF_ARC_PRSTN_RST_CFG);
+}
+
+uint8_t get_sris_mode_from_strap()
+{
+	uint32_t boot_strap;
+
+	boot_strap = regmap_readl(mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS_H);
+
+	return !!(boot_strap & PSOC_GLOBAL_CONF_BOOT_STRAP_PINS_H_SRIS_MODE_MASK);
+}
+
+void enable_flr_handling_fsm(void)
+{
+	/* No HW FSM bits in Gaudi2, No need to set anything */
+}
+
+static int verify_sha(uint32_t data_size, unsigned char *ptr_to_data,
+		      unsigned char *ptr_to_sha)
+{
+	unsigned char actual_hash[SHA384_SUM_LEN];
+
+	sha384_csum(ptr_to_data, data_size, actual_hash, 0);
+
+	return memcmp(ptr_to_sha, actual_hash, SHA384_SUM_LEN);
+}
+
+static int check_boundary(uint64_t addr, uint32_t size, uint64_t endaddr)
+{
+	return ((addr + size) <= endaddr) ? 0 : 1;
+}
+
+/*
+ * check_load_addr_valid updates 'addr' with the 32bit ARC
+ * view point address used to jump to the code and execute.
+ * If address is valid and within bounds 0 is returned,
+ * else returns 1.
+ */
+static int check_load_addr_valid(struct boot_desc *p_desc, uint32_t *addr)
+{
+	uint32_t addr_low = LOW_DWORD(p_desc->loadaddr);
+	int ret;
+
+	switch (p_desc->loadaddr) {
+	case HL_ICCM_BASE ... HL_ICCM_END:
+		ret = check_boundary(p_desc->loadaddr, p_desc->img_size,
+				HL_ICCM_END);
+		*addr = addr_low & ICCM_OFFS_MASK;
+		break;
+	case HL_SP_SRAM_BASE ... HL_SP_SRAM_END:
+		ret = check_boundary(p_desc->loadaddr, p_desc->img_size,
+				HL_SP_SRAM_END);
+		*addr = HL_SCRATCHPAD_SRAM_BASE +
+			(addr_low & SP_SRAM_OFFS_MASK);
+		/*
+		 * Note that the offset of SP SRAM to be provided to perform
+		 * DMA must be in granuality of 4B. ie.
+		 * (right shift offset 0x1000 by 2).
+		 */
+		p_desc->loadaddr = (HL_SP_SRAM_BASE +
+				((addr_low & SP_SRAM_OFFS_MASK) >> 2));
+		break;
+	case HL_SRAM_PHY_BASE ... HL_SRAM_PHY_END:
+		ret = check_boundary(p_desc->loadaddr, p_desc->img_size,
+				HL_SRAM_PHY_END);
+		*addr = HL_SRAM_LOG_BASE +
+			(addr_low & SRAM_PHYS_OFFS_MASK);
+		break;
+	default:
+		ret = 1;
+		break;
+	}
+	return ret;
+}
+
+static int img_desc_precheck(struct boot_desc *p_desc, uint32_t *addr)
+{
+	if (p_desc->img_size == 0)
+		goto img_desc_invalid;
+
+	/*
+	 * prevent rogue accesses by checking for-
+	 * 1. flash offset should be <= Max possible offset
+	 * 2. requested size is also less than Max allowed size
+	 */
+	if ((p_desc->spi_offset >=
+		(FLASH_VALID_OFFSET + FLASH_VALID_MAX_SIZE)) ||
+		(p_desc->img_size >= FLASH_VALID_MAX_SIZE))
+		goto img_desc_invalid;
+
+	if (p_desc->spi_offset + p_desc->img_size >=
+			(FLASH_VALID_OFFSET + FLASH_VALID_MAX_SIZE))
+		goto img_desc_invalid;
+
+	if (check_load_addr_valid(p_desc, addr))
+		goto img_desc_invalid;
+
+	return 0;
+
+img_desc_invalid:
+	return 1;
+}
+
+static void ext_rom_load_erom_pcie(void)
+{
+	int err;
+	uint32_t idx;
+	struct boot_desc desc;
+	uint32_t load_addr_logical; /* 32 bit ARC view point address */
+	void (*erom_pcie_func)();
+
+	arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_PCIE);
+
+	idx = boot_desc_get_img_desc(HL_FW_EROM_PCIE, &desc);
+	if (idx == HL_FW_IMG_NOT_FOUND)
+		return;
+
+	err = img_desc_precheck(&desc, &load_addr_logical);
+	if (err)
+		return;
+
+	arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_PCIE_DMA_START);
+
+	dma_copy_image(desc.img_size, desc.spi_offset,
+		       desc.loadaddr, SPI_DMA_DST_HBW);
+	if (dma_wait_finish() == DMA_CRC_ERROR)
+		return;
+
+	arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_PCIE_DMA_FINISH);
+
+	/* Verify SHA excluding the CRC byte */
+	err = verify_sha(desc.img_size - HL_CRC32_FOOTER,
+			(unsigned char *)(load_addr_logical),
+			desc.chksum);
+
+	if (!err) {
+		arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_PCIE_START);
+		erom_pcie_func = (void *)(load_addr_logical);
+		erom_pcie_func();
+		arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_PCIE_FINISH);
+	}
+}
+
+static void ext_rom_load_erom_recovery(void)
+{
+	int err;
+	uint32_t idx;
+	struct boot_desc desc;
+	uint32_t load_addr_logical; /* 32 bit ARC view point address */
+	void (*erom_recov_func)();
+
+	arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_RECOVERY);
+
+	idx = boot_desc_get_img_desc(HL_FW_EROM_RECOVERY, &desc);
+	if (idx == HL_FW_IMG_NOT_FOUND)
+		return;
+
+	err = img_desc_precheck(&desc, &load_addr_logical);
+	if (err)
+		return;
+
+	arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_RECOVERY_DMA_START);
+
+	dma_copy_image(desc.img_size, desc.spi_offset,
+		       desc.loadaddr, SPI_DMA_DST_HBW);
+	if (dma_wait_finish() == DMA_CRC_ERROR)
+		return;
+
+	arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_RECOVERY_DMA_FINISH);
+
+	/* Verify SHA excluding the CRC byte */
+	err = verify_sha(desc.img_size - HL_CRC32_FOOTER,
+			(unsigned char *)(load_addr_logical),
+			desc.chksum);
+
+	if (!err) {
+		arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_RECOVERY_START);
+		erom_recov_func = (void *)(load_addr_logical);
+		erom_recov_func();
+		arcboot_rom_status_update(
+				PROGRESS_ARCBOOT_EROM_RECOVERY_FINISH);
+	}
+}
+
+static void ext_rom_load_erom_tpm(void)
+{
+	int err = 0;
+	uint32_t idx = 0;
+	struct boot_desc desc;
+	uint32_t load_addr_logical; /* 32 bit ARC view point address */
+	void (*erom_tpm_func)();
+
+	arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_TPM);
+
+	idx = boot_desc_get_img_desc(HL_FW_EROM_TPM, &desc);
+	if (idx == HL_FW_IMG_NOT_FOUND)
+		return;
+
+	err = img_desc_precheck(&desc, &load_addr_logical);
+	if (err)
+		return;
+
+	arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_TPM_DMA_START);
+
+	dma_copy_image(desc.img_size, desc.spi_offset,
+		       desc.loadaddr, SPI_DMA_DST_HBW);
+	if (dma_wait_finish() == DMA_CRC_ERROR)
+		return;
+
+	arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_TPM_DMA_FINISH);
+
+	/* Verify SHA excluding the CRC byte */
+	err = verify_sha(desc.img_size - HL_CRC32_FOOTER,
+			(unsigned char *)(load_addr_logical),
+			desc.chksum);
+
+	if (!err) {
+		arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_TPM_START);
+		erom_tpm_func = (void *)(load_addr_logical);
+		erom_tpm_func();
+		arcboot_rom_status_update(PROGRESS_ARCBOOT_EROM_TPM_FINISH);
+	}
+}
+
+void execute_pcie_recovery(void)
+{
+	/*
+	 * efuse[14:13]:
+	 * 00: ROM
+	 * 01: eROM
+	 * 10: Reserved
+	 * 11: ROM
+	 */
+	uint8_t pcie_location = ((arcboot_rom_global.config_fuse >>
+			EFUSE_SYSCFG_RECOVERY_CODE_LOCATION) &
+			EFUSE_SYSCFG_RECOVERY_CODE_LOCATION_MASK);
+
+	if (pcie_location != EFUSE_SYSCFG_RECOVERY_CODE_LOCATION_EROM) {
+		/* In all other scenarios, execute from ROM (most secure) */
+		pcie_recovery();
+		return;
+	}
+
+	if (!arcboot_rom_global.erom_boot_desc_flag)
+		if (!boot_desc_init()) {
+			arcboot_rom_status_update(
+					PROGRESS_ARCBOOT_EROM_BOOT_DESC_ERROR);
+			return;
+		}
+
+	/* else load PCIE binary from eROM to establish the link */
+	ext_rom_load_erom_pcie();
+
+	/* Further, load the recovery bin from eROM */
+	ext_rom_load_erom_recovery();
+
+	/*
+	 * if we reach here, because of SHA/CRC error in execution of
+	 * eROM recovery, stay here, and don't return
+	 */
+	while (1)
+		;
+}
+
+void arcboot_rom_handle_tpm(void)
+{
+	/* check fuse bit to call the erom function*/
+	if ((arcboot_rom_global.config_fuse &
+	   EFUSE_SYSCFG_ENABLE_TPM_MASK) != 0) {
+		if (!arcboot_rom_global.erom_boot_desc_flag)
+			if (!boot_desc_init()) {
+				arcboot_rom_status_update(
+					PROGRESS_ARCBOOT_EROM_BOOT_DESC_ERROR);
+				return;
+			}
+
+		ext_rom_load_erom_tpm();
+	}
+}
+
+void arcboot_rom_set_spi_write_limit(void)
+{
+	/* limit flash write to just 2MB */
+	regmap_writel(write_en_2MB, mmPSOC_SECURITY_SPI_WRITE_LIMIT);
+}
+
+void pcie_config_iatu(void)
+{
+	uint32_t pci_dbi_base = (mmPCIE_DBI_BASE & 0x7FFFFFF);
+
+	regmap_writel(DBI_ENABLE, mmPCIE_AUX_DBI);
+	regmap_writel(IATU_LOWER_TARGET_ADDR,
+		(pci_dbi_base + IATU_LWR_TARGET_ADDR_OFF_INBOUND_OFF));
+	regmap_writel(IATU_HIGHER_TARGET_ADDR,
+		(pci_dbi_base + IATU_UPPER_TARGET_ADDR_OFF_INBOUND_OFF));
+	regmap_writel(IATU_INBOUND_LOW_OFFSET_ADDR,
+		(pci_dbi_base + IATU_REGION_CTRL_1_OFF_INBOUND_OFF));
+	regmap_writel(IATU_INBOUND_HI_OFFSET_ADDR,
+		(pci_dbi_base + IATU_REGION_CTRL_2_OFF_INBOUND_OFF));
+}
+
+void pcie_phy_para_sel_set(void)
+{
+	regmap_writel(1, mmPCIE_PHY_CR_PARA_SEL_0);
+	regmap_writel(1, mmPCIE_PHY_CR_PARA_SEL_1);
+	regmap_writel(1, mmPCIE_PHY_CR_PARA_SEL_2);
+	regmap_writel(1, mmPCIE_PHY_CR_PARA_SEL_3);
+}
+
+void pcie_wait_for_sram_init_done(void)
+{
+	uint8_t sram_init_done = 0;
+
+	do {
+		sram_init_done =
+			regmap_readl(mmPCIE_PHY_PHYX_SRAM_INIT_DONE_0);
+	} while (sram_init_done != 1);
+
+	sram_init_done = 0;
+	do {
+		sram_init_done =
+			regmap_readl(mmPCIE_PHY_PHYX_SRAM_INIT_DONE_1);
+	} while (sram_init_done != 1);
+
+	sram_init_done = 0;
+	do {
+		sram_init_done =
+			regmap_readl(mmPCIE_PHY_PHYX_SRAM_INIT_DONE_2);
+	} while (sram_init_done != 1);
+
+	sram_init_done = 0;
+	do {
+		sram_init_done =
+			regmap_readl(mmPCIE_PHY_PHYX_SRAM_INIT_DONE_3);
+	} while (sram_init_done != 1);
+}
+
+void pcie_phy_set_sram_ext_ld_done(void)
+{
+	regmap_writel(1, mmPCIE_PHY_PHY_SRAM_EXT_LD_DONE);
+}
+
+void pcie_phy_set_mpll_a_b_ssc_enable(void)
+{
+
+	pcie_update_reg_range(mmPCIE_PHY_PHYX_MPLLB_SSC_EN_0,
+			mmPCIE_PHY_PHYX_MPLLB_SSC_EN_3, 0x1);
+	pcie_update_reg_range(mmPCIE_PHY_PHYX_MPLLA_SSC_EN_0,
+			mmPCIE_PHY_PHYX_MPLLA_SSC_EN_3, 0x1);
+}
+
+void pcie_phy_set_mpll_a_b_mul_bw(uint8_t separate_reference)
+{
+	uint32_t reg;
+
+	if (separate_reference) {
+		reg = 0xA0;
+		regmap_writel(0x00250025,
+			      mmPCIE_PHY_PROTOCOL0_EXT_MPLLA_BANDWIDTH);
+		regmap_writel(0x00250025,
+			      mmPCIE_PHY_PROTOCOL0_EXT_MPLLB_BANDWIDTH);
+	} else {
+		reg = 0x50;
+		regmap_writel(0x00530053,
+			      mmPCIE_PHY_PROTOCOL0_EXT_MPLLA_BANDWIDTH);
+		regmap_writel(0x01C301C3,
+			      mmPCIE_PHY_PROTOCOL0_EXT_MPLLB_BANDWIDTH);
+	}
+
+	regmap_writel(reg, mmPCIE_PHY_PROTOCOL0_EXT_MPLLA_MULTIPLIER);
+	regmap_writel(0x7D, mmPCIE_PHY_PROTOCOL0_EXT_MPLLB_MULTIPLIER);
+}
+
+void pcie_phy_set_ext_tx_rx_ctrl(void) {}
+void pcie_phy_set_protocol0_ext_tx_rx(void) {}
+
+#define DUMP_SEL_SRNS_MASK	0x1
+#define DUMP_SEL_SSC_MASK	0x2
+
+uint8_t get_srns_mode_from_strap(uint32_t boot_strap)
+{
+	uint32_t dump_sel = (boot_strap &
+		PSOC_GLOBAL_CONF_BOOT_STRAP_PINS_L_DUMP_SEL_MASK) >>
+		PSOC_GLOBAL_CONF_BOOT_STRAP_PINS_L_DUMP_SEL_SHIFT;
+
+	/* dumpsel[0] is SRNS */
+	return (dump_sel & DUMP_SEL_SRNS_MASK);
+}
+
+uint8_t get_ssc_en_from_strap(uint32_t boot_strap)
+{
+	uint32_t dump_sel = (boot_strap &
+		PSOC_GLOBAL_CONF_BOOT_STRAP_PINS_L_DUMP_SEL_MASK) >>
+		PSOC_GLOBAL_CONF_BOOT_STRAP_PINS_L_DUMP_SEL_SHIFT;
+
+	/* dumpsel[1] is SSC EN */
+	return !!(dump_sel & DUMP_SEL_SSC_MASK);
+}
+
+/*
+ * Request CPLD to start the watchdog, by asserting
+ * a GPIO.
+ */
+#define GAUDI2_CPLD_WDOG_GPIO_INDEX	62
+void arcboot_rom_request_cpld_wdog(void)
+{
+	uint32_t index = GAUDI2_CPLD_WDOG_GPIO_INDEX % 16;
+	uint32_t val, mask = BIT(index);
+
+	/* configure GPIO in output mode */
+	val = regmap_readl(mmPSOC_GPIO3_OUTENSET);
+	val = val | mask;
+	regmap_writel(val, mmPSOC_GPIO3_OUTENSET);
+
+	/* gpio is active low */
+	val = regmap_readl(mmPSOC_GPIO3_DATAOUT);
+	val &= ~mask;
+	regmap_writel(val, mmPSOC_GPIO3_DATAOUT);
+}
+
+void arcboot_rom_clear_sw_status(void)
+{
+	/* As per Architecture recommendation, clear status reg */
+	regmap_writel(0, mmPSOC_SECURITY_STATUS);
+
+	regmap_writel(0, mmPSOC_SECURITY_SW_STATUS_0);
+	regmap_writel(0, mmPSOC_SECURITY_SW_STATUS_1);
+	regmap_writel(0, mmPSOC_SECURITY_SW_STATUS_2);
+	regmap_writel(0, mmPSOC_SECURITY_SW_STATUS_3);
+	regmap_writel(0, mmPSOC_SECURITY_SW_STATUS_4);
+	regmap_writel(0, mmPSOC_SECURITY_SW_STATUS_5);
+	regmap_writel(0, mmPSOC_SECURITY_SW_STATUS_6);
+	regmap_writel(0, mmPSOC_SECURITY_SW_STATUS_7);
+}
