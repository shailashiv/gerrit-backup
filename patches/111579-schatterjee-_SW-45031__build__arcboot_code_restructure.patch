+void security_disable_jtag_mstr_if(void)
+{
+	regmap_writel(JT_MSTR_IF_AXUSER_CORE_SHARED_MASK,
+		      mmJT_MSTR_IF_AXUSER_CORE);
+
+	/* override AXI prot bit by master IF to secure, unprivlaged access */
+	regmap_writel(MSTR_IF_CORE_HBW_AXPROT_OVRD_OVRD_EN,
+		      mmJT_MSTR_IF_CORE_HBW_AXPROT_OVRD);
+	/* enable access to PSOC_SECURITY only */
+	regmap_writel(SECURITY_PSOC_START_HBW_LSB,
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_0);
+	regmap_writel(SECURITY_PSOC_START_HBW_MSB,
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_0);
+	regmap_writel(SECURITY_PSOC_SECURITY_START_HBW,
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_0);
+	regmap_writel(SECURITY_HBW_MSB_ZERO,
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_0);
+
+	regmap_writel(SECURITY_PSOC_SECURITY_END_HBW,
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_1);
+	regmap_writel(SECURITY_HBW_MSB_ZERO,
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_1);
+	regmap_writel(SECURITY_PSOC_END_HBW_LSB,
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_1);
+	regmap_writel(SECURITY_PSOC_END_HBW_MSB,
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_1);
+}
+
+void security_enable_jtag_mstr_if(void)
+{
+	regmap_writel(0, mmJT_MSTR_IF_AXUSER_CORE);
+	/* don't override AXI prot bit by master IF */
+	regmap_writel(0, mmJT_MSTR_IF_CORE_HBW_AXPROT_OVRD);
+
+	/* enable access to all */
+	regmap_writel(SECURITY_PSOC_END_HBW_LSB,
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_LO_0);
+	regmap_writel(SECURITY_PSOC_END_HBW_MSB,
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MIN_HI_0);
+	regmap_writel(SECURITY_PSOC_START_HBW_LSB,
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_LO_0);
+	regmap_writel(SECURITY_PSOC_START_HBW_MSB,
+		      mmJT_MSTR_IF_RR_SHRD_HBW_PRIV_RANGE_MAX_HI_0);
+}
+
+void security_disable_twi_if(void)
+{
+	security_disable_i2c_s_mstr_if();
+	security_disable_smi_mstr_if();
+}
