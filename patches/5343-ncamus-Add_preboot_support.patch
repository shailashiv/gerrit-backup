From f7a70c68843dab3157c1fee2aa0fd5a4bc0902b8 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Wed, 30 May 2018 13:45:20 +0300
Subject: [PATCH] Add preboot support


---

diff --git a/Config.in b/Config.in
index eaa7a1f..d1d7fc8 100644
--- a/Config.in
+++ b/Config.in
@@ -6,5 +6,6 @@
 source "$BR2_EXTERNAL_HL_DALI_PATH/package/tbot/Config.in"
 source "$BR2_EXTERNAL_HL_DALI_PATH/package/dsv/Config.in"
 source "$BR2_EXTERNAL_HL_DALI_PATH/package/thermal/Config.in"
+source "$BR2_EXTERNAL_HL_DALI_PATH/package/preboot/Config.in"
 
 # Below can add to make it appear in the top-level configuration menu
diff --git a/Makefile b/Makefile
index 9777e75..0ffd62b 100644
--- a/Makefile
+++ b/Makefile
@@ -96,7 +96,7 @@
 	@$(MAKE) uboot-dirclean linux-dirclean armcp-dirclean	\
 		 spdlog-dirclean specs-dirclean specs_external-dirclean \
 		 host-uboot-test-hooks-dirclean host-tbot-dirclean \
-		 thermal-dirclean
+		 thermal-dirclean preboot-dirclean
 
 .PHONY: dali-onix-test dali-pldm-test dali-asic-test
 dali-onix-test: dali-onix-tools-install
diff --git a/board/habanalabs/common/local.mk b/board/habanalabs/common/local.mk
index cbf8096..5b23a0f 100644
--- a/board/habanalabs/common/local.mk
+++ b/board/habanalabs/common/local.mk
@@ -8,3 +8,4 @@
 TBOT_OVERRIDE_SRCDIR = $(TOPDIR)/../tbot
 DSV_OVERRIDE_SRCDIR = $(TOPDIR)/../dsv
 THERMAL_OVERRIDE_SRCDIR = $(TOPDIR)/../thermal
+PREBOOT_OVERRIDE_SRCDIR = $(TOPDIR)/../preboot
diff --git a/configs/dali_defconfig b/configs/dali_defconfig
index bcc1a8d..33d0314 100644
--- a/configs/dali_defconfig
+++ b/configs/dali_defconfig
@@ -63,3 +63,4 @@
 BR2_PACKAGE_TBOT=y
 BR2_PACKAGE_DSV=y
 BR2_PACKAGE_THERMAL=y
+BR2_PACKAGE_PREBOOT=y
diff --git a/package/preboot/Config.in b/package/preboot/Config.in
new file mode 100644
index 0000000..6e03bc4
--- /dev/null
+++ b/package/preboot/Config.in
@@ -0,0 +1,5 @@
+config BR2_PACKAGE_PREBOOT
+	bool "PREBOOT"
+	help
+	  Pre boot loader
+	  Replacement for U-Boot SPL
diff --git a/package/preboot/preboot.mk b/package/preboot/preboot.mk
new file mode 100644
index 0000000..7792a9e
--- /dev/null
+++ b/package/preboot/preboot.mk
@@ -0,0 +1,14 @@
+THERMAL_VERSION = 1.0.0
+PREBOOT_SITE = preboot
+PREBOOT_LICENSE = unclear
+
+define PREBOOT_BUILD_CMDS
+	$(TARGET_MAKE_ENV) $(MAKE) CROSS_COMPILE="$(TARGET_CROSS)" -C $(@D) all
+endef
+
+PREBOOT_INSTALL_IMAGES = YES
+define PREBOOT_INSTALL_IMAGES_CMDS
+	cp -dpf $(@D)/preboot.bin $(BINARIES_DIR)/
+endef
+
+$(eval $(generic-package))
