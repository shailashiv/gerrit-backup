From 319c784e2092aac7b54c421ea4ac2bcfa298c1a2 Mon Sep 17 00:00:00 2001
From: Arnon Kaufman <akaufman@habana.ai>
Date: Sat, 29 Jan 2022 01:00:38 +0200
Subject: [PATCH] [SW-65638] gaudi2: release: log and verbose flags

Simplify log and verbose argument passing

Change-Id: I0c24a44b92e26e04925037e2a2e8aec13ae62691
Signed-off-by: Arnon Kaufman <akaufman@habana.ai>
---

diff --git a/scripts/fwi/fw_installer.sh b/scripts/fwi/fw_installer.sh
index 54845d2..89c807b 100755
--- a/scripts/fwi/fw_installer.sh
+++ b/scripts/fwi/fw_installer.sh
@@ -196,9 +196,9 @@
 	                            platform sepcific options, examples, and dump of
 	                            the internal arguments
 	-v                        : each -v increases the level of verbosity
-	-verbose <level>          : control the vorbosity level
+	vl|-verbose <level>       : control the vorbosity level
 	-L,--log <file>           : change the default log file location (~/hl_fwi.log)
-	--log-level <0-3>         : set the log level (default 1)
+	--ll|--log-level <0-3>    : set the log level (default 1)
 	--log-show                : do a tail on the main log file.
 	-p,--platform <type>      : select platform, sa (default) or hls
 	-S,--status               : read status
@@ -1114,10 +1114,10 @@
 		# be recognized here as well
 		-c|--config|--cfg|-p|--platform|-t|--type|--ignore-config|--ignore-cfg)
 			;;
-		-v)
-			((verbose_lvl+=1))
+		-v*)
+			((verbose_lvl+=((${#cmd}-1))))
 			;;
-		--verbose)
+		--vl|--verbose)
 			verbose_lvl=$1
 			;;
 		--debug)
@@ -1241,7 +1241,7 @@
 		-L|--log)
 			log_dir=$1
 			;;
-		--log-lvl|--log-level)
+		--ll|--log-lvl|--log-level)
 			plog_lvl $1
 			;;
 		--log-show)
