+int get_lane_skip_info(int ch, struct extest_skip_info lane_skip_info_arr[])
+{
+	u32 pc_code, dw_code;
+	u32 byte_code, adj_byte_code;
+	int pc_idx, dw_idx, byte_idx;
+	u32 extest_wdr_entry, bit_to_clear;
+	u32 extest_wdr_bit_pos;
+	int info_arr_idx;
+
+	/* EXTEST WDR mask value corresponds to lane_repair WDR value */
+	u32 hlr_dword_code_to_extest_map[] = {
+			0, 1, 2, 3, 4, 7, 8, 9, 10, 11
+	};
+
+	if (!hlr_info[ch].status)
+		return 0;
+
+	info_arr_idx = 0;
+
+	for (pc_idx = 0; pc_idx < PC_PER_CH; pc_idx++) {
+		pc_code = (pc_idx == 0) ? hlr_info[ch].dw01_code : hlr_info[ch].dw23_code;
+		for (dw_idx = 0; dw_idx < DWORDS_PER_PC; dw_idx++) {
+			dw_code = (pc_code >> (dw_idx * HLR_DWORD_CODE_SHIFT)) & 0xFFFF;
+			/* Looping over byte-paires inside a DWORD */
+			for (byte_idx = 0; byte_idx < BYTES_PER_DWORD; byte_idx += 2) {
+				byte_code = (dw_code  >> (4 * byte_idx)) & 0xF;
+				adj_byte_code = (dw_code >> (4 * (byte_idx + 1))) & 0xF;
+
+				if  (byte_code != 0xF && adj_byte_code == 0xE) {
+					extest_wdr_bit_pos = hlr_dword_code_to_extest_map[byte_code] +
+							     byte_idx * EXTEST_WDR_BYTE_OFFSET +
+							     dw_idx * EXTEST_WDR_DWORD_OFFSET;
+					extest_wdr_entry = extest_wdr_bit_pos / 32;
+					bit_to_clear = extest_wdr_bit_pos - (32 * extest_wdr_entry);
+
+					lane_skip_info_arr[info_arr_idx].bit = bit_to_clear;
+					lane_skip_info_arr[info_arr_idx].wdr_entry = extest_wdr_entry;
+					info_arr_idx++;
+				} else if (byte_code == 0xE && adj_byte_code != 0xF) {
+					extest_wdr_bit_pos = hlr_dword_code_to_extest_map[adj_byte_code] +
+							     (byte_idx + 1) * EXTEST_WDR_BYTE_OFFSET +
+							     dw_idx * EXTEST_WDR_DWORD_OFFSET;
+					extest_wdr_entry = extest_wdr_bit_pos / 32;
+					bit_to_clear = extest_wdr_bit_pos - (32 * extest_wdr_entry);
+
+					lane_skip_info_arr[info_arr_idx].bit = bit_to_clear;
+					lane_skip_info_arr[info_arr_idx].wdr_entry = extest_wdr_entry;
+					info_arr_idx++;
+				}
+			}
+		}
+	}
+	return info_arr_idx;
+}
