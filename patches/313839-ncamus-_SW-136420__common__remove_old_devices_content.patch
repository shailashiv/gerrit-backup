From 277bb52cedca3f52d767f962fdcbecc9915e08f8 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Sat, 25 Mar 2023 19:51:23 +0300
Subject: [PATCH] [SW-136420] common: remove old devices content

Remove H2/H3/H5 that are not generated from master anymore

Change-Id: I6a6769634be0e36a1dd6be5d68317c2ccae1196e
---

diff --git a/Makefile b/Makefile
index 6fe5dd8..dfc97bc 100644
--- a/Makefile
+++ b/Makefile
@@ -25,9 +25,6 @@
 ARCBOOT_CFLAGS += -Isdk/elpsoft/src/headers
 ARCBOOT_CFLAGS += -Isdk/elpsoft/src/math
 SPECS_DEV := $(shell echo $(HL_DEV) | cut -d'_' -f1)
-ifeq ($(SPECS_DEV),greco)
-	SPECS_DEV := goya2
-endif
 
 ARCBOOT_CFLAGS += -I$(SPECS_DIR)
 ARCBOOT_CFLAGS += -I$(SPECS_DIR)/$(SPECS_DEV)/asic_reg
