From 7dca005e8e6b575a380be69c8e8a857ba34e398c Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Tue, 08 Mar 2022 09:07:40 +0200
Subject: [PATCH] [SW-69581] gaudi3: fit: fix comment

Fixed comment describing the FW sram address mask

Change-Id: I81cb243d7b0ed4378bc3506354ac12ccb78f372a
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/arch/gaudi3/arc/common.c b/arch/gaudi3/arc/common.c
index 0396a40..6a6aa63 100644
--- a/arch/gaudi3/arc/common.c
+++ b/arch/gaudi3/arc/common.c
@@ -147,8 +147,9 @@
 {
 	u32 arc_dst;
 
-	/* ARC_ADDR_MASK trancates the address to the 256MB region accesible by
-	 * Arc. MSB of 0x0020 points to the FW_MEM_REGION.
+	/*
+	 * ARC_ADDR_MASK trancates the address to the 256MB region accesible by
+	 * Arc. MSB of 0x2 points to the FW_MEM_REGION.
 	 */
 	arc_dst = ((u32)dst & ARC_ADDR_MASK) | BIT(29);
 
