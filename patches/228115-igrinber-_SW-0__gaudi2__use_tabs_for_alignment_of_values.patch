From 806cc516c7ad8ffd5aa12ad0010cbe0eaf697083 Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Mon, 04 Jul 2022 16:29:56 +0300
Subject: [PATCH] [SW-0] gaudi2: use tabs for alignment of values

Align define values with tabs instead of spaces.

Change-Id: I4af9666bd86ed4a4737c162f3adcb58223bdb0da
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/arch/gaudi2/arc/common.c b/arch/gaudi2/arc/common.c
index 44c6c9e..98f6c87 100644
--- a/arch/gaudi2/arc/common.c
+++ b/arch/gaudi2/arc/common.c
@@ -645,8 +645,8 @@
 	regmap_writel(1, mmPCIE_PHY_CR_PARA_SEL_3);
 }
 
-#define DUMP_SEL_SRNS_MASK      0x1
-#define DUMP_SEL_SSC_MASK       0x2
+#define DUMP_SEL_SRNS_MASK	0x1
+#define DUMP_SEL_SSC_MASK	0x2
 
 uint8_t get_srns_mode_from_strap(uint32_t boot_strap)
 {
@@ -676,8 +676,8 @@
 			      mmPCIE_PHY_PHYX_MPLLA_SSC_EN_3, 0x1);
 }
 
-#define EFUSE_SYSCFG_WA_SNPS_CASE_01038891    BIT(23)
-#define EFUSE_SYSCFG_PCIE_GEN_LIMIT           BIT(18)
+#define EFUSE_SYSCFG_WA_SNPS_CASE_01038891	BIT(23)
+#define EFUSE_SYSCFG_PCIE_GEN_LIMIT		BIT(18)
 
 bool pcie_skip_wa_snps(void)
 {
