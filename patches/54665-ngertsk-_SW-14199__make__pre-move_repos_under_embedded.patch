From 6b6c0a7cdc66405fce3b8a3541fbf8566c56c6b5 Mon Sep 17 00:00:00 2001
From: Nina Gertskin <ngertskin@habana.ai>
Date: Thu, 08 Oct 2020 12:27:04 +0300
Subject: [PATCH] [SW-14199] make: pre-move repos under embedded

some projects use buildroot-external folder as a relative path to specs
we have SPECS_ROOT environment variable in habana_env file
this commit change these projects to use SPECS environment variable

Change-Id: I03e8f9c569e71a71b744bc94e56deed406369285
Signed-off-by: Nina Gertskin <ngertskin@habana.ai>
---

diff --git a/Makefile b/Makefile
index 795056b..2a3789c 100644
--- a/Makefile
+++ b/Makefile
@@ -21,8 +21,8 @@
 ARCBOOT_CFLAGS += -Isdk/elpsoft/src/headers
 ARCBOOT_CFLAGS += -Isdk/elpsoft/src/math
 SPECS_DEV := $(shell echo $(HL_DEV) | cut -d'_' -f1)
-ARCBOOT_CFLAGS += -I$(dir $(BR2_EXTERNAL))/specs/$(SPECS_DEV)/asic_reg
-ARCBOOT_CFLAGS += -I$(dir $(BR2_EXTERNAL))/embedded/specs
+ARCBOOT_CFLAGS += -I$(SPECS_DIR)/$(SPECS_DEV)/asic_reg
+ARCBOOT_CFLAGS += -I$(SPECS_EMBEDDED_DIR)
 ARCBOOT_CFLAGS += -DBTLVER=$(ARCBOOT_VER)
 ARCBOOT_CFLAGS += -DBTLID=0x30
 ARCBOOT_CFLAGS += -DFLASH_START_OFFSET=0x60000
