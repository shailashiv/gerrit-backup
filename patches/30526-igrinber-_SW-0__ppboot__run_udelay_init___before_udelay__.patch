From d17311e3133023263d1376c6f6a350f8c81147da Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Sun, 22 Mar 2020 23:31:43 +0200
Subject: [PATCH] [SW-0] ppboot: run udelay_init() before udelay()

This will keep the udelay() correctness in any case and on any CPU
frequency.

Change-Id: I4d5434208b9f3c185b5a8e533458e7977522b9ff
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/app/ppboot.c b/app/ppboot.c
index cc67e48..6924c9f 100644
--- a/app/ppboot.c
+++ b/app/ppboot.c
@@ -15,6 +15,7 @@
 #include "preboot.h"
 #include "uart.h"
 #include "spi.h"
+#include "pll.h"
 
 /* Stable ID can be 0 or 1, if not defined return primary offset (0) */
 static u32 next_image_offset(u32 offset, char *name)
@@ -135,6 +136,12 @@
 
 	hl_plat_init();
 	hl_jtag_init();
+	/*
+	 * Note: we assume CPU frequency is not changed while CPU is running,
+	 * so the udelay init is done once before we start.
+	 */
+	hl_pll_udelay_init();
+
 	preboot_sync_btl();
 	hl_uart_init();
 	ppboot_pcie_init();
diff --git a/common/pll.c b/common/pll.c
index 6afc75a..4ff9915 100644
--- a/common/pll.c
+++ b/common/pll.c
@@ -13,7 +13,7 @@
 
 static u64 cycles_per_usec = BYPASS_CYCLES_PER_USEC;
 
-static inline void hl_pll_udelay_init(void)
+void hl_pll_udelay_init(void)
 {
 	cycles_per_usec = hl_pll_get_cpu_cycles_per_usec();
 }
diff --git a/common/pll.h b/common/pll.h
index d53f382..dd9aee2 100644
--- a/common/pll.h
+++ b/common/pll.h
@@ -66,6 +66,7 @@
 u64 hl_pll_get_cpu_cycles_per_usec(void);
 u32 hl_pll_get_freq(u32 pll_base, enum hl_pll_div_out div);
 bool hl_pll_is_configurable(struct hl_pll_cfg *cfg);
+void hl_pll_udelay_init(void);
 void hl_pll_udelay(unsigned int usec);
 
 #endif /* _HL_PLL_H_ */
