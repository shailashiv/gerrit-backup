From 6a0e0bc7d3ac353ee803b14d4d4877714980f59d Mon Sep 17 00:00:00 2001
From: Noam Lessner <nlessner@habana.ai>
Date: Sun, 09 Feb 2020 08:16:11 +0200
Subject: [PATCH] [SW-8229] goya2: add todo for open items

Add open TODOs and fix minor comment issues

Change-Id: I7cbde6199326be6824da535f2ff564789f4a5c03
Signed-off-by: Noam Lessner <nlessner@habana.ai>
---

diff --git a/app/arcboot_rom.c b/app/arcboot_rom.c
index 313c566..6cce9b4 100644
--- a/app/arcboot_rom.c
+++ b/app/arcboot_rom.c
@@ -31,6 +31,7 @@
 	spi_flash_set_byte_swap(DISABLE_BYTE_SWAP);
 
 	/* on warm reset change default to reset ARC and PSOC */
+	/* TODO: ask raviv why in fpga we get a reset on start */
 	reg = regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN_RST_CFG_L);
 	reg |= PSOC_GLOBAL_CONF_PRSTN_RST_CFG_L_ARC_MASK;
 	reg |= PSOC_GLOBAL_CONF_PRSTN_RST_CFG_L_PSOC_MASK;
diff --git a/common/mem_cpy.c b/common/mem_cpy.c
index ffa7e6e..3bf0406 100644
--- a/common/mem_cpy.c
+++ b/common/mem_cpy.c
@@ -16,8 +16,9 @@
 	/* image_size needs to be in 16 byte blocks count */
 	image_block_count_16b = image_size / 16;
 
-	/* if last block isn't complete 16 bytes add 1 to count */
-	/* so we also copy part of block			*/
+	/* if last block isn't complete 16 bytes add 1 to count
+	 * so we also copy part of block
+	 */
 	if ((image_size % 16) > 0)
 		image_block_count_16b++;
 
diff --git a/common/pcie.c b/common/pcie.c
index 9103845..82a0e73 100644
--- a/common/pcie.c
+++ b/common/pcie.c
@@ -62,6 +62,7 @@
 		regmap_writel(1, mmPCIE_PHY_PHYX_SRAM_EXT_LD_DONE_1);
 
 		/* Configure IATU */
+		/* TODO: check the values of register are correct */
 		regmap_writel(0x300000, mmPCIE_AUX_DBI);
 		regmap_writel(0xF0000000, mmPCIE_DBI_CORR_ERR_MASK_OFF);
 		regmap_writel(0x7F, mmPCIE_DBI_ADV_ERR_CAP_CTRL_OFF);
diff --git a/common/secureboot.c b/common/secureboot.c
index e1e16d9..230c02b 100644
--- a/common/secureboot.c
+++ b/common/secureboot.c
@@ -31,6 +31,7 @@
 
 int secureboot_verify_image(uint32_t image_size, uint32_t image_offset)
 {
+	/* TODO: have to work on API to arcboot_ram */
 	int verify = 0;
 	int err = 0;
 	int key_scan;
@@ -68,6 +69,7 @@
 						     &verify, block_buf,
 						     sizeof(block_buf));
 		}
+		/* TODO: if customer key is ok exit for */
 	}
 	/* if for loop doesn't find a valid key hash in fuse, return error */
 	if (!verify && (key_scan == SECUREBOOT_HABANA_KEY)) {
diff --git a/common/security.c b/common/security.c
index 7aad862..17d0fae 100644
--- a/common/security.c
+++ b/common/security.c
@@ -547,10 +547,12 @@
 
 	switch (fw_version_location) {
 	case SPI_FLASH:
+			/* TODO: need to inverse bits */
 		fw_version_sec = spi_flash_get_fw_version_security();
 		break;
 	case SPI_OTP:
 		spi_flash_otp_access(FLASH_OTP_ENABLE);
+			/* TODO: do we need to inverse bits? */
 		fw_version_sec =
 			spi_flash_otp_get_fw_version_security();
 		spi_flash_otp_access(FLASH_OTP_DISABLE);
@@ -561,6 +563,7 @@
 		break;
 	}
 	/* store minimum allowed security version in PSOC */
+	/* TODO: for all revoke,fw, and key store in SP_SRAM also */
 	regmap_writel(SECURITY_FW_VERSION_FROM_SECURITY_BYTE(fw_version_sec),
 		      mmPSOC_SECURITY_MIN_FW_VERSION);
 }
diff --git a/common/spi_flash.h b/common/spi_flash.h
index 9f87022..3dcea5b 100644
--- a/common/spi_flash.h
+++ b/common/spi_flash.h
@@ -47,8 +47,11 @@
 						sizeof(uint32_t))
 #define FLASH_IMAGE_SWITCH_OFFSET	4096
 
+/* 16 byte */
 #define FLASH_EFUSE_FW_VERSION_OFFSET	0
+/* 160 bytes */
 #define FLASH_EFUSE_KEYS_OFFSET		16
+/* 16 bytes */
 #define FLASH_EFUSE_KEYS_REVOKE_OFFSET	176
 
 void spi_flash_set_byte_swap(uint8_t enable);
