From 1c2b6587277498b97e7287f2c546f7f768a8c948 Mon Sep 17 00:00:00 2001
From: Guy Nisan <gnisan@habana.ai>
Date: Wed, 05 May 2021 11:52:57 +0300
Subject: [PATCH] [SW-30993] gaudi: hbm: rename hlr to lr

HLR is commonly used for HARD lane repair. Dur to the addition of SOFT
lane repair which uses the same data structure it is renamed to LR.
No functional changes.

Change-Id: I278ff676ebb7857daec28cb9eb31d2cca09118c4
Signed-off-by: Guy Nisan <gnisan@habana.ai>
---

diff --git a/gaudi/hbm.c b/gaudi/hbm.c
index c5d303f..5c62a9f 100644
--- a/gaudi/hbm.c
+++ b/gaudi/hbm.c
@@ -106,7 +106,7 @@
 	.lane_repair_iter = {},
 };
 
-struct hlr_count {
+struct lr_count {
 	int pc0;
 	int pc1;
 	int aw;
@@ -118,7 +118,7 @@
 	u16 aw_code;
 	bool status;
 	bool is_repair_code_valid;
-	struct hlr_count count;
+	struct lr_count count;
 	/* DC test only */
 	u32 extest_rx_fails[EXTEST_WDR_REG_NUM];
 	u32 extest_tx_fails[EXTEST_WDR_REG_NUM];
@@ -310,7 +310,7 @@
 static u32 aword[GAUDI_HBM_CHANNELS][4];
 static u32 dword_wr[GAUDI_HBM_CHANNELS][4][4];
 static u32 dword_rd[GAUDI_HBM_CHANNELS][4][4];
-static struct ch_lane_repair_info hlr_info[GAUDI_HBM_DEVICES][GAUDI_HBM_CHANNELS];
+static struct ch_lane_repair_info lr_info[GAUDI_HBM_DEVICES][GAUDI_HBM_CHANNELS];
 static struct dev_fail_info dev_fail_info[GAUDI_HBM_DEVICES];
 
 static const u32 extest_wdr_pattern[EXTEST_WDR_PTRNS_NUM * EXTEST_WDR_REG_NUM] = {
@@ -444,7 +444,7 @@
 
 int get_lane_skip_info(int device, int ch, struct extest_skip_info lane_skip_info_arr[])
 {
-	struct ch_lane_repair_info *hlr = &hlr_info[device][ch];
+	struct ch_lane_repair_info *lr = &lr_info[device][ch];
 	u32 pc_code, dw_code;
 	u32 byte_code, adj_byte_code;
 	int pc_idx, dw_idx, byte_idx;
@@ -457,13 +457,13 @@
 			0, 1, 2, 3, 4, 7, 8, 9, 10, 11
 	};
 
-	if (!hlr->status)
+	if (!lr->status)
 		return 0;
 
 	info_arr_idx = 0;
 
 	for (pc_idx = 0; pc_idx < PC_PER_CH; pc_idx++) {
-		pc_code = (pc_idx == 0) ? hlr->dw01_code : hlr->dw23_code;
+		pc_code = (pc_idx == 0) ? lr->dw01_code : lr->dw23_code;
 		for (dw_idx = 0; dw_idx < DWORDS_PER_PC; dw_idx++) {
 			dw_code = (pc_code >> (dw_idx * HLR_DWORD_CODE_SHIFT)) & 0xFFFF;
 			/* Looping over byte-paires inside a DWORD */
@@ -597,7 +597,7 @@
 					preboot_puts_hex(", mask ", mask, true);
 				}
 
-				hlr_info[device][ch].extest_rx_fails[i] |=
+				lr_info[device][ch].extest_rx_fails[i] |=
 					(received & mask) ^ (expected & mask);
 			}
 		}
@@ -671,7 +671,7 @@
 				if ((received & mask) != (expected & mask))
 					err++;
 
-				hlr_info[device][ch].extest_tx_fails[i] |=
+				lr_info[device][ch].extest_tx_fails[i] |=
 					(received & mask) ^ (expected & mask);
 			}
 
@@ -754,7 +754,7 @@
 				if ((received & mask) != (expected & mask))
 					err++;
 
-				hlr_info[device][ch].extest_tx_fails[i] |=
+				lr_info[device][ch].extest_tx_fails[i] |=
 					(received & mask) ^ (expected & mask);
 			}
 
@@ -1021,78 +1021,78 @@
 static void lane_update_phy(int device, int mc_ch)
 {
 	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-	struct ch_lane_repair_info *hlr = &hlr_info[device][mc_ch];
+	struct ch_lane_repair_info *lr = &lr_info[device][mc_ch];
 
 	/* Configure MLB according to remapped lanes */
-	if (hlr->dw01_code != 0xFFFFFFFF) {
-		hlr->dw01_code = hlr->dw01_code;
-		hlr->count.pc0 = 1;
-		if (((hlr->dw01_code & 0xFFFF) != 0xFFFF) &&
-		    (((hlr->dw01_code >> 16) & 0xFFFF) != 0xFFFF))
-			hlr->count.pc0 = 2;
+	if (lr->dw01_code != 0xFFFFFFFF) {
+		lr->dw01_code = lr->dw01_code;
+		lr->count.pc0 = 1;
+		if (((lr->dw01_code & 0xFFFF) != 0xFFFF) &&
+		    (((lr->dw01_code >> 16) & 0xFFFF) != 0xFFFF))
+			lr->count.pc0 = 2;
 
-		hlr->status = true;
+		lr->status = true;
 
-		WREG32(base + (mc_ch * 0x1000) + 0x2F0, hlr->dw01_code);
+		WREG32(base + (mc_ch * 0x1000) + 0x2F0, lr->dw01_code);
 	}
 
-	if (hlr->dw23_code != 0xFFFFFFFF) {
-		hlr->dw23_code = hlr->dw23_code;
-		hlr->count.pc1 = 1;
-		if (((hlr->dw23_code & 0xFFFF) != 0xFFFF) &&
-		    (((hlr->dw23_code >> 16) & 0xFFFF) != 0xFFFF))
-			hlr->count.pc1 = 2;
+	if (lr->dw23_code != 0xFFFFFFFF) {
+		lr->dw23_code = lr->dw23_code;
+		lr->count.pc1 = 1;
+		if (((lr->dw23_code & 0xFFFF) != 0xFFFF) &&
+		    (((lr->dw23_code >> 16) & 0xFFFF) != 0xFFFF))
+			lr->count.pc1 = 2;
 
-		hlr->status = true;
+		lr->status = true;
 
-		WREG32(base + (mc_ch * 0x1000) + 0x2F4, hlr->dw23_code);
+		WREG32(base + (mc_ch * 0x1000) + 0x2F4, lr->dw23_code);
 	}
 
-	if (hlr->aw_code != 0xFF) {
-		hlr->aw_code = hlr->aw_code;
-		hlr->count.aw = 1;
-		hlr->status = true;
+	if (lr->aw_code != 0xFF) {
+		lr->aw_code = lr->aw_code;
+		lr->count.aw = 1;
+		lr->status = true;
 
-		WREG32(base + (mc_ch * 0x1000) + 0x2F8, hlr->aw_code);
+		WREG32(base + (mc_ch * 0x1000) + 0x2F8, lr->aw_code);
 	}
 }
 
 static void lane_update_hbm(int device, int mc_ch)
 {
 	u32 base = GAUDI_HBM_CFG_BASE + device * GAUDI_HBM_CFG_OFFSET;
-	struct ch_lane_repair_info *hlr = &hlr_info[device][mc_ch];
+	struct ch_lane_repair_info *lr = &lr_info[device][mc_ch];
 
 	/* Check if we need to update HBM */
-	if (!hlr->is_repair_code_valid ||
-	    (hlr->dw01_code == 0xFFFFFFFF && hlr->dw23_code == 0xFFFFFFFF &&
-	     hlr->aw_code == 0xFF))
+	if (!lr->is_repair_code_valid ||
+	    (lr->dw01_code == 0xFFFFFFFF && lr->dw23_code == 0xFFFFFFFF &&
+	     lr->aw_code == 0xFF))
 		return;
 
 	/* HBM device configuration */
 	WREG32(base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) + 0x100,
-	       hlr->dw01_code);
+	       lr->dw01_code);
 	WREG32(base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) + 0x104,
-	       (hlr->dw23_code << 8) | (hlr->aw_code & 0xff));
+	       (lr->dw23_code << 8) | (lr->aw_code & 0xff));
 	WREG32(base + (GAUDI_HBM_CENTER_CHANNEL * 0x1000) + 0x108,
-	       hlr->dw23_code >> 24);
+	       lr->dw23_code >> 24);
 
 	ieee1500_inst(device, hbm_ch_mapping[mc_ch], ieee1500_soft_lane_repair,
 		      EXTEST_WRITE_INST);
 }
 
-static void hlr_reset_failures(struct ch_lane_repair_info *hlr,
+static void lr_reset_failures(struct ch_lane_repair_info *lr,
 			       bool is_reset_count)
 {
-	memset(hlr->extest_rx_fails, 0, sizeof(hlr->extest_rx_fails));
-	memset(hlr->extest_tx_fails, 0, sizeof(hlr->extest_tx_fails));
-	memset(hlr->failed_dq, 0, sizeof(hlr->failed_dq));
-	memset(hlr->failed_dm, 0, sizeof(hlr->failed_dm));
-	memset(hlr->failed_dbi, 0, sizeof(hlr->failed_dbi));
-	hlr->failed_r = 0;
-	hlr->failed_c = 0;
+	memset(lr->extest_rx_fails, 0, sizeof(lr->extest_rx_fails));
+	memset(lr->extest_tx_fails, 0, sizeof(lr->extest_tx_fails));
+	memset(lr->failed_dq, 0, sizeof(lr->failed_dq));
+	memset(lr->failed_dm, 0, sizeof(lr->failed_dm));
+	memset(lr->failed_dbi, 0, sizeof(lr->failed_dbi));
+	lr->failed_r = 0;
+	lr->failed_c = 0;
 
 	if (is_reset_count)
-		memset(hlr->fails_in_byte, 0, sizeof(hlr->fails_in_byte));
+		memset(lr->fails_in_byte, 0, sizeof(lr->fails_in_byte));
 }
 
 static void hbm_reset_failures(void)
@@ -1101,7 +1101,7 @@
 
 	for (device = 0; device < GAUDI_HBM_DEVICES; device++)
 		for (ch = 0; ch < GAUDI_HBM_CHANNELS; ch++)
-			hlr_reset_failures(&hlr_info[device][ch], true);
+			lr_reset_failures(&lr_info[device][ch], true);
 }
 
 /*
@@ -1110,7 +1110,7 @@
 static int hbm_channel_lane_repair(int device, int ch)
 {
 	struct hbm *hbm = &hbm_data;
-	struct ch_lane_repair_info *hlr = &hlr_info[device][ch];
+	struct ch_lane_repair_info *lr = &lr_info[device][ch];
 	struct dev_fail_info *dev_fail = &dev_fail_info[device];
 	int fails_in_cbus = 0, fails_in_rbus = 0;
 	u8 repair_code[PC_PER_CH][8], repair_code_c, repair_code_r;
@@ -1122,7 +1122,7 @@
 
 	/* Create repair vector */
 	for (pc = 0; pc < PC_PER_CH; pc++) {
-		dw_code = pc ? &hlr->dw23_code : &hlr->dw01_code;
+		dw_code = pc ? &lr->dw23_code : &lr->dw01_code;
 
 		/* Convert dw codes nibbles to repair_code array */
 		for (byte = 0; byte < BYTES_PER_PC; byte++)
@@ -1133,15 +1133,15 @@
 			 * introduce during ATE (hard repair)
 			 */
 			if (repair_code[pc][byte] < REPAIR_CODE_ADJ)
-				hlr->fails_in_byte[pc][byte] = 1;
+				lr->fails_in_byte[pc][byte] = 1;
 			else
-				hlr->fails_in_byte[pc][byte] = 0;
+				lr->fails_in_byte[pc][byte] = 0;
 
 			/* Check result of current byte */
 			for (bit = 0; bit < BITS_PER_BYTE; bit++) {
-				if (!!(hlr->failed_dq[pc] &
+				if (!!(lr->failed_dq[pc] &
 				       BIT(byte * 8 + bit))) {
-					hlr->fails_in_byte[pc][byte]++;
+					lr->fails_in_byte[pc][byte]++;
 					repair_code[pc][byte] = bit + REPAIR_CODE_DQ0;
 				}
 			}
@@ -1151,42 +1151,42 @@
 			 * lane is failing
 			 */
 			if (hbm->dbi_enable &&
-			    hlr->fails_in_byte[pc][byte] >= 8 &&
-			    !(hlr->failed_dm[pc] & BIT(byte))) {
+			    lr->fails_in_byte[pc][byte] >= 8 &&
+			    !(lr->failed_dm[pc] & BIT(byte))) {
 				/* DBI fault - detect for AC test */
-				hlr->failed_dbi[pc] |= BIT(byte);
-				hlr->fails_in_byte[pc][byte] -= 8;
+				lr->failed_dbi[pc] |= BIT(byte);
+				lr->fails_in_byte[pc][byte] -= 8;
 			}
 
 			/* ECC */
-			if (!!(hlr->failed_dm[pc] & BIT(byte))) {
-				hlr->fails_in_byte[pc][byte]++;
+			if (!!(lr->failed_dm[pc] & BIT(byte))) {
+				lr->fails_in_byte[pc][byte]++;
 				repair_code[pc][byte] = REPAIR_CODE_DM;
 			}
 
 			/* Data bit inversion */
-			if (!!(hlr->failed_dbi[pc] & BIT(byte))) {
-				hlr->fails_in_byte[pc][byte]++;
+			if (!!(lr->failed_dbi[pc] & BIT(byte))) {
+				lr->fails_in_byte[pc][byte]++;
 				repair_code[pc][byte] = REPAIR_CODE_DBI;
 			}
 
 			/* more than one lane per byte, cannot repair */
-			if (hlr->fails_in_byte[pc][byte] > REDUNDENT_BYTE_PAIR_LANES)
+			if (lr->fails_in_byte[pc][byte] > REDUNDENT_BYTE_PAIR_LANES)
 				return 1;
 		}
 
 		/* Check result of byte pair */
 		for (byte = 0; byte < BYTES_PER_PC; byte += 2) {
 			/* more than one lane per byte pair */
-			if (hlr->fails_in_byte[pc][byte] +
-			    hlr->fails_in_byte[pc][byte + 1] > REDUNDENT_BYTE_PAIR_LANES)
+			if (lr->fails_in_byte[pc][byte] +
+			    lr->fails_in_byte[pc][byte + 1] > REDUNDENT_BYTE_PAIR_LANES)
 				return 1;
 
 			/* mark repair in adjacent byte */
-			if (hlr->fails_in_byte[pc][byte])
+			if (lr->fails_in_byte[pc][byte])
 				repair_code[pc][byte + 1] = REPAIR_CODE_ADJ;
 
-			if (hlr->fails_in_byte[pc][byte + 1])
+			if (lr->fails_in_byte[pc][byte + 1])
 				repair_code[pc][byte] = REPAIR_CODE_ADJ;
 		}
 	}
@@ -1195,8 +1195,8 @@
 	if (dev_fail->unrep_aw)  /* Failures in unrepairable pins */
 		return 1;
 
-	repair_code_c = hlr->aw_code & 0xf;
-	repair_code_r = (hlr->aw_code >> 4) & 0xf;
+	repair_code_c = lr->aw_code & 0xf;
+	repair_code_r = (lr->aw_code >> 4) & 0xf;
 
 	/* Check if we already fixed this bus */
 	if (repair_code_c < REPAIR_CODE_NONE)
@@ -1204,7 +1204,7 @@
 
 	/* Check result of current C bus */
 	for (bit = 0; bit < CBUS_LANES_NUM; bit++) {
-		if (!(hlr->failed_c & BIT(bit)))
+		if (!(lr->failed_c & BIT(bit)))
 			continue;
 
 		fails_in_cbus++;
@@ -1220,7 +1220,7 @@
 
 	/* Check result of current R bus */
 	for (bit = 0; bit < RBUS_LANES_NUM; bit++) {
-		if (!(hlr->failed_r & BIT(bit)))
+		if (!(lr->failed_r & BIT(bit)))
 			continue;
 
 		fails_in_rbus++;
@@ -1232,14 +1232,14 @@
 
 	/* Convert back the repair code arrays */
 	for (pc = 0; pc < PC_PER_CH; pc++) {
-		dw_code = pc ? &hlr->dw23_code : &hlr->dw01_code;
+		dw_code = pc ? &lr->dw23_code : &lr->dw01_code;
 
 		*dw_code = 0;
 		for (byte = 0; byte < BYTES_PER_PC; byte++)
 			*dw_code |= repair_code[pc][byte] << (byte * 4);
 	}
 
-	hlr->aw_code = repair_code_c | (repair_code_r << 4);
+	lr->aw_code = repair_code_c | (repair_code_r << 4);
 
 	lane_update_hbm(device, ch);
 	lane_update_phy(device, ch);
@@ -1247,7 +1247,7 @@
 	/* Since soft repair is an iterative process, reset handled failures to
 	 * prevent redudant repair attempts.
 	 */
-	hlr_reset_failures(hlr, false);
+	lr_reset_failures(lr, false);
 
 	return 0;
 }
@@ -1295,7 +1295,7 @@
 static int hbm_channel_ac_test_repair(int device, int ch)
 {
 	struct hbm *hbm = &hbm_data;
-	struct ch_lane_repair_info *hlr = &hlr_info[device][ch];
