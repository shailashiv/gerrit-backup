From 59d48f3010e0515b9b194c370bf51f47582b18c2 Mon Sep 17 00:00:00 2001
From: Pavan S <psreenivas@habana.ai>
Date: Thu, 16 Mar 2023 14:13:59 +0200
Subject: [PATCH] [SW-136144] gaudi3: include register header files

The header files included in gaudi3_reg_map files
in embedded specs requires them to copy to ami build
package directory for hl-fw-loader. Therefore in-order
to remove it from gaudi3 specs adding the required
file compilation

Signed-off-by: Pavan S <psreenivas@habana.ai>
Change-Id: I2187f079f06fe5957a03e752d03b8ce3a4bf8486
---

diff --git a/arch/gaudi3/arc/erom_pcie.c b/arch/gaudi3/arc/erom_pcie.c
index 3fcb4ab..670a784 100644
--- a/arch/gaudi3/arc/erom_pcie.c
+++ b/arch/gaudi3/arc/erom_pcie.c
@@ -8,6 +8,7 @@
 #include <preboot.h>
 #include <psoc_security_regs.h>
 #include <gaudi3_reg_map.h>
+#include <gaudi3_blocks_linux_driver.h>
 
 void erom_main_function(void)
 {
