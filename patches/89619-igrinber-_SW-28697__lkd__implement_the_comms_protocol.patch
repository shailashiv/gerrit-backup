+
+static void module_lkd_run_fast_noop(void)
+{
+	int err;
+
+	/* depending on the current state machine, perform action */
+	switch (sts.do_cmd.cmd) {
+	case COMMS_NOOP:
+	case COMMS_CLR_STS:
+	case COMMS_GOTO_WFE:
+	case COMMS_SKIP_BMC:
+	case COMMS_LOW_PLL_OPP:
+		module_lkd_send_status(COMMS_STS_NOOP, COMMS_SRAM, 0);
+		break;
+	case COMMS_RST_STATE:
+		sts.exec_res = NOT_FOUND;
+		module_lkd_send_status(COMMS_STS_OK, COMMS_SRAM, 0);
+		break;
+	case COMMS_EXEC:
+		err = module_lkd_run_fast_exec();
+		if (err)
+			module_lkd_send_status(COMMS_STS_ERR, COMMS_SRAM, 0);
+		else
+			module_lkd_send_status(COMMS_STS_OK, COMMS_SRAM, 0);
+
+		break;
+	default:	/* should never get here */
+		preboot_puts_raw(__func__);
+		preboot_puts(": default case - err\n");
+	}
+}
+
+/* CLR_STS is a sync command, so here we decide what execution type is needed */
+static enum cmd_check_res module_lkd_check_noop(void)
+{
+	enum cmd_check_res res = NOT_FOUND;
+
+	/* check the command we got before waiting for sync */
+	switch (sts.do_cmd.cmd) {
+	case COMMS_PREP_DESC:
+	case COMMS_DATA_RDY:
+		res = FOUND_SLOW_RETURN;
+		break;
+	case COMMS_EXEC:
+		res = sts.exec_res;
+		break;
+	case COMMS_RST_DEV:
+		res = FOUND_NO_RETURN;
+		break;
+	case COMMS_GOTO_WFE:
+		if (!preboot_security_is_enabled()) {
+			res = FOUND_NO_RETURN;
+			break;
+		}
+		/* no break */
+	case COMMS_NOOP:
+	case COMMS_CLR_STS:
+	case COMMS_RST_STATE:
+	case COMMS_SKIP_BMC:
+	case COMMS_LOW_PLL_OPP:
+	default:
+		res = FOUND_FAST_RETURN;
+		break;
+	}
+
+	return res;
+}
