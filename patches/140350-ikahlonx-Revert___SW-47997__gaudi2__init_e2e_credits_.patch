-
-#include <arc_farm_kdma_mstr_if_e2e_crdt_regs.h>
-#include <dcore0_hif0_regs.h>
-#include <dcore0_rtr0_mstr_if_e2e_crdt_regs.h>
-#include <pmmu_pif_regs.h>
-#include <preboot.h>
-#include <uart.h>
-
-#include "hl.h"
-
-static void gaudi2_init_module_mstr_if(u32 block_idx, u32 instances,
-					   u64 block_base, u64 block_off,
-					   u64 instance_off,
-					   unsigned long enable_mask,
-					   struct block_ctx *cfg_ctx)
-{
-	u64 base = block_base + block_idx * block_off;
-	int i, seq;
-
-	for (i = 0; i < instances; i++) {
-		seq = block_idx * instances + i;
-
-		if (!test_bit(seq, &enable_mask))
-			continue;
-
-		cfg_ctx->instance_cfg_fn(base + i * instance_off,
-								cfg_ctx->data);
-	}
-}
-
-static inline void gaudi2_init_dcore_mstr_if(u32 dcore, u32 instances,
-					     u64 dcore0_base, u64 offset,
-					     unsigned long enable_mask,
-					     struct block_ctx *cfg_ctx)
-{
-	gaudi2_init_module_mstr_if(dcore, instances, dcore0_base,
-				       DCORE_OFFSET, offset,
-				       enable_mask, cfg_ctx);
-}
-
-static inline void gaudi2_init_common_mstr_if(u32 instances, u64 base,
-					      u64 offset,
-					      unsigned long enable_mask,
-					      struct block_ctx *cfg_ctx)
-{
-	gaudi2_init_module_mstr_if(0, instances, base, 0, offset,
-						enable_mask, cfg_ctx);
-}
-
-static void gaudi2_init_e2e_mstr_if_cfg(u64 base, void *data)
-{
-	int i;
-	struct e2e_cfg_data *e2e_data = (struct e2e_cfg_data *)data;
-
-	regmap_writel(0x1, base + MSTR_IF_E2E_CRDT_E2E_EMEM_EN_OFFSET);
-	regmap_writel(0x1, base + MSTR_IF_E2E_CRDT_E2E_PCI_EN_OFFSET);
-	regmap_writel(0x1, base +
-		      MSTR_IF_E2E_CRDT_E2E_EMEM_SB_RELEASE_EN_OFFSET);
-	regmap_writel(0x1, base +
-		      MSTR_IF_E2E_CRDT_E2E_PCI_SB_RELEASE_EN_OFFSET);
-
-	/*
-	 * Actual initialization of the component "credits vector".
-	 * each credits vector has 16 entries in which the indexes groups
-	 * {0-3}, {4-7}, {8-11} and {12-15} has the same value.
-	 */
-	for (i = 0; i <= E2E_PCIE; i++) {
-		regmap_writel(e2e_data->emem_rd_sz.cfg_val_idx_0_3, i * 4 +
-			      base +
-			      MSTR_IF_E2E_CRDT_E2E_EMEM_RD_SIZE_0_OFFSET);
-		regmap_writel(e2e_data->emem_wr_sz.cfg_val_idx_0_3, i * 4 +
-			      base +
-			      MSTR_IF_E2E_CRDT_E2E_EMEM_WR_SIZE_0_OFFSET);
-	}
-	for (i = E2E_HBM_DMA; i <= E2E_HBM_MMU; i++) {
-		regmap_writel(e2e_data->emem_rd_sz.cfg_val_idx_4_7, i * 4 +
-			      base +
-			      MSTR_IF_E2E_CRDT_E2E_EMEM_RD_SIZE_0_OFFSET);
-		regmap_writel(e2e_data->emem_wr_sz.cfg_val_idx_4_7, i * 4 +
-			      base +
-			      MSTR_IF_E2E_CRDT_E2E_EMEM_WR_SIZE_0_OFFSET);
-	}
-	for (i = E2E_PCIE_MMU; i <= E2E_SM; i++) {
-		regmap_writel(e2e_data->emem_rd_sz.cfg_val_idx_8_11, i * 4 +
-			     base +
-			     MSTR_IF_E2E_CRDT_E2E_EMEM_RD_SIZE_0_OFFSET);
-		regmap_writel(e2e_data->emem_wr_sz.cfg_val_idx_8_11, i * 4 +
-			      base +
-			      MSTR_IF_E2E_CRDT_E2E_EMEM_WR_SIZE_0_OFFSET);
-	}
-	for (i = E2E_NIC; i <= E2E_MME; i++) {
-		regmap_writel(e2e_data->emem_rd_sz.cfg_val_idx_12_15, i * 4 +
-			      base +
-			      MSTR_IF_E2E_CRDT_E2E_EMEM_RD_SIZE_0_OFFSET);
-		regmap_writel(e2e_data->emem_wr_sz.cfg_val_idx_12_15, i * 4 +
-			      base +
-			      MSTR_IF_E2E_CRDT_E2E_EMEM_WR_SIZE_0_OFFSET);
-	}
-
-	/* configure the PCIe rs/wr credits */
-	regmap_writel(e2e_data->pcie.rd, base +
-		      MSTR_IF_E2E_CRDT_E2E_PCI_RD_SIZE_OFFSET);
-	regmap_writel(e2e_data->pcie.wr, base +
-		      MSTR_IF_E2E_CRDT_E2E_PCI_WR_SIZE_OFFSET);
-}
-
-static void init_e2e_emem_config(struct e2e_emem_config *conf, u16 idx_12_15,
-				 u16 idx_8_11, u16 idx_4_7, u16 idx_0_3)
-{
-	conf->cfg_val_idx_0_3 = idx_0_3;
-	conf->cfg_val_idx_4_7 = idx_4_7;
-	conf->cfg_val_idx_8_11 = idx_8_11;
-	conf->cfg_val_idx_12_15 = idx_12_15;
-}
-
-static void init_e2e_pcie_config(struct e2e_pcie_config *conf, u16 rd, u16 wr)
-{
-	conf->rd = rd;
-	conf->wr = wr;
-}
-
-static void gaudi2_init_dcore_tpcs_e2e(int dcore, struct e2e_cfg_data *e2e_data)
-{
-	switch (dcore) {
-	case 0:
-		init_e2e_emem_config(&e2e_data->emem_rd_sz, 38, 35, 27, 24);
-		init_e2e_emem_config(&e2e_data->emem_wr_sz, 38, 35, 28, 23);
-		break;
-	case 1:
-		init_e2e_emem_config(&e2e_data->emem_rd_sz, 27, 24, 38, 35);
-		init_e2e_emem_config(&e2e_data->emem_wr_sz, 28, 23, 38, 35);
-		break;
-	case 2:
-		init_e2e_emem_config(&e2e_data->emem_rd_sz, 35, 38, 24, 27);
-		init_e2e_emem_config(&e2e_data->emem_wr_sz, 35, 38, 23, 28);
-		break;
-	case 3:
-		init_e2e_emem_config(&e2e_data->emem_rd_sz, 24, 27, 35, 38);
-		init_e2e_emem_config(&e2e_data->emem_wr_sz, 23, 28, 35, 38);
-		break;
-	default:
-		preboot_puts_hex("in TPC e2e config - Illegal dcore", dcore,
-				 false);
-		return;
-	}
-	init_e2e_pcie_config(&e2e_data->pcie, 7, 30);
-}
-
-static void gaudi2_init_dcore_mme_sbte_e2e(int dcore,
-					   struct e2e_cfg_data *e2e_data)
-{
-	switch (dcore) {
-	case 0:
-	case 2:
-		init_e2e_emem_config(&e2e_data->emem_rd_sz, 52, 52, 39, 39);
-		init_e2e_emem_config(&e2e_data->emem_wr_sz, 57, 57, 42, 42);
-		break;
-	case 1:
-	case 3:
-		init_e2e_emem_config(&e2e_data->emem_rd_sz, 39, 39, 52, 52);
-		init_e2e_emem_config(&e2e_data->emem_wr_sz, 42, 42, 57, 57);
-		break;
-	default:
-		preboot_puts_hex("in MME SBTE e2e config - Illegal dcore",
