-/**
- * struct e2e_emem_config - e2e component EMEM vector configuration
- * Note: this structure is based on the fact that each "quarter" of components
- *       vector (of size 16, i.e. group of 4) has the same config value.
- * @cfg_val_idx_0_3: config value to indexes 0-3.
- * @cfg_val_idx_4_7: config value to indexes 4-7.
- * @cfg_val_idx_8_11: config value to indexes 8-11.
- * @cfg_val_idx_12_15: config value to indexes 12-15.
- */
-struct e2e_emem_config {
-	u16 cfg_val_idx_0_3;
-	u16 cfg_val_idx_4_7;
-	u16 cfg_val_idx_8_11;
-	u16 cfg_val_idx_12_15;
-};
-
-/**
- * struct e2e_pcie_config - e2e component PCIe values configuration
- * @rd: read credits.
- * @wr: write credits.
- */
-struct e2e_pcie_config {
-	u16 rd;
-	u16 wr;
-};
-
-/**
- * struct e2e_cfg_data - e2e internal configuration data
- * @emem_rd_sz: E2E_CRDT_E2E_EMEM_RD_SIZE config values.
- * @emem_wr_sz: E2E_CRDT_E2E_EMEM_WR_SIZE config values.
- * @pcie: E2E pcie config values
- */
-struct e2e_cfg_data {
-	struct e2e_emem_config emem_rd_sz;
-	struct e2e_emem_config emem_wr_sz;
-	struct e2e_pcie_config pcie;
-};
