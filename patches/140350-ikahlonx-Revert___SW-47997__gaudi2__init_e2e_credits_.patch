 #define DCORE_VDEC_OFFSET	\
 		(mmDCORE0_VDEC1_MSTR_IF_RR_SHRD_HBW_BASE - \
@@ -148,29 +105,6 @@
 	TPC_ID_DCORE3_TPC4,
