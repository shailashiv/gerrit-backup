-static void preboot_disable_pcie_ltr(void)
-{
-	u32 cap_hdr_cfg, dev_cap2_reg;
-	/* PCIe LTR configuration, set bits 31:20 to 0x1f8 */
-	cap_hdr_cfg = regmap_readl(mmPCIE_DBI_MARGIN_EXT_CAP_HDR_REG);
-	cap_hdr_cfg &= ~(PCIE_DBI_MARGIN_EXT_CAP_HDR_REG_NEXT_OFFSET_MASK);
-	cap_hdr_cfg |= (PCIE_CAP_HDR_NXT_OFFSET <<
-		 PCIE_DBI_MARGIN_EXT_CAP_HDR_REG_NEXT_OFFSET_SHIFT);
-	regmap_writel(cap_hdr_cfg, mmPCIE_DBI_MARGIN_EXT_CAP_HDR_REG);
-
-	/* Disable LTR support, set bit-11 to '0' */
-	dev_cap2_reg = regmap_readl(mmPCIE_DBI_DEVICE_CAPABILITIES2_REG);
-	dev_cap2_reg &= ~(PCIE_DBI_DEVICE_CAPABILITIES2_REG_PCIE_CAP_LTR_SUPP_MASK);
-	dev_cap2_reg |= (PCIE_LTR_DISABLE <<
-		 PCIE_DBI_DEVICE_CAPABILITIES2_REG_PCIE_CAP_LTR_SUPP_SHIFT);
-	regmap_writel(dev_cap2_reg, mmPCIE_DBI_DEVICE_CAPABILITIES2_REG);
-}
-
-void preboot_init_pcie(void)
-{
-	u64 start;
-
-	preboot_init_pcie_phy();
-
-	preboot_pcie_device_id_vendor_id_set();
-
-	/* Disable the EQ REDO */
-	regmap_writel(0x00402801, mmPCIE_DBI_GEN3_RELATED_OFF);
-
-	start = timestamp_get_us();
-
-	/* Wait for init_done before executing W/A */
-	while (!(regmap_readl(mmPCIE_PHY_PHYX_SRAM_INIT_DONE_0) &&
-		 regmap_readl(mmPCIE_PHY_PHYX_SRAM_INIT_DONE_1))) {
-		/*
-		 * PCIe external load complete should take maximum of 300us
-		 * to complete. Including some grace period 576us of
-		 * timeout is used
-		 */
-		if (timeout_expired(start, PCIE_EXT_LD_TIMEOUT_US)) {
-			preboot_puts("Timed-out waiting for ext_ld_done!");
-			break;
-		}
-	}
-
-	/* Execute the Synopsys W/A */
-	regmap_writel(0xF, mmPCIE_PHY_CR_PARA_CTRL);
-	regmap_writel(0x0004A07D, mmPCIE_PHY_CR_PARA_CMD);
-	udelay(20);
-
-	/* PCIe disable LTR */
-	preboot_disable_pcie_ltr();
-
-	/* Enable and Mask LTSSM (erratum 102) */
-	regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
-}
-
-void preboot_pcie_wait_for_link(void)
-{
-	u64 start = timestamp_get_us();
-
-	/* init dev id as soon as possible, while waiting for prstn */
-	preboot_device_id_init();
-
-	/* Wait for PRSTn */
-	while (!regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN)) {
-		/* If PRSTn does not happen in 5 seconds
-		 * timeout and return
-		 */
-		if (timeout_expired(start, PCIE_WAIT_TIMEOUT_US)) {
-			preboot_puts("Timed-out waiting for PRSTn!\n");
-			return;
-		}
-	}
-
-	/* Only after PRSTn is de-asserted */
-	preboot_pcie_enable();
-
-	/* Reset start timer */
-	start = timestamp_get_us();
-
-	while (1) {
-		unsigned int prstn, ltssm, smlh, rdlh;
-
-		prstn = regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN);
-		ltssm = regmap_readl(mmPCIE_AUX_LTSSM_EN);
-		smlh = regmap_readl(mmPCIE_AUX_SMLH_LINK_UP);
-		rdlh = regmap_readl(mmPCIE_AUX_RDLH_LINK_UP);
-
-		if (prstn && smlh && rdlh) {
-			preboot_puts("PCIe link is UP!\n");
-			break;
-		}
-
-		if (timeout_expired(start, PCIE_WAIT_TIMEOUT_US)) {
-			preboot_puts("Timed-out waiting for PCIe link UP!\n");
-			break;
-		}
-
-		/*
-		 * Some host assert prstn during link up while moving to GEN3
-		 * This cause BAR size to be reset
-		 * We stop link up process by disabling ltssm
-		 * till BAR is reconfigured
-		 */
-		if (!prstn && ltssm) {
-			regmap_writel(0, mmPCIE_AUX_LTSSM_EN);
-			continue;
-		}
-
-		if (prstn && !ltssm) {
-			regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
-			continue;
-		}
-	}
-
-	/* W/A H/W bug that may lead to have a wrong mask (0x1) in LTSSM */
-	regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
-}
-
 void init_prstn(void)
 {
 	/* Configure PRSTN to reset entire SoC */
@@ -285,64 +131,6 @@
 	 * restart boot sequence.
 	 */
 	regmap_writel(0x770, mmPSOC_GLOBAL_CONF_BOOT_SEQ_RE_START);
-}
-
-static void halt_n_reset_arc(u8 id)
-{
-	u32 val, halt_ack_offset, halt_req_offset;
-	u32 retry = ARC_HALT_ACK_RETRIES;
-	u32 halt_mask, halt_ack_mask;
-	u32 rst_offset;
-
-	if (id) {
-		halt_ack_offset = mmPSOC_ARC1_CFG_RUN_HALT_ACK;
-		halt_req_offset = mmPSOC_ARC1_CFG_RUN_HALT_REQ;
-		rst_offset = mmPSOC_ARC1_CFG_ARC_RST;
-		halt_mask = PSOC_ARC1_CFG_RUN_HALT_ACK_SYS_HALT_R_MASK;
-		halt_ack_mask = PSOC_ARC1_CFG_RUN_HALT_ACK_HALT_ACK_MASK;
-
-	} else {
-		halt_ack_offset = mmPSOC_ARC0_CFG_RUN_HALT_ACK;
-		halt_req_offset = mmPSOC_ARC0_CFG_RUN_HALT_REQ;
-		rst_offset = mmPSOC_ARC0_CFG_ARC_RST;
-		halt_mask = PSOC_ARC0_CFG_RUN_HALT_ACK_SYS_HALT_R_MASK;
-		halt_ack_mask = PSOC_ARC0_CFG_RUN_HALT_ACK_HALT_ACK_MASK;
-	}
-
-	val = regmap_readl(halt_ack_offset);
-	if (val & halt_mask) {
-		preboot_puts_hex("Skipping halt for ARC", id, false);
-	} else {
-		/* Halt ARC */
-		regmap_writel(BIT(1), halt_req_offset);
-		while (1) {
-			val = regmap_readl(halt_ack_offset);
-			if (val & halt_ack_mask)
-				break;
-			udelay(10);
-			retry--;
-			if (!retry) {
-				preboot_puts_hex("No ack from ARC", id, false);
-				break;
-			}
-		}
-		regmap_writel(0x0, halt_req_offset);
-	}
-
-	/* Reset ARC */
-	regmap_writel(0x1, rst_offset);
-}
-
-static void axi_enable_drain(void)
-{
-	u32 val;
-
-	/* Set timeout and enable drain */
-	regmap_writel(PSOC_AXI_DRAIN_TIMEOUT,
-			mmPSOC_GLOBAL_CONF_AXI_DRAIN_TIMEOUT);
-	val = regmap_readl(mmPSOC_GLOBAL_CONF_AXI_DRAIN_CTRL);
-	val |= (0x1 << PSOC_GLOBAL_CONF_AXI_DRAIN_CTRL_EN_SHIFT);
-	regmap_writel(val, mmPSOC_GLOBAL_CONF_AXI_DRAIN_CTRL);
 }
 
 static void init_arc(void)
