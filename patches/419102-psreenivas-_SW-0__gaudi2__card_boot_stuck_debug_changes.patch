 }
 
 static void ppboot_time_critical_section_start(void)
@@ -305,7 +307,39 @@
 	preboot_uart_rbuf_disable();
 	preboot_puts("\n");
 }
+#if 0
+#define ARC0_WAIT_TIMEOUT	1000000
+static void preboot_print_arc0_status(void)
+{	u64 start = timestamp_get_us();
+	u32 retry = 30;
 
+	preboot_puts_hex("ARC0 status ", regmap_readl(mmPSOC_GLOBAL_CONF_SCRATCHPAD_13), false);
+	preboot_puts_hex("PRSTN reg ", regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN), false);
+	preboot_puts_hex("PSOC AXI drain ", regmap_readl(mmPSOC_GLOBAL_CONF_AXI_DRAIN_INTR), false);
+	preboot_puts_hex("retry ", retry, false);
+	if (link_is_up)
+		return;
+	while (retry) {
+		if (timeout_expired(start, ARC0_WAIT_TIMEOUT)) {
+			start = timestamp_get_us();
+			retry--;
+			preboot_puts_hex("ARC0 status ", regmap_readl(mmPSOC_GLOBAL_CONF_SCRATCHPAD_13), false);
+			preboot_puts_hex("PRSTN reg ", regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN), false);
+			preboot_puts_hex("PSOC AXI drain ", regmap_readl(mmPSOC_GLOBAL_CONF_AXI_DRAIN_INTR), false);
+			preboot_puts_hex("retry ", retry, false);
+
+		}
+		if (regmap_readl(mmPSOC_GLOBAL_CONF_SCRATCHPAD_13) & BIT(13)) {
+			preboot_puts_hex("ARC0 status ", regmap_readl(mmPSOC_GLOBAL_CONF_SCRATCHPAD_13), false);
+			preboot_puts_hex("PRSTN reg ", regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN), false);
+			preboot_puts_hex("PSOC AXI drain ", regmap_readl(mmPSOC_GLOBAL_CONF_AXI_DRAIN_INTR), false);
+			preboot_puts_hex("retry ", retry, false);
+			return;
+		}
+	}
+	preboot_puts("timeout for pcie link\n");
+}
+#endif
