 	/* Put secondary CPU in sleep state until further notice */
 	wfe();
 }
diff --git a/arch/gaudi2/common/common.c b/arch/gaudi2/common/common.c
index 052267a..c1c1713 100644
--- a/arch/gaudi2/common/common.c
+++ b/arch/gaudi2/common/common.c
@@ -58,7 +58,6 @@
 
 #include <common/pci_ids.h>
 
-#include <device.h>
 #include <uart.h>
 #include <pll.h>
 #include <pci.h>
@@ -68,6 +67,7 @@
 #include <boot_info.h>
 #include <hl_boot_desc.h>
 #include <efuse.h>
+#include <device.h>
 
 #define PCIE_LTR_DISABLE		0
 #define PCIE_CAP_HDR_NXT_OFFSET		0x1f8
@@ -557,6 +557,7 @@
 void preboot_init_pcie(void)
 {
 	preboot_init_pcie_phy();
+	preboot_update_arc0_status(4);
 
 	preboot_pcie_device_id_vendor_id_set();
 
@@ -568,14 +569,17 @@
 	regmap_writel(0x01402801, mmPCIE_DBI_GEN3_RELATED_OFF);
 	regmap_writel(0x04027041, mmPCIE_DBI_GEN3_EQ_CONTROL_OFF);
 
+	preboot_update_arc0_status(5);
 	/* Wait for ext_ld_done before executing W/A */
 	pcie_wait_for_sram_ext_ld_done();
 
+	preboot_update_arc0_status(6);
 	/* Execute the Synopsys W/A */
 	regmap_writel(0xF, mmPCIE_PHY_CR_PARA_CTRL);
 	regmap_writel(0x0004A07D, mmPCIE_PHY_CR_PARA_CMD);
 	udelay(20);
 
+	preboot_update_arc0_status(7);
 	/* Set HBM BAR size */
 	preboot_update_bar_sizes();
 
@@ -588,19 +592,23 @@
 	/* Mask Completer Abort AER */
 	hl_pcie_mask_ca_aer();
 
+	preboot_update_arc0_status(8);
 	/* Enable and Mask LTSSM (erratum 102) */
 	regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
 }
 
 void preboot_pcie_monitoring(void)
 {
+	preboot_update_arc0_status(2);
 	/* Wait for PRSTn */
 	while (!regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN))
 		;
 
+	preboot_update_arc0_status(3);
 	/* Only after PRSTn is de-asserted */
 	preboot_pcie_enable();
 
+	preboot_update_arc0_status(9);
 	while (1) {
 		unsigned int prstn, ltssm, smlh, rdlh;
 
@@ -609,8 +617,10 @@
 		smlh = regmap_readl(mmPCIE_AUX_SMLH_LINK_UP);
 		rdlh = regmap_readl(mmPCIE_AUX_RDLH_LINK_UP);
 
-		if (prstn && smlh && rdlh)
+		if (prstn && smlh && rdlh) {
+			preboot_update_arc0_status(10);
 			break;
+		}
 
 		/*
 		 * Some host assert prstn during link up while moving to GEN3
@@ -620,11 +630,13 @@
 		 */
 		if (!prstn && ltssm) {
 			regmap_writel(0, mmPCIE_AUX_LTSSM_EN);
+			preboot_update_arc0_status(11);
 			continue;
 		}
 
 		if (prstn && !ltssm) {
 			regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
+			preboot_update_arc0_status(12);
 			continue;
 		}
 	}
@@ -635,6 +647,7 @@
 	 * does not hurt.
 	 */
 	regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
+	preboot_update_arc0_status(13);
 }
 
 bool tpm_is_supported(void) { return true; }
@@ -1342,3 +1355,43 @@
 {
 	return hl_fuse_read(mmPSOC_EFUSE_BASE, word, val);
 }
+
+#if 0
+void preboot_i2cslave_init(bool debug_mode)
+{
+	/* Check if already enabled */
+	if (regmap_readl(i2c_s.enable_reg)) {
+		preboot_puts("I2C SLAVE already initialized\n");
+		return;
+	}
+
+	if (debug_mode) {
+		regmap_writel(I2C_SLAVE_ADDRESS_DBG, i2c_s.sar_reg);
+	} else {
+		/* Program IC_SAR with address to which slave responds */
+		regmap_writel(I2C_SLAVE_ADDRESS, i2c_s.sar_reg);
+
+		/* Enable I2C Slave */
+		regmap_writel(0x1, global_conf.i2c_slv_reg);
+
+		/* Enable I2C Slave interrupts */
+		regmap_writel(0x0, global_conf.i2c_slv_intr_mask_reg);
+	}
+
+	/* Program IC_CON */
+	regmap_writel(0x22, i2c_s.con_reg);
+
+	/* Set INTR mask to default */
+	regmap_writel(I2C_SLAVE_DEFAULT_INTR_MASK, i2c_s.intr_mask_reg);
+
+	/* Write to IC_RX_TL to set Rx FIFO threshold level */
+	regmap_writel(0x0, i2c_s.rx_tl_reg);
+
+	/* Write to IC_TX_TL to set Tx FIFO threshold level */
+	regmap_writel(0x7, i2c_s.tx_tl_reg);
+
+	/* Write 1 to IC_ENABLE to enable DW_apb_i2c */
+	regmap_writel(0x1, i2c_s.enable_reg);
+	preboot_puts("i2c slave init\n");
+}
+#endif
