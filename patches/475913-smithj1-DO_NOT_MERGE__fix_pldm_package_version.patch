 then
-        _major=${BASH_REMATCH[1]}
-        _minor=${BASH_REMATCH[2]}
-        _patch=${BASH_REMATCH[3]}
-        VERSION_STAMP=$((_major << 24 | _minor << 16 | _patch << 8))
+        sw_major=${BASH_REMATCH[1]}
+        sw_minor=${BASH_REMATCH[2]}
+        sw_patch=${BASH_REMATCH[3]}
+        fw_major=${BASH_REMATCH[4]}
+        fw_minor=${BASH_REMATCH[5]}
+        fw_patch=${BASH_REMATCH[6]}
+
+        PKG_VERSION="${sw_major}.${sw_minor}.${sw_patch}.0"
+        VERSION_STAMP=$((fw_major << 24 | fw_minor << 16 | fw_patch << 8))
 else
         echo "%0: Failed to parse version string for comparison stamp"
         exit 1
@@ -30,8 +35,8 @@
 
 ${PLDM_FWUP_JSON_CTOR_SCRIPT} --output-file ${PACKAGE_JSON} \
         --package-release-date-time "${PACKAGE_RELEASE_DATE_TIME}" \
-        --package-version "${VERSION_STR}" \
-        --component-image-set-version "${VERSION_STR}" \
+        --package-version "${PKG_VERSION}" \
+        --component-image-set-version "${PKG_VERSION}" \
         --pci-device-id "${PCI_DEVICE_ID}" \
         --pci-subsystem-id "${PCI_SUBSYSTEM_ID}" \
         --component $((COMPONENT_CLASSIFICATION_FIRMWARE)) $((COMPONENT_ID_LOADER)) \
diff --git a/build-main.sh b/build-main.sh
new file mode 100755
index 0000000..39253c1
--- /dev/null
+++ b/build-main.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+
+FW_PATH=${PWD}/output/gaudi3/images/itbs
+CPLD_PATH=/software/users/jsmith/cpld
+
+make gaudi3-pldm-package-create \
+	SOFTWARE_VERSION=1.21.0 \
+	FIRMWARE_VERSION=59.2.4 \
+	MAIN_PACKAGE_VERSION=1.21.0.0 \
+ 	AGENT_FW_LOADER_FIT=${FW_PATH}/gaudi3-agent-fw_loader-fit.itb \
+ 	EROM_FW_LOADER_FIT=${FW_PATH}/gaudi3-agent-fw_loader-fit_erom.itb \
+	AGENT_PCIE_FIT=${FW_PATH}/gaudi3-agent-pcie-fit.itb \
+	AGENT_SERDES_FIT=${FW_PATH}/gaudi3-agent-serdes-fit.itb \
+	REVOKE_KEY_FIT=${FW_PATH}/gaudi3-revoke_key.itb \
+	UPDATE_SVN_FIT=${FW_PATH}/gaudi3-update_svn.itb \
+	EEPROM_FIT=${FW_PATH}/gaudi3-eeprom.itb \
+	CPLD_FIT_2=${CPLD_PATH}/gaudi3-cpld-LFMXO5-15D-ES3-03-TS677A4813.itb \
+	CPLD_FIT_3=${CPLD_PATH}/gaudi3-cpld-LFMXO5-15D-HBN-HL325-04-TS67714C1D.itb \
+	CPLD_FIT_4=${CPLD_PATH}/gaudi3-cpld-LFMXO5-15D-HBN-HL325-04-TS67714C1D-production.itb
+
