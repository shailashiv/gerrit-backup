From 916f4dfb9fd0a01ebfdfbbf37fcf74afb52a27ef Mon Sep 17 00:00:00 2001
From: Varun Sharma <vsharma@habana.ai>
Date: Fri, 04 Feb 2022 06:04:22 +0200
Subject: [PATCH] [SW-67835] gaudi2: add missing pcie gen3 and gen4 configuration

This patch adds missing EQ REDO pcie configuration for gen3 and
gen4, as shared by pcie sival team.

Change-Id: Ia6e04dd8e4419e3c8089c1de84c32e8470a02a63
Signed-off-by: Varun Sharma <vsharma@habana.ai>
---

diff --git a/arch/gaudi2/common/common.c b/arch/gaudi2/common/common.c
index 77bd7d5..7bdcefb 100644
--- a/arch/gaudi2/common/common.c
+++ b/arch/gaudi2/common/common.c
@@ -533,8 +533,13 @@
 
 	preboot_pcie_device_id_vendor_id_set();
 
-	/* Disable the EQ REDO */
+	/* Disable the EQ REDO Gen3 */
 	regmap_writel(0x00402801, mmPCIE_DBI_GEN3_RELATED_OFF);
+	regmap_writel(0x04027041, mmPCIE_DBI_GEN3_EQ_CONTROL_OFF);
+
+	/* Disable the EQ REDO Gen4 */
+	regmap_writel(0x01402801, mmPCIE_DBI_GEN3_RELATED_OFF);
+	regmap_writel(0x04027041, mmPCIE_DBI_GEN3_EQ_CONTROL_OFF);
 
 	/* Wait for ext_ld_done before executing W/A */
 	pcie_wait_for_sram_ext_ld_done();
