diff --git a/goya2_arc_gnu/common.c b/goya2_arc_gnu/common.c
index 77a7f29..cf89b84 100644
--- a/goya2_arc_gnu/common.c
+++ b/goya2_arc_gnu/common.c
@@ -22,6 +22,7 @@
 #include <preboot.h>
 #include <pll.h>
 #include <uart.h>
+#include <string.h>
 
 #include "common.h"
 
@@ -223,9 +224,20 @@
 	*regs = mmPSOC_QSPI_CTRLR0;
 }
 
-void uboot_start(void)
+void fit_copy_image(u64 dst, const void *buf, int len)
 {
-	unsigned int lsb = 0xf0000000 | UBOOT_TEXT_BASE, msb = 0x7f;
+	/* Prepare the ARC SRAM address */
+	u32 arc_dst = ((u32)dst & 0xFFFFFFF) | BIT(28);
+
+	preboot_puts_hex("FIT loadaddr: ", arc_dst, false);
+
+	memcpy((void *)arc_dst, buf, len);
+}
+
+void uboot_start(u64 loadaddr)
+{
+	u32 lsb = (u32)loadaddr, msb = (u32)(loadaddr >> 32);
+
 	/* Set CPU0 Reset address to U-Boot */
 	regmap_writel(lsb, mmCPU_CA53_CFG_RST_ADDR_LSB_0);
 	regmap_writel(msb, mmCPU_CA53_CFG_RST_ADDR_MSB_0);
diff --git a/include/preboot.h b/include/preboot.h
index 8d3a7f2..5ace7a0 100644
