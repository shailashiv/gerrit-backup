From 6bcc3cfbc2d86ec870a588cef83bd6cf0edbc612 Mon Sep 17 00:00:00 2001
From: Akshay Pradip Bharad <apbharad@habana.ai>
Date: Thu, 19 Jun 2025 09:05:43 +0300
Subject: [PATCH] [JSW-972] jgs: queues: d2h and h2d queue config

Update d2h and h2d queue reg for JGS

Change-Id: I914cc9116688d02302aac2bafc4ff3fd90dada36
Signed-off-by: Akshay Pradip Bharad <apbharad@habana.ai>
---

diff --git a/dts/arc/jgs_io_mgmt.dtsi b/dts/arc/jgs_io_mgmt.dtsi
index ac80cd6..8a2d9722 100644
--- a/dts/arc/jgs_io_mgmt.dtsi
+++ b/dts/arc/jgs_io_mgmt.dtsi
@@ -86,11 +86,11 @@
 			interrupt-names = "shared_irq";
 			label = "GPU_QUEUE_SHARED_IRQ";
 
-			d2hqueue0: gpu_queue@f9ce2400 {
-				reg = <0xf9ce2400 0x30>,
-				      <0xf9ce2180 0xf>,
-				      <0xf9cd4bc0 0xf>,
-				      <0xf9cd45b0 0xf>;
+			d2hqueue0: gpu_queue@f8662400 {
+				reg = <0xf8662400 0x30>,
+				      <0xf8662180 0xf>,
+				      <0xf8654bc0 0xf>,
+				      <0xf86545b0 0xf>;
 				reg-names = "base", "intr_local", "intr_global", "intr_mask";
 				#address-cells = <3>;
 				compatible = "intel,gpu_queue_d2h";
@@ -100,11 +100,11 @@
 				label = "GPU_QUEUE_D2H0";
 			};
 
-			d2hqueue1: gpu_queue@f9ce2440 {
-				reg = <0xf9ce2440 0x30>,
-				      <0xf9ce2180 0xf>,
-				      <0xf9cd4bc0 0xf>,
-				      <0xf9cd45b0 0xf>;
+			d2hqueue1: gpu_queue@f8662440 {
+				reg = <0xf8662440 0x30>,
+				      <0xf8662180 0xf>,
+				      <0xf8654bc0 0xf>,
+				      <0xf86545b0 0xf>;
 				reg-names = "base", "intr_local", "intr_global", "intr_mask";
 				#address-cells = <3>;
 				compatible = "intel,gpu_queue_d2h";
@@ -114,11 +114,11 @@
 				label = "GPU_QUEUE_D2H1";
 			};
 
-			h2dqueue0: gpu_queue@f9ce2200 {
-				reg = <0xf9ce2200 0x20>,
-				      <0xf9ce2160 0xf>,
-				      <0xf9cd4bc0 0xf>,
-				      <0xf9cd45b0 0xf>;
+			h2dqueue0: gpu_queue@f8662200 {
+				reg = <0xf8662200 0x20>,
+				      <0xf8662160 0xf>,
+				      <0xf8654bc0 0xf>,
+				      <0xf86545b0 0xf>;
 				reg-names = "base", "intr_local", "intr_global", "intr_mask";
 				compatible = "intel,gpu_queue_h2d";
 				local_idx = <0>;
