diff --git a/scripts/make/gaudi/Makefile b/scripts/make/gaudi/Makefile
index a3bba1c..221ff64 100644
--- a/scripts/make/gaudi/Makefile
+++ b/scripts/make/gaudi/Makefile
@@ -18,6 +18,8 @@
 	$(call hl-release-test-start)
 
 HL_FAKE_SEC ?=
+FAKE_KEY_IDX ?= 0
+FAKE_SVN ?= $(shell grep HL_SEC_FW_VERSION ${BR2_EXTERNAL}/../specs/${HL_DEV}/${HL_DEV}_security.h | tr -s [:blank:] ' ' | awk '{ print $$NF }')
 
 .PHONY: hl-gaudi
 hl-gaudi: $(OUTPUT_DIR)
@@ -139,6 +141,26 @@
 gaudi-otp-install:
 	-sshpass -p$(HL_PASSWD) $(SCP) $(IMAGES_DIR)/${HL_DEV}-otp.itb	root@$(HL_INSTALL_LAB_IP):/lib/firmware/habanalabs/$(HL_DEV)/
 
+.PHONY: gaudi-fake-sign
+gaudi-fake-sign:
+	@for i in `ls $(IMAGES_DIR)/{gaudi-fit.itb,gaudi-boot-fit.itb,gaudi-agent-*.itb}`; do \
+		KEYS_DIR=${BR2_EXTERNAL}/board/habanalabs/$(HL_DEV)/dev_keys/ \
+		$(HABANA_SCRIPTS_FOLDER)/embedded/security/fit_sign.sh hash -S $(FAKE_SVN) -K $(FAKE_KEY_IDX) $$i &>/tmp/`basename $$i`.hash 2>/tmp/`basename $$i`.log; \
+		\
+		openssl pkeyutl -sign -in /tmp/`basename $$i`.hash -inkey ${BR2_EXTERNAL}/board/habanalabs/$(HL_DEV)/dev_keys/key-GPK$(FAKE_KEY_IDX).key \
+		-pkeyopt digest:sha256 -out /tmp/`basename $$i`.sig 2>/dev/null 1>&2; \
+		\
+		KEYS_DIR=${BR2_EXTERNAL}/board/habanalabs/$(HL_DEV)/dev_keys/ \
+		$(HABANA_SCRIPTS_FOLDER)/embedded/security/fit_sign.sh sign -S $(FAKE_SVN) -K $(FAKE_KEY_IDX) -s /tmp/`basename $$i`.sig $$i &>/tmp/`basename $$i`.signed  2>>/tmp/`basename $$i`.log; \
+		\
+		mv -f /tmp/`basename $$i`.signed $$i; \
+		echo "***"; \
+		echo $$i; \
+		echo "***"; \
+		KEYS_DIR=${BR2_EXTERNAL}/board/habanalabs/$(HL_DEV)/dev_keys/ \
+		$(HABANA_SCRIPTS_FOLDER)/embedded/security/fit_sign.sh verify $$i 2>>/tmp/`basename $$i`.log; \
+	done
+
