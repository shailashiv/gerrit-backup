From 1eb71326c942da98b4d8e5a3b2619d9aae8b546e Mon Sep 17 00:00:00 2001
From: Guy Nisan <gnisan@habana.ai>
Date: Tue, 01 Jun 2021 10:34:18 +0300
Subject: [PATCH] [SW-0] gaudi: security: add fake otp and bulk sign

Add fake OTP binary using 5 different keys for development purposes,
along with bulk itb files signing script.

Change-Id: I341cd820e9724dc738d397dea8840e352e8ed0bc
Signed-off-by: Guy Nisan <gnisan@habana.ai>
---

diff --git a/board/habanalabs/gaudi/create-otp-image.sh b/board/habanalabs/gaudi/create-otp-image.sh
index 2c30859..158fccd 100755
--- a/board/habanalabs/gaudi/create-otp-image.sh
+++ b/board/habanalabs/gaudi/create-otp-image.sh
@@ -15,13 +15,29 @@
 
 BOARD_BASE=${BR2_EXTERNAL}/board/habanalabs/${HL_DEV}
 MKIMAGE_FILE=${BR2_EXTERNAL}/output/${HL_DEV}/host/bin/mkimage
-KEY_DIR=${HABANA_SCRIPTS_DIR}/embedded/security/keys
 IMAGE_DIRETORY=${BR2_EXTERNAL}/output/${HL_DEV}/images
+
+echo
+if [ -z $HL_FAKE_SEC ]; then
+	echo "*** Creating EDSS keys OTP ***"
+	KEY_DIR=${HABANA_SCRIPTS_DIR}/embedded/security/keys
+	OTP_ITB_FILE=${IMAGE_DIRETORY}/${HL_DEV}-otp.itb
+else
+	echo "*** Creating development keys OTP ***"
+	KEY_DIR=${BR2_EXTERNAL}/board/habanalabs/${HL_DEV}/dev_keys
+	OTP_ITB_FILE=${IMAGE_DIRETORY}/${HL_DEV}-dev-otp.itb
+	echo
+	echo "FAKE OTP FAKE OTP FAKE OTP FAKE OTP FAKE OTP"
+	echo "Do not write development keys OTP data into"
+	echo "a card with no fake secutity running"
+	echo "FAKE OTP FAKE OTP FAKE OTP FAKE OTP FAKE OTP"
+fi
+echo
+
 OTP_IMAGE_NAME=otp.bin
 OTP_IMAGE=${IMAGE_DIRETORY}/${OTP_IMAGE_NAME}
 OTP_ITS_TEMPLATE=${BR2_EXTERNAL}/board/habanalabs/common/otp.its
 OTP_ITS_FILE=${BR2_EXTERNAL}/board/habanalabs/common/${HL_DEV}-otp.its
-OTP_ITB_FILE=${IMAGE_DIRETORY}/${HL_DEV}-otp.itb
 
 source ${BR2_EXTERNAL}/board/habanalabs/common/image-utility.sh
 
@@ -52,3 +68,6 @@
 ITS_SED_PARAMS+="s#@OTP_BIN@#${OTP_IMAGE}#g;"
 sed ${ITS_SED_PARAMS} ${OTP_ITS_TEMPLATE} > ${OTP_ITS_FILE}
 $MKIMAGE_FILE -D "-W no-unit_address_vs_reg" -f ${OTP_ITS_FILE} ${OTP_ITB_FILE}
+
+echo
+echo "*** Created: $OTP_ITB_FILE ***"
