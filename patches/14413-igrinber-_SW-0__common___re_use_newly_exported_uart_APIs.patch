From bc745c374296ee321450093598be6ec47e7a9e5a Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Sun, 23 Jun 2019 16:07:10 +0300
Subject: [PATCH] [SW-0] common: (re)use newly exported uart APIs

Replace two uart API calls by appropriate single one.

Change-Id: Ibd4c0cdb7d5a44fd16131143d35793999cdc5064
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/common/preboot.c b/common/preboot.c
index 4137a58..9265183 100644
--- a/common/preboot.c
+++ b/common/preboot.c
@@ -69,8 +69,7 @@
 
 	preboot_puts_raw("Preparing to run SPL ");
 	preboot_puts_raw(spl_image);
-	preboot_puts_raw(" (offset: 0x");
-	preboot_puth_raw(image_base_offset, false);
+	preboot_puts_hex_raw(" (offset: ", image_base_offset, false);
 	preboot_puts(")\n");
 
 	*spl_off = image_base_offset + spl_offset;
