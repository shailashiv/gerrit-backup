From d7cbb6af13ff3c28e0092aad2b04c94b058d7347 Mon Sep 17 00:00:00 2001
From: Sanyog Kale <skale@habana.ai>
Date: Tue, 27 Sep 2022 09:00:21 +0300
Subject: [PATCH] [SW-105911] common: split global data structure into two structures

Currently, ROM keeps the image data backup in first 3KB DCCM
persistent memory which is filled in cold reset from SPI and re-used
in non-cold reset based on validation pass flag. ROM doesn't make
use of boot info get api's to retrieve image information stored in
boot info in non-cold reset. This patch make following changes.

1. split global data structure into two parts global and manifest.
2. global data strcuture placed in 1st 512 bytes of DCCM which
will remain as persistent memory.
3. manifest data structure placed from 512 bytes to 3K of DCCM
which will remain as persistent/non-persistent based on boot info
skip flag. ie. If boot info skip flag in efuse is set, ROM will
need 3KB memory as persistent and other FW component should not
use it or override it.

Change-Id: I6bc6d6edacb919d1925b7e0d35b65f0fe3ef134c
---

diff --git a/app/arcboot_rom.c b/app/arcboot_rom.c
index 6f119ee..86f82b7 100644
--- a/app/arcboot_rom.c
+++ b/app/arcboot_rom.c
@@ -30,6 +30,8 @@
 	.fuse_spi = false,
 };
 
+struct arcboot_manifest_s __attribute__((section (".rom_manifest_section"))) arcboot_rom_manifest;
+
 #define ARCBOOT_STATUS_REG_SZ_BITS		32
 __weak void arcboot_rom_status_update(enum arcboot_rom_progress progress)
 {
diff --git a/arch/gaudi3/arc/arcboot_rom.lds b/arch/gaudi3/arc/arcboot_rom.lds
index a82b42e..b80cbbd 100644
--- a/arch/gaudi3/arc/arcboot_rom.lds
+++ b/arch/gaudi3/arc/arcboot_rom.lds
@@ -34,6 +34,7 @@
 	_dccm_begin = ORIGIN(DCCM);
 	_dccm_end = ORIGIN(DCCM) + LENGTH(DCCM);
 	_persistent_sec_size = 3k;
+	_rom_global_data_size = 512;
 
 	.ivt : {
 		KEEP (*(.ivt));
@@ -49,7 +50,9 @@
 		_data_after_persist_sec = _etext + _persistent_sec_size;
 		_data = .;
 	    KEEP(*(.rom_persistent_section))
-	    . = _data + _persistent_sec_size; /* Reserve 3KB memory for persistent data section */
+	    . = _data + _rom_global_data_size; /* Reserve 512 memory for persistent data section */
+	    KEEP(*(.rom_manifest_section))
+	    . = _data + _persistent_sec_size; /* Reserve 2560 (3K - 512) memory for persistent data section */
 		_rom_non_persistent_dccm_start = .;
 		*(.data)
 	} > REGION_DATA
diff --git a/arch/gaudi3/arc/common.c b/arch/gaudi3/arc/common.c
index c640601..20f523e 100644
--- a/arch/gaudi3/arc/common.c
+++ b/arch/gaudi3/arc/common.c
