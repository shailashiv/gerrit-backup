From 175daf9501fffe6ec98d03ee4ec09886e0d155cd Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Fri, 16 Nov 2018 07:14:24 +0200
Subject: [PATCH] Log: Improve ability of puts

Now it can print a register e.g. a char

Change-Id: I0cb20f5a842d031a2bb1083c183a6475f8d21d26
---

diff --git a/preboot.c b/preboot.c
index 4dbfda2..1c3f614 100644
--- a/preboot.c
+++ b/preboot.c
@@ -68,6 +68,35 @@
 	hl_preboot_puts_raw("\r");
 }
 
+static void hl_preboot_puts_num(const char* log, unsigned int val, size_t size)
+{
+	int i;
+	char str[16], c;
+
+	str[0] = '0';
+	str[1] = 'x';
+
+	for (i=0; i < size; i++) {
+		int shift = (size - i - 1) * 4;
+
+		c = (val >> shift) & 0xF;
+		if (c > 9)
+			str[i+2] = 'A' + c - 10;
+		else
+			str[i+2] = '0' + c;
+	}
+	str[i+2] = '\n';
+	str[i+3] = '\0';
+
+	hl_preboot_puts_raw(log);
+	hl_preboot_puts(str);
+}
+
+static inline void hl_preboot_puts_char(const char* str, unsigned char val)
+{
+	hl_preboot_puts_num(str, val, sizeof(val) * 2);
+}
+
 /*
  * Using scratchpad registers for
  * passing flash layout to CPU SW
