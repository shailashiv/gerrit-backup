From 479d110314b9f56604d38c89796df4ada6ac248d Mon Sep 17 00:00:00 2001
From: Gleb Kodinets <gkodinets@habana.ai>
Date: Sun, 03 Oct 2021 17:27:26 +0300
Subject: [PATCH] [SW-56994] pci: moving bar mapping regions data to specs

This patch makes PCI inbound regions mapping use definitions
from specs.

Change-Id: I8103e50363c898fbe7ed29ec2109f66eaeb4850b
---

diff --git a/arch/gaudi/arm/asic.c b/arch/gaudi/arm/asic.c
index 9c757de..1c08fd2 100644
--- a/arch/gaudi/arm/asic.c
+++ b/arch/gaudi/arm/asic.c
@@ -375,43 +375,18 @@
 	return false; /* No end */
 }
 
+/* PCI inbound regions data is defined in specs address_space.h */
+static struct hl_pci_inbound_region gaudi_pci_inbound_regions[] = PCI_INBOUND_REGIONS_DATA_ARRAY;
+
 void hl_pci_iatu_init(void)
 {
-	u64 sp_sram_offset;
-	struct hl_pci_inbound_region inbound_region;
+	int i;
 	struct hl_pci_outbound_region outbound_region;
 
 	hl_pcie_disable_mem_access();
 
-	/* Inbound Region 0 - Bar 0 - Point to SRAM + CFG */
-	inbound_region.mode = PCI_BAR_MATCH_MODE;
-	inbound_region.bar = PCI_BAR_ID_0;
-	inbound_region.addr = SDRAM_FULL_BASE;
-	hl_pci_set_inbound_region(0, &inbound_region);
-
-	/* Inbound Region 1 - Bar 4 - Point to HBM */
-	inbound_region.mode = PCI_BAR_MATCH_MODE;
-	inbound_region.bar = PCI_BAR_ID_4;
-	inbound_region.addr = DRAM_BASE;
-	hl_pci_set_inbound_region(1, &inbound_region);
-
-	/* Inbound Region 2 - Bar 2 - SPI FLASH till start of SP SRAM */
-	inbound_region.mode = PCI_ADDRESS_MATCH_MODE;
-	inbound_region.bar = PCI_BAR_ID_2;
-	inbound_region.offset_in_bar = 0;
-	inbound_region.addr = HL_SPI_BASE;
-	sp_sram_offset = HL_SP_SRAM_BASE - HL_SPI_BASE;
-	inbound_region.size = sp_sram_offset;
-	hl_pci_set_inbound_region(2, &inbound_region);
-
-	/* Inbound Region 3 - Bar 2 - End of SP SRAM till end of config */
-	inbound_region.mode = PCI_ADDRESS_MATCH_MODE;
-	inbound_region.bar = PCI_BAR_ID_2;
-	inbound_region.offset_in_bar = sp_sram_offset + HL_SP_SRAM_SIZE;
-	inbound_region.addr = HL_SP_SRAM_BASE + HL_SP_SRAM_SIZE;
-	inbound_region.size = HOST_PHYS_BASE -
-			      (HL_SP_SRAM_BASE + HL_SP_SRAM_SIZE);
-	hl_pci_set_inbound_region(3, &inbound_region);
+	for (i = 0; i < ARRAY_SIZE(gaudi_pci_inbound_regions); ++i)
+		hl_pci_set_inbound_region(i, &gaudi_pci_inbound_regions[i]);
 
 	/* Outbound Region 0 - Point to Host */
 	outbound_region.addr = HOST_PHYS_BASE;
diff --git a/arch/gaudi2/arm/asic.c b/arch/gaudi2/arm/asic.c
index 4d3b111..28c6061 100644
--- a/arch/gaudi2/arm/asic.c
+++ b/arch/gaudi2/arm/asic.c
@@ -10,8 +10,6 @@
 #include <preboot.h>
 #include <sha256.h>
 #include <boot_desc.h>
-#include <pci.h>
-#include <address_space.h>
 
 #define SDRAM_BASE_FULL 0x1000FFFFFD000000ull
 
diff --git a/arch/gaudi2/common/asic.c b/arch/gaudi2/common/asic.c
index 3a7673b..8097d60 100644
--- a/arch/gaudi2/common/asic.c
+++ b/arch/gaudi2/common/asic.c
@@ -161,34 +161,18 @@
 	return factor > 2 ? factor : 2;
 }
 
+/* PCI inbound regions data is defined in specs address_space.h */
+static struct hl_pci_inbound_region gaudi2_pci_inbound_regions[] = PCI_INBOUND_REGIONS_DATA_ARRAY;
+
 void hl_pci_iatu_init(void)
 {
-	struct hl_pci_inbound_region inbound_region;
+	int i;
 	struct hl_pci_outbound_region outbound_region;
 
 	hl_pcie_disable_mem_access();
 
-	/* Inbound Region 0 - Bar 0 - Point to CFG */
-	inbound_region.mode = PCI_ADDRESS_MATCH_MODE;
-	inbound_region.bar = PCI_BAR_ID_0;
-	inbound_region.offset_in_bar = 0;
-	inbound_region.addr = STM_FLASH_BASE;
-	inbound_region.size = CFG_REGION_SIZE;
-	hl_pci_set_inbound_region(0, &inbound_region);
-
-	/* Inbound Region 1 - Bar 0 - Point to BAR0_RESERVED + SRAM */
-	inbound_region.mode = PCI_ADDRESS_MATCH_MODE;
-	inbound_region.bar = PCI_BAR_ID_0;
-	inbound_region.offset_in_bar = CFG_REGION_SIZE;
-	inbound_region.addr = BAR0_RSRVD_BASE;
-	inbound_region.size = BAR0_RSRVD_SIZE + SRAM_SIZE;
-	hl_pci_set_inbound_region(1, &inbound_region);
-
-	/* Inbound Region 2 - Bar 4 - Point to DRAM */
-	inbound_region.mode = PCI_BAR_MATCH_MODE;
-	inbound_region.bar = PCI_BAR_ID_4;
-	inbound_region.addr = DRAM_BASE;
-	hl_pci_set_inbound_region(2, &inbound_region);
+	for (i = 0; i < ARRAY_SIZE(gaudi2_pci_inbound_regions); ++i)
+		hl_pci_set_inbound_region(i, &gaudi2_pci_inbound_regions[i]);
 
 	/* Outbound Region 0 - Point to Host */
 	outbound_region.addr = HOST_PHYS_BASE_0;
