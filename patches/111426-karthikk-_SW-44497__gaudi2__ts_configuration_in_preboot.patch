+#define HL_TS_CMN_CLK_SYNTH		(mmDCORE0_TSTDVS_TS_CMN_CLK_SYNTH & 0xFF)
+#define HL_TS_00_ALARMA_CFG		(mmDCORE0_TSTDVS_TS_00_ALARMA_CFG & 0xFF)
