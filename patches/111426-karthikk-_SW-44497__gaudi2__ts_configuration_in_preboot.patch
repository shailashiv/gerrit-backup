diff --git a/arch/gaudi2/common/common.c b/arch/gaudi2/common/common.c
index 16fd624..c9c2c2d 100644
--- a/arch/gaudi2/common/common.c
+++ b/arch/gaudi2/common/common.c
@@ -11,6 +11,14 @@
 #include <cmd_module.h>
 #include <psoc_global_conf_regs.h>
 #include <gaudi2/gaudi2_reg_map.h>
+#include <psoc_reset_conf_regs.h>
+#include <psoc_reset_conf_masks.h>
+#include <gaudi2_blocks_linux_driver.h>
+#include <pll.h>
+#include <uart.h>
+#include "common.h"
+#include "preboot/thermal.h"
+#include <string.h>
 
 void lkd_dev_spec_regs(struct cpu_dyn_regs *regs)
 {
@@ -51,3 +59,44 @@
 	regs->gic_host_ints_irq  = mmGIC_HOST_INTS_IRQ_POLL_REG;
 	regs->gic_host_soft_rst_irq = mmGIC_HOST_SOFT_RST_IRQ_POLL_REG;
 }
+
+static struct hl_ts_cfg gaudi2_hl_ts_data[] = {
+	{.base = mmDCORE0_TSTDVS_BASE & ~HL_CFG_BASE, .alarm_a = 90, .alarm_b = 115,
+		.use_calib = false, .calib_offset = 9, .hl_tmp_data = { 0 }},
+	{.base = mmDCORE1_TSTDVS_BASE & ~HL_CFG_BASE, .alarm_a = 90, .alarm_b =  115,
+		.use_calib = false, .calib_offset = 10, .hl_tmp_data = { 0 }},
+	{.base = mmDCORE2_TSTDVS_BASE & ~HL_CFG_BASE, .alarm_a = 90, .alarm_b = 115,
+		.use_calib = false, .calib_offset = 7, .hl_tmp_data = { 0 }},
+	{.base = mmDCORE3_TSTDVS_BASE & ~HL_CFG_BASE, .alarm_a = 90, .alarm_b = 115,
+		.use_calib = false, .calib_offset = 8, .hl_tmp_data = { 0 }}
+};
+
+void hl_ts_data_init(void)
+{
+	u32 pll_freq;
+	int i;
+
+	pll_freq = hl_pll_get_freq(mmDCORE0_XBAR_IF_PLL_CTRL_BASE & ~HL_CFG_BASE, HL_PLL_DIV3);
+
+	/* All TS instances use XBAR IF PLL, DIV3 clock */
+	for (i = 0; i < HL_ASIC_TS_MAX_COUNT; i++)
+		gaudi2_hl_ts_data[i].freq = pll_freq;
+
+	memcpy(hl_ts_data, gaudi2_hl_ts_data,
+			sizeof(struct hl_ts_cfg) * HL_ASIC_TS_MAX_COUNT);
+}
+
+void hl_ts_reset(void)
+{
+	preboot_puts("Performing RST of TS UNIT\n");
+	/* Perform unit reset for TS and TS_IF */
+	regmap_writel(PSOC_RESET_CONF_TS_UNIT_RST_EN_MASK,
+			mmPSOC_RESET_CONF_TS_UNIT_RST);
+	regmap_writel(PSOC_RESET_CONF_TS_IF_UNIT_RST_EN_MASK,
+			mmPSOC_RESET_CONF_TS_IF_UNIT_RST);
+	regmap_writel(1, mmPSOC_RESET_CONF_UNIT_RST_N);
+	udelay(1000);
+	regmap_writel(0, mmPSOC_RESET_CONF_TS_UNIT_RST);
+	regmap_writel(0, mmPSOC_RESET_CONF_TS_IF_UNIT_RST);
+	regmap_writel(1, mmPSOC_RESET_CONF_UNIT_RST_N);
+}
