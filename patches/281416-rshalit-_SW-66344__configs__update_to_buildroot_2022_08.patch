From 02148814fe284c03c0158a68bdaa9deac9d084ce Mon Sep 17 00:00:00 2001
From: ran shalit <rshalit@habana.ai>
Date: Tue, 13 Dec 2022 16:14:34 +0200
Subject: [PATCH] [SW-66344] configs: update to buildroot 2022.08

As part of update to buildroot 2022.08, should use
disable the safety related configs which were enabled
by default in the updated buildroot.

This is related to the following patch in buildroot
2021-05-03 - Config.in: enable FORTIFY_SOURCE, PIC/PIE,
RELRO, SSP by default <Fabrice Fontaine>

Change-Id: Icdb4758d04794b5147e88d7b63860659fad416f3
Signed-off-by: ran shalit <rshalit@habana.ai>
---

diff --git a/configs/gaudi2_arc_defconfig b/configs/gaudi2_arc_defconfig
index bab18a1..58a7e33 100644
--- a/configs/gaudi2_arc_defconfig
+++ b/configs/gaudi2_arc_defconfig
@@ -21,3 +21,7 @@
 BR2_PACKAGE_ZEPHYR_ARC_PID=y
 BR2_PACKAGE_ZEPHYR_ARC_MGMT=y
 BR2_PACKAGE_ZEPHYR_ARC_PREBOOT=y
+BR2_PIC_PIE=n
+BR2_SSP_NONE=y
+BR2_RELRO_NONE=y
+BR2_FORTIFY_SOURCE_NONE=y
\ No newline at end of file
