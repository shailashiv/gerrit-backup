@@ -68,3 +68,7 @@
 BR2_PACKAGE_ZEPHYR_ARM_AGENT_SERDES=y
 BR2_PACKAGE_ZEPHYR_ARM_AGENT_HBM=y
 BR2_PACKAGE_ZEPHYR_AGENT_FW_LOADER=y
+BR2_PIC_PIE=n
+BR2_SSP_NONE=y
+BR2_RELRO_NONE=y
+BR2_FORTIFY_SOURCE_NONE=y
\ No newline at end of file
