From 4e1dab773dcd6808b139beb59f551a1aa711cac4 Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Wed, 22 May 2024 10:02:05 +0000
Subject: [PATCH] Revert "[SW-15774] package: extract agent-hbm from zephyr"

This breaks all the margin tool agents running on the device.
Revert for now, once fixed will be reapplied.

This reverts commit acd42b51c2c9a8287b95a2636881d215839237e1.

Change-Id: I1001dc1cac35fd3e2c9a94dc4e1428351458138d
---

diff --git a/Config.in b/Config.in
index 794cefa..8cf90a8 100644
--- a/Config.in
+++ b/Config.in
@@ -11,7 +11,6 @@
 source "$BR2_EXTERNAL_HABANALABS_PATH/package/pid/Config.in"
 source "$BR2_EXTERNAL_HABANALABS_PATH/package/mgmt/Config.in"
 source "$BR2_EXTERNAL_HABANALABS_PATH/package/event/Config.in"
-source "$BR2_EXTERNAL_HABANALABS_PATH/package/agent-hbm/Config.in"
 
 source "$BR2_EXTERNAL_HABANALABS_PATH/package/hl-fw-loader/Config.in"
 source "$BR2_EXTERNAL_HABANALABS_PATH/package/hls2-bmc/Config.in"
diff --git a/board/habanalabs/fs1_arc/fs1-local.mk b/board/habanalabs/fs1_arc/fs1-local.mk
index cbd4a6a..1098f5b 100644
--- a/board/habanalabs/fs1_arc/fs1-local.mk
+++ b/board/habanalabs/fs1_arc/fs1-local.mk
@@ -4,4 +4,3 @@
