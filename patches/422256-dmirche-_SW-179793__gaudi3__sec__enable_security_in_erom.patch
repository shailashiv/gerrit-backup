+static inline void mirror_rmwritel(u32 addr, u32 data, u32 mask)
+{
+	u32 val;
+
+	val = mirror_readl(addr);
+	val &= ~mask;
+	val |= (data << (__builtin_ffsll(mask) - 1));
+
+	mirror_writel(val, addr);
+}
