+struct lbw_rr_reg_dbg {
+	uint8_t status: 1;  /* Range Register is enabled or disabled */
+	uint8_t sym: 1;     /* To indicate if RR instances for all dcore/hdcore */
+			    /* configured with same value */
+	uint8_t log_overflow: 1; /* if RR is programmed more than 4 times, set this bit */
+	uint8_t rsvd: 5;
+
+	uint8_t rr_index; /* Range Register number */
+	enum hl_sec_rr_sel rr_type; /* NOC(0x1), PSOC(0x2), PCIE(0x4: elbi, lbw, mstr) */
+	uint32_t data_min;
+	uint32_t data_max;
+};
