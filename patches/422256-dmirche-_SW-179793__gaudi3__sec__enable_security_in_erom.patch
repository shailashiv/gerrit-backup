+
+#ifndef _PREBOOT_SECURITY_DEF_H_
+#define _PREBOOT_SECURITY_DEF_H_
+
+#define GAUDI3_NUM_OF_DIES              2
+#define GAUDI3_NUM_DCORES_PER_DIE       2
+#define GAUDI3_NUM_RRTR_PER_HDCORE      8
+#define GAUDI3_NUM_MME_PER_DIE          4
+#define GAUDI3_NUM_CORES_PER_MME        2
+#define GAUDI3_NUM_MME_CORES_PER_DIE    (GAUDI3_NUM_MME_PER_DIE * GAUDI3_NUM_CORES_PER_MME)
+
+
+#define GEN_BIT_MASK(n)			(((uint64_t)1 << (n)) - 1)
+#define HDCORE_OFFSET			(mmHD1_ARC_FARM_ARC0_ACP_ENG_BASE - \
+					mmHD0_ARC_FARM_ARC0_ACP_ENG_BASE)
+#define RRTR_OFFSET			(mmHD0_RRTR1_BASE - mmHD0_RRTR0_BASE)
+
+#define DIE_OFFSET			(mmD1_PMMU_HBW_STLB_BASE - mmD0_PMMU_HBW_STLB_BASE)
+
+enum hl_security_pcie_rr_types {
+	HL_SECURITY_PCIE_ELBI_RR = BIT(0),
+	HL_SECURITY_PCIE_MSTR_RR = BIT(1),
+	HL_SECURITY_PCIE_LBW_RR = BIT(2)
+};
+
+enum hl_gaudi3_sku {
+	GAUDI3_SINGLE_DIE_SKU,
+	GAUDI3_DUAL_DIE_SKU,
+};
+
+struct gaudi3_redundancy_ctx {
+	uint8_t initialized;
+	uint8_t num_of_dies;
+	uint8_t num_active_hbm;
+	uint8_t hbm_fault_mask[GAUDI3_NUM_OF_DIES];
+	uint8_t vdec_fault_mask[GAUDI3_NUM_OF_DIES];
+	uint8_t rot_fault_mask[GAUDI3_NUM_OF_DIES];
+	uint8_t hbm_ena_mask;
+	uint8_t reserved0[6];
+	uint64_t tpc_fault_mask[GAUDI3_NUM_OF_DIES];
+	int8_t redundant_vdec[GAUDI3_NUM_OF_DIES];
+	int8_t redundant_hbm[GAUDI3_NUM_OF_DIES];
+	int8_t redundant_rot[GAUDI3_NUM_OF_DIES][GAUDI3_NUM_DCORES_PER_DIE];
+	int8_t redundant_tpc[GAUDI3_NUM_OF_DIES][GAUDI3_NUM_DCORES_PER_DIE];
+	int8_t redundant_mme_row[GAUDI3_NUM_OF_DIES][GAUDI3_NUM_MME_CORES_PER_DIE];
+	uint8_t reserved1[4];
+};
+
+struct gaudi3_enable_masks {
+	uint8_t hbm_enable_mask;
+};
+
+struct hl_isolation_cfg {
+	enum hl_gaudi3_sku sku;
+	struct gaudi3_redundancy_ctx redundancy_ctx;
+	struct gaudi3_enable_masks enable_masks;
+};
+
+struct hl_security_drv_data {
+	struct hl_isolation_cfg iso_cfg;
+	bool sec_dbg;
+	enum hl_sku_type sku;
+	struct hl_fw_sec_info sec_data;
+	uintptr_t lbw_rr_dbg_offset;
+	uintptr_t hbw_rr_dbg_offset;
+};
+
+struct hl_security_rr_engine_select {
+	/** NOC RR selection for security configuration */
+	uint8_t noc;
+	/** PCIE RR selection for security configuration */
+	uint8_t pcie;
+	/** PSOC RR selection for security configuration */
+	uint8_t psoc;
+	/** HMMU RR selection for security configuration */
+	uint8_t hmmu;
+	/** SYNC_MNGR RR selection for security configuration */
+	uint8_t sync_mngr;
+	/** Reserved for future use */
+	uint8_t reserved[11];
+};
+
+#endif  //_PREBOOT_SECURITY_DEF_H_
