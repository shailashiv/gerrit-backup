+void security_report_img_status(uint8_t index, uint32_t img_sts_bit)
+{
+	uint32_t reg, offset;
+
+	if (index == BOOT_ROM_SECONDARY)
+		offset = IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_SEC_IMG_STATUS);
+	else
+		offset = IO0_H0_PSOC_BOOT_SECURITY(mmPSOC_SECURITY_PRI_IMG_STATUS);
+
+	reg = regmap_readl(offset);
+	reg |= img_sts_bit;
+	regmap_writel(reg, offset);
+}
