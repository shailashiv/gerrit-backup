+
+int boot_rom_verify_image(enum hl_fw_boot_ptr_imgs img_type)
+{
+	enum boot_rom_progress boot_desc_verif_base = PROGRESS_SPI_BOOT_DESC_VERIFY_START;
+	struct hl_fw_boot_ptrs boot_ptr;
+	uint32_t boot_ptr_addr = 0;
+	int ret;
+	uint32_t img_plus_key_len;
+
+	if (!security_efuse_image_validation_en())
+		return BOOT_ROM_SUCCESS;
+
+	if ((img_type == HL_FW_BOOT_PTR_SPI) && (boot_rom_global.validation_pass))
+		return BOOT_ROM_SUCCESS;
+
+	if (img_type == HL_FW_BOOT_PTR_RECOVERY)
+		boot_desc_verif_base = PROGRESS_RECOVERY_IMG_BOOT_DESC_VERIFY_START;
+
+	boot_ptr_addr = boot_desc_param_get(img_type, &boot_ptr);
+
+	if (!boot_ptr_addr)
+		return BOOT_ROM_FAIL;
+
+	boot_rom_status_update_bringup(boot_desc_verif_base, PROGRESS_VERIFY_START);
+
+	/* TODO: once SPI DMA changes verified, check once */
+	img_plus_key_len = boot_ptr.boot_ptrs_img_sz - boot_ptr.sig_sz - CRC32_SIZE;
+
+	ret = secureboot_verify_image_signature((uint8_t *)boot_ptr_addr, img_plus_key_len,
+			(uint8_t *)(boot_ptr_addr + img_plus_key_len - boot_ptr.pub_key_sz),
+			boot_ptr.pub_key_sz, (uint8_t *)(boot_ptr_addr + img_plus_key_len), boot_ptr.sig_sz,
+			boot_ptr.sec_ver, boot_ptr.key_idx);
+
+	if (ret == SECUREBOOT_VERIFY_SUCCESS) {
+		boot_rom_status_update_bringup(boot_desc_verif_base, PROGRESS_VERIFY_SUCCESS);
+	} else {
+		if (ret == SECUREBOOT_VERIFY_VER_FAILED)
+			boot_rom_status_update_bringup(boot_desc_verif_base, PROGRESS_VERIFY_VERSION_FAIL);
+		else if (ret == SECUREBOOT_VERIFY_KEY_REVOKED)
+			boot_rom_status_update_bringup(boot_desc_verif_base, PROGRESS_VERIFY_KEY_REVOKED);
+		else if (ret == SECUREBOOT_VERIFY_KEY_FAILED)
+			boot_rom_status_update_bringup(boot_desc_verif_base, PROGRESS_VERIFY_KEY_HASH_FAIL);
+		else
+			boot_rom_status_update_bringup(boot_desc_verif_base, PROGRESS_VERIFY_AUTH_FAIL);
+
+		return BOOT_ROM_FAIL;
+	}
+
+	return BOOT_ROM_SUCCESS;
+}
diff --git a/common/secure_boot.c b/common/secure_boot.c
new file mode 100644
index 0000000..6be36ae
--- /dev/null
+++ b/common/secure_boot.c
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2024 HabanaLabs Ltd.
+ * All Rights Reserved.
+ */
+
+#include <mem_io.h>
+#include <string.h>
+#include <boot_rom.h>
+#include <dev_security.h>
+#include "secure_boot.h"
+#include <soc.h>
+#include <sha512.h>
+#include <rsa.h>
+#include <fs1_efuse.h>
+
+bool security_efuse_image_validation_en(void)
+{
+	/* check efuse for security validation enable */
+	uint32_t sig_val = boot_rom_global.sec_data.efuse_sys_cfg & 
+		EFUSE_SYS_CFG_SIGNATURE_VALIDATION_EN;
+
+	return (sig_val > 0);
+}
+
+int security_check_valid_fw_version(uint32_t fw_version)
+{
+	if ((fw_version < boot_rom_global.sec_data.sec_ver) ||
+		(fw_version > SECURITY_MAX_FW_SEC_VERSION)) {
+		return SECURITY_FW_VERSION_NOT_SECURE;
+	}
+
+	return SECURITY_FW_VERSION_SECURE;
+}
+
+int security_check_key_revoke_status(uint32_t key_index)
+{
+	uint8_t key_revoke;
+
+	if (key_index >= NUM_KEYS_IN_ROM)
+		return -1;
+
+	key_revoke = boot_rom_global.sec_data.key_revoke;
+
+	/* if the key is not revoked, return 1 */
+	if ((key_revoke & BIT(key_index)) == 0)
+		return 1;
+
+	/* no valid key found */
+	return -1;
+}
+
+int security_rom_get_key_hash_by_idx(uint32_t *hash, uint8_t key_index)
+{
+	uint32_t *ptr = (uint32_t *)rom_key_hashes[key_index];
+
+	memcpy(hash, ptr, SHA384_SUM_LEN);
+
+	return 0;
+}
+
+int secureboot_verify_key_hash(int key_index, uint8_t *key, uint32_t key_len)
+{
+	uint8_t expected_hash[SHA384_SUM_LEN];
+	uint8_t actual_hash[SHA384_SUM_LEN];
+
+	if (security_rom_get_key_hash_by_idx((uint32_t *)expected_hash, key_index))
+		return SECUREBOOT_VERIFY_KEY_FAILED;
+
+	sha384_csum(key, key_len, actual_hash, 0);
+
+	return memcmp(actual_hash, expected_hash, SHA384_SUM_LEN);
+}
+
+int secureboot_verify_image_signature(const uint8_t *image, uint32_t image_len, uint8_t *key,
+				uint32_t key_len, uint8_t *sig, uint32_t sig_len,
+				uint8_t sec_ver, uint8_t key_index)
+{
+	int ret;
+
+	if (!security_efuse_image_validation_en())
+		return SECUREBOOT_VERIFY_SUCCESS;
+
+	if ((key_len > TOTAL_PUB_KEY_PROPS_SZ) || (sig_len > SIG_SIZE))
+		return SECUREBOOT_VERIFY_FAILED;
+
+	if (security_check_valid_fw_version(sec_ver) != SECURITY_FW_VERSION_SECURE) {
+		return SECUREBOOT_VERIFY_VER_FAILED;
+	}
+
+	ret = security_check_key_revoke_status(key_index);
+	if (ret != 1)
+		return SECUREBOOT_VERIFY_KEY_REVOKED;
+
+	if (secureboot_verify_key_hash(key_index, key, key_len))
+		return SECUREBOOT_VERIFY_KEY_FAILED;
+
+	ret = rsa_verify(image, image_len, key, key_len, sig, sig_len);
+
+	/* 0 - SUCCESS, but arcboot main code, expects 1 for SUCCESS */
+	if (!ret)
+		return SECUREBOOT_VERIFY_SUCCESS;
+
+	return SECUREBOOT_VERIFY_FAILED;
+}
+
+int secureboot_verify_image_hash384(uint8_t *exp_hash, unsigned char *image, uint32_t image_len)
+{
+	uint8_t actual_hash[SHA384_SUM_LEN];
+
+	sha384_csum(image, image_len, actual_hash, 0);
+
+	return memcmp(actual_hash, exp_hash, SHA384_SUM_LEN);
+}
diff --git a/common/secure_boot.h b/common/secure_boot.h
new file mode 100644
index 0000000..7060df1
--- /dev/null
+++ b/common/secure_boot.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Copyright (C) 2024 HabanaLabs Ltd.
+ */
+
+#ifndef _SECURE_BOOT_H_
+#define _SECURE_BOOT_H_
+
+#define SECUREBOOT_VERIFY_KEY_REVOKED	-3
+#define SECUREBOOT_VERIFY_KEY_FAILED	-2
+#define SECUREBOOT_VERIFY_VER_FAILED	-1
+#define SECUREBOOT_VERIFY_FAILED	0
+#define SECUREBOOT_VERIFY_SUCCESS	1
+
+#define SECURITY_FW_VERSION_SECURE			1
+#define SECURITY_FW_VERSION_NOT_SECURE		-1
+
+#define SECURITY_MAX_FW_SEC_VERSION			128
+
+int secureboot_verify_image_signature(const uint8_t *image, uint32_t image_len, uint8_t *key,
+				uint32_t key_len, uint8_t *sig, uint32_t sig_len,
+				uint8_t sec_ver, uint8_t key_index);
+int secureboot_verify_image_hash384(uint8_t *exp_hash, unsigned char *image, uint32_t image_len);
+
+bool security_efuse_image_validation_en(void);
+
+#endif /* _SECURE_BOOT_H_ */
