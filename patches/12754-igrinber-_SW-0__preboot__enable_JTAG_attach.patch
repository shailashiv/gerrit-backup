From 099d7a6200bd9dd79cabe235cc39c91e7ce00773 Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Mon, 20 May 2019 17:39:56 +0300
Subject: [PATCH] [SW-0] preboot: enable JTAG attach

From time to time, we would like to use JTAG debugger during preboot.
Enable JTAG attach during early preboot.

Change-Id: I91fff161d85af0cce49beef61d7d261e9368a513
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/common/preboot.c b/common/preboot.c
index 89654d0..680c56c 100644
--- a/common/preboot.c
+++ b/common/preboot.c
@@ -9,6 +9,7 @@
 #include <stddef.h>
 
 #include <psoc_global_conf_regs.h>
+#include <cpu_ca53_cfg_regs.h>
 #include <hl_fw_if.h>
 #include <hl_boot_if.h>
 
@@ -150,12 +151,23 @@
 		;
 }
 
+static void hl_jtag_init(void)
+{
+	u32 reg, nPRESETDBG = BIT(12);
+
+	/* Enable JTAG attach */
+	reg = regmap_readl(mmCPU_CA53_CFG_ARM_RST_CONTROL);
+	reg |= nPRESETDBG;
+	regmap_writel(reg, mmCPU_CA53_CFG_ARM_RST_CONTROL);
+}
+
 void preboot_main(void)
 {
 	void (*spl_start)(void) = (void *)SPL_TEXT_BASE;
 
 	regmap_writel(CPU_BOOT_STATUS_IN_PREBOOT, get_cpu_boot_status_reg());
 
+	hl_jtag_init();
 	hl_uart_init();
 	preboot_version();
 	preboot_pcie_init();
