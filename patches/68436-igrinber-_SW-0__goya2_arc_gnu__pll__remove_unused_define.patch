From 68d388a71a55bde594cef77e71466e62ce2c5b4e Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Mon, 04 Jan 2021 22:13:48 +0200
Subject: [PATCH] [SW-0] goya2_arc_gnu: pll: remove unused define

GOYA2_UNIT_RST_N_L is unsued - remove it.

Change-Id: Id082d38fbd344cdbf1ccd6ce56e153fb740b4eef
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/goya2_arc_gnu/pll.c b/goya2_arc_gnu/pll.c
index f19beab..340c80c 100644
--- a/goya2_arc_gnu/pll.c
+++ b/goya2_arc_gnu/pll.c
@@ -55,7 +55,6 @@
 #define GOYA2_PLL_CFG		0x100
 #define GOYA2_PLL_CFG_EN	BIT(0)
 #define GOYA2_PLL_CFG_LOCK	BIT(16)
-#define GOYA2_UNIT_RST_N_L	0x4B0
 #define HL_PLL_DIV_FACTOR_CMD	0x220
 
 static void hl_pll_reset(struct hl_pll_cfg *cfg, bool reset)
