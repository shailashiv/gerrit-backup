diff --git a/preboot/module_fwupd.c b/preboot/module_fwupd.c
index 2f26c49..17bbc60 100644
--- a/preboot/module_fwupd.c
+++ b/preboot/module_fwupd.c
@@ -53,7 +53,8 @@
 	regmap_writel(val, mmUPD_STS);
 }
 
-static void fwupd_get_proto_status(struct hl_upd_proto_status *status, int err, int serr)
+static void fwupd_get_proto_status(struct hl_upd_proto_status *status,
+				   int err, int serr)
 {
 	status->version = HL_UPD_PROTO_VERSION;
 	status->compat_mask = cpu_boot_dev_sts_get_all();
@@ -150,35 +151,36 @@
 	case HL_UPD_STS_TIMEOUT_ERR:
 		/*
 		 * The error inform function, work in such a way
-		 * that the error will be set only once (assuming no concurrency)
-		 * so if the error inform function is called before entring the
-		 * current function, module_fwupd_send_status, the second call will not
-		 * overrun its values.
-		 * it allows support legacy code by setting the sent error status as protocol
-		 * error and set it's minor value.
-		 * if
+		 * that the error will be set only once (assuming no
+		 * concurrency) so if the error inform function is called before
+		 * entering the current function, module_fwupd_send_status,
+		 * the second call will not overrun its values.
+		 * it allows support legacy code by setting the sent error
+		 * status as protocol error and set it's minor value.
 		 */
 		preboot_error_inform(HL_FW_ERR_PROTO, sts);
 		if (state->exec_res != FOUND_SLOW_RETURN) {
 			/*
-			 * error status response requires FIT creation, that implies - SLOW MODE
-			 * if an error status request has been done from within a slow
-			 * mode invocation. The request can be serve and skip this conditional
-			 * block.
-			 * otherwise, the control should be returned to the main event loop,
-			 * with request for change into SLOW MODE and execute a command state to
-			 * send the error status. There is not enough commands bits to add this
-			 * command state, so the alternative for that, is using a flag to ask for
-			 * running the state. That condition is not enough; an error should be
-			 * inform in order to trigger the response.
-			 * Both of those condition should be checked in the module's check and run
-			 * functions.
-			 * The error was set previously (2 lines above), and the request
-			 * to change the state is done by this flag.
+			 * error status response requires FIT creation, that
+			 * implies - SLOW MODE
+			 * if an error status request has been done from within
+			 * a slow mode invocation. The request can be served
+			 * and skip this conditional block.
+			 * otherwise, the control should be returned to the main
+			 * event loop,with request for change into SLOW MODE and
+			 * execute a command state to send the error status.
+			 * There is not enough commands bits to add this
+			 * command state, so the alternative for that, is using
+			 * a flag to ask for running the state. That condition
+			 * is not enough; an error should be inform in order to
+			 * trigger the response.
+			 * Both of those condition should be checked in the
+			 * module's check and run functions.
+			 * The error was set previously (2 lines above), and
+			 * the request to change the state is done by this flag.
 			 *
-			 * WARNING:	don't change state->exec_res it is the check function
-			 *		responsibility
-			 *
+			 * WARNING:	don't change state->exec_res it is the
+			 *		check function responsibility
 			 */
 			state->sending_error_flag = true;
 			break;
@@ -193,7 +195,7 @@
 			if (err)
 				tmp_offset = 0;
 		}
-
+		/* no break */
 	default:
 		/* on STS_OK / STS_ACK etc,  the original offset is set */
 		module_fwupd_send_status_fast(state, sts, tmp_offset);
