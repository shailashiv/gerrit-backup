From 7ccb5905f1b33f3a59ba30dbd45a3f1aa9c2b7aa Mon Sep 17 00:00:00 2001
From: Sanyog Kale <skale@habana.ai>
Date: Thu, 25 Aug 2022 20:47:06 +0300
Subject: [PATCH] [SW-86869] gaudi3: add comment in enable/disable twi if

To enhance readability, this patch add comment in
security_enable_twi_if function.

Change-Id: Icaa43c3fd675acc63fa7ac15b0bc6262b2084bb6
---

diff --git a/arch/gaudi3/arc/security.c b/arch/gaudi3/arc/security.c
index ada7adc..e7490ba 100644
--- a/arch/gaudi3/arc/security.c
+++ b/arch/gaudi3/arc/security.c
@@ -505,6 +505,13 @@
 
 void security_enable_twi_if(void)
 {
+	/*
+	 * By default jtag and twi interfaces are privileged.
+	 * ROM sets it to secured when the respective interfaces are
+	 * to be disabled in security_disable_twi_if function.
+	 * In security_enable_twi_if function, no need to configure
+	 * axprot.
+	 */
 	security_smi_access(SMI_EN_VAL);
 }
 
