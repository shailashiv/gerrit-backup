index 0adc63d..7ed8386 100644
--- a/drivers/svid/svid_intel.c
+++ b/drivers/svid/svid_intel.c
@@ -1,48 +1,146 @@
 /*
  * SPDX-License-Identifier: Apache-2.0
  *
- * Copyright 2016-2025 Intel, Ltd.
+ * Copyright 2025 Intel, Ltd.
  * All Rights Reserved.
  */
 
 #include <zephyr/types.h>
 #include <zephyr/kernel.h>
 #include <zephyr/device.h>
+#include <zephyr/devicetree.h>
+#include <zephyr/sys/util.h>
+#include <svid_regs.h>
+#include <hl_platform_defs.h>
+
 
 #include <zephyr/drivers/svid/svid.h>
-
-#define DT_DRV_COMPAT intel_svid
 
 #define LOG_LEVEL CONFIG_SVID_LOG_LEVEL
 
 #include <zephyr/logging/log.h>
 LOG_MODULE_REGISTER(svid);
 
+#if defined(CONFIG_PINCTRL)
+#include <zephyr/drivers/pinctrl.h>
+#endif
+
 #include "svid_intel.h"
 
-typedef int (*svid_api_configure_t)(const struct device *dev, uint32_t dev_config);
-
-struct svid_driver_api {
-	svid_api_configure_t configure;
-};
-
-int svid_configure(const struct device *dev, uint32_t config)
+int svid_config(const struct device *dev, uint32_t config)
 {
+	/* TODO: Initialise below registers may be via NVM
+	 * fast slew rate reg (24h)
+	 * slow slew rate reg (25h)
+	 * vboot register (26h)
+	 */
+
+	/* TODO: set interrupt masks */
+
 	return 0;
 };
 
+int svid_send_cmd(const struct device *dev,
+			uint8_t target_addr,
+			uint8_t command,
+			uint8_t payload,
+			uint16_t *response)
+{
+	const struct svid_config *conf = dev->config;
+	svid_req_t req;
+	uint8_t ack;
+
+	req.cmd_word.addr = target_addr;
+	req.cmd_word.cmd = command;
+	req.cmd_word.payload = payload;
+
+	SVID_WRITE32(req.raw, conf->base_addr + mmSVID_MASTER_REQ);
+
+	*response = SVID_READ32(conf->base_addr + mmSVID_SLAVE_RES);
+	ack = (*response & ACK_BIT_MASK) >> ACK_BIT_POS;
+
+	if (ack != SVID_RSP_ACK) {
+		LOG_ERR("SVID: ACK not received ack_bits = %x", ack);
+		return -1;
+	}
+	LOG_DBG("data read: %x", *response);
+	return 0;
+};
+
+int svid_isr(const struct device *dev)
+{
+	const struct svid_config *conf = dev->config;
+	uint8_t ret;
+
+	/* Read the SVID cause register */
+	ret = SVID_READ32(conf->base_addr + mmSVID_INTR_CTRL_CAUSE);
+
+	LOG_DBG("SVID ISR: cause: %x", ret);
+
+	/* Clear the interrupt */
+	SVID_WRITE32(ret, conf->base_addr + mmSVID_INTR_CTRL_CLEAR);
+
+	return 0;
+}
+
 const struct svid_driver_api funcs = {
-	.configure = svid_configure,
+	.configure = svid_config,
+	.send_command = svid_send_cmd,
 };
 
 int svid_init(const struct device *dev)
 {
-	LOG_INF("SVID Initialized");
-	return 0;
+	const struct svid_config *conf = dev->config;
+	int ret = 0;
+	uint16_t rxd;
+	uint32_t val;
+
+#if defined(CONFIG_PINCTRL)
+	ret = pinctrl_apply_state(conf->pcfg, PINCTRL_STATE_DEFAULT);
+	if (ret) {
+		return ret;
+	}
+#endif
+
+	/* Enable SVID Peripheral clock */
+	SVID_WRITE32(ENABLE, conf->base_addr + mmSVID_CLK_O_EN);
+
+	/* Enable the SVID IP on PSOC */
+	SVID_WRITE32(ENABLE, conf->base_addr + mmSVID_SVID_EN);
+
+	/* Configure SVID timings
+	 * Fast clock is running at 500MHz (2ns)
+	 * BAUDIV 12 (2*12*2ns=48ns)
+	 * Generated SVID clock 20.83MHz
+	 * RQD 10 (delay between requests = 20ns)
+	 * RXD is 636
+	 * 2* 12 *(3 start + 18 command + 3 end + 2.5 TA)
+	 */
+	rxd = conf->baud_div * RXD_MULTIPLIER;
+	val = (rxd << RXD_POS_MASK) | (conf->rqd);
+	SVID_WRITE32(val, conf->base_addr + mmSVID_CFG_1);
+
+	val = ((conf->baud_div << BAUDIV_POS_MASK) | (conf->syncd));
+	SVID_WRITE32(val, conf->base_addr + mmSVID_CFG_2);
+
+	LOG_DBG("SVID driver initialized");
+
+	return ret;
 };
 
-#define SVID_DRIVER_INIT(inst) \
-	DEVICE_DT_INST_DEFINE(inst, svid_init, NULL, NULL, NULL,  \
-	POST_KERNEL, CONFIG_KERNEL_INIT_PRIORITY_DEFAULT, &funcs);
+/* Macro to initialize the driver instance */
+#define SVID_DRIVER_INIT(n)						\
+	PINCTRL_SVID_DEFINE(n);						\
+	SVID_IRQ_CONFIG(n);						\
+	const struct svid_config svid_config_##n = {			\
+		PINCTRL_SVID_CONFIG(n)					\
+		.baud_div = DT_INST_PROP(n, baud_div),			\
+		.syncd = DT_INST_PROP(n, sync_delay),			\
+		.rqd = DT_INST_PROP(n, rq_delay),			\
+		.base_addr = DT_REG_ADDR(DT_NODELABEL(svid##n)),	\
+	};								\
+	DEVICE_DT_INST_DEFINE(n, svid_init, NULL,			\
+		NULL, &svid_config_##n, POST_KERNEL,			\
+		CONFIG_KERNEL_INIT_PRIORITY_DEFAULT, &funcs);
 
 DT_INST_FOREACH_STATUS_OKAY(SVID_DRIVER_INIT)
