--- a/drivers/svid/svid_intel.h
+++ b/drivers/svid/svid_intel.h
@@ -1,10 +1,88 @@
 /*
  * SPDX-License-Identifier: Apache-2.0
  *
- * Copyright 2016-2025 Intel, Ltd.
+ * Copyright 2025 Intel, Ltd.
  * All Rights Reserved.
  */
 #ifndef ZEPHYR_DRIVERS_SVID_INTEL_H_
 #define ZEPHYR_DRIVERS_SVID_INTEL_H_
 
+#define DT_DRV_COMPAT intel_svid
+
+#if defined(CONFIG_PINCTRL)
+#define PINCTRL_SVID_DEFINE(n)	PINCTRL_DT_INST_DEFINE(n)
+#define PINCTRL_SVID_CONFIG(n)	.pcfg = PINCTRL_DT_INST_DEV_CONFIG_GET(n),
+#else
+#define PINCTRL_DW_DEFINE(n)
+#define PINCTRL_DW_CONFIG(n)
+#endif
+
+#define ACK_BIT_MASK		0x3FF
+#define ACK_BIT_POS		0x8
+
+#define RXD_POS_MASK		0x10
+#define BAUDIV_POS_MASK		0x9
+
+#define SVID_START_BITS		3
+#define SVID_CMD_BITS		18
+#define SVID_END_BITS		3
+#define SVID_TA_BITS		2.5
+#define RXD_MULTIPLIER (2 * (SVID_START_BITS +	\
+				SVID_CMD_BITS +	\
+				SVID_END_BITS +	\
+				SVID_TA_BITS))
+
+#define SVID_IRQ_CONFIG(n)
+
+struct svid_config {
+	uint16_t baud_div;
+	uint16_t syncd;
+	uint16_t rqd;
+	uintptr_t base_addr;
+#if defined(CONFIG_PINCTRL)
+	const struct pinctrl_dev_config *pcfg;
+#endif
+};
+
+/**
+ * @brief Configure the SVID device with the specified configuration.
+ *
+ * @param dev Pointer to the SVID device structure.
+ * @param config Configuration value to apply.
+ * @return 0 on success, negative error code on failure.
+ */
+int svid_config(const struct device *dev, uint32_t config);
+
+/**
+ * @brief Send a command to the SVID device.
+ *
+ * @param dev Pointer to the SVID device structure.
+ * @param target_addr Target device address.
+ * @param command Command to send.
+ * @param payload Command payload.
+ * @param response Pointer to store the response from the device.
+ * @return 0 on success, negative error code on failure.
+ */
+int svid_send_cmd(const struct device *dev,
+			uint8_t target_addr,
+			uint8_t command,
+			uint8_t payload,
+			uint16_t *response);
+
+/**
+ * @brief SVID interrupt service routine.
+ *
+ * @param dev Pointer to the SVID device structure.
+ * @return 0 on success, negative error code on failure.
+ */
+int svid_isr(const struct device *dev);
+
+/**
+ * @brief Initialize the SVID device.
+ *
+ * @param dev Pointer to the SVID device structure.
+ * @return 0 on success, negative error code on failure.
+ */
+int svid_init(const struct device *dev);
+
 #endif
