  */
 #ifndef ZEPHYR_DRIVERS_SVID_H_
 #define ZEPHYR_DRIVERS_SVID_H_
 
+#include <errno.h>
+#include <zephyr/sys/slist.h>
+#include <zephyr/types.h>
+#include <zephyr/device.h>
+
+#ifdef __cplusplus
+extern "C" {
 #endif
+
+#define ENABLE				1
+#define DISABLE				0
+/*
+ * ACK1    ACK2    Type
+ * 0       0       Mixed Error
+ * 0       1       Not Acknowledged
+ * 1       0       Acknowledge
+ * 1       1       Reject
+ */
+#define SVID_RSP_MIXED_ERROR		0x00
+#define SVID_RSP_NAK			0x01
+#define SVID_RSP_ACK			0x10
+#define SVID_RSP_REJ			0x11
+
+/* SVID Target Register Macros */
+#define VENDOR_ID_REG			0x00
+#define PROD_ID_REG			0x01
+#define PROD_REV_REG			0x02
+#define PROD_DATE_REG			0x03
+#define LOT_CODE_REG			0x04
+#define PROTOCOL_ID_REG			0x05
+#define CAPABILITY_REG			0x06
+#define STEP_SIZE_REG			0x07
+#define BIAS_VID_TABLE_REG		0x08
+#define VIDOMAX_H_CAPA_REG		0x09
+#define VIDOMAX_L_REG			0x0A
+#define VIN_FULLSCALE_H_REG		0x0B
+#define VIN_FULLSCALE_L_REG		0x0C
+#define VOUT_FULLSCALE_H_REG		0x0D
+#define VOUT_FULLSCALE_L_REG		0x0E
+#define ALLCALL_ACT_REG			0x0F
+#define STATUS1_REG			0x10
+#define STATUS2_REG			0x11
+#define TEMPERATURE_REG			0x12
+#define PMIC_GLOBAL_ST_REG		0x13
+#define LASTREAD_REG			0x14
+#define IOUT_H_REG			0x15
+#define IOUT_L_REG			0x16
+#define VR_TEMP_REG			0x17
+#define POUT_H_REG			0x18
+#define IIN_H_REG			0x19
+#define VIN_H_REG			0x1A
+#define PIN_H_REG			0x1B
+#define STATUS2_LASTREAD_REG		0x1C
+#define PARERR_CNT_REG			0x1D
+#define CFG_FILE_ID_REG			0x1E
+#define I_C2CL_REG			0x1F
+#define ICC_IN_MAX_REG			0x20
+#define ICC_MAX_REG			0x21
+#define TEMP_MAX_REG			0x22
+#define DC_LL_REG			0x23
+#define SR_FAST_REG			0x24
+#define SR_SLOW_REG			0x25
+#define VBOOT_REG			0x26
+#define VR_TOLERANCE_REG		0x27
+#define I_OFFSET_REG			0x28
+#define T_OFFSET_REG			0x29
+#define SLOW_SR_SEL_HC_REG		0x2A
+#define PS4_EXIT_LAT_REG		0x2B
+#define PS3_EXIT_LAT_REG		0x2C
+#define EN_SVID_RDY_T_REG		0x2D
+#define PIN_MAX_REG			0x2E
+#define PIN_ALERT_TH_REG		0x2F
+#define VID_MAX_REG			0x30
+#define VID_SETTING_REG			0x31
+#define PWR_STATE_REG			0x32
+#define OFFSET_REG			0x33
+#define MULTI_VR_CFG_REG		0x34
+#define MAIN_ADDR_PTR_REG		0x35
+#define DC_LL_FINE_REG			0x36
+#define TRACKVID_REG			0x37
+#define WP0_REG				0x3A
+#define WP1_REG				0x3B
+#define WP2_REG				0x3C
+#define WP3_REG				0x3D
+#define WP4_REG				0x3E
+#define WP5_REG				0x3F
+#define WP6_REG				0x40
+#define WP7_REG				0x41
+#define IVID1_VID_REG			0x42
+#define IVID1_I_REG			0x43
+#define IVID2_VID_REG			0x44
+#define IVID2_I_REG			0x45
+#define IVID3_VID_REG			0x46
+#define IVID3_I_REG			0x47
+#define PSYSC_DBC_CLR_REG		0x49
+#define PSYS_CR_LVL_H_REG		0x4A
+#define PSYS_W2_LVL_H_REG		0x4B
+#define PSYS_W1_LVL_H_REG		0x4C
+#define PSYS_WARN2_CNT_REG		0x4D
+#define PSYS_WARN1_CNT_REG		0x4E
+#define PSYS_DBC_SET_REG		0x4F
+#define ICCMAX_ADD_REG			0x50
+
+/* SVID Target Address Macros */
+#define SVID_ADDR_0			0x0
+#define SVID_ADDR_1			0x1
+#define SVID_ADDR_2			0x2
+#define SVID_ADDR_3			0x3
+#define SVID_ADDR_4			0x4
+#define SVID_ADDR_5			0x5
+#define SVID_ADDR_6			0x6
+#define SVID_ADDR_7			0x7
+#define SVID_ADDR_8			0x8
+#define SVID_ADDR_9			0x9
+#define SVID_ADDR_10			0xA
+#define SVID_ADDR_11			0xB
+#define SVID_ADDR_12			0xC
+#define SVID_ADDR_13			0xD
+#define SVID_ADDR_14			0xE
+#define SVID_ADDR_15			0xF
+
+/* SVID Command Definitions */
+#define SETVID_FAST			1
+#define SETVID_SLOW			2
+#define SETVID_DECAY			3
+#define SETPS				4
+#define SETREGADDR			5
+#define SETREGDATA			6
+#define GETREG				7
+#define TEST_MODE			8
+#define SETWP				9
+#define SETREGADDR_VENDOR		10
+#define SETREGDATA_VENDOR		11
+#define GETREG_VENDOR			12
+#define GETREG_PKTRECENT		13
+#define GETREG_PKTALERT			14
+#define GETREG_PKTBAD			15
+#define GETREG_VREVENT			16
+#define SETREGADDR_TESTCFG		17
+#define SETREGDATA_TESTCFG		18
+
+/* Register read write helper macros */
+#define SVID_WRITE32(data, addr)	sys_write32(data, addr)
+#define SVID_READ32(addr)		sys_read32(addr)
+
+typedef union {
+	struct {
+		uint32_t addr: 4 __packed;
+		uint32_t cmd: 5 __packed;
+		uint32_t payload: 8 __packed;
+		uint32_t reserved: 15 __packed;
+	} cmd_word;
+
+	uint32_t raw;
+} svid_req_t;
+
+typedef int (*svid_api_configure_t)(const struct device *dev,
+				uint32_t dev_config);
+
+typedef int (*svid_api_send_cmd_t)(const struct device *dev,
+				uint8_t target_addr, uint8_t command,
+				uint8_t payload, uint16_t *response);
+
+__subsystem struct svid_driver_api {
+	svid_api_configure_t configure;
+	svid_api_send_cmd_t send_command;
+};
+
+/*
+ * @brief Configure the SVID controller
+ *
+ * @param dev    Pointer to the device structure for the driver instance.
+ * @param config Configuration value.
+ *
+ * @retval 0       If successful.
+ * @retval -ENOSYS If function is not implemented by the driver.
+ */
+__syscall int svid_configure(const struct device *dev, uint32_t config);
+
+static inline int z_impl_svid_configure(const struct device *dev, uint32_t config)
+{
+	const struct svid_driver_api *api = (const struct svid_driver_api *)dev->api;
+
+	if (api->configure) {
+		return api->configure(dev, config);
+	}
+
+	return -ENOSYS;
+}
+
+/*
+ * @brief Send a command to the SVID controller
+ *
+ * @param dev          Pointer to the device structure for the driver instance.
+ * @param target_addr  Target address for the command.
+ * @param command      Command to send.
+ * @param payload      Payload for the command.
+ * @param response     Pointer to store the response from the command.
+ *
+ * @retval 0       If successful.
+ * @retval -ENOSYS If function is not implemented by the driver.
+ */
+__syscall int svid_send_command(const struct device *dev,
+				uint8_t target_addr, uint8_t command,
+				uint8_t payload, uint16_t *response);
+
+static inline int z_impl_svid_send_command(const struct device *dev,
+				uint8_t target_addr, uint8_t command,
+				uint8_t payload, uint16_t *response)
+{
+	const struct svid_driver_api *api = (const struct svid_driver_api *)dev->api;
+
+	if (api->send_command) {
+		return api->send_command(dev, target_addr, command, payload, response);
+	}
+
+	return -ENOSYS;
+}
+
+#ifdef __cplusplus
+}
+#endif
+#include <zephyr/syscalls/svid.h>
+
+#endif /* ZEPHYR_DRIVERS_SVID_H_ */
