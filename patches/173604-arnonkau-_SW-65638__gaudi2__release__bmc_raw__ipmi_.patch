From 8b85d639d2d81a2271ab02da9e073981b3c21dc7 Mon Sep 17 00:00:00 2001
From: Arnon Kaufman <akaufman@habana.ai>
Date: Fri, 28 Jan 2022 19:08:28 +0200
Subject: [PATCH] [SW-65638] gaudi2: release: bmc raw (ipmi)

To easily send IPMI raw command to the OAM-BMC
IMPORTANT: no need to send the prefix 0x3c

Change-Id: I5410b3d6fc273207456fff054cdaaeca3fd40ac7
Signed-off-by: Arnon Kaufman <akaufman@habana.ai>
---

diff --git a/scripts/fwi/hls_platform.rc b/scripts/fwi/hls_platform.rc
index 36c0a71..5a4c65f 100644
--- a/scripts/fwi/hls_platform.rc
+++ b/scripts/fwi/hls_platform.rc
@@ -3,6 +3,7 @@
 
 mods_var_register i2c_scan
 mods_var_register i2c_send
+mods_var_register bmc_raw
 mods_var_register oam_enable_uart
 mods_var_register oam_reset
 mods_var_register oam_full_pwr
@@ -27,6 +28,7 @@
 	--btl-mode <enable|disable>                  : disable btl
 	--i2c-scan <bus>                             : show i2c scan
 	--i2c-send <bus>,<addr>,<reg_offset>,[<data>]: send i2c over BMC-OAM
+	--bmc-raw <data>,[<data>,..,<data>]          : send i2c over BMC-OAM
 	--set-pci-sw                                 : reset the pci switch configuration
 	--show-pci-map                               : Shows the pci address map, with correlation to KVM/VM/OAM
 END
@@ -988,6 +990,16 @@
 	pinfo "I2C Res: ${ret[@]}"
 }
 
+function bmc_raw_op()
+{
+	local ret err
+	pinfo -l 2 "bmc_raw ${bmc_raw}"
+	ret=($(bmc_raw_cmd $(delimited_to_array ',' ${bmc_raw})))
+	err=$?
+	pinfo "Res: ${ret[@]}"
+}
+
+
 function oam_i2c_scan_op()
 {
 	local ret err
@@ -1044,6 +1056,11 @@
 		[ $? -ne 0 ] && return 1
 	}
 
+	[ "$bmc_raw" != "" ] && {
+		bmc_raw_op
+		[ $? -ne 0 ] && return 1
+	}
+
 	[ "$set_pci_sw_f" != "" ] && {
 		set_pci_sw
 		[ $? -ne 0 ] && {
