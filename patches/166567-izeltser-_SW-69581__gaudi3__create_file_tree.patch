diff --git a/arch/gaudi3/arc/ppboot.lds.S b/arch/gaudi3/arc/ppboot.lds.S
new file mode 100644
index 0000000..93d8b69
--- /dev/null
+++ b/arch/gaudi3/arc/ppboot.lds.S
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright 2022 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include "common.h"
+
+#ifdef __arc__
+OUTPUT_FORMAT("elf32-littlearc", "elf32-bigarc", "elf32-littlearc")
+OUTPUT_ARCH(arc)
+
+MEMORY
+{
+	.sram 	: ORIGIN = PPBOOT_TEXT_BASE, LENGTH = PPBOOT_SIZE
+	DCCM	: ORIGIN = PPBOOT_DCCM_BASE, LENGTH = 8K
+}
+
+REGION_ALIAS("REGION_DATA",	DCCM)
+REGION_ALIAS("REGION_SDATA",	DCCM)
+REGION_ALIAS("REGION_BSS",	DCCM)
+REGION_ALIAS("REGION_STACK",	DCCM)
+
+#endif
+
+ENTRY(_start)
+SECTIONS
+{
+	.text : {
+		. = ALIGN(8);
+		app/ppboot/crt0_ppboot.o (.text*)
+		*(.text .text.*)
+		_etext = . ;
+	} >.sram
+
+	.rodata : AT ( LOADADDR(.text) + SIZEOF(.text) ) {
+		_rodata = .;
+		*(.rodata .rodata.*)
+		_erodata = . ;
+        } >.sram
+
+	.data : AT ( LOADADDR(.rodata) + SIZEOF(.rodata) ) {
+		. = ALIGN(8);
+		_data = .;
+		*(.data .data.*)
+		_edata = .;
+        } > REGION_DATA
+
+	.sdata : AT ( LOADADDR(.data) + SIZEOF(.data) ) {
+		. = ALIGN(8);
+		_sdata = .;
+		*(.sdata .sdata.* .gnu.linkonce.s.*)
+		_esdata = . ;
+        } > REGION_SDATA
+
+	.bss : {
+		. = ALIGN(8);
+		__bss_start = . ;
+		*(.bss*)
+		__bss_end = . ;
+	} > REGION_BSS
+
+	.stack : {
+		. = ALIGN(8);
+		__stack = . ;
+		. = . + 512 ;
+		__stack_top = . ;
+	} > REGION_STACK
+
+	.stack2 : {
+		. = ALIGN(8);
+		__stack2 = . ;
+		. = . + 512 ;
+		__stack2_top = . ;
+	} > REGION_STACK
+
+	.note.gnu.build-id : { *(.note.gnu.build-id) } > .sram
+}
