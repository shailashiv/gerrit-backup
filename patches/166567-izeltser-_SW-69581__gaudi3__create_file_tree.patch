diff --git a/arch/gaudi3/arc/secondary.S b/arch/gaudi3/arc/secondary.S
new file mode 100644
index 0000000..8c15cd3
--- /dev/null
+++ b/arch/gaudi3/arc/secondary.S
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier:     GPL-2.0+ */
+/*
+ * Copyright (C) 2022 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+.global secondary_entry
+secondary_entry:
+	/* stack top set to secondary CPU DCCM 1k offset (internal address) */
+	mov	sp, __stack2_top
+	mov	fp, sp
+
+	/* Disable un-aligned checks on data memory */
+	lr	r0, [STATUS32]
+	bset	r0, r0, 0x13
+	kflag	r0
+	bl	secondary_main
