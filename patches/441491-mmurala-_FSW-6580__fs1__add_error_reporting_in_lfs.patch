From 99ad1f7d553b805720e36495501b02f2f7cff240 Mon Sep 17 00:00:00 2001
From: Murala S Swamy <ssmurala@habana.ai>
Date: Sat, 10 Aug 2024 09:42:54 +0300
Subject: [PATCH] [FSW-6580] fs1: add error reporting in lfs

With this patch, added support to report errors
in lfs library during run time. It will catch
internal errors during mount, format, read and
write.
With this error report enablement, identified
corrupted dir pair error from lfs_dir_fetchmatch.
This particular error will occuer only when mount
performed on empty disk. So it was recomended
that format and mount the disk when we know disk
is empty in some well known conditions like cold
reset.
There is no error identified when direct mount
without format on disk which has pre existing
data, especially scenarios like hard reset.

Change-Id: If55deb7f41f71025da78caf373fd76c969765f77
---

diff --git a/arch/fs1/arc/common.c b/arch/fs1/arc/common.c
index c690e3a..9989515 100644
--- a/arch/fs1/arc/common.c
+++ b/arch/fs1/arc/common.c
@@ -95,6 +95,11 @@
 	boot_rom_global.die_id = FS1_INVALID_DIE_ID;
 	boot_rom_global.die_type = FS1_INVALID_DIE_TYPE;
 	boot_rom_global.sku = FS1_INVALID_SKU;
+	/*
+	 * Will clear this flag, Irrespective of cold/hard reset.
+	 * So that once in a uptime, flow will format and mount or simple mount.
+	 */
+	boot_rom_global.lfs_disk_mount = false;
 }
 
 #define HL_ARC1_DCCM_PERSIST_SECTION_SIZE		(3 * 1024) /* 3KB */
@@ -157,6 +162,7 @@
 	boot_rom_global.efuse_read = cold_rst_data.efuse_read_flag;
 	boot_rom_global.boot_info_set_done = cold_rst_data.boot_info_set_done;
 	boot_rom_global.tpm_extend_done = cold_rst_data.tpm_validation_flag;
+	boot_rom_global.lfs_non_cold_reset = cold_rst_data.lfs_non_cold_reset;
 }
 
 int boot_rom_mem_init(uint64_t addr, uint32_t size)
@@ -385,3 +391,21 @@
 
 	return 0;
 }
+
+bool boot_rom_lfs_status(bool set)
+{
+	struct fs1_cold_rst_data cold_rst_data;
+
+	if (set == false)
+		/*
+		 * We update boot_rom_global.lfs_non_cold_reset only at begining of boot.
+		 */
+		return (boot_rom_global.lfs_non_cold_reset == 0);
+	else {
+		cold_rst_data.data = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+		cold_rst_data.lfs_non_cold_reset = 1;
+		regmap_writel(cold_rst_data.data, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+	}
+
+	return set;
+}
diff --git a/arch/fs1/arc/progress_bits.h b/arch/fs1/arc/progress_bits.h
index b41af29..c7a889c 100644
--- a/arch/fs1/arc/progress_bits.h
