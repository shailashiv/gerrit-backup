@@ -135,6 +135,8 @@
 	PROGRESS_BOOT_INFO_IMG_DESC_INFO_GET_START = 125,
 	PROGRESS_BOOT_INFO_IMG_DESC_INFO_GET_FINISH = 126,
 	PROGRESS_BOOT_INFO_LFS_DISK_MOUNT_FAIL = 127,
+	PROGRESS_BOOT_INFO_LFS_ERROR = 128,
+	PROGRESS_BOOT_INFO_LFS_ASSERT = 129,
 };
 
 #endif /* _PROGRESS_BITS_H_ */
diff --git a/common/common.h b/common/common.h
index 18d62a0..1797270 100644
--- a/common/common.h
+++ b/common/common.h
@@ -34,5 +34,6 @@
 enum boot_rom_tpm_spi_freq_config boot_rom_get_tpm_spi_freq_config(void);
 void boot_rom_init_sku(void);
 bool boot_rom_in_multi_die_mode(void);
+bool boot_rom_lfs_status(bool set);
 
 #endif /* _COMMON_H_ */
diff --git a/common/littlefs/lfs_util.h b/common/littlefs/lfs_util.h
index faf2d91..3d450f1 100644
--- a/common/littlefs/lfs_util.h
+++ b/common/littlefs/lfs_util.h
@@ -25,6 +25,7 @@
 #include <stdbool.h>
 #include <string.h>
 #include <inttypes.h>
+#include <status.h>
 
 #define LFS_NO_ASSERT
 #define LFS_NO_MALLOC
@@ -84,7 +85,7 @@
 #ifndef LFS_ERROR
 #ifndef LFS_NO_ERROR
 #define LFS_ERROR_(fmt, ...)
-#define LFS_ERROR(...) LFS_ERROR_(__VA_ARGS__, "")
+#define LFS_ERROR(...) boot_rom_status_update(PROGRESS_BOOT_INFO_LFS_ERROR);
 #else
 #define LFS_ERROR(...)
 #endif
@@ -93,7 +94,7 @@
 // Runtime assertions
 #ifndef LFS_ASSERT
 #ifndef LFS_NO_ASSERT
-#define LFS_ASSERT(test) assert(test)
+#define LFS_ASSERT(test) boot_rom_status_update(PROGRESS_BOOT_INFO_LFS_ASSERT);
 #else
 #define LFS_ASSERT(test)
 #endif
diff --git a/common/littlefs/lfs_wrapper.c b/common/littlefs/lfs_wrapper.c
index efdc55d..c50c871 100644
--- a/common/littlefs/lfs_wrapper.c
+++ b/common/littlefs/lfs_wrapper.c
@@ -13,12 +13,10 @@
 #include <lfs_wrapper.h>
 #include <dev_boot_info.h>
 #include <status.h>
+#include <common.h>
 
 #define DST_SAFE	true
 #define DST_UNSAFE	false
-
-/* TODO: LFS_GLOBAL_VAR_SECTION */
-bool lfs_init_done = false;
 
 static void memcpy32_rev(void *dst, void *src, int size)
 {
@@ -176,20 +174,31 @@
 {
 	int err;
 
-	if (lfs_init_done)
+	if (boot_rom_global.lfs_disk_mount)
 		return 0;
 
-	err = lfs_mount(&lfs, &lfs_cfg);
-	if (err) {
+	if (boot_rom_lfs_status(false)) {
+		/* Always format to make sure start with fresh disk in CR */
 		err = lfs_format(&lfs, &lfs_cfg);
-		if (!err)
+		if (!err) {
 			err = lfs_mount(&lfs, &lfs_cfg);
+			boot_rom_lfs_status(true);
+		}
+	} else {
+		/* Any hard reset scenario's,
+		 * First mount should be always success bcz we have data of previous CR
+		 */
+		err = lfs_mount(&lfs, &lfs_cfg);
 	}
 
 	if (!err) {
-		lfs_init_done = true;
+		boot_rom_global.lfs_disk_mount = true;
 	} else {
 		boot_rom_status_update(PROGRESS_BOOT_INFO_LFS_DISK_MOUNT_FAIL);
+		/*
+		 * TODO: Boot rom going ahead without LFS?
+		 * How to inform to other modules?
+		 */
 	}
 
 	return err;
