From b1d56edfdf18321fe6f469e9a1c74fa16499362a Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Thu, 18 Apr 2019 08:56:07 +0300
Subject: [PATCH] [SW-0] preboot: use flops register per device

Each device got its own flops registers.

Change-Id: I77f3442f522757bbc11dec973265a61119f829c1
---

diff --git a/common/preboot.c b/common/preboot.c
index d3efa8c..3ba1436 100644
--- a/common/preboot.c
+++ b/common/preboot.c
@@ -38,18 +38,18 @@
 	char *spl_image = "candidate";
 
 	modifiable_image_pending =
-			regmap_readl(mmPSOC_GLOBAL_CONF_NON_RST_FLOPS_3);
+			regmap_readl(NON_RST_FLOPS_3);
 	if (modifiable_image_pending == FLOPS_UPD_PENDING) {
 		next_image_modifiable =
 			(*(unsigned int *)(HL_SPI_BASE + 0x60004) & 0xff) - '1';
 		if (next_image_modifiable < 2) {
 			next_image = next_image_modifiable;
 			regmap_writel((next_image + FLOPS_UPD_NXT_IMG1),
-					mmPSOC_GLOBAL_CONF_NON_RST_FLOPS_3);
+					NON_RST_FLOPS_3);
 			try_new_image = true;
 		} else
 			regmap_writel(FLOPS_UPD_NOOP,
-					mmPSOC_GLOBAL_CONF_NON_RST_FLOPS_3);
+					NON_RST_FLOPS_3);
 	}
 
 	if (!try_new_image) {
diff --git a/gaudi/gaudi.h b/gaudi/gaudi.h
index a23cdeb..7fc72bd 100644
--- a/gaudi/gaudi.h
+++ b/gaudi/gaudi.h
@@ -16,6 +16,8 @@
 #define UART_BAUDDIV			(PCI_DIV2_CLOCK / 115200)
 #define SPI_BAUDR			(PCI_DIV2_CLOCK / 25000000)
 
+#define NON_RST_FLOPS_3			mmPSOC_GLOBAL_CONF_COLD_RST_FLOPS_3
+
 void preboot_pcie_wait_for_link(void);
 static inline void preboot_delay(void) {}
 static inline void preboot_putc_virt_uart(const char c) {}
diff --git a/goya/goya.h b/goya/goya.h
index 6b95944..323cd75 100644
--- a/goya/goya.h
+++ b/goya/goya.h
@@ -12,6 +12,8 @@
 #define mmIC_PLL_BASE		0x4A3000
 #define CPU_PLL_BASE		mmCPU_PLL_BASE
 
+#define NON_RST_FLOPS_3		mmPSOC_GLOBAL_CONF_NON_RST_FLOPS_3
+
 void preboot_pcie_wait_for_link(void);
 void preboot_delay(void);
 void preboot_putc_virt_uart(const char c);
