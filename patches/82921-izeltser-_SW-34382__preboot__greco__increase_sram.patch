From b5846edc32b493f23a99a8af73502101f847a0a8 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Mon, 15 Mar 2021 16:45:31 +0200
Subject: [PATCH] [SW-34382] preboot: greco: increase sram

Handling boot info from scratchpad sram, specifically nvme
descriptor, has increased the bss utilization.
increasing to a max of 128kb

Change-Id: I93af56200ec6a629751985aceeb65276648b632b
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/greco/common.h b/greco/common.h
index f12a77d..89738f3 100644
--- a/greco/common.h
+++ b/greco/common.h
@@ -11,7 +11,7 @@
 #include <bitops.h>
 
 #define PPBOOT_SIZE			0x5000		/* 20KB */
-#define PREBOOT_SIZE			0xC000		/* 48KB */
+#define PREBOOT_SIZE			0x20000		/* 128KB */
 
 #define SRAM_SIZE			0x8000000	/* 128MB */
 #define HL_SP_SRAM_SIZE			0x10000
