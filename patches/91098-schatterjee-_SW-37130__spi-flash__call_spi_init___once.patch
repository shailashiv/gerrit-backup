From 49d7b53aabbf2a4cefd5bc3d6f08537f846e66ed Mon Sep 17 00:00:00 2001
From: Subrata Chatterjee <schatterjee@habana.ai>
Date: Mon, 26 Apr 2021 17:40:31 +0300
Subject: [PATCH] [SW-37130] spi-flash: call spi_init() once

Flag added to avoid multiple spi_init() calls.

Change-Id: I2f507b46d525f75f4fe8586c63b544f368d4e019
Signed-off-by: Subrata Chatterjee <schatterjee@habana.ai>
---

diff --git a/common/spi.c b/common/spi.c
index 389c451..fc5c81a 100644
--- a/common/spi.c
+++ b/common/spi.c
@@ -46,6 +46,8 @@
 #define PAGE_SIZE			0x10000
 
 static unsigned int spi_regs;
+static bool spi_initialized;
+
 /*
  * SSI device Chip Select (CS0) is combined with GPIO53
  * Using this we can really do SSI bus claim/release
@@ -256,8 +258,12 @@
 
 static void spi_init(void)
 {
-	u32 baudr = hl_spi_baudr_get();
+	u32 baudr;
 
+	if (spi_initialized)
+		return;
+
+	baudr = hl_spi_baudr_get();
 	/* Validate that baudr is even */
 	baudr = (baudr + 1) & ~1;
 
@@ -270,6 +276,8 @@
 	regmap_writel(0x0000003F, spi_regs + IMR);	/* Disable Interrupts */
 	regmap_writel(0x00000001, spi_regs + SER);
 	regmap_writel(0x00000001, spi_regs + SSIENR);
+
+	spi_initialized = true;
 }
 
 void spi_prot(void)
