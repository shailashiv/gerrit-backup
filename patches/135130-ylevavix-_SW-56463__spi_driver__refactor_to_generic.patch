diff --git a/lib/common/spi_flash.c b/lib/common/spi_flash.c
new file mode 100644
index 0000000..203e1d6
--- /dev/null
+++ b/lib/common/spi_flash.c
@@ -0,0 +1,219 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2021 HabanaLabs Ltd.
+ * All Rights Reserved.
+ */
+
+#include <psoc_gpio3_regs.h>
+#include <psoc_spi_regs.h>
+#include <bitops.h>
+#include <stddef.h>
+#include <stdbool.h>
+
+#include <psoc_gpio3_regs.h>
+#include <psoc_spi_regs.h>
+
+#include <bitops.h>
+#include <preboot.h>
+#include "common.h"
+#include <spi.h>
+#include "uart.h"
+#include <pll.h>
+
+#include "spi_flash.h"
+
+/* spi flash commands */
+#define CMD_WRITE_STATUS		0x01
+#define CMD_READ			0x03
+#define CMD_WRITE_DISABLE		0x04
+#define CMD_READ_STATUS			0x05
+#define CMD_WRITE_ENABLE		0x06
+#define CMD_FLAG_STATUS			0x70
+#define CMD_ERASE			0xD8
+#define READ_STATUS_PEC			(1 << 7)
+
+/* Used for Macronix flashes only. */
+#define SPINOR_OP_ENSO			0xB1
+#define SPINOR_OP_EXSO			0xC1
+
+#define PAGE_SIZE			0x10000
+
+static struct spi_ctx flash_spi = {0};
+
+static void spi_ssi_cs_init(void)
+{
+	unsigned int reg, mask, data, out_en;
+
+	spi_ssi_cs0_get(&mask, &data, &out_en);
+
+	reg  = regmap_readl(data);
+	reg  &= ~mask;
+	regmap_writel(reg, data);
+
+	reg = regmap_readl(out_en);
+	reg |= mask;
+	regmap_writel(reg, out_en);
+}
+
+static void spi_flash_claim_bus(void)
+{
+	regmap_writel(1, get_cs_pad_sel_flash());
+}
+
+static void spi_flash_release_bus(void)
+{
+	regmap_writel(0, get_cs_pad_sel_flash());
+}
+
+void spi_flash_init(void)
+{
+	spi_flash_base_get(&flash_spi.spi_base);
+	flash_spi.spi_initialized = false;
+	flash_spi.spi_access_is_locked = false;
+	flash_spi.cs_init = spi_ssi_cs_init;
+	flash_spi.claim_bus = spi_flash_claim_bus;
+	flash_spi.release_bus = spi_flash_release_bus;
+	flash_spi.fifo_len = 0;
+	spi_init(&flash_spi);
+}
+
+/*
+ * 40ms as worst case WRSR cycle time given in mx25u25635f datasheet.
+ * 2sec is the worse erase time according to DS.
+ */
+#define SPI_WRITE_WAIT_TIMEOUT_US	2000000
+static int spi_flash_common_write(unsigned int cmd, unsigned char *buf,
+				size_t size, int cmd_size)
+{
+	int ret = 0;
+	unsigned char sr;
+	u64 start = timestamp_get_us();
+
+	spi_char_cmd_csel(&flash_spi, CMD_WRITE_ENABLE, NULL);
+	do {
+		spi_char_cmd_csel(&flash_spi, CMD_READ_STATUS, &sr);
+		if (timeout_expired(start, SPI_WRITE_WAIT_TIMEOUT_US))
+			return 1;
+	} while (!(sr & READ_STATUS_WEL));
+
+	start = timestamp_get_us();
+	spi_special_cmd_csel(&flash_spi, cmd, buf, size, cmd_size);
+	do {
+		spi_char_cmd_csel(&flash_spi, CMD_READ_STATUS, &sr);
+		if (timeout_expired(start, SPI_WRITE_WAIT_TIMEOUT_US)) {
+			ret = 1;
+			break;
+		}
+	} while (sr & READ_STATUS_WIP);
+
+	spi_char_cmd_csel(&flash_spi, CMD_WRITE_DISABLE, NULL);
+
+	return ret;
+}
+
+void spi_flash_read(void *dst, unsigned int offset, unsigned int size)
+{
+	unsigned int cmd = (CMD_READ << 24) | offset;
+	int i;
+
+	spi_flash_claim_bus();
+	spi_dev_update_frame_size(&flash_spi, sizeof(cmd));
+	spi_dev_dword_cmd(&flash_spi, cmd, NULL);
+	for (i = 0; i < size; i += sizeof(unsigned int))
+		spi_dev_dword_cmd(&flash_spi, 0, dst + i);
+	spi_dev_dword_cmd(&flash_spi, 0, NULL);
+	spi_flash_release_bus();
+}
+
+void spi_flash_copy(void *dst, unsigned int offset, unsigned int size,
+			char *name)
+{
+	if (spi_is_locked(&flash_spi))
+		return;
+
+	spi_flash_init();
+	spi_flash_read(dst, offset, size);
+
+	if (name) {
+		preboot_puts_raw(name);
+		preboot_puts(" copying from flash is completed\n");
+	}
+}
+
+void spi_flash_copy_otp(void *dst, unsigned int offset, unsigned int size)
+{
+	if (spi_is_locked(&flash_spi))
+		return;
+
+	spi_flash_init();
+	spi_char_cmd_csel(&flash_spi, SPINOR_OP_ENSO, NULL);
+	spi_flash_read(dst, offset, size);
+	spi_char_cmd_csel(&flash_spi, SPINOR_OP_EXSO, NULL);
+}
+
+void spi_flash_prot(void)
+{
+	unsigned char sr;
+
+	if (spi_is_locked(&flash_spi))
+		return;
+
+	spi_flash_init();
+
+	spi_char_cmd_csel(&flash_spi, CMD_READ_STATUS, &sr);
+	sr |= PROT_MASK;
+	spi_flash_common_write(CMD_WRITE_STATUS, &sr, sizeof(sr), 1);
+}
+
+int spi_flash_erase(unsigned int offset, unsigned int size)
+{
+	unsigned int i;
+	unsigned int cmd = CMD_ERASE;
+	int ret;
+
+	if (spi_is_locked(&flash_spi))
+		return 1;
+
+	for (i = 0; i < size; i += PAGE_SIZE) {
+		ret = spi_flash_common_write(cmd |
+					__builtin_bswap32(offset + i), NULL, 0,
+					sizeof(cmd));
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+__weak void spi_flash_prot_early(void)
+{
+	spi_flash_prot();
+}
+
+__weak void spi_flash_prot_late(void) {}
+
+void spi_flash_prot_status(void)
+{
+	unsigned char sr = 0;
+
+	if (!flash_spi.spi_initialized) {
+		preboot_puts("spi not initialized\n");
+		return;
+	}
+
+	if (spi_is_locked(&flash_spi))
+		return;
+
+	spi_char_cmd_csel(&flash_spi, CMD_READ_STATUS, &sr);
+
+	if ((sr & READ_STATUS_BP0_3) && (sr & READ_STATUS_SRWD)
+				&& !(sr & READ_STATUS_WEL))
+		preboot_puts("Flash may be protected, depend on WP# signal\n");
+	else
+		preboot_puts("Flash is not protected\n");
+}
+
+void spi_flash_lock_access(bool is_lock)
+{
+	spi_lock_access(&flash_spi, is_lock);
+}
