 #ifndef _EFUSE_H_
 #define _EFUSE_H_
-#define EFUSE_SYSCFG_OFFSET		0x3A
 
-#define EFUSE_DISABLE_DEBUG_IF_MASK	BIT(12)
+#define EFUSE_SYSCFG_OFFSET			0x3A
+
+#define EFUSE_SYSCFG_DISABLE_DEBUG_IF_MASK	BIT(12)
+#define EFUSE_SYSCFG_SECURITY_LOCATION		7
+#define EFUSE_SYSCFG_SECURITY_LOCATION_MASK	0x3
