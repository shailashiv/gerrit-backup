From a93474c6eaee1f6dd7ceb47e0188b4206113a751 Mon Sep 17 00:00:00 2001
From: Noam Lessner <nlessner@habana.ai>
Date: Wed, 29 Jan 2020 00:38:49 +0200
Subject: [PATCH] [SW-8228] goya2: add reading of fuses

Add functions to support reading of security fuses on start.

Change-Id: I7c939409c74d8a18a6a90eefae3df1789e917255
---

diff --git a/app/arcboot_rom.c b/app/arcboot_rom.c
index 1234a1f..e7ed554 100644
--- a/app/arcboot_rom.c
+++ b/app/arcboot_rom.c
@@ -9,28 +9,64 @@
 #include "efuse.h"
 #include "security.h"
 
-void arcboot_rom_init()
+struct arcboot_global_s arcboot_rom_global = {
+	.config_fuse = 0,
+};
+
+static void arcboot_rom_init(void) {}
+
+static void arcboot_rom_fuse(void)
 {
-	u32 config_fuse = 0;
-	fuse_read(EFUSE_SYSCFG_OFFSET, &config_fuse);
-	if (config_fuse & EFUSE_DISABLE_DEBUG_IF_MASK)
+	uint8_t hash_key_index;
+	uint8_t fw_version_sec = 0;
+	uint32_t key_revoke = 0;
+	uint32_t key_hash[SECURITY_KEY_HASH_ARRAY_SIZE];
+	enum security_location current_security_location;
+
+	fuse_read(EFUSE_SYSCFG_OFFSET, &arcboot_rom_global.config_fuse);
+	if (arcboot_rom_global.config_fuse & EFUSE_SYSCFG_DISABLE_DEBUG_IF_MASK)
 		security_disable_debug_if();
 
+	/* read security location from efuse */
+	current_security_location =
+		((arcboot_rom_global.config_fuse >>
+		  EFUSE_SYSCFG_SECURITY_LOCATION) &
+		  EFUSE_SYSCFG_SECURITY_LOCATION_MASK);
+
+	switch (current_security_location) {
+	case SPI_FLASH:
+		break;
+	case SPI_OTP:
+		break;
+	case ASIC_EFUSE:
+		/* TODO: finish efuse hash get and fw_ver_sec */
+		key_revoke = arcboot_rom_global.config_fuse &
+			     EFUSE_SYSCFG_REVOKE_KEY_MASK;
+		break;
+	}
+
+	/* store key_revoke map in PSOC */
+	regmap_writel(key_revoke, mmPSOC_SECURITY_KEY_REVOKE);
+
+	/* store minimum allowed security version in PSOC */
+	regmap_writel(SECURITY_FW_VERSION_FROM_SECURITY_BYTE(fw_version_sec),
+		      mmPSOC_SECURITY_MIN_FW_VERSION);
+
+	/* store habana key hash in PSOC */
+	for (hash_key_index = 0; hash_key_index < SECURITY_KEY_HASH_ARRAY_SIZE;
+	     hash_key_index++)
+		regmap_writel(key_hash[hash_key_index],
+			      security_key_soc_location_offset(hash_key_index));
 }
 
-void arcboot_rom_bringup_pcie()
-{
+static void arcboot_rom_bringup_pcie(void) {}
 
-}
-
-void arcboot_rom_bringup_arcboot_ram()
-{
-
-}
+static void arcboot_rom_bringup_arcboot_ram(void) {}
 
 int arcboot_rom_main(void)
 {
 	arcboot_rom_init();
+	arcboot_rom_fuse();
 	arcboot_rom_bringup_pcie();
 	arcboot_rom_bringup_arcboot_ram();
 
