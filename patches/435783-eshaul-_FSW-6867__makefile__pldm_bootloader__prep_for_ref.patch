diff --git a/arch/fs1/arc/palad.c b/arch/fs1/arc/palad.c
new file mode 100644
index 0000000..e4da780
--- /dev/null
+++ b/arch/fs1/arc/palad.c
@@ -0,0 +1,288 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * (C) Copyright 2023 HabanaLabs, Ltd.
+ */
+
+#include <psoc_pad_conf_regs.h>
+#include <pcie_dbi_regs.h>
+#include <pcie_dbi_masks.h>
+#include <pcie_aux_regs.h>
+#include <pcie_aux_masks.h>
+#include <psoc_boot_conf_regs.h>
+#include <psoc_boot_conf_masks.h>
+#include <arc_regs.h>
+#include <fs1_blocks_linux_driver.h>
+
+#include <baremetal.h>
+#include <pll.h>
+#include <uart.h>
+#include <bitops.h>
+#include <fs1_reg_map.h>
+#include <fs1_efuse.h>
+#include <efuse.h>
+#include <hl.h>
+
+#define SYS_CLOCK_FREQUENCY	250000000ULL /* PCI PLL DIV3 Emulation clk */
+
+#define UART_CLOCK_FREQUENCY	SYS_CLOCK_FREQUENCY
+#define PALAD_UART_BAUDRATE	300
+
+/*
+ * This cfg specific to PALAD bumps up uart freq
+ * to 250 MHz while keeping other divs on nominal frequency
+ */
+static struct hl_pll_cfg fs1_psoc_pll_cfg[] = {
+	{
+		.name = "PSOC", .base = mmIO_0_CFG_HALF_0_SOC_0_PLL_0_PSOC_PLL_BASE,
+		.nr = 1, .nf = 240, .od = 3, .nb = 2,
+		.div_factor = { 0, 1, 4, 3 },
+		.div_sel = { HL_PLL_PLL_CLK,
+			     HL_PLL_DIV_PLL,
+			     HL_PLL_DIV_PLL,
+			     HL_PLL_DIV_PLL
+		},
+	},
+};
+
+u64 hl_pll_timestamp_freq_get(void)
+{
+	return SYS_CLOCK_FREQUENCY;
+}
+
+u32 hl_skip_pcie_init(void)
+{
+	return 0;
+}
+
+u32 hl_spi_baudr_get(void)
+{
+	u32 factor = SYS_CLOCK_FREQUENCY / HL_SPI_FLASH_MAX_FREQ;
+
+	/* baud rate doesn't support odd number and must not be 0 */
+	factor = (factor < 2) ? 2 : factor;
+
+	return (factor + 1) & 0xFFFE;
+}
+
+void hl_uart_init(void)
+{
+	regmap_writel(1, mmIO_0_CFG_HALF_0_PSOC_PSOC_CFG_PAD_CONF_BASE +
+			 mmPSOC_PAD_CONF_PAD_SEL_49);				/* UART0 RXD */
+	regmap_writel(1, mmIO_0_CFG_HALF_0_PSOC_PSOC_CFG_PAD_CONF_BASE +
+			 mmPSOC_PAD_CONF_PAD_SEL_50);				/* UART0 TXD */
+	preboot_uart_init(UART_CLOCK_FREQUENCY / PALAD_UART_BAUDRATE);
+}
+
+#define PSOC_HBW_DIV_ID		0
+#define PSOC_LBW_DIV_ID		1
+#define PSOC_CFG_DIV_ID		2
+#define PSOC_UART_DIV_ID	3
+
+void hl_dev_psoc_pll_init(void)
+{
+	hl_pll_reconfig_div(fs1_psoc_pll_cfg, PSOC_UART_DIV_ID);
+	hl_pll_reconfig_div(fs1_psoc_pll_cfg, PSOC_HBW_DIV_ID);
+	hl_pll_reconfig_div(fs1_psoc_pll_cfg, PSOC_LBW_DIV_ID);
+	hl_pll_reconfig_div(fs1_psoc_pll_cfg, PSOC_CFG_DIV_ID);
+}
+
+static bool is_cxl_mode(void)
+{
+	u32 val;
+
+	val = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_BOOT_STRAP_PINS_H));
+	val &= PSOC_BOOT_CONF_BOOT_STRAP_PINS_H_CXL_MODE_M;
+
+	return !!val;
+}
+
+#define SRIOV_MAX_NUM_VFS	4
+#define SRIOV_DEFAULT_NUM_VFS	1
+
+static void palad_pcie_dynamic_init(void)
+{
+	bool cxl_mode = is_cxl_mode();
+	u32 pci_efuse_cfg;
+	u8 num_vf = 0;
+	u32 val;
+
+	hl_fuse_read(mmIO_0_CFG_HALF_0_PSOC_PSOC_CFG_EFUSE_BASE, IO_EFUSE_PLDM_CFG_0_OFFSET,
+		     &pci_efuse_cfg);
+	preboot_puts_hex("efuse pci cfg = ", pci_efuse_cfg, false);
+
+	if (cxl_mode) {
+		/* CXL capability is enabled as reset default */
+
+		/* disable CXL.Cache capability if required */
+		if (!(pci_efuse_cfg & CXL_CACHE_CAP_ENABLED_M)) {
+			val = regmap_readl(IO0_H0_PCIE_DBI(
+						mmPCIE_DBI_CXL_RCRB_DVSEC_HDR_2_FLEXBUS_CAP_OFF));
+			val &= ~PCIE_DBI_CXL_RCRB_DVSEC_HDR_2_FLEXBUS_CAP_OFF_CACHE_CAP_M;
+			regmap_writel(val, IO0_H0_PCIE_DBI(
+						mmPCIE_DBI_CXL_RCRB_DVSEC_HDR_2_FLEXBUS_CAP_OFF));
+			val = regmap_readl(IO0_H0_PCIE_DBI(
+						mmPCIE_DBI_CXL_RCIEP_DVSEC_HDR_2_FLEXBUS_CAP_OFF));
+			val &= ~PCIE_DBI_CXL_RCIEP_DVSEC_HDR_2_FLEXBUS_CAP_OFF_CACHE_CAP_M;
+			regmap_writel(val, IO0_H0_PCIE_DBI(
+						mmPCIE_DBI_CXL_RCIEP_DVSEC_HDR_2_FLEXBUS_CAP_OFF));
+		}
+	} else { /* pci mode */
+		/* switch to PCI mode by disabling Alternative Protocol Support */
+		val = regmap_readl(IO0_H0_PCIE_DBI(mmPCIE_DBI_PL32G_CAPABILITY_REG));
+		val &= ~PCIE_DBI_PL32G_CAPABILITY_REG_MOD_TS_ALT_PROTOCOL_SUPPORT_M;
+		regmap_writel(val, IO0_H0_PCIE_DBI(mmPCIE_DBI_PL32G_CAPABILITY_REG));
+
+		/* set number of VFs */
+		num_vf = pci_efuse_cfg & SRIOV_NUM_OF_VFS_M;
+		if (num_vf > SRIOV_MAX_NUM_VFS) {
+			num_vf = SRIOV_DEFAULT_NUM_VFS;
+			preboot_puts("VF exceeds 4, using default of 1 VF\n");
+		}
+
+		val = num_vf << PCIE_DBI_TOTAL_VFS_INITIAL_VFS_REG_SRIOV_INITIAL_VFS_S |
+		      num_vf << PCIE_DBI_TOTAL_VFS_INITIAL_VFS_REG_SRIOV_TOTAL_VFS_S;
+		regmap_writel(val, IO0_H0_PCIE_DBI(mmPCIE_DBI_TOTAL_VFS_INITIAL_VFS_REG));
+	}
+
+	/* skip ATS capability */
+	if (!(pci_efuse_cfg & ATS_CAPABILITY_ENABLED_M)) {
+		val = regmap_readl(IO0_H0_PCIE_DBI(mmPCIE_DBI_SRIOV_BASE_REG));
+		val &= ~PCIE_DBI_SRIOV_BASE_REG_SRIOV_NEXT_OFFSET_M;
+		val |= mmPCIE_DBI_LTR_CAP_HDR_REG <<
+			PCIE_DBI_SRIOV_BASE_REG_SRIOV_NEXT_OFFSET_S;
+		regmap_writel(val, IO0_H0_PCIE_DBI(mmPCIE_DBI_SRIOV_BASE_REG));
+	}
+}
+
+#define BAR_SIZE_1GB		(SZ_1G - 1)
+#define VF_RES_BAR_SIZES	(PCIE_DBI_VF_RESBAR_CAP_REG_2_REG_V512GB_M | \
+				 PCIE_DBI_VF_RESBAR_CAP_REG_2_REG_V256GB_M | \
+				 PCIE_DBI_VF_RESBAR_CAP_REG_2_REG_V128GB_M | \
+				 PCIE_DBI_VF_RESBAR_CAP_REG_2_REG_V64GB_M)
+
+static void palad_pcie_params_init(void)
+{
+	u32 val;
+
+	/* enable writing to DBI RO regs */
+	val = regmap_readl(IO0_H0_PCIE_DBI(mmPCIE_DBI_MISC_CONTROL_1_OFF));
+	val |= PCIE_DBI_MISC_CONTROL_1_OFF_DBI_RO_WR_EN_M;
+	regmap_writel(val, IO0_H0_PCIE_DBI(mmPCIE_DBI_MISC_CONTROL_1_OFF));
+
+	/* switch to shadow registers access in order to set BAR masks */
+	regmap_writel(PCIE_AUX_DBI_CS2_M, mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_DBI);
+
+	/* set PF CFG BAR to 1GB */
+	regmap_writel(BAR_SIZE_1GB, IO0_H0_PCIE_DBI(mmPCIE_DBI_BAR0_REG));
+	regmap_writel(0, IO0_H0_PCIE_DBI(mmPCIE_DBI_BAR1_REG));
+
+	/* set SRIOV CFG BAR to 1GB */
+	regmap_writel(BAR_SIZE_1GB, IO0_H0_PCIE_DBI(mmPCIE_DBI_SRIOV_BAR0_REG));
+	regmap_writel(0, IO0_H0_PCIE_DBI(mmPCIE_DBI_SRIOV_BAR1_REG));
+
+	/* disable shadow registers access */
+	regmap_writel(0, mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_DBI);
+
+	/* set VF resizable BAR #2 allowed size */
+	regmap_writel(VF_RES_BAR_SIZES, IO0_H0_PCIE_DBI(mmPCIE_DBI_VF_RESBAR_CAP_REG_2_REG));
+
+	palad_pcie_dynamic_init();
+
+	/* disable writing to DBI RO regs */
+	val = regmap_readl(IO0_H0_PCIE_DBI(mmPCIE_DBI_MISC_CONTROL_1_OFF));
+	val &= ~PCIE_DBI_MISC_CONTROL_1_OFF_DBI_RO_WR_EN_M;
+	regmap_writel(val, IO0_H0_PCIE_DBI(mmPCIE_DBI_MISC_CONTROL_1_OFF));
+}
+
+#define LTTSM_ENA_MASK	(PCIE_AUX_LTSSM_EN_IND_M | PCIE_AUX_LTSSM_EN_MASK_M)
+
+void preboot_pcie_wait_for_link(void)
+{
+	palad_pcie_params_init();
+
+	regmap_writel(LTTSM_ENA_MASK, mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE +
+				      mmPCIE_AUX_LTSSM_EN);
+}
+
+
+/*
+ * pcie pll is initialized by the boot fsm to nominal values (in secured boot mode). In order to
+ * support uart prints on palad only div3 of the PSOC pll should be modified.
+ */
+void btldr_pll_fixup(uint32_t die_id)
+{
+	hl_dev_psoc_pll_init();
+}
+
+/*
+ * ARC must not be in reset state when accessing the CCM modules.
+ * bloader is using CCM memories of MNG and MISC ARCs. MNG is already running, only MISC's reset
+ * need to be deasserted.
+ */
+void btldr_parc_prepare(void)
+{
+	regmap_writel(0, mmIO_0_CFG_HALF_0_PSOC_ARC_MISC_ARC_BASE + mmARC_ARC_RST);
+}
+
+static void btldr_copy_preboot_app(void)
+{
+	int err;
+	u32 val;
+
+	/*
+	 * Clean copy of the application is stored in MNG ICCM. In case the application binary
+	 * exceeds MNG ICCM size (256kb), the rest is stored in MISC ICCM.
+	 * An efuse bit is controlling whether the application binary is larger than MNG ICCM size.
+	 */
+	fs1_mem_copy(ARC_MNG_ICCM_FULL_BASE, PREBOOT_TEXT_BASE_FULL, ARC_MNG_ICCM_SIZE, false);
+
+	err = preboot_fuse_read(IO_EFUSE_PLDM_CFG_0_OFFSET, &val);
+	if (err)
+		val = BLOADER_COPY_LARGE_APP;
+
+	val &= BLOADER_COPY_LARGE_APP;
+
+	if (!val)
+		return;
+
+	fs1_mem_copy(ARC_MISC_ICCM_FULL_BASE, PREBOOT_TEXT_BASE_FULL + ARC_MNG_ICCM_SIZE,
+		     ARC_MISC_ICCM_SIZE, false);
+}
+
+static void btldr_copy_bootinfo(void)
+{
+	int err;
+	u32 val;
+
+	err = preboot_fuse_read(IO_EFUSE_PLDM_CFG_0_OFFSET, &val);
+	if (err)
+		val = BLOADER_COPY_BOOTINFO;
+
+	val &= BLOADER_COPY_BOOTINFO;
+
+	if (!val)
+		return;
+
+	/*
+	 * Normally bootinfo is first written to spsram by the arcboot, so preboot rtos expects some
+	 * bootinfo data to be available when it runs. On PALAD, when running standalone preboot,
+	 * pre-recorded boot info data is loaded to the SPSRAM.
+	 * Since SPSRAM content is erazed on cold reboot, fresh copy stored in MISC DCCM and copied
+	 * back to the SPSRAM as part of the preparation to run preboot rtos.
+	 */
+	fs1_mem_copy(ARC_MISC_DCCM_FULL_BASE, HL_SP_SRAM_BASE, BOOT_INFO_SIZE, false);
+}
+
+void btldr_copy_data(void)
+{
+	btldr_copy_preboot_app();
+	btldr_copy_bootinfo();
+}
+
+#define APP_RST_VECTOR_ADDR	PREBOOT_TEXT_BASE_FULL
+
+void btldr_exec_app(void)
+{
+	preboot_puts("palad-bloader resigned\n");
+	image_start(APP_RST_VECTOR_ADDR);
+}
diff --git a/arch/fs1/arc/palad_bloader.lds.S b/arch/fs1/arc/palad_bloader.lds.S
new file mode 100644
index 0000000..367d883
--- /dev/null
+++ b/arch/fs1/arc/palad_bloader.lds.S
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Copyright (C) 2024 HabanaLabs Ltd.
+ */
+
+OUTPUT_FORMAT("elf32-littlearc", "elf32-bigarc", "elf32-littlearc")
+OUTPUT_ARCH(arc)
+
+MEMORY
+{
+	ICCM	: ORIGIN = 0x00000000, LENGTH = 256K
+	SBROM	: ORIGIN = 0x78980000, LENGTH = 128K
+	DCCM	: ORIGIN = 0x80000000, LENGTH = 128K
+}
+
+REGION_ALIAS("REGION_IVT",	SBROM)
+REGION_ALIAS("REGION_TEXT",	SBROM)
+REGION_ALIAS("REGION_DATA",	DCCM)
+REGION_ALIAS("REGION_SDATA",	DCCM)
+REGION_ALIAS("REGION_BSS",	DCCM)
+REGION_ALIAS("REGION_STACK",	DCCM)
+
+ENTRY(__start)
+
+SECTIONS
+{
+	_dccm_begin = ORIGIN(DCCM);
+	_dccm_end = ORIGIN(DCCM) + LENGTH(DCCM);
+
+	.ivt : {
+		KEEP (*(.ivt));
+	} > REGION_IVT
+
+	.text : {
+		crt0_rom.o (.text*)
+		*(.text .text.* .rodata .rodata.*)
+		_etext = . ;
+	} > REGION_TEXT
+
+	.data : AT ( LOADADDR(.text) + SIZEOF(.text) ) {
+		_data_after_persist_sec = _etext;
+		_data = .;
+		_rom_non_persistent_dccm_start = .;
+		*(.data .data.*)
+	} > REGION_DATA
+
+	.sdata : AT ( LOADADDR(.data) + SIZEOF(.data) ) {
+		__SDATA_BEGIN__ = .;
+		*(.sdata .sdata.* .gnu.linkonce.s.*)
+		_edata = .;
+		PROVIDE (edata = .);
+	} > REGION_SDATA
+
+	.bss : {
+		*(.dynbss)
+		*(.bss .bss.* .gnu.linkonce.b.*)
+		*(COMMON)
+		/* Align here to ensure that the .bss section occupies space up to
+		_end. Align after .bss to ensure correct alignment even if the
+		.bss section disappears because there are no input sections. */
+		. = ALIGN(32 / 8);
+		_end = .;
+		PROVIDE (end = .);
+	} > REGION_BSS
+
+	.stack : {
+		. = ALIGN(32 / 8);
+		__stack = . ;
+		. = . + 2k;
+		__stack_top = . ;
+	} > REGION_STACK
+}
