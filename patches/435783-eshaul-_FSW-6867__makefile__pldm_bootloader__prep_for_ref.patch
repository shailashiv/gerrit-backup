-		. = ALIGN(32 / 8);
-		_end = .;
-		PROVIDE (end = .);
-	} > REGION_BSS
-
-	.stack : {
-		. = ALIGN(32 / 8);
-		__stack = . ;
-		. = . + 2k;
-		__stack_top = . ;
-	} > REGION_STACK
