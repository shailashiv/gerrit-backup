diff --git a/arch/gaudi2/common/palad.c b/arch/gaudi2/common/palad.c
new file mode 100644
index 0000000..f79e51d
--- /dev/null
+++ b/arch/gaudi2/common/palad.c
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ *
+ * (C) Copyright 2021 HabanaLabs, Ltd.
+ *
+ */
+
+#include <gaudi2_blocks_linux_driver.h>
+#include <baremetal.h>
+#include <psoc_global_conf_regs.h>
+#include <psoc_cpu_pll_ctrl_regs.h>
+#include <pll.h>
+#include <uart.h>
+
+
+#define SYS_CLOCK_FREQUENCY	155000ULL
+
+#define UART_CLOCK_FREQUENCY	11900ULL
+#define PALAD_UART_BAUDRATE	300
+
+/*
+ * This cfg specific to PALAD bumps up uart freq
+ * to 250 MHz while keeping other div's on refclk
+ */
+static struct hl_pll_cfg gaudi2_pll_cfg[] = {
+	{
+		.name = "CPU", .base = mmPSOC_CPU_PLL_CTRL_BASE,
+		.nr = 1, .nf = 60, .od = 2, .nb = 3,
+		.div_factor = { 0, 0, 4, 1 },
+		.div_sel = { HL_PLL_REF_CLK,
+			HL_PLL_REF_CLK,
+			HL_PLL_REF_CLK,
+			HL_PLL_DIV_PLL
+		},
+	}
+};
+
+u64 hl_pll_timestamp_freq_get(void)
+{
+	return SYS_CLOCK_FREQUENCY;
+}
+
+u32 hl_skip_fw_cfg(void)
+{
+	/* Use DumpSel[3] to skip FW config */
+	return hl_is_debug_mode(HL_DEBUG_HW_DRAM);
+}
+
+u32 hl_spi_baudr_get(void)
+{
+	u32 factor = 2; /* Min Divider */
+
+	/* baud rate doesn't support odd number */
+	return (factor + 1) & 0xFFFE;
+}
+
+void hl_uart_init(void)
+{
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_8);	/* UART0 RXD */
+	regmap_writel(1, mmPSOC_GLOBAL_CONF_PAD_SEL_9);	/* UART0 TXD */
+	preboot_uart_init(UART_CLOCK_FREQUENCY / PALAD_UART_BAUDRATE);
+}
+
+void hl_dev_pll_init(void)
+{
+	/* Bump up UART frequency */
+	hl_pll_init(gaudi2_pll_cfg, 1);
+}
+
+void preboot_init_pcie_phy(void) {}
+
+void preboot_update_bar_sizes(void) {}
+
+void sha_csum(const unsigned char *input, unsigned int ilen,
+		unsigned char *output)
+{
+}
