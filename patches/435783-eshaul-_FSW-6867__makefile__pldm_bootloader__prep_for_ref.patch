diff --git a/arch/gaudi3/arc/palad.c b/arch/gaudi3/arc/palad.c
new file mode 100644
index 0000000..1d7da13
--- /dev/null
+++ b/arch/gaudi3/arc/palad.c
@@ -0,0 +1,218 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * (C) Copyright 2022 HabanaLabs, Ltd.
+ */
+#include <gaudi3_blocks_linux_driver.h>
+#include <gaudi3_reg_map.h>
+#include <global_conf_regs.h>
+#include <global_conf_masks.h>
+#include <arc_regs.h>
+#include <stddef.h>
+#include <bitops.h>
+#include <baremetal.h>
+#include <uart.h>
+#include <pll.h>
+#include <arcboot_export_dev.h>
+#include <boot_desc.h>
+#include <efuse.h>
+#include "hl.h"
+#include <fit.h>
+
+#define UART_CLOCK_FREQUENCY	250000000ULL /* PCI PLL DIV3 SIMULATION CLK */
+
+#define PALAD_UART_BAUDRATE	300
+
+/*
+ * This cfg specific to PALAD bumps up uart freq
+ * to 250 MHz while keeping other div's on refclk
+ */
+static struct hl_pll_cfg gaudi3_cpu_pll_cfg[] = {
+	{
+		.name = "CPU", .base = mmD0_G4_PCI_PLL_CTRL_BASE,
+		.nr = 1, .nf = 240, .od = 2, .nb = 3,
+		.div_factor = { 0, 1, 9, 3 },
+		.div_sel = { HL_PLL_PLL_CLK,
+			HL_PLL_DIV_PLL,
+			HL_PLL_DIV_PLL,
+			HL_PLL_DIV_PLL
+		},
+	}
+};
+
+static struct hl_pll_cfg gaudi3_nw_pll_cfg[] = {
+	{
+		.name = "G4NCH", .base = mmD0_G4_NCH_PLL_CTRL_BASE,
+		.nr = 1, .nf = 224, .od = 6, .nb = 0,
+		.div_factor = {0, 1, 1, 7},
+		.div_sel = {HL_PLL_PLL_CLK,
+			HL_PLL_DIV_PLL,
+			HL_PLL_DIV_PLL,
+			HL_PLL_DIV_PLL
+		},
+	},
+	{
+		.name = "G0MSH", .base = mmD0_G0_MSH_PLL_CTRL_BASE,
+		.nr = 1, .nf = 224, .od = 6, .nb = 0,
+		.div_factor = {0, 1, 1, 7},
+		.div_sel = {HL_PLL_PLL_CLK,
+			HL_PLL_DIV_PLL,
+			HL_PLL_DIV_PLL,
+			HL_PLL_DIV_PLL
+		},
+	},
+	{
+		.name = "G6MSH", .base = mmD0_G6_MSH_PLL_CTRL_BASE,
+		.nr = 1, .nf = 224, .od = 6, .nb = 0,
+		.div_factor = {0, 1, 1, 7},
+		.div_sel = {HL_PLL_PLL_CLK,
+			HL_PLL_DIV_PLL,
+			HL_PLL_DIV_PLL,
+			HL_PLL_DIV_PLL
+		},
+	},
+};
+
+void hl_uart_init(void)
+{
+	regmap_writel(1, D0_PSOC_GLOBAL_CONF_REG(mmGLOBAL_CONF_PAD_SEL_48)); /* UART0 RXD */
+	regmap_writel(1, D0_PSOC_GLOBAL_CONF_REG(mmGLOBAL_CONF_PAD_SEL_49)); /* UART0 TXD */
+	preboot_uart_init(UART_CLOCK_FREQUENCY / PALAD_UART_BAUDRATE);
+}
+
+#define SP_SRAM_INIT_TIMEOUT_US		(5 * USEC_PER_SEC)
+
+/*
+ * Initialize scratch SRAM to avoid ECC exceptions.
+ * Normally bootrom takes care of that, but in palad when running without
+ * bootrom, let preboot initialize the spsram memory
+ */
+void preboot_sp_sram_init(void)
+{
+	unsigned int rst_src = hl_rst_src_get();
+	u32 init_sts;
+	u64 start;
+
+	if (rst_src != HL_COLD_RST)
+		return;
+
+	regmap_writel(GLOBAL_CONF_SCRATCHPAD_INIT_CTRL_START_M,
+		      D0_PSOC_GLOBAL_CONF_REG(mmGLOBAL_CONF_SCRATCHPAD_INIT_CTRL));
+	start = timestamp_get_us();
+
+	while (1) {
+		init_sts =
+			regmap_readl(D0_PSOC_GLOBAL_CONF_REG(mmGLOBAL_CONF_SCRATCHPAD_INIT_CTRL));
+		if (init_sts & GLOBAL_CONF_SCRATCHPAD_INIT_CTRL_DONE_M)
+			break;
+
+		/*
+		 * If init does not happen in 5 seconds
+		 * timeout and return
+		 */
+		if (timeout_expired(start, SP_SRAM_INIT_TIMEOUT_US)) {
+			preboot_puts("Timed-out waiting for sp sram init\n");
+			break;
+		}
+	}
+}
+
+void hl_dev_cpu_pll_init(void)
+{
+	hl_pll_init(gaudi3_cpu_pll_cfg, 1);
+}
+
+void hl_dev_nw_pll_init(void)
+{
+	hl_pll_init(gaudi3_nw_pll_cfg, ARRAY_SIZE(gaudi3_nw_pll_cfg));
+}
+
+void ppboot_security_init(void)
+{
+	hl_dev_security_init();
+}
+
+bool hl_dev_is_valid_img_desc(struct boot_desc *desc)
+{
+	return true;
+}
+
+#define PCI_AUX_DIV_ID	2
+#define UART_DIV_ID	3
+
+/*
+ * pcie pll is initialized by the boot fsm to nominal values (in secured boot mode). In order to
+ * support uart prints on palad only div3 of the pci pll should be modified. Since div3 also impacts
+ * the baudrate of the d2d spi dma, pci pll of both dies should be carefully reconfigured first,
+ * before using the spi gw for data transfer.
+ * since pci pll div2 is not initialized by boot fsm, it is being set here as well.
+ */
+void btldr_pll_fixup(uint32_t die_id)
+{
+	gaudi3_cpu_pll_cfg[0].base = die_id ? mmD1_G4_PCI_PLL_CTRL_BASE : mmD0_G4_PCI_PLL_CTRL_BASE;
+
+	hl_pll_reconfig_div(gaudi3_cpu_pll_cfg, PCI_AUX_DIV_ID);
+	hl_pll_reconfig_div(gaudi3_cpu_pll_cfg, UART_DIV_ID);
+}
+
+void btldr_parc_prepare(void)
+{
+	/* ARC must not be in reset state when accessing the CCM modules */
+	regmap_writel(0, D0_PARC_ARC0_CFG_REG(mmARC_ARC_RST));
+	regmap_writel(0, mmD0_PARC_ARC2_CFG_BASE + mmARC_ARC_RST);
+}
+
+#define EFUSE_APP_SIZE_OFFSET	55
+#define EFUSE_APP_SIZE_MASK	0x1
+
+static void btldr_copy_preboot_app(void)
+{
+	int err;
+	u32 val;
+
+	/*
+	 * Clean copy of the application is stored in ICCM0. In case the application binary
+	 * exceeds ICCM0 size, the rest is stored in ICCM2.
+	 * An efuse bit is controlling whether the application binary is larger than ICCM0 size.
+	 */
+	gaudi3_hbw_memcpy(ARC0_ICCM_FULL_BASE, ARC1_ICCM_FULL_BASE, ARC0_ICCM_SIZE,
+		GAUDI3_HBW_MEM_CPY);
+
+	err = preboot_fuse_read(EFUSE_APP_SIZE_OFFSET, &val);
+	if (err)
+		val = EFUSE_APP_SIZE_MASK;
+
+	val &= EFUSE_APP_SIZE_MASK;
+
+	if (!val)
+		return;
+
+	gaudi3_hbw_memcpy(ARC2_ICCM_FULL_BASE, ARC1_ICCM_FULL_BASE + ARC0_ICCM_SIZE,
+			  ARC1_ICCM_SIZE - ARC0_ICCM_SIZE, GAUDI3_HBW_MEM_CPY);
+}
+
+static void btldr_copy_bootinfo(void)
+{
+	/*
+	 * Normally bootinfo is first written to spsram by the arcboot, so preboot rtos expects some
+	 * bootinfo data to be available when it runs. On PALAD, when running standalone preboot,
+	 * pre-recorded boot info data is loaded to the SPSRAM.
+	 * Since SPSRAM content is erazed on cold reboot, fresh copy stored in DCCM0 and copied
+	 * back to the SPSRAM as part of the preparation to run preboot rtos.
+	 */
+	gaudi3_hbw_memcpy(ARC0_DCCM_FULL_BASE, HL_SP_SRAM_BASE, ARC0_DCCM_SIZE,
+		GAUDI3_HBW_MEM_CPY);
+}
+
+void btldr_copy_data(void)
+{
+	btldr_copy_preboot_app();
+	btldr_copy_bootinfo();
+}
+
+#define APP_RST_VECTOR_ADDR	0 /* first address of the local ICCM */
+
+void btldr_exec_app(void)
+{
+	preboot_puts("palad-bloader resigned\n");
+	preboot_start_image(APP_RST_VECTOR_ADDR, true, FIT_CORE_ID_D0_PSOC_ARC1);
+}
diff --git a/arch/gaudi3/arc/palad_bloader.lds.S b/arch/gaudi3/arc/palad_bloader.lds.S
new file mode 100644
index 0000000..4bfef04
--- /dev/null
+++ b/arch/gaudi3/arc/palad_bloader.lds.S
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Copyright (C) 2023 HabanaLabs Ltd.
+ */
+
+OUTPUT_FORMAT("elf32-littlearc", "elf32-bigarc", "elf32-littlearc")
+OUTPUT_ARCH(arc)
+
+MEMORY
+{
+	ICCM	: ORIGIN = 0x00000000, LENGTH = 256K
+	SBROM	: ORIGIN = 0x23100000, LENGTH = 128K
+	DCCM	: ORIGIN = 0x80000000, LENGTH = 64K
+}
+
+REGION_ALIAS("REGION_IVT",	SBROM)
+REGION_ALIAS("REGION_TEXT",	SBROM)
+REGION_ALIAS("REGION_DATA",	DCCM)
+REGION_ALIAS("REGION_SDATA",	DCCM)
+REGION_ALIAS("REGION_BSS",	DCCM)
+REGION_ALIAS("REGION_STACK",	DCCM)
+
+ENTRY(__start)
+
+SECTIONS
+{
+	_dccm_begin = ORIGIN(DCCM);
+	_dccm_end = ORIGIN(DCCM) + LENGTH(DCCM);
+
+	.ivt : {
+		KEEP (*(.ivt));
+	} > REGION_IVT
+
+	.text : {
+		crt0_rom.o (.text*)
+		*(.text .text.* .rodata .rodata.*)
+		_etext = . ;
+	} > REGION_TEXT
+
+	.data : AT ( LOADADDR(.text) + SIZEOF(.text) ) {
+		_data_after_persist_sec = _etext;
+		_data = .;
+		_rom_non_persistent_dccm_start = .;
+		*(.data .data.*)
+	} > REGION_DATA
+
+	.sdata : AT ( LOADADDR(.data) + SIZEOF(.data) ) {
+		__SDATA_BEGIN__ = .;
+		*(.sdata .sdata.* .gnu.linkonce.s.*)
+		_edata = .;
+		PROVIDE (edata = .);
+	} > REGION_SDATA
+
+	.bss : {
+		*(.dynbss)
+		*(.bss .bss.* .gnu.linkonce.b.*)
+		*(COMMON)
+		/* Align here to ensure that the .bss section occupies space up to
+		_end. Align after .bss to ensure correct alignment even if the
+		.bss section disappears because there are no input sections. */
+		. = ALIGN(32 / 8);
+		_end = .;
+		PROVIDE (end = .);
+	} > REGION_BSS
+
+	.stack : {
+		. = ALIGN(32 / 8);
+		__stack = . ;
+		. = . + 2k;
+		__stack_top = . ;
+	} > REGION_STACK
+}
