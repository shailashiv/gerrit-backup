From d18b0ddc12c0de7fc896257d91fe642fab36e9fb Mon Sep 17 00:00:00 2001
From: Erez Shaul <eshaul@habana.ai>
Date: Thu, 18 Jul 2024 17:00:14 +0300
Subject: [PATCH] [FSW-6867] makefile, pldm_bootloader: prep for refactoring pldm target

this is a preparation for target refactor from pldm to palad
this change will enable to use both pldm and palad target words
once jenkins scripts will be adjusted to palad the override can be reverted

Change-Id: If6eb18f95175bf738dc58466abc574de832c8bb3
Signed-off-by: Erez Shaul <eshaul@habana.ai>
---

diff --git a/Makefile b/Makefile
index 809bfce..e455196 100644
--- a/Makefile
+++ b/Makefile
@@ -12,6 +12,11 @@
 
 EMB_COMMON_MOD_DIR := ${PREBOOT_ROOT_DIR}/emb_common_mod
 
+# TODO: remove this after switching to palad target
+ifeq ($(HL_TARGET), pldm)
+    HL_TARGET = palad
+endif
+
 CFLAGS += -I$(SPECS_DIR)
 CFLAGS += -I$(SPECS_DIR)/$(BASE_DEV_NAME)/asic_reg
 CFLAGS += -I ${EMBEDDED_ROOT}/arcboot/arch
@@ -23,8 +28,8 @@
 CFLAGS += -I $(EMB_COMMON_MOD_DIR)/lib/common
 CFLAGS += -I $(EMB_COMMON_MOD_DIR)/lib/preboot
 
-ifeq ($(HL_TARGET),pldm)
-	CFLAGS += -DTARGET_IS_PLDM
+ifeq ($(HL_TARGET),palad)
+	CFLAGS += -DTARGET_IS_PALAD
 endif
 ifeq ($(HL_TARGET),onix)
 	CFLAGS += -DTARGET_IS_ONIX
