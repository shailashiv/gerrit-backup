diff --git a/app/palad_bloader/Makefile b/app/palad_bloader/Makefile
new file mode 100644
index 0000000..b3798f6
--- /dev/null
+++ b/app/palad_bloader/Makefile
@@ -0,0 +1,75 @@
+CC = $(CROSS_COMPILE)gcc
+OBJCOPY = $(CROSS_COMPILE)objcopy
+BASE_DEV_NAME := $(shell echo $(HL_DEV) | cut -d'_' -f1)
+HL_DEV_SUBTYPE := $(shell echo $(HL_DEV) | cut -d'_' -s -f2,3)
+PREBOOT_ROOT_DIR := ../..
+HL_DEV_ARCH := $(PREBOOT_ROOT_DIR)/arch/$(BASE_DEV_NAME)/$(HL_DEV_SUBTYPE)
+HL_DEV_ARCH_COMMON := $(PREBOOT_ROOT_DIR)/arch/$(BASE_DEV_NAME)/common
+
+EMB_COMMON_MOD_DIR := ${PREBOOT_ROOT_DIR}/emb_common_mod
+
+include $(HL_DEV_ARCH)/Makefile
+
+# TODO: remove this after switching to palad target
+ifeq ($(HL_TARGET), pldm)
+    HL_TARGET = palad
+endif
+
+CFLAGS += -I$(SPECS_DIR)
+CFLAGS += -I$(SPECS_DIR)/$(BASE_DEV_NAME)/asic_reg
+CFLAGS += -Wall -Werror
+CFLAGS += -g -c
+CFLAGS += -I $(PREBOOT_ROOT_DIR)/include/ -I $(PREBOOT_ROOT_DIR)/ -I $(PREBOOT_ROOT_DIR)/lib/ -I $(PREBOOT_ROOT_DIR)/lib/common/ -I $(HL_DEV_ARCH)/
+CFLAGS += -I $(EMB_COMMON_MOD_DIR)/include
+CFLAGS += -I $(EMB_COMMON_MOD_DIR)/lib
+CFLAGS += -I $(EMB_COMMON_MOD_DIR)/lib/common
+CFLAGS += -I $(EMB_COMMON_MOD_DIR)/lib/preboot
+
+CFLAGS += -Os -fdata-sections -ffunction-sections
+
+SFLAGS := $(CFLAGS) -D__ASSEMBLY__
+
+PALAD_BLOADER_LD_SCRIPT := $(shell ls $(HL_DEV_ARCH)/palad_bloader.lds.S)
+LDFLAGS := -g -nostdlib -static
+LDFLAGS += -Wl,--gc-sections
+LDLIBS := -lgcc
+
+PALAD_BLOADER_SRCS_C := $(shell ls *.c)
+PALAD_BLOADER_SRCS_C += $(shell ls $(PREBOOT_ROOT_DIR)/lib/common/*.c)
+PALAD_BLOADER_SRCS_C := $(filter-out $(PREBOOT_ROOT_DIR)/lib/common/pif_ts.c,$(PALAD_BLOADER_SRCS_C))
+PALAD_BLOADER_SRCS_C += $(shell ls $(HL_DEV_ARCH_COMMON)/common.c)
+PALAD_BLOADER_SRCS_C += $(shell ls $(HL_DEV_ARCH)/common.c)
+PALAD_BLOADER_SRCS_C += $(shell ls $(HL_DEV_ARCH)/$(HL_TARGET).c)
+PALAD_BLOADER_SRCS_C += $(shell ls $(EMB_COMMON_MOD_DIR)/lib/common/lib_common.c)
+PALAD_BLOADER_SRCS_C += $(shell ls $(EMB_COMMON_MOD_DIR)/lib/common/pci.c)
+PALAD_BLOADER_APP_S := $(shell ls crt0_rom.S)
+
+include $(HL_DEV_ARCH)/Makefile
+
+PALAD_BLOADER_OBJECTS := $(PALAD_BLOADER_SRCS_C:.c=.o)
+PALAD_BLOADER_OBJECTS += $(PALAD_BLOADER_APP_S:.S=.o)
+
+# TODO: add version info
+
+all: clean
+	$(MAKE) palad_bloader.bin
+
+palad_bloader.bin: palad_bloader.elf
+	$(OBJCOPY) -O binary $< $@
+
+palad_bloader.elf: $(PALAD_BLOADER_OBJECTS) $(PALAD_BLOADER_LD_SCRIPT)
+	@$(CC) $(LDFLAGS) -T $(PALAD_BLOADER_LD_SCRIPT) -o $@ -Wl,--start-group $(PALAD_BLOADER_OBJECTS) $(LDLIBS) -Wl,--end-group
+
+%.lds: %.lds.S
+	@$(CC) $(SFLAGS) -E -P -nostdinc -o $@ $<
+
+%.o: %.c
+	@$(CC) $(CFLAGS) -o $@ $<
+
+%.o: %.S
+	@$(CC) $(SFLAGS) -o $@ $<
+
+clean:
+	rm -f $(PALAD_BLOADER_OBJECTS)
+
+.PHONY: clean
diff --git a/app/palad_bloader/crt0_rom.S b/app/palad_bloader/crt0_rom.S
new file mode 100644
index 0000000..8a5b537
--- /dev/null
+++ b/app/palad_bloader/crt0_rom.S
@@ -0,0 +1,139 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright 2022 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+;; ************************************************************************************************
+;; -----------------
+;; ARC start up file
+;; -----------------
+;; The startup code for the ARC family of processors does the following
+;; before transferring control to user defined main label :
+;;	1. Set sp to __stack_top (link time variable)
+;;	2. Set fp to zero
+;;	3. Zero out the bss section (for uninitialized globals)
+;; After returning from main, the processor is halted and the pipeline is flushed out
+;;
+;; ************************************************************************************************
+.file "crt0_rom.S"
+
+.macro CPU_EARLY_SETUP
+	; enable I-cache/D-cache
+	lr	r5, [ic_ctrl]
+	bclr	r5, r5, 0	; 0 - Enable, 1 is Disable
+	sr	r5, [ic_ctrl]
+
+	lr	r5, [dc_ctrl]
+	bclr	r5, r5, 6	; Invalidate (discard w/o wback)
+	bclr	r5, r5, 0	; Enable (+Inv)
+	sr	r5, [dc_ctrl]
+
+	; Disable alignment checking
+	lr	r5, [status32]
+	bset	r5, r5, 19
+	kflag	r5
+.endm
+
+.extern main
+
+.section .ivt, "a", @progbits
+
+; Helper macro to define weak symbols to include into interrupt vector table.
+; User code may define those functions in them, so user function will be
+; referenced in the IVT. By default all handlers point to _exit_halt - so they
+; always cause application halt, because if application causes an exception or
+; interrupt, but doesn't set a handler for it - something is wrong in
+; application. Exception is "start" entry of IVT, which points to __start
+; function.
+#define IVT_ENTRY(name) \
+    .word name `\
+    .weak name `\
+    .set name, _exit_halt
+
+; handler's name,		number,	name,			offset in IVT (hex/dec)
+.word __start			; 0	program entry point	0x0		0
+IVT_ENTRY(memory_error)		; 1	memory_error		0x4		4
+IVT_ENTRY(instruction_error)	; 2	instruction_error	0x8		8
+IVT_ENTRY(EV_MachineCheck)	; 3	EV_MachineCheck		0xC		12
+IVT_ENTRY(EV_TLBMissI)		; 4	EV_TLBMissI		0x10		16
+IVT_ENTRY(EV_TLBMissD)		; 5	EV_TLBMissD		0x14		20
+IVT_ENTRY(EV_ProtV)		; 6	EV_ProtV		0x18		24
+IVT_ENTRY(EV_PrivilegeV)	; 7	EV_PrivilegeV		0x1C		28
+IVT_ENTRY(EV_SWI)		; 8	EV_SWI			0x20		32
+IVT_ENTRY(EV_Trap)		; 9	EV_Trap			0x24		36
+IVT_ENTRY(EV_Extension)		; 10	EV_Extension		0x28		40
+IVT_ENTRY(EV_DivZero)		; 11	EV_DivZero		0x2C		44
+IVT_ENTRY(EV_DCError)		; 12	EV_DCError		0x30		48
+IVT_ENTRY(EV_Maligned)		; 13	EV_Maligned		0x34		52
+IVT_ENTRY(EV_Ex14)		; 14	unused			0x38		56
+IVT_ENTRY(EV_Ex15)		; 15	unused			0x3C		60
+IVT_ENTRY(IRQ_Timer0)		; 16	Timer 0			0x40		64
+IVT_ENTRY(IRQ_Timer1)		; 17	Timer 1			0x44		68
+IVT_ENTRY(IRQ_18)		; 18				0x48		72
+IVT_ENTRY(IRQ_19)		; 19				0x4C		76
+IVT_ENTRY(IRQ_20)		; 20				0x50		80
+
+.section .text.__startup, "ax", @progbits
+
+.global __start
+.type __start, @function
+.align 4
+
+; Startup code for the ARC600, ARC700 and ARCv2 processors
+; NOTE:  The following restrictions apply on zero overhead loops (other
+; restrictions are not pertinent to this code)
+; - loop end should be 4 instruction words away from the lp_count setting
+;   instruction
+; - loop body should have at least two instruction words
+__start:
+	CPU_EARLY_SETUP
+	mov gp, @__SDATA_BEGIN__
+
+	mov sp, @__stack_top	; initialize stack pointer
+
+	mov r2, @_rom_non_persistent_dccm_start; r2 = start of the non persistent dccm section
+	sub r3, @_dccm_end, r2	; r3 = size of the dccm section in bytes
+	; set up the loop counter register to the size (in words) of the dccm section
+	asr_s r13, r3
+	asr.f lp_count, r13
+
+	mov r4, 0x0
+	; loop to zero out the dccm.  Enter loop only if lp_count != 0
+	lpnz @.Lend_dccm
+	st.ab r4, [r2, 4]	; zero out the word
+	nop
+.Lend_dccm:
+
+	mov_s r1, @_data_after_persist_sec	; r1 = non persistent section begin in ROM(LMA).
+	mov_s r2, @_rom_non_persistent_dccm_start; r2 = non persistent section begin in DCCM(VMA).
+
+	sub r3, @_edata, r2	; r3 = size of the non persistent data section in bytes
+
+	; set up the loop counter register to the size (in words) of the data section
+	asr_s r13, r3
+	asr.f lp_count, r13
+
+	; loop to copy data from ROM to DCCM.  Enter loop only if lp_count != 0
+	lpnz @.Lend_cdata
+	ld.ab	r5,[r1,4]
+	st.ab	r5,[r2,4]
+.Lend_cdata:
+
+	;; branch to main
+	bl.d @palad_bloader_main
+	mov fp, 0		; initialize frame pointer
+				; r0 contains exit code
+	j @_exit_halt
+
+.global _exit_halt
+.type _exit_halt, @function
+.align 4
+_exit_halt:
+				; r0 contains exit code
+	flag 0x01
+	nop
+	nop
+	nop
+	j @_exit_halt
+	nop
diff --git a/app/palad_bloader/palad_bloader.c b/app/palad_bloader/palad_bloader.c
new file mode 100644
index 0000000..6bd29e1
--- /dev/null
+++ b/app/palad_bloader/palad_bloader.c
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2023 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <stddef.h>
+#include <baremetal.h>
+#include <hl.h>
+#include <device.h>
+#include <uart.h>
+#include <pll.h>
+
+#include "palad_bloader.h"
+
+int hl_fuse_init(u32 efuse_base) { return 0; }
+
+static void device_init(void)
+{
+	device_init_global_conf();
+	device_init_efuse();
+	device_init_uart();
+}
+
+__weak uint32_t hl_get_die_id(void) { return 0; }
+
+void palad_bloader_main(void)
+{
+	uint32_t die_id = hl_get_die_id();
+
+	device_init_pll(); /* used for uart and delay */
+	udelay_init();
+
+	btldr_pll_fixup(die_id);
+	if (die_id)
+		wfe();
+
+	device_init();
+	hl_uart_init();
+
+	preboot_puts("starting palad-bloader\n");
+	btldr_parc_prepare();
+	btldr_copy_data();
+	btldr_exec_app();
+}
