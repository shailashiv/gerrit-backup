From db282a75664abc543cfebbcd55ff400785b9837b Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Fri, 31 Jan 2020 07:59:22 +0200
Subject: [PATCH] [SW-0] hl: pcie_phy: turn firmware per device

Seem like that FW is not common anymore (H5)

Change-Id: I2fa220d7a5a816e8997c8ab6c21aa3ea71015296
---

diff --git a/Makefile b/Makefile
index 9e878c3..13235a1 100644
--- a/Makefile
+++ b/Makefile
@@ -41,7 +41,7 @@
 PPBOOT_OBJECTS += $(PPBOOT_APP_C:.c=.o)
 AUTO_GENERATED_FILE := auto_generated.h
 
-all: ppboot.bin preboot.bin common/pcie_phy_fw.bin
+all: ppboot.bin preboot.bin pcie_phy_fw.bin
 
 %.bin: %
 	$(OBJCOPY) -O binary -R .note.gnu.build-id $< $@
@@ -57,10 +57,10 @@
 	@LANG=en_us date +'#define PREBOOT_DATE "%b %d %Y"' >> $@
 	@date +'#define PREBOOT_TIME "%T"' >> $@
 
-common/pcie_phy_fw.bin: common/pcie_phy_fw.i
+pcie_phy_fw.bin: $(HL_DEV)/pcie_phy_fw.i
 	@cut -d' ' -f2- $< | xxd -r -p | dd status=none bs=16 count=$$(($(FW_SIZE) / 16)) conv=sync,swab of=$@
 
-common/pcie_phy_fw.i: common/pcie_phy_fw.hex
+$(HL_DEV)/pcie_phy_fw.i: $(HL_DEV)/pcie_phy_fw.hex
 	@$(CC) -x c -E -P -nostdinc -o $@ $<
 
 %.lds: %.lds.S
