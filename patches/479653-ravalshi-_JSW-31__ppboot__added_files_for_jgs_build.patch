diff --git a/arch/jgs/arc/pll.c b/arch/jgs/arc/pll.c
new file mode 100644
index 0000000..d49de43
--- /dev/null
+++ b/arch/jgs/arc/pll.c
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2024 HabanaLabs Ltd.
+ */
+
+#include <pll_control_regs.h>
+#include <pll_control_masks.h>
+#include <jgs_blocks_linux_driver.h>
+
+#include <stddef.h>
+#include <bitops.h>
+#include <baremetal.h>
+#include <pll.h>
+#include "common.h"
+
+#define FS1_PLL_CFG_EN	(PLL_CONTROL_CFG_FOUTPOSTDIVEN_M | PLL_CONTROL_CFG_EN_M)
+
+void hl_pll_reset(struct hl_pll_cfg *cfg, bool reset)
+{
+	u32 reg = regmap_readl(cfg->base + mmPLL_CONTROL_CFG);
+
+	if (reset)
+		reg &= ~FS1_PLL_CFG_EN;
+	else
+		reg |= FS1_PLL_CFG_EN;
+
+	regmap_writel(reg, cfg->base + mmPLL_CONTROL_CFG);
+}
+
+int hl_pll_is_locked(struct hl_pll_cfg *cfg)
+{
+	return regmap_readl(cfg->base + mmPLL_CONTROL_CFG) & PLL_CONTROL_CFG_LOCK_M;
+}
+
+#define FS1_PLL_MAX_WAIT_TIME	5
+
+void hl_pll_cfg(struct hl_pll_cfg *cfg)
+{
+	u32 reg = 0;
+
+	/* put the PLL into reset by writing 0 to CTRL_CFG.EN and CTRL_CFG.FOUTPOSTDIVEN */
+	hl_pll_reset(cfg, true);
+
+	/* FBDIV - bit 0
+	 * POSTDIV1 - bit 16
+	 * POSTDIV2 - bit 20
+	 * REFDIV - bit 24
+	 */
+	reg = cfg->nr << PLL_CONTROL_CFG_DIV_REFDIV_S | cfg->nb << PLL_CONTROL_CFG_DIV_POSTDIV2_S |
+	      cfg->od << PLL_CONTROL_CFG_DIV_POSTDIV1_S | cfg->nf;
+
+	regmap_writel(reg, cfg->base + mmPLL_CONTROL_CFG_DIV);
+	regmap_writel(PLL_CONTROL_VCO_CTRL_VCOSEL_M, cfg->base + mmPLL_CONTROL_VCO_CTRL);
+
+	/* after updating the coefficients we need to wait >=1us */
+	udelay(FS1_PLL_MAX_WAIT_TIME);
+
+	/* enable the PLL by writing a value of 1 to CTRL_CFG.EN and CTRL_CFG.FOUTPOSTDIVEN */
+	hl_pll_reset(cfg, false);
+}
+
+void hl_pll_clk_relax_reset(struct hl_pll_cfg *cfg) {}
+
+void hl_pll_clear_lock_status(struct hl_pll_cfg *cfg) {}
+
+void hl_pll_ack_int(struct hl_pll_cfg *cfg) {}
+
+void hl_pll_set_div_sel_delay(struct hl_pll_cfg *cfg)
+{
+	regmap_writel(1, cfg->base + mmPLL_CONTROL_DIV_SEL_DELAY);
+}
+
+void hl_pll_vco_en(struct hl_pll_cfg *cfg)
+{
+	u32 val;
+
+	val = regmap_readl(cfg->base + mmPLL_CONTROL_VCO_CTRL);
+	val |= PLL_CONTROL_VCO_CTRL_FOUTVCOEN_M;
+	regmap_writel(val, cfg->base + mmPLL_CONTROL_VCO_CTRL);
+}
+
+u32 hl_get_pll_div_fix(void) { return 1; }
diff --git a/arch/jgs/arc/ppboot.lds.S b/arch/jgs/arc/ppboot.lds.S
new file mode 100644
index 0000000..94feb98
--- /dev/null
+++ b/arch/jgs/arc/ppboot.lds.S
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright 2023 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#include "common.h"
+
+#ifdef __arc__
+OUTPUT_FORMAT("elf32-littlearc", "elf32-bigarc", "elf32-littlearc")
+OUTPUT_ARCH(arc)
+
+MEMORY
+{
+	.sram 	: ORIGIN = PPBOOT_TEXT_BASE, LENGTH = PPBOOT_SIZE
+	DCCM	: ORIGIN = PPBOOT_DCCM_BASE, LENGTH = 10K
+}
+
+REGION_ALIAS("REGION_DATA",	DCCM)
+REGION_ALIAS("REGION_SDATA",	DCCM)
+REGION_ALIAS("REGION_BSS",	DCCM)
+REGION_ALIAS("REGION_STACK",	DCCM)
+
+#endif
+
+ENTRY(_start)
+SECTIONS
+{
+	.text : {
+		. = ALIGN(8);
+		app/ppboot/crt0_ppboot.o (.text*)
+		*(.text .text.*)
+		_etext = . ;
+	} >.sram
+
+	.rodata : AT ( LOADADDR(.text) + SIZEOF(.text) ) {
+		_rodata = . ;
+		*(.rodata .rodata.*)
+		_erodata = . ;
+        } >.sram
+
+	.data : AT ( LOADADDR(.rodata) + SIZEOF(.rodata) ) {
+		. = ALIGN(8);
+		_data = . ;
+		*(.data .data.*)
+		_edata = . ;
+        } > REGION_DATA
+
+	.sdata : AT ( LOADADDR(.data) + SIZEOF(.data) ) {
+		. = ALIGN(8);
+		_sdata = . ;
+		*(.sdata .sdata.* .gnu.linkonce.s.*)
+		_esdata = . ;
+        } > REGION_SDATA
+
+	__SDATA_LOAD = LOADADDR(.data) + SIZEOF(.data);
+
+	.bss : {
+		. = ALIGN(8);
+		__bss_start = . ;
+		*(.bss*)
+		__bss_end = . ;
+	} > REGION_BSS
+
+	.stack : {
+		. = ALIGN(8);
+		__stack = . ;
+		. = . + 4096 ;
+		__stack_top = . ;
+	} > REGION_STACK
+
+	.stack2 : {
+		. = ALIGN(8);
+		__stack2 = . ;
+		. = . + 512 ;
+		__stack2_top = . ;
+	} > REGION_STACK
+
+	.note.gnu.build-id : { *(.note.gnu.build-id) } > .sram
+}
