+#define COMP_PREBOOT_MAX_SZ SZ_128K
+
+#if defined(DIE_TYPE_IO)
+static void btldr_copy_preboot_app(void)
+{
+	int err;
+	u32 val;
+
+	/*
+	 * Clean copy of the application is stored in MISC ICCM for IO-DIE
+	 * (or in MNG ICCM for COMP-DIE). In case the application binary
+	 * exceeds MISC ICCM size (256kb), the rest is stored in MISC DCCM for IO-DIE
+	 * (or in RST ICCM for COMP-DIE).
+	 * An efuse bit is controlling whether the application binary is larger than available.
+	 */
+	hw_mem_copy(IO0_MISC_ICCM_FULL_BASE, PREBOOT_TEXT_BASE_FULL, IO_MISC_ICCM_SIZE, false, false);
+
+	err = preboot_fuse_read(IO_EFUSE_PALAD_CFG_0_OFFSET, &val);
+	if (err)
+		val = BLOADER_COPY_LARGE_APP;
+
+	val &= BLOADER_COPY_LARGE_APP;
+
+	if (!val)
+		return;
+
+	hw_mem_copy(IO0_MISC_DCCM_FULL_BASE, PREBOOT_TEXT_BASE_FULL + IO_MISC_ICCM_SIZE,
+			IO_MISC_DCCM_SIZE, false, false);
+}
+#else
+static void btldr_copy_preboot_app(void)
+{
+	int err;
+	u32 val;
+
+	/*
+	 * Clean copy of the application is stored in MISC ICCM for IO-DIE
+	 * (or in MNG ICCM for COMP-DIE). In case the application binary
+	 * exceeds MISC ICCM size (256kb), the rest is stored in MISC DCCM for IO-DIE
+	 * (or in RST ICCM for COMP-DIE).
+	 * An efuse bit is controlling whether the application binary is larger than available.
+	 */
+	hw_mem_copy(COMP0_MNG_ICCM_FULL_BASE, PREBOOT_TEXT_BASE_FULL, COMP_PREBOOT_MAX_SZ, false, false);
+
+	err = preboot_fuse_read(IO_EFUSE_PALAD_CFG_0_OFFSET, &val);
+	if (err)
+		val = BLOADER_COPY_LARGE_APP;
+
+	val &= BLOADER_COPY_LARGE_APP;
+
+	if (!val)
+		return;
+
+	hw_mem_copy(COMP0_RST_ICCM_BASE, PREBOOT_TEXT_BASE_FULL + COMP_PREBOOT_MAX_SZ,
+		COMP_RST_ICCM_SIZE, false, false);
+}
+#endif
+
+#if defined(DIE_TYPE_IO)
+static void btldr_copy_bootinfo(void)
+{
+	int err;
+	u32 val;
+
+	err = preboot_fuse_read(IO_EFUSE_PALAD_CFG_0_OFFSET, &val);
+	if (err)
+		val = BLOADER_COPY_BOOTINFO;
+
+	val &= BLOADER_COPY_BOOTINFO;
+
+	if (!val)
+		return;
+
+	/*
+	 * Normally bootinfo is first written to spsram by the arcboot, so preboot rtos expects some
+	 * bootinfo data to be available when it runs. On PALAD, when running standalone preboot,
+	 * pre-recorded boot info data is loaded to the SPSRAM.
+	 * Since SPSRAM content is erazed on cold reboot, fresh copy stored in MISC DCCM and copied
+	 * back to the SPSRAM as part of the preparation to run preboot rtos.
+	 */
+	hw_mem_copy(IO0_MISC_DCCM_FULL_BASE, IO0_SP_SRAM_FULL_BASE, BOOT_INFO_SIZE, false, false);
+}
+
+void btldr_copy_data(void)
+{
+	btldr_copy_preboot_app();
+	btldr_copy_bootinfo();
+}
+#else
+void btldr_copy_data(void)
+{
+	btldr_copy_preboot_app();
+	/* TODO standalobe does not support bootinfo for now */
+}
+#endif
