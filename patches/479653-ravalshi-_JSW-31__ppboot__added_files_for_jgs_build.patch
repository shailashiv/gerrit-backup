diff --git a/Makefile b/Makefile
index 414389d..e24b025 100644
--- a/Makefile
+++ b/Makefile
@@ -4,7 +4,7 @@
 BASE_DEV_NAME := $(shell echo $(HL_DEV) | cut -d'_' -f1)
 HL_DEV_SUBTYPE := $(shell echo $(HL_DEV) | cut -d'_' -s -f2,3)
 ifeq ($(HL_DEV_SUBTYPE),)
-	HL_DEV_SUBTYPE := arm
+	HL_DEV_SUBTYPE := arc
 endif
 PREBOOT_ROOT_DIR := .
 HL_DEV_ARCH := arch/$(BASE_DEV_NAME)/$(HL_DEV_SUBTYPE)
diff --git a/arch/jgs/arc/Makefile b/arch/jgs/arc/Makefile
new file mode 100644
index 0000000..901af36
--- /dev/null
+++ b/arch/jgs/arc/Makefile
@@ -0,0 +1,31 @@
+include $(HL_DEV_ARCH_COMMON)/Makefile
+
+PPBOOT_MAX_SIZE := 16384
+
+CFLAGS += -I$(SPECS_H17_DIR)/jgs/
+CFLAGS += -I$(SPECS_H17_DIR)/jgs/asic_reg
+CFLAGS += -I$(SPECS_EMBEDDED_DIR)/fs/common
+CFLAGS += -I$(SPECS_EMBEDDED_DIR)/fs/$(DEV_PREFIX)
+
+ARBOOT_EXPORTS_FILE := $(HL_DEV_ARCH)/exports.elf
+LDFLAGS += -Wl,--just-symbols $(ARBOOT_EXPORTS_FILE)
+
+PPBOOT_SRCS_C := $(filter-out lib/common/module_i2c_slave.c,$(PPBOOT_SRCS_C))
+PPBOOT_SRCS_C := $(filter-out lib/common/pif_ts.c,$(PPBOOT_SRCS_C))
+PPBOOT_SRCS_C += $(HL_DEV_ARCH)/pll.c
+PPBOOT_SRCS_C += $(shell ls $(EMB_COMMON_MOD_DIR)/arch/$(BASE_DEV_NAME)/common.c)
+
+PALAD_BLOADER_SRCS_C += $(shell ls $(EMB_COMMON_MOD_DIR)/arch/$(BASE_DEV_NAME)/$(HL_TARGET).c)
+PALAD_BLOADER_SRCS_C += $(shell ls $(EMB_COMMON_MOD_DIR)/arch/$(BASE_DEV_NAME)/common.c)
+
+# TODO: uncomment when bootrom exports is available
+#ifeq ($(HL_TARGET),onix)
+#	LDFLAGS += -Wl,--just-symbols $(HL_DEV_ARCH)/exports_onix.elf
+#else
+#	LDFLAGS += -Wl,--just-symbols $(HL_DEV_ARCH)/exports.elf
+#endif
+
+PHY_FW_SIZE ?= 0	#dummy value for building auxilary apps w/o phy logic
+CFLAGS += -DPHY_FW_SIZE=$(PHY_FW_SIZE)
+
+image_validation: image_validation_common
diff --git a/arch/jgs/arc/asic.c b/arch/jgs/arc/asic.c
new file mode 100644
index 0000000..5838e1e
--- /dev/null
+++ b/arch/jgs/arc/asic.c
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * (C) Copyright 2023 HabanaLabs, Ltd.
+ */
+
+#include <psoc_pad_conf_regs.h>
+#include <jgs_blocks_linux_driver.h>
+
+#include <baremetal.h>
+#include <pll.h>
+#include <uart.h>
+//TODO: remove
+//#include<dummy.h>
+
+
+/* timestamp fed with constand ref_clk/2 */
+#define TS_CLOCK_FREQUENCY	25000000ULL
+
+u64 hl_pll_timestamp_freq_get(void)
+{
+	return TS_CLOCK_FREQUENCY;
+}
+
+u32 hl_spi_baudr_get(void)
+{
+	u32 factor, psoc_div3_freq;
+
+	psoc_div3_freq = hl_pll_get_freq(mmIO_0_CFG_PLL_GRP0_PSOC_PLL_PLL_BASE, HL_PLL_DIV3);
+	factor = psoc_div3_freq / HL_SPI_FLASH_MAX_FREQ;
+
+	/* baud rate doesn't support odd number and must not be 0 */
+	factor = (factor < 2) ? 2 : factor;
+
+	return (factor + 1) & 0xFFFE;
+}
+
+u32 hl_skip_pcie_init(void)
+{
+	return 0;
+}
+
+void hl_uart_init(void)
+{
+	/* As per Gaudi3 Frequencies.xlsx, PSOC PLL Div[3] drives uart */
+	u32 uart_clk_freq = hl_pll_get_freq(mmIO_0_CFG_PLL_GRP0_PSOC_PLL_PLL_BASE,
+										HL_PLL_DIV3);
+
+	regmap_writel(1, mmIO_0_CFG_PSOC_PSOC_CFG_PAD_CONF_BASE +
+			 mmPSOC_PAD_CONF_PAD_SEL_49);				/* UART0 RXD */
+	regmap_writel(1, mmIO_0_CFG_PSOC_PSOC_CFG_PAD_CONF_BASE +
+			 mmPSOC_PAD_CONF_PAD_SEL_50);				/* UART0 TXD */
+	preboot_uart_init(uart_clk_freq / HL_UART_BAUDRATE);
+}
+
+void preboot_pcie_wait_for_link(void)
+{
+	/* TODO: implement PCI init for Asic */
+}
