new file mode 100644
index 0000000..c0ee638
--- /dev/null
+++ b/arch/jgs/arc/pcie_phy_fw_parser.py
@@ -0,0 +1,133 @@
+# SPDX-License-Identifier:     GPL-2.0+
+#
+# (C) Copyright 2023 HabanaLabs, Ltd.
+
+import sys
+import os
+
+MSB_ADDRESS_MASK = 0x80000000
+
+def extract_sram_locations_from_hex(hex_file_path, target_binary_file_path):
+	try:
+		with open(hex_file_path, 'r') as file:
+			hex_data = file.read().strip()
+
+			parsed_data = []
+			for line in hex_data.split('\n'):
+				if line.strip() != '':
+					address_s, data_s = line.strip().split(',')
+					address = int(address_s, 16)
+					data = int(data_s, 16)
+
+					# Extract the SRAM locations from the hex file
+					if (address & MSB_ADDRESS_MASK) == MSB_ADDRESS_MASK:
+						parsed_data.append(data)
+
+			# Create a binary file with the parsed_data
+			generated_bin_file_path = target_binary_file_path +\
+   						  ('/' if target_binary_file_path else '') +\
+           					  'pcie_phy_fw.bin'
+			with open(generated_bin_file_path, 'wb') as bin_file:
+				for data in parsed_data:
+					bin_file.write(data.to_bytes(4, 'little'))
+
+			print(f"Binary file '{generated_bin_file_path}' created successfully.")
+
+			# Get the size of the binary file
+			binary_file_size = os.path.getsize(generated_bin_file_path)
+			print(f"Size of binary file '{generated_bin_file_path}': {binary_file_size} bytes.")
+			return binary_file_size
+
+	except FileNotFoundError:
+		print(f"Error: File '{hex_file_path}' not found.")
+		return None
+
+def extract_csr_locations_from_hex(hex_file_path, target_header_file_path):
+	try:
+		with open(hex_file_path, 'r') as file:
+			hex_data = file.read().strip()
+
+			parsed_data = []
+			lines_count = 0
+			size_of_csr_locations = 0
+			for line in hex_data.split('\n'):
+				lines_count += 1
+				if line.strip() != '':
+					address_s, data_s = line.strip().split(',')
+					address = int(address_s, 16)
+					data = int(data_s, 16)
+
+     					# Extract the CSR locations from the hex file
+					if (address & MSB_ADDRESS_MASK) != MSB_ADDRESS_MASK:
+						size_of_csr_locations+=8
+						parsed_data.append(data)
+						parsed_data.append(address)
+
+			print(f"Lines count: {lines_count}")
+			print(f"Size of CSR locations: {size_of_csr_locations}B")
+
+			# Create a header file with const array of the parsed csr locations data
+			generated_h_file_path = target_header_file_path + \
+						('/' if target_header_file_path else '') + \
+						'auto_gen_pcie_phy_csr_locations.h'
+			with open(generated_h_file_path, 'w') as h_file:
+
+				h_file.write('////////////////////////////////\n')
+				h_file.write('// This file is auto-generated\n')
+				h_file.write('////////////////////////////////\n\n')
+
+				h_file.write('#pragma once\n\n')
+
+				h_file.write('#include <stdint.h>\n\n')
+
+				h_file.write(f'const size_t csr_locations_size = {len(parsed_data)};\n')
+				h_file.write('const uint32_t csr_locations[] = {\n')
+				for i in range(0, len(parsed_data), 2):
+					data = parsed_data[i]
+					address = parsed_data[i+1]
+					h_file.write(f'\t0x{data:08X},0x{address:08X},\n')
+				h_file.write('};\n\n')
+
+				h_file.write('size_t get_csr_locations_size() {\n')
+				h_file.write('	return csr_locations_size;\n')
+				h_file.write('}\n\n')
+
+				h_file.write('const uint32_t* get_csr_locations() {\n')
+				h_file.write('	return csr_locations;\n')
+				h_file.write('}\n\n')
+
+			print(f"h file '{generated_h_file_path}' created successfully.")
+
+
+	except FileNotFoundError:
+		print(f"Error: File '{hex_file_path}' not found.")
+		return None
+
+
+if __name__ == "__main__":
+	print("~~~~~~~~~~~~~~~~~~~~~~~~~~~")
+	print("~  pcie_phy_fw_parser.py  ~")
+	print("~~~~~~~~~~~~~~~~~~~~~~~~~~~")
+	# Parse the command line arguments
+	if len(sys.argv) < 4:
+		print("Error: Insufficient command line arguments.")
+		print("Usage: python pcie_phy_fw_parser.py" + \
+          			     " " + "<hex_file_path>" + \
+                  		     " " + "<target_header_file_path>" + \
+                		     " " + "<target_binary_file_path>")
+		sys.exit(1)
+
+	# Extract the command line arguments
+	hex_file_path = sys.argv[1]
+	target_header_file_path = sys.argv[2]
+	target_binary_file_path = sys.argv[3]
+
+	if not os.path.exists(hex_file_path):
+		print(f"Error: File '{hex_file_path}' not found - existing.")
+		sys.exit(1)
+
+	# Call the functions to extract CSR and SRAM locations from the hex file
+	extract_csr_locations_from_hex(hex_file_path, target_header_file_path)
+	phy_sram_loc_size = extract_sram_locations_from_hex(hex_file_path, target_binary_file_path)
+
+	print(f"phy_sram_loc_size = {phy_sram_loc_size} Bytes.")
