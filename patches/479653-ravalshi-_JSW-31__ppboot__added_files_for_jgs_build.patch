+/* SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Copyright (C) 2023 HabanaLabs Ltd.
+ */
+
+#ifndef COMMON_JGS_ARC_GNU_H_
+#define COMMON_JGS_ARC_GNU_H_
+
+#include <sizes.h>
+
+#define PPBOOT_SIZE			0x4000		/* 16KB */
+
+#define HL_FW_BOOT_PTRS_BASE		0
+
+/* same as IO0_SP_SRAM_FULL_BASE (left here for backwards compatibility) */
+#define HL_SP_SRAM_BASE			0x300007FF8A00000ULL
+#define HL_SP_SRAM_SIZE			SZ_1M
+
+/* CFG is at Arc region F, specs CFG base address is 0x70000000. 7+8 = 0xF */
+/* defined here in addition to specs because they are in use im common code */
+#define HL_CFG_BASE			0x80000000
+#define FW_MEM_REGION_BASE		0x78800000 /* IO Die0 Half0 FW memories */
+#define FW_SRAM_BASE			(FW_MEM_REGION_BASE + 0x1A0000)
+#define SP_SRAM_BASE			(FW_MEM_REGION_BASE + 0x200000)
+
+#define BOOT_INFO_BASE			SP_SRAM_BASE
+#define BOOT_INFO_SIZE			SZ_32K
+
+#define PPBOOT_TEXT_BASE		FW_SRAM_BASE
+/* preboot sits after bootinfo */
+#define PREBOOT_TEXT_BASE		(SP_SRAM_BASE + BOOT_INFO_SIZE)
+#define PREBOOT_TEXT_BASE_FULL		(HL_SP_SRAM_BASE + BOOT_INFO_SIZE)
+#define RECOVERY_TEXT_BASE		0x0
+#define RECOVERY_SIZE			SZ_16K
+
+/* SDRAM is not available in FS1, SPSRAM used instead */
+#define SDRAM_BASE			SP_SRAM_BASE
+
+/*
+ * In order not to conflict with ARC BOOTROM's usage of DCCM,
+ * Let PPBoot start from the offset of 0x6000, for using DCCM
+ * for its own BSS and Stack.
+ */
+#define PPBOOT_DCCM_BASE		0x80006000
+
+#define FUSE_WORDS_PER_BANK		0x80
+#define I2C_SLAVE_ADDRESS		0x6A
+#define I2C_SLAVE_ADDRESS_DBG		I2C_SLAVE_ADDRESS
+#define I2C_SLAVE_DEFAULT_INTR_MASK	0x48FF
+
+#define ARC_RST_VALUE			0x110
+#define ARC_RST_VEC_ADDR		0x0
+
+#define ARC_ADDR_MASK			0xFFFFFFFull
+
+/*
+ * RX poll timeout is configured at 1.28ms, which is duration
+ * required for the transfer of 4kB of data over SPI at a
+ * frequency of 25MHz.
+ * This is TODO for FS1
+ */
+#define SPI_RX_POLL_TIMEOUT_US		1280 /* timeout in us */
+
+#ifdef PROT_MASK_WINBOND
+#undef PROT_MASK_WINBOND
+#endif
+/*  for winbond flash: BP0 == 0x1 - means 1 block - up to 256KB (eROM) */
+#define PROT_MASK_WINBOND	(READ_STATUS_BP0 | READ_STATUS_TB)
+
+#endif /* COMMON_JGS_ARC_GNU_H_ */
