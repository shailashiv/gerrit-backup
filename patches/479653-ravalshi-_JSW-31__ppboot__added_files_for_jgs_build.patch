@@ -0,0 +1,67 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * (C) Copyright 2023 HabanaLabs, Ltd.
+ */
+
+#include <psoc_pad_conf_regs.h>
+#include <fs1_blocks_linux_driver.h>
+
+#include <baremetal.h>
+#include <pll.h>
+#include <uart.h>
+
+#define SYS_CLOCK_FREQUENCY	35000000ULL
+
+u64 hl_pll_timestamp_freq_get(void)
+{
+	return SYS_CLOCK_FREQUENCY;
+}
+
+u32 hl_skip_pcie_init(void)
+{
+	return 1;
+}
+
+u32 hl_spi_baudr_get(void)
+{
+	u32 factor = SYS_CLOCK_FREQUENCY / HL_SPI_FLASH_MAX_FREQ;
+
+	/* baud rate doesn't support odd number and must not be 0 */
+	factor = (factor < 2) ? 2 : factor;
+
+	return (factor + 1) & 0xFFFE;
+}
+
+void hl_uart_init(void)
+{
+	regmap_writel(1, mmIO_0_CFG_HALF_0_PSOC_PSOC_CFG_PAD_CONF_BASE +
+			 mmPSOC_PAD_CONF_PAD_SEL_49);				/* UART0 RXD */
+	regmap_writel(1, mmIO_0_CFG_HALF_0_PSOC_PSOC_CFG_PAD_CONF_BASE +
+			 mmPSOC_PAD_CONF_PAD_SEL_50);				/* UART0 TXD */
+	preboot_uart_init(SYS_CLOCK_FREQUENCY / (HL_UART_BAUDRATE / 2));
+}
+
+void preboot_pcie_wait_for_link(void)
+{
+	/* no PCI init required for Onix */
+}
+
+/* link is managed by Zilinx IP, FW doesn't have control */
+bool hl_is_pcie_link_up(void) { return true; }
+
+/* JTAG is enabled by default */
+void hl_jtag_init(void) {}
+
+/* PCI blocks no Available on Onix */
+void plat_pcie_drain_init(void) {}
+
+/* VUART not available in Onix */
+void preboot_putc_virt_uart(const char c) {}
+
+/* Early write response not available in Onix */
+void hl_lbw_early_write_resp_enable(void) {}
+
+/* Init cpu-id not available in Onix */
+void hl_init_cpu_ids(void) {}
+
+void hl_dev_pll_init(void) {}
