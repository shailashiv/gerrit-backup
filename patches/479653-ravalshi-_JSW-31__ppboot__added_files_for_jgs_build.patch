+#define SYS_CLOCK_FREQUENCY	250000000ULL /* PCI PLL DIV3 Emulation clk */
+
+#define UART_CLOCK_FREQUENCY	SYS_CLOCK_FREQUENCY
+#define PALAD_UART_BAUDRATE	300
+
+/*
+ * This cfg specific to PALAD bumps up uart freq
+ * to 250 MHz while keeping other divs on nominal frequency
+ */
