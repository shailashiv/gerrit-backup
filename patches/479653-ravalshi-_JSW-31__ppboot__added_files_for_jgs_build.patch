+
+#define SPSRAM_ADDR_MASK	0xFFFFF
+
+static u32 fs1_translate_arc_addr(u64 addr)
+{
+	if (addr >= IO0_SP_SRAM_FULL_BASE && addr < (IO0_SP_SRAM_FULL_BASE + (u64)IO_SP_SRAM_SIZE)) {
+		addr = (addr & SPSRAM_ADDR_MASK) + IO0_SP_SRAM_BASE;
+		goto ret_addr;
+	}
+
+	preboot_puts_hex64("warn: no address translation: ", addr, true);
+
+ret_addr:
+	return (u32)addr;
+}
+
+void image_start(u64 loadaddr)
+{
+	u32 arc_addr = fs1_translate_arc_addr(loadaddr);
+	void (*image_entry)(void);
+
+	/*
+	 * Jump to __reset of zephyr. After image_entry, control is not
+	 * expected to return here and continue.
+	 */
+	image_entry = (void *)(*(u32 *)arc_addr);
+
+	image_entry();
+}
+
+static enum dma_dest_type preboot_get_dma_dest_type(uint64_t addr)
+{
+	if (addr >= IO0_FW_SRAM_FULL_BASE &&
+	    addr < IO0_FW_SRAM_FULL_BASE + IO_FW_SRAM_SIZE)
+		return DMA_DEST_SRAM;
+
+	return DMA_DEST_HBW;
+}
+
+#ifndef USE_BOOTROM_SPI_DMA
+
+static int dma_copy_image_internal(uint16_t image_size, uint32_t flash_offset,
+				    uint64_t dest_offset, uint8_t fw_sram_dst)
+{
+	uint32_t spi_dma_ctrl =  0, restart_crc = 1;
+	uint32_t spi_dma_status;
+	uint32_t spi_dma_dst_addr_l = DMA_ADDRESS_LOW(dest_offset);
+	uint32_t spi_dma_dst_addr_h = DMA_ADDRESS_HIGH(dest_offset);
+	uint16_t flash_offset_1k = flash_offset / DMA_SRC_BLOCK_SIZE;
+	uint16_t image_size_4b = (image_size / DMA_DST_BLOCK_SIZE);
+
+	regmap_writel(spi_dma_dst_addr_l, mmIO_0_CFG_PSOC_PARC_CFG_MISC_BASE +
+					  mmPARC_GLOBAL_CONF_SPI_DMA_DST_ADDR_L);
+	regmap_writel(spi_dma_dst_addr_h, mmIO_0_CFG_PSOC_PARC_CFG_MISC_BASE +
+					  mmPARC_GLOBAL_CONF_SPI_DMA_DST_ADDR_H);
+
+	/* enable DMA transfer */
+	spi_dma_ctrl = PARC_GLOBAL_CONF_SPI_DMA_CTRL_EN_M;
+
+	/* sram=1 hbw=0 as destination */
+	spi_dma_ctrl |= fw_sram_dst << PARC_GLOBAL_CONF_SPI_DMA_CTRL_DST_SRAM_S;
+
+	/* TODO: This patch is temporary until FSW-9792 is implemented */
+	/* 0: continue crc calc 1: restart crc */
+	spi_dma_ctrl |= restart_crc << PARC_GLOBAL_CONF_SPI_DMA_CTRL_CRC_RESTART_S;
+
+	/* # of 4bytes to DMA copy */
+	spi_dma_ctrl |= (uint32_t)image_size_4b << PARC_GLOBAL_CONF_SPI_DMA_CTRL_MEM_SIZE_S;
+
+	/* spi offset in 1k chunks */
+	spi_dma_ctrl |= (uint32_t)flash_offset_1k << PARC_GLOBAL_CONF_SPI_DMA_CTRL_ADDR_SHIFT_S;
+
+	regmap_writel(spi_dma_ctrl, mmIO_0_CFG_PSOC_PARC_CFG_MISC_BASE +
+				    mmPARC_GLOBAL_CONF_SPI_DMA_CTRL);
+
+	/*
+	 * wait for DMA finish
+	 * TODO: Naive temporary implementation, add transaction timeout monitoring
+	 */
+	do {
+		spi_dma_status = regmap_readl(mmIO_0_CFG_PSOC_PARC_CFG_MISC_BASE +
+					      mmPARC_GLOBAL_CONF_SPI_DMA_STATUS);
+	} while (!(spi_dma_status & PARC_GLOBAL_CONF_SPI_DMA_STATUS_DONE_M));
+
+	return (spi_dma_status & PARC_GLOBAL_CONF_SPI_DMA_STATUS_ERROR_M) >>
+		PARC_GLOBAL_CONF_SPI_DMA_STATUS_ERROR_S;
+
+}
+
+/*
+ * DMA example:
+ * image_size = 200kb + 16 bytes CRC = 0x32010
+ * dma_chunks: 4
+ * 1st DMA: SRC: 0x0 DST: 0x0 (dma_size: 0xFFF4 left_size: 0x2201C)
+ * 2nd DMA: SRC: 0x10000 DST: 0xFFF0 (dma_size: 0xFFF4 left_size: 0x12028)
+ * 3nd DMA: SRC: 0x20000 DST: 0x1FFE0 (dma_size: 0xFFF4 left_size: 0x2034)
+ * 4th DMA: SRC: 0x30000 DST: 0x2FFD0 (dma_size: 0x2034 left_size: 0x0)
+ */
+static enum dma_error dma_copy_image_v2(uint32_t image_size, uint32_t flash_offset,
+					uint64_t dest_addr, enum dma_dest_type dest_type,
+					bool skip_crc_check)
+{
+	uint32_t copy_size, dma_size;
+	uint32_t dma_chunks;
+	uint8_t i;
+	int crc_err;
+
+	if (dest_type >= DMA_DEST_MAX)
+		return DMA_INVALID_DEST_TYPE;
+
+	if (dest_addr % ADDR_SIZE_ALIGNMENT)
+		return DMA_UNALIGNED_DEST_ADDR;
+
+	dma_chunks = image_size / MAX_DMA_SIZE_CRC;
+	if (image_size % MAX_DMA_SIZE_CRC)
+		dma_chunks++;
+
+	if (image_size < MIN_DMA_SIZE_CRC)
+		return DMA_INVALID_IMG_SIZE;
+
+	if ((image_size - (CRC32_SIZE * dma_chunks)) % ADDR_SIZE_ALIGNMENT)
+		return DMA_UNALIGNED_IMG_SIZE;
+
+	copy_size = image_size;
+
+	for (i = 0; i < dma_chunks; i++) {
+		dma_size = copy_size > MAX_DMA_SIZE_CRC ? MAX_DMA_SIZE_CRC : copy_size;
+		crc_err = dma_copy_image_internal(dma_size, (flash_offset + (OFFSET_64KB * i)),
+						  (dest_addr + (MAX_DMA_SIZE * i)), dest_type);
+		if ((!skip_crc_check) && crc_err)
+			return DMA_INVALID_CRC_ERROR;
+
+		copy_size -= dma_size;
+	}
+
+	return DMA_SUCCESS;
+}
+
+#else
+/* TODO: use bootrom code when it is mature enough FSW-2070 */
+#endif /* USE_BOOTROM_SPI_DMA */
+
+bool ppboot_cp_image(u64 loadaddr, u32 offset, u32 size, char *name)
+{
+	enum dma_error dma_err;
+	enum dma_dest_type dma_type;
+
+	if (name)
+		preboot_puts_raw(name);
+	preboot_puts_hex64(" loadaddr: ", loadaddr, false);
+
+	dma_type = preboot_get_dma_dest_type(loadaddr);
+
+	dma_err = dma_copy_image_v2(size, offset, loadaddr, dma_type, false);
+	if (dma_err != DMA_SUCCESS) {
+		preboot_puts_hex("DMA failed to copy preboot, err=", dma_err, false);
+		return false;
+	}
+
+	return true;
+}
+
+void hl_erom_bringup_pcie_link(void)
+{
+	preboot_pcie_wait_for_link();
+}
+
+/* by default IO0 fuse is read */
+int preboot_fuse_read(u32 word, u32 *val)
+{
+	return hl_fuse_read(mmIO_0_CFG_PSOC_PSOC_CFG_EFUSE_BASE, word, val);
+}
+
+#define MEM_CPY_LBW_SIZE_LIMIT		(SZ_1M - SZ_16)
+#define MEM_CPY_LBW_SIZE_SHIFT		2
+#define MEM_CPY_LBW_SIZE_SHIFT_MASK	(BIT(MEM_CPY_LBW_SIZE_SHIFT) - 1)
+#define MEM_CPY_HBW_SIZE_LIMIT		(SZ_4M - SZ_16)
+#define MEM_CPY_HBW_SIZE_SHIFT		4
+#define MEM_CPY_HBW_SIZE_SHIFT_MASK	(BIT(MEM_CPY_HBW_SIZE_SHIFT) - 1)
+#define HL_MEM_CPY_TIMEOUT_US		10000
+
+int fs1_mem_init(uint64_t dst, uint32_t size, bool is_hbw)
+{
+	return hw_mem_copy(0, dst, size, is_hbw, true);
+}
+
+u32 _dev_spec_get_img_desc(struct hl_fw_img_desc *desc_ptr, enum fw_post_reset_cmd upd_status,
+			  struct boot_desc *desc)
+{
+	/* TODO: use stable index when bootinfo implementation is final in arcboot */
+	desc->spi_offset = desc_ptr->spi_offset[0];
+	desc->img_size = desc_ptr->size;
+	desc->loadaddr = ((u64)desc_ptr->load_high << 32) | desc_ptr->load_low;
+	desc->desc_ver = desc_ptr->desc_ver;
+	desc->crc32 = desc_ptr->crc32;
+	memcpy(desc->chksum, desc_ptr->chksum, ARRAY_SIZE(desc->chksum));
+	desc->cpu_cfg_base = desc_ptr->cpu_cfg_base;
+	desc->mem_base = ((u64)desc_ptr->mem_base_high << 32) | desc_ptr->mem_base_low;
+	desc->mem_size = desc_ptr->mem_size;
+	desc->flags = desc_ptr->flags.img_flags;
+
+	return 0;
+}
+
+__weak void hl_pcie_phy_fw_copy(void)
+{
+	preboot_puts("Skipping phy init\n");
+}
+
+void hl_init_pcie_phy_fw(void)
+{
+	u32 rst_src = hl_rst_src_get();
+
+	if (rst_src == HL_COLD_RST || rst_src == HL_MANUAL_RST)
+		hl_pcie_phy_fw_copy();
+}
+
+static bool image_is_load_req(struct desc_flags flags, u32 rst_src)
+{
+	switch (rst_src) {
+	case HL_COLD_RST:
+	case HL_MANUAL_RST:
+		if (flags.cold_load)
+			return true;
+		break;
+	case HL_PRSTN_RST:
+		if (flags.warm_load)
+			return true;
+		break;
+	default:
+		if (flags.sw_rst_load)
+			return true;
+	}
+
+	return false;
+}
+
+static bool image_is_exec_req(struct desc_flags flags, u32 rst_src)
+{
+	switch (rst_src) {
+	case HL_COLD_RST:
+	case HL_MANUAL_RST:
+		if (flags.cold_exec)
+			return true;
+		break;
+	case HL_PRSTN_RST:
+		if (flags.warm_exec)
+			return true;
+		break;
+	default:
+		if (flags.sw_rst_exec)
+			return true;
+	}
+
+	return false;
+}
+
+#define PSOC_CPU_RUN_MASK	0x1
+#define PSOC_CPU_HALT_MASK	0x2
+
+static void image_load_cpu_prep(struct boot_desc *desc, u32 rst_src)
+{
+	struct desc_flags flags;
+
+	flags.img_flags = desc->flags;
+
+	/* if current CPU, do nothing */
+	if (desc->cpu_cfg_base == mmIO_0_CFG_PSOC_ARC_MNG_ARC_BASE)
+		return;
+
+	if (!image_is_load_req(flags, rst_src) && !image_is_exec_req(flags, rst_src))
+		return;
+
+	/* if not current CPU, release CPU reset and stop CPU */
+	if (flags.cpu_type == CPU_TYPE_PSOC) {
+		regmap_writel(0, desc->cpu_cfg_base + mmARC_ARC_RST);
+		regmap_writel(PSOC_CPU_HALT_MASK, desc->cpu_cfg_base + mmARC_RUN_HALT_REQ);
+#ifdef TO_BE_REMOVED
+	} else {
+		regmap_writel(0, desc->cpu_cfg_base + mmFARM_ARC_AUX_ARC_RST);
+		regmap_writel(1, desc->cpu_cfg_base + mmFARM_ARC_AUX_HALT_REQ);
+#endif
+	}
+}
+
+static void image_load_mem_init(struct boot_desc *desc, u32 rst_src)
+{
+	struct desc_flags flags;
+
+	flags.img_flags = desc->flags;
+	if (image_is_load_req(flags, rst_src) && flags.mem_init)
+		fs1_mem_init(desc->mem_base, desc->mem_size, false);
+}
+
+static void image_load_mem_load(struct boot_desc *desc, u32 rst_src)
+{
+	char *image_name = NULL;
+	char *preboot_str = "Preboot";
+	struct desc_flags flags;
+
+	flags.img_flags = desc->flags;
+
+	if (!image_is_load_req(flags, rst_src))
+		return;
+
+	if (desc->cpu_cfg_base == mmIO_0_CFG_PSOC_ARC_MNG_ARC_BASE)
+		image_name = preboot_str;
+
+	ppboot_cp_image(desc->loadaddr, desc->spi_offset, desc->img_size, image_name);
+}
+
+#define CPU_RST_VECTOR_SHIFT	10
+
+static u32 image_load_get_rst_vector(struct boot_desc *desc)
+{
+	u32 arc_addr = fs1_translate_arc_addr(desc->loadaddr);
+	u32 rst_vec;
+
+	/*
+	 * reset vector specified in the first 4 bytes of the image, meaning in the beginning of
+	 * loadaddr location.
+	 */
+	rst_vec = *(u32 *)arc_addr;
+
+	return rst_vec >> CPU_RST_VECTOR_SHIFT;
+}
+
+static bool image_load_cpu_exec(struct boot_desc *desc, u32 rst_src)
+{
+	u32 rst_vector;
+	struct desc_flags flags;
+
+	flags.img_flags = desc->flags;
+
+	if (!image_is_exec_req(flags, rst_src))
+		return false;
+
+	/* if executing on current CPU nothing more to do here */
+	if (desc->cpu_cfg_base == mmIO_0_CFG_PSOC_ARC_MNG_ARC_BASE)
+		return true;
+
+	rst_vector = image_load_get_rst_vector(desc);
+	if (flags.cpu_type == CPU_TYPE_PSOC) {
+		regmap_writel(rst_vector, desc->cpu_cfg_base + mmARC_RST_VEC_ADDR);
+		regmap_writel(PSOC_CPU_RUN_MASK, desc->cpu_cfg_base + mmARC_RUN_HALT_REQ);
+#ifdef TO_BE_REMOVED
+	} else {
+		regmap_writel(rst_vector, desc->cpu_cfg_base + mmFARM_ARC_AUX_RST_VEC_ADDR);
+		regmap_writel(1, desc->cpu_cfg_base + mmFARM_ARC_AUX_RUN_REQ);
+#endif
+	}
+
+	return false;
+}
+
+/*
+ * Load images from flash in an automated manner, based on manifest image parameters.
+ * Loop on descriptors until action is required (based on flags and reset cause)
+ * 1. if not current CPU, prepare the CPU by release of CPU reset
+ * 2. if mem init required, init memory
+ * 3. if mem load required, copy the image to memory and validate sha
+ * 4. if cpu execution required, and not current CPU, set reset vector and run CPU.
+ *    if cpu execution required, and current CPU, return address
+ */
+bool ppboot_load_next_img(u64 *loadaddr)
+{
+	struct boot_desc desc;
+	int bootdesc_cnt, i;
+	u32 rst_src, err;
+	bool no_return;
+
+	bootdesc_cnt = _boot_desc_init();
+	if (!bootdesc_cnt) {
+		preboot_puts_raw("No valid flash manifest");
+		return false;
+	}
+
+	for (i = 0; i < bootdesc_cnt; i++) {
+		err = _boot_desc_get_img_desc_by_idx(i, &desc);
+		if (err) {
+			preboot_puts_hex("Failed to get boot descriptor no. ", i, false);
+			continue;
+		}
+
+		rst_src = hl_rst_src_get();
+		image_load_cpu_prep(&desc, rst_src);
+		image_load_mem_init(&desc, rst_src);
+		image_load_mem_load(&desc, rst_src);
+		no_return = image_load_cpu_exec(&desc, rst_src);
+		if (no_return) {
+			*loadaddr = desc.loadaddr;
+			return true;
+		}
+	}
+
+	return false;
+}
