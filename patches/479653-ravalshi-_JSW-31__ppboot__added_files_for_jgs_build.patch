+static void init_pcie_phy_fw_update(void)
+{
+	u32 val;
+
+	/*
+	 * The exact size of data written to SRAM_LOCATIONS and CSR_LOCATIONS
+	 * is written to PHY_FW_FSM_SIZE register.
+	 */
+	val = regmap_readl(mmIO_0_CFG_HALF_0_CXL_EP_PCIE_FW_FSM_BASE +
+			   mmPCIE_FW_FSM_PHY_FW_FSM_SIZE);
+	val &= ~PCIE_FW_FSM_PHY_FW_FSM_SIZE_PMA_SRAM_SIZE_M;
+	val |= PHY_FW_SIZE << PCIE_FW_FSM_PHY_FW_FSM_SIZE_PMA_SRAM_SIZE_S;
+	regmap_writel(val, mmIO_0_CFG_HALF_0_CXL_EP_PCIE_FW_FSM_BASE +
+			   mmPCIE_FW_FSM_PHY_FW_FSM_SIZE);
+
+	val = regmap_readl(mmIO_0_CFG_HALF_0_CXL_EP_PCIE_FW_FSM_BASE +
+			   mmPCIE_FW_FSM_PHY_FW_FSM_SIZE);
+	val &= ~PCIE_FW_FSM_PHY_FW_FSM_SIZE_PMA_CSR_SIZE_M;
+	val |= (uint16_t)get_csr_locations_data_size() << PCIE_FW_FSM_PHY_FW_FSM_SIZE_PMA_CSR_SIZE_S;
+	regmap_writel(val, mmIO_0_CFG_HALF_0_CXL_EP_PCIE_FW_FSM_BASE +
+			   mmPCIE_FW_FSM_PHY_FW_FSM_SIZE);
+
+	/*
+	 * PHY_FW_FSM_CTRL ➔ SRAM_ROM_SEL should be set to '0'
+	 * to disable default phy fw from ROM.
+	 */
+	val = regmap_readl(mmIO_0_CFG_HALF_0_CXL_EP_PCIE_FW_FSM_BASE +
+			   mmPCIE_FW_FSM_PHY_FW_FSM_CTRL);
+	val &= ~PCIE_FW_FSM_PHY_FW_FSM_CTRL_SRAM_ROM_SEL_M;
+	val |= 0 << PCIE_FW_FSM_PHY_FW_FSM_CTRL_SRAM_ROM_SEL_S;
+	regmap_writel(val, mmIO_0_CFG_HALF_0_CXL_EP_PCIE_FW_FSM_BASE +
+			   mmPCIE_FW_FSM_PHY_FW_FSM_CTRL);
+
+	/*
+	 * PHY_FW_FSM_CTRL ➔ FSM_START set to '1'
+	 * to start the phy fw loading to the fw memories.
+	 */
+	val = regmap_readl(mmIO_0_CFG_HALF_0_CXL_EP_PCIE_FW_FSM_BASE +
+			   mmPCIE_FW_FSM_PHY_FW_FSM_CTRL);
+	val &= ~PCIE_FW_FSM_PHY_FW_FSM_CTRL_FSM_START_M;
+	val |= 1 << PCIE_FW_FSM_PHY_FW_FSM_CTRL_FSM_START_S;
+	regmap_writel(val, mmIO_0_CFG_HALF_0_CXL_EP_PCIE_FW_FSM_BASE +
+			   mmPCIE_FW_FSM_PHY_FW_FSM_CTRL);
+
+	/*
+	 * FW should poll on PHY_FW_FSM_CTRL ➔ FW_FSM_PHY_INIT_DONE
+	 * which shows the completion of FW loading to the phy.
+	 */
+
+	/*
+	 * this code is commented out because pcie phy is not fully implemented
+	 * in palladium and it will hang the simulation.
+	 * once pcie phy is implemented, this code should be uncommented.
+	 * jira ticket: H15-352
+	 *
+	 * while (!(regmap_readl(mmIO_0_CFG_HALF_0_CXL_EP_PCIE_FW_FSM_BASE +
+	 * mmPCIE_FW_FSM_PHY_FW_FSM_CTRL) &
+	 * PCIE_FW_FSM_PHY_FW_FSM_CTRL_FW_FSM_PHY_INIT_DONE_M));
+	 *
+	 * preboot_puts("FW copied to phy successfully\n");
+	 */
+}
+
+#define BAR_SIZE_1GB		(SZ_1G - 1)
+#define VF_RES_BAR_SIZES	(PCIE_DBI_VF_RESBAR_CAP_REG_2_REG_V512GB_M | \
+				 PCIE_DBI_VF_RESBAR_CAP_REG_2_REG_V256GB_M | \
+				 PCIE_DBI_VF_RESBAR_CAP_REG_2_REG_V128GB_M | \
+				 PCIE_DBI_VF_RESBAR_CAP_REG_2_REG_V64GB_M)
+
+#define ALIGN_TO_16_BYTES(addr) (((addr) + 15) & ~0xF)
+#define PPBOOT_LAST_ADDR ((uint32_t) (&__SDATA_LOAD))
+
+size_t get_csr_locations_data_size(void)
+{
+	/* this size is taken from: auto_gen_pcie_phy_csr_locations.h */
+	return csr_locations_size;
+}
+
+/* Temporarly implemented in paladium only because of coral issue */
+void hl_pcie_phy_fw_copy(void)
+{
+	uint64_t full_addr;
+	uint8_t *dst_csr = (uint8_t *)IO0_PCIE_FW_CSR_BASE + HL_CFG_BASE;
+	/* sram_loc_addr located at PPBOOT_LAST_ADDR, aligned to 16 bytes */
+	uint32_t sram_loc_addr = ALIGN_TO_16_BYTES(PPBOOT_LAST_ADDR);
+	const uint32_t *csr_loc_data = get_csr_locations();
+
+	full_addr = get_64bit_addr_from_32bit_addr(sram_loc_addr);
+	if (!full_addr) {
+		preboot_puts("Skipping phy init\n");
+		return;
+	}
+
+	/* Copy SRAM_LOCATIONS to IO0_PCIE_FW_SRAM_FULL_BASE */
+	hw_mem_copy(full_addr,
+		IO0_PCIE_FW_SRAM_FULL_BASE,
+		(uint32_t)PHY_FW_SIZE, false, false);
+
+	/* Copy CSR_LOC_DATA to IO0_PCIE_FW_CSR_BASE */
+	memcpy(dst_csr, (const void *)csr_loc_data, get_csr_locations_data_size());
+}
+
+static void palad_pcie_params_init(void)
+{
+	u32 val;
+
+	/* enable writing to DBI RO regs */
+	val = regmap_readl(IO0_H0_PCIE_DBI(mmPCIE_DBI_MISC_CONTROL_1_OFF));
+	val |= PCIE_DBI_MISC_CONTROL_1_OFF_DBI_RO_WR_EN_M;
+	regmap_writel(val, IO0_H0_PCIE_DBI(mmPCIE_DBI_MISC_CONTROL_1_OFF));
+
+	/* switch to shadow registers access in order to set BAR masks */
+	regmap_writel(PCIE_AUX_DBI_CS2_M, mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_DBI);
+
+	/* set PF CFG BAR to 1GB */
+	regmap_writel(BAR_SIZE_1GB, IO0_H0_PCIE_DBI(mmPCIE_DBI_BAR0_REG));
+	regmap_writel(0, IO0_H0_PCIE_DBI(mmPCIE_DBI_BAR1_REG));
+
+	/* set SRIOV CFG BAR to 1GB */
+	regmap_writel(BAR_SIZE_1GB, IO0_H0_PCIE_DBI(mmPCIE_DBI_SRIOV_BAR0_REG));
+	regmap_writel(0, IO0_H0_PCIE_DBI(mmPCIE_DBI_SRIOV_BAR1_REG));
+
+	/* disable shadow registers access */
+	regmap_writel(0, mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_DBI);
+
+	/* set VF resizable BAR #2 allowed size */
+	regmap_writel(VF_RES_BAR_SIZES, IO0_H0_PCIE_DBI(mmPCIE_DBI_VF_RESBAR_CAP_REG_2_REG));
+
+	palad_pcie_dynamic_init();
+
+	/* disable writing to DBI RO regs */
+	val = regmap_readl(IO0_H0_PCIE_DBI(mmPCIE_DBI_MISC_CONTROL_1_OFF));
+	val &= ~PCIE_DBI_MISC_CONTROL_1_OFF_DBI_RO_WR_EN_M;
+	regmap_writel(val, IO0_H0_PCIE_DBI(mmPCIE_DBI_MISC_CONTROL_1_OFF));
+}
+
+#define LTTSM_ENA_MASK	(PCIE_AUX_LTSSM_EN_IND_M | PCIE_AUX_LTSSM_EN_MASK_M)
+
+void preboot_pcie_wait_for_link(void)
+{
+	init_pcie_phy_fw_update();
+
+	palad_pcie_params_init();
+
+	regmap_writel(LTTSM_ENA_MASK, mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE +
+				      mmPCIE_AUX_LTSSM_EN);
+
+	/* release request retry so the host can access pci config space */
+	regmap_writel(0, IO0_H0_PCIE_FLR(mmPCIE_FLR_APP_REQ_RETRY_EN));
+	regmap_writel(0, IO0_H0_PCIE_FLR(mmPCIE_FLR_APP_PF_REQ_RETRY_EN));
+	regmap_writel(0, IO0_H0_PCIE_FLR(mmPCIE_FLR_APP_VF_REQ_RETRY_EN));
+}
