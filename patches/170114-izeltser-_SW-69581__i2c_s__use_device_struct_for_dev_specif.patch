From 5fdd81b4ec6956fa013b65129baf4723d2b1a657 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Thu, 20 Jan 2022 16:45:10 +0200
Subject: [PATCH] [SW-69581] i2c_s: use device struct for dev specific regs

Including device specific headers from common code is not allowed
anymore, and instead the device structures should be used.
I2C slave device code is refactored to use device structure.

Change-Id: I93dcf6626f384cbc225b9c36622a61f6c8ff769a
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/app/preboot/preboot.c b/app/preboot/preboot.c
index a0249e8..ac6c063 100644
--- a/app/preboot/preboot.c
+++ b/app/preboot/preboot.c
@@ -414,6 +414,7 @@
 	device_init_efuse();
 	device_init_uart();
 	device_init_pci();
+	device_init_i2c_s();
 }
 
 __weak void hl_set_reset_cause(uint32_t reset_cause) {}
