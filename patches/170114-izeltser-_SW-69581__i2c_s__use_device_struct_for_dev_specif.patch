 extern struct device_efuse efuse;
 extern struct device_uart uart;
 extern struct device_pci pci;
+extern struct device_i2c_s i2c_s;
 
 void device_init_efuse(void);
 void device_init_uart(void);
 void device_init_pci(void);
+void device_init_i2c_s(void);
diff --git a/lib/common/module_i2c_slave.c b/lib/common/module_i2c_slave.c
index 4cfef5f..543193c 100644
--- a/lib/common/module_i2c_slave.c
+++ b/lib/common/module_i2c_slave.c
@@ -8,9 +8,8 @@
 #include <stdint.h>
 #include <stddef.h>
 #include <psoc_global_conf_regs.h>
-#include <psoc_i2c_s_regs.h>
-#include <psoc_i2c_s_masks.h>
 #include <preboot.h>
+#include <device.h>
 #include <hl_fw_if.h> /* requires preboot.h for __packed */
 #include <preboot/thermal.h>
 #include <hl_i2c_slave_events.h>
@@ -42,6 +41,8 @@
 	struct i2cslave_buf buf;
 };
 
+struct device_i2c_s i2c_s;
+
 static struct i2cslave_data i2cs_data;
 
 static void i2cslave_reset_buffer(struct i2cslave_buf *buf)
@@ -56,16 +57,16 @@
 static void i2cslave_init(bool debug_mode)
 {
 	/* Check if already enabled */
-	if (regmap_readl(mmPSOC_I2C_S_IC_ENABLE)) {
+	if (regmap_readl(i2c_s.enable_reg)) {
 		preboot_puts("I2C SLAVE already initialized\n");
 		return;
 	}
 
 	if (debug_mode) {
-		regmap_writel(I2C_SLAVE_ADDRESS_DBG, mmPSOC_I2C_S_IC_SAR);
+		regmap_writel(I2C_SLAVE_ADDRESS_DBG, i2c_s.sar_reg);
 	} else {
 		/* Program IC_SAR with address to which slave responds */
-		regmap_writel(I2C_SLAVE_ADDRESS, mmPSOC_I2C_S_IC_SAR);
+		regmap_writel(I2C_SLAVE_ADDRESS, i2c_s.sar_reg);
 
 		/* Enable I2C Slave */
 		regmap_writel(0x1, mmPSOC_GLOBAL_CONF_I2C_SLV);
@@ -75,20 +76,30 @@
 	}
 
 	/* Program IC_CON */
-	regmap_writel(0x22, mmPSOC_I2C_S_IC_CON);
+	regmap_writel(0x22, i2c_s.con_reg);
 
 	/* Set INTR mask to default */
-	regmap_writel(I2C_SLAVE_DEFAULT_INTR_MASK, mmPSOC_I2C_S_IC_INTR_MASK);
+	regmap_writel(I2C_SLAVE_DEFAULT_INTR_MASK, i2c_s.intr_mask_reg);
 
 	/* Write to IC_RX_TL to set Rx FIFO threshold level */
-	regmap_writel(0x0, mmPSOC_I2C_S_IC_RX_TL);
+	regmap_writel(0x0, i2c_s.rx_tl_reg);
 
 	/* Write to IC_TX_TL to set Tx FIFO threshold level */
-	regmap_writel(0x7, mmPSOC_I2C_S_IC_TX_TL);
+	regmap_writel(0x7, i2c_s.tx_tl_reg);
 
 	/* Write 1 to IC_ENABLE to enable DW_apb_i2c */
-	regmap_writel(0x1, mmPSOC_I2C_S_IC_ENABLE);
+	regmap_writel(0x1, i2c_s.enable_reg);
 }
+
+#define PSOC_I2C_S_IC_INTR_STAT_R_RX_UNDER_MASK		0x1
+#define PSOC_I2C_S_IC_INTR_STAT_R_RX_OVER_MASK		0x2
+#define PSOC_I2C_S_IC_INTR_STAT_R_TX_OVER_MASK		0x8
+#define PSOC_I2C_S_IC_INTR_STAT_R_TX_ABRT_MASK		0x40
+#define PSOC_I2C_S_IC_INTR_STAT_R_RX_DONE_MASK		0x80
+#define PSOC_I2C_S_IC_INTR_STAT_R_ACTIVITY_MASK		0x100
+#define PSOC_I2C_S_IC_INTR_STAT_R_STOP_DET_MASK		0x200
+#define PSOC_I2C_S_IC_INTR_STAT_R_START_DET_MASK	0x400
+#define PSOC_I2C_S_IC_INTR_STAT_R_GEN_CALL_MASK		0x800
 
 static u32 i2cslave_dw_read_clear_intrbits_slave(void)
 {
@@ -106,7 +117,7 @@
 	 *
 	 * The raw version might be useful for debugging purposes.
 	 */
-	stat = regmap_readl(mmPSOC_I2C_S_IC_INTR_STAT);
+	stat = regmap_readl(i2c_s.intr_stat_reg);
 
 	/*
 	 * Do not use the IC_CLR_INTR register to clear interrupts, or
@@ -116,30 +127,33 @@
 	 * Instead, use the separately-prepared IC_CLR_* registers.
 	 */
 	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_TX_ABRT_MASK)
-		regmap_readl(mmPSOC_I2C_S_IC_CLR_TX_ABRT);
+		regmap_readl(i2c_s.clr_tx_abrt_reg);
 	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_RX_UNDER_MASK)
-		regmap_readl(mmPSOC_I2C_S_IC_CLR_RX_UNDER);
+		regmap_readl(i2c_s.clr_rx_under_reg);
 	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_RX_OVER_MASK)
-		regmap_readl(mmPSOC_I2C_S_IC_CLR_RX_OVER);
+		regmap_readl(i2c_s.clr_rx_over_reg);
 	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_TX_OVER_MASK)
-		regmap_readl(mmPSOC_I2C_S_IC_CLR_TX_OVER);
+		regmap_readl(i2c_s.clr_tx_over_reg);
 	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_RX_DONE_MASK)
-		regmap_readl(mmPSOC_I2C_S_IC_CLR_RX_DONE);
+		regmap_readl(i2c_s.clr_rx_done_reg);
 	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_ACTIVITY_MASK)
-		regmap_readl(mmPSOC_I2C_S_IC_CLR_ACTIVITY);
+		regmap_readl(i2c_s.clr_activity_reg);
 	if (stat & PSOC_I2C_S_IC_INTR_STAT_R_STOP_DET_MASK)
-		regmap_readl(mmPSOC_I2C_S_IC_CLR_STOP_DET);
+		regmap_readl(i2c_s.clr_stop_det_reg);
