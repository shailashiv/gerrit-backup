 };
 
+struct device_i2c_s {
+	u32 enable_reg;
+	u32 sar_reg;
+	u32 con_reg;
+	u32 intr_mask_reg;
+	u32 intr_stat_reg;
+	u32 rx_tl_reg;
+	u32 tx_tl_reg;
+	u32 data_cmd_reg;
+	u32 clr_tx_abrt_reg;
+	u32 clr_rx_under_reg;
+	u32 clr_rx_over_reg;
+	u32 clr_tx_over_reg;
+	u32 clr_rx_done_reg;
+	u32 clr_activity_reg;
+	u32 clr_stop_det_reg;
+	u32 clr_start_det_reg;
+	u32 clr_gen_call_reg;
+	u32 clr_rd_req_reg;
+	u32 clr_intr_reg;
+	u32 rxflr_reg;
+};
