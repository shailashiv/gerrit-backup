From 256dcf0e8669e4fa30c516b54413c7b2920d069a Mon Sep 17 00:00:00 2001
From: Noam Lessner <nlessner@habana.ai>
Date: Sat, 08 Feb 2020 20:33:56 +0200
Subject: [PATCH] [SW-8229] goya2: remove u32 typedef

replace u32 typedef with uint32_t so we use standard library

Change-Id: Ibe8c725f7c474aa1ccc2bb6107df60866faf36dd
Signed-off-by: Noam Lessner <nlessner@habana.ai>
---

diff --git a/common/efuse.c b/common/efuse.c
index 412dac1..87dc1aa 100644
--- a/common/efuse.c
+++ b/common/efuse.c
@@ -22,7 +22,7 @@
  * each half is bank of FUSE_WORDS_PER_BANK words
  * NOTE: bank1 is a complete duplication of bank0
  */
-int fuse_read(u32 word, u32 *val)
+int fuse_read(uint32_t word, uint32_t *val)
 {
 	int offset;
 	static uint16_t i = EFUSE_NOT_READ;
@@ -45,11 +45,11 @@
 		return -2;
 
 	/* read value from bank0 */
-	offset = (word * sizeof(u32));
+	offset = (word * sizeof(uint32_t));
 	*val = regmap_readl(mmPSOC_EFUSE_DATA_0 + offset);
 
 	/* read value from bank1 and OR with value from bank0 */
-	offset = ((FUSE_WORDS_PER_BANK + word) * sizeof(u32));
+	offset = ((FUSE_WORDS_PER_BANK + word) * sizeof(uint32_t));
 	*val |= regmap_readl(mmPSOC_EFUSE_DATA_0 + offset);
 
 	return 0;
diff --git a/common/efuse.h b/common/efuse.h
index 4391e0e..0a7b77e 100644
--- a/common/efuse.h
+++ b/common/efuse.h
@@ -28,7 +28,7 @@
 #define EFUSE_SYSCFG_REVOKE_KEY_LOCATION	0
 #define EFUSE_SYSCFG_REVOKE_KEY_MASK		0x1F
 
-int fuse_read(u32 word, u32 *val);
+int fuse_read(uint32_t word, uint32_t *val);
 uint8_t efuse_otp_get_fw_version_security(void);
 void efuse_get_hash(uint32_t *key_hash);
 
diff --git a/common/secureboot.c b/common/secureboot.c
index 01e66f4..e1e16d9 100644
--- a/common/secureboot.c
+++ b/common/secureboot.c
@@ -45,7 +45,7 @@
 					  test_phase0b_data_len;
 	unsigned char *test_public_key = test_phase0b_sig -
 					 test_public_key_len;
-	uint32_t fw_version = base_readl((u32)test_phase0b_data);
+	uint32_t fw_version = base_readl((uint32_t)test_phase0b_data);
 	if ((arcboot_rom_global.config_fuse &
 	     EFUSE_SYSCFG_ENABLE_VALIDATION_MASK) == 0) {
 		return SECUREBOOT_VERIFY_SUCCESS;
diff --git a/common/spi_flash.c b/common/spi_flash.c
index 6905631..1f092e6 100644
--- a/common/spi_flash.c
+++ b/common/spi_flash.c
@@ -28,15 +28,15 @@
 		      mmPSOC_GLOBAL_CONF_SPI_DIRECT_WR_RD_CTRL);
 }
 
-u32 spi_flash_readl(u32 offset)
+uint32_t spi_flash_readl(uint32_t offset)
 {
 	spi_flash_set_byte_swap(ENABLE_BYTE_SWAP);
-	u32 reg = base_readl(HL_FLASH_BASE + offset);
+	uint32_t reg = base_readl(HL_FLASH_BASE + offset);
 
 	return reg;
 }
 
-void spi_flash_writel(u32 val, u32 offset)
+void spi_flash_writel(uint32_t val, uint32_t offset)
 {
 	spi_flash_set_byte_swap(ENABLE_BYTE_SWAP);
 	base_writel(val, HL_FLASH_BASE + offset);
diff --git a/common/spi_flash.h b/common/spi_flash.h
index 95848a8..9f87022 100644
--- a/common/spi_flash.h
+++ b/common/spi_flash.h
@@ -52,8 +52,8 @@
 #define FLASH_EFUSE_KEYS_REVOKE_OFFSET	176
 
 void spi_flash_set_byte_swap(uint8_t enable);
-u32 spi_flash_readl(u32 offset);
-void spi_flash_writel(u32 val, u32 offset);
+uint32_t spi_flash_readl(uint32_t offset);
+void spi_flash_writel(uint32_t val, uint32_t offset);
 void spi_flash_get_revoke(uint32_t *key_revoke);
 void spi_flash_get_hash(uint32_t *key_hash);
 uint8_t spi_flash_get_fw_version_security(void);
diff --git a/include/arcboot.h b/include/arcboot.h
index 6c054a6..71cba7b 100644
--- a/include/arcboot.h
+++ b/include/arcboot.h
@@ -64,49 +64,45 @@
 	SPI_FLASH
 };
 
-typedef unsigned char u8;
-typedef unsigned long int u32;
-typedef unsigned long long u64;
-
-static inline void base_writel(u32 val, u32 offset)
+static inline void base_writel(uint32_t val, uint32_t offset)
 {
-	*((volatile u32 *)(offset)) = val;
+	*((volatile uint32_t *)(offset)) = val;
 }
 
-static inline u32 base_readl(u32 offset)
+static inline uint32_t base_readl(uint32_t offset)
 {
-	u32 reg = *((volatile u32 *)(offset));
+	uint32_t reg = *((volatile uint32_t *)(offset));
 
 	return reg;
 }
 
-static inline u32 regmap_readl(u32 offset)
+static inline uint32_t regmap_readl(uint32_t offset)
 {
-	u32 reg = base_readl(HL_CFG_BASE + offset);
+	uint32_t reg = base_readl(HL_CFG_BASE + offset);
 
 	return reg;
 }
 
-static inline void regmap_writel(u32 val, u32 offset)
+static inline void regmap_writel(uint32_t val, uint32_t offset)
 {
 	base_writel(val, HL_CFG_BASE + offset);
 }
 
-static inline u32 rom_readl(u32 offset)
+static inline uint32_t rom_readl(uint32_t offset)
 {
-	u32 reg = base_readl(HL_SBROM_BASE + offset);
+	uint32_t reg = base_readl(HL_SBROM_BASE + offset);
 
 	return reg;
 }
 
-static inline u32 fw_sram_readl(u32 offset)
+static inline uint32_t fw_sram_readl(uint32_t offset)
 {
-	u32 reg = base_readl(HL_FWSRAM_BASE + offset);
+	uint32_t reg = base_readl(HL_FWSRAM_BASE + offset);
 
 	return reg;
 }
 
-static inline void fw_sram_writel(u32 val, u32 offset)
+static inline void fw_sram_writel(uint32_t val, uint32_t offset)
 {
 	base_writel(val, HL_FWSRAM_BASE + offset);
 }
