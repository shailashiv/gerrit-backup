 function hl_print_elf_sections_csv {
 	local app=$1
 
 	echo "name,size,address"
-	arc-linux-objdump -h ${BINARIES_DIR}/zephyr_${app}.elf | \
+	arc-linux-objdump -h ${ELFS_DIR}/zephyr_${app}.elf | \
 		awk '/^[ \t]+[0-9]+ [^.]/ { printf("%s,0x%s,0x%s\n", $2, $3, $4);}'
 }
 
@@ -186,18 +186,20 @@
 }
 
 function hl_pldm_hex {
-	NAME=$(echo "$1" | cut -f 1 -d '.')
-	FILE=$2
-	BYTES_PER_LINE=$3
+	local NAME=$(echo "$1" | cut -f 1 -d '.')
+	local FILE=$2
+	local BYTES_PER_LINE=$3
+	local DESTDIR=$4
 	# pad file to 128bit (16Byte) as pladium emulates 128bit memory, so xxd wont trunc lines
 	dd status=none conv=sync bs=16 if=${FILE} > ${FILE}.tmp
-	xxd -e -g ${BYTES_PER_LINE} ${FILE}.tmp | xxd -r | xxd -ps -c${BYTES_PER_LINE} > ${DEV_PREFIX}-${HL_TARGET}-${NAME}.hex
+	xxd -e -g ${BYTES_PER_LINE} ${FILE}.tmp | xxd -r | xxd -ps -c${BYTES_PER_LINE} > ${DESTDIR}/${DEV_PREFIX}-${HL_TARGET}-${NAME}.hex
 	rm ${FILE}.tmp
 }
 
 function hl_pldm_flash_hex {
-	NAME=$(echo "$1" | cut -f 1 -d '.')
-	FILE=$2
+	local NAME=$(echo "$1" | cut -f 1 -d '.')
+	local FILE=$2
+	local DESTDIR=$3
 	# save hex as a 1 byte list of values
-	xxd -e -g 4 ${FILE} | xxd -r | xxd -ps -c1			> ${DEV_PREFIX}-${HL_TARGET}-${NAME}.hex
+	xxd -e -g 4 ${FILE} | xxd -r | xxd -ps -c1 > ${DESTDIR}/${DEV_PREFIX}-${HL_TARGET}-${NAME}.hex
 }
