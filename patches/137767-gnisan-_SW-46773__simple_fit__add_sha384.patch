From e6b5191d1c9194f793cb33daf5add8b688587ffd Mon Sep 17 00:00:00 2001
From: Guy Nisan <gnisan@habana.ai>
Date: Mon, 18 Oct 2021 08:52:43 +0300
Subject: [PATCH] [SW-46773] simple fit: add sha384

Add sha384, used by Gaudi2 as hash algo.

Change-Id: Ibcdfd9547c374b93450b7bd13a8ef920f48a31b2
Signed-off-by: Guy Nisan <gnisan@habana.ai>
---

diff --git a/board/habanalabs/common/create-simple.sh b/board/habanalabs/common/create-simple.sh
index 04e474b..ad118df 100755
--- a/board/habanalabs/common/create-simple.sh
+++ b/board/habanalabs/common/create-simple.sh
@@ -1,7 +1,7 @@
 #!/usr/bin/env bash
 
-if [ $# -lt 4 ]; then
-	echo "Usage $0 <load type enum> <conf name> <use-elbi> <use-fw-loader>" >&2
+if [ $# -lt 6 ]; then
+	echo "Usage $0 <load type enum> <conf name> <use-elbi> <use-fwupdate> <use-fw-loader> <sha256/sha384>" >&2
 	exit 1
 fi
 
@@ -10,6 +10,7 @@
 USE_ELBI=${3}
 USE_FWUPDATE=${4}
 LOAD_BOOTLOADER=${5}
+HASH=${6}
 LOAD_TYPE_NAME=FIT_LOAD_TYPE_${1^^} # Upper case
 LOAD_TYPE_NUMBER=$(grep ${LOAD_TYPE_NAME} ${SPECS_EMBEDDED_DIR}/fit_load_type.h | sed 's/.* = \(.*\),/\1/')
 
@@ -43,5 +44,6 @@
 ITS_SED_PARAMS+="s/@USE_ELBI@/${USE_ELBI}/g;";
 ITS_SED_PARAMS+="s/@USE_FWUPDATE@/${USE_FWUPDATE}/g;";
 ITS_SED_PARAMS+="s/@LOAD_BOOTLOADER@/${LOAD_BOOTLOADER}/g;";
+ITS_SED_PARAMS+="s/@HL_HASH@/${HASH}/g;";
 sed ${ITS_SED_PARAMS} ${SIMPLE_ITS_TEMPLATE} > ${SIMPLE_ITS_FILE}
 $MKIMAGE_FILE -D "-W no-unit_address_vs_reg" -f ${SIMPLE_ITS_FILE} -k ${KEYS_DIR} ${SIMPLE_ITB_FILE}
diff --git a/board/habanalabs/common/load-simple.its b/board/habanalabs/common/load-simple.its
index ef774a8..dc11154 100644
--- a/board/habanalabs/common/load-simple.its
+++ b/board/habanalabs/common/load-simple.its
@@ -17,7 +17,7 @@
 			type = "standalone";
 			compression = "none";
 			hash {
-				algo = "sha256";
+				algo = "@HL_HASH@";
 			};
 		};
 	};
@@ -34,7 +34,7 @@
 			@USE_ELBI@;
 			@USE_FWUPDATE@;
 			signature {
-				algo = "sha256,rsa3072";
+				algo = "@HL_HASH@,rsa3072";
 				key-name-hint = "hl_rsa3072";
 				/* Signing fit requires at least one image */ 
 				sign-images = "pub-key";
