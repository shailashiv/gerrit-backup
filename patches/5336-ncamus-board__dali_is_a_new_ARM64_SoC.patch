+
+BOARD_BASE=${BR2_EXTERNAL_HL_DALI_PATH}/board/habanalabs/dali
+SPL_BINFILE=${SPL_BINFILE:-u-boot-spl.bin}
+UBOOT_CMDFILE=${UBOOT_CMDFILE:-${BOARD_BASE}/uboot-eeprom.cmd}
+UBOOT_FITFILE=u-boot.itb
+UBOOT_ITSFILE=${UBOOT_ITSFILE:-${BOARD_BASE}/dali_fit_spl.its}
+UBOOT_BINFILE=${UBOOT_BINFILE:-${UBOOT_FITFILE}}
+LINUX_FITFILE=fit.itb
+
+pushd ${BINARIES_DIR}
+	cp ${BOARD_BASE}/dali_${DALI_TARGET}.its .
+	cp ${BASE_DIR}/build/linux-custom/arch/arm64/boot/Image .
+	${HOST_DIR}/usr/bin/mkimage -D "-W no-unit_address_vs_reg" -f dali_${DALI_TARGET}.its ${LINUX_FITFILE}
+
+	cp ${UBOOT_ITSFILE} dali_fit_spl.its
+	# In case ITSFILE points to locations under public directory /tools
+	ln -nfs /tools
+	# SPI IOMAP likes these to be 8B aligned in size
+	dd status=none conv=sync bs=8 if=${BASE_DIR}/build/uboot-custom/u-boot-nodtb.bin	 > u-boot-nodtb.bin
+	dd status=none conv=sync bs=8 if=${BASE_DIR}/build/uboot-custom/u-boot.dtb		 > u-boot.dtb
+	${HOST_DIR}/usr/bin/mkimage -f dali_fit_spl.its -E ${UBOOT_FITFILE}
+	${HOST_DIR}/usr/bin/mkimage -C none -A arm64 -T script -d ${UBOOT_CMDFILE} boot.scr
+
+	# KMD likes these to be 4B aligned in size
+	dd status=none conv=sync bs=4 if=${LINUX_FITFILE}					 > dali-fit.itb
+	dd status=none conv=sync bs=4 if=u-boot.bin						 > dali-u-boot.bin
+
+	### Construct bin file
+	# Primary U-Boot
+	dd status=none conv=sync bs=1M		if=${UBOOT_BINFILE}	 			 > dali-spi-flash.bin.nocrc
+	# Secondary U-Boot
+	dd status=none conv=sync bs=1M		if=${UBOOT_BINFILE}				>> dali-spi-flash.bin.nocrc
+	# U-Boot ENV
+	dd status=none conv=sync bs=64K		if=uboot-env.bin				>> dali-spi-flash.bin.nocrc
+	# U-Boot ENV Redundand
+	dd status=none conv=sync bs=64K		if=uboot-env.bin				>> dali-spi-flash.bin.nocrc
+
+	# Prepare checksum
+	CKSUM=`cksum dali-spi-flash.bin.nocrc | cut -d' ' -f1`
+	CKSUM_BE=`printf "%08x" ${CKSUM}`
+	CKSUM_LE=${CKSUM_BE:6:2}${CKSUM_BE:4:2}${CKSUM_BE:2:2}${CKSUM_BE:0:2}
+	echo ${CKSUM_LE} | xxd -p -r								 > dali-spi-flash.crc
+	dd status=none conv=sync bs=64K		if=dali-spi-flash.bin.nocrc			 > dali-spi-flash.bin
+	dd status=none conv=sync bs=4		if=dali-spi-flash.crc				>> dali-spi-flash.bin
+
+	# Convert bin file into Palladium hex format
+	xxd -p -c1 -g1				dali-spi-flash.bin	 			 > dali-spi-flash.hex
+popd
