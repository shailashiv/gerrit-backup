diff --git a/Makefile b/Makefile
new file mode 100644
index 0000000..3adfa42
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,83 @@
+.DEFAULT_GOAL := dali-help
+dali-help:
+	@echo 'Cleaning:'
+	@echo '  dali-distclean       - Delete all Dali files created by build'
+	@echo
+	@echo 'Build:'
+	@echo '  dali-<borad>-build   - Build for <board> e.g. onix, pldm, asic'
+	@echo '  optional environment variables:'
+	@echo '    SPL_BINFILE        - Alternative SPL binary <PATH>'
+	@echo '    UBOOT_ITSFILE      - Alternative ITS file <PATH>'
+	@echo '    UBOOT_BINFILE      - Alternative U-Boot binary <PATH>'
+	@echo '    UBOOT_CMDFILE      - Alternative U-Boot script <PATH>'
+	@echo
+	@echo 'Install:'
+	@echo '  optional environment variables:'
+	@echo '    PLDM_HEX_DIR       - Palladium directory to install flash image'
+	@echo '  dali-<board>-install - Install to <board> e.g. onix, pldm, asic'
+	@echo '                           set DALI_INSTALL_LAB_IP=<lab IP> to'
+	@echo '                             override <board> default lab IP'
+	@echo '                           set DALI_INSTALL_HOST_IP=<host IP> to'
+	@echo '                             override <board> default host IP'
+
+export BR2_EXTERNAL := $(CURDIR)
+OUTPUT_DIR := $(BR2_EXTERNAL)/output
+Makefile:;
+%:
+	@$(MAKE) -C ../buildroot O=$(OUTPUT_DIR) $@
+
+DALI_TARGET_FILE := $(OUTPUT_DIR)/.dali-target.mk
+ifneq ($(realpath $(DALI_TARGET_FILE)),)
+include $(DALI_TARGET_FILE)
+endif
+.PHONY: dali-onix-target dali-pldm-target dali-asic-target
+dali-onix-target dali-pldm-target dali-asic-target:
+	@echo "export DALI_TARGET=$(patsubst dali-%-target,%,$@)" > $(DALI_TARGET_FILE)
+
+$(OUTPUT_DIR)/.config: $(BR2_EXTERNAL)/configs/dali_defconfig
+	@$(MAKE) $(<F)
+
+.PHONY: dali-onix-build dali-pldm-build dali-asic-build
+dali-onix-build: dali-onix-target
+dali-pldm-build: dali-pldm-target
+dali-asic-build: dali-asic-target
+dali-onix-build dali-pldm-build dali-asic-build: $(OUTPUT_DIR)/.config
+	@$(MAKE) all
+
+IMAGES_DIR := ${OUTPUT_DIR}/images
+UBOOT_BASE := ${OUTPUT_DIR}/build/uboot-custom
+LINUX_BASE := ${OUTPUT_DIR}/build/linux-custom
+.PHONY: dali-onix-install dali-pldm-install dali-asic-install
+dali-onix-install: DALI_INSTALL_LAB_IP ?= monster4-nuc
+dali-onix-install: DALI_INSTALL_HOST_IP ?= monster4
+dali-pldm-install: DALI_INSTALL_LAB_IP ?= 192.168.10.45
+dali-pldm-install: DALI_INSTALL_HOST_IP ?= 192.168.10.45
+dali-asic-install: DALI_INSTALL_LAB_IP ?= 192.168.10.109
+dali-asic-install: DALI_INSTALL_HOST_IP ?= 192.168.10.114
+.PHONY: dali-install
+dali-install:
+	-sshpass -p123456        scp $(IMAGES_DIR)/dali-u-boot.bin	root@$(DALI_INSTALL_HOST_IP):/lib/firmware/habanalabs/dali/
+	-sshpass -p123456        scp $(IMAGES_DIR)/dali-fit.itb		root@$(DALI_INSTALL_HOST_IP):/lib/firmware/habanalabs/dali/
+	-sshpass -p123456        scp $(IMAGES_DIR)/dali-spi-flash.bin	root@$(DALI_INSTALL_HOST_IP):/lib/firmware/habanalabs/dali/
+	-sshpass -p123456        scp $(IMAGES_DIR)/dali-u-boot.bin	root@$(DALI_INSTALL_LAB_IP):/lib/firmware/habanalabs/dali/
+	-sshpass -p123456        scp $(IMAGES_DIR)/dali-u-boot-spl.bin	root@$(DALI_INSTALL_LAB_IP):/lib/firmware/habanalabs/dali/
+	-sshpass -p123456        scp $(IMAGES_DIR)/dali-fit.itb		root@$(DALI_INSTALL_LAB_IP):/var/lib/tftpboot/
+	-sshpass -p123456        scp $(IMAGES_DIR)/boot.scr		root@$(DALI_INSTALL_LAB_IP):/var/lib/tftpboot/tests/
+	-sshpass -p123456        scp $(IMAGES_DIR)/dali-spi-flash.bin	root@$(DALI_INSTALL_LAB_IP):/lib/firmware/habanalabs/dali/
+	-sshpass -p123456        scp $(UBOOT_BASE)/u-boot		root@$(DALI_INSTALL_LAB_IP):/lib/firmware/habanalabs/dali/
+	-sshpass -p123456        scp $(LINUX_BASE)/vmlinux		root@$(DALI_INSTALL_LAB_IP):/lib/firmware/habanalabs/dali/
+dali-onix-install dali-pldm-install dali-asic-install: dali-install
+dali-onix-install:
+	@
+PLDM_HEX_DIR ?= $(IMAGES_DIR)/tools/hl_shared_dir/pldm
+${PLDM_HEX_DIR}:
+	@mkdir -p $@
+dali-pldm-install: ${PLDM_HEX_DIR}
+	-cp $(IMAGES_DIR)/dali-spi-flash.hex $</
+dali-asic-install:
+	@
+
+.PHONY: dali-distclean
+dali-distclean: $(OUTPUT_DIR)/.config
+	@$(MAKE) uboot-dirclean linux-dirclean armcp-dirclean	\
+		 spdlog-dirclean specs-dirclean specs_external-dirclean
diff --git a/board/habanalabs/common/ip_pdu b/board/habanalabs/common/ip_pdu
new file mode 100755
index 0000000..10f0d05
--- /dev/null
+++ b/board/habanalabs/common/ip_pdu
@@ -0,0 +1,54 @@
+#!/bin/bash
+
+pdu_uri=http://192.168.10.80
+pdu_cred="--user=snmp --password=1234"
+
+if [ $# -eq 2 ]; then
+	board=$1
+	action=$2
+else
+	echo "error - usage: $0 <board name> <-l | on | off>"
+	exit 1
+fi
+
+case "$board" in
+*onix)
+	pwr_id=1
+	;;
+*)
+	echo "error - Unknown board name: $board"
+	exit 2
+	;;
+esac
+
+get_id=`echo $((10+pwr_id))`
+set_id=`for i in $(seq $((pwr_id-1))); do echo -n 0; done; echo -n 1`
+case "$action" in
+-l)
+	status=`wget -q -O - $pdu_cred ${pdu_uri}/status.xml | grep pot0 | cut -d, -f$get_id`
+	case "$status" in
+	0)
+		echo off
+		;;
+	1)
+		echo ON
+		;;
+	*)
+		echo "error - Unknown state: $status"
+		exit 3
+		;;
+	esac
+	;;
+on | off)
+	wget -q -O - $pdu_cred ${pdu_uri}/${action}s.cgi?led=$set_id
+	status=3 # D_ON=2/D_OFF=3
+	while [ $status -gt 1 ]; do
+		sleep 1
+		status=`wget -q -O - $pdu_cred ${pdu_uri}/status.xml | grep pot0 | cut -d, -f$get_id`
+	done
+	;;
+*)
+	echo "error - Unknown action: $action"
+	exit 4
+	;;
+esac
