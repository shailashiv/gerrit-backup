From 1c4d9ed404477e164c2794e3b11c01e4c7a2694e Mon Sep 17 00:00:00 2001
From: Pardha Saradhi Kesapragada <pkesapragada@habana.ai>
Date: Thu, 18 Feb 2021 08:27:57 +0200
Subject: [PATCH] Revert "[SW-20154] make: compile libraries based on device"

This reverts commit fc91be029353e7f7743c938863e2ee69c507b275.

Change-Id: I4f6bb91bfcdb68c8c64cb3849939578c58cca006
---

diff --git a/Makefile b/Makefile
index 12283c7..2cade4d 100644
--- a/Makefile
+++ b/Makefile
@@ -30,7 +30,7 @@
 
 ifneq ($(CROSS_COMPILE),)
 LDFLAGS = -flto
-LDFLAGS += -L $(LIBDIR) -L $(HL_DEV)
+LDFLAGS += -L $(LIBDIR) -lsb -lellipsys -L $(HL_DEV)
 LDFLAGS += -T $(HL_DEV)/$(HL_TARGET)_$@.lds
 LDFLAGS += -nostartfiles
 LDFLAGS += -Wl,-e__start
@@ -54,11 +54,15 @@
 ARCBOOT_ROM_OBJECTS := $(ARCBOOT_COMMON_SRCS_C:.c=.o) $(ARCBOOT_ROM_SRCS_C:.c=.o) $(ARCBOOT_ROM_SRCS_S:.S=.o)
 endif
 
-.PHONY: all
-all:
+.PHONY: all libsb libellipsys sbtool
+all: libsb libellipsys
 	@$(MAKE) arcboot_rom.bin
 	@$(MAKE) arcboot_ram.bin
 
+libsb libellipsys:
+	@+$(MAKE) -C sdk $@ SB_SIGN_MODE=rsa_fixed > /dev/null
+sbtool:
+	@$(MAKE) -C sdk $@ > /dev/null
 %.bin: %
 	@$(OBJCOPY) -O binary -R .note.gnu.build-id -R .test* $< $@
 
diff --git a/goya2_arc/Makefile b/goya2_arc/Makefile
index 9e1a702..e69de29 100644
--- a/goya2_arc/Makefile
+++ b/goya2_arc/Makefile
@@ -1,9 +0,0 @@
-LDFLAGS += -lsb -lellipsys
-
-.PHONY: libsb libellipsys sbtool
-all: libsb libellipsys
-
-libsb libellipsys:
-	@+$(MAKE) -C sdk $@ SB_SIGN_MODE=rsa_fixed > /dev/null
-sbtool:
-	@$(MAKE) -C sdk $@ > /dev/null
