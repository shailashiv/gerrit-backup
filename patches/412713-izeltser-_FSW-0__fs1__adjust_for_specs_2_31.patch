From 007b8739ff910976649de908d548a773900867d3 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Wed, 24 Apr 2024 14:24:52 +0300
Subject: [PATCH] [FSW-0] fs1: adjust for specs 2.31

Adjust register for VLSI tag 2.31

Change-Id: Ic2fddf22abfe6ea60bf2a7f1aa0ac5d6d3105a7f
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/arch/fs1/arc/common.c b/arch/fs1/arc/common.c
index 8d1c017..3cfe74b 100644
--- a/arch/fs1/arc/common.c
+++ b/arch/fs1/arc/common.c
@@ -28,6 +28,7 @@
 #include <parc_global_conf_masks.h>
 #include <mem_copy_regs.h>
 #include <mem_copy_masks.h>
+#include <pcie_flr_regs.h>
 #include <fs1_blocks_linux_driver.h>
 #include <fs1_security.h>
 
@@ -102,12 +103,14 @@
 				  mmPCIE_DBI_UNCORR_ERR_MASK_OFF;
 	pci.aux_dbi_reg = mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_DBI;
 	pci.aux_mem_space_en_reg = mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_MEM_SPACE_EN;
-	pci.aux_flr_ctrl_reg = mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_FLR_CTRL;
+	pci.aux_flr_ctrl_reg = mmIO_0_CFG_HALF_0_CXL_EP_PCIE_FLR_BASE + mmPCIE_FLR_FLR_CONTROL;
 	pci.aux_ltssm_en_reg = mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_LTSSM_EN;
-	pci.aux_pf_flr_active_reg = mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE +
-				    mmPCIE_AUX_PF_FLR_ACTIVE;
-	pci.aux_flr_int_reg = mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_FLR_INT;
-	pci.aux_pf_flr_done_reg = mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_PF_FLR_DONE;
+	pci.aux_pf_flr_active_reg = mmIO_0_CFG_HALF_0_CXL_EP_PCIE_FLR_BASE +
+				    mmPCIE_FLR_CFG_FLR_PF_ACTIVE;
+	pci.aux_flr_int_reg = mmIO_0_CFG_HALF_0_CXL_EP_PCIE_FLR_BASE +
+			      mmPCIE_FLR_INTR_SPI_CAUSE_CFG_FLR_PF_ACTIVE;
+	pci.aux_pf_flr_done_reg = mmIO_0_CFG_HALF_0_CXL_EP_PCIE_FLR_BASE +
+				  mmPCIE_FLR_APP_FLR_PF_DONE;
 	pci.aux_rdlh_link_up_reg = mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_RDLH_LINK_UP;
 	pci.aux_smlh_link_up_reg = mmIO_0_CFG_HALF_0_CXL_EP_PCIE_AUX_BASE + mmPCIE_AUX_SMLH_LINK_UP;
 	pci.core_hot_rst_reg = mmIO_0_CFG_HALF_0_CXL_EP_PCIE_CORE_BASE + mmPCIE_CORE_HOT_RST;
