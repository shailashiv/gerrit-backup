+}
+
 #define ALIGN_TO_16_BYTES(addr) (((addr) + 15) & ~0xF)
 #define PPBOOT_LAST_ADDR ((uint32_t) (&__SDATA_LOAD))
 
@@ -555,5 +561,5 @@
 		    (uint32_t)PHY_FW_SIZE, false);
 
