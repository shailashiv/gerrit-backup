diff --git a/arch/gaudi3/arc/recovery.c b/arch/gaudi3/arc/recovery.c
index a27ae62..503de38 100644
--- a/arch/gaudi3/arc/recovery.c
+++ b/arch/gaudi3/arc/recovery.c
@@ -188,6 +188,16 @@
 	 */
 	arcboot_rom_d2d_phy_wd_hw_errata_fix();
 
+	/* Die 0 and Die 1 sync for d2d */
+	if (!arcboot_rom_global.die_id) {
+		/* Indicate slave die that d2d init has started */
+		arcboot_rom_notify_slave();
+	} else {
+		arcboot_rom_detect_signal_on_slave();
+	}
+	/* Inter die indication for d2d link init handshaking */
+	arcboot_rom_status_update(PROGRESS_ARCBOOT_ROM_D2D_LINK_INTER_DIE_SYNC);
+
 	/* Set START bit for D2D link initialization */
 	regmap_writel(D0_PSOC_GLOBAL_CONF_DPHY_FSM_CTRL_START_M, mmD0_PSOC_GLOBAL_CONF_DPHY_FSM_CTRL);
 
diff --git a/arch/gaudi3/arc/slave.c b/arch/gaudi3/arc/slave.c
index 095e8ef..6118f15 100644
--- a/arch/gaudi3/arc/slave.c
+++ b/arch/gaudi3/arc/slave.c
@@ -24,20 +24,40 @@
 	regmap_writel(val, mmD0_PSOC_GLOBAL_CONF_DIE_RECOVERY_OUT);
 }
 
-void arcboot_rom_wait_for_signal(void)
+void arcboot_rom_detect_signal_on_slave(void)
 {
 	uint32_t val;
 
+	while (1) {
+		val = regmap_readl(mmD0_PSOC_GLOBAL_CONF_DIE_RECOVERY_IN);
+		if (val & D0_PSOC_GLOBAL_CONF_DIE_RECOVERY_IN_IND_M) {
+			break;
+		}
+	}
+	/*
+	* No timeout added for while(1) due to the usage of this function:
+	* 1) Recovery: It is required for slave to wait for this indication from
+	* master. As slave die in rom is to only execute recovery, it waits forever
+	* for this indication to be set, apart from recovery there is no logic to be
+	* executed on slave in ROM.
+	*
+	* 2) D2D link init: The pcie linkup time on master cannot be predicted, hence
+	* slave needs to wait. However the implication of this while(1) is minimal as
+	* d2d is the last process in the recovery flow which ends also in a while(1).
+	* Hence this would not have any functional impact.
+	*/
+}
+
+void arcboot_rom_wait_for_signal(void)
+{
 	if (!arcboot_rom_global.die_id)
 		return;
 
 	arcboot_rom_status_update(PROGRESS_SLV_DIE_WAITING_ON_RECOVERY_IND);
 
-	while (1) {
-		val = regmap_readl(mmD0_PSOC_GLOBAL_CONF_DIE_RECOVERY_IN);
-		if (val & D0_PSOC_GLOBAL_CONF_DIE_RECOVERY_IN_IND_M)
-			execute_recovery();
-	}
+	arcboot_rom_detect_signal_on_slave();
+
+	execute_recovery();
 }
 
 #define FUSE_EMULATION_DATA_UDELAY	5000 /* 5ms */
