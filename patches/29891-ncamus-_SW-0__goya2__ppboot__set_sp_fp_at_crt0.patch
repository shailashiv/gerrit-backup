From ede2b8a6bb102e06a96d459fbd1edfd258c7f6d2 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Sat, 14 Mar 2020 07:23:58 +0200
Subject: [PATCH] [SW-0] goya2: ppboot: set sp/fp at crt0

With this any push/pop will cause memory exception

Change-Id: I68b800aba9f48777f13569baac7948d096b262d8
---

diff --git a/app/crt0_ppboot.S b/app/crt0_ppboot.S
index b4bd0bb..c8d0d69 100644
--- a/app/crt0_ppboot.S
+++ b/app/crt0_ppboot.S
@@ -16,6 +16,9 @@
 /* lf2flt: to avoid compiler (buildroot wrapper) warning during linkage */
 .global	lf2flt
 lf2flt:
+
+	mov	sp, __stack_top
+	mov	fp, sp
 #endif
 
 #ifdef __aarch64__
