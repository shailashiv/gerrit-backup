From d6257eb008ed4d7b7d308816e9b0901a46b394ec Mon Sep 17 00:00:00 2001
From: Karthikeyan K <karthikk@habana.ai>
Date: Wed, 08 Dec 2021 12:21:40 +0200
Subject: [PATCH] [SW-63186] gaudi2: security: set axprot for pdma

Configure pdma as user level access using axprot registers.

Change-Id: I8209ab68a54a545edfa5614ce8d1f2185b9f5b10
---

diff --git a/arch/gaudi2/common/security.c b/arch/gaudi2/common/security.c
index 457e16a..15df4a5 100644
--- a/arch/gaudi2/common/security.c
+++ b/arch/gaudi2/common/security.c
@@ -50,6 +50,8 @@
 #include <dcore0_mme_ctrl_mstr_if_core_lbw_regs.h>
 #include <dcore0_edma0_mstr_if_core_hbw_regs.h>
 #include <dcore0_edma0_mstr_if_core_lbw_regs.h>
+#include <pdma0_mstr_if_core_hbw_regs.h>
+#include <pdma0_mstr_if_core_lbw_regs.h>
 
 /*
  * instances_num : Number of instances of RR to program.
@@ -216,6 +218,7 @@
 	AXPROT_TPC,
 	AXPROT_MME,
 	AXPROT_EDMA,
+	AXPROT_PDMA,
 };
 
 #define DCORE_DIST	0x200000
@@ -959,6 +962,10 @@
 #define EDMA_RTR_INST_DIST	0x10000
 #define EDMA_INST_NUM		NUM_OF_DCORES
 #define EDMA_INST_DIST		DCORE_DIST
+#define PDMA_RTR_INST_NUM	1
+#define PDMA_RTR_INST_DIST	0
+#define PDMA_INST_NUM		2
+#define PDMA_INST_DIST		0x10000
 
 static struct axprot_regs axprot_reg[] = {
 	[AXPROT_VDEC] = {
@@ -1008,6 +1015,14 @@
 		.dcore_num = EDMA_INST_NUM,
 		.inst_dist = EDMA_RTR_INST_DIST,
 		.inst_num = EDMA_RTR_INST_NUM,
+	},
+	[AXPROT_PDMA] = {
+		.base_reg = mmPDMA0_MSTR_IF_CORE_HBW_AXPROT_OVRD,
+		.value = AXPROT_USER_VAL,
+		.dcore_dist = PDMA_INST_DIST,
+		.dcore_num = PDMA_INST_NUM,
+		.inst_dist = PDMA_RTR_INST_DIST,
+		.inst_num = PDMA_RTR_INST_NUM,
 	},
 };
 
@@ -1134,6 +1149,19 @@
 	preboot_axprot_regs_init(AXPROT_EDMA);
 }
 
+static void preboot_secure_pdma(void)
+{
+
+	/* Configure pdma to user level */
+	/* HBW AXPROT */
+	preboot_axprot_regs_init(AXPROT_PDMA);
+
+	axprot_reg[AXPROT_PDMA].base_reg = mmPDMA0_MSTR_IF_CORE_LBW_AXPROT_OVRD;
+
+	/* LBW AXPROT */
+	preboot_axprot_regs_init(AXPROT_PDMA);
+}
+
 void preboot_security_init(void)
 {
 	preboot_secure_pcie();
@@ -1151,6 +1179,7 @@
 		preboot_secure_tpc();
 		preboot_secure_mme();
 		preboot_secure_edma();
+		preboot_secure_pdma();
 		preboot_secure_lbw();
 		preboot_secure_hbw();
 		preboot_puts("Security enabled.\n");
