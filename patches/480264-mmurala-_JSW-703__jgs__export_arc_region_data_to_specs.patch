new file mode 100644
index 0000000..f014dc3
--- /dev/null
+++ b/arch/fs1/arc/dev_manifest.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright 2025 Intel, Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#ifndef _DEV_BOOT_DESC_H_
+#define _DEV_BOOT_DESC_H_
+
+#include <fs1_blocks_linux_driver.h>
+#include <address_space.h>
+
+#define SPI_MANIFEST_IMG_0_FLASH_OFFSET		(0x0)
+/* manifest 0 boot pointers are DMA trans to MNG ARC ICCM at offset 0 */
+#define SPI_MANIFEST_IMG_0_ICCM_OFFSET		(0)
+#define SPI_MANIFEST_IMG_0_DMA_DEST			((IO_0_MNG_ARC_ICCM_BASE_FULL) + (SPI_MANIFEST_IMG_0_ICCM_OFFSET))
+/* 32Bit arc viewpoint address of manifest 0 stored in ICCM */
+#define SPI_MANIFEST_IMG_0_DMA_DEST_ARC		((IO_0_MNG_ARC_ICCM_BASE) + (SPI_MANIFEST_IMG_0_ICCM_OFFSET))
+
+
+#define SPI_MANIFEST_IMG_1_FLASH_OFFSET		(0x200000)
+/* manifest 1 boot pointers are DMA trans to MNG ARC ICCM at offset 64K */
+#define SPI_MANIFEST_IMG_1_ICCM_OFFSET		SZ_64K
+#define SPI_MANIFEST_IMG_1_DMA_DEST			((IO_0_MNG_ARC_ICCM_BASE_FULL) + (SPI_MANIFEST_IMG_1_ICCM_OFFSET))
+/* 32Bit arc viewpoint address of manifest 1 stored in ICCM */
+#define SPI_MANIFEST_IMG_1_DMA_DEST_ARC		((IO_0_MNG_ARC_ICCM_BASE) + (SPI_MANIFEST_IMG_1_ICCM_OFFSET))
+
+
+/* For Fake fuse manifest */
+#define SPI_MANIFEST_IMG_2_ICCM_OFFSET		SZ_128K
+#define SPI_MANIFEST_IMG_2_DMA_DEST			((IO_0_MNG_ARC_ICCM_BASE_FULL) + (SPI_MANIFEST_IMG_2_ICCM_OFFSET))
+/* 32Bit arc viewpoint address of manifest 2 stored in ICCM */
+#define SPI_MANIFEST_IMG_2_DMA_DEST_ARC		((IO_0_MNG_ARC_ICCM_BASE) + (SPI_MANIFEST_IMG_2_ICCM_OFFSET))
+
+#endif /* _DEV_BOOT_DESC_H_ */
