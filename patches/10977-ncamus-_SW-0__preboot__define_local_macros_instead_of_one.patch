From b30534292e80ce4907dc9a92bedd80395c6be777 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Mon, 08 Apr 2019 08:19:23 +0300
Subject: [PATCH] [SW-0] preboot: define local macros instead of ones from u-boot

This is another step for u-boot decoupling

Change-Id: I580c13b91612ca892dd705820100d9e257332957
---

diff --git a/common/preboot.c b/common/preboot.c
index 6825412..058ce0c 100644
--- a/common/preboot.c
+++ b/common/preboot.c
@@ -5,7 +5,6 @@
  * SPDX-License-Identifier:     GPL-2.0+
  */
 
-#include <common.h>
 #include <linux/io.h>
 #include "auto_generated.h"
 #include <stddef.h>
@@ -136,7 +135,7 @@
 			break;
 	}
 
-	regmap_writel((u32)(offset & ~CONFIG_SYS_SDRAM_BASE),
+	regmap_writel((u32)(offset & ~SDRAM_BASE),
 			mmPSOC_GLOBAL_CONF_SCRATCHPAD_28);
 }
 #else	/* TARGET_IS_TESTER */
@@ -145,7 +144,7 @@
 
 void preboot_main(void)
 {
-	void (*spl_start)(void) = (void *)CONFIG_SPL_TEXT_BASE;
+	void (*spl_start)(void) = (void *)SPL_TEXT_BASE;
 
 	regmap_writel(CPU_BOOT_STATUS_IN_PREBOOT, get_cpu_boot_status_reg());
 
diff --git a/common/preboot.h b/common/preboot.h
index 474c1ad..1951262 100644
--- a/common/preboot.h
+++ b/common/preboot.h
@@ -8,8 +8,17 @@
 #ifndef COMMON_PREBOOT_H_
 #define COMMON_PREBOOT_H_
 
+#define BIT(nr)					(1 << (nr))
+#define ARRAY_SIZE(x)				(sizeof(x) / sizeof((x)[0]))
+
 #define HL_SPI_BASE				0x7FF8000000ull
 #define HL_CFG_BASE				0x7FFC000000ull
+#define SDRAM_BASE				0x7ff0000000ull
+#define SPL_TEXT_BASE				0x7ff0080000ull
+
+typedef unsigned char u8;
+typedef unsigned int u32;
+typedef unsigned long long u64;
 
 static inline u8 regmap_readb(u64 offset)
 {
diff --git a/common/spi.c b/common/spi.c
index 7164a6b..e72020a 100644
--- a/common/spi.c
+++ b/common/spi.c
@@ -8,7 +8,6 @@
 #include <config.h>
 #include <linux/io.h>
 #include <linux/sizes.h>
-#include <linux/bitops.h>
 
 #include <psoc_gpio3_regs.h>
 #include <psoc_spi_regs.h>
@@ -17,7 +16,7 @@
 #include "spi.h"
 #include "uart.h"
 
-#define SPL_SIZE			SZ_64K
+#define SPL_SIZE			0x10000		/* 64KB */
 #define CMD_WRITE_STATUS		0x01
 #define CMD_READ			0x03
 #define CMD_WRITE_DISABLE		0x04
@@ -190,7 +189,7 @@
 
 static void spi_read_spl(unsigned int offset)
 {
-	void *dst = (void *)CONFIG_SPL_TEXT_BASE;
+	void *dst = (void *)SPL_TEXT_BASE;
 	unsigned int cmd = (CMD_READ << 24) | offset;
 	int i;
 
diff --git a/goya/goya.c b/goya/goya.c
index a2fd6f5..db60bab 100644
--- a/goya/goya.c
+++ b/goya/goya.c
@@ -5,7 +5,6 @@
  * SPDX-License-Identifier:     GPL-2.0+
  */
 
-#include <common.h>
 #include <linux/io.h>
 
 #include <pcie_phy_regs.h>
diff --git a/goya/pll.c b/goya/pll.c
index 3bacfc6..11b6a71 100644
--- a/goya/pll.c
+++ b/goya/pll.c
@@ -1,4 +1,3 @@
-#include <common.h>
 #include <command.h>
 #include <linux/delay.h>
 #include <linux/io.h>
