From 661e6bc6d8f1058660456b4b538227da7936c5e6 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Mon, 24 Feb 2020 06:48:21 +0200
Subject: [PATCH] [SW-0] goya2: swap btl image in post image script

In Goya2 flash endianess is little

Change-Id: I83276c11a1f86ab4967ed767b179fec7dfba594a
---

diff --git a/board/habanalabs/common/post-image-spi.sh b/board/habanalabs/common/post-image-spi.sh
index 437225c..6bc149e 100755
--- a/board/habanalabs/common/post-image-spi.sh
+++ b/board/habanalabs/common/post-image-spi.sh
@@ -17,12 +17,14 @@
 	od -Anone -v -tx1 -w4 ${OUTF}.tmp | gawk '{ print $4 $3 $2 $1 }' | xxd -r -p > ${OUTF}
 }
 
+source ${BOARD_BASE}/post-image-spi.sh
+
 pushd ${BINARIES_DIR}
 	${HOST_DIR}/usr/bin/mkimage -C none -A arm64 -T script -d ${UBOOT_CMDFILE} boot.scr
 
 	# Align sectors to 64KB
 	dd status=none conv=sync bs=64K if=${BTL_BINFILE}					 > sectors-aligned.bin
-	dd status=none conv=sync bs=64K if=sectors-aligned.bin					 > ${HL_DEV}-sectors.bin
+	swap_btl sectors-aligned.bin ${HL_DEV}-sectors.bin
 	BTL_BINFILE=${HL_DEV}-sectors.bin
 
 	dd status=none conv=sync bs=8 if=${PREBOOT_BINFILE}					 > ${HL_DEV}-preboot.bin
diff --git a/board/habanalabs/gaudi/post-image-spi.sh b/board/habanalabs/gaudi/post-image-spi.sh
new file mode 100755
index 0000000..933faca
--- /dev/null
+++ b/board/habanalabs/gaudi/post-image-spi.sh
@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+
+function swap_btl {
+	INF=$1
+	OUTF=$2
+
+	# No SWAP needed
+	dd status=none conv=sync bs=64K if=${INF} > ${OUTF}
+}
diff --git a/board/habanalabs/goya/post-image-spi.sh b/board/habanalabs/goya/post-image-spi.sh
new file mode 100755
index 0000000..933faca
--- /dev/null
+++ b/board/habanalabs/goya/post-image-spi.sh
@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+
+function swap_btl {
+	INF=$1
+	OUTF=$2
+
+	# No SWAP needed
+	dd status=none conv=sync bs=64K if=${INF} > ${OUTF}
+}
diff --git a/board/habanalabs/goya2/post-image-spi.sh b/board/habanalabs/goya2/post-image-spi.sh
new file mode 100755
index 0000000..36c2f1a
--- /dev/null
+++ b/board/habanalabs/goya2/post-image-spi.sh
@@ -0,0 +1,8 @@
+#!/usr/bin/env bash
+
+function swap_btl {
+	INF=$1
+	OUTF=$2
+
+	swap_file ${INF} ${OUTF}
+}
