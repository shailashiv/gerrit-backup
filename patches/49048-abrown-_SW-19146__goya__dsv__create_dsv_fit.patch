diff --git a/package/dsv/dsv.mk b/package/dsv/dsv.mk
index be5b31a..b54aac8 100644
--- a/package/dsv/dsv.mk
+++ b/package/dsv/dsv.mk
@@ -8,4 +8,9 @@
 	$(TARGET_MAKE_ENV) $(MAKE) CROSS_COMPILE="$(TARGET_CROSS)" -C $(@D) all
 endef
 
+DSV_INSTALL_IMAGES = YES
+define DSV_INSTALL_IMAGES_CMDS
+        $(INSTALL) -D -m 0644 $(@D)/dsv.bin $(BINARIES_DIR)/
+endef
+ 
 $(eval $(generic-package))
