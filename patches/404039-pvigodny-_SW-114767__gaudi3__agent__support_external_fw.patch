From 6f376f864161a52c0979c72f1a373c0e78e319ef Mon Sep 17 00:00:00 2001
From: Peleg Vigodny <pvigodny@habana.ai>
Date: Sun, 17 Mar 2024 15:33:44 +0200
Subject: [PATCH] [SW-114767] gaudi3: agent: support external fw

Support defining external FW for Gaudi3 agents

Signed-off-by: Peleg Vigodny <pvigodny@habana.ai>
Change-Id: I98a96164a6be08601dcae007f86b059188a58ce9
---

diff --git a/board/habanalabs/gaudi3_arc/agent.its b/board/habanalabs/gaudi3_arc/agent.its
index 3700f07..64a58d7 100644
--- a/board/habanalabs/gaudi3_arc/agent.its
+++ b/board/habanalabs/gaudi3_arc/agent.its
@@ -34,6 +34,18 @@
 				algo = "sha384";
 			};
 		};
+
+		external_fw {
+			description = "External agent FW";
+			data = /incbin/("@HL_AGENT_FW_BIN@");
+			compression = "none";
+			arch = "arc";
+			core-id = <1>;
+			loadaddr = <@AGENT_FW_ADDR_HI@ @AGENT_FW_ADDR_LO@>;
+			hash {
+				algo = "@SHA_VERSION@";
+			};
+		};
 	};
 
 	configurations {
