 void boot_rom_uart_init(void)
 {
@@ -104,3 +105,171 @@
 	if(!boot_rom_boot_desc_init_done(HL_FW_BOOT_PTR_SPI))
 		execute_recovery();
 }
+
+bool boot_rom_is_valid_address_range(uint64_t addr, int len)
+{
+	if (addr >= (uint64_t)SP_SRAM_BASE &&
+	    addr + len <= (uint64_t)(SP_SRAM_BASE + HL_SP_SRAM_SIZE) )
+		return true;
+
+	if (addr >= HL_SP_SRAM_BASE &&
+	    addr + len <= HL_SP_SRAM_BASE + HL_SP_SRAM_SIZE)
+		return true;
+
+	if (addr >= HL_ARC0_ICCM_FULL_BASE &&
+	    addr + len <= HL_ARC0_ICCM_FULL_BASE + ARC0_MEM_SIZE)
+		return true;
+
+	if (addr >= HL_ARC1_ICCM_FULL_BASE &&
+	    addr + len <= HL_ARC1_ICCM_FULL_BASE + ARC1_MEM_SIZE)
+		return true;
+
+	if (addr >= HL_ARC2_ICCM_FULL_BASE &&
+	    addr + len <= HL_ARC2_ICCM_FULL_BASE + ARC2_MEM_SIZE)
+		return true;
+
+	if (addr >= (uint64_t)(HL_FW_MEM_BASE + HL_FWSRAM_OFFSET) &&
+	    addr + len <= (uint64_t)(HL_FW_MEM_BASE + HL_FWSRAM_OFFSET + HL_FW_SRAM_SIZE) )
+		return true;
+
+	if (addr >= HL_FW_SRAM_FULL_BASE &&
+	    addr + len <= HL_FW_SRAM_FULL_BASE + HL_FW_SRAM_SIZE)
+		return true;
+
+	return false;
+}
+
+bool boot_rom_is_valid_start_addr(struct boot_desc *desc)
+{
+	if ((desc->start_addr >= desc->loadaddr) &&
+	   (desc->start_addr < desc->loadaddr + desc->img_size))
+		return true;
+
+	return false;
+}
+
+#define PPBOOT_MAX_IMAGE_SIZE	(2 * MAX_DMA_SIZE_CRC)
+static int boot_rom_bringup_img_sub(int img, struct boot_desc *desc,
+	enum fw_post_reset_cmd upd_status, uint8_t cur_img)
+{
+	enum dma_error err = DMA_SUCCESS;
+	enum boot_rom_progress img_sts_base = PROGRESS_BRINGUP_PCI_PRI;
+	boot_rom_global.curr_img = cur_img;
+
+	if (cur_img == BOOT_ROM_SECONDARY)
+		img_sts_base = PROGRESS_BRINGUP_PCI_SEC;
+		/* TODO: Check what is TPM_SPI and progress status */
+
+	boot_rom_status_update_bringup(img_sts_base, PROGRESS_BRINGUP_START);
+	boot_desc_get_img_desc(HL_FW_BOOT_PTR_SPI, img, desc, upd_status);
+	if (!boot_rom_is_valid_address_range(desc->loadaddr, desc->img_size)) {
+		boot_rom_status_update_bringup(img_sts_base, PROGRESS_BRINGUP_LOADADDR_INVALID);
+		return BOOT_ROM_BRINGUP_ERROR;
+	}
+
+	if (!boot_rom_is_valid_start_addr(desc)) {
+		boot_rom_status_update_bringup(img_sts_base, PROGRESS_BRINGUP_STARTADDR_INVALID);
+		return BOOT_ROM_BRINGUP_ERROR;
+	}
+
+	//boot_rom_security_report_img_fw(boot_rom_global.curr_img, desc->sec_ver); /* TODO: security_impl */
+	if ((img == HL_FW_IMG_PPBOOT) && (desc->img_size > PPBOOT_MAX_IMAGE_SIZE)) {
+		boot_rom_status_update_bringup(img_sts_base, PROGRESS_BRINGUP_TOO_BIG);
+		return BOOT_ROM_BRINGUP_ERROR;
+	}
+
+	err = boot_rom_spi_dma(desc->img_size, desc->spi_offset, desc->loadaddr, false, false, 0);
+
+	if (err != DMA_SUCCESS) {
+		if (err == DMA_INVALID_CRC_ERROR) {
+			/*
+			 * TPM validation is after ppboot image validation, hence the
+			 * image status of ppboot can be overwritten by tpm validation logic.
+			 * Hence the PSOC debug registers for image status should not be
+			 * done for TPM image.
+			 */
+			// if (img != HL_FW_IMG_TPM_SPI)
+			// 	boot_rom_security_report_img_status(cur_img, IMG_STATUS_CRC_FAIL); /* TODO: security_impl */
+			boot_rom_status_update_bringup(img_sts_base, PROGRESS_BRINGUP_CRC_FAIL);
+		} else if (err == DMA_UNALIGNED_DEST_ADDR) {
+			boot_rom_status_update_bringup(img_sts_base, PROGRESS_BRINGUP_UNALIGNED_DEST_ADDR);
+		} else if (err == DMA_INVALID_IMG_SIZE) {
+			boot_rom_status_update_bringup(img_sts_base, PROGRESS_BRINGUP_INVALID_IMG_SIZE);
+		} else if (err == DMA_UNALIGNED_IMG_SIZE) {
+			boot_rom_status_update_bringup(img_sts_base, PROGRESS_BRINGUP_UNALIGNED_IMG_SIZE);
+		} else {
+			boot_rom_status_update_bringup(img_sts_base, PROGRESS_BRINGUP_DMA_ERROR);
+		}
+
+		return BOOT_ROM_BRINGUP_ERROR;
+	}
+
+	boot_rom_status_update_bringup(img_sts_base, PROGRESS_BRINGUP_DMA);
+
+	/* TODO: security_impl */
+
+	return BOOT_ROM_SUCCESS;
+}
+
+static int boot_rom_bringup_img(int img, uint64_t *start_addr)
+{
+	enum fw_post_reset_cmd fw_upd_status = boot_rom_read_upd_status();
+	int ret;
+	struct boot_desc desc = {0};
+
+	ret = boot_rom_bringup_img_sub(img, &desc, fw_upd_status, BOOT_ROM_PRIMARY);
+	if (ret == BOOT_ROM_SUCCESS)
+		goto image_bringup_success;
+
+	if (boot_rom_secondary_img_disabled())
+		return BOOT_ROM_FAIL;
+
+	/* Try the secondary image by toggling upd_status variable */
+	fw_upd_status = (fw_upd_status == FLOPS_UPD_PENDING) ? FLOPS_UPD_NOOP :
+			 FLOPS_UPD_PENDING;
+
+	ret = boot_rom_bringup_img_sub(img, &desc, fw_upd_status, BOOT_ROM_SECONDARY);
+	if (ret == BOOT_ROM_SUCCESS)
+		goto image_bringup_success;
+
+	return BOOT_ROM_FAIL;
+
+image_bringup_success:
+	*start_addr = desc.start_addr;
+
+	return BOOT_ROM_SUCCESS;
+}
+
+void boot_rom_bringup_ppboot(void)
+{
+	void (*ppboot)();
+	uint64_t *start_addr = &boot_rom_global.ppboot_start_addr;
+	int ret;
+
+	/* TODO: add check for boot desc init */
+
+	if (boot_rom_global.validation_pass)
+		goto skip_rom_validation;
+
+	/* Check for prim/sec failure */
+	ret = boot_rom_bringup_img(HL_FW_IMG_PPBOOT, start_addr);
+	if (ret == BOOT_ROM_SUCCESS) {
+		boot_rom_set_validation(true);
+	} else {
+		boot_rom_set_validation(false);
+		goto skip_bringup;
+	}
+
+skip_rom_validation:
+	/* TODO: Add tpm init code */
+
+	boot_rom_status_update(PROGRESS_PPBOOT_START);
+	if (*start_addr) {
+		/* TODO: start cpld watchdog timer */
+		ppboot = (void *)((uint32_t)boot_rom_get_arc_addr(*start_addr));
+		ppboot();
+	}
+
+skip_bringup:
+	execute_recovery();
+}
