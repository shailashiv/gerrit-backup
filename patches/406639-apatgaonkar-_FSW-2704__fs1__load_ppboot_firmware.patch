+++ b/arch/fs1/arc/soc.h
@@ -94,6 +94,8 @@
 #define HL_FW_SRAM_FULL_BASE		(HL_FW_MEM_BASE_FULL + HL_FWSRAM_OFFSET)
 #define HL_FW_SRAM_SIZE			SZ_128K
 
+#define CONV_64B_TO_ARC_FW_MEM(addr)	((addr & 0x3FFFFF) + HL_FW_MEM_BASE)
+
 #define REC_IMG_PTRS_BASE			(0x0)
 /* recovery boot descriptors are DMA trans to ARC1 ICCM at offset 192K */
 #define REC_IMG_DESC_ICCM_OFFSET	(192 * 1024)
