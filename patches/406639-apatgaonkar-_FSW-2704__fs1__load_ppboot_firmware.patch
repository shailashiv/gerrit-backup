+	boot_rom_manifest.boot_ptr_ctx[HL_FW_BOOT_PTR_SPI].boot_desc_flag = 0;
 }
 
 #define HL_ARC1_DCCM_PERSIST_SECTION_SIZE		(3 * 1024) /* 3KB */
@@ -166,3 +182,47 @@
 	cold_rst_data.efuse_read_flag = 1;
 	regmap_writel(cold_rst_data.data, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
 }
+
+uint32_t boot_rom_read_upd_status(void)
+{
+	return regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_3));
+}
+
+bool boot_rom_secondary_img_disabled(void)
+{
+	return (boot_rom_global.config_fuse & EFUSE_SYSCFG_DIS_SECONDARY_IMG);
+}
+
+void boot_rom_set_validation(bool status)
+{
+	struct fs1_cold_rst_data cold_rst_data;
+
+	/*
+	 * validation pass, set validation flag and clear recovery
+	 * validation failed, set recovery flag and clear validation
+	 */
+	cold_rst_data.data = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+	cold_rst_data.validation_flag = (status) ? 1 : 0;
+	cold_rst_data.recovery_flag = (status) ? 0 : 1;
+	regmap_writel(cold_rst_data.data, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+}
+
+uint32_t boot_rom_fw_mem_arc_addr(uint64_t addr)
+{
+	uint32_t ret_addr;
+
+	if (addr >= HL_ARC1_ICCM_FULL_BASE && addr <= HL_ARC1_ICCM_FULL_BASE + ARC1_ICCM_SIZE)
+		ret_addr = CONV_64B_TO_ARC_FW_MEM(addr) - (HL_FW_MEM_BASE + HL_ICCM_OFFSET);
+	else
+		ret_addr = CONV_64B_TO_ARC_FW_MEM(addr);
+
+	return ret_addr;
+}
+
+uint32_t boot_rom_get_arc_addr(uint64_t addr)
+{
+	if (addr >= HL_FW_MEM_BASE_FULL && addr <= HL_FW_MEM_BASE_FULL + HL_FW_MEM_SIZE)
+		return boot_rom_fw_mem_arc_addr(addr);
+
+	return 0;
+}
