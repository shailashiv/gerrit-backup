+#define mmSRAM_W_PLL_BASE		0x4C8000
+#define mmMESH_E_PLL_BASE		0x4E7000
+#define mmSRAM_E_PLL_BASE		0x4E8000
+#define mmPSOC_CPU_PLL_BASE		0xC70000
+#define mmPSOC_MME_PLL_BASE		0xC71000
+#define mmPSOC_PCI_PLL_BASE		0xC72000
+#define mmPSOC_TPC_PLL_BASE		0xC73000
