+#include <pll.h>
+#include <uart.h>
+
+#define SYS_CLOCK_FREQUENCY	155000ULL
+#define UART_CLOCK_FREQUENCY	(SYS_CLOCK_FREQUENCY / 5)
+#define PLDM_UART_BAUDRATE	1200
+
+bool hl_pll_is_configurable(struct hl_pll_cfg *cfg)
+{
+	return false;
+}
+
+int hl_pll_get_cfg(struct hl_pll_cfg **hl_pll_cfg)
+{
+	return 0;
+}
+
+u32 hl_skip_pcie_init(void)
+{
+	return 1;
+}
+
+u64 hl_pll_get_cpu_cycles_per_usec(void)
+{
+	return SYS_CLOCK_FREQUENCY / USEC_PER_SEC;
+}
+
+void hl_uart_init(void)
+{
+	preboot_uart_init(UART_CLOCK_FREQUENCY / PLDM_UART_BAUDRATE);
+}
+
+u32 hl_spi_baudr_get(void)
+{
+	u32 factor = 2; /* Min Divider */
+
+	/* baud rate doesn't support odd number */
+	return (factor + 1) & 0xFFFE;
+}
+
+void preboot_init_pcie_phy(void) {}
+
diff --git a/goya2/ppboot.lds.S b/goya2/ppboot.lds.S
new file mode 100644
index 0000000..68d58f1
--- /dev/null
+++ b/goya2/ppboot.lds.S
@@ -0,0 +1,31 @@
+/*
+ * (C) Copyright 2017 HabanaLabs, Ltd.
+ * Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#include "common.h"
+
+MEMORY { .sram : ORIGIN = PPBOOT_TEXT_BASE, LENGTH = PPBOOT_SIZE }
+
+OUTPUT_FORMAT("elf64-littleaarch64", "elf64-littleaarch64", "elf64-littleaarch64")
+OUTPUT_ARCH(aarch64)
+ENTRY(_start)
+SECTIONS
+{
+	.text : {
+		. = ALIGN(8);
+		app/crt0_ppboot.o (.text*)
+		* (.text*)
+	} >.sram
+
+	.stack : {
+		. = ALIGN(8);
+		__stack = . ;
+		. = . + 512 ;
+		__stack_top = . ;
+	} > .sram
+
+	.note.gnu.build-id : { *(.note.gnu.build-id) } > .sram
+}
