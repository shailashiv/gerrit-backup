+/*
+ * (C) Copyright 2019 HabanaLabs, Ltd.
+ * Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#include <stdbool.h>
+
+#include <preboot.h>
+#include <pll.h>
+#include <uart.h>
+
+#define SYS_CLOCK_FREQUENCY	35000000ULL
+
+bool hl_pll_is_configurable(struct hl_pll_cfg *cfg)
+{
+	return false;
+}
+
+int hl_pll_get_cfg(struct hl_pll_cfg **hl_pll_cfg)
+{
+	return 0;
+}
+
+u32 hl_skip_pcie_init(void)
+{
+	return 1;
+}
+
+u64 hl_pll_get_cpu_cycles_per_usec(void)
+{
+	return SYS_CLOCK_FREQUENCY / USEC_PER_SEC;
+}
+
+void hl_uart_init(void)
+{
+	preboot_uart_init(SYS_CLOCK_FREQUENCY / HL_UART_BAUDRATE);
+}
+
+u32 hl_spi_baudr_get(void)
+{
+	u32 factor;
+
+	factor = SYS_CLOCK_FREQUENCY / HL_SPI_FLASH_MAX_FREQ;
+
+	/* baud rate doesn't support odd number */
+	return (factor + 1) & 0xFFFE;
+}
