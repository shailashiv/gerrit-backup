+static void _gaudi2_init_arc_dup_eng_axuser_overrides(u32 arc_base)
+{
+	regmap_writel(GAUDI2_AXUSER_HB_WR_OVRD_LO, arc_base +
+		      ARC_DUP_ENG_AXUSER_HB_WR_OVRD_LO_OFFSET);
+	regmap_writel(GAUDI2_AXUSER_HB_RD_OVRD_LO, arc_base +
+		      ARC_DUP_ENG_AXUSER_HB_RD_OVRD_LO_OFFSET);
+	regmap_writel(GAUDI2_AXUSER_LB_OVRD, arc_base +
+		      ARC_DUP_ENG_AXUSER_LB_OVRD_OFFSET);
+	regmap_writel(0, arc_base + ARC_DUP_ENG_AXUSER_HB_STRONG_ORDER_OFFSET);
+}
+
+static void gaudi2_init_arc_dup_eng_axuser_overrides(void)
+{
+	_gaudi2_init_arc_dup_eng_axuser_overrides(mmARC_FARM_ARC0_DUP_ENG_BASE);
+	_gaudi2_init_arc_dup_eng_axuser_overrides(mmARC_FARM_ARC1_DUP_ENG_BASE);
+	_gaudi2_init_arc_dup_eng_axuser_overrides(mmARC_FARM_ARC2_DUP_ENG_BASE);
+	_gaudi2_init_arc_dup_eng_axuser_overrides(mmARC_FARM_ARC3_DUP_ENG_BASE);
+}
+
+void preboot_axuser_override(void)
+{
+	gaudi2_init_mstr_if(mmPCIE_MSTR_RR_MSTR_IF_AXUSER_BASE);
+	gaudi2_init_dma_core_axuser_overrides();
+	gaudi2_init_qm_axuser_overrides();
+	gaudi2_init_tpc_axuser_overrides();
+	gaudi2_init_mme_axuser_overrides();
+	gaudi2_init_vdec_axuser_overrides();
+	gaudi2_init_arc_dup_eng_axuser_overrides();
+}
