+	regmap_writel(GAUDI2_AXUSER_HB_RD_OVRD_LO, core_base +
+		      VDEC_BRDG_CTRL_AXUSER_MSIX_NRM_HB_RD_OVRD_LO_OFFSET);
+	regmap_writel(GAUDI2_AXUSER_LB_OVRD, core_base +
