+	if (DECODER_ENABLED_MASK & BIT(1))
+		_gaudi2_init_vdec_axuser_overrides(
+						mmDCORE0_VDEC1_BRDG_CTRL_BASE);
+
+	if (DECODER_ENABLED_MASK & BIT(2))
+		_gaudi2_init_vdec_axuser_overrides(
+						mmDCORE1_VDEC0_BRDG_CTRL_BASE);
+
+	if (DECODER_ENABLED_MASK & BIT(3))
+		_gaudi2_init_vdec_axuser_overrides(
+						mmDCORE1_VDEC1_BRDG_CTRL_BASE);
+
+	if (DECODER_ENABLED_MASK & BIT(4))
+		_gaudi2_init_vdec_axuser_overrides(
+						mmDCORE2_VDEC0_BRDG_CTRL_BASE);
+
+	if (DECODER_ENABLED_MASK & BIT(5))
+		_gaudi2_init_vdec_axuser_overrides(
+						mmDCORE2_VDEC1_BRDG_CTRL_BASE);
+
+	if (DECODER_ENABLED_MASK & BIT(6))
+		_gaudi2_init_vdec_axuser_overrides(
+						mmDCORE3_VDEC0_BRDG_CTRL_BASE);
+
+	if (DECODER_ENABLED_MASK & BIT(7))
+		_gaudi2_init_vdec_axuser_overrides(
+						mmDCORE3_VDEC1_BRDG_CTRL_BASE);
+
+	if (DECODER_ENABLED_MASK & BIT(8))
+		_gaudi2_init_vdec_axuser_overrides(mmPCIE_VDEC0_BRDG_CTRL_BASE);
+
+	if (DECODER_ENABLED_MASK & BIT(9))
+		_gaudi2_init_vdec_axuser_overrides(mmPCIE_VDEC1_BRDG_CTRL_BASE);
+}
