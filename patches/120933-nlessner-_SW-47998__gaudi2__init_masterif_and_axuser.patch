+#include <preboot.h>
+#include <uart.h>
+#include "hl.h"
+
+/*
+ * master-if AXUSER override bits
+ *
+ * For HBW fabric, AWUSER defined as follows:
+ *   [41:38] |Y |CORD/Y
+ *   [37:33] |X |CORD/X
+ *   [32]    |Coreherency |HB_CORE
+ *   [31]    |RESERVED |HB_RSVD/BIT_31
+ *   [30]    |RESERVED |HB_RSVD/BIT_30
+ *   [29]    |EXTMEM_CLOSE_PAGE |HB_DDR/CPAGE_WR
+ *   [28]    |RESERVED |HB_RSVD/BIT_28
+ *   [27]    |RESERVED |HB_RSVD/BIT_27
+ *   [26]    |REDUCTION_MAX |HB_REDUCTION/MAX
+ *   [25:22] |QOS |HB_DDR/QOS_WR
+ *   [21:20] |REDUCTION_ROUNDING_MODE |HB_REDUCTION/ROUND
+ *   [19:18] |REDUCTION_OPERATION |HB_REDUCTION/OP
+ *   [17:14] |REDUCTION_DATA_TYPE |HB_REDUCTION/DTYPE
+ *   [13]    |REDUCTION_INDICATION |HB_REDUCTION/IND
+ *   [12]    |NO_SNOOP |HB_PCIE/NO_SNOOP
+ *   [11]    |STRONG_ORDER |HB_PCIE/STRONG_ORDER
+ *   [10]    |MMBP |HB_SEC/MMBP
+ *   [9:0]   |ASID |HB_SEC/ASID
+ *
+ * For HBW fabric, ARUSER defined as follows:
+ *   [41:38] |Y |CORD/Y
+ *   [37:33] |X |E2E/X
+ *   [32]    |Coreherency |CORE
+ *   [31]    |REGULATOR |HB_RSVD/BIT_31
+ *   [30]    |RESERVED |HB_RSVD/BIT_30
+ *   [29]    |DDR_CLOSE_PAGE |HB_DDR/CPAGE_RD
+ *   [28]    |RESERVED |HB_RSVD/BIT_28
+ *   [27]    |RESERVED |HB_RSVD/BIT_27
+ *   [26]    |REDUCTION_MAX |HB_REDUCTION/MAX
+ *   [25:22] |QOS |HB_DDR/QOS_RD
+ *   [21:13] |RESERVED |HB_REDUCTION/RD_RSVD
+ *   [12]    |NO_SNOOP |HB_PCIE/NO_SNOOP
+ *   [11]    |STRONG_ORDER |HB_PCIE/STRONG_ORDER
+ *   [10]    |MMBP |HB_SEC/MMBP
+ *   [9:0]   |ASID |HB_SEC/ASID
+ *
+ * For LBW fabric, both AWUSER and ARUSER:
+ *   [31:28] |Y |E2E/Y
+ *   [27:23] |X |E2E/X
+ *   [22]    |RESERVED |LB_RSVD/BIT_22
+ *   [21:11] |RESERVED |LB_RSVD/BIT_21_11
+ *   [10]    |LOCK_INDICATION |LB_LOCK/VAL
+ *   [9:0]   |RESERVED |LB_COORD/VAL
+ */
+
+static void gaudi2_init_mstr_if(u32 mstr_if_base)
+{
+	regmap_writel(0, mstr_if_base + MSTR_IF_AXUSER_HB_WR_OVRD_LO_OFFSET);
+	regmap_writel(0, mstr_if_base + MSTR_IF_AXUSER_HB_RD_OVRD_LO_OFFSET);
+	regmap_writel(ARC_FARM_KDMA_MSTR_IF_AXUSER_HB_MMU_BP_RD_MASK |
+		      ARC_FARM_KDMA_MSTR_IF_AXUSER_HB_MMU_BP_RD_MASK,
+		      mstr_if_base + MSTR_IF_AXUSER_HB_MMU_BP_OFFSET);
+}
+
+static void _gaudi2_init_qm_axuser_overrides(u32 qm_base)
+{
+	/* Configure QM AXUSER overrides */
+	regmap_writel(GAUDI2_AXUSER_HB_WR_OVRD_LO, qm_base +
+		      QM_AXUSER_SECURED_HB_WR_OVRD_LO_OFFSET);
+	regmap_writel(GAUDI2_AXUSER_HB_RD_OVRD_LO, qm_base +
+		      QM_AXUSER_SECURED_HB_RD_OVRD_LO_OFFSET);
+	regmap_writel(GAUDI2_AXUSER_LB_OVRD, qm_base +
+		      QM_AXUSER_SECURED_LB_OVRD_OFFSET);
+	regmap_writel(0x0, qm_base + QM_AXUSER_SECURED_HB_STRONG_ORDER_OFFSET);
+	regmap_writel(GAUDI2_AXUSER_HB_WR_OVRD_LO, qm_base +
+		      QM_AXUSER_NONSECURED_HB_WR_OVRD_LO_OFFSET);
+	regmap_writel(GAUDI2_AXUSER_HB_RD_OVRD_LO, qm_base +
+		      QM_AXUSER_NONSECURED_HB_RD_OVRD_LO_OFFSET);
+	regmap_writel(GAUDI2_AXUSER_LB_OVRD, qm_base +
+		      QM_AXUSER_NONSECURED_LB_OVRD_OFFSET);
+	regmap_writel(0x0, qm_base +
+		      QM_AXUSER_NONSECURED_HB_STRONG_ORDER_OFFSET);
+}
+
+static void gaudi2_init_qm_axuser_overrides(void)
+{
+	u64 nic_idx, qm_idx;
+
+	_gaudi2_init_qm_axuser_overrides(mmPDMA0_QM_BASE);
+	_gaudi2_init_qm_axuser_overrides(mmPDMA1_QM_BASE);
+
+	if (EDMA_ENABLED_MASK & BIT(EDMA_ID_DCORE0_INSTANCE0))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE0_EDMA0_QM_BASE);
+
+	if (EDMA_ENABLED_MASK & BIT(EDMA_ID_DCORE0_INSTANCE1))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE0_EDMA1_QM_BASE);
+
+	if (EDMA_ENABLED_MASK & BIT(EDMA_ID_DCORE1_INSTANCE0))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE1_EDMA0_QM_BASE);
+
+	if (EDMA_ENABLED_MASK & BIT(EDMA_ID_DCORE1_INSTANCE1))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE1_EDMA1_QM_BASE);
+
+	if (EDMA_ENABLED_MASK & BIT(EDMA_ID_DCORE2_INSTANCE0))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE2_EDMA0_QM_BASE);
+
+	if (EDMA_ENABLED_MASK & BIT(EDMA_ID_DCORE2_INSTANCE1))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE2_EDMA1_QM_BASE);
+
+	if (EDMA_ENABLED_MASK & BIT(EDMA_ID_DCORE3_INSTANCE0))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE3_EDMA0_QM_BASE);
+
+	if (EDMA_ENABLED_MASK & BIT(EDMA_ID_DCORE3_INSTANCE1))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE3_EDMA1_QM_BASE);
+
+	/*
+	 * MME
+	 */
+	if (MME_MASK & BIT(0))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE0_MME_QM_BASE);
+
+	if (MME_MASK & BIT(1))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE1_MME_QM_BASE);
+
+	if (MME_MASK & BIT(2))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE2_MME_QM_BASE);
+
+	if (MME_MASK & BIT(3))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE3_MME_QM_BASE);
+
+	/*
+	 * TPC
+	 */
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE0_TPC0))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE0_TPC0_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE0_TPC1))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE0_TPC1_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE0_TPC2))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE0_TPC2_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE0_TPC3))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE0_TPC3_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE0_TPC4))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE0_TPC4_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE0_TPC5))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE0_TPC5_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE0_TPC6))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE0_TPC6_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE1_TPC0))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE1_TPC0_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE1_TPC1))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE1_TPC1_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE1_TPC2))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE1_TPC2_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE1_TPC3))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE1_TPC3_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE1_TPC4))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE1_TPC4_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE1_TPC5))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE1_TPC5_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE2_TPC0))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE2_TPC0_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE2_TPC1))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE2_TPC1_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE2_TPC2))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE2_TPC2_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE2_TPC3))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE2_TPC3_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE2_TPC4))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE2_TPC4_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE2_TPC5))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE2_TPC5_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE3_TPC0))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE3_TPC0_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE3_TPC1))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE3_TPC1_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE3_TPC2))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE3_TPC2_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE3_TPC3))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE3_TPC3_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE3_TPC4))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE3_TPC4_QM_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE3_TPC5))
+		_gaudi2_init_qm_axuser_overrides(mmDCORE3_TPC5_QM_BASE);
+
+	/*
+	 * ROTATOR
+	 */
+	if (ROTATOR_MASK & BIT(0))
+		_gaudi2_init_qm_axuser_overrides(mmROT0_QM_BASE);
+
+	if (ROTATOR_MASK & BIT(1))
+		_gaudi2_init_qm_axuser_overrides(mmROT1_QM_BASE);
+
+	/*
+	 * NIC
+	 */
+	for (nic_idx = 0; nic_idx < NIC_NUMBER_OF_MACROS; nic_idx++)
+		for (qm_idx = 0; qm_idx < QM_PER_MACRO; qm_idx++) {
+			if (!(NIC_PORTS_MASK & BIT(nic_idx * QM_PER_MACRO +
+						   qm_idx)))
+				continue;
+
+			_gaudi2_init_qm_axuser_overrides(mmNIC0_QM0_BASE +
+							 nic_idx * NIC_OFFSET +
+							 qm_idx * NIC_QM_OFFSET);
+		}
+}
+
+static void _gaudi2_init_dma_core_axuser_overrides(u32 core_base)
+{
+	regmap_writel(GAUDI2_AXUSER_HB_WR_OVRD_LO, core_base +
+		      DMA_CORE_CTX_AXUSER_HB_WR_OVRD_LO_OFFSET);
+	regmap_writel(GAUDI2_DMA_AXUSER_HB_RD_OVRD_L, core_base +
+		      DMA_CORE_CTX_AXUSER_HB_RD_OVRD_LO_OFFSET);
+	regmap_writel(GAUDI2_AXUSER_LB_OVRD, core_base +
+		      DMA_CORE_CTX_AXUSER_LB_OVRD_OFFSET);
+	regmap_writel(0x0, core_base +
+		      DMA_CORE_CTX_AXUSER_HB_STRONG_ORDER_OFFSET);
+}
+
+static void gaudi2_init_edma_core_axuser_overrides(void)
+{
+	int dcore, inst;
+	u32 core_base;
+	u8 seq;
+
+	for (dcore = 0; dcore < NUM_OF_DCORES; dcore++) {
+		for (inst = 0; inst < NUM_OF_EDMA_PER_DCORE; inst++) {
+			seq = (NUM_OF_EDMA_PER_DCORE * dcore) + inst;
+
+			if (!(EDMA_ENABLED_MASK & BIT(seq)))
+				continue;
+
+			core_base = mmDCORE0_EDMA0_CORE_BASE +
+				    (DCORE_OFFSET * dcore) +
+				    (DCORE_EDMA_OFFSET * inst);
+			_gaudi2_init_dma_core_axuser_overrides(core_base);
+		}
+	}
+}
+
+static void gaudi2_init_dma_core_axuser_overrides(void)
+{
+	_gaudi2_init_dma_core_axuser_overrides(mmPDMA0_CORE_BASE);
+	_gaudi2_init_dma_core_axuser_overrides(mmPDMA1_CORE_BASE);
+	_gaudi2_init_dma_core_axuser_overrides(mmARC_FARM_KDMA_BASE);
+	gaudi2_init_edma_core_axuser_overrides();
+}
+
+static void _gaudi2_init_tpc_axuser_overrides(u32 core_base)
+{
+	regmap_writel(GAUDI2_TPC_AXUSER_HB_WR_OVRD_L, core_base +
+		      TPC_CFG_AXUSER_HB_WR_OVRD_LO_OFFSET);
+	regmap_writel(GAUDI2_AXUSER_HB_RD_OVRD_LO, core_base +
+		      TPC_CFG_AXUSER_HB_RD_OVRD_LO_OFFSET);
+	regmap_writel(GAUDI2_TPC_AXUSER_LB_OVRD, core_base +
+		      TPC_CFG_AXUSER_LB_OVRD_OFFSET);
+	regmap_writel(0x0, core_base + TPC_CFG_AXUSER_HB_STRONG_ORDER_OFFSET);
+}
+
+static void gaudi2_init_tpc_axuser_overrides(void)
+{
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE0_TPC0))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE0_TPC0_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE0_TPC1))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE0_TPC1_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE0_TPC2))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE0_TPC2_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE0_TPC3))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE0_TPC3_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE0_TPC4))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE0_TPC4_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE0_TPC5))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE0_TPC5_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE0_TPC6))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE0_TPC6_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE1_TPC0))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE1_TPC0_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE1_TPC1))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE1_TPC1_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE1_TPC2))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE1_TPC2_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE1_TPC3))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE1_TPC3_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE1_TPC4))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE1_TPC4_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE1_TPC5))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE1_TPC5_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE2_TPC0))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE2_TPC0_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE2_TPC1))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE2_TPC1_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE2_TPC2))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE2_TPC2_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE2_TPC3))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE2_TPC3_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE2_TPC4))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE2_TPC4_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE2_TPC5))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE2_TPC5_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE3_TPC0))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE3_TPC0_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE3_TPC1))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE3_TPC1_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE3_TPC2))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE3_TPC2_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE3_TPC3))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE3_TPC3_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE3_TPC4))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE3_TPC4_CFG_BASE);
+
+	if (TPC_ENABLED_MASK & BIT(TPC_ID_DCORE3_TPC5))
+		_gaudi2_init_tpc_axuser_overrides(mmDCORE3_TPC5_CFG_BASE);
