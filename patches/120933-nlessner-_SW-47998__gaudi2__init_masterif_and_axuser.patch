+	regmap_writel(0x0, core_base +
+		      VDEC_BRDG_CTRL_AXUSER_MSIX_ABNRM_HB_STRONG_ORDER_OFFSET);
+
+	regmap_writel(GAUDI2_AXUSER_HB_WR_OVRD_LO, core_base +
+		      VDEC_BRDG_CTRL_AXUSER_MSIX_L2C_HB_WR_OVRD_LO_OFFSET);
+	regmap_writel(GAUDI2_AXUSER_HB_RD_OVRD_LO, core_base +
+		      VDEC_BRDG_CTRL_AXUSER_MSIX_L2C_HB_RD_OVRD_LO_OFFSET);
+	regmap_writel(GAUDI2_AXUSER_LB_OVRD, core_base +
+		      VDEC_BRDG_CTRL_AXUSER_MSIX_L2C_LB_OVRD_OFFSET);
+	regmap_writel(0x0, core_base +
+		      VDEC_BRDG_CTRL_AXUSER_MSIX_L2C_HB_STRONG_ORDER_OFFSET);
+
+	regmap_writel(GAUDI2_AXUSER_HB_WR_OVRD_LO, core_base +
