+static void _gaudi2_init_mme_axuser_overrides(u32 core_base)
+{
+	int i, ports_offset;
+
+	regmap_writel(GAUDI2_AXUSER_HB_WR_OVRD_LO, core_base +
+		      MME_CTRL_LO_MME_AXUSER_HB_WR_OVRD_LO_OFFSET);
+	regmap_writel(GAUDI2_AXUSER_HB_RD_OVRD_LO, core_base +
+		      MME_CTRL_LO_MME_AXUSER_HB_RD_OVRD_LO_OFFSET);
+	regmap_writel(GAUDI2_AXUSER_LB_OVRD, core_base +
+		      MME_CTRL_LO_MME_AXUSER_LB_OVRD_OFFSET);
+	regmap_writel(0x0, core_base +
+		      MME_CTRL_LO_MME_AXUSER_HB_STRONG_ORDER_OFFSET);
+
+	for (i = 0; i < NUM_OF_MME_SBTE_PORTS; i++) {
+		ports_offset = i * DCORE_MME_SBTE_OFFSET;
+
+		regmap_writel(0x0, core_base + ports_offset +
+			      MME_CTRL_SBTE_AXUSER_HB_RD_OVRD_LO_OFFSET);
+		regmap_writel(0x0, core_base + ports_offset +
+			      MME_CTRL_SBTE_AXUSER_HB_STRONG_ORDER_OFFSET);
+	}
+
+	for (i = 0; i < NUM_OF_MME_WB_PORTS; i++) {
+		ports_offset = i * DCORE_MME_WB_OFFSET;
+
+		regmap_writel(GAUDI2_MME_AXUSER_HB_WR_OVRD_L, core_base +
+			      ports_offset +
+			      MME_CTRL_WB_AXUSER_HB_WR_OVRD_LO_OFFSET);
+		regmap_writel(0x0, core_base + ports_offset +
+			      MME_CTRL_WB_AXUSER_HB_STRONG_ORDER_OFFSET);
+	}
+}
+
+void gaudi2_init_mme_axuser_overrides(void)
+{
+	if (MME_MASK & BIT(0))
+		_gaudi2_init_mme_axuser_overrides(mmDCORE0_MME_CTRL_LO_BASE);
+
+	if (MME_MASK & BIT(1))
+		_gaudi2_init_mme_axuser_overrides(mmDCORE1_MME_CTRL_LO_BASE);
+
+	if (MME_MASK & BIT(2))
+		_gaudi2_init_mme_axuser_overrides(mmDCORE2_MME_CTRL_LO_BASE);
+
+	if (MME_MASK & BIT(3))
+		_gaudi2_init_mme_axuser_overrides(mmDCORE3_MME_CTRL_LO_BASE);
+}
