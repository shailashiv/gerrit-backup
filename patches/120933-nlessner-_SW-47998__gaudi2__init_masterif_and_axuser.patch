 #define BITS_PER_LONG_LONG	64
+
+#ifdef __arc__
 #define BITS_PER_LONG		32
+#else
+#define BITS_PER_LONG		64
+#endif
+
 #define BIT(nr)		(1 << (nr))
 #define BIT_WORD(nr)	((nr) / BITS_PER_LONG)
 
 /* extracts "n" number of bits from position "p" in the given number "v" */
 #define EXTRACT_BITS(v, p, n) (((v) & (((1 << (n)) - 1) << (p))) >> (p))
+
+#define GENMASK(h, l)                      \
+	(((~UL(0)) - (UL(1) << (l)) + 1) & \
+	 (~UL(0) >> (BITS_PER_LONG - 1 - (h))))
+
 #define GENMASK_ULL(h, l)                    \
