From cae065a5de9e9b7360c8a59493055e6fa81d86b1 Mon Sep 17 00:00:00 2001
From: Sanyog Kale <skale@habana.ai>
Date: Mon, 18 May 2020 13:10:11 +0300
Subject: [PATCH] [SW-11875] ppboot: move ppboot files in separate directory

This patch adds changes to move files used only by ppboot to ppboot
directory.

The idea here to compile ppboot only with the files ppboot binary
uses. In order to achieve that, files in common folders are segregated
where files used by ppboot only are moved to ppboot folder and files
used by both preboot and ppboot are kept in common folder. This helps
to add single entries in Makefile instead of individual files. Along
with this, ppboot files under app folder are also moved in ppboot
directory.

Also Makefile is updated to compile ppboot only with ppboot files.

Change-Id: I2ae91e18911e19d5ec3a5fb1e8a0886e98f901c6
---

diff --git a/Makefile b/Makefile
index e83054e..ce2fdae 100644
--- a/Makefile
+++ b/Makefile
@@ -25,6 +25,8 @@
 
 PREBOOT_SRCS_C := $(shell ls common/*.c)
 PREBOOT_SRCS_C := $(filter-out common/thermal_v2.c, $(PREBOOT_SRCS_C))
+PPBOOT_SRCS_C := $(shell ls common/*.c)
+PPBOOT_SRCS_C := $(filter-out common/thermal_v2.c, $(PPBOOT_SRCS_C))
 
 include $(HL_DEV)/Makefile
 
@@ -32,14 +34,15 @@
 PREBOOT_SRCS_C += $(shell ls $(HL_DEV)/common.c)
 PREBOOT_SRCS_C += $(shell ls $(HL_DEV)/$(HL_TARGET).c)
 PREBOOT_APP_S := $(shell ls preboot/crt0_preboot.S)
-PPBOOT_APP_S := $(shell ls app/crt0_ppboot.S)
-PPBOOT_APP_C := $(shell ls app/ppboot.c)
+PPBOOT_SRCS_C += $(shell ls ppboot/*.c)
+PPBOOT_SRCS_C += $(shell ls $(HL_DEV)/common.c)
+PPBOOT_SRCS_C += $(shell ls $(HL_DEV)/$(HL_TARGET).c)
+PPBOOT_APP_S := $(shell ls ppboot/crt0_ppboot.S)
 
 PREBOOT_OBJECTS := $(PREBOOT_SRCS_C:.c=.o)
 PREBOOT_OBJECTS += $(PREBOOT_APP_S:.S=.o)
-PPBOOT_OBJECTS := $(PREBOOT_SRCS_C:.c=.o)
+PPBOOT_OBJECTS := $(PPBOOT_SRCS_C:.c=.o)
 PPBOOT_OBJECTS += $(PPBOOT_APP_S:.S=.o)
-PPBOOT_OBJECTS += $(PPBOOT_APP_C:.c=.o)
 AUTO_GENERATED_FILE := auto_generated.h
 
 BINDIR = bin
