+eeprom write  $LAYOUT 7ff0000000 0 100
+eeprom update $LAYOUT "Layout Version" "0"
+eeprom update $LAYOUT "Production Serial Number" "a011223344"
+eeprom update $LAYOUT "PCB Assembly Version" "1a"
+eeprom update $LAYOUT "CPLD FW Version" "2b"
+eeprom update $LAYOUT "Infineon FW Version" "3c"
+eeprom update $LAYOUT "DDR Type and Speed" "12"
+eeprom update $LAYOUT "Fans Vendor" "3"
+eeprom update $LAYOUT "Mechanics Vendor" "4"
+eeprom update $LAYOUT "Thermal Solution Vendor" "5"
+eeprom update $LAYOUT "PCIe Gen3 or Gen4 Enabled" "6"
+eeprom update $LAYOUT "MAC Address" "00:11:22:33:44:55"
+eeprom update $LAYOUT "Board Configuration" "Gaudi HL1000"
+echo "eeprom content is:"
+eeprom print  $LAYOUT
+setenv LAYOUT
