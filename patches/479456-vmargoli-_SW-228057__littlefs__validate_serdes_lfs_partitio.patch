From 00fdf5b14ddb1ba379eaa457566748097de0ae90 Mon Sep 17 00:00:00 2001
From: Vitaly Margolin <vmargolin@habana.ai>
Date: Tue, 13 May 2025 16:57:12 +0300
Subject: [PATCH] [SW-228057] littlefs: validate serdes lfs partition

Validate LFS Serdes partition

Change-Id: Ia0aac2a4935d792a8d5aab234d9f4365f392fdf4
Signed-off-by: Vitaly Margolin <vmargolin@habana.ai>
---

diff --git a/app/io/mgmt.c b/app/io/mgmt.c
index e6a7123..ec06d85 100644
--- a/app/io/mgmt.c
+++ b/app/io/mgmt.c
@@ -190,6 +190,7 @@
 #endif /* CONFIG_HL_I2C_TARGET_CORE */
 
 EMPTY_WEAK_FUNC(int hl_device_hw_init(struct hl_dev_config *dev_config), 0)
+EMPTY_WEAK_FUNC(int hl_device_hw_post_init(struct hl_dev_config *dev_config), 0)
 EMPTY_WEAK_FUNC(int hl_init_hbm_mem_pool(struct hl_dev_config *dev_config), 0)
 EMPTY_WEAK_FUNC(void ras_init(struct hl_dev_config *dev_config),)
 EMPTY_WEAK_FUNC(void hl_hbm_enable_dbg_counters(struct hl_dev_config *dev_config),)
@@ -410,6 +411,12 @@
 		goto err_loop;
 	}
 
+	ret = hl_device_hw_post_init(&dev_config);
+	if (ret) {
+		LOG_ERR("hw post init failed\n");
+		goto err_loop;
+	}
+
 	dev_config.init_rma_tables(&dev_config);
 
 #ifdef CONFIG_HL_I2C_TARGET_CORE
diff --git a/arch/gaudi3/device.c b/arch/gaudi3/device.c
index adee1eb..68fcb39 100644
--- a/arch/gaudi3/device.c
+++ b/arch/gaudi3/device.c
@@ -1236,11 +1236,16 @@
 
 	gaudi3_noc_init_late(&noc_info);
 	gaudi3_runtime_bmu_fixup();
-	hl_serdes_serdes_init();
 
 	return ret;
 }
 
+int hl_device_hw_post_init(struct hl_dev_config *dev_config)
+{
+	hl_serdes_serdes_init_with_validation(dev_config->hbm_mem_pool);
+	return 0;
+}
+
 int hl_init_hbm_mem_pool(struct hl_dev_config *dev_config)
 {
 	dev_config->hbm_mem_pool = &hbm_mem_pool;
diff --git a/include/io/common.h b/include/io/common.h
index 4555b7d..24ac28e 100644
--- a/include/io/common.h
+++ b/include/io/common.h
@@ -250,6 +250,7 @@
 void set_fw_versions_addr(struct hl_dev_config *dev_config, struct hl_component_versions *version);
 bool hl_engine_init(struct hl_dev_config *dev_config);
 int hl_device_hw_init(struct hl_dev_config *dev_config);
+int hl_device_hw_post_init(struct hl_dev_config *dev_config);
 int hl_init_hbm_mem_pool(struct hl_dev_config *dev_config);
 void hl_update_wdog_cause(uint8_t hb_fail_mask);
 int hl_get_preboot_version_num(uint32_t *ver);
