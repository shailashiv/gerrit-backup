index 0000000..9e94aa2
--- /dev/null
+++ b/boards/intel/jgs/Kconfig.jgs_preboot_palad
@@ -0,0 +1,5 @@
+# Copyright 2025 HabanaLabs, Ltd. All Rights Reserved.
