From d67b07e06a5feab131bcea8ef51f01b2c17e3a77 Mon Sep 17 00:00:00 2001
From: Murala S Swamy <ssmurala@habana.ai>
Date: Sat, 31 May 2025 18:47:43 +0300
Subject: [PATCH] [JSW-808] jgs: enable palad build

With this patch, added required config
files to enable palad build.

Change-Id: I4a4706b1e884c73abedaa9161ecd7abbd98a1e61
---

diff --git a/boards/intel/jgs/Kconfig.jgs_mgmt_palad b/boards/intel/jgs/Kconfig.jgs_mgmt_palad
new file mode 100644
index 0000000..ee61dda
--- /dev/null
+++ b/boards/intel/jgs/Kconfig.jgs_mgmt_palad
@@ -0,0 +1,5 @@
+# Copyright 2022 HabanaLabs, Ltd. All Rights Reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+config BOARD_JGS_MGMT_PALAD
+	select SOC_JGS_MGMT
