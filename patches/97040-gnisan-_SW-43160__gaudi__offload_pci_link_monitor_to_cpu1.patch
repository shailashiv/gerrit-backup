From 6edc3f42d5c583ef3495f7bb15ef20aa6017c560 Mon Sep 17 00:00:00 2001
From: Guy Nisan <gnisan@habana.ai>
Date: Sun, 23 May 2021 21:50:57 +0300
Subject: [PATCH] [SW-43160] gaudi: offload pci link monitor to cpu1

PCI link may appear at any stage, not just on boot. It needs to be
monitored and handled swiftly or else the link remains broken.
Preboot contains a good number of routines which may cause a delay to
pci link monitor polling module since they shared the same core.

This patch utilizes the secondary ARM core for PCI link monitoring. This
way is can be done in parallel with the rest of preboot logic.

In addition, PCI link handling (HW WA) was removed from CPU0 PCI module.

Change-Id: I513550aaedf78e0a2d0bbb847931bd24b0915025
Signed-off-by: Guy Nisan <gnisan@habana.ai>
---

diff --git a/Makefile b/Makefile
index ca936b8..465b8a8 100644
--- a/Makefile
+++ b/Makefile
@@ -47,6 +47,7 @@
 PPBOOT_SRCS_C += $(shell ls $(HL_DEV)/common.c)
 PPBOOT_SRCS_C += $(shell ls $(HL_DEV)/$(HL_TARGET).c)
 PPBOOT_APP_S := $(shell ls ppboot/crt0_ppboot.S)
+PPBOOT_APP_S += $(shell ls $(HL_DEV)/*.S | grep -v lds)
 
 BINDIR = bin
 PPBOOT_TARGET = $(BINDIR)/ppboot.bin
diff --git a/gaudi/common.c b/gaudi/common.c
index d46715a..745079f 100644
--- a/gaudi/common.c
+++ b/gaudi/common.c
@@ -28,6 +28,8 @@
 #include <gaudi/gaudi_reg_map.h>
 #include <gaudi/gaudi_fw_if.h>
 #include <common/pci_ids.h>
+#include <cpu_ca53_cfg_regs.h>
+#include <cpu_ca53_cfg_masks.h>
 
 #include <bitops.h>
 #include <preboot.h>
@@ -49,6 +51,10 @@
 #define FW_WORD_NUM		0x2000	/* FW_SIZE / 2 */
 #define PCIE_LTR_DISABLE		0
 #define PCIE_CAP_HDR_NXT_OFFSET		0x1f8
+
+#define CPU1_RST_CTRL							\
+	((BIT(1) << CPU_CA53_CFG_ARM_RST_CONTROL_NCPUPORESET_SHIFT) |	\
+	 (BIT(1) << CPU_CA53_CFG_ARM_RST_CONTROL_NCORERESET_SHIFT))
 
 bool hl_is_debug_mode(enum hl_debug_hw_func func)
 {
@@ -251,27 +257,14 @@
 	reg |= BIT(PCIE_DBI_STATUS_COMMAND_REG_PCI_TYPE0_MEM_SPACE_EN_SHIFT);
 	regmap_writel(reg, mmPCIE_DBI_STATUS_COMMAND_REG);
 }
-
-void preboot_pcie_wait_for_link(void)
+static void preboot_pcie_monitoring(void)
 {
-	u64 start = timestamp_get_us();
-
 	/* Wait for PRSTn */
-	while (!regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN)) {
-		/* If PRSTn does not happen in 5 seconds
-		 * timeout and return
-		 */
-		if (timeout_expired(start, PCIE_WAIT_TIMEOUT_US)) {
-			preboot_puts("Timed-out waiting for PRSTn!\n");
-			return;
-		}
-	}
+	while (!regmap_readl(mmPSOC_GLOBAL_CONF_PRSTN))
+		;
 
 	/* Only after PRSTn is de-asserted */
 	preboot_pcie_enable();
-
-	/* Reset start timer */
-	start = timestamp_get_us();
 
 	while (1) {
 		unsigned int prstn, ltssm, smlh, rdlh;
@@ -281,15 +274,8 @@
 		smlh = regmap_readl(mmPCIE_AUX_SMLH_LINK_UP);
 		rdlh = regmap_readl(mmPCIE_AUX_RDLH_LINK_UP);
 
-		if (prstn && smlh && rdlh) {
-			preboot_puts("PCIe link is UP!\n");
+		if (prstn && smlh && rdlh)
 			break;
-		}
-
-		if (timeout_expired(start, PCIE_WAIT_TIMEOUT_US)) {
-			preboot_puts("Timed-out waiting for PCIe link UP!\n");
-			break;
-		}
 
 		/*
 		 * Some host assert prstn during link up while moving to GEN3
@@ -312,6 +298,46 @@
 	regmap_writel(3, mmPCIE_AUX_LTSSM_EN);
 }
 
+void preboot_secondary_cpu_stop(void)
+{
+	u32 rst_ctrl = regmap_readl(mmCPU_CA53_CFG_ARM_RST_CONTROL);
+
+	rst_ctrl &= ~CPU1_RST_CTRL; /* Reset CPU1 */
+	regmap_writel(rst_ctrl, mmCPU_CA53_CFG_ARM_RST_CONTROL);
+}
+
+void secondary_main(void)
+{
+	preboot_pcie_monitoring();
+
+	/* Hang in WFE until further notice */
+	while (1)
+		wfe();
+}
+
+void preboot_pcie_wait_for_link(void)
+{
+	u32 rst_addr_lsb, rst_addr_msb, rst_ctrl;
+
+	/*
+	 * Call preboot_security_is_enabled() before offloading PCI work to
+	 * CPU1 is needed because we don't want CPU1 to init fuse or access OTP
+	 * while CPU0 is running and may attempt access the same resource.
+	 * Performing this call fills the fuse/OTP cache so a secondary call
+	 * will only read from cache.
+	 */
+	(void)preboot_security_is_enabled();
+
+	rst_addr_lsb = (u32)(uintptr_t)secondary_entry;
+	rst_addr_msb = (u32)(uintptr_t)(((uintptr_t)secondary_entry) >> 32);
+	regmap_writel(rst_addr_lsb, mmCPU_CA53_CFG_RST_ADDR_LSB_1);
+	regmap_writel(rst_addr_msb, mmCPU_CA53_CFG_RST_ADDR_MSB_1);
+
+	rst_ctrl = regmap_readl(mmCPU_CA53_CFG_ARM_RST_CONTROL);
+	rst_ctrl |= CPU1_RST_CTRL; /* Take CPU1 out of reset */
+	regmap_writel(rst_ctrl, mmCPU_CA53_CFG_ARM_RST_CONTROL);
+}
+
 void preboot_delay(void) {}
 
 #define mmPCIE_WRAP_VUART_TX_DATA	0xC01F60
