-#define PCIE_WAIT_TIMEOUT_US		(60 * USEC_PER_SEC)
 #define BTL_SYNC_TIMEOUT_US		(USEC_PER_SEC / 2)
 #define PCIE_EXT_LD_TIMEOUT_US		576
 
@@ -63,6 +62,8 @@
 /* Only BP2 == 0x4 - means 8 blocks - up to 512KB */
 #define PROT_MASK			(READ_STATUS_BP2 | READ_STATUS_SRWD)
 
+extern void secondary_entry(void);
+
 int gaudi_hbm_init(void);
 u32 preboot_get_vendor_id_device_id(void);
 
