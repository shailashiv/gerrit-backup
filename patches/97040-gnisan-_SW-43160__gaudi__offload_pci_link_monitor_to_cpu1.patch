 		__stack_top = . ;
 	} > .sram
 
+	.stack2 : {
+		. = ALIGN(8);
+		__stack2 = . ;
+		. = . + 512 ;
+		__stack_top2 = . ;
+	} > .sram
+
 	.note.gnu.build-id : { *(.note.gnu.build-id) } > .sram
 }
diff --git a/gaudi/secondary.S b/gaudi/secondary.S
new file mode 100644
index 0000000..9ea8492
--- /dev/null
+++ b/gaudi/secondary.S
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier:     GPL-2.0+ */
+/*
+ * Copyright (C) 2017-2021 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+.global secondary_entry
+secondary_entry:
+	ldr	x0, =__stack_top2
+	bic	sp, x0, #0xf	/* 16-byte alignment for ABI compliance */
+	mov	x29, sp		/* Set FP (x29) */
+	bl	secondary_main
diff --git a/goya/common.c b/goya/common.c
index 6a28545..6488f2d 100644
--- a/goya/common.c
+++ b/goya/common.c
@@ -113,10 +113,6 @@
 	}
 }
 
-void preboot_pcie_exec_hw_wa(void)
-{
-}
-
 /*
  * Handle PCIe erratum: make sure reset_n de-asserted only after perst
  * Assume PRSTn tied with cold reset
diff --git a/preboot/fit.c b/preboot/fit.c
index 8ac5370..44bb7e0 100644
--- a/preboot/fit.c
+++ b/preboot/fit.c
@@ -971,6 +971,7 @@
 __weak void preboot_finalize_fw_info(void) {}
 __weak void preboot_finalize_rma_tables(void) {}
 __weak void preboot_finalize_fw_upd_closure(void) {}
+__weak void preboot_secondary_cpu_stop(void) {}
 
 void fit_run_image(void)
 {
@@ -990,6 +991,7 @@
 	preboot_finalize_rma_tables();
 	preboot_finalize_fw_upd_closure();
 	preboot_finalize_enabled_caps();
+	preboot_secondary_cpu_stop();
 	boot_info_finalize();
 	preboot_start_image(startaddr);
 }
