 }
 
-__attribute__((weak)) enum cmd_check_res dev_specific_module_pci_check(void)
+__weak enum cmd_check_res dev_specific_module_pci_check(void)
 {
 	pci_sts.flr_reg_val = regmap_readl(mmPCIE_AUX_FLR_INT);
 	pci_sts.hot_rst_reg_val = regmap_readl(mmPCIE_CORE_HOT_RST) & BIT(0);
diff --git a/preboot/module_uart.c b/preboot/module_uart.c
index 16f3259..339b448 100644
--- a/preboot/module_uart.c
+++ b/preboot/module_uart.c
@@ -19,7 +19,7 @@
 	return FOUND_FAST_RETURN;
 }
 
-__attribute__((weak)) void hl_parse_uart(int val) {}
+__weak void hl_parse_uart(int val) {}
 
 void module_uart_run(void)
 {
diff --git a/preboot/thermal.c b/preboot/thermal.c
index 3cfadf3..e3143cc 100644
