From 5c2c2a3120f5dcefa7d744dd1c4b2e8125ee5d21 Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Sun, 12 Jul 2020 17:01:17 +0300
Subject: [PATCH] [SW-0] compiler: add __weak define

Add define for the "weak" compiler attribute. This is to shorten all the
__attribute__((weak)) directives to just __weak.
This helps with long long lines and aligns the code to what we have in
U-Boot.

Change-Id: Iffae246d5e8b18c3f942c34998c5480a312b91ee
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/common/efuse.c b/common/efuse.c
index 49951ca..3bece08 100644
--- a/common/efuse.c
+++ b/common/efuse.c
@@ -48,7 +48,7 @@
 	return 0;
 }
 
-__attribute__((weak)) int preboot_fuse_read(u32 word, u32 *val)
+__weak int preboot_fuse_read(u32 word, u32 *val)
 {
 	int offset, ret;
 	u32 read_val;
diff --git a/common/pll.c b/common/pll.c
index 0890c80..46a67f0 100644
--- a/common/pll.c
+++ b/common/pll.c
@@ -82,7 +82,7 @@
 	}
 }
 
-__attribute__((weak)) u32 hl_pll_get_freq(u32 pll_base, enum hl_pll_div_out div)
+__weak u32 hl_pll_get_freq(u32 pll_base, enum hl_pll_div_out div)
 {
 	u32 nr, nf, od, div_sel, factor, offset;
 	u64 out_freq = SYS_REF_CLOCK;
diff --git a/gaudi/common.c b/gaudi/common.c
index 58e1516..0113afa 100644
--- a/gaudi/common.c
+++ b/gaudi/common.c
@@ -69,7 +69,7 @@
 	regmap_writel(1, mmPSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
 }
 
-__attribute__((weak)) void preboot_init_pcie_phy(void)
+__weak void preboot_init_pcie_phy(void)
 {
 	/* Reset PCIe PHY */
 	regmap_writel(0, mmPSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
diff --git a/goya2/common.c b/goya2/common.c
index ce194ba..5fa3f6e 100644
--- a/goya2/common.c
+++ b/goya2/common.c
@@ -73,7 +73,7 @@
 	regmap_writel(1, mmPSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
 }
 
-__attribute__((weak)) void preboot_init_pcie_phy(void)
+__weak void preboot_init_pcie_phy(void)
 {
 	/* Reset PCIe PHY */
 	regmap_writel(0, mmPSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
@@ -223,7 +223,7 @@
  * Wait for Boot Manager to complete PCIe image execution
  * and return to idle state, so it won't initiate UART access anymore
  */
-__attribute__((weak)) void preboot_sync_btl(void)
+__weak void preboot_sync_btl(void)
 {
 	while (regmap_readl(mmPSOC_GLOBAL_CONF_BTM_FSM))
 		;
diff --git a/goya2_arc/common.c b/goya2_arc/common.c
index 1dda76b..8abebeb 100644
--- a/goya2_arc/common.c
+++ b/goya2_arc/common.c
@@ -49,7 +49,7 @@
 	regmap_writel(1, mmPSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
 }
 
-__attribute__((weak)) void preboot_init_pcie_phy(void)
+__weak void preboot_init_pcie_phy(void)
 {
 	/* Reset PCIe PHY */
 	regmap_writel(0, mmPSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
diff --git a/goya2_arc_gnu/common.c b/goya2_arc_gnu/common.c
index b119690..a309275 100644
--- a/goya2_arc_gnu/common.c
+++ b/goya2_arc_gnu/common.c
@@ -77,7 +77,7 @@
 	regmap_writel(1, mmPSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
 }
 
-__attribute__((weak)) void preboot_init_pcie_phy(void)
+__weak void preboot_init_pcie_phy(void)
 {
 	/* Reset PCIe PHY */
 	regmap_writel(0, mmPSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
diff --git a/include/preboot.h b/include/preboot.h
index 857ed13..de0212e 100644
--- a/include/preboot.h
+++ b/include/preboot.h
@@ -48,6 +48,9 @@
 #ifndef __packed
 #define __packed	__attribute__((packed))
 #endif
+#ifndef __weak
+#define __weak		__attribute__((weak))
+#endif
 
 typedef unsigned char u8;
 typedef unsigned int u32;
diff --git a/ppboot/ppboot.c b/ppboot/ppboot.c
index 15a1c9b..8aa738c 100644
--- a/ppboot/ppboot.c
+++ b/ppboot/ppboot.c
@@ -40,7 +40,7 @@
 	return image_pending;
 }
 
-__attribute__((weak)) u64 copy_preboot(void)
+__weak u64 copy_preboot(void)
 {
 	char *name = "PREBOOT";
 	struct boot_desc desc;
@@ -109,8 +109,8 @@
 	return false;
 }
 
-__attribute__((weak)) u32 preboot_clr_flops_reset_cause(void) { return 0; }
-__attribute__((weak)) void ppboot_log_waiting_for_pcie(void) {}
+__weak u32 preboot_clr_flops_reset_cause(void) { return 0; }
+__weak void ppboot_log_waiting_for_pcie(void) {}
 
 static void ppboot_pcie_init(void)
 {
@@ -141,7 +141,7 @@
 	regmap_writel(reg, mmCPU_CA53_CFG_ARM_RST_CONTROL);
 }
 
-__attribute__((weak)) void hl_init_pcie_phy_fw(void) {}
+__weak void hl_init_pcie_phy_fw(void) {}
 
 static inline void ppboot_version(void)
 {
diff --git a/ppboot/spi.c b/ppboot/spi.c
index c818647..74459ce 100644
--- a/ppboot/spi.c
+++ b/ppboot/spi.c
@@ -42,7 +42,7 @@
