+__weak void spi_ssi_cs0_get(unsigned int *mask,
 					   unsigned int *data_offset,
 					   unsigned int *out_en_offset)
 {
@@ -200,7 +200,7 @@
 	spi_release_bus();
 }
 
-__attribute__((weak)) void spi_base_get(unsigned int *regs)
+__weak void spi_base_get(unsigned int *regs)
 {
 	*regs = mmPSOC_SPI_CTRLR0;
 }
diff --git a/preboot/fit.c b/preboot/fit.c
index c821ac8..edd3804 100644
--- a/preboot/fit.c
+++ b/preboot/fit.c
@@ -30,7 +30,7 @@
 
 #define FIT_ALGO_PROP_EXPECTED_VALUE	"sha256,rsa3072"
 
-__attribute__((weak)) int fit_need_image_verification(void)
+__weak int fit_need_image_verification(void)
 {
 	return 0;
 }
diff --git a/preboot/module_pci.c b/preboot/module_pci.c
index dda1a08..0089231 100644
--- a/preboot/module_pci.c
+++ b/preboot/module_pci.c
@@ -22,7 +22,7 @@
 	.hot_rst_reg_val = ~1,
 };
 
-__attribute__((weak)) void pci_dev_specific_setup(void) {}
+__weak void pci_dev_specific_setup(void) {}
 
 void module_pci_setup(void)
 {
@@ -30,7 +30,7 @@
