From b671ccef14aa5f033b8e44b6a6c47ff2d354b695 Mon Sep 17 00:00:00 2001
From: Pardha Saradhi Kesapragada <pkesapragada@habana.ai>
Date: Thu, 25 Mar 2021 08:55:24 +0200
Subject: [PATCH] Revert "[SW-30985] gaudi2_arc_gnu: add support to bringup preboot"

This reverts commit 594ca45174b7c04f8f2e373e282089beda3e3ba7.

Change-Id: I7387c38a3545b20f69f53e06f031637293f5ff83
---

diff --git a/gaudi2_arc_gnu/Makefile b/gaudi2_arc_gnu/Makefile
index 5f55fc5..ed41eb2 100644
--- a/gaudi2_arc_gnu/Makefile
+++ b/gaudi2_arc_gnu/Makefile
@@ -1,8 +1,6 @@
 FW_SIZE := 0x8000
 PPBOOT_MAX_SIZE := 16384
 
-LDFLAGS += -Wl,--just-symbols ../arcboot-custom/exports.elf
-
 PREBOOT_SRCS_C += $(shell ls $(HL_DEV)/pll.c)
 #PREBOOT_SRCS_C += $(shell ls preboot/thermal_v2.c)
 PREBOOT_SRCS_C += $(shell ls $(HL_DEV)/security.c)
diff --git a/gaudi2_arc_gnu/common.c b/gaudi2_arc_gnu/common.c
index b5b8750..41347b4 100644
--- a/gaudi2_arc_gnu/common.c
+++ b/gaudi2_arc_gnu/common.c
@@ -36,7 +36,6 @@
 #include "common.h"
 #include <bitops.h>
 #include "preboot/thermal.h"
-#include <arcboot_export.h>
 
 #define FW_WORD_NUM		0x2200	/* FW_SIZE / 2 */
 #define PRODUCT_ID_STR_SIZE	0x8
@@ -447,10 +446,4 @@
 	}
 
 	return PREBOOT_TEXT_BASE;
-}
-
-bool ppboot_load_preboot_img(u64 *loadaddr)
-{
-	*loadaddr = copy_preboot();
-	return true;
 }
diff --git a/gaudi2_arc_gnu/common.h b/gaudi2_arc_gnu/common.h
index 9a9712e..33cd632 100644
--- a/gaudi2_arc_gnu/common.h
+++ b/gaudi2_arc_gnu/common.h
@@ -17,7 +17,7 @@
 #define HL_FW_BOOT_PTRS_BASE		0x80000
 #define HL_SPI_LEGACY_PREBOOT_OFF	0xC0000
 
-#define HL_SP_SRAM_BASE		0x1000007FF7FE0000ULL
+#define HL_SP_SRAM_BASE		0x7FF7FE0000ULL
 #define PCIE_FW_SRAM_BASE	0x27FF0000
 #define FW_SRAM_BASE		0x27FD0000
 #define SP_SRAM_BASE		0x27FE0000
@@ -48,10 +48,13 @@
 #define I2C_SLAVE_ADDRESS	0x6A
 #define I2C_SLAVE_ADDRESS_DBG	I2C_SLAVE_ADDRESS
 
+/* TODO: Check these */
 #define EFUSE_SYSCFG_DISABLE_TWI_IF_MASK        BIT(19)
-#define EFUSE_SYSCFG_FW_VERSION_LOCATION_SPI	BIT(8)
-#define EFUSE_SYSCFG_ENABLE_VALIDATION_MASK	BIT(10)
+#define EFUSE_SYSCFG_FW_VERSION_LOCATION_SPI	BIT(14)
+#define EFUSE_SYSCFG_KEY_LOCATION_SPI		BIT(8)
+#define EFUSE_SYSCFG_REVOKATION_LOCATION_SPI	BIT(6)
 
+#define EFUSE_SYSCFG_ENABLE_VALIDATION_MASK	BIT(10)
 #define RECOVERY_TEXT_BASE	(0x0 + 0x4)
 #define RECOVERY_SIZE		0x4000
 
diff --git a/ppboot/ppboot.c b/ppboot/ppboot.c
index 400aec5..5b43b71 100644
--- a/ppboot/ppboot.c
+++ b/ppboot/ppboot.c
@@ -70,7 +70,7 @@
 	return is_valid;
 }
 
-__weak bool ppboot_load_preboot_img(u64 *loadaddr)
+static bool ppboot_load_preboot_img(u64 *loadaddr)
 {
 	struct boot_desc desc;
 	bool ret;
