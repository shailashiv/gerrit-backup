From 3fd2ae5ad158acfdb11e749d9c5d49cd57e9a07b Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Fri, 31 Jan 2020 12:42:37 +0200
Subject: [PATCH] [SW-0] gaudi: weaken preboot_init_pcie_phy()

In Palladium there is no PCIe PHY

Change-Id: I8875e26e5be7c0d3efa21ca3c259c28a57728007
---

diff --git a/gaudi/common.c b/gaudi/common.c
index 29dc7aa..1871fe5 100644
--- a/gaudi/common.c
+++ b/gaudi/common.c
@@ -39,7 +39,7 @@
 	regmap_writel(1, mmPSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
 }
 
-static void preboot_init_pcie_phy(void)
+__attribute__((weak)) void preboot_init_pcie_phy(void)
 {
 	/* Reset PCIe PHY */
 	regmap_writel(0, mmPSOC_GLOBAL_CONF_PCIE_PHY_RST_N);
diff --git a/gaudi/pldm.c b/gaudi/pldm.c
index c07682b..b2a204d 100644
--- a/gaudi/pldm.c
+++ b/gaudi/pldm.c
@@ -47,3 +47,6 @@
 	/* baud rate doesn't support odd number */
 	return (factor + 1) & 0xFFFE;
 }
+
+void preboot_init_pcie_phy(void) {}
+
