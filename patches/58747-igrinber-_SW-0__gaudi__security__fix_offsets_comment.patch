From 5bf39212215f3cd8489f2d7849dd7cbd0d1bfad2 Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Wed, 04 Nov 2020 20:09:47 +0200
Subject: [PATCH] [SW-0] gaudi: security: fix offsets comment

Fix the hex number in comment.
No functional changes.

Change-Id: I76cc599b05a0770cabd26d6ce545f3ef947eba2c
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/gaudi/security.c b/gaudi/security.c
index 9dafd8b..3877a76 100644
--- a/gaudi/security.c
+++ b/gaudi/security.c
@@ -607,7 +607,7 @@
 	prot_base += SNGL_REG_PROT_SIZE;
 	set_prot_bits_range_all(prot_base, SNGL_REG_PROT_SIZE * 2);
 
-	/* offsets: 0x800 - 0880 as following: */
+	/* offsets: 0x800 - 0x880 as following: */
 	prot_base += SNGL_REG_PROT_SIZE * 2;
 	mask =  ~(PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AR_0) &
 		 PROT_BIT(mmSIF_RTR_CTRL_0_RANGE_SEC_BASE_LOW_AR_1) &
