From 9e149018dd3c4e05c6c3a47caf213f5576d38295 Mon Sep 17 00:00:00 2001
From: Gleb Kodinets <gkodinets@habana.ai>
Date: Thu, 22 Jul 2021 16:02:33 +0300
Subject: [PATCH] [SW-23529] headers: reducing include dependencies

This patch reduces unnesessary include order and
dependencies.

Change-Id: Ib5a616f32cb7074ff9c0f076de94c375420b7aae
---

diff --git a/include/boot_if.h b/include/boot_if.h
index c709295..3e9bb95 100644
--- a/include/boot_if.h
+++ b/include/boot_if.h
@@ -7,8 +7,10 @@
 #ifndef _HL_BOOT_IF_H_
 #define _HL_BOOT_IF_H_
 
-#include <hl_boot_if.h>
-#include <preboot.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <types.h>
+#include <hl_boot_if.h>		/* requires stdint.h */
 
 u32 cpu_boot_cmd_get(void);
 void cpu_boot_cmd_clr_before_wfe(void);
diff --git a/include/memory.h b/include/memory.h
index d34e784..d5ec4e6 100644
--- a/include/memory.h
+++ b/include/memory.h
@@ -7,7 +7,7 @@
 #define _MEMORY_H_
 
 #include <stdint.h>
-#include <stdbool.h>
+#include <types.h>
 
 #include <common.h>
 
