From f5e359d722fe2c39d31dfbec0529c8fba992b469 Mon Sep 17 00:00:00 2001
From: Subrata Chatterjee <schatterjee@habana.ai>
Date: Thu, 09 Jun 2022 18:09:03 +0300
Subject: [PATCH] [SW-70527] gaudi2: ras: remove redundant macro

Removed 2 redundant ring pattern value macros.

Signed-off-by: Subrata Chatterjee <schatterjee@habana.ai>
Change-Id: I12d9249225d6f32eac2d5bc14aeadc76d67c2f92
---

diff --git a/arch/gaudi2/arc/asic.c b/arch/gaudi2/arc/asic.c
index eab19f6..86b6b15 100644
--- a/arch/gaudi2/arc/asic.c
+++ b/arch/gaudi2/arc/asic.c
@@ -359,12 +359,12 @@
 	gaudi2_sms_read_and_check_pattern(expected_ones, expected_zeros);
 
 	if (op == SRAM_SELF_REPAIR_OP_BIST) {
-		regmap_writel(GAUDI2_RING_PATTERN_VAL8, mmPSOC_DFT_APB_WORD0);
+		regmap_writel(GAUDI2_RING_PATTERN_VAL1, mmPSOC_DFT_APB_WORD0);
 		regmap_writel(GAUDI2_RING_PATTERN_VAL9, mmPSOC_DFT_APB_WORD1);
 		udelay(DELAY_5K_USEC);
 
 		regmap_writel(GAUDI2_RING_PATTERN_VAL10, mmPSOC_DFT_APB_WORD0);
-		regmap_writel(GAUDI2_RING_PATTERN_VAL11,  mmPSOC_DFT_APB_WORD1);
+		regmap_writel(GAUDI2_RING_PATTERN_VAL7,  mmPSOC_DFT_APB_WORD1);
 
 		expected_ones = 0b00000000000000000000000000000000;
 		expected_zeros = 0b00000000000000000000000000010000;
diff --git a/arch/gaudi2/common/common.h b/arch/gaudi2/common/common.h
index fd5ad8a..9f4c2d1 100644
--- a/arch/gaudi2/common/common.h
+++ b/arch/gaudi2/common/common.h
@@ -230,10 +230,8 @@
 #define GAUDI2_RING_PATTERN_VAL5		0x1000013
 #define GAUDI2_RING_PATTERN_VAL6		0x9
 #define GAUDI2_RING_PATTERN_VAL7		0x7
-#define GAUDI2_RING_PATTERN_VAL8		0x1000012
 #define GAUDI2_RING_PATTERN_VAL9		0x1
 #define GAUDI2_RING_PATTERN_VAL10		0x100000d
-#define GAUDI2_RING_PATTERN_VAL11		0x7
 #define GAUDI2_RING_PATTERN_VAL12		0x1000008
 #define GAUDI2_RING_PATTERN_VAL13		0x85
 #define GAUDI2_RING_PATTERN_VAL14		0x1000006
