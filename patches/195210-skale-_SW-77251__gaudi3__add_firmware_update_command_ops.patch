From 2c223e3639dcb692a7879646892528c0c104fca8 Mon Sep 17 00:00:00 2001
From: Sanyog Kale <skale@habana.ai>
Date: Thu, 31 Mar 2022 21:48:52 +0300
Subject: [PATCH] [SW-77251] gaudi3: add firmware update command ops

As part of ROM recovery, ROM is expected to support firmware update
via PCIe inband. This patch adds support for firmware update
module operations which will listen on specific registers to receive
command and perform operations accordingly.

Change-Id: I72f62d8054217efffc38a9fadfc82d47d7d55870
---

diff --git a/arch/gaudi2/arc/Makefile b/arch/gaudi2/arc/Makefile
index c9217ac..b679507 100644
--- a/arch/gaudi2/arc/Makefile
+++ b/arch/gaudi2/arc/Makefile
@@ -2,4 +2,4 @@
 
 BINARIES = arcboot_rom.bin arcboot_ram.bin
 
-ARCBOOT_COMMON_SRCS_C := $(filter-out common/fit_regions.c common/fit.c common/memory.c, $(ARCBOOT_COMMON_SRCS_C))
+ARCBOOT_COMMON_SRCS_C := $(filter-out common/fit_regions.c common/fit.c common/memory.c common/module_fwupd.c, $(ARCBOOT_COMMON_SRCS_C))
diff --git a/arch/gaudi3/arc/recovery.c b/arch/gaudi3/arc/recovery.c
index df73d47..f73cf91 100644
--- a/arch/gaudi3/arc/recovery.c
+++ b/arch/gaudi3/arc/recovery.c
@@ -12,6 +12,7 @@
 #include <efuse.h>
 #include <dev_common.h>
 #include <dev_efuse.h>
+#include <device.h>
 
 static struct cmd_module_ops cmd_ops[] = {
 	{	/* PCI module */
@@ -24,6 +25,16 @@
 		.teardown = module_pci_teardown,
 		.run_noreturn = noop,
 	},
+	{	/* FW UPD module */
+		.setup = module_fwupd_setup,
+		.check = module_fwupd_check,
+		.disable = noop,
+		.run = module_fwupd_run,
+		.enable = noop,
+		.run_fast = module_fwupd_run_fast,
+		.teardown = noop,
+		.run_noreturn = module_fwupd_run_noret,
+	},
 };
 
 static void execute_erom_recovery(void)
diff --git a/arch/greco/arc_elf32/Makefile b/arch/greco/arc_elf32/Makefile
index 4d3384c..729142f 100644
--- a/arch/greco/arc_elf32/Makefile
+++ b/arch/greco/arc_elf32/Makefile
@@ -1,3 +1,3 @@
 BINARIES = arcboot_rom.bin arcboot_ram.bin
 
-ARCBOOT_COMMON_SRCS_C := $(filter-out common/fit_regions.c common/fit.c common/memory.c, $(ARCBOOT_COMMON_SRCS_C))
