diff --git a/lib/common/boot_if.c b/lib/common/boot_if.c
index bfc8866..f969a16 100644
--- a/lib/common/boot_if.c
+++ b/lib/common/boot_if.c
@@ -12,23 +12,22 @@
 #include <preboot.h>
 #include <hl_boot_if.h>			/* requires stdint.h */
 
-/* TODO: add support for both registers of status and error */
 struct cpu_boot_if {
 	u32 status;	/* boot progress status register offset */
 	u32 response;
-	u32 err;
-	u32 dev_sts;
+	u32 err[2];
+	u32 dev_sts[2];
 	/* Shadow the status and error registers */
-	u32 dev_sts_val;
-	u32 err_val;
+	u32 dev_sts_val[2];
+	u32 err_val[2];
 	u32 status_val;	/* boot progress status value */
 };
 
 static struct cpu_boot_if cpu_boot_if = {
 	.status = mmPSOC_GLOBAL_CONF_CPU_BOOT_STATUS,
 	.response = mmCPU_CMD_STATUS_TO_HOST,
-	.err = mmCPU_BOOT_ERR0,
-	.dev_sts = mmCPU_BOOT_DEV_STS0,
+	.err = { mmCPU_BOOT_ERR0, mmCPU_BOOT_ERR1 },
+	.dev_sts = { mmCPU_BOOT_DEV_STS0, mmCPU_BOOT_DEV_STS1 },
 };
 
 /*
@@ -59,14 +58,18 @@
 
 void cpu_boot_if_init(void)
 {
-	cpu_boot_if.dev_sts_val = regmap_readl(cpu_boot_if.dev_sts);
-	cpu_boot_if.err_val = regmap_readl(cpu_boot_if.err);
+	cpu_boot_if.dev_sts_val[0] = regmap_readl(cpu_boot_if.dev_sts[0]);
+	cpu_boot_if.dev_sts_val[1] = regmap_readl(cpu_boot_if.dev_sts[1]);
+	cpu_boot_if.err_val[0] = regmap_readl(cpu_boot_if.err[0]);
+	cpu_boot_if.err_val[1] = regmap_readl(cpu_boot_if.err[1]);
 }
 
 void cpu_boot_if_fix_ro_regs(void)
 {
-	regmap_writel(cpu_boot_if.dev_sts_val, cpu_boot_if.dev_sts);
-	regmap_writel(cpu_boot_if.err_val, cpu_boot_if.err);
+	regmap_writel(cpu_boot_if.dev_sts_val[0], cpu_boot_if.dev_sts[0]);
+	regmap_writel(cpu_boot_if.dev_sts_val[1], cpu_boot_if.dev_sts[1]);
+	regmap_writel(cpu_boot_if.err_val[0], cpu_boot_if.err[0]);
+	regmap_writel(cpu_boot_if.err_val[1], cpu_boot_if.err[1]);
 	regmap_writel(cpu_boot_if.status_val, cpu_boot_if.status);
 }
 
@@ -74,10 +77,14 @@
 {
 	u32 *shadow;
 
-	if (reg == cpu_boot_if.dev_sts)
-		shadow = &cpu_boot_if.dev_sts_val;
-	else if (reg == cpu_boot_if.err)
-		shadow = &cpu_boot_if.err_val;
+	if (reg == cpu_boot_if.dev_sts[0])
+		shadow = &cpu_boot_if.dev_sts_val[0];
+	else if (reg == cpu_boot_if.dev_sts[1])
+		shadow = &cpu_boot_if.dev_sts_val[1];
+	else if (reg == cpu_boot_if.err[0])
+		shadow = &cpu_boot_if.err_val[0];
+	else if (reg == cpu_boot_if.err[1])
+		shadow = &cpu_boot_if.err_val[1];
 	else
 		return;
 
@@ -88,21 +95,22 @@
 	regmap_writel(*shadow, reg);
 }
 
-/* We support only ERR0 for now */
-void cpu_boot_err_clrset(u32 mask, bool set)
+void cpu_boot_err_clrset(u64 mask, bool set)
 {
-	cpu_boot_reg_clrset(cpu_boot_if.err, mask, set);
+	cpu_boot_reg_clrset(cpu_boot_if.err[0], (u32)mask, set);
+	cpu_boot_reg_clrset(cpu_boot_if.err[1], (u32)(mask >> 32), set);
 }
 
-bool cpu_boot_err_get(u32 mask)
+bool cpu_boot_err_get(u64 mask)
 {
-	return !!(cpu_boot_if.err_val & mask);
+	return !!((cpu_boot_if.err_val[0] & (u32)mask) |
+		  (cpu_boot_if.err_val[1] & (u32)(mask >> 32)));
 }
 
-/* We support only STS0 for now */
-void cpu_boot_dev_sts_clrset(u32 mask, bool set)
+void cpu_boot_dev_sts_clrset(u64 mask, bool set)
 {
-	cpu_boot_reg_clrset(cpu_boot_if.dev_sts, mask, set);
+	cpu_boot_reg_clrset(cpu_boot_if.dev_sts[0], (u32)mask, set);
+	cpu_boot_reg_clrset(cpu_boot_if.dev_sts[1], (u32)(mask >> 32), set);
 }
 
 void cpu_boot_rsp_set(enum cpu_msg_status sts)
@@ -117,7 +125,7 @@
 
 u64 cpu_boot_dev_sts_get_all(void)
 {
-	u64 val = cpu_boot_if.dev_sts_val;
+	u64 val = cpu_boot_if.dev_sts_val[1];
 
-	return val;
+	return val << 32 | cpu_boot_if.dev_sts_val[0];
 }
