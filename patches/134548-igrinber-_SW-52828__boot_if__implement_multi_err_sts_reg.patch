From d66416bfdef2d36527e5bce2b24f8bd1ca515ee8 Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Thu, 30 Sep 2021 19:20:00 +0300
Subject: [PATCH] [SW-52828] boot_if: implement multi err/sts reg

Implement the multiple registers use for both the errors and device
status bits.
Update the existing internal API and update all users.

Change-Id: I215aaa74af6dabc1e3aa682053d6cfe04e426b6e
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/app/ppboot/ppboot.c b/app/ppboot/ppboot.c
index 886308a..8462b05 100644
--- a/app/ppboot/ppboot.c
+++ b/app/ppboot/ppboot.c
@@ -32,7 +32,8 @@
 				     struct boot_desc *desc, bool is_prime)
 {
 	bool is_valid = true;
-	u32 idx, bit;
+	u32 idx;
+	u64 boot_err;
 	char *msg;
 
 	idx = boot_desc_get_img_desc(image_pending, HL_FW_IMG_PREBOOT, desc);
@@ -58,13 +59,13 @@
 	}
 	if (!is_valid) {
 		if (is_prime) {
-			bit = CPU_BOOT_ERR0_PRI_IMG_VER_FAIL;
+			boot_err = BIT_ULL(CPU_BOOT_ERR_PRI_IMG_VER_FAIL);
 			msg = "Primary";
 		} else {
-			bit = CPU_BOOT_ERR0_SEC_IMG_VER_FAIL;
+			boot_err = BIT_ULL(CPU_BOOT_ERR_SEC_IMG_VER_FAIL);
 			msg = "Secondary";
 		}
-		cpu_boot_err_clrset(bit, true);
+		cpu_boot_err_clrset(boot_err, true);
 		preboot_puts_raw(msg);
 		preboot_puts(" is not a valid image.\n");
 	}
@@ -207,7 +208,7 @@
 	bool is_debug_en;
 
 	is_debug_en = hl_is_jtag_enabled();
-	cpu_boot_dev_sts_clrset(CPU_BOOT_DEV_STS0_DEBUG_EN, is_debug_en);
+	cpu_boot_dev_sts_clrset(BIT_ULL(CPU_BOOT_DEV_STS_DEBUG_EN), is_debug_en);
 	reg = regmap_readl(mmCPU_CA53_CFG_ARM_RST_CONTROL);
 	if (is_debug_en)
 		reg |= BIT(12);
@@ -249,7 +250,7 @@
 	if (__stack != STACK_CANARY_MAGIC_WORD) {
 		preboot_puts("The stack has overflowed\n");
 		preboot_puts_hex("Stack Canary value = ", __stack, false);
-		cpu_boot_err_clrset(CPU_BOOT_ERR0_BOOT_FW_CRIT_ERR, true);
+		cpu_boot_err_clrset(BIT_ULL(CPU_BOOT_ERR_BOOT_FW_CRIT_ERR), true);
 	}
 
 	ppboot_check_stack_mon_dev_specific();
