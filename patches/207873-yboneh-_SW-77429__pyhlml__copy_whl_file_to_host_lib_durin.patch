From 12fae74b500473919b469c443fd988ff96250fdb Mon Sep 17 00:00:00 2001
From: Yahav Boneh <yboneh@habana.ai>
Date: Tue, 10 May 2022 22:41:09 +0300
Subject: [PATCH] [SW-77429] pyhlml: copy whl file to host/lib during build

Copy pyhlml's whl file to host/lib during build

Change-Id: I5747e1b787c3ada25536311451faafbbe9547116
Signed-off-by: Yahav Boneh <yboneh@habana.ai>
---

diff --git a/package/hl-smi/hl-smi.mk b/package/hl-smi/hl-smi.mk
index 1f23f93..8c97f2c 100644
--- a/package/hl-smi/hl-smi.mk
+++ b/package/hl-smi/hl-smi.mk
@@ -11,6 +11,8 @@
 	$(INSTALL) -s -D -m 0755 $(@D)/bin/hl-smi $(BINARIES_DIR)/hl-smi
 	$(INSTALL) -D -m 0644 $(@D)/lib/libhlml.a $(HOST_DIR)/lib/libhlml.a
 	$(INSTALL) -D -m 0644 $(@D)/lib/libhlml.so $(HOST_DIR)/lib/libhlml.so
+	$(eval PYHLML_WHL_FILE := $(shell basename $(shell ls $(@D)/lib/*.whl | awk '{$$1=$$1;print}')))
+	$(INSTALL) -D -m 0644 $(@D)/lib/$(PYHLML_WHL_FILE) $(HOST_DIR)/lib/$(PYHLML_WHL_FILE)
 	$(INSTALL) -D -m 0644 $(SPECS_EMBEDDED_DIR)/hlml.h $(HOST_DIR)/include/hlml.h
 endef
 
