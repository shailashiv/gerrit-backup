From 4f7d299dd8b425e9096e21b933852232136dcc9c Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Tue, 23 Apr 2019 11:29:13 +0300
Subject: [PATCH] [SW-0] pll: remove duplicate hl_pll_bypass_set()

We can use hl_pll_bypass() instead

Change-Id: Ica63f8d9bd9d1a2c4e2f70c52b9c84891fb03cdc
---

diff --git a/common/pll.c b/common/pll.c
index 97135f8..8727c9d 100644
--- a/common/pll.c
+++ b/common/pll.c
@@ -17,19 +17,6 @@
 	return regmap_readl(cfg->base + HL_PLL_DIV_SEL + offset);
 }
 
-static void hl_pll_bypass_set(struct hl_pll_cfg *cfg, enum hl_pll_div_out out)
-{
-	int offset = out * sizeof(u32);
-
-	if (cfg->div_factor[out] == -1)
-		regmap_writel(HL_PLL_REF_CLK,
-				cfg->base + HL_PLL_DIV_SEL + offset);
-	else
-		regmap_writel(cfg->div_factor[out] ?
-				HL_PLL_DIV_PLL : HL_PLL_PLL_CLK,
-				cfg->base + HL_PLL_DIV_SEL + offset);
-}
-
 static void hl_pll_udelay(unsigned int usec)
 {
 	int pll_num;
@@ -180,7 +167,7 @@
  */
 int hl_pll_init(unsigned int *pll_partial_init)
 {
-	int i, pll_num, sel;
+	int i, pll_num;
 	struct hl_pll_cfg *hl_pll_cfg;
 	enum hl_pll_bypass_val bval;
 
@@ -199,8 +186,7 @@
 			continue;
 
 		if (*pll_partial_init)
-			for (sel = 0; sel < HL_PLL_DIV_SIZE; sel++)
-				hl_pll_bypass_set(hl_pll_cfg + i, sel);
+			hl_pll_bypass(hl_pll_cfg + i, false);
 		else
 			hl_pll_set(hl_pll_cfg + i);
 	}
