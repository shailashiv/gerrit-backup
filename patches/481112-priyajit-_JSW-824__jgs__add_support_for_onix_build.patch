From 492367ec2199f13eb6fb513c969bb4c01450e142 Mon Sep 17 00:00:00 2001
From: Priyajit Ghosh <prghosh@habana.ai>
Date: Wed, 04 Jun 2025 14:36:11 +0300
Subject: [PATCH] [JSW-824] jgs: add support for onix build

This patch adds support n buildroot-external
to build onix for jgs

Change-Id: If35edf83f8da6faae9a732f719c11fd97aeedfb7
---

diff --git a/configs/jgs_onix_defconfig b/configs/jgs_onix_defconfig
new file mode 100644
index 0000000..6b096e2
--- /dev/null
+++ b/configs/jgs_onix_defconfig
@@ -0,0 +1,34 @@
+BR2_USE_MMU=y
+BR2_arcle=y
+BR2_archs4x=y
+BR2_SVN="svn"
+BR2_DL_DIR="$(BR2_EXTERNAL_HABANALABS_PATH)/dl"
+BR2_SHARED_STATIC_LIBS=y
+BR2_PACKAGE_OVERRIDE_FILE="$(BR2_EXTERNAL_HABANALABS_PATH)/board/habanalabs/jgs/jgs-local.mk"
+BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_HABANALABS_PATH)/board/habanalabs/common/patches"
+BR2_TOOLCHAIN_EXTERNAL=y
+BR2_TARGET_GENERIC_HOSTNAME=""
+BR2_TARGET_GENERIC_ISSUE=""
+BR2_INIT_NONE=y
+BR2_SYSTEM_BIN_SH_NONE=y
+# BR2_TARGET_GENERIC_GETTY is not set
+BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_HABANALABS_PATH)/board/habanalabs/jgs/jgs-post-image-fit-arc.sh $(BR2_EXTERNAL_HABANALABS_PATH)/board/habanalabs/jgs/jgs-post-image-spi-arc_global.sh $(BR2_EXTERNAL_HABANALABS_PATH)/board/habanalabs/jgs/post-image-agents.sh"
+BR2_PACKAGE_BAREMETAL=y
+BR2_PACKAGE_DSM=n
+BR2_PACKAGE_PREBOOT=y
+BR2_PACKAGE_MGMT=y
+BR2_PACKAGE_MGMT_COMPUTE=n
+BR2_PACKAGE_RESET=y
+#BR2_POST_IMAGE_FW_LOADER_ITS_TEMPLATE="$(BR2_EXTERNAL_HABANALABS_PATH)/board/habanalabs/jgs/agent-fw_loader.its"
+BR2_PIC_PIE=n
+BR2_SSP_NONE=y
+BR2_RELRO_NONE=y
+BR2_FORTIFY_SOURCE_NONE=y
+BR2_PACKAGE_PALAD_BLOADER=y
+BR2_PACKAGE_HOST_UBOOT_TOOLS=y
+BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT=y
+BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SIGNATURE_SUPPORT=y
+BR2_PACKAGE_ARCBOOT=y
+BR2_PACKAGE_PREBOOT_COMPUTE=n
+BR2_PACKAGE_RESET_COMPUTE=n
+#BR2_PACKAGE_AGENT_FWL=y
