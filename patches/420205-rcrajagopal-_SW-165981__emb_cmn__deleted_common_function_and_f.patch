-static int fit_verify_security(const void *fit, int noffset,
-			       enum fit_sec_failure *res)
-{
-	if (!preboot_img_validation_is_enabled())
-		return 0;
-
-	if (!fit_svn_is_valid(fit)) {
-		*res = FIT_SEC_SVN_INVALID;
-		return 1;
-	}
-
-	/* Security in enabled and SV is valid all thats left is to check the
-	 * signature on the FIT.
-	 */
-	return fit_verify_config(fit, noffset, res);
-}
