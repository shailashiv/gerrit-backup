-	u64 load, start;
-	const char *cmpr;
-	size_t fit_size = fdt_totalsize(fit);
-	bool halted_secondary_cpu = false;
-	const uint32_t *core_id;
-
-	/* Check if image supports a minimum FDT version or newer */
-	if (fdt_version(fit) < FDT_MIN_SUPPORTED_VERSION)
-		return FIT_LOAD_SEC_FAILED;
-
-	/* check that the calculated memory range are legal */
-	if (!preboot_sram_is_valid_address_range((uintptr_t)fit, fit_size))
-		return FIT_LOAD_SEC_FAILED;
-
-	/* Get number of images in preboot configuration */
-	conf = fit_find_config_node(fit);
-	if (conf < 0)
-		return FIT_LOAD_CORRUPTED;
-
-	if (!fit_load_is_runnable(fit, conf))
-		return FIT_LOAD_CORRUPTED;
-
-	if (fit_verify_image(fit, fit_size, conf, res))
-		return FIT_LOAD_SEC_FAILED;
-
-	num_images = fdt_stringlist_count(fit, conf, FIT_LOADABLE_PROP);
-	if (num_images > FIT_MAX_IMAGES) {
-		preboot_puts_hex("Images in fit exceeds max limit: ",
-					FIT_MAX_IMAGES, false);
-		return FIT_LOAD_CORRUPTED;
-	} else if (num_images < 0) {
-		preboot_puts_hex("Cant read images from fit: ",
-					-num_images, false);
-		return FIT_LOAD_CORRUPTED;
-	}
-
-	for (i = 0; i < num_images; i++) {
-		node = fit_loadables_node_get(fit, i);
-		if (node < 0) {
-			preboot_puts_hex("Wrong FIT format: loadable image not found: ", i, false);
-			return FIT_LOAD_NOT_RUNNABLE;
-		}
-
-		if (fit_getprop_u64(fit, node, FIT_LOADADDR_PROP, &load)) {
-			preboot_puts_hex("Wrong FIT format: loadaddr not found for image: ", i, false);
-			return FIT_LOAD_BAD_LOAD_ADDR;
-		}
-		if (fit_getprop_u64(fit, node, FIT_STARTADDR_PROP, &start))
-			start = load;
-
-		buf = fdt_getprop(fit, node, FIT_DATA_PROP, &len);
-		if (!buf) {
-			preboot_puts_hex("Wrong FIT format: data empty for image: ", i, false);
-			return FIT_LOAD_CORRUPTED;
-		}
-
-		if (fit_node_check_hash(fit, node, buf, len)) {
-			preboot_puts_hex("FIT loadable corrupted: bad hash for image: ", i, false);
-			return FIT_LOAD_CORRUPTED;
-		}
-
-		cmpr = (const char *)fdt_getprop(fit, node,
-						 FIT_COMPRESSION_PROP,
-						 NULL);
-		if (!cmpr) {
-			/*
-			 * mkimage is adding compression, if it's missing then
-			 * something is wrong.
-			 */
-			preboot_puts_hex("Wrong FIT format: missing compression: ", i, false);
-			return FIT_LOAD_CORRUPTED;
-		}
-
-		if (!strcmp(cmpr, "none"))
-			image_len = len;
-		else
-			image_len = len * COMPRESSION_FACTOR;
-
-		if (!preboot_is_valid_address_range(load, image_len)) {
-			preboot_puts_hex("FIT: invalid load address for image: ", i, false);
-			return FIT_LOAD_BAD_LOAD_ADDR;
-		}
-
-		images[i].arch = (const char *)fdt_getprop(fit, node,
-							FIT_ARCH_PROP, NULL);
-		if (!images[i].arch) {
-			preboot_puts_hex("Wrong FIT format: arch empty for image: ", i, false);
-			return FIT_LOAD_CORRUPTED;
-		}
-
-		if (!halted_secondary_cpu && fit_image_is_for_arc0(fit, i)) {
-			if (!is_pcie_initialized())
-				preboot_puts("Warning: ARC0 busy with PCI init, halting anyway\n");
-
-			preboot_secondary_cpu_stop();
-			halted_secondary_cpu = true;
-		}
-
-		images[i].loadaddr = load;
-		images[i].startaddr = start;
-
-		if (fit_is_core_id_supported()) {
-			core_id = fdt_getprop(fit, node, HL_FIT_CORE_ID_PROP, &core_id_len);
-			if (!core_id)
-				return FIT_LOAD_CORRUPTED;
-
-			if (core_id_len != sizeof(*core_id))
-				return FIT_LOAD_CORRUPTED;
-
-			images[i].core_id = fdt32_to_cpu(*core_id);
-			if (fit_process_core_id((enum fit_core_id)images[i].core_id))
-				return FIT_LOAD_CORRUPTED;
-		}
-
-		if (fit_copy_image(load, buf, len, images[i].arch, cmpr))
-			return FIT_LOAD_CORRUPTED;
-	}
-
-	preboot_security_boot_info_write_key_idx(&preboot_key_idx);
-
-	return FIT_LOAD_SUCCESS;
-}
-
-static void fit_report_err(enum fit_load_result err,
-			   enum fit_sec_failure sec_res)
-{
-	enum hl_fw_fit_boot_error boot_err = HL_FW_FIT_BOOT_ERR_NONE;
-
-	switch (err) {
-	case FIT_LOAD_BAD_LOAD_ADDR:
-		boot_err = HL_FW_FIT_BOOT_ERR_ADDRESS_VIOLATION;
-		break;
-	case FIT_LOAD_NOT_RUNNABLE:
-		boot_err = HL_FW_FIT_BOOT_ERR_NOT_RUNNABLE;
-		break;
-	case FIT_LOAD_CORRUPTED:
-		boot_err = HL_FW_FIT_BOOT_ERR_CORRUPTED;
-		break;
-	case FIT_LOAD_SEC_FAILED:
-
-		switch (sec_res) {
-		case FIT_SEC_SVN_INVALID:
-			boot_err = HL_FW_FIT_BOOT_ERR_SVN;
-			break;
-		case FIT_SEC_KEY_REVOKED:
-			boot_err = HL_FW_FIT_BOOT_ERR_REVOKED_KEY;
-			break;
-		case FIT_SEC_SIGN_FAILED:
-			boot_err = HL_FW_FIT_BOOT_ERR_SIGNATURE;
-			break;
-		default:
-			break;
-		}
-
-		break;
-	default:
-		break;
-	};
-
-	oob_set_boot_err(boot_err, false);
-}
-
-static int fwupd_sec_convert_min_error(enum fit_sec_failure err)
-{
-	int serr;
-
-	switch (err) {
-	case FIT_SEC_KEY_REVOKED:
-		serr = HL_SEC_ERR_KEY_REVOKED;
-		break;
-	case FIT_SEC_SVN_INVALID:
-		serr = HL_SEC_ERR_SVN_INVALID;
-		break;
-	case FIT_SEC_SIGN_FAILED:
-		serr = HL_SEC_ERR_SIGN_FAILED;
-		break;
-	default:
-		serr = FIT_SEC_NONE;
-	};
-
-	return serr;
-}
-
-void fit_load_print_error(enum fit_load_result errtype)
-{
-	switch (errtype) {
-	case FIT_LOAD_BAD_LOAD_ADDR:
-	case FIT_LOAD_NOT_RUNNABLE:
-	case FIT_LOAD_CORRUPTED:
-		preboot_puts("FIT loading failed\n");
-		break;
-	case FIT_LOAD_SEC_FAILED:
-		preboot_puts("FIT security validation failed\n");
-		break;
-	default:
-		preboot_puts_hex("unrecognized error value for: fit_load_result",
-			(unsigned int)errtype, false);
-		break;
-	}
-}
-
-void fit_format_print_error(enum fit_format_result errtype)
-{
-	switch (errtype) {
-	case FIT_FORMAT_HEADER_CHECK_FAILED:
-		preboot_puts("FIT header check failed\n");
-		break;
-	case FIT_FORMAT_NO_DESCRIPTION:
-		preboot_puts("Wrong FIT format: no description\n");
-		break;
-	case FIT_FORMAT_NO_IMAGES_PARENT_NODE:
-		preboot_puts("Wrong FIT format: no images parent node\n");
-		break;
-	case FIT_FORMAT_CURRUPTED_LOAD_TYPE:
-		preboot_puts("Currupted load type\n");
-		break;
-	case FIT_FORMAT_UNSUPPORTED_LOAD_TYPE:
-		preboot_puts("Unsupported load type\n");
-		break;
-	default:
-		preboot_puts_hex("unrecognized error value for: fit_format_result",
-			(unsigned int)errtype, false);
-		break;
-	}
-}
-
-int fit_load_images(void *fit)
-{
-	enum fit_sec_failure sec_res = FIT_SEC_NONE;
-	enum fit_load_result fit_load_error;
-	enum fit_format_result fit_format_error;
-
-	memset(&images, 0x0, sizeof(images));
-
-	fit_format_error = fit_check_format(fit);
-	if (fit_format_error) {
-		fit_format_print_error(fit_format_error);
-		fit_load_error = FIT_LOAD_CORRUPTED;
-	} else {
-		fit_load_error = fit_copy_images(fit, &sec_res);
-	}
-
-
-	cpu_boot_err_clrset(BIT_ULL(CPU_BOOT_ERR_FIT_CORRUPTED) |
-			    BIT_ULL(CPU_BOOT_ERR_SECURITY_FAIL), false);
-	switch (fit_load_error) {
-	case FIT_LOAD_SUCCESS:
-		return FIT_LOAD_SUCCESS;
-	case FIT_LOAD_SEC_FAILED:
-		cpu_boot_err_set(CPU_BOOT_ERR_SECURITY_FAIL);
-		preboot_error_inform(HL_FW_ERR_SECURITY,
-				     fwupd_sec_convert_min_error(sec_res));
-		break;
-	default:
-		cpu_boot_err_set(CPU_BOOT_ERR_FIT_CORRUPTED);
-		preboot_error_inform(HL_FW_ERR_FIT, fit_load_error);
-		break;
-	}
-
-	fit_report_err(fit_load_error, sec_res);
-	fit_load_print_error(fit_load_error);
-
-	return fit_load_error;
-}
-
-__weak void preboot_finalize_fw_info(void) {}
-__weak void preboot_finalize_rma_tables(void) {}
-__weak void preboot_finalize_fw_upd_closure(void) {}
-
-void fit_run_image(void)
-{
-	u64 startaddr = 0;
-	bool valid_arc_img = false;
-	u32 i;
-
-	for (i = 0; i < FIT_MAX_IMAGES; i++) {
-
-		/*
-		 * Below check to detect end of valid images
-		 * in images array.
-		 */
-		if (!images[i].arch)
-			break;
-
-		if (!(strcmp(images[i].arch, "arm64")))
-			startaddr = images[i].startaddr;
-
-		if (!(strcmp(images[i].arch, "arc"))) {
-			valid_arc_img = true;
-
-			if (fit_is_core_id_supported()) {
-				/* start ARC1 image in end, so skip running arc1 image here */
-				if (!(fit_process_core_id(images[i].core_id))) {
-					startaddr = images[i].startaddr;
-					continue;
-				}
-			}
-		}
-
-		if ((valid_arc_img) && (startaddr))
-			break;
-	}
-
-	preboot_finalize_nic_en();
-	preboot_finalize_fw_info();
-	preboot_finalize_rma_tables();
-	preboot_finalize_fw_upd_closure();
-	preboot_finalize_enabled_caps();
-	preboot_finalize_uboot_override();
-	hl_boot_info_finalize();
-	preboot_start_image(startaddr, valid_arc_img);
-}
-
-__weak size_t preboot_get_img_sec_desc_size(void)
-{
-	return 0;
-}
-
-int fit_validate_size(const void *fit, int len)
-{
-	size_t img_size = ROUND_UP4(fdt_totalsize(fit));
-
-	if (fdt_check_header(fit)) {
-		preboot_puts("Bad FIT header\n");
-		return 1;
-	}
-
-	/* taking the security footer into account */
-	img_size += preboot_get_img_sec_desc_size();
-
-	return img_size != len;
-}
-
-int fit_get_load_type(const void *fit, u32 *load_type)
-{
-	const u32 *cell;
-	u32 type = FIT_LOAD_TYPE_RUN;
-	int ret, len, conf;
-
-	ret = fit_check_format(fit);
-	if (ret)
-		return ret;
-
-	conf = fit_find_config_node(fit);
-	if (conf >= 0) {
-		cell = fdt_getprop(fit, conf, FIT_LOAD_TYPE_PROP, &len);
-		if (!cell) {
-			preboot_puts("No load type. Assuming old FIT version\n");
-			*load_type = type;
-			return FIT_FORMAT_SUCCESS;
-		}
-		if (len != sizeof(*cell))
-			return FIT_FORMAT_CURRUPTED_LOAD_TYPE;
-
-		type = fdt32_to_cpu(*cell);
-		if (type >= FIT_LOAD_TYPE_COUNT)
-			return FIT_FORMAT_UNSUPPORTED_LOAD_TYPE;
-	}
-
-	*load_type = type;
-
-	return ret;
-}
-
-static int fit_image_get_data(const void *fit, int noffset,
-		       const void **data, size_t *size)
-{
-	int len;
-
-	*data = fdt_getprop(fit, noffset, FIT_DATA_PROP, &len);
-	if (*data == NULL) {
-		*size = 0;
-		return -1;
-	}
-
-	*size = len;
-	return 0;
-}
-
-static int fit_image_get_node(const void *fit, const char *image_uname)
-{
-	int noffset, images_noffset;
-
-	images_noffset = fdt_path_offset(fit, FIT_IMAGES_PATH);
-	if (images_noffset < 0) {
-		preboot_puts("Can't find images parent node\n");
-		return images_noffset;
-	}
-
-	noffset = fdt_subnode_offset(fit, images_noffset, image_uname);
-	if (noffset < 0)
-		preboot_puts("Can't get node offset for image unit name\n");
-
-	return noffset;
-}
-
-static int fit_conf_get_prop_node_index(const void *fit, int noffset,
-				 const char *prop_name, int index)
-{
-	const char *uname;
-	int len;
-
-	/* get image unit name from configuration property */
-	uname = fdt_stringlist_get(fit, noffset, prop_name, index, &len);
-	if (uname == NULL)
-		return len;
-
-	return fit_image_get_node(fit, uname);
-}
-
-int fit_image_get_loadable_data(const void *fit, const void **data,
-				size_t size)
-{
-	size_t actual_size;
-	int err, node, conf;
-
-	conf = fit_find_config_node(fit);
-	if (conf < 0)
-		return 1;
-
-	node = fit_conf_get_prop_node_index(fit, conf, FIT_LOADABLE_PROP, 0);
-	if (node < 0)
-		return 1;
-
-	err = fit_image_get_data(fit, node, data, &actual_size);
-	if (err)
-		return err;
-
-	if (actual_size != size)
-		return 1;
-
-	return 0;
-}
-
-#define HL_SEC_REGIONS_CNT	2
-#define HL_SEC_KEY_NAME		"hl_rsa3072"
-
-int fit_verify_img_sig(const void *img, size_t img_size, const void *sec_desc,
-		       size_t sec_desc_size, const void *pub_key_fit,
-		       const u8 *sig, size_t sig_len)
-{
-	const char *key_name = HL_SEC_KEY_NAME;
-	struct rsa_key_prop prop;
-	struct image_region region[HL_SEC_REGIONS_CNT];
-
-	if (fit_get_key_prop(pub_key_fit, key_name, &prop))
-		return 1;
-
-	/*
-	 * region 0 holds the fit image as a whole,
-	 * region 1 holds the hl security descriptor
-	 */
-	region[0].data = img;
-	region[0].size = img_size;
-	region[1].data = sec_desc;
-	region[1].size = sec_desc_size;
-
-	return rsa_verify_regions(region, HL_SEC_REGIONS_CNT, sig, sig_len,
-				  &prop);
-}
