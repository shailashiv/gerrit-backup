-static int fit_get_pub_key(const void *fit, int noffset, int sig_sub_node,
-			   const void **pub_key_fit, enum fit_sec_failure *res)
-{
-	int node, key_len, pub_key_node;
-	const void *key_ext_data = NULL;
-	const void *key_data;
-	const char *key_name;
-	int key_ext_len = 0;
-
-	node = fit_pub_key_node_get(fit, noffset);
-	if (node < 0) {
-		preboot_puts("Wrong FIT format missing pubkey\n");
-		return 1;
-	}
-
-	key_data = fdt_getprop(fit, node, FIT_DATA_PROP, &key_len);
-	if (!key_data) {
-		preboot_puts("Wrong FIT format: missing pubkey fit\n");
-		return 1;
-	}
-
-	preboot_key_idx = fit_get_int(fit, 0, FIT_SEC_KEY_IDX, -1);
-	if (preboot_key_idx < 0) {
-		preboot_puts("Wrong FIT format: missing key idx\n");
-		return 1;
-	}
-
-	*pub_key_fit = key_data;
-	if (!preboot_security_key_montgomery_is_valid())
-		goto key_validation;
-
-	/* Get modulus from public key */
-	if (fdt_check_header(*pub_key_fit)) {
-		preboot_puts("FITkey header check failed\n");
-		return 1;
-	}
-
-	if (get_key_name(fit, sig_sub_node, &key_name))
-		return 1;
-
-	pub_key_node = get_pub_key_node(*pub_key_fit, key_name);
-	if (pub_key_node < 0) {
-		preboot_puts("Wrong FITkey format: no key node\n");
-		return 1;
-	}
-
-	/* Update key data and key length with 384 bytes modulus */
-	key_data = fdt_getprop(*pub_key_fit, pub_key_node,
-			"rsa,modulus", &key_len);
-
-	/* Get montgomery from public key extension */
-	node = fit_pub_key_ext_node_get(fit, noffset);
-	if (node < 0) {
-		preboot_puts("Wrong FIT format missing ext pubkey\n");
-		return 1;
-	}
-
-	key_ext_data = fdt_getprop(fit, node, FIT_DATA_PROP,
-			&key_ext_len);
-	if (!key_ext_data) {
-		preboot_puts("Wrong FIT format: missing ext pubkey fit\n");
-		return 1;
-	}
-
-key_validation:
-	if (preboot_security_key_is_revoked(preboot_key_idx)) {
-		preboot_puts_hex("Key revoked: ", preboot_key_idx, false);
-		*res = FIT_SEC_KEY_REVOKED;
-		return 1;
-	}
-
-	if (!preboot_security_key_is_valid(preboot_key_idx, key_data, key_len,
-				key_ext_data, key_ext_len)) {
-		preboot_puts("Key validation failed\n");
-		*res = FIT_SEC_SIGN_FAILED;
-		return 1;
-	}
-
-	return 0;
-}
