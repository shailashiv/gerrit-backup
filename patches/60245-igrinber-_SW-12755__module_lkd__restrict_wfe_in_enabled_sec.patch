From 269c23141ff75fbab348765e668a647e33f31184 Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Mon, 16 Nov 2020 18:41:51 +0200
Subject: [PATCH] [SW-12755] module_lkd: restrict wfe in enabled sec

WFE command is illegal in secured environment - restrict it.

Change-Id: I010932aed60f4e1f4d7834f688ee4ab94d910d73
Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/preboot/module_lkd.c b/preboot/module_lkd.c
index 2993751..2226480 100644
--- a/preboot/module_lkd.c
+++ b/preboot/module_lkd.c
@@ -43,11 +43,17 @@
 	sts.msg_reg_val = cpu_boot_cmd_get();
 	switch (sts.msg_reg_val) {
 	case KMD_MSG_GOTO_WFE:
-		res = FOUND_NO_RETURN;
-		/* WFE - we should clear the message/cmd register */
-		cpu_boot_cmd_clr_before_wfe();
-		cpu_boot_rsp_set(CPU_MSG_OK);
 		preboot_puts("LKD WFE received\n");
+		if (preboot_security_is_enabled()) {
+			cpu_boot_rsp_set(CPU_MSG_ERR);
+			preboot_puts("Security is enabled - WFE refused!\n");
+			res = NOT_FOUND;
+		} else {
+			/* WFE - we should clear the message/cmd register */
+			cpu_boot_cmd_clr_before_wfe();
+			cpu_boot_rsp_set(CPU_MSG_OK);
+			res = FOUND_NO_RETURN;
+		}
 		break;
 	case KMD_MSG_FIT_RDY:
 		res = FOUND_SLOW_RETURN;
