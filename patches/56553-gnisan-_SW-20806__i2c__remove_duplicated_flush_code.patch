From 161c2a61734fcc76c9a8366e08707f2bd7bc7323 Mon Sep 17 00:00:00 2001
From: Guy Nisan <gnisan@habana.ai>
Date: Wed, 21 Oct 2020 20:03:18 +0300
Subject: [PATCH] [SW-20806] i2c: remove duplicated flush code

Remove duplicated code, call flush function instead

Change-Id: I51cd5c6f71a03f24cd50f694c7c52b23b315f125
Signed-off-by: Guy Nisan <gnisan@habana.ai>
---

diff --git a/common/module_i2c_slave.c b/common/module_i2c_slave.c
index 3b28551..1592157 100644
--- a/common/module_i2c_slave.c
+++ b/common/module_i2c_slave.c
@@ -104,9 +104,17 @@
 	return stat;
 }
 
+static void i2cslave_flush(void)
+{
+	u32 stat = regmap_readl(mmPSOC_I2C_S_IC_INTR_STAT);
+
+	if (stat & (PSOC_I2C_S_IC_INTR_STAT_R_RX_FULL_MASK |
+		    PSOC_I2C_S_IC_INTR_STAT_R_RD_REQ_MASK))
+		module_i2c_s_run();
+}
+
 void module_i2c_s_setup(void)
 {
-	unsigned int stat;
 	bool debug_mode;
 
 	debug_mode = hl_is_debug_mode(HL_DEBUG_HW_I2C);
@@ -114,19 +122,9 @@
 	hl_i2c_slave_init(debug_mode);
 
 	if (!debug_mode) {
-		stat = regmap_readl(mmPSOC_I2C_S_IC_INTR_STAT);
-
-		if (stat & (PSOC_I2C_S_IC_INTR_STAT_R_RD_REQ_MASK |
-			    PSOC_I2C_S_IC_INTR_STAT_R_RX_FULL_MASK))
-			module_i2c_s_run();
-
+		i2cslave_flush();
 		regmap_writel(0x1, mmPSOC_I2C_S_IC_ENABLE);
-
-		stat = regmap_readl(mmPSOC_I2C_S_IC_INTR_STAT);
-
-		if (stat & (PSOC_I2C_S_IC_INTR_STAT_R_RD_REQ_MASK |
-			    PSOC_I2C_S_IC_INTR_STAT_R_RX_FULL_MASK))
-			module_i2c_s_run();
+		i2cslave_flush();
 	}
 
 	preboot_puts("I2C SLAVE initialized\n");
@@ -152,23 +150,9 @@
 
 void module_i2c_s_disable(void)
 {
-	unsigned int stat;
-
-	stat = regmap_readl(mmPSOC_I2C_S_IC_INTR_STAT);
-
-	/* Clear requests before disabling */
-	if (stat & (PSOC_I2C_S_IC_INTR_STAT_R_RD_REQ_MASK |
-		    PSOC_I2C_S_IC_INTR_STAT_R_RX_FULL_MASK))
-		module_i2c_s_run();
-
+	i2cslave_flush();
 	regmap_writel(0x0, mmPSOC_I2C_S_IC_ENABLE);
-
-	stat = regmap_readl(mmPSOC_I2C_S_IC_INTR_STAT);
-
-	/* Make sure all requests are handled after disable */
-	if (stat & (PSOC_I2C_S_IC_INTR_STAT_R_RD_REQ_MASK |
-		    PSOC_I2C_S_IC_INTR_STAT_R_RX_FULL_MASK))
-		module_i2c_s_run();
+	i2cslave_flush();
 
 	preboot_puts("I2C SLAVE: disabled\n");
 }
@@ -245,12 +229,7 @@
 	/* Make sure all transactions arrived */
 	udelay(1000);
 
-	val = regmap_readl(mmPSOC_I2C_S_IC_INTR_STAT);
-
-	/* Make sure all requests are handled after disable */
-	if (val & (PSOC_I2C_S_IC_INTR_STAT_R_RD_REQ_MASK |
-		   PSOC_I2C_S_IC_INTR_STAT_R_RX_FULL_MASK))
-		module_i2c_s_run();
+	i2cslave_flush();
 
 	preboot_puts("I2C SLAVE: tear down done\n");
 }
