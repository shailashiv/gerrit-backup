From 418982e724f0619e0b2280745995d4372d09e1af Mon Sep 17 00:00:00 2001
From: Noam Lessner <nlessner@habana.ai>
Date: Tue, 17 Dec 2019 09:34:29 +0200
Subject: [PATCH] [SW-6739] arcboot: split directory for future

rearrange directory structure and makefile to support future
architectures

Change-Id: If76653ae49c9fee559a0a007450b566bad670413
Signed-off-by: Noam Lessner <nlessner@habana.ai>
---

diff --git a/Makefile b/Makefile
index e47db3d..9d870ce 100644
--- a/Makefile
+++ b/Makefile
@@ -21,13 +21,21 @@
 
 LDFLAGS = -flto
 LDFLAGS += -L $(LIBDIR) -lsb -lellipsys
-LDFLAGS += -T $@.lds
+LDFLAGS += -T $(HL_DEV)/$@.lds
 LDFLAGS += -nostartfiles
 LDFLAGS += -Wl,-e__start
 
 # This combination allows removing unused symbols from libsb.a and libellipsys.a
 LDFLAGS += -Wl,--gc-sections
 export CFLAGS = -Os -fdata-sections -ffunction-sections
+
+ARCBOOT_SRCS_C := common/arcboot.c
+ARCBOOT_SRCS_S := common/crt0.S
+ARCBOOT_OBJECTS := $(ARCBOOT_SRCS_C:.c=.o) $(ARCBOOT_SRCS_S:.S=.o)
+
+ARCBOOT_ROM_SRCS_C := common/arcboot_rom.c
+ARCBOOT_ROM_SRCS_S := common/crt0_rom.S
+ARCBOOT_ROM_OBJECTS := $(ARCBOOT_ROM_SRCS_C:.c=.o) $(ARCBOOT_ROM_SRCS_S:.S=.o)
 
 .PHONY: all libsb libellipsys sbtool
 all: libsb libellipsys
@@ -40,13 +48,13 @@
 %.bin: %
 	@$(OBJCOPY) -O binary -R .note.gnu.build-id -R .*data -R .test* $< $@
 
-arcboot: arcboot.o crt0.o
+arcboot: $(ARCBOOT_OBJECTS)
 	$(CC) $^ $(LDFLAGS) -o $@
-arcboot_rom: arcboot_rom.o crt0_rom.o
+arcboot_rom: $(ARCBOOT_ROM_OBJECTS)
 	@$(CC) $^ $(LDFLAGS) -o $@
 
 %.o: %.c
 	@$(CC) $(ARCBOOT_CFLAGS) -c $< -o $@
 
-%.o: %.s
+%.o: %.S
 	@$(CC) $(AFLAGS) -c $< -o $@
