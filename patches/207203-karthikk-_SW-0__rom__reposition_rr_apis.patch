+static uint32_t security_rr_calc_rr_dist(struct rom_rr_ctx *rr_ctx)
+{
+	uint32_t rr_dist;
+
+	if (rr_ctx->rr_idx > RR_LBW_MAX_SHORT_IDX)
+		rr_dist = (rr_ctx->rr_idx - RR_LBW_MAX_SHORT_RR) * sizeof(uint32_t);
+	else
+		rr_dist = rr_ctx->rr_idx * sizeof(uint32_t);
+
+	return rr_dist;
+}
+
+static void security_rr_update_hit_reg(uint32_t reg, uint8_t hit_idx)
+{
+	uint32_t val = regmap_readl(reg);
+
+	val |= BIT(hit_idx);
+	regmap_writel(val, reg);
+
+	val = regmap_readl(reg + RR_HIT_WR_TO_RD_DIST);
+	val |= BIT(hit_idx);
+	regmap_writel(val, reg + RR_HIT_WR_TO_RD_DIST);
+}
+
+static void security_rr_pcie_lbw_config_full(struct rom_rr_ctx *rr_ctx)
+{
+	uint32_t rr_dist = security_rr_calc_rr_dist(rr_ctx);
+
+	regmap_writel(rr_ctx->data_min,
+			mmD0_PCIE_ELBI_RR_MSTR_IF_RR_LBW_PRIV_RANGE_MIN_0 + rr_dist);
+	regmap_writel(rr_ctx->data_max,
+			mmD0_PCIE_ELBI_RR_MSTR_IF_RR_LBW_PRIV_RANGE_MAX_0 + rr_dist);
+	regmap_writel(rr_ctx->en_val,
+			mmD0_PCIE_ELBI_RR_MSTR_IF_RR_LBW_PRIV_RANGE_EN_0 + rr_dist);
+
+	security_rr_update_hit_reg(mmD0_PCIE_ELBI_RR_MSTR_IF_RR_LBW_PRIV_HIT_AW,
+			rr_ctx->rr_idx);
+
+	regmap_writel(rr_ctx->data_min,
+			mmD0_PCIE_MSTR_RR_MSTR_IF_RR_LBW_PRIV_RANGE_MIN_0 + rr_dist);
+	regmap_writel(rr_ctx->data_max,
+			mmD0_PCIE_MSTR_RR_MSTR_IF_RR_LBW_PRIV_RANGE_MAX_0 + rr_dist);
+	regmap_writel(rr_ctx->en_val,
+			mmD0_PCIE_MSTR_RR_MSTR_IF_RR_LBW_PRIV_RANGE_EN_0 + rr_dist);
+
+	security_rr_update_hit_reg(mmD0_PCIE_MSTR_RR_MSTR_IF_RR_LBW_PRIV_HIT_AW,
+			rr_ctx->rr_idx);
+
+	regmap_writel(rr_ctx->data_min,
+			mmD0_NRTR0_3CH_CTRL0_RR_LBW_PRIV_RANGE_MIN_0 + rr_dist);
+	regmap_writel(rr_ctx->data_max,
+			mmD0_NRTR0_3CH_CTRL0_RR_LBW_PRIV_RANGE_MAX_0 + rr_dist);
+	regmap_writel(rr_ctx->en_val,
+			mmD0_NRTR0_3CH_CTRL0_RR_LBW_PRIV_RANGE_EN_0 + rr_dist);
+	security_rr_update_hit_reg(mmD0_NRTR0_3CH_CTRL0_RR_LBW_PRIV_HIT_AW,
+				rr_ctx->rr_idx);
+}
+
+static void security_rr_pcie_lbw_config_short(struct rom_rr_ctx *rr_ctx)
+{
