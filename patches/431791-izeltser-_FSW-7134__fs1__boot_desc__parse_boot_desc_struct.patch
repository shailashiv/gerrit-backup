From 794105593a449580890852f89f883812f85459ee Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Wed, 10 Jul 2024 08:53:45 +0300
Subject: [PATCH] [FSW-7134] fs1: boot_desc: parse boot desc struct

Take the necessary fields from the boot descriptor structure and store
for a local use

Change-Id: I8414335ed7a9818b25b811d07f3a712eadb2e433
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/arch/fs1/arc/common.c b/arch/fs1/arc/common.c
index 3774e25..0858ea0 100644
--- a/arch/fs1/arc/common.c
+++ b/arch/fs1/arc/common.c
@@ -34,6 +34,7 @@
 #include <pmmu_pcie_wrap_regs.h>
 #include <fs1_blocks_linux_driver.h>
 #include <fs1_security.h>
+#include <string.h>
 
 #include <baremetal.h>
 #include <bitops.h>
@@ -503,6 +504,12 @@
 u32 dev_spec_get_img_desc(struct hl_fw_img_desc *desc_ptr, enum fw_post_reset_cmd upd_status,
 			  struct boot_desc *desc)
 {
-	/* TODO: parse FS1 descriptor */
+	desc->spi_offset = desc_ptr->offset;
+	desc->img_size = desc_ptr->size;
+	desc->loadaddr = ((u64)desc_ptr->load_high << 32) | desc_ptr->load_low;
+	desc->desc_ver = desc_ptr->desc_ver;
+	desc->crc32 = desc_ptr->crc32;
+	memcpy(desc->chksum, desc_ptr->chksum, ARRAY_SIZE(desc->chksum));
+
 	return 0;
 }
diff --git a/include/boot_desc.h b/include/boot_desc.h
index fe721b4..ae96068 100644
--- a/include/boot_desc.h
+++ b/include/boot_desc.h
@@ -26,6 +26,7 @@
 	u32 img_size;
 	u64 loadaddr;
 	u8 chksum[SHA_SUM_LEN];
+	u32 crc32;
 };
 
 /*
