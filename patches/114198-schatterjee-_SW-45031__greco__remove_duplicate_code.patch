+		break;
+	case HL_DEBUG_HW_PCIE:
+		strap_mask = BIT(10); /* Dump Select[2] */
+		break;
+	case HL_DEBUG_HW_DRAM:
+		strap_mask = BIT(8); /* Dump Select[0] */
+		break;
+	case HL_DEBUG_HW_I2C:
+		strap_mask = BIT(9); /* Dump Select[1] */
+		break;
