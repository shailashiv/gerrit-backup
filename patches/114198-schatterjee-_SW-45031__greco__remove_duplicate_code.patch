diff --git a/arch/greco/arc_elf32/common.h b/arch/greco/arc_elf32/common.h
index 76c9933..3c4bc59 100644
--- a/arch/greco/arc_elf32/common.h
+++ b/arch/greco/arc_elf32/common.h
@@ -22,8 +22,12 @@
 #define PCIE_FW_SRAM_BASE	0x1BFF0000
 #define FW_SRAM_BASE		0x1B050000
 #define SP_SRAM_BASE		0x1BFE0000
+#define HL_SP_SRAM_SIZE		0x10000
 #define PPBOOT_TEXT_BASE	(FW_SRAM_BASE + 0xC)
 #define PREBOOT_TEXT_BASE	(SDRAM_BASE + PPBOOT_SIZE + 0x8)
+
+#define FW_WORD_NUM		0x2200	/* FW_SIZE / 2 */
+
 /* In order not to conflict with ARC BOOTROM's usage of DCCM,
  * Let PPBoot start from the offset of 8544 bytes, for using DCCM
  * for its own BSS and Stack.
diff --git a/arch/greco/arm/asic.c b/arch/greco/arm/asic.c
index f9cb4a6..888fbf2 100644
--- a/arch/greco/arm/asic.c
+++ b/arch/greco/arm/asic.c
@@ -144,3 +144,23 @@
 	regs->gic_host_ints_irq  = mmGIC_HOST_INTS_IRQ_POLL_REG;
 	regs->gic_host_soft_rst_irq = mmGIC_HOST_SOFT_RST_IRQ_POLL_REG;
 }
+
+/*
+ * Wait for Boot Manager to complete PCIe image execution
+ * and return to idle state, so it won't initiate UART access anymore
+ */
+__weak void preboot_sync_btl(void)
+{
+	u64 start = timestamp_get_us();
+
+	while (regmap_readl(mmPSOC_GLOBAL_CONF_BTM_FSM)) {
+		/*
+		 * Boot manager is supposed to complete entire execution
+		 * of FSM, BTL primary/secondary at this point. Though
+		 * It should not take more than 100ms for it to finish
+		 * timeout of half second is used here.
+		 */
+		if (timeout_expired(start, BTL_SYNC_TIMEOUT_US))
+			break;
+	}
+}
