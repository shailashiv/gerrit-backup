From 5dea083e1bfff681a7dba658282cb0bb845cc1de Mon Sep 17 00:00:00 2001
From: Noam Lessner <nlessner@habana.ai>
Date: Mon, 23 Dec 2019 10:00:37 +0200
Subject: [PATCH] [SW-6739] arcboot: add support for fw_sram

add fw_sram to supported memory space

Change-Id: If0e974dbc16fa9a6cbc568f30a4f7fa324e42361
Signed-off-by: Noam Lessner <nlessner@habana.ai>
---

diff --git a/Makefile b/Makefile
index 0657dbf..26d25b1 100644
--- a/Makefile
+++ b/Makefile
@@ -46,7 +46,7 @@
 sbtool:
 	@$(MAKE) -C sdk $@
 %.bin: %
-	@$(OBJCOPY) -O binary -R .note.gnu.build-id -R .test* $< $@
+	@$(OBJCOPY) -O binary -R .note.gnu.build-id -R .fw_sram -R .test* $< $@
 
 arcboot: $(ARCBOOT_OBJECTS)
 	$(CC) $^ $(LDFLAGS) -o $@
diff --git a/goya2_arc/arcboot.lds b/goya2_arc/arcboot.lds
index aa0d58e..9a6be86 100644
--- a/goya2_arc/arcboot.lds
+++ b/goya2_arc/arcboot.lds
@@ -15,11 +15,13 @@
 	STM	: ORIGIN = 0x18000000, LENGTH = 32M
 	SPI	: ORIGIN = 0x1A000000, LENGTH = 16M
 	SBROM	: ORIGIN = 0x1B040000, LENGTH = 64K
+	FWSRAM	: ORIGIN = 0x1B050000, LENGTH = 64K
 	CS	: ORIGIN = 0x1C000000, LENGTH = 64M
 	DCCM	: ORIGIN = 0x80000000, LENGTH = 16K
 }
 
 REGION_ALIAS("REGION_TEXT",	ICCM)
+REGION_ALIAS("REGION_FW",	FWSRAM)
 REGION_ALIAS("REGION_DATA",	DCCM)
 REGION_ALIAS("REGION_SDATA",	DCCM)
 REGION_ALIAS("REGION_SBSS",	DCCM)
@@ -37,6 +39,11 @@
 		_etext = . ;
 	} > REGION_TEXT
 
+	.fw_sram :
+	{
+		*(.fw_sram)
+	} > REGION_FW
+
 	.data : AT ( LOADADDR(.text) + SIZEOF(.text) ) {
 		_data = .;
 		*(.data)
diff --git a/goya2_arc/arcboot_rom.lds b/goya2_arc/arcboot_rom.lds
index db67460..ddc927a 100644
--- a/goya2_arc/arcboot_rom.lds
+++ b/goya2_arc/arcboot_rom.lds
@@ -15,12 +15,14 @@
 	STM	: ORIGIN = 0x18000000, LENGTH = 32M
 	SPI	: ORIGIN = 0x1A000000, LENGTH = 16M
 	SBROM	: ORIGIN = 0x1B040000, LENGTH = 64K
+	FWSRAM	: ORIGIN = 0x1B050000, LENGTH = 64K
 	CS	: ORIGIN = 0x1C000000, LENGTH = 64M
 	DCCM	: ORIGIN = 0x80000000, LENGTH = 16K
 }
 
 REGION_ALIAS("REGION_IVT",	SBROM)
 REGION_ALIAS("REGION_TEXT",	SBROM)
+REGION_ALIAS("REGION_FW",	FWSRAM)
 REGION_ALIAS("REGION_DATA",	DCCM)
 REGION_ALIAS("REGION_SDATA",	DCCM)
 REGION_ALIAS("REGION_SBSS",	DCCM)
@@ -42,6 +44,10 @@
 		_etext = . ;
 	} > REGION_TEXT
 
+	.fw_sram : {
+		*(.fw_sram)
+	} > REGION_FW
+
 	.data : AT ( LOADADDR(.text) + SIZEOF(.text) ) {
 		_data = .;
 		*(.data)
