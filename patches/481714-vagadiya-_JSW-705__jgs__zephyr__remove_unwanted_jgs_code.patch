+ * Copyright 2024 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+#ifndef _FS1_ISOLATION_DEFS_H
+#define _FS1_ISOLATION_DEFS_H
+
+#include <zephyr/types.h>
+#include <stdbool.h>
+#include <zephyr/kernel.h>
+#include <fs1_fw_if.h>
+#include <hl_platform_defs.h>
+
+#define DISABLE_ALL	0
+#define ALL_8_ACTIVE	0xFF
+#define ALL_9_ACTIVE	0x1FF
+#define ALL_13_ACTIVE	0x1FFF
+#define ALL_16_ACTIVE	0xFFFF
+#define ALL_32_ACTIVE	0xFFFFFFFF
+#define ALL_64_ACTIVE	0xFFFFFFFFFFFFFFFF
+
+#define DEC_ENABLE_MASK		ALL_9_ACTIVE
+#define NIC_ENABLE_MASK		ALL_13_ACTIVE
+#define EDMA_ENABLE_MASK	0x1F
+#define PDMA_ENABLE_MASK	0x3
+#define PMMU_ENABLE_MASK        0x1
+#define XECORE_ENABLE_MASK	0x1FFFF
+
+/* for individual die */
+struct fs1_isolation_info {
+	enum fs1_die_id die_id;
+	void *redundancy_ctx;
+};
+
+/* for individual die */
+struct fs1_isolation_drv_data {
+	bool initialized;
+	enum fs1_die_id die_id;
+
+	union {
+		/* io die */
+		struct {
+			uint16_t dec_enable_mask[2];
+			uint16_t nic_enable_mask;
+			uint8_t pmmu_enable_mask;
+		};
+		/* compute die */
+		struct {
+			uint8_t edma_enable_mask;
+			uint8_t pdma_enable_mask;
+			uint32_t xecore_enable_mask;
+			uint32_t dual_plane_enable_mask;
+		};
+	};
+};
+
+#endif /* _FS1_ISOLATION_DEFS_H */
