index 0000000..038ed3a
--- /dev/null
+++ b/boards/intel/fs1/fs1_agent_asic_defconfig
@@ -0,0 +1,51 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2024 HabanaLabs, Ltd.
+
+CONFIG_CPU_ARCHS_NO_HW_ATOMIC=y
+CONFIG_COMMON_LIBC_MALLOC_ARENA_SIZE=2048
+CONFIG_BUILD_OUTPUT_BIN=n
+CONFIG_MAIN_STACK_SIZE=5120
+CONFIG_PRINTK=y
+CONFIG_LOG=y
+CONFIG_LOG_MODE_MINIMAL=y
+CONFIG_LOG_MAX_LEVEL=4
+CONFIG_CONSOLE=y
+CONFIG_SERIAL=y
+CONFIG_UART_CONSOLE=y
+CONFIG_HW_STACK_PROTECTION=y
+CONFIG_EMPTY_WEAK_FUNCTIONS=y
+CONFIG_LINKER_ORPHAN_SECTION_PLACE=y
+CONFIG_XIP=n
+CONFIG_LIBBOOTINFO=y
+CONFIG_LIBSOC_INIT=y
+CONFIG_GPIO=y
+# bootinfo addr is spsram base
+CONFIG_BOOTINFO_ADDR=0x78a00000
+CONFIG_BOOTINFO_SIZE=0x8000
+
+CONFIG_EEPROM=y
+CONFIG_LIBEEPROM=y
+CONFIG_EEPROM_AT24=y
+CONFIG_EEPROM_SHELL=y
+CONFIG_EEPROM_SHELL_BUFFER_SIZE=256
+
+#Enable spi
+CONFIG_SPI=y
+CONFIG_SPI_DW_ACCESS_WORD_ONLY=y
+CONFIG_SPI_NOR=y
+CONFIG_FLASH=y
+CONFIG_SPI_NOR_FLASH_MACRONIX=y
+CONFIG_SPI_NOR_FLASH_WINBOND=y
+CONFIG_SPI_NOR_FLASH_LAYOUT_PAGE_SIZE=4096
+CONFIG_SPI_NOR_SFDP_RUNTIME=y
+CONFIG_FLASH_JESD216_API=y
+CONFIG_CRC=y
+
+#CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=35000000
+#CONFIG_MAIN_THREAD_PRIORITY=4
+CONFIG_COMMON_LIBC_MALLOC_ARENA_SIZE=2048
+CONFIG_ASSERT=y
+CONFIG_HEAP_MEM_POOL_SIZE=1280
+#CONFIG_ARC_EXCEPTION_DEBUG=y
+#CONFIG_LIBEEPROM=y
+#CONFIG_LIBBOOTINFO=y
