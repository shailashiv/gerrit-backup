@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright (c) 2024 Habanalabs
+ */
+
+/**
+ * @file drivers/misc/fs1_isolation/fs1/fs1_isolation_api.h
+ *
+ * @brief Public APIs for the Intel fs1_isolation driver.
+ */
+
+#ifndef ZEPHYR_INCLUDE_DRIVERS_FS1_ISOLATION_API_H_
+#define ZEPHYR_INCLUDE_DRIVERS_FS1_ISOLATION_API_H_
+
+#include <zephyr/types.h>
+#include <zephyr/device.h>
+#include <fs1_isolation_defs.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum fs1_iso_module {
+	FS1_ISO_IO_MODULE_DEC,
+	FS1_ISO_IO_MODULE_NIC,
+	FS1_ISO_IO_MODULE_PMMU,
+	FS1_ISO_COMPUTE_MODULE_EDMA,
+	FS1_ISO_COMPUTE_MODULE_PDMA,
+	FS1_ISO_COMPUTE_MODULE_XECORE,
+	FS1_ISO_MODULE_DUAL_PLANE,
+	FS1_ISO_MODULE_LAST,
+};
+
+/**
+ * @typedef fs1_isolation_set_isolation_t
+ * @brief Callback API for dec isolation
+ */
+typedef int (*fs1_isolation_set_isolation_t)(const struct device *dev, enum fs1_iso_module module);
+
+/**
+ * @typedef fs1_isolation_inject_isolation_info_t
+ * @brief Callback API for running hl_isolation_inject_isolation_info
+ */
+typedef int (*fs1_isolation_inject_isolation_info_t)(
+			const struct device *dev,
+			const struct fs1_isolation_info *isolation_info);
+
+__subsystem struct fs1_isolation_driver_api {
+	fs1_isolation_set_isolation_t fs1_isolation_set_isolation_drv;
+	fs1_isolation_inject_isolation_info_t fs1_isolation_inject_isolation_info_drv;
+};
+
+__syscall int fs1_isolation_set_isolation(const struct device *dev, enum fs1_iso_module module);
+
+static inline int z_impl_fs1_isolation_set_isolation(const struct device *dev,
+			enum fs1_iso_module module)
+{
+	const struct fs1_isolation_driver_api *api =
+		(const struct fs1_isolation_driver_api *)dev->api;
+
+	if (api == NULL) {
+		return -ENOTSUP;
+	}
+
+	if (api->fs1_isolation_set_isolation_drv == NULL)
+		return -ENOTSUP;
+
+	return api->fs1_isolation_set_isolation_drv(dev, module);
+}
+
+__syscall int fs1_isolation_inject_info(const struct device *dev,
+					const struct fs1_isolation_info *isolation_info);
+
+static inline int z_impl_fs1_isolation_inject_info(
+					const struct device *dev,
+					const struct fs1_isolation_info *isolation_info)
+{
+	const struct fs1_isolation_driver_api *api =
+		(const struct fs1_isolation_driver_api *)dev->api;
+
+	if (api == NULL) {
+		return -ENOTSUP;
+	}
+
+	if (api->fs1_isolation_inject_isolation_info_drv == NULL)
+		return -ENODEV;
+
+	return api->fs1_isolation_inject_isolation_info_drv(dev, isolation_info);
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#include <syscalls/fs1_isolation_api.h>
+
+#endif /* ZEPHYR_INCLUDE_DRIVERS_FS1_ISOLATION_API_H_ */
