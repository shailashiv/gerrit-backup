@@ -0,0 +1,76 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2023 HabanaLabs, Ltd.
+ * All Rights Reserved.
+ */
+
+/dts-v1/;
+
+#include <fs1_preboot.dtsi>
+
+/ {
+	model = "fs1_preboot";
+};
+
+&refclk {
+	/* clock values differ between images on pldm */
+	clock-frequency = <21300>;
+};
+
+&uart0 {
+	current-speed = <300>;
+	status = "okay";
+};
+
+&clk_psoc_io {
+	/*
+	 * nominal frequency for div3 is refclk.
+	 * In pldm only, due to very low frequency of the emulation, div3 is set to
+	 * PLL/4 (250Mhz) so we can use the uart console. it can also help to speed up
+	 * the SPI communication.
+	 */
+	div_fact = <0 1 4 3>;
+	div_sel = <1 3 3 3>;
+	status = "okay";
+};
+
+&clk_nic_io {
+	status = "okay";
+};
+
+&clk_pcie_io {
+	status = "okay";
+};
+
+&clk_dec_io {
+	status = "okay";
+};
+
+&clk_enc_io {
+	status = "okay";
+};
+
+&clk_noc_io {
+	status = "okay";
+};
+
+&mbox {
+	status = "okay";
+};
+
+&sriov {
+	status = "okay";
+};
+
+&isolation {
+	status = "okay";
+};
+
+&binning {
+	status = "okay";
+};
+
+&reset {
+	status = "okay";
+};
