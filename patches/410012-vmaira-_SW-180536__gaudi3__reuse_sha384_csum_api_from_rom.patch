diff --git a/include/sha512.h b/include/sha512.h
index 2a74b89..2424204 100644
--- a/include/sha512.h
+++ b/include/sha512.h
@@ -31,8 +31,4 @@
 void sha384_update(struct sha512_context *ctx, const u8 *input, u32 length);
 void sha384_finish(struct sha512_context *ctx, u8 digest[SHA384_SUM_LEN]);
 
-void sha384_csum(const u8 *input, unsigned int ilen,
-		u8 *output, __attribute__ ((unused)) unsigned int chunk_sz);
-
-
 #endif /* _SHA512_H */
