From 0824b39cdd2cb753c7e7cfea0df6a8ced9e714ca Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Sun, 26 May 2024 16:40:37 +0300
Subject: [PATCH] [FSW-0] fs1: adjust for specs 1.3

Adjust DBI register for VLSI tag 1.3

Change-Id: I69ea4e56f0494af59c9516ea4b5dcc426fa442fe
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/arch/fs1/arc/dev_pcie.c b/arch/fs1/arc/dev_pcie.c
index a3ec5d5..a98a170 100644
--- a/arch/fs1/arc/dev_pcie.c
+++ b/arch/fs1/arc/dev_pcie.c
@@ -89,7 +89,7 @@
 
 	val = regmap_readl(IO0_H0_PCIE_DBI(mmPCIE_DBI_SRIOV_BASE_REG));
 	val &= ~PCIE_DBI_SRIOV_BASE_REG_SRIOV_NEXT_OFFSET_M;
-	val |= mmPCIE_DBI_PRS_EXT_CAP_HDR_REG <<
+	val |= mmPCIE_DBI_LTR_CAP_HDR_REG <<
 		PCIE_DBI_SRIOV_BASE_REG_SRIOV_NEXT_OFFSET_S;
 	regmap_writel(val, IO0_H0_PCIE_DBI(mmPCIE_DBI_SRIOV_BASE_REG));
 }
