+#define mmCPU_PLL_BASE		0x4A2000
+#define mmIC_PLL_BASE		0x4A3000
+#define mmPSOC_EMMC_PLL_BASE	0xC70000
+#define mmPSOC_MME_PLL_BASE	0xC71000
+#define mmPSOC_PCI_PLL_BASE	0xC72000
+#define mmTPC_PLL_BASE		0xE01000
diff --git a/goya2/preboot.lds.S b/goya2/preboot.lds.S
new file mode 100644
index 0000000..2186e48
--- /dev/null
+++ b/goya2/preboot.lds.S
@@ -0,0 +1,30 @@
+/*
+ * (C) Copyright 2017 HabanaLabs, Ltd.
+ * Noam Camus <noamikong@gmail.com>
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ */
+
+#ifdef __arc__
+MEMORY { .sram : ORIGIN = 0xf0000000, LENGTH = 0x10000 }
+OUTPUT_FORMAT("elf32-littlearc", "elf32-bigarc", "elf32-littlearc")
+OUTPUT_ARCH(arc)
+#endif
+
+#ifdef __aarch64__
+MEMORY { .sram : ORIGIN = 0x7ff0000000, LENGTH = 0x10000 }
+OUTPUT_FORMAT("elf64-littleaarch64", "elf64-littleaarch64", "elf64-littleaarch64")
+OUTPUT_ARCH(aarch64)
+#endif
+
+ENTRY(_start)
+SECTIONS
+{
+	.text : {
+		. = ALIGN(8);
+		common/start.o (.text*)
+		* (.text*)
+	} >.sram
+
+	.note.gnu.build-id : { *(.note.gnu.build-id) } > .sram
+}
