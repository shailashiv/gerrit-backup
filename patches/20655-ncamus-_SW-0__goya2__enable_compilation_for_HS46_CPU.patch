From f86b5cd8f4d0b9cb4caaa7da90f9b8db98d15b14 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Wed, 06 Nov 2019 13:47:58 +0200
Subject: [PATCH] [SW-0] goya2: enable compilation for HS46 CPU

This will run on ARC proccessor HS46 which is 32bit nad will be used to
establish PCIe link

Change-Id: I70420feae404994527f5f137f7a1f8c61b04c5ba
---

diff --git a/common/preboot.h b/common/preboot.h
index 3278135..264fd44 100644
--- a/common/preboot.h
+++ b/common/preboot.h
@@ -11,6 +11,13 @@
 #define BIT(nr)					(1 << (nr))
 #define ARRAY_SIZE(x)				(sizeof(x) / sizeof((x)[0]))
 
+#ifdef __arc__
+#define HL_SPI_BASE				0x1A000000
+#define HL_CFG_BASE				0x1C000000
+#define SDRAM_BASE				0x10000000
+#define SPL_TEXT_BASE				0x10080000
+#endif
+
 #ifdef __aarch64__
 #define HL_SPI_BASE				0x7FF8000000ull
 #define HL_CFG_BASE				0x7FFC000000ull
diff --git a/common/start.S b/common/start.S
index da9ffe5..423ce29 100644
--- a/common/start.S
+++ b/common/start.S
@@ -12,6 +12,15 @@
 .globl	_start
 _start:
 
+#ifdef __arc__
+/* lf2flt: to avoid compiler (buildroot wrapper) warning during linkage */
+.global	lf2flt
+lf2flt:
+
+	mov	sp, _start + 0x10000
+	mov	fp, sp
+#endif
+
 #ifdef __aarch64__
 	ldr	x0, =(_start + 0x10000)
 	bic	sp, x0, #0xf	/* 16-byte alignment for ABI compliance */
