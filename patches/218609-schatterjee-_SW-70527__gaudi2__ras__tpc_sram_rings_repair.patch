 #define GAUDI2_RING_PATTERN_VAL1		0x1000012
 #define GAUDI2_RING_PATTERN_VAL2		0x121
 #define GAUDI2_RING_PATTERN_VAL3		0x131
@@ -244,6 +245,18 @@
 #define GAUDI2_RING_PATTERN_VAL20		0x100000a
 #define GAUDI2_RING_PATTERN_VAL21		0x3
 #define GAUDI2_RING_PATTERN_VAL22		0x1000001
+#define GAUDI2_RING_PATTERN_VAL23		0x1000072
+#define GAUDI2_RING_PATTERN_VAL24		0x484848
+#define GAUDI2_RING_PATTERN_VAL25		0x48484848
+#define GAUDI2_RING_PATTERN_VAL26		0x12121
+#define GAUDI2_RING_PATTERN_VAL27		0x4c4c4c
+#define GAUDI2_RING_PATTERN_VAL28		0x4c4c4c4c
+#define GAUDI2_RING_PATTERN_VAL29		0x13131
+#define GAUDI2_RING_PATTERN_VAL30		0x444444
+#define GAUDI2_RING_PATTERN_VAL31		0x44444444
+#define GAUDI2_RING_PATTERN_VAL32		0x11111
+#define GAUDI2_RING_PATTERN_VAL33		0x100007f
+#define GAUDI2_RING_PATTERN_VAL34		0x1000031
 
 
 void gaudi2_axi_drain_ena(void);
