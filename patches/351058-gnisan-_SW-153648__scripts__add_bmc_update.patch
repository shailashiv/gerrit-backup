+#!/bin/bash
+
+set +xe
+
+echo " "
+export CYAN="\033[0;36m"
+export GREEN="\033[0;32m"
+export YELLOW="\033[0;33m"
+export MAGNETA="\033[0;35m"
+export BLUE="\033[0;34m"
+export RED="\033[0;31m"
+export NC="\033[0m" # No Color
+echo " "
+
+if [ $# -lt 7 ]; then
+	echo "$0 <kvm host> <oam bmc> <ipmi username> <ipmi password> <bmc ssh username> <bmc ssh password> <image file>"
+	exit 1
+fi
+
+CURRENT_KVM=$1
+CURRENT_HLS=$2
+USERNAME=$3
+PASSWORD=$4
+SYS_USERNAME=$5
+SYS_PASSWORD=$6
+IMG=$7
+
+printf "${MAGNETA}Testing Connection To Host...${NC}\n"
+echo " "
+PING_CMD="nc -zv ${CURRENT_HLS} 22 -w 1"
+eval $PING_CMD
+if [[ $? -eq 0 ]]; then
+    echo " "
+    printf "${GREEN}${CURRENT_HLS}${NC} is up & running!!!\n"
+    echo " "
+    if [ ! -f "${IMG}" ]; then
+	    echo "File not found ${IMG}"
+	    exit 1
+    fi
+    echo " "
+    printf "Retrive HIB Interface IP address on ${CURRENT_HLS} Host...\n"
+    echo " "
+        HIB_IP_ADDRESS=$(getent hosts ${CURRENT_HLS} | awk '{ print $1 }')
+
+    printf "HIB Interface IP Address Is ---> ${CYAN}${HIB_IP_ADDRESS}${NC}\n"
+    echo " "
+    printf "${BLUE}Programming HIB Version On Primary Flash For:${NC} ${CURRENT_HLS}... \n"
+    echo " "
+    ./Yafuflash -non-interactive -mse 1 -nw -ip ${HIB_IP_ADDRESS} -U $USERNAME -P $PASSWORD ${IMG}; RC=$?; echo $RC > hib_err.txt; ALL_RC=$(grep -v "0" hib_err.txt | wc -l); echo " "
+    echo " "
+else
+    echo " "
+    printf "${RED}${CURRENT_HLS} is Not Accessible!!!${NC}\n"
+    echo " "
+    exit 13
+fi
+printf "${CYAN}Sleep for ~3 minutes before secondary flash...${NC}\n"
+sleep 200
+echo " "
+printf "${YELLOW}Programming HIB Version On Secondary Flash For:${NC} ${CURRENT_HLS}... \n"
+echo " "
+./Yafuflash -non-interactive -mse 2 -nw -ip ${HIB_IP_ADDRESS} -U admin -P admin ${IMG}; RC=$?; echo $RC >> hib_err.txt; ALL_RC=$(grep -v "0" hib_err.txt | wc -l); echo " "
+echo " "
+echo "${MAGNETA}Testing Connection To Host...${NC}\n"
+echo " "
+PING_CMD="nc -zv ${HIB_IP_ADDRESS} 22 -w 1"
+eval $PING_CMD
+if [[ $? -eq 0 ]]; then
+    echo -e -n "${GREEN}${CURRENT_HLS}${NC} is up & running!!"
+    else
+    echo -e -n "${CYAN}Waiting for connection...${NC}"
+    echo " "
+    echo " "
+    wait_period=0
+    while true; do
+    eval $PING_CMD
+    if [[ $? -eq 0 ]]; then
+        echo " "
+        echo -e -n "${GREEN}${CURRENT_HLS}${NC} is up & running!!"
+        echo " "
+        break
+    else
+        echo " "
+        echo "Time Now: `date +%H:%M:%S`"
+        echo " "
+        echo -e -n "${YELLOW}Sleeping for two minutes...${NC}"
+        echo " "
+        wait_period=$(($wait_period+120))
+        # Below 600 is 600 seconds i.e. 10 minutes * 60 = 600 sec
+        if [ $wait_period -gt 600 ];then
+            echo " "
+            echo ===================================================================
+            echo " "
+            echo -e -n "Connection check timeout has been set to 10 minutes.\nPlease check whats wrong with ${RED}${CURRENT_HLS}${NC} host, exiting now..."
+            echo " "
+            echo " "
+            exit 13
+            echo ===================================================================
+            break
+        else
+            echo " "
+            sleep 120
+            echo " "
+        fi
+    fi
+    done
+fi
+echo " "
+echo " "
+PING_CMD="nc -zv ${HIB_IP_ADDRESS} 22 -w 1"
+eval $PING_CMD
+if [[ $? -ne 0 ]]; then
+    echo " "
+    printf "${RED}${CURRENT_HLS} is Not Accessible!!!${NC}\n"
+    echo " "
+else
+    echo " "
+    printf " Sleep ~2 minutes before continue with ${GREEN}${CURRENT_HLS}${NC} settings restoration...\n"
+    sleep 100
+    echo " "
+    printf "${BLUE}Setting Back User passwd...${NC}\n"
