diff --git a/common/boot_flow.c b/common/boot_flow.c
index 2fb9abd..d96cb84 100644
--- a/common/boot_flow.c
+++ b/common/boot_flow.c
@@ -31,9 +31,13 @@
 	if (!boot_rom_boot_desc_init_done(manifest_idx))
 		return BOOT_ROM_FAIL;
 
+	boot_rom_status_update_bringup(img_sts_base, PROGRESS_BRINGUP_START);
+
 	/* get image descriptor from the manifest */
-	if (boot_desc_get_img_desc(manifest_idx, img_type, desc) != BOOT_ROM_SUCCESS)
+	if (boot_desc_get_img_desc(manifest_idx, img_type, desc) != BOOT_ROM_SUCCESS) {
+		boot_rom_status_update_bringup(img_sts_base, PROGRESS_BRINGUP_NO_IMG_DESC);
 		return BOOT_ROM_FAIL;
+	}
 
 	/* Validate Image descriptor start address and other ranges */
 	if (boot_rom_verify_img_desc_address_range(desc, img_sts_base, img_type)
@@ -109,10 +113,11 @@
 			/* TODO: Start CPLD watchdog timer */
 			/* TODO: Report security image fw version */
 			ppboot = (void *)((uint32_t)boot_rom_get_arc_addr(desc.start_addr));
+			boot_rom_status_update(PROGRESS_PPBOOT_START);
 			ppboot();
 		}
 	}
-
+	boot_rom_status_update(PROGRESS_PPBOOT_FINISH);
 	boot_rom_halt();
 }
 
@@ -148,8 +153,12 @@
 		/* TODO: Start CPLD watchdog timer */
 		/* TODO: Report security image fw version */
 		ppboot = (void *)((uint32_t)boot_rom_get_arc_addr(desc.start_addr));
+		boot_rom_status_update(PROGRESS_PPBOOT_START);
 		ppboot();
 	}
+
+	boot_rom_status_update(PROGRESS_PPBOOT_FINISH);
+	boot_rom_halt();
 }
 
 static uint32_t boot_rom_verify_manifest(__unused enum hl_fw_manifest_type manifest_idx)
