From e65ff138e018ff6bf99c283210841cc8c2901355 Mon Sep 17 00:00:00 2001
From: Varun Sharma <vsharma@habana.ai>
Date: Thu, 17 Mar 2022 14:18:36 +0200
Subject: [PATCH] [SW-43475] greco: arc: move preboot load address to start of sram

This patch changes preboot start address to start of sram, instead of
16KB offset, which was previously left by mistake for ppboot.
Ppboot loads in fw sram, so sram can directly start from 0 offset.

Also it is seem that while starting fro 16K offset, max 48K is getting
copied into sram from spi flash using dma, since preboot size can be
greater then 48K, it causes mismatch in copied data.
When starting from 0th offset, more then 48K is also getting copied
fine.

Change-Id: Iafb2199b440f788789f01edd2bf9e1aacdce15a9
Signed-off-by: Varun Sharma <vsharma@habana.ai>
---

diff --git a/arch/greco/arc/common.h b/arch/greco/arc/common.h
index be0b07d..f83b41e 100644
--- a/arch/greco/arc/common.h
+++ b/arch/greco/arc/common.h
@@ -21,7 +21,7 @@
 #define SP_SRAM_BASE		0x1BFE0000
 #define ARC_ICCM_BASE		0x1B020000
 #define PPBOOT_TEXT_BASE	(FW_SRAM_BASE + 0xC)
-#define PREBOOT_TEXT_BASE	(SDRAM_BASE + PPBOOT_SIZE + 0x8)
+#define PREBOOT_TEXT_BASE	(SDRAM_BASE + 0x8)
 
 #define HL_SP_SRAM_BASE		0x7FFBFE0000
 #define HL_SP_SRAM_SIZE		SZ_64K
diff --git a/arch/greco/arc_elf32/common.c b/arch/greco/arc_elf32/common.c
index f243644..31b0f9f 100644
--- a/arch/greco/arc_elf32/common.c
+++ b/arch/greco/arc_elf32/common.c
@@ -226,8 +226,7 @@
 	 * 0x7FFBFE1000ULL, the address to be passed is 0x7FFBFE0400ULL
 	 * instead of 0x7FFBFE1000ULL (right shift offest 0x1000 by 2).
 	 */
-	dma_copy_image(image_size, flash_offset,
-			(SDRAM_FULL_BASE + (PPBOOT_SIZE >> 2)),
+	dma_copy_image(image_size, flash_offset, SDRAM_FULL_BASE,
 			SPI_DMA_DST_HBW);
 	if (dma_wait_finish() == DMA_CRC_ERROR)
 		return ARCBOOT_BRINGUP_ERROR;
diff --git a/arch/greco/arc_elf32/common.h b/arch/greco/arc_elf32/common.h
index a1fc5d0..efe1830 100644
--- a/arch/greco/arc_elf32/common.h
+++ b/arch/greco/arc_elf32/common.h
@@ -24,7 +24,7 @@
 #define SP_SRAM_BASE		0x1BFE0000
 #define HL_SP_SRAM_SIZE		SZ_64K
 #define PPBOOT_TEXT_BASE	(FW_SRAM_BASE + 0xC)
-#define PREBOOT_TEXT_BASE	(SDRAM_BASE + PPBOOT_SIZE + 0x8)
+#define PREBOOT_TEXT_BASE	(SDRAM_BASE + 0x8)
 
 #define FW_WORD_NUM		0x2A00	/* FW_SIZE / 2 */
 
