diff --git a/drivers/pinctrl/pinctrl_hl_gaudi3.c b/drivers/pinctrl/pinctrl_hl_gaudi3.c
new file mode 100644
index 0000000..82cdc4b
--- /dev/null
+++ b/drivers/pinctrl/pinctrl_hl_gaudi3.c
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2025 Intel Ltd.
+ * All Rights Reserved.
+ */
+
+ #define DT_DRV_COMPAT hl_gaudi3_pinctrl
+
+ #include <zephyr/devicetree.h>
+ #include <zephyr/drivers/pinctrl.h>
+ #include <common_utils.h>
+ #include <pinctrl_soc.h>
+ #include <hl_fw_if.h>
+
+int pinctrl_configure_pins(const pinctrl_soc_pin_t *pins, uint8_t pin_cnt, uintptr_t reg)
+{
+	int i;
+
+	uint32_t num_dies = 1, die_id = hl_read_die_id();
+	bool spi_gw_dis = hl_get_spi_gw_disable();
+	uint8_t pin, func;
+	uint32_t pinctrl_base;
+
+	pinctrl_base = (uint32_t)DT_REG_ADDR(DT_NODELABEL(pinctrl));
+
+	if (hl_get_sku_type() == HL_DUAL_DIE_SKU)
+		num_dies = 2;
+
+	if (!hl_is_cfg_addr_valid((uint32_t)pinctrl_base, die_id, num_dies, spi_gw_dis))
+		return -EINVAL;
+
+	for (i = 0; i < pin_cnt; i++) {
+		pin = pins[i].pin;
+		func = pins[i].func;
+		sys_write32(func, pinctrl_base + (pin * sizeof(uint32_t)));
+	}
+
+	return 0;
+}
diff --git a/dts/bindings/pinctrl/hl,gaudi3-pinctrl.yaml b/dts/bindings/pinctrl/hl,gaudi3-pinctrl.yaml
new file mode 100644
index 0000000..71813f9
--- /dev/null
+++ b/dts/bindings/pinctrl/hl,gaudi3-pinctrl.yaml
@@ -0,0 +1,46 @@
+# Copyright (c) 2025 Intel Corporation
+# SPDX-License-Identifier: Apache-2.0
+
+description: |
+  Intel Gaudi3 Pin controller.
+
+  Device pin configuration should be placed in the child nodes of this node.
+  Populate the 'pinmux' field with a pair consisting of a pin number and 'func'
+  for its IO function.
+
+  For example, setting SPI pins would look like this:
+
+    #include <zephyr/dt-bindings/pinctrl/gpio.h>
+
+    &pinctrl {
+      spi0_default: spi0_default {
+        pinmux = <GPIO_SPI_0_MISO GPIO_SPI_0_MOSI GPIO_SPI_0_SCLK_OUT GPIO_SPI_0_CS0>;
+        func = <0 0 0 1>;
+      };
+    };
+
+compatible: "hl,gaudi3-pinctrl"
+
+include: base.yaml
+
+properties:
+  reg:
+    required: true
+
+child-binding:
+  description: |
+    This binding gives a base representation of the HL Gaudi3 pins
+    configuration.
+
+  properties:
+    pinmux:
+      required: true
+      type: array
+      description: |
+        Gaudi3 pin's configuration
+
+    func:
+      required: true
+      type: array
+      description: |
+        Gaudi3 pin's alternate functions
