diff --git a/soc/hl/gaudi/gaudi3/pinctrl_soc.h b/soc/hl/gaudi/gaudi3/pinctrl_soc.h
new file mode 100644
index 0000000..a5977eb
--- /dev/null
+++ b/soc/hl/gaudi/gaudi3/pinctrl_soc.h
@@ -0,0 +1,30 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright 2016-2025 Intel, Ltd.
+ * All Rights Reserved.
+ */
+
+#ifndef HL_SOC_GAUDI3_PINCTRL_SOC_H
+#define HL_SOC_GAUDI3_PINCTRL_SOC_H
+
+#include <zephyr/devicetree.h>
+#include <zephyr/sys/util.h>
+#include <zephyr/types.h>
+
+typedef struct pinctrl_soc_pin_t {
+	uint8_t pin;
+	uint8_t func;
+} pinctrl_soc_pin_t;
+
+#define HL_DT_PIN(node_id, prop, idx) {					\
+		.pin = DT_PROP_BY_IDX(node_id, pinmux, idx),		\
+		.func = DT_PROP_BY_IDX(node_id, func, idx),		\
+	},
+
+#define Z_PINCTRL_STATE_PINS_INIT(node_id, prop)			\
+		{DT_FOREACH_PROP_ELEM(DT_PHANDLE(node_id, prop),	\
+					pinmux,			\
+					HL_DT_PIN)}
+
+#endif
