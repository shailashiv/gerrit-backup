From 3fbb44091aaa5c7c245e84c94edd3143e3fd4035 Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Sat, 25 Mar 2023 20:09:29 +0300
Subject: [PATCH] [SW-136420] common: remove old devices content

Remove H2/H3/H5 that are not generated from master anymore

Change-Id: Ied38583f673a717fc680b6863da2b7acf3ef817b
---

diff --git a/Makefile b/Makefile
index ce0ac9d..bb5b2bf 100644
--- a/Makefile
+++ b/Makefile
@@ -9,10 +9,6 @@
 PREBOOT_ROOT_DIR := .
 HL_DEV_ARCH := arch/$(BASE_DEV_NAME)/$(HL_DEV_SUBTYPE)
 HL_DEV_ARCH_COMMON := arch/$(BASE_DEV_NAME)/common
-ifeq ($(BASE_DEV_NAME),greco)
-	BASE_DEV_NAME := goya2
-	CFLAGS += -DDCCM_INIT
-endif
 
 CFLAGS += -I$(SPECS_DIR)
 CFLAGS += -I$(SPECS_DIR)/$(BASE_DEV_NAME)/asic_reg
diff --git a/arch/gaudi2/common/common.c b/arch/gaudi2/common/common.c
index 793fbd2..6198350 100644
--- a/arch/gaudi2/common/common.c
+++ b/arch/gaudi2/common/common.c
@@ -612,7 +612,7 @@
 	}
 
 	/*
-	 * W/A H/W bug (Gaudi1) that may lead to have a wrong mask (0x1)
+	 * W/A H/W bug that may lead to have a wrong mask (0x1)
 	 * in LTSSM. Probably can be removed for Gaudi2, but we keep it as it
 	 * does not hurt.
 	 */
