From 28cf021324f5940df7a5589ef6a13b62645328f6 Mon Sep 17 00:00:00 2001
From: Subrata Chatterjee <schatterjee@habana.ai>
Date: Mon, 26 Apr 2021 18:38:25 +0300
Subject: [PATCH] [SW-37130] onix: add hl_spi_baudr_get() definition

Added function hl_spi_baudr_get() from greco_arc
to avoid compilation issue as spi_init() is now called
from common function.

Change-Id: I25f905d9630d4df13f37895fdf30bfadc1f21939
Signed-off-by: Subrata Chatterjee <schatterjee@habana.ai>
---

diff --git a/greco_arc_gnu/onix.c b/greco_arc_gnu/onix.c
index 523a1ce..d3e55fd 100644
--- a/greco_arc_gnu/onix.c
+++ b/greco_arc_gnu/onix.c
@@ -35,6 +35,14 @@
 	preboot_uart_init(UART_CLOCK_FREQUENCY / PLDM_UART_BAUDRATE);
 }
 
+u32 hl_spi_baudr_get(void)
+{
+	u32 factor = 2; /* Min Divider */
+
+	/* baud rate doesn't support odd number */
+	return (factor + 1) & 0xFFFE;
+}
+
 enum cmd_check_res dev_specific_module_pci_check(void)
 {
 	/*
