diff --git a/board/habanalabs/common/local_remote_common b/board/habanalabs/common/local_remote_common
new file mode 100755
index 0000000..903c178
--- /dev/null
+++ b/board/habanalabs/common/local_remote_common
@@ -0,0 +1,15 @@
+#!/bin/bash
+
+function print_msg() {
+	local msg=$1
+	echo -e   "********************************************************"
+	echo -e   "***** $msg"
+	echo -e   "********************************************************"
+}
+
+function print_dmesg() {
+        print_msg "*************** dmesg start ***********************"
+        sudo dmesg -c
+        print_msg "*************** dmesg end *************************"
+}
+
diff --git a/board/habanalabs/common/local_run b/board/habanalabs/common/local_run
new file mode 100755
index 0000000..f813477
--- /dev/null
+++ b/board/habanalabs/common/local_run
@@ -0,0 +1,104 @@
+#!/bin/bash -l
+
+params=$*
+remove_pkgs=$(echo $params | grep -ow remove | uniq)
+install_pkgs=$(echo $params | grep -ow install | uniq)
+program_flash=$(echo $params | grep -ow program | uniq)
+
+pre_pkg_lst="dkms"
+habana_pkg_lst="habanalabs"
+fw_ldr=$HOME/fw_loader
+
+source local_remote_common
+
+if [[ -z "$remove_pkgs" && -z "$install_pkgs" && -z "$program_flash" ]]; then
+	print_msg "Error: no arguments provided"
+	exit 10;
+fi
+
+function local_purge_leftovers() {
+	print_msg "Start Purging leftovers"
+	DKMS_HABANA_DIR=/var/lib/dkms/habanalabs
+	HABANA_KO="/lib/modules/$(uname -r)/updates/dkms/habanalabs.ko"
+	if [ $(lsmod | grep -ci habana) -ne 0 ]; then
+		echo habanalabs is still inserted... removing...;
+		sudo modprobe -r habanalabs;
+	fi
+	if [ -e $DKMS_HABANA_DIR ]; then
+		echo $DKMS_HABANA_DIR is still present... removing...;
+		sudo rm -fr $DKMS_HABANA_DIR;
+	fi
+	if [ -e $HABANA_KO ]; then
+		echo $(basename $HABANA_KO) is still present... removing...;
+		sudo rm -f $HABANA_KO;
+	fi
+	print_msg "Finished Purging leftovers"
+}
+
+function local_remove_packages() {
+	print_msg "Removing old habana packages"
+	sudo apt-get purge --auto-remove $habana_pkg_lst -y
+	sudo apt-get clean
+}
+
+function local_install_packages() {
+	print_msg "Installing habana prerequisites"
+	sudo apt update				|| return 1;
+	sudo apt-get install ${pre_pkg_lst} -y	|| return 1;
+	print_msg "Installing new habana packages"
+	sudo apt install ${habana_pkg_lst} -y	|| return 1;
+}
+
+function local_program_flash() {
+#	local hl_vid=1da3
+#	local hl_did=0001
+#	local hl_slot=$(lspci -Dd ${hl_vid}:${hl_did} | cut -d\  -f1)
+#	local pci_rescan=/sys/bus/pci/rescan
+#	local hl_remove=/sys/bus/pci/devices/${hl_slot}/remove
+	local hl_syspath=/sys/class/habanalabs
+
+	print_msg "Programming SPI flash"
+	sudo $fw_ldr || return 1;
+	sleep 5;
+#	sudo bash -c "echo 1 > $hl_remove" || return 1;
+	sudo modprobe -r habanalabs
+	sleep 5;
+#	sudo bash -c "echo 1 > $pci_rescan" || return 1;
+	sudo modprobe habanalabs "heartbeat=0"
+	print_msg "New SPI flash FW versions"
+	sleep 5;
+	cat $hl_syspath/hl*/*_ver
+	
+}
+
+function local_err_exit() {
+	local err=$1
+	print_dmesg
+	exit $err;
+}
+
+# Clean the dmesg buffer
+sudo dmesg -C
+
+if [[ -n "$remove_pkgs" || -n "$install_pkgs" ]]; then
+	local_remove_packages
+	local_purge_leftovers
+fi
+	
+if [ -n "$install_pkgs" ]; then
+	local_install_packages
+	if [ $? -ne 0 ]; then
+		print_msg "Failed installing packages"
+		local_err_exit 1;
+	fi
+	print_dmesg
+fi
+
+if [ -n "$program_flash" ]; then
+	local_program_flash
+	if [ $? -ne 0 ]; then
+        	print_msg "Failed programming flash"
+	        local_err_exit 2;
+	fi
+	print_dmesg
+fi
