diff --git a/app/ext_rom/erom_recovery.c b/app/ext_rom/erom_recovery.c
index 5fa69c0..b3be286 100644
--- a/app/ext_rom/erom_recovery.c
+++ b/app/ext_rom/erom_recovery.c
@@ -5,9 +5,128 @@
  *
  */
 
-#include "preboot.h"
+#include <stdint.h>
+#include <boot_if.h>
+#include <cmd_module.h>
+#include <stddef.h>
+#include <pll.h>
+#include <preboot.h>
+#include <security.h>
+#include <spi_flash.h>
+#include <device.h>
+
+#include <uart.h>
+
+#define BTL_VER_PREFIX  "BTL version "
+#define FUSE_VER_PREFIX "Fuse version "
+
+static char preboot_vers[][VERSION_MAX_LEN] = {
+	[PREBOOT_BTL_VER] = { BTL_VER_PREFIX },
+	[PREBOOT_EFUSE_VER] = { FUSE_VER_PREFIX },
+};
+
+static struct cmd_module_ops cmd_ops[] = {
+	{	/* PCI module */
+		.setup = module_pci_setup,
+		.check = module_pci_check,
+		.disable = module_pci_disable,
+		.run = module_pci_run,
+		.enable = module_pci_enable,
+		.run_fast = module_pci_run_fast,
+		.teardown = module_pci_teardown,
+		.run_noreturn = noop,
+	},
+	{	/* FW UPD module */
+		.setup = module_fwupd_setup,
+		.check = module_fwupd_check,
+		.disable = noop,
+		.run = module_fwupd_run,
+		.enable = noop,
+		.run_fast = module_fwupd_run_fast,
+		.teardown = noop,
+		.run_noreturn = module_fwupd_run_noret,
+	},
+	{	/* I2C FW UPD module */
+		.setup = module_i2c_fwupd_setup,
+		.check = module_i2c_fwupd_check,
+		.disable = noop,
+		.run = module_i2c_fwupd_run,
+		.enable = noop,
+		.run_fast = module_i2c_fwupd_run_fast,
+		.teardown = noop,
+		.run_noreturn = module_fwupd_run_noret,
+	},
+	{	/* UART module */
+		.setup = module_uart_setup,
+		.check = module_uart_check,
+		.disable = noop,
+		.run = noop,
+		.enable = noop,
+		.run_fast = module_uart_run,
+		.teardown = module_uart_teardown,
+		.run_noreturn = noop,
+	},
+	{	/* I2C SLAVE module */
+		.setup = module_i2c_s_setup,
+		.check = module_i2c_s_check,
+		.disable = module_i2c_s_disable,
+		.run = module_i2c_s_run,
+		.enable = module_i2c_s_enable,
+		.run_fast = module_i2c_s_run_fast,
+		.teardown = module_i2c_s_teardown,
+		.run_noreturn = module_i2c_s_run_noret,
+	},
+};
+
+static void device_init(void)
+{
+	device_init_global_conf();
+	device_init_uart();
+	device_init_pci();
+	device_init_i2c_s();
+}
 
 void erom_main_function(void)
 {
-	preboot_main();
+	u64 ver_off = (uintptr_t)preboot_vers;
+
+	device_init();
+	/*
+	 * Note: we assume CPU frequency is not changed while CPU is running,
+	 * so the udelay init is done once before we start.
+	 */
+	cpu_boot_if_init();
+	cpu_boot_sts_set(CPU_BOOT_STATUS_IN_PREBOOT);
+	/* Enable the errors communication */
+	cpu_boot_err_set(CPU_BOOT_ERR_ENABLED);
+	/* Enable the device status communication */
+	cpu_boot_dev_sts_set(CPU_BOOT_DEV_STS_ENABLED);
+
+	udelay_init();
+
+	hl_dev_pll_init();
+
+	hl_uart_init();
+
+	preboot_cond_arc0_reset();
+
+	spi_flash_init();
+	spi_flash_prot_late();
+	spi_flash_prot_status();
+
+	preboot_sp_sram_init();
+
+	preboot_device_id_init();
+
+	hl_ts_init();
+
+	/* Prepare boot FW versions and eFuse data for host */
+	preboot_version();
+	preboot_security_dynamic_vers_init(ver_off, sizeof(preboot_vers));
+
+	preboot_dev_enable_caps();
+
+	cpu_boot_sts_set(CPU_BOOT_STATUS_WAITING_FOR_BOOT_FIT);
+
+	module_handle_cmds(cmd_ops, ARRAY_SIZE(cmd_ops));
 }
