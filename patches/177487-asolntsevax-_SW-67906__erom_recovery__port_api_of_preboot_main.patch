-PREBOOT_SRCS_C := $(filter-out $(HL_DEV_ARCH_COMMON)/tpm_auth.c, $(PREBOOT_SRCS_C)) #tpm code is not needed in recovery image
-
-PREBOOT_SRCS_C += $(shell ls $(HL_DEV_ARCH)/common.c)
-PREBOOT_SRCS_C += $(shell ls $(HL_DEV_ARCH)/$(HL_TARGET).c)
-PREBOOT_OBJECTS := $(PREBOOT_SRCS_C:.c=.o)
-
-EROM_RECOVERY_DEPS := ${PREBOOT_OBJECTS} # EROM recovery image contains entire preboot image
