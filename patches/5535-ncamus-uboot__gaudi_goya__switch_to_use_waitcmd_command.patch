From f00ddde81d8a4699b2bdd9b0dcca4bad54ce5e4f Mon Sep 17 00:00:00 2001
From: Igor Grinberg <igrinberg@habana.ai>
Date: Fri, 19 Oct 2018 16:50:11 +0300
Subject: [PATCH] uboot: gaudi/goya: switch to use waitcmd command

The new waitcmd command has been introduced and it wraps the getfit
command now.
Switch to use the new command.

Signed-off-by: Igor Grinberg <igrinberg@habana.ai>
---

diff --git a/board/habanalabs/gaudi/uboot-env-asic.txt b/board/habanalabs/gaudi/uboot-env-asic.txt
index c1050ab..c35886a 100644
--- a/board/habanalabs/gaudi/uboot-env-asic.txt
+++ b/board/habanalabs/gaudi/uboot-env-asic.txt
@@ -1,2 +1,2 @@
 bootm_low=0
-bootcmd=getfit && bootm $fileaddr#conf@1 || getfit_failure
+bootcmd=while true; do waitcmd; run command; done
diff --git a/board/habanalabs/gaudi/uboot-env-onix.txt b/board/habanalabs/gaudi/uboot-env-onix.txt
index c1050ab..c35886a 100644
--- a/board/habanalabs/gaudi/uboot-env-onix.txt
+++ b/board/habanalabs/gaudi/uboot-env-onix.txt
@@ -1,2 +1,2 @@
 bootm_low=0
-bootcmd=getfit && bootm $fileaddr#conf@1 || getfit_failure
+bootcmd=while true; do waitcmd; run command; done
