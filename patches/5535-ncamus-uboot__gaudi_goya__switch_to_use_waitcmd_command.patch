diff --git a/board/habanalabs/gaudi/uboot_asic.fragment b/board/habanalabs/gaudi/uboot_asic.fragment
index 95c2b89..7fda35e 100644
--- a/board/habanalabs/gaudi/uboot_asic.fragment
+++ b/board/habanalabs/gaudi/uboot_asic.fragment
@@ -3,7 +3,7 @@
 CONFIG_BAUDRATE=115200
 CONFIG_BOOTDELAY=0
 CONFIG_DEBUG_UART_CLOCK=107500000
-CONFIG_BOOTCOMMAND="getfit && bootm $fileaddr#conf@1"
+CONFIG_BOOTCOMMAND="while true; do waitcmd; run command; done"
 CONFIG_DEFAULT_DEVICE_TREE="gaudi_asic"
 CONFIG_SPI_FLASH_MACRONIX=y
 CONFIG_SYS_I2C_EEPROM_BUS=1
