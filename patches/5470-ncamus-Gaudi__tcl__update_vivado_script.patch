diff --git a/board/habanalabs/common/vivado_lab/program-avnet.tcl b/board/habanalabs/common/vivado_lab/program-avnet.tcl
index 77a507d..b40552e 100644
--- a/board/habanalabs/common/vivado_lab/program-avnet.tcl
+++ b/board/habanalabs/common/vivado_lab/program-avnet.tcl
@@ -1,10 +1,12 @@
 open_hw
 connect_hw_server
 open_hw_target
-set_property PROGRAM.FILE {/opt/Xilinx/Vivado_Lab/h2_cpu_top_onix_avnet_070618.bit} [get_hw_devices xcvu440_0]
+#set_property PROGRAM.FILE {/opt/Xilinx/Vivado_Lab/h2_cpu_top_onix_avnet_070618.bit} [get_hw_devices xcvu440_0]
+set_property PROGRAM.FILE {/opt/Xilinx/Vivado_Lab/h3_top_avnet_220818.bit} [get_hw_devices xcvu440_0]
 current_hw_device [get_hw_devices xcvu440_0]
 refresh_hw_device [lindex [get_hw_devices xcvu440_0] 0]
-set_property PROGRAM.FILE {/opt/Xilinx/Vivado_Lab/h2_cpu_top_onix_avnet_070618.bit} [get_hw_devices xcvu440_0]
+#set_property PROGRAM.FILE {/opt/Xilinx/Vivado_Lab/h2_cpu_top_onix_avnet_070618.bit} [get_hw_devices xcvu440_0]
+set_property PROGRAM.FILE {/opt/Xilinx/Vivado_Lab/h3_top_avnet_220818.bit} [get_hw_devices xcvu440_0]
 program_hw_devices [get_hw_devices xcvu440_0]
 refresh_hw_device [lindex [get_hw_devices xcvu440_0] 0]
 exit
