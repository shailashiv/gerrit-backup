 #set_property PROGRAM.FILE {/opt/Xilinx/Vivado_Lab/h2_cpu_top_onix_dspg_070618.bit} [get_hw_devices xcvu440_0]
 # GAUDI:
-set_property PROGRAM.FILE {/opt/Xilinx/Vivado_Lab/h3_top_210818.bit} [get_hw_devices xcvu440_0]
+set_property PROGRAM.FILE {/opt/Xilinx/Vivado_Lab/h3_top_dspg_220818.bit} [get_hw_devices xcvu440_0]
