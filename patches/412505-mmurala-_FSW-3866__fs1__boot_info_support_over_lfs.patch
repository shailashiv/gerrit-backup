From 4d242d3f5223d0201b2ce30be668134a118557df Mon Sep 17 00:00:00 2001
From: Murala S Swamy <ssmurala@habana.ai>
Date: Tue, 23 Apr 2024 14:58:38 +0300
Subject: [PATCH] [FSW-3866] fs1: boot info support over lfs

With this patch, added placeholder for boot info
over lfs, and defined lfs disk size and offset.
provided progress bits required for boot info
status during cold reset and reset scenario's.

Change-Id: I21a66a8fc523727de13e545dcd007ea0703efea4
---

diff --git a/app/boot_rom.c b/app/boot_rom.c
index a8fa829..4a4cea7 100644
--- a/app/boot_rom.c
+++ b/app/boot_rom.c
@@ -17,6 +17,7 @@
 	.die_id = 0,
 	.die_type = INVALID_DIE_TYPE,
 	.fake_fuse_en = false,
+	.boot_info_set_done = false,
 };
 
 struct boot_rom_manifest_s __attribute__((section (".rom_manifest_section")))boot_rom_manifest;
@@ -33,5 +34,7 @@
 
 	boot_rom_check_n_enter_recovery();
 
+	boot_rom_init_boot_info();
+
 	return 0;
 }
