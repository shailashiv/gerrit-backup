 BOOT_ROM_COMMON_SRCS_C += $(shell ls $(HL_DEV_ARCH)/slave.c)
 BOOT_ROM_COMMON_SRCS_C += $(shell ls $(HL_DEV_ARCH)/dev_uart.c)
 BOOT_ROM_COMMON_SRCS_C += $(shell ls $(HL_DEV_ARCH)/dev_recovery.c)
+BOOT_ROM_COMMON_SRCS_C += $(shell ls $(HL_DEV_ARCH)/dev_boot_info.c)
diff --git a/arch/fs1/arc/common.c b/arch/fs1/arc/common.c
index 9c98bcd..0af393e 100644
--- a/arch/fs1/arc/common.c
+++ b/arch/fs1/arc/common.c
@@ -102,6 +102,7 @@
 	boot_rom_global.recovery_flag = cold_rst_data.recovery_flag;
 	boot_rom_global.validation_pass = cold_rst_data.validation_flag;
 	boot_rom_global.efuse_read = cold_rst_data.efuse_read_flag;
+	boot_rom_global.boot_info_set_done = cold_rst_data.boot_info_set_done;
 }
 
 /* TODO: Add functionality once mem init feature is added to memcpy block */
diff --git a/arch/fs1/arc/dev_boot_info.c b/arch/fs1/arc/dev_boot_info.c
new file mode 100644
index 0000000..91ec87e
--- /dev/null
+++ b/arch/fs1/arc/dev_boot_info.c
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier:     GPL-2.0+
+/*
+ * Copyright (C) 2024 HabanaLabs Ltd.
+ * All Rights Reserved.
+ *
+ */
+
+#include <string.h>
+#include <stdbool.h>
+#include <boot_rom.h>
+#include <hl_boot_desc.h>
+#include <common.h>
+#include <fs1_fw_if.h>
+#include <lfs_wrapper.h>
+#include <hl_sec_if.h>
+#include <status.h>
+#include "dev_efuse.h"
+#include <fs1_blocks_linux_driver.h>
+#include <psoc_boot_conf_regs.h>
+#include <fs1_reg_map.h>
+
+bool boot_rom_skip_boot_info(void)
+{
+	if (boot_rom_global.die_type != IO_DIE_MASTER)
+		return true;
+
+	/* TODO: efuse check can be added here */
+
+	return false;
+}
+
+void boot_rom_init_boot_info(void)
+{
+	struct fs1_cold_rst_data cold_rst_data;
+
+	if(boot_rom_skip_boot_info())
+		return;
+
+	if (!boot_rom_global.boot_info_set_done) {
+		boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_SET_START);
+
+		/* TODO: save boot info required for other FW modules */
+
+		cold_rst_data.data = regmap_readl(IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+		cold_rst_data.boot_info_set_done = 1;
+		regmap_writel(cold_rst_data.data, IO0_H0_PSOC_BOOT(mmPSOC_BOOT_CONF_COLD_RST_REG_2));
+		boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_SET_FINISH);
+	} else {
+		/* Read and make sure databackup after any reset */
+		boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_GET_START);
+
+		/* TODO: retrieve boot info and verify */
+
+		boot_rom_status_update(PROGRESS_BOOT_INFO_IMG_DESC_INFO_GET_FINISH);
+	}
+
+	return;
+}
