+/* add LFS offset */
+#define OFFSET_32KB		(32 * 1024)
+#define CONFIG_BOOTINFO_ADDR	(HL_FW_MEM_BASE + HL_SCRATCHPAD_SRAM_OFFSET + OFFSET_32KB)
+#define CONFIG_BOOTINFO_SIZE	OFFSET_32KB
+
+#endif	/* _DEV_BOOT_INFO_H_ */
