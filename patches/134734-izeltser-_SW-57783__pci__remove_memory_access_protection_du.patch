From ae6a9e64ef4858e60225a0c0f8305365ccccf5e7 Mon Sep 17 00:00:00 2001
From: Igal Zeltser <izeltser@habana.ai>
Date: Thu, 30 Sep 2021 16:30:54 +0300
Subject: [PATCH] [SW-57783] pci: remove memory access protection during iatu init

Testing shows that some hosts misbehave when the device pulls down
the mem_en bit right after the host sets it up.
Since now we are protecting each region of the iatu during
initialization, we can remove the memory protection by the mem_en
bit of the configuration space.

Change-Id: I217ad976e53ca362ab467dd4ada1663512df9d7c
Signed-off-by: Igal Zeltser <izeltser@habana.ai>
---

diff --git a/arch/gaudi/arm/asic.c b/arch/gaudi/arm/asic.c
index a9c72a1..5aae048 100644
--- a/arch/gaudi/arm/asic.c
+++ b/arch/gaudi/arm/asic.c
@@ -387,8 +387,6 @@
 	struct hl_pci_inbound_region inbound_region;
 	struct hl_pci_outbound_region outbound_region;
 
-	hl_pcie_disable_mem_access();
-
 	/* Inbound Region 0 - Bar 0 - Point to SRAM + CFG */
 	inbound_region.mode = PCI_BAR_MATCH_MODE;
 	inbound_region.bar = PCI_BAR_ID_0;
@@ -423,8 +421,6 @@
 	outbound_region.addr = HOST_PHYS_BASE;
 	outbound_region.size = HOST_PHYS_SIZE;
 	hl_pci_set_outbound_region(&outbound_region);
-
-	hl_pcie_enable_mem_access();
 }
 
 void lkd_dev_spec_regs(struct cpu_dyn_regs *regs)
diff --git a/arch/gaudi2/common/asic.c b/arch/gaudi2/common/asic.c
index a1fb829..7378ca5 100644
--- a/arch/gaudi2/common/asic.c
+++ b/arch/gaudi2/common/asic.c
@@ -63,8 +63,6 @@
 	struct hl_pci_inbound_region inbound_region;
 	struct hl_pci_outbound_region outbound_region;
 
-	hl_pcie_disable_mem_access();
-
 	/* Inbound Region 0 - Bar 0 - Point to CFG */
 	inbound_region.mode = PCI_ADDRESS_MATCH_MODE;
 	inbound_region.bar = PCI_BAR_ID_0;
@@ -91,6 +89,4 @@
 	outbound_region.addr = HOST_PHYS_BASE_0;
 	outbound_region.size = HOST_PHYS_SIZE_0;
 	hl_pci_set_outbound_region(&outbound_region);
-
-	hl_pcie_enable_mem_access();
 }
diff --git a/arch/greco/common/asic.c b/arch/greco/common/asic.c
index 95fc5a3..20a63a4 100644
--- a/arch/greco/common/asic.c
+++ b/arch/greco/common/asic.c
@@ -57,8 +57,6 @@
 	struct hl_pci_inbound_region inbound_region;
 	struct hl_pci_outbound_region outbound_region;
 
-	hl_pcie_disable_access();
-
 	/* Inbound Region 0 - Bar - - Point to SRAM and CFG */
 	inbound_region.mode = PCI_BAR_MATCH_MODE;
 	inbound_region.bar = PCI_BAR_ID_0;
@@ -75,8 +73,6 @@
 	outbound_region.addr = HOST_PHYS_BASE;
 	outbound_region.size = HOST_PHYS_SIZE;
 	hl_pci_set_outbound_region(&outbound_region);
-
-	hl_pcie_enable_access();
 }
 
 void lkd_dev_spec_regs(struct cpu_dyn_regs *regs)
