 {
+	if (!uart.regs_initialized)
+		return;
+
 	while (tx_buf.head != tx_buf.tail) {
 		while (regmap_readl(uart.uart_state_reg) & UART_SR_TXFULL)
 			;
@@ -104,6 +112,9 @@
 
 void preboot_uart_init(unsigned int val)
 {
+	if (!uart.regs_initialized)
+		return;
+
 	regmap_writel(0x0, uart.uart_ctrl_reg);
 	regmap_writel(val, uart.uart_bauddiv_reg);
