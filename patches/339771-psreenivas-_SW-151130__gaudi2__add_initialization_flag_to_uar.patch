From c0be3c863c8f7a3306c34fb6384da6f35fbb7ae0 Mon Sep 17 00:00:00 2001
From: Pavan S <psreenivas@habana.ai>
Date: Fri, 14 Jul 2023 09:00:40 +0300
Subject: [PATCH] [SW-151130] gaudi2: add initialization flag to uart module

The prints in arc0 will impact pcie link up timings
the uart module is common for arc0 and arc1 and trying
to print from both the arcs can have sync issues.
This patch adds initialized flag in uart which is
default set to false and will be set to true as
part of device_init_uart. The device_init_uart
init is done only for arc1. Hence all the prints
from arc0 will be ignored.

Signed-off-by: Pavan S <psreenivas@habana.ai>
Change-Id: Icffc45a133e0a586c201a1ac464fd55e734484d9
---

diff --git a/arch/gaudi2/common/common.c b/arch/gaudi2/common/common.c
index aedaea9..07fce4c 100644
--- a/arch/gaudi2/common/common.c
+++ b/arch/gaudi2/common/common.c
@@ -1200,6 +1200,7 @@
 	uart.uart_state_reg = mmPSOC_UART_0_STATE;
 	uart.uart_ctrl_reg = mmPSOC_UART_0_CTRL;
 	uart.uart_bauddiv_reg = mmPSOC_UART_0_BAUDDIV;
+	uart.regs_initialized = true;
 }
 
 void device_init_pci(void)
diff --git a/arch/gaudi3/arc/common.c b/arch/gaudi3/arc/common.c
index acf5116..707561f 100644
--- a/arch/gaudi3/arc/common.c
+++ b/arch/gaudi3/arc/common.c
@@ -528,6 +528,7 @@
 	uart.uart_state_reg = D0_PSOC_UART_0_REG(mmUART_STATE);
 	uart.uart_ctrl_reg = D0_PSOC_UART_0_REG(mmUART_CTRL);
 	uart.uart_bauddiv_reg = D0_PSOC_UART_0_REG(mmUART_BAUDDIV);
+	uart.regs_initialized = true;
 }
 
 void device_init_pci(void)
diff --git a/include/device.h b/include/device.h
index dc036f7..f8302df 100644
--- a/include/device.h
+++ b/include/device.h
@@ -18,6 +18,7 @@
 	u32 uart_state_reg;
 	u32 uart_ctrl_reg;
 	u32 uart_bauddiv_reg;
+	u32 regs_initialized;
 };
 
 struct device_pci {
