From 627372902f4552be486355fbdddfcf1f41d6b32d Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Sun, 07 Apr 2019 18:54:18 +0300
Subject: [PATCH] [SW-0] preboot: replace io accessors with local implementation

Replace U-boot readb/readl/writeb/writel with local implementation
taken from fw_loader.
It removes part of the coupling with u-boot project.

Change-Id: Iac4bd5f5ec7d900a8880e0c3bd92da1ebd5f2e87
---

diff --git a/common/preboot.c b/common/preboot.c
index be7fce6..9244add 100644
--- a/common/preboot.c
+++ b/common/preboot.c
@@ -35,17 +35,18 @@
 	bool try_new_image = false;
 	char *spl_image = "candidate";
 
-	modifiable_image_pending = readl(mmPSOC_GLOBAL_CONF_NON_RST_FLOPS_3);
+	modifiable_image_pending =
+			regmap_readl(mmPSOC_GLOBAL_CONF_NON_RST_FLOPS_3);
 	if (modifiable_image_pending == FLOPS_UPD_PENDING) {
 		next_image_modifiable =
 			(*(unsigned int *)(HL_SPI_BASE + 0x60004) & 0xff) - '1';
 		if (next_image_modifiable < 2) {
 			next_image = next_image_modifiable;
-			writel((next_image + FLOPS_UPD_NXT_IMG1),
+			regmap_writel((next_image + FLOPS_UPD_NXT_IMG1),
 					mmPSOC_GLOBAL_CONF_NON_RST_FLOPS_3);
 			try_new_image = true;
 		} else
-			writel(FLOPS_UPD_NOOP,
+			regmap_writel(FLOPS_UPD_NOOP,
 					mmPSOC_GLOBAL_CONF_NON_RST_FLOPS_3);
 	}
 
@@ -71,7 +72,7 @@
 	preboot_puts(")\n");
 
 	*spl_off = image_base_offset + spl_offset;
-	writel((image_base_offset + uboot_offset),
+	regmap_writel((image_base_offset + uboot_offset),
 			mmPSOC_GLOBAL_CONF_SCRATCHPAD_30);
 }
 
@@ -87,7 +88,7 @@
 
 static void preboot_pcie_init(void)
 {
-	if (readl(mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS) & SKIP_PCIE_INIT) {
+	if (regmap_readl(mmPSOC_GLOBAL_CONF_BOOT_STRAP_PINS) & SKIP_PCIE_INIT) {
 		preboot_puts("PCIe initialization is skipped!\n");
 		return;
 	}
@@ -103,7 +104,7 @@
 static void preboot_version(void)
 {
 	u64 offset = (u64) preboot_btl_ver_str;
-	u32 btlver = readl(mmPSOC_GLOBAL_CONF_SCRATCHPAD_28);
+	u32 btlver = regmap_readl(mmPSOC_GLOBAL_CONF_SCRATCHPAD_28);
 	int i, btl_ver_sz;
 
 	preboot_puts("\n");
@@ -131,7 +132,7 @@
 			break;
 	}
 
-	writel((u32)(offset & ~CONFIG_SYS_SDRAM_BASE),
+	regmap_writel((u32)(offset & ~CONFIG_SYS_SDRAM_BASE),
 			mmPSOC_GLOBAL_CONF_SCRATCHPAD_28);
 }
 #else	/* TARGET_IS_TESTER */
@@ -142,7 +143,7 @@
 {
 	void (*spl_start)(void) = (void *)CONFIG_SPL_TEXT_BASE;
 
-	writel(CPU_BOOT_STATUS_IN_PREBOOT, get_cpu_boot_status_reg());
+	regmap_writel(CPU_BOOT_STATUS_IN_PREBOOT, get_cpu_boot_status_reg());
 
 	preboot_version();
 	preboot_pcie_init();
diff --git a/common/preboot.h b/common/preboot.h
index 47da923..b5b17d0 100644
--- a/common/preboot.h
+++ b/common/preboot.h
@@ -8,6 +8,30 @@
 #ifndef COMMON_PREBOOT_H_
 #define COMMON_PREBOOT_H_
 
+static inline u8 regmap_readb(u64 offset)
+{
+	u8 reg = *((volatile u8 *)offset);
+
+	return reg;
+}
+
+static inline void regmap_writeb(u8 val, u64 offset)
+{
+	*((volatile u8 *)offset) = val;
+}
+
+static inline u32 regmap_readl(u64 offset)
+{
+	u32 reg = *((volatile u32 *)offset);
+
+	return reg;
+}
+
+static inline void regmap_writel(u32 val, u64 offset)
+{
+	*((volatile u32 *)offset) = val;
+}
+
 u64 get_cpu_boot_status_reg(void);
 
 #endif /* COMMON_PREBOOT_H_ */
