From 36b3ebc7f842e2446c85a08f01fe88894dba8fa0 Mon Sep 17 00:00:00 2001
From: Yehuda Levavi <yehuda.levavi@tandemg.com>
Date: Sun, 05 Dec 2021 09:12:46 +0200
Subject: [PATCH] [SW-0] tpm: fix bus release

Fix BUS release in case of packets larger than 32B.

Change-Id: I835e3e66697241cf582410e59b8d824a038e1c7e
Signed-off-by: Yehuda Levavi <yehuda.levavi@tandemg.com>
---

diff --git a/arch/gaudi2/common/tpm2.c b/arch/gaudi2/common/tpm2.c
index ba6fc72..cedb167 100644
--- a/arch/gaudi2/common/tpm2.c
+++ b/arch/gaudi2/common/tpm2.c
@@ -348,6 +348,8 @@
 			goto release_bus;
 		}
 
+		spi_tpm_release_bus();
+
 		if (in) {
 			memcpy(in, rx_buf, transfer_len);
 			in += transfer_len;
@@ -356,11 +358,10 @@
 		len -= transfer_len;
 	}
 
+	return ret;
+
 release_bus:
 	/* If an error occurred, release the chip by deasserting the CS */
-	if (ret < 0)
-		spi_xfer(&tpm_spi, 0, NULL, NULL, SPI_XFER_END);
-
 	spi_tpm_release_bus();
 
 	return ret;
