From c53ff0cc05eb9e2fe1d08da2a36f630dfe09c85e Mon Sep 17 00:00:00 2001
From: Karthikeyan K <karthikk@habana.ai>
Date: Fri, 27 May 2022 06:31:24 +0300
Subject: [PATCH] [SW-0] rom: bug fix for slave pcie id

Fixes the logic for slave pcie device and vendor id.

Change-Id: Id473d3c6d1af6050b56ae2555c3b3c75d947945b
---

diff --git a/arch/gaudi3/arc/common.c b/arch/gaudi3/arc/common.c
index 2bb4b86..87846d2 100644
--- a/arch/gaudi3/arc/common.c
+++ b/arch/gaudi3/arc/common.c
@@ -313,12 +313,12 @@
 	if (!arcboot_rom_global.die_id)
 		return;
 
-	id = ((PCI_VENDOR_ID_HABANALABS <
+	id = ((PCI_VENDOR_ID_HABANALABS <<
 		D1_PCIE_DBI_SIG_DEVICE_ID_VENDOR_ID_REG_PCI_TYPE0_VENDOR_ID_S) |
-		(PCI_IDS_GAUDI3_DIE1 <
+		(PCI_IDS_GAUDI3_DIE1 <<
 		D1_PCIE_DBI_SIG_DEVICE_ID_VENDOR_ID_REG_PCI_TYPE0_DEVICE_ID_S));
 
-	regmap_writel(id, mmD1_PCIE_DBI_SIG_DEVICE_ID_VENDOR_ID_REG);
+	regmap_writel(id, mmD0_PCIE_DBI_SIG_DEVICE_ID_VENDOR_ID_REG);
 }
 
 void pcie_config_boot_termination(void)
