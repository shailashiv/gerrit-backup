From 6e259791572c9a64b6c1b40b0fdf71bf3cffaa1b Mon Sep 17 00:00:00 2001
From: Noam Camus <ncamus@habana.ai>
Date: Sat, 18 Jan 2020 21:57:35 +0200
Subject: [PATCH] [SW-8228] arcboot: fuse_read() fix comment style

We use C and not C++ format

Change-Id: I426c1ffe3bce428ce1c8303529bb015a93572255
---

diff --git a/common/efuse.c b/common/efuse.c
index ec3ce46..35acc78 100644
--- a/common/efuse.c
+++ b/common/efuse.c
@@ -38,11 +38,11 @@
 		return -2;
 	}
 
-	// read value from bank0
+	/* read value from bank0 */
 	offset = (word * sizeof(u32));
 	*val = regmap_readl(mmPSOC_EFUSE_DATA_0 + offset);
 
-	// read value from bank1 and OR with value from bank0
+	/* read value from bank1 and OR with value from bank0 */
 	offset = ((FUSE_WORDS_PER_BANK + word) * sizeof(u32));
 	*val |= regmap_readl(mmPSOC_EFUSE_DATA_0 + offset);
 
