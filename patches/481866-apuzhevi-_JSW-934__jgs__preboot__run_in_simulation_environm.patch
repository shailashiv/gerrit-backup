From 63d4e76e9327d98c01ec28d631b2c79e6b84ec2f Mon Sep 17 00:00:00 2001
From: Alexey Puzhevich <alexey.puzhevich@intel.com>
Date: Mon, 16 Jun 2025 16:55:52 +0300
Subject: [PATCH] [JSW-934] jgs: preboot: run in simulation environment

The needed changes were introduced to enable ppboot
execution in simulation environment (Coral) on mwm_ww19_4 spec.

Change-Id: I7cf592d97d1e1ddde76f3ccaa60beaab4f347550
Signed-off-by: Alexey Puzhevich <alexey.puzhevich@intel.com>
---

diff --git a/gpu/jgs/jgs_mem_addr_dt.h b/gpu/jgs/jgs_mem_addr_dt.h
index 7f54616..06cc571 100644
--- a/gpu/jgs/jgs_mem_addr_dt.h
+++ b/gpu/jgs/jgs_mem_addr_dt.h
@@ -39,7 +39,7 @@
 #define ARC_PREBOOT_COMPUTE_DCCM_OFFSET	80000000
 #define ARC_PREBOOT_COMPUTE_DCCM_SIZE	0x40
 
-#define SPSRAM_PREBOOT_OFFSET	78a00000
+#define SPSRAM_PREBOOT_OFFSET	79df0000
 #define SPSRAM_PREBOOT_SIZE	0x400
 #define BOOTINFO_REGION_OFFSET	00000
 #define BOOTINFO_REGION_SIZE	0x20
