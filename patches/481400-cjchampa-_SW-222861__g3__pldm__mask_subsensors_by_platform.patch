+			PLDM_PLATFORM_MASK_NONE,
+			PLDM_PLATFORM_MASK_NONE,
+			PLDM_PLATFORM_MASK_HL338,
+			PLDM_PLATFORM_MASK_NONE,
+			PLDM_PLATFORM_MASK_NONE,
+			PLDM_PLATFORM_MASK_NONE,
+		},
 	}},
